-    (hn : NoOffDiagonalOverlap block₁ block₂ σ)
-    (g₀ : FactorGroup block₁ block₂) (g : translatedSheet g₀) :
-    ((localOrbitHomeomorph σ hn g₀) g).val =
-      orbitMapToOrbit block₁ block₂ (permMatrix σ) g.val := rfl
-
