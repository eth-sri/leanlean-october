+    (ha : a ∈ D) (hb : b ∈ D) (hab : a ≠ b)
+    (he : mini h a = mini h b) (σ : Finset T) (C : Finset I)
+    (h_room : IST.isRoom σ C) (h_rel : isDoorof τ D σ C) :
+    (σ, C) = roomAt τ D a h ∨ (σ, C) = roomAt τ D b h := by
+  cases h_rel with
+  | idoor h0 _ x hx hσ hD =>
+      subst hσ
+      subst hD
+      obtain ⟨i, hi, hM, hmax⟩ :=
+        (sublemma_3_2 τ D x h_door h hx a b ha hb hab he).mp h0
+      have hx' := maximal_element_unique τ D i h hM x hmax
+      simp only [Finset.mem_insert, Finset.mem_singleton] at hi
+      rcases hi with rfl | rfl
+      · left
+        simp [roomAt, hM, hx']
+      · right
+        simp [roomAt, hM, hx']
+  | odoor h0 _ j hj hσ hD =>
+      subst hσ
+      have hj_ab := odoor_index_in_pair τ D C a b j h_door h ha hb hab he h0
+        h_room.2 hj hD
+      have hC : C = D.erase j := by
+        rw [hD]
+        exact (Finset.erase_insert hj).symm
+      have hdom : IST.isDominant τ (D.erase j) := by rwa [← hC]
+      have hjD : j ∈ D := by
+        rw [hD]
+        exact Finset.mem_insert_self _ _
+      obtain ⟨a', b', ha', hb', hab', he', hi', hE⟩ :=
+        (sublemma_3_1 τ D h_door h j hjD).mp hdom
+      have hM : ¬(M_set τ D j h).Nonempty := by
+        rw [hE]
+        exact Set.not_nonempty_empty
+      have hr : (τ, C) = roomAt τ D j h := by
+        simp [roomAt, hM, hC]
+      simp only [Finset.mem_insert, Finset.mem_singleton] at hj_ab
+      rcases hj_ab with rfl | rfl
+      · exact Or.inl hr
+      · exact Or.inr hr
