+lemma roomAt_ne [Fintype T] (τ : Finset T) (D : Finset I) (a b : I)
+    (h_door : IST.isDoor τ D) (h : τ.Nonempty)
+    (ha : a ∈ D) (hb : b ∈ D) (hab : a ≠ b)
+    (he : mini h a = mini h b) :
+    roomAt τ D a h ≠ roomAt τ D b h := by
+  have hdis := M_sets_disjoint τ D a b h h_door ha hb hab he
+  by_cases hMa : (M_set τ D a h).Nonempty
+  · by_cases hMb : (M_set τ D b h).Nonempty
+    · have hna := m_element_not_in_tau τ D a a b h_door h ha hb hab he hMa (Or.inl rfl)
+      have hne : m_element τ D a h hMa ≠ m_element τ D b h hMb := by
+        intro hm
+        have haM := (m_element_is_maximal τ D a h hMa).1
+        have hbM := (m_element_is_maximal τ D b h hMb).1
+        rw [hm] at haM
+        have hi : m_element τ D b h hMb ∈ M_set τ D a h ∩ M_set τ D b h := ⟨haM, hbM⟩
+        rw [hdis] at hi
+        exact hi
+      simp only [roomAt, hMa, hMb]
+      intro hp
+      have hi : insert (m_element τ D a h hMa) τ = insert (m_element τ D b h hMb) τ :=
+        congrArg Prod.fst hp
+      apply hne
+      have hm : m_element τ D a h hMa ∈ insert (m_element τ D b h hMb) τ := by
+        rw [← hi]
+        exact Finset.mem_insert_self _ _
+      rcases Finset.mem_insert.mp hm with hm | hm
+      · exact hm
+      · exact absurd hm hna
+    · have hn := m_element_not_in_tau τ D a a b h_door h ha hb hab he hMa (Or.inl rfl)
+      intro hp
+      have hi : insert (m_element τ D a h hMa) τ = τ := by
+        simpa [roomAt, hMa, hMb] using congrArg Prod.fst hp
+      apply hn
+      simpa only [hi] using Finset.mem_insert_self (m_element τ D a h hMa) τ
+  · by_cases hMb : (M_set τ D b h).Nonempty
+    · have hn := m_element_not_in_tau τ D b a b h_door h ha hb hab he hMb (Or.inr rfl)
+      intro hp
+      have hi : τ = insert (m_element τ D b h hMb) τ := by
+        simpa [roomAt, hMa, hMb] using congrArg Prod.fst hp
+      apply hn
+      simpa only [← hi] using Finset.mem_insert_self (m_element τ D b h hMb) τ
+    · simp only [roomAt, hMa, hMb]
+      intro hp
+      have hi : D.erase a = D.erase b := congrArg Prod.snd hp
+      have hb' : b ∈ D.erase a := Finset.mem_erase.mpr ⟨hab.symm, hb⟩
+      rw [hi] at hb'
+      exact Finset.notMem_erase b D hb'
 
