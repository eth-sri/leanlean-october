-/-- A practical global criterion; not a new definition of ContMDiff. -/
-theorem contMDiff_blockO_of_val {f : M → BlockO block}
-    (hf : ContMDiff I (𝓘(ℝ, Mat n)) ⊤ (fun y => (f y).val)) :
