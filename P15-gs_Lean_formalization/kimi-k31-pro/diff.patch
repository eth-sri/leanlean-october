-instance blockOContMDiffMul (block : Fin n → ℕ) :
-    ContMDiffMul (𝓘(ℝ, Model block)) ⊤ (BlockO block) where
-  toIsManifold := blockOIsManifold block
-  contMDiff_mul := blockO_mul_contMDiff block
