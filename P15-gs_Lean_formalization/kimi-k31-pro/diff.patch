-  have ht : ContDiff ℝ ⊤ (fun X : Mat n => Xᵀ) :=
-    contDiff_iff_contDiffAt.mpr (fun _ => smooth_transpose_at contDiffAt_id)
-  simpa only [Function.comp_def,blockO_inv_val] using ht.comp_contMDiff (blockO_val_contMDiff block)
