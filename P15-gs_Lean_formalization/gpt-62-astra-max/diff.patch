-    mul_mem_sharedMatrixSpace hb hbn
-      (mul_mem_sharedMatrixSpace hb hbn ⟨hA.1, hA.2.2⟩ ⟨hC.1, hC.2.2⟩)
-      ⟨hA.1.transpose, hA.2.2.transpose⟩
