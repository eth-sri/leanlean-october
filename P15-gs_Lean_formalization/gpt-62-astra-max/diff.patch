-  · intro hg
-    obtain ⟨h, hh⟩ := Set.mem_iUnion.mp hg
-    refine ⟨g * h.val, hh, ?_⟩
-    apply Subtype.ext
-    change (g * h.val) • P = g • P
-    rw [mul_smul, show h.val • P = P from h.property]
