-  let L := squareFlatten (fromBlocks U₁ 0 0 U₂)
-  let R := squareFlatten (fromBlocks V₁ 0 0 V₂)
-  let K := squareFlatten (fromBlocks (diagonal (fun i => (c i : ℂ))) (-diagonal (fun i => (s i : ℂ)))
