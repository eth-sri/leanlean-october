-    HasDerivAt (fun t : ℝ => cayley (t • A)) ((-2 : ℝ) • A) 0 := by
-  let u : Model (fun _ : Fin n => 0) := ⟨A, by intro i j hij; exact (hij rfl).elim, hk⟩
-  have hd := chartInv_line_hasDerivAt_zero (1 : BlockU (fun _ : Fin n => 0)) u
