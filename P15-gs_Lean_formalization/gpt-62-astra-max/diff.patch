-      ⟪f i, f j⟫_ℝ = ∑ k, A k i * A k j := by
-        rw [← e₀.sum_inner_mul_inner (f i) (f j)]
-        apply Finset.sum_congr rfl
-        intro k hk
-        rw [real_inner_comm (e₀ k) (f i), hcoords, hcoords]
-      _ = (Aᵀ * A) i j := rfl
-      _ = _ := by rw [hA]; simp [Matrix.diagonal_apply]
