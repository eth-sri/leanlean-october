-theorem hasDerivAt_matrix_conjTranspose {f : ℝ → CMat n} {u : CMat n}
-    (hf : HasDerivAt f u 0) : HasDerivAt (fun t => (f t)ᴴ) uᴴ 0 := by
-  apply hasDerivAt_pi.mpr
-  intro i
-  apply hasDerivAt_pi.mpr
-  intro j
-  exact ((hasDerivAt_pi.mp (hasDerivAt_pi.mp hf j)) i).star
