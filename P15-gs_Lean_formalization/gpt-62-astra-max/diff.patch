-def ballNormalize {r : ℝ} (x : PuncturedNormBall E r) : NormSphere E :=
-  ⟨‖x.val‖⁻¹ • x.val, by
-    have hp : 0 < ‖x.val‖ := norm_pos_iff.mpr x.property.2
-    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hp)]
-    exact inv_mul_cancel₀ (ne_of_gt hp)⟩
