-theorem frobSq_add (A B : Matrix ι κ ℝ) :
-    frobSq (A + B) = frobSq A + 2 * frobInner A B + frobSq B := by
-  unfold frobSq
-  rw [frobInner_add_left, frobInner_add_right, frobInner_add_right,
