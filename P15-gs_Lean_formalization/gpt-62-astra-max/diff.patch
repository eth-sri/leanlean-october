-theorem frobInner_sub_left (A B C : Matrix ι κ ℝ) :
-    frobInner (A - B) C = frobInner A C - frobInner B C := by
-  simp [frobInner, sub_mul, Finset.sum_sub_distrib]
-
-theorem frobInner_sub_right (A B C : Matrix ι κ ℝ) :
