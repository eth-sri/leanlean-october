-  have hn' : |η| < |A i j| := lt_of_not_ge hn
-  have hp : 0 < (|A i j| - |η|) * (|A i j| + |η|) :=
-    mul_pos (sub_pos.mpr hn') (by linarith [abs_nonneg η])
-  nlinarith [sq_abs (A i j), sq_abs η]
-
