-    (OuterFactors q o × boundedConeCoordinates d r) ≃ₜ outerConeRegion q d o r where
-  toFun := fun p => ⟨(p.1,p.2.val),p.2.property⟩
-  invFun := fun p => (p.val.1,⟨p.val.2,p.property⟩)
