-    NormSphere (EuclideanSpace ℝ (Fin n)) ≃ₜ UnitSphere (Fin n) :=
-  Homeomorph.setCongr (by
-    ext x
-    change ‖x‖ = 1 ↔ dist x 0 = 1
-    rw [dist_zero_right])
