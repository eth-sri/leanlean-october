-/-- Globally defined matrix update; Z need not already be tangent. -/
-def pointCayleyStep (b₁ b₂ : Fin n → ℕ) (X Z : Mat n) (t : ℝ) : Mat n :=
-  unitCayley (t • balancedLeft b₁ b₂ X Z) * X *
-    unitCayley (t • balancedRight b₁ b₂ X Z)
