+  have h := LinearMap.finrank_range_add_finrank_ker (derivLevel Q o).toLinearMap
+  rw [level_onto Q o hne,finrank_top] at h
+  simpa [Anchors,Width,Module.finrank_pi_fintype,add_mul,Nat.add_comm] using h
+end GS.Spectral
