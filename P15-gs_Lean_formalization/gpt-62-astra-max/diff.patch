-@[simp] theorem pointCayleyStep_zero_vector (b₁ b₂ : Fin n → ℕ) (X : Mat n) (t : ℝ) :
-    pointCayleyStep b₁ b₂ X 0 t = X := by simp [pointCayleyStep]
-
-end GS.GlobalGeometry
