-    have hld := Nat.mod_add_div l.val b
-    rw [hk', he'] at hkd
-    rw [hl'] at hld
-    omega
-  · intro k _
-    refine ⟨localBlockIndex hb hbn i k, ?_, ?_⟩
-    · simp [s]
-    · exact Fin.ext (localBlockIndex_mod hb hbn i k)
-  · intro k hk
-    have hk' : k.val / b = i.val / b := (Finset.mem_filter.mp hk).2
