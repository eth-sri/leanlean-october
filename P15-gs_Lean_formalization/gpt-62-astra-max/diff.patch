-/-- Ambient realization of a vector in the genuine total tangent bundle. -/
-def tangentAmbient
-    (p : TangentBundle (𝓘(ℝ, PairModel b₁ b₂)) (MatrixOrbit b₁ b₂ (permMatrix σ))) :
