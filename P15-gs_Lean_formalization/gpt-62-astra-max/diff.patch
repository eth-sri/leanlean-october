-  let s : Set (Fin n) := {i | d i ≠ 0}
-  have hv : Orthonormal ℝ (s.restrict v) := by
-    rw [orthonormal_iff_ite]
-    intro i j
-    change ⟪(d i)⁻¹ • f i, (d j)⁻¹ • f j⟫_ℝ = _
-    rw [real_inner_smul_left, inner_smul_right, hgram]
