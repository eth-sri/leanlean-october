-  · simpa only [Set.mem_preimage, horizontalProjected_zero] using hWzero
-  · intro h hh
-    exact e.left_inv hh.1
-  · intro h hh
-    have hi : ContDiffAt ℝ ⊤ e.symm (horizontalProjected b₁ b₂ σ h) :=
