-    (p : TangentBundle (𝓘(ℝ, HorizontalModel right left P))
-      (MatrixOrbit right left P) ×
-      TangentBundle (𝓘(ℝ, HorizontalModel right left P))
-        (MatrixOrbit right left P)) : ℝ :=
