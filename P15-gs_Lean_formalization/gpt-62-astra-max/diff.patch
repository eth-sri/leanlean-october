-  let V : Set (Mat q) := (fun H : Mat q => Hᵀ) ⁻¹' U ∩
-    (fun H : Mat q => -H) ⁻¹' U
-  have hV : IsOpen V :=
-    (hU.preimage (by fun_prop)).inter (hU.preimage (by fun_prop))
-  refine ⟨V,hV,?_,?_⟩
-  · exact ⟨by simpa using h0, by simpa using h0⟩
-  · intro H hH ho
