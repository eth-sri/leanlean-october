-  obtain ⟨H,hH,hHn,hHA⟩ := hlog _ hAL (gaugeMiddle_orthogonal D E hD hE 0 A hA)
-  obtain ⟨K,hK,hKn,hKB⟩ := hlog _ hBL (gaugeMiddle_orthogonal D E hD hE 1 B hB)
