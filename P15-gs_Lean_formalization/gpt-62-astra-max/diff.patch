-  obtain ⟨a, a_in_imgs⟩ := imgs_nonempty
-  have a_in_s : a ∈ s := (Finset.mem_filter.1 a_in_imgs).1
-  have a_infinite_preimage : ¬Set.Finite (e ⁻¹' {a}) := (Finset.mem_filter.1 a_in_imgs).2
