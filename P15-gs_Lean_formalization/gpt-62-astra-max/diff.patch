-    PuncturedNormBall E r :=
-  ⟨(r / 2) • v.val, by
-    have hn : ‖(r / 2) • v.val‖ = r / 2 := by
-      rw [norm_smul, Real.norm_eq_abs, abs_of_pos (by linarith), v.property, mul_one]
-    refine ⟨by rw [hn]; linarith, ?_⟩
-    intro hz
-    rw [hz, norm_zero] at hn
-    linarith⟩
