-    (hA : SharedOrthogonalFactor b τ A) (ha : admissible A) :
-    cayley A ∈ sharedSkewSpace b τ := by
-  have hm := cayley_mem_sharedMatrixSpace hb hbn ⟨hA.1, hA.2.2⟩ ha
-  exact ⟨hm.1, cayley_isSkew A hA.2.1 ha, hm.2⟩
