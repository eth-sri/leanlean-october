-    FactorGroup block₁ block₂ → CMat n := fun g => g • P
-
-theorem continuous_orbitMap (block₁ block₂ : Fin n → ℕ) (P : CMat n) :
-    Continuous (orbitMap block₁ block₂ P) := by
-  exact continuous_id.smul continuous_const
-
