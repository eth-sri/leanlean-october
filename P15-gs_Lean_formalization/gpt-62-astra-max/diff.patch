-/-- Squared metric norm, expressed without installing a conflicting chart norm. -/
-def tangentEnergy
-    (p : TangentBundle (𝓘(ℝ, PairModel b₁ b₂)) (MatrixOrbit b₁ b₂ (permMatrix σ))) :
