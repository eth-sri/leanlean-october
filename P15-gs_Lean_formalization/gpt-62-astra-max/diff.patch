-      unfold frobSq
-      rw [frobInner_smul_left,frobInner_comm A ((1/2 : ℝ) • A),frobInner_smul_left]
-      ring
-    dsimp [c,z]
-    rw [hscale,hscale,frobSq_add,frobSq_sub]
-    ring
-  refine ⟨c,z,hc,hz,?_,?_,?_,?_⟩
-  · linarith [frobSq_nonneg z]
-  · linarith [frobSq_nonneg c]
