-  (Factor.ofMatrix (unitCayley (t • v.1.val)) (unitCayley_shared left (t • v.1)),
-   Factor.ofMatrix ((unitCayley (t • v.2.val))ᵀ)
-     (shared_factor_transpose (unitCayley_shared right (t • v.2))))
