-theorem shared_factor_transpose (hA : SharedOrthogonalFactor b τ A) :
-    SharedOrthogonalFactor b τ Aᵀ :=
-  ⟨hA.1.transpose, hA.2.1.transpose, hA.2.2.transpose⟩
