-def InSharedA2Unitary (b₁ b₂ : ℕ) (τ₁ τ₂ : ℕ → ℕ) (P X : CMat n) : Prop :=
-  ∃ L R : CMat n, SharedUnitaryFactor b₂ τ₂ L ∧
-    SharedUnitaryFactor b₁ τ₁ R ∧ X = GS.UnitaryGeometry.product2 L P R
-
-instance factorsMulAction (right left : Pattern n) :
