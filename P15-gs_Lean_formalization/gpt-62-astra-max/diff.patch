-    (g := fun p : HorizontalModel right left P × ℝ => cayleyTangentStep right left P X p.1 p.2)
-    (f := fun v : HorizontalModel right left P => (v, (1 : ℝ)))
-    (cayleyTangentStep_joint_contMDiff right left P X) hi
