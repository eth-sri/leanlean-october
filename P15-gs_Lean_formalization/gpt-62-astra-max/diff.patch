-theorem diagonalTwo_mul {D E : Mat 2} (hD : DiagonalTwo D) (hE : DiagonalTwo E) :
-    DiagonalTwo (D*E) := by
-  constructor <;> simp [Matrix.mul_apply,Fin.sum_univ_two,hD.1,hD.2,hE.1,hE.2]
