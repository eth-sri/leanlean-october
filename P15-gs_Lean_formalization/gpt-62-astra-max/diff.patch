-def determinantObstruction (A : Mat 6) : Prop :=
-  let d := absDetBlock A
-  (1-d 0 2*d 1 0/d 2 1)*(1-d 0 2*d 2 1/d 1 0) ≥ d 0 0*d 2 2/d 1 1
