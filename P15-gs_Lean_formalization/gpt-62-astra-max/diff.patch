-    (v w : TangentSpace (𝓘(ℝ, HorizontalModel b₁ b₂ σ)) X) : ℝ :=
-  cFrobInner (inclusionDifferential b₁ b₂ σ X v)
-    (inclusionDifferential b₁ b₂ σ X w)
