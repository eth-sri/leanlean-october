-    TangentSpace (𝓘(ℝ, HorizontalModel b₁ b₂ σ)) X →L[ℝ] CMat n :=
-  mfderiv (𝓘(ℝ, HorizontalModel b₁ b₂ σ)) (𝓘(ℝ, CMat n))
-    (fun Y : MatrixOrbit b₁ b₂ (cPermMatrix σ) => Y.val) X
