-/-- Smoothness of the feasible curve in the actual orbit atlas. -/
-theorem cayleyTangentStep_contMDiff
-    (X : MatrixOrbit right left P)
-    (v : TangentSpace (𝓘(ℝ, HorizontalModel right left P)) X) :
