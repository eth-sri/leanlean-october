-  have hg_in : ∀ n, g n ∈ preimage := by
-    intro n
-    induction' n with n ih
-    · simp [g, mk_subseq]; exact f_in 0
-    · simp [g, mk_subseq]; exact f_in (g n)
-  have hg_strict : StrictMono g := by
-    intro m n hmn
-    induction' hmn with n hmn ih
