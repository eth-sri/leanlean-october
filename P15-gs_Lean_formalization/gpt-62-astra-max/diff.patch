-      _ = ∑ k, ⟪e₀ i, e k⟫_ℂ * ⟪e k, f j⟫_ℂ :=
-        (e.sum_inner_mul_inner _ _).symm
-      _ = (V*R) i j := rfl
-  exact ⟨V,R,ho,ht,he⟩
-
-end GS.UnitaryGeometry
