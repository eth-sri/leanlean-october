-    rintro X ⟨h, hh, rfl⟩
-    rw [horizontalPoint_val, (projectedSliceData right left P).left_inverse h hh.1]
-  right_inverse := by
-    intro h hh
-    rw [horizontalPoint_val]
-    exact (projectedSliceData right left P).left_inverse h hh.1
