-  invFun := fun y => ⟨⟨y.val,hsub y.property⟩,y.property⟩
-  left_inv := by intro x; rfl
-  right_inv := by intro y; rfl
-  continuous_toFun := by fun_prop
-  continuous_invFun := by fun_prop
