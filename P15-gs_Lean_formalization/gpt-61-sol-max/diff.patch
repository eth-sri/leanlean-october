-  simp only [cayley, Matrix.mul_assoc, inv_mul (1 + A) hA, Matrix.mul_one]
-
-theorem one_add_cayley_mul (A : Mat n) (hA : admissible A) :
-    (1 + cayley A) * (1 + A) = (2 : ℝ) • (1 : Mat n) := by
-  rw [Matrix.add_mul, Matrix.one_mul, cayley_mul A hA]
-  rw [two_smul ℝ]
-  abel
