-  left_inv := by
-    rintro ⟨a, i⟩
-    fin_cases a <;> simp
-  right_inv := by
-    intro x
-    cases x <;> simp
-
-/-- Sum-indexed square matrices in the original consecutive scalar order. -/
-def squareFlatten {p : ℕ} (A : Matrix (Fin p ⊕ Fin p) (Fin p ⊕ Fin p) ℝ) :
-    Mat (2*p) :=
-  flattenBlocks (pullMatrix (twoProdSumEquiv p) A)
