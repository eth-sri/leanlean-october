@@ -0,0 +1,32 @@
+import GS.MatrixGeometry.Inner
+noncomputable section
+namespace GS.MatrixBase
+variable {𝕜 : Type} [RCLike 𝕜]
+
+variable (D : KMat 𝕜 n →L[ℝ] ℝ)
+
+variable (f : KMat 𝕜 n → ℝ)
+
+
+
+
+
+
+def dualMatrix  : KMat 𝕜 n :=
+  decodeCFrob ((InnerProductSpace.toDual ℝ (CFrobCoordinates 𝕜 n)).symm
+    (D.comp (decodeCFrob : CFrobCoordinates 𝕜 n →ₗ[ℝ] KMat 𝕜 n).toContinuousLinearMap))
+
+theorem functional_eq_cFrobInner  (A : KMat 𝕜 n) :
+    D A = cFrobInner (dualMatrix D) A := by
+  rw [← encodeCFrob_inner]
+  unfold dualMatrix
+  rw [encode_decode_cFrob, InnerProductSpace.toDual_symm_apply]
+  rfl
+
+
+
+def ambientGradient  (X : KMat 𝕜 n) : KMat 𝕜 n :=
+  dualMatrix (fderiv ℝ f X)
+
+
+end GS.MatrixBase
diff --git a/GS/MatrixGeometry/FactorCharts.lean b/GS/MatrixGeometry/FactorCharts.lean
new file mode 100644
index 000000000..735f7afce
--- /dev/null
+++ b/GS/MatrixGeometry/FactorCharts.lean
@@ -0,0 +1,162 @@
+import GS.MatrixGeometry.Base
+
+import GS.MatrixGeometry.Factors
+import Mathlib.Geometry.Manifold.IsManifold.Basic
+import Mathlib.Geometry.Manifold.Algebra.LieGroup
+import Mathlib.Geometry.Manifold.ContMDiff.NormedSpace
+
+
+
+/-!
+# A Cayley atlas on the actual shared factor group
+
+The chart model is the concrete subspace of supported tied skew-Hermitian matrices.
+The source uses the existing matrix topology, and its inverse is defined on
+the entire model.  Transition functions are restrictions of rational ambient
+matrix formulas.  This establishes the factor manifold, not yet the shared
+matrix-orbit manifold or its tangent bundle.
+-/
+
+noncomputable section
+attribute [local instance] Matrix.normedAddCommGroup Matrix.normedSpace
+open Matrix GS.MatrixBase
+namespace GS.MatrixGeometry
+variable {𝕜 : Type} [RCLike 𝕜]
+variable  {s : Pattern 𝕜 n}
+variable (Q : Factor s)
+
+variable (C : Generator s)
+
+variable (U : Factor s)
+
+variable (A : KMat 𝕜 n)
+
+/-- A total continuous linear extension of the shared chart coordinates. -/
+def modelProjection (s : Pattern 𝕜 n) : KMat 𝕜 n →L[ℝ] Generator s :=
+  (cFrobProjection (sharedSkewSpace s.size s.label)).codRestrict _ (cFrobProjection_mem _)
+
+
+theorem modelProjection_val_of_mem (s : Pattern 𝕜 n) (A : KMat 𝕜 n)
+    (hA : A ∈ sharedSkewSpace s.size s.label) : (modelProjection s A).val = A :=
+  cFrobProjection_of_mem _ _ hA
+
+@[simp] theorem modelProjection_inclusion  :
+    modelProjection s C.val = C := by simp_all [modelProjection_val_of_mem,Subtype.ext]
+
+/-- Open neighbourhood of Q inside the inherited shared-factor topology. -/
+def factorSource  : Set (Factor s) :=
+  {U | admissible ((Factor.matrix Q)ᴴ * Factor.matrix U)}
+
+def factorCoordinates   : Generator s :=
+  modelProjection s (cayley ((Factor.matrix Q)ᴴ * A))
+
+/-- All shared skew coordinates reconstruct valid shared unitary factors. -/
+def reconstruct   : Factor s :=
+  Q * Factor.ofMatrix (cayley C.val) (cayley_shared s.positive s.divides C.property)
+
+@[simp] theorem reconstruct_matrix   :
+    Factor.matrix (reconstruct Q C) = Factor.matrix Q * cayley C.val := rfl
+
+theorem factorSource_open  : IsOpen (factorSource Q) :=
+  admissible_open.preimage
+    (GS.MatrixBase.continuous_matrix_product continuous_const Factor.continuous_matrix)
+
+@[simp] theorem base_mem_factorSource  : Q ∈ factorSource Q := by
+  change admissible ((Factor.matrix Q)ᴴ * Factor.matrix Q)
+  rw [(Factor.matrix_unitary Q).1]
+  exact admissible_one
+
+theorem centered_reconstruct   :
+    (Factor.matrix Q)ᴴ * Factor.matrix (reconstruct Q C) = cayley C.val := by
+  rw [reconstruct_matrix, ← Matrix.mul_assoc, (Factor.matrix_unitary Q).1,
+    Matrix.one_mul]
+
+theorem reconstruct_mem_source   :
+    reconstruct Q C ∈ factorSource Q := by
+  change admissible ((Factor.matrix Q)ᴴ * Factor.matrix (reconstruct Q C))
+  rw [centered_reconstruct]
+  exact admissible_cayley C.val (admissible_of_isSkew C.val C.property.2.1)
+
+theorem centered_cayley_shared  (hU : U ∈ factorSource Q) :
+    cayley ((Factor.matrix Q)ᴴ * Factor.matrix U) ∈ sharedSkewSpace s.size s.label :=
+by
+  have h := shared_factor_mul s.positive s.divides
+    (shared_factor_conjTranspose (Factor.matrix_shared Q)) (Factor.matrix_shared U)
+  have hm := cayley_mem_sharedMatrixSpace s.positive s.divides ⟨h.1,h.2.2⟩ hU
+  exact ⟨hm.1,cayley_isSkew _ h.2.1 hU,hm.2⟩
+
+
+
+@[simp] theorem factorCoordinates_reconstruct   :
+    factorCoordinates Q (Factor.matrix (reconstruct Q C)) = C := by
+  unfold factorCoordinates
+  rw [centered_reconstruct,
+    cayley_involutive C.val (admissible_of_isSkew C.val C.property.2.1)]
+  exact modelProjection_inclusion C
+
+theorem reconstruct_factorCoordinates  (hU : U ∈ factorSource Q) :
+    reconstruct Q (factorCoordinates Q (Factor.matrix U)) = U := by
+  apply Factor.matrix_injective
+  rw [reconstruct_matrix, show (factorCoordinates Q (Factor.matrix U)).val = _ from
+    modelProjection_val_of_mem s _ (centered_cayley_shared Q U hU), cayley_involutive _ hU,
+    ← Matrix.mul_assoc, (Factor.matrix_unitary Q).2, Matrix.one_mul]
+
+@[simp] theorem reconstruct_zero  : reconstruct Q 0 = Q := by
+  apply Factor.matrix_injective
+  simp only [reconstruct_matrix, Submodule.coe_zero, cayley_zero, Matrix.mul_one]
+
+
+
+theorem factorCoordinates_smooth_at  
+    (hA : admissible ((Factor.matrix Q)ᴴ * A)) :
+    ContDiffAt ℝ ⊤ (factorCoordinates Q) A :=
+  (modelProjection s).contDiff.contDiffAt.comp A
+    (smooth_cayley_comp_at (smooth_mul_at contDiffAt_const contDiffAt_id) hA)
+
+theorem reconstruct_matrix_smooth  :
+    ContDiff ℝ ⊤ (fun C : Generator s => Factor.matrix (reconstruct Q C)) := by
+  simp only [reconstruct_matrix]
+  apply contDiff_iff_contDiffAt.mpr; intro C
+  exact smooth_mul_at contDiffAt_const
+    (smooth_cayley_comp_at (by fun_prop) (admissible_of_isSkew _ C.property.2.1))
+
+
+@[fun_prop] theorem continuous_reconstruct  : Continuous (reconstruct Q) :=
+  ((reconstruct_matrix_smooth Q).continuous.subtype_mk _).subtype_mk _
+
+/-- A total extension on each side, with an open source and full linear target. -/
+def factorPartialChart  : OpenPartialHomeomorph (Factor s) (Generator s) where
+  toFun U := factorCoordinates Q (Factor.matrix U)
+  invFun := reconstruct Q
+  source := factorSource Q
+  target := Set.univ
+  map_source' _ _ := Set.mem_univ _
+  map_target' C _ := reconstruct_mem_source Q C
+  left_inv' U hU := reconstruct_factorCoordinates Q U hU
+  right_inv' C _ := factorCoordinates_reconstruct Q C
+  open_source := factorSource_open Q
+  open_target := isOpen_univ
+  continuousOn_toFun := by
+    intro U hU
+    exact ((factorCoordinates_smooth_at Q (Factor.matrix U) hU).continuousAt.comp
+      Factor.continuous_matrix.continuousAt).continuousWithinAt
+  continuousOn_invFun := (continuous_reconstruct Q).continuousOn
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+end GS.MatrixGeometry
diff --git a/GS/MatrixGeometry/FactorCoordinates.lean b/GS/MatrixGeometry/FactorCoordinates.lean
new file mode 100644
index 000000000..bddd0e199
--- /dev/null
+++ b/GS/MatrixGeometry/FactorCoordinates.lean
@@ -0,0 +1,142 @@
+import Mathlib.Tactic
+import GS.MatrixGeometry.Base
+
+import GS.MatrixGeometry.Differential
+import GS.OverlapGeometry.FactorChartOpen
+
+
+set_option backward.isDefEq.respectTransparency false
+/-!
+# Product coordinates on the genuine shared factor group
+
+The existing single-factor charts have full generator-space targets.  Their
+product reconstruction is therefore open in the inherited factor topology.
+This module also records its ambient differential and the differentiated
+coordinate inverse; no orbit atlas is assumed.
+-/
+
+noncomputable section
+attribute [local instance] Matrix.normedAddCommGroup Matrix.normedSpace
+open Matrix GS.MatrixBase
+namespace GS.MatrixGeometry
+variable {𝕜 : Type} [RCLike 𝕜]
+variable  {s right left : Pattern 𝕜 n}
+
+variable (Q : Factor s) (g : Factors right left) (P : KMat 𝕜 n)
+
+variable (v : Generator s)
+
+/-- The actual matrix formula for the inverse of a shared factor chart. -/
+def matrixReconstruct  : KMat 𝕜 n :=
+  Factor.matrix (reconstruct Q v)
+
+@[simp] theorem matrixReconstruct_zero :
+    matrixReconstruct Q 0 = Factor.matrix Q := by simp_all [reconstruct_zero,matrixReconstruct]
+
+theorem matrixReconstruct_smooth :
+    ContDiff ℝ ⊤ (matrixReconstruct Q) := reconstruct_matrix_smooth Q
+
+@[simp] theorem factorCoordinates_matrixReconstruct  :
+    factorCoordinates Q (matrixReconstruct Q v) = v :=
+  factorCoordinates_reconstruct Q v
+
+/-- Differentiate the concrete total inverse chart, not an assigned tangent map. -/
+theorem matrixReconstruct_fderiv_zero  :
+    fderiv ℝ (matrixReconstruct Q) 0 v =
+      (-2 : ℝ) • (Factor.matrix Q * v.val) := by
+  have hi := ((matrixReconstruct_smooth Q).differentiable (by simp) 0).hasFDerivAt
+  have hl  := by
+    simpa using (hasDerivAt_id (0 : ℝ)).smul_const v
+  exact (hi.comp_hasDerivAt_of_eq 0 hl (by simp)).unique
+    (reconstruct_line_hasDerivAt_zero Q v)
+
+/-- The ambient coordinate extension is a left inverse of the actual inverse-
+chart derivative at every generator, not only at the chart centre. -/
+theorem coordinateDerivative_reconstruct  :
+    (fderiv ℝ (factorCoordinates Q) (matrixReconstruct Q v)).comp
+      (fderiv ℝ (matrixReconstruct Q) v) =
+        ContinuousLinearMap.id ℝ (Generator s) := by
+  rw [← fderiv_comp v
+    ((factorCoordinates_smooth_at Q (matrixReconstruct Q v)
+      (reconstruct_mem_source Q v)).differentiableAt (by simp))
+    ((matrixReconstruct_smooth Q).differentiable (by simp) v)]
+  simp only [Function.comp_def, factorCoordinates_matrixReconstruct]
+  exact fderiv_id
+
+/-- Source of the product of the existing single-factor charts. -/
+def pairSource : Set (Factors right left) :=
+  factorSource g.1 ×ˢ factorSource g.2
+
+variable (X : MatrixOrbit right left P)
+
+variable (v : PairGenerator right left)
+
+
+def pairCoordinates (h : Factors right left) : PairGenerator right left :=
+  (factorCoordinates g.1 (Factor.matrix h.1),
+    factorCoordinates g.2 (Factor.matrix h.2))
+
+theorem pairSource_open : IsOpen (pairSource g) :=
+  (factorSource_open g.1).prod (factorSource_open g.2)
+
+@[simp] theorem self_mem_pairSource : g ∈ pairSource g :=
+  ⟨base_mem_factorSource g.1, base_mem_factorSource g.2⟩
+
+
+
+theorem factorLift_pairCoordinates (h : Factors right left) (hh : h ∈ pairSource g) : factorLift g (pairCoordinates g h) = h := by
+  apply Prod.ext
+  · exact reconstruct_factorCoordinates g.1 h.1 hh.1
+  · exact reconstruct_factorCoordinates g.2 h.2 hh.2
+
+
+
+theorem reconstruct_isOpenMap : IsOpenMap (reconstruct Q) := by
+  intro U hU
+  exact (factorPartialChart Q).isOpen_image_symm_of_subset_target hU
+    (by tauto)
+
+/-- Positively dimensional stabilizers do not affect openness of reconstruction. -/
+theorem factorLift_isOpenMap : IsOpenMap (factorLift g) :=
+  (reconstruct_isOpenMap g.1).prodMap (reconstruct_isOpenMap g.2)
+
+theorem factorLift_orbit_isOpenMap :
+    IsOpenMap (fun v : PairGenerator right left =>
+      orbitMapToOrbit right left P (factorLift g v)) :=
+  (orbitMapToOrbit_isOpenMap P).comp (factorLift_isOpenMap g)
+
+/-- Smooth linear action of any fixed shared factor pair on ambient matrices. -/
+theorem fixed_action_smooth :
+    ContDiff ℝ ⊤ (fun A : KMat 𝕜 n => g • A) := by
+  change ContDiff ℝ ⊤ (fun A : KMat 𝕜 n => Factor.matrix g.1 * A * (Factor.matrix g.2)ᴴ)
+  fun_prop
+
+/-- A fixed representative is used only to centre a chart.  No continuity
+of this choice function is asserted or used. -/
+def preferredFactor  : Factors right left :=
+  Classical.choose X.property
+
+@[simp] theorem preferredFactor_spec  :
+    orbitMapToOrbit right left P (preferredFactor P X) = X := by
+  apply Subtype.ext
+  exact Classical.choose_spec X.property
+
+/-- A total matrix-orbit parametrization; only injectivity will be local. -/
+def orbitInverse (g : Factors right left) (v : PairGenerator right left) := orbitMapToOrbit right left P (factorLift g v)
+
+
+
+/-- Fixed group translation of the total factor chart. -/
+theorem factorLift_eq_mul  :
+    factorLift g v = g * factorLift (1 : Factors right left) v := by
+  apply Prod.ext
+  · change reconstruct g.1 v.1 = g.1 * reconstruct (1 : Factor left) v.1
+    simp only [reconstruct, one_mul]
+  · change reconstruct g.2 v.2 = g.2 * reconstruct (1 : Factor right) v.2
+    simp only [reconstruct, one_mul]
+
+/-- This identity is global in the coordinate model. -/
+theorem orbitParam_eq_translate  :
+    orbitParam g P v = g • orbitParam (1 : Factors right left) P v := by grind [orbitParam,factorLift_eq_mul,mul_smul]
+
+end GS.MatrixGeometry
diff --git a/GS/MatrixGeometry/Factors.lean b/GS/MatrixGeometry/Factors.lean
new file mode 100644
index 000000000..dac399bb2
--- /dev/null
+++ b/GS/MatrixGeometry/Factors.lean
@@ -0,0 +1,92 @@
+import GS.MatrixGeometry.Base
+
+import GS.MatrixGeometry.Sharing
+
+
+
+
+/-!
+# Compact groups of repeated physical unitary blocks
+
+`Pattern` records only the block size, its positivity/divisibility, and the
+within-layer sharing labels.  `Factor` is a closed subgroup of the existing
+block unitary group, with the inherited matrix topology.  In particular,
+no group law or topology is imposed on a parametrized image by fiat.
+-/
+
+open Matrix GS.MatrixBase
+namespace GS.MatrixGeometry
+variable {𝕜 : Type} [RCLike 𝕜]
+
+/-- A valid complete-block layout and arbitrary within-layer sharing labels.
+Unused labels are allowed; different layers have independent patterns. -/
+structure Pattern (𝕜 : Type) (n : ℕ) where
+  size : ℕ
+  positive : 0 < size
+  divides : size ∣ n
+  label : ℕ → ℕ
+
+namespace Pattern
+
+def block (s : Pattern 𝕜 n) (i : Fin n) : ℕ := i.val / s.size
+
+/-- Actual entry equalities define a subgroup of the already constructed
+block unitary group. -/
+def subgroup (s : Pattern 𝕜 n) : Subgroup (GS.MatrixBase.BlockU 𝕜 s.block) where
+  carrier := {A | TiedEntries s.size s.label A.val}
+  one_mem' := TiedEntries.one s.size s.label
+  mul_mem' := by
+    intro A B hA hB
+    exact TiedEntries.mul s.positive s.divides A.property.1 hA hB
+  inv_mem' := by
+    intro A hA
+    exact hA.conjTranspose
+
+theorem subgroup_isClosed (s : Pattern 𝕜 n) :
+    IsClosed (s.subgroup : Set (GS.MatrixBase.BlockU 𝕜 s.block)) :=
+  (isClosed_tiedEntries s.size s.label).preimage continuous_subtype_val
+
+end Pattern
+
+abbrev Factor (s : Pattern 𝕜 n) := ↥s.subgroup
+abbrev Generator (s : Pattern 𝕜 n) := ↥(sharedSkewSpace (𝕜 := 𝕜) (n := n) s.size s.label)
+
+namespace Factor
+variable {s : Pattern 𝕜 n}
+
+/-- The original finite matrix, through the two inherited subtypes. -/
+def matrix (A : Factor s) : KMat 𝕜 n := A.val.val
+
+@[simp] theorem matrix_inv {s : Pattern 𝕜 n} (Q : Factor s) :
+    Factor.matrix Q⁻¹ = (Factor.matrix Q)ᴴ := rfl
+
+
+@[simp] theorem matrix_one : matrix (1 : Factor s) = 1 := rfl
+
+
+
+theorem matrix_shared (A : Factor s) : SharedUnitaryFactor s.size s.label (matrix A) :=
+  ⟨A.val.property.1, A.val.property.2, A.property⟩
+
+theorem matrix_unitary (A : Factor s) : GS.MatrixBase.Unitary (matrix A) := A.val.property.2
+
+theorem matrix_injective : Function.Injective (matrix : Factor s → KMat 𝕜 n) := by
+  intro A B h
+  apply Subtype.ext
+  exact Subtype.ext h
+
+theorem continuous_matrix : Continuous (matrix : Factor s → KMat 𝕜 n) :=
+  continuous_subtype_val.comp continuous_subtype_val
+
+def ofMatrix (A : KMat 𝕜 n) (hA : SharedUnitaryFactor s.size s.label A) : Factor s :=
+  ⟨⟨A, hA.1, hA.2.1⟩, hA.2.2⟩
+
+end Factor
+
+instance factorCompactSpace (s : Pattern 𝕜 n) : CompactSpace (Factor s) :=
+  isCompact_iff_compactSpace.mp s.subgroup_isClosed.isCompact
+
+/-- The two layers can use unrelated sharing maps and block sizes. -/
+abbrev Factors (right left : Pattern 𝕜 n) := Factor left × Factor right
+
+end GS.MatrixGeometry
diff --git a/GS/MatrixGeometry/GeneratorAction.lean b/GS/MatrixGeometry/GeneratorAction.lean
new file mode 100644
index 000000000..a73002bde
--- /dev/null
+++ b/GS/MatrixGeometry/GeneratorAction.lean
@@ -0,0 +1,68 @@
+import Mathlib.Tactic
+import GS.MatrixGeometry.Base
+
+import GS.MatrixGeometry.MinimumNormLift
+
+
+
+/-!
+# Equivariance of the minimum-physical-norm shared lift
+
+Both spatial generators transform by unitary conjugation. This preserves
+the actual tied generator spaces, their physical Frobenius pairing, and the
+synthesis kernel. Uniqueness of the horizontal lift then proves equivariance
+without choosing a section of the orbit map.
+-/
+
+open Matrix GS.MatrixBase
+namespace GS.MatrixGeometry
+variable {𝕜 : Type} [RCLike 𝕜]
+variable  {right left : Pattern 𝕜 n}
+variable (g : Factors right left)
+
+variable (v w : PairGenerator right left)
+
+variable (A C X Z : KMat 𝕜 n)
+
+private theorem conjugate_cancel  (hA : GS.MatrixBase.Unitary A) :
+    Aᴴ * (A * C * Aᴴ) * A = C := by
+  calc
+    _ = (Aᴴ * A) * C * (Aᴴ * A) := by noncomm_ring
+    _ = _ := by rw [hA.1]; simp
+
+@[simp] theorem generatorAction_inverse   :
+    generatorAction g⁻¹ (generatorAction g v) = v := by grind [generatorAction_left,generatorAction_right,Factor.matrix_inv,Factor.matrix_unitary,conjugate_cancel,Prod.fst_inv,Prod.snd_inv,Matrix.conjTranspose_conjTranspose]
+
+@[simp] theorem generatorAction_inverse_right   :
+    generatorAction g (generatorAction g⁻¹ v) = v := by grind [generatorAction_inverse,inv_inv]
+
+theorem generatorInner_action   :
+    generatorInner (generatorAction g v) (generatorAction g w) = generatorInner v w := by
+  grind [generatorInner, GS.MatrixBase.Unitary.conjTranspose, Factor.matrix_unitary, generatorAction_left, generatorAction_right, GS.MatrixBase.cFrobInner_left_unitary, GS.MatrixBase.cFrobInner_right_unitary]
+
+theorem generatorAction_horizontal  
+    (v : PairGenerator right left) (hv : IsHorizontal X v) :
+    IsHorizontal (g • X) (generatorAction g v) := by
+  intro k hk
+  have hb : pointMap right left X (generatorAction g⁻¹ k) = 0 := by
+    have he := pointMap_generatorAction g⁻¹ (g • X) k
+    rw [inv_smul_smul, hk] at he
+    simpa only [action_apply, Matrix.mul_zero, Matrix.zero_mul] using he
+  calc
+    generatorInner (generatorAction g v) k =
+        generatorInner (generatorAction g v) (generatorAction g (generatorAction g⁻¹ k)) := by aesop
+    _ = generatorInner v (generatorAction g⁻¹ k) := generatorInner_action g v _
+    _ = 0 := hv _ hb
+
+/-- The selected lift is independent of all choices made in its existence proof. -/
+theorem minimumNormLift_equivariant   :
+    minimumNormLift right left (g • X) (g • Z) =
+      generatorAction g (minimumNormLift right left X Z) := by
+  symm
+  apply minimumNormLift_unique
+  · rw [pointMap_generatorAction, minimumNormLift_synthesis, pointProjection_equivariant]
+  · grind [generatorAction_horizontal,minimumNormLift_horizontal]
+
+
+
+end GS.MatrixGeometry
diff --git a/GS/MatrixGeometry/Gradient.lean b/GS/MatrixGeometry/Gradient.lean
new file mode 100644
index 000000000..79edd2eaf
--- /dev/null
+++ b/GS/MatrixGeometry/Gradient.lean
@@ -0,0 +1,67 @@
+import GS.MatrixGeometry.Base
+
+import GS.MatrixGeometry.TangentBridge
+import GS.MatrixGeometry.Riemannian
+import GS.MatrixGeometry.SmoothProjection
+import Mathlib.Geometry.Manifold.MFDeriv.FDeriv
+
+
+set_option backward.isDefEq.respectTransparency false
+/-!
+# The intrinsic gradient on the genuine shared orbit
+
+The ambient orthogonal projector is lifted into the actual tangent space of
+our horizontal atlas. Its Frobenius pairing is the manifold derivative of the
+restricted loss. The lift, Riesz identity, uniqueness, and stationarity are all
+proved for actual repeated full blocks, without excluding overlap.
+-/
+
+noncomputable section
+attribute [local instance] Matrix.normedAddCommGroup Matrix.normedSpace
+open GS.MatrixBase
+open scoped Manifold
+namespace GS.MatrixGeometry
+variable {𝕜 : Type} [RCLike 𝕜]
+variable  (right left : Pattern 𝕜 n) (P : KMat 𝕜 n)
+variable (X : MatrixOrbit right left P)
+
+local instance gradientHorizontalNormedSpace : NormedSpace ℝ (HorizontalModel right left P) :=
+  Submodule.normedSpace _
+local instance gradientChartedSpace : ChartedSpace (HorizontalModel right left P)
+    (MatrixOrbit right left P) := sharedOrbitChartedSpace right left P
+
+
+variable (Z : KMat 𝕜 n)
+
+/-- A canonical tangent lift exists because the already-defined point projector
+lands in the actual differential image. No choice of a new factorization is made. -/
+def tangentProjection  :
+    TangentSpace (𝓘(ℝ, HorizontalModel right left P)) X :=
+  Classical.choose (pointProjection_unique_tangent_lift right left P X Z)
+
+@[simp] theorem inclusion_tangentProjection
+     :
+    inclusionDifferential right left P X (tangentProjection right left P X Z) =
+      pointProjection right left X.val Z :=
+  (Classical.choose_spec (pointProjection_unique_tangent_lift right left P X Z)).1
+
+
+
+@[simp] theorem tangentProjection_zero :
+    tangentProjection right left P X (0 : KMat 𝕜 n) = 0 := by
+  apply inclusionDifferential_injective right left P X
+  simp only [map_zero,inclusion_tangentProjection]
+
+variable (f : KMat 𝕜 n → ℝ)
+
+/-- This vector inhabits mathlib's TangentSpace for the constructed atlas. -/
+def intrinsicGradient 
+    (X : MatrixOrbit right left P) :
+    TangentSpace (𝓘(ℝ, HorizontalModel right left P)) X :=
+  tangentProjection right left P X (ambientGradient f X.val)
+
+
+
+
+
+end GS.MatrixGeometry
diff --git a/GS/MatrixGeometry/GradientSection.lean b/GS/MatrixGeometry/GradientSection.lean
new file mode 100644
index 000000000..29248c688
--- /dev/null
+++ b/GS/MatrixGeometry/GradientSection.lean
@@ -0,0 +1,124 @@
+import Mathlib.Tactic
+import GS.MatrixGeometry.Base
+
+import GS.MatrixGeometry.BundleRetraction
+import GS.MatrixGeometry.Gradient
+import GS.Extensions.TangentSections
+
+
+set_option backward.isDefEq.respectTransparency false
+/-!
+# Smooth intrinsic gradient sections and the exact shared gradient update
+
+The target here is the actual tangent bundle, not only the matrix realization
+of a vector field. To avoid assuming a smooth inverse to the inclusion
+differential, we differentiate the smooth map F(X,Z) = R_X(proj_X Z) in its
+ambient second variable at zero. This constructs the bundled tangent projector
+from mathlib's genuine tangent map. No gradient-section regularity is assumed
+in proving the smoothness of F: its matrix value is an explicit Cayley formula.
+-/
+
+noncomputable section
+attribute [local instance] Matrix.normedAddCommGroup Matrix.normedSpace
+open GS.MatrixBase
+open scoped Manifold
+namespace GS.MatrixGeometry
+variable {𝕜 : Type} [RCLike 𝕜]
+variable  (right left : Pattern 𝕜 n) (P : KMat 𝕜 n)
+local instance gradientSectionNormedSpace : NormedSpace ℝ (HorizontalModel right left P) := Submodule.normedSpace _
+local instance gradientSectionChartedSpace : ChartedSpace (HorizontalModel right left P)
+    (MatrixOrbit right left P) := sharedOrbitChartedSpace right left P
+local instance gradientSectionIsManifold : IsManifold (𝓘(ℝ, HorizontalModel right left P)) ⊤
+    (MatrixOrbit right left P) := sharedOrbitIsManifold right left P
+
+variable (X : MatrixOrbit right left P)
+
+/-- The already constructed pointwise tangent lift, as a continuous linear map. -/
+def tangentProjectionCLM  :
+    KMat 𝕜 n →L[ℝ] HorizontalModel right left P :=
+  ({ toFun := tangentProjection right left P X
+     map_add' := by
+       intro Z W
+       apply inclusionDifferential_injective right left P X
+       simp only [map_add,inclusion_tangentProjection]
+     map_smul' := by
+       intro a Z
+       apply inclusionDifferential_injective right left P X
+       simp only [map_smul,inclusion_tangentProjection,RingHom.id_apply]
+   } : KMat 𝕜 n →ₗ[ℝ] HorizontalModel right left P).toContinuousLinearMap
+
+
+
+variable (p : MatrixOrbit right left P × KMat 𝕜 n)
+
+/-- Ambient-input extension of the retraction, still valued in the exact orbit. -/
+def ambientRetraction  :
+    MatrixOrbit right left P :=
+  cayleyFibreRetraction right left P p.1 (tangentProjection right left P p.1 p.2)
+
+variable (f : KMat 𝕜 n → ℝ)
+
+@[simp] theorem ambientRetraction_val  (Z : KMat 𝕜 n) :
+    (ambientRetraction right left P (X, Z)).val =
+      sharedCayleyValue right left X.val Z 1 := by
+  change sharedCayleyValue right left X.val
+    (inclusionDifferential right left P X (tangentProjection right left P X Z)) 1 = _
+  rw [inclusion_tangentProjection]
+  exact sharedCayleyValue_projected X.val Z 1
+
+@[simp] theorem ambientRetraction_zero  :
+    ambientRetraction right left P (X, 0) = X := by aesop
+
+-- Preserve the abstract subspace interfaces during elaboration. Their defining
+-- terms need not be expanded when comparing manifold and normed-space instances.
+attribute [local irreducible] sharedSkewSpace orbitDerivative GS.OverlapGeometry.horizontalComplement
+
+/-- This proof uses the matrix formula and hence is independent of the desired
+smoothness of the tangent projection as a section. -/
+theorem ambientRetraction_contMDiff :
+    ContMDiff ((𝓘(ℝ, HorizontalModel right left P)).prod (𝓘(ℝ, KMat 𝕜 n)))
+      (𝓘(ℝ, HorizontalModel right left P)) ⊤ (ambientRetraction right left P) := by
+  apply (sharedOrbit_contMDiff_iff_ambient right left P
+    ((𝓘(ℝ, HorizontalModel right left P)).prod (𝓘(ℝ, KMat 𝕜 n)))
+    (ambientRetraction right left P)).mpr
+  have hb : ContMDiff ((𝓘(ℝ, HorizontalModel right left P)).prod (𝓘(ℝ, KMat 𝕜 n)))
+      (𝓘(ℝ, KMat 𝕜 n)) ⊤ (fun p : MatrixOrbit right left P × KMat 𝕜 n => p.1.val) :=
+    (sharedOrbit_val_contMDiff right left P).comp contMDiff_fst
+  have hl := minimumNormLift_contMDiff right left P
+  have h := (generatorCayleyValue_smooth right left).comp_contMDiff
+    (hb.prodMk_space (hl.prodMk_space (contMDiff_const (c := (1 : ℝ)))))
+  exact h.congr (fun ⟨X,Z⟩ => ambientRetraction_val right left P X Z)
+
+/-- The projected ambient vector as an element of the TRUE total tangent bundle. -/
+def tangentProjectionBundle  :
+    TangentBundle (𝓘(ℝ, HorizontalModel right left P)) (MatrixOrbit right left P) :=
+  ⟨p.1, tangentProjection right left P p.1 p.2⟩
+
+/-- Joint smoothness of the actual tangent lift, including its varying base. -/
+theorem tangentProjectionBundle_contMDiff :
+    ContMDiff ((𝓘(ℝ, HorizontalModel right left P)).prod (𝓘(ℝ, KMat 𝕜 n)))
+      (𝓘(ℝ, HorizontalModel right left P)).tangent ⊤
+      (tangentProjectionBundle right left P) := by
+  refine (((ambientRetraction_contMDiff right left P).contMDiff_tangentMap (by simp)).comp
+    (GS.Extensions.contMDiff_vertical_input (M := MatrixOrbit right left P)
+      (V := KMat 𝕜 n) (𝓘(ℝ, HorizontalModel right left P)))).congr ?_
+  rintro ⟨X,Z⟩
+  have h := mfderiv_comp_apply_of_eq
+    (I := 𝓘(ℝ, KMat 𝕜 n)) (f := fun W : KMat 𝕜 n => (X,W)) 0
+    ((ambientRetraction_contMDiff right left P).mdifferentiable (by simp) (X,0))
+    (mdifferentiableAt_const.prodMk mdifferentiableAt_id) rfl Z
+  simp only [TangentSpace, mfderiv_prod_right, ContinuousLinearMap.inr_apply,
+    Function.comp_def] at h
+  have hd := mfderiv_comp_apply_of_eq (0 : KMat 𝕜 n)
+    ((cayleyFibreRetraction_contMDiff right left P X).mdifferentiable (by simp) 0)
+    (tangentProjectionCLM right left P X).mdifferentiableAt
+    (map_zero (tangentProjectionCLM right left P X)) Z
+  simp only [TangentSpace, ContinuousLinearMap.mfderiv_eq,
+    cayleyFibreRetraction_mfderiv_zero, ContinuousLinearMap.id_apply] at hd
+  have hd := h.symm.trans hd
+  dsimp only [Function.comp_def, tangentMap, tangentProjectionBundle]
+  congr 1
+  · aesop
+  · exact hd.symm
+
+end GS.MatrixGeometry
diff --git a/GS/MatrixGeometry/HorizontalDifferential.lean b/GS/MatrixGeometry/HorizontalDifferential.lean
new file mode 100644
index 000000000..70de211b5
--- /dev/null
+++ b/GS/MatrixGeometry/HorizontalDifferential.lean
@@ -0,0 +1,61 @@
+import Mathlib.Tactic
+import GS.MatrixGeometry.Base
+
+import GS.MatrixGeometry.ProjectedSlice
+
+
+/-!
+# The full differential image after removing the shared stabilizer
+
+The complement has the same differential image as the complete factor model
+at every translated centre.  It therefore represents every matrix direction,
+including when shared blocks and cross-layer overlap occur simultaneously.
+-/
+
+noncomputable section
+attribute [local instance] Matrix.normedAddCommGroup Matrix.normedSpace
+open Matrix GS.MatrixBase
+namespace GS.MatrixGeometry
+variable {𝕜 : Type} [RCLike 𝕜]
+variable  {right left : Pattern 𝕜 n}
+local instance horizontalDifferentialNormedSpace (P : KMat 𝕜 n) :
+    NormedSpace ℝ (HorizontalModel right left P) := Submodule.normedSpace _
+
+variable (P : KMat 𝕜 n)
+
+variable (g : Factors right left)
+
+theorem horizontalOrbit_fderiv_zero 
+     (h : HorizontalModel right left P) :
+    fderiv ℝ (fun h : HorizontalModel right left P => orbitParam g P h.val) 0 h =
+      fderiv ℝ (orbitParam g P) 0 h.val := by
+  have hh := ((orbitParam_smooth g P).differentiable (by simp) 0).hasFDerivAt
+  have hd := hh.comp (f := fun h : HorizontalModel right left P => h.val) 0
+    (HorizontalModel right left P).subtypeL.hasFDerivAt
+  convert congrArg (fun D => D h) hd.fderiv using 1 <;> rfl
+
+theorem horizontalOrbit_fderiv_zero_range 
+     (Z : KMat 𝕜 n) :
+    (∃ h : HorizontalModel right left P,
+      fderiv ℝ (fun h : HorizontalModel right left P => orbitParam g P h.val) 0 h = Z) ↔
+      Z ∈ pointDirections right left (g • P) := by
+  rw [← orbitParam_fderiv_zero_range g P Z]
+  constructor
+  · grind [horizontalOrbit_fderiv_zero]
+  · rintro ⟨v, hv⟩
+    let z := (horizontalKernelEquiv right left P).symm v
+    have hz : (z.1.val : PairGenerator right left) + z.2.val = v :=
+      (horizontalKernelEquiv right left P).apply_symm_apply v
+    have hk : fderiv ℝ (orbitParam g P) 0 z.2.val = 0 :=
+      by
+        have hi := orbitParam_intertwine_of_kernel P z.2.val z.2.property
+        rw [orbitParam_fderiv_zero]
+        simp only [GS.MatrixBase.tangentParam,Matrix.smul_mul,Matrix.mul_smul]
+        have he : Factor.matrix g.1 * z.2.val.1.val * P * (Factor.matrix g.2)ᴴ =
+            Factor.matrix g.1 * P * z.2.val.2.val * (Factor.matrix g.2)ᴴ := by grind
+        rw [he,← add_smul]
+        norm_num
+    refine ⟨z.1, ?_⟩
+    rw [horizontalOrbit_fderiv_zero, ← hv, ← hz, map_add, hk, add_zero]
+
+end GS.MatrixGeometry
diff --git a/GS/MatrixGeometry/HorizontalModel.lean b/GS/MatrixGeometry/HorizontalModel.lean
new file mode 100644
index 000000000..e059a9593
--- /dev/null
+++ b/GS/MatrixGeometry/HorizontalModel.lean
@@ -0,0 +1,45 @@
+import GS.MatrixGeometry.Base
+
+import GS.MatrixGeometry.FactorCoordinates
+import GS.OverlapGeometry.HorizontalModel
+
+open GS.MatrixBase
+
+
+/-!
+# Horizontal coordinates for an actual shared orbit
+
+The complement and its continuous ambient left inverse reuse the general
+finite-dimensional constructions.  The differential is the actual derivative
+of the shared factor map.  The carrier P need not be unitary.
+-/
+
+noncomputable section
+attribute [local instance] Matrix.normedAddCommGroup Matrix.normedSpace
+open GS.OverlapGeometry (horizontalComplement complementKernelEquiv horizontalLeftInverse
+  horizontalLeftInverse_apply)
+namespace GS.MatrixGeometry
+variable {𝕜 : Type} [RCLike 𝕜]
+
+variable (right left : Pattern 𝕜 n)
+
+variable (P : KMat 𝕜 n)
+
+/-- The actual differential of the original factor parametrization. -/
+def orbitDerivative   :
+    PairGenerator right left →L[ℝ] KMat 𝕜 n :=
+  fderiv ℝ (orbitParam (1 : Factors right left) P) 0
+
+abbrev OrbitKernel   :=
+  LinearMap.ker (orbitDerivative right left P).toLinearMap
+
+abbrev HorizontalModel   :=
+  horizontalComplement (orbitDerivative right left P)
+
+def horizontalKernelEquiv := complementKernelEquiv (orbitDerivative right left P)
+
+def orbitHorizontalInverse := horizontalLeftInverse (orbitDerivative right left P)
+
+
+
+end GS.MatrixGeometry
diff --git a/GS/MatrixGeometry/Indices.lean b/GS/MatrixGeometry/Indices.lean
new file mode 100644
index 000000000..7c6b06226
--- /dev/null
+++ b/GS/MatrixGeometry/Indices.lean
@@ -0,0 +1,22 @@
+import GS.MatrixGeometry.Base
+namespace GS.GlobalGeometry
+/-- The index with prescribed local coordinate in the physical block of `i`. -/
+def localBlockIndex (hb : 0 < b) (hbn : b ∣ n) (i : Fin n) (k : Fin b) : Fin n :=
+  ⟨i.val / b * b + k.val, by
+    have hin : i.val / b < n / b := (Nat.div_lt_iff_lt_mul hb).mpr (by simp_all [Nat.div_mul_cancel])
+    calc
+      i.val / b * b + k.val < i.val / b * b + b := Nat.add_lt_add_left k.isLt _
+      _ = (i.val / b + 1) * b := by noncomm_ring
+      _ ≤ n / b * b := Nat.mul_le_mul_right b hin
+      _ = n := Nat.div_mul_cancel hbn⟩
+
+@[simp] theorem localBlockIndex_div (hb : 0 < b) (hbn : b ∣ n)
+    (i : Fin n) (k : Fin b) : (localBlockIndex hb hbn i k).val / b = i.val / b := by
+  change (i.val / b * b + k.val) / b = i.val / b
+  rw [Nat.add_comm, Nat.mul_comm, Nat.add_mul_div_left _ _ hb,
+    Nat.div_eq_of_lt k.isLt, Nat.zero_add]
+
+@[simp] theorem localBlockIndex_mod (hb : 0 < b) (hbn : b ∣ n)
+    (i : Fin n) (k : Fin b) : (localBlockIndex hb hbn i k).val % b = k.val := by simp_all [localBlockIndex,Nat.mod_eq_of_lt,Nat.add_mod]
+
+end GS.GlobalGeometry
diff --git a/GS/MatrixGeometry/Inner.lean b/GS/MatrixGeometry/Inner.lean
new file mode 100644
index 000000000..6bda4d017
--- /dev/null
+++ b/GS/MatrixGeometry/Inner.lean
@@ -0,0 +1,146 @@
+import GS.MatrixGeometry.Base
+noncomputable section
+open Matrix InnerProductSpace
+namespace GS.MatrixBase
+variable {𝕜 : Type} [RCLike 𝕜]
+section Rectangular
+variable {ι κ ν : Type*} [Fintype ι] [Fintype κ] [Fintype ν]
+variable (A B C : Matrix ι κ 𝕜)
+
+def cFrobInner : ℝ := ∑ i, ∑ j, RCLike.re (star (A i j)*B i j)
+abbrev cFrobSq : ℝ := cFrobInner A A
+
+theorem cFrobInner_eq_re_trace :
+    cFrobInner A B = RCLike.re (Matrix.trace (Aᴴ*B)) := by
+  simp only [cFrobInner,Matrix.trace,Matrix.diag,Matrix.mul_apply,
+    Matrix.conjTranspose_apply,map_sum]
+  exact Finset.sum_comm
+
+theorem cFrobInner_comm : cFrobInner A B = cFrobInner B A := by
+  simp [cFrobInner,RCLike.mul_re,RCLike.star_def,mul_comm]
+@[simp] theorem cFrobInner_zero_left : cFrobInner 0 A = 0 := by simp [cFrobInner]
+@[simp] theorem cFrobInner_zero_right : cFrobInner A 0 = 0 := by simp [cFrobInner]
+theorem cFrobInner_add_left :
+    cFrobInner (A+B) C = cFrobInner A C+cFrobInner B C := by
+  simp [cFrobInner_eq_re_trace,Matrix.add_mul]
+theorem cFrobInner_add_right :
+    cFrobInner A (B+C) = cFrobInner A B+cFrobInner A C := by grind [cFrobInner_add_left,cFrobInner_comm]
+theorem cFrobInner_neg_left : cFrobInner (-A) B = -cFrobInner A B := by
+  simp [cFrobInner_eq_re_trace]
+theorem cFrobInner_sub_left :
+    cFrobInner (A-B) C = cFrobInner A C-cFrobInner B C := by
+  rw [sub_eq_add_neg,cFrobInner_add_left,cFrobInner_neg_left,sub_eq_add_neg]
+theorem cFrobInner_real_smul_left (a : ℝ) (A B : Matrix ι κ 𝕜) :
+    cFrobInner (a • A) B = a*cFrobInner A B := by
+  simp [cFrobInner_eq_re_trace,Matrix.smul_mul,RCLike.smul_re]
+theorem cFrobInner_conjTranspose : cFrobInner Aᴴ Bᴴ = cFrobInner A B := by
+  simp only [cFrobInner,Matrix.conjTranspose_apply,star_star]
+  simp only [RCLike.mul_re,RCLike.star_def,RCLike.conj_re,RCLike.conj_im,
+    mul_neg,neg_mul,sub_neg_eq_add]
+  exact Finset.sum_comm
+theorem cFrobInner_mul_left (A : Matrix ι κ 𝕜) (B : Matrix κ ν 𝕜) (C : Matrix ι ν 𝕜) :
+    cFrobInner (A*B) C = cFrobInner B (Aᴴ*C) := by simp_all [cFrobInner_eq_re_trace,Matrix.mul_assoc,Matrix.conjTranspose_mul]
+theorem cFrobInner_left_unitary [DecidableEq ι] (U : Matrix ι ι 𝕜)
+    (hU : Unitary U) (A B : Matrix ι κ 𝕜) :
+    cFrobInner (U*A) (U*B) = cFrobInner A B := by
+  rw [cFrobInner_mul_left,← Matrix.mul_assoc,hU.1]; simp
+theorem cFrobInner_right_unitary [DecidableEq κ] (U : Matrix κ κ 𝕜)
+    (hU : Unitary U) (A B : Matrix ι κ 𝕜) :
+    cFrobInner (A*U) (B*U) = cFrobInner A B := by
+  simpa only [← Matrix.conjTranspose_mul,cFrobInner_conjTranspose] using
+    cFrobInner_left_unitary Uᴴ hU.conjTranspose Aᴴ Bᴴ
+
+instance cFrobCoordinatesRealInner : InnerProductSpace ℝ (EuclideanSpace 𝕜 (ι × κ)) :=
+  { InnerProductSpace.rclikeToReal 𝕜 _ with
+    toNormedSpace := inferInstance
+    smul_left := by
+      intro x y r
+      change RCLike.re ⟪r • x,y⟫_𝕜 = r*RCLike.re ⟪x,y⟫_𝕜
+      rw [inner_smul_left_eq_smul,RCLike.smul_re] }
+
+def encodeCFrob : Matrix ι κ 𝕜 →ₗ[ℝ] EuclideanSpace 𝕜 (ι × κ) where
+  toFun A := (WithLp.equiv 2 _).symm (fun k => A k.1 k.2)
+  map_add' _ _ := rfl
+  map_smul' _ _ := rfl
+
+def decodeCFrob : EuclideanSpace 𝕜 (ι × κ) →ₗ[ℝ] Matrix ι κ 𝕜 where
+  toFun x i j := x (i,j)
+  map_add' _ _ := rfl
+  map_smul' _ _ := rfl
+
+@[simp] theorem decode_encode_cFrob : decodeCFrob (encodeCFrob A) = A := rfl
+@[simp] theorem encode_decode_cFrob (x : EuclideanSpace 𝕜 (ι × κ)) : encodeCFrob (decodeCFrob x) = x := rfl
+
+theorem encodeCFrob_inner : ⟪encodeCFrob A,encodeCFrob B⟫_ℝ = cFrobInner A B := by
+  change RCLike.re ⟪encodeCFrob A,encodeCFrob B⟫_𝕜 = _
+  simp [EuclideanSpace.inner_eq_star_dotProduct,dotProduct,encodeCFrob,
+    cFrobInner,Fintype.sum_prod_type,mul_comm]
+theorem cFrobSq_nonneg : 0 ≤ cFrobSq A := by
+  rw [cFrobSq,← encodeCFrob_inner]
+  exact real_inner_self_nonneg
+theorem cFrobSq_eq_zero_iff : cFrobSq A = 0 ↔ A = 0 := by
+  rw [cFrobSq,← encodeCFrob_inner,inner_self_eq_zero]
+  constructor
+  · intro h; simpa using congrArg decodeCFrob h
+  · rintro rfl; simp
+end Rectangular
+
+
+
+abbrev CFrobCoordinates (𝕜 : Type) [RCLike 𝕜] (n : ℕ) := EuclideanSpace 𝕜 (Fin n × Fin n)
+variable (A B C : KMat 𝕜 n)
+
+def encodedCSubspace (S : Submodule ℝ (KMat 𝕜 n)) : Submodule ℝ (CFrobCoordinates 𝕜 n) :=
+  S.map encodeCFrob
+
+/-- An actual continuous linear map, constructed from mathlib's projection.
+The name orthogonalProjection follows the mathlib 4.19.0 API. -/
+def cFrobProjection (S : Submodule ℝ (KMat 𝕜 n)) : KMat 𝕜 n →L[ℝ] KMat 𝕜 n :=
+  ((decodeCFrob : CFrobCoordinates 𝕜 n →ₗ[ℝ] KMat 𝕜 n).toContinuousLinearMap.comp
+    ((encodedCSubspace S).subtypeL.comp ((encodedCSubspace S).orthogonalProjection (𝕜 := ℝ)))).comp
+    (encodeCFrob : KMat 𝕜 n →ₗ[ℝ] CFrobCoordinates 𝕜 n).toContinuousLinearMap
+
+theorem cFrobProjection_mem (S : Submodule ℝ (KMat 𝕜 n)) (Z : KMat 𝕜 n) :
+    cFrobProjection S Z ∈ S := by
+  have hp := ((encodedCSubspace S).orthogonalProjection  (encodeCFrob Z)).property
+  obtain ⟨A, hA, he⟩ := hp
+  change decodeCFrob ((encodedCSubspace S).orthogonalProjection  (encodeCFrob Z) :
+    CFrobCoordinates 𝕜 n) ∈ S
+  rw [← he, decode_encode_cFrob]
+  exact hA
+
+/-- This is the one API-sensitive projection lemma; all later arguments only
+use its matrix conclusion. -/
+theorem cFrobProjection_normal (S : Submodule ℝ (KMat 𝕜 n)) (Z Y : KMat 𝕜 n)
+    (hY : Y ∈ S) : cFrobInner (Z-cFrobProjection S Z) Y = 0 := by
+  rw [← encodeCFrob_inner, map_sub]
+  exact Submodule.orthogonalProjectionFn_inner_eq_zero (K := encodedCSubspace S)
+    (encodeCFrob Z) (encodeCFrob Y) ⟨Y,hY,rfl⟩
+
+theorem cFrobProjection_unique_normal (S : Submodule ℝ (KMat 𝕜 n)) (Z Y : KMat 𝕜 n)
+    (hY : Y ∈ S) (hn : ∀ W ∈ S, cFrobInner (Z-Y) W = 0) :
+    cFrobProjection S Z = Y := by
+  have he := Submodule.eq_starProjection_of_mem_of_inner_eq_zero
+    (K := encodedCSubspace S) (u := encodeCFrob Z) ⟨Y,hY,rfl⟩ (by
+      rintro _ ⟨W,hW,rfl⟩
+      simpa only [← map_sub,encodeCFrob_inner] using hn W hW)
+  exact congrArg decodeCFrob he
+
+@[simp] theorem cFrobProjection_of_mem (S : Submodule ℝ (KMat 𝕜 n)) (Y : KMat 𝕜 n)
+    (hY : Y ∈ S) : cFrobProjection S Y = Y := by
+  apply cFrobProjection_unique_normal S Y Y hY
+  intro W hW
+  simp
+
+
+
+
+
+theorem cFrobProjection_self_adjoint (S : Submodule ℝ (KMat 𝕜 n)) (A B : KMat 𝕜 n) :
+    cFrobInner (cFrobProjection S A) B = cFrobInner A (cFrobProjection S B) := by
+  rw [← encodeCFrob_inner,← encodeCFrob_inner]
+  exact Submodule.inner_starProjection_left_eq_right (encodedCSubspace S)
+    (encodeCFrob A) (encodeCFrob B)
+
+
+end GS.MatrixBase
diff --git a/GS/MatrixGeometry/LocalProduct.lean b/GS/MatrixGeometry/LocalProduct.lean
new file mode 100644
index 000000000..8347a5aca
--- /dev/null
+++ b/GS/MatrixGeometry/LocalProduct.lean
@@ -0,0 +1,135 @@
+import GS.MatrixGeometry.Base
+
+import GS.MatrixGeometry.HorizontalModel
+import Mathlib.Analysis.Calculus.InverseFunctionTheorem.ContDiff
+
+
+set_option backward.isDefEq.respectTransparency false
+/-!
+# Local horizontal--stabilizer product for shared factors
+
+The derivative of multiplication in the actual shared Cayley coordinates is
+addition.  The horizontal/kernel splitting makes this derivative invertible,
+so the inverse function theorem supplies the needed local product chart.
+No product decomposition of the image is assumed.
+-/
+
+noncomputable section
+attribute [local instance] Matrix.normedAddCommGroup Matrix.normedSpace
+open GS.MatrixBase
+namespace GS.MatrixGeometry
+variable {𝕜 : Type} [RCLike 𝕜]
+variable  {s right left : Pattern 𝕜 n}
+
+variable (s right left : Pattern 𝕜 n)
+
+variable (P : KMat 𝕜 n)
+
+def blockProductCoordinates  (x : Generator s × Generator s) := factorCoordinates (1 : Factor s)
+    (matrixReconstruct (1 : Factor s) x.1 * matrixReconstruct (1 : Factor s) x.2)
+
+
+
+@[fun_prop] theorem blockProductCoordinates_smooth_zero  :
+    ContDiffAt ℝ ⊤ (blockProductCoordinates s) 0 := by
+  apply ContDiffAt.comp (f := fun x : Generator s × Generator s =>
+    matrixReconstruct (1 : Factor s) x.1 * matrixReconstruct (1 : Factor s) x.2) 0
+  · simpa using factorCoordinates_smooth_at (1 : Factor s) (1 : KMat 𝕜 n)
+      (by aesop)
+  · exact smooth_mul_at
+      ((matrixReconstruct_smooth (1 : Factor s)).contDiffAt.comp 0 contDiffAt_fst)
+      ((matrixReconstruct_smooth (1 : Factor s)).contDiffAt.comp 0 contDiffAt_snd)
+
+
+def factorProductCoordinates 
+    (x : PairGenerator right left × PairGenerator right left) := (blockProductCoordinates left (x.1.1, x.2.1),
+    blockProductCoordinates right (x.1.2, x.2.2))
+
+
+
+
+
+theorem blockProductCoordinates_hasFDerivAt_zero  :
+    HasFDerivAt (blockProductCoordinates s)
+      (ContinuousLinearMap.fst ℝ (Generator s) (Generator s) +
+        ContinuousLinearMap.snd ℝ (Generator s) (Generator s)) 0 := by
+  have h := ((blockProductCoordinates_smooth_zero s).differentiableAt (by simp)).hasFDerivAt
+  convert h using 1
+  apply ContinuousLinearMap.ext
+  intro v
+  symm
+  change fderiv ℝ (blockProductCoordinates s) 0 v = v.1 + v.2
+  have hp := hasDerivAt_matrix_mul
+    (reconstruct_line_hasDerivAt_zero (1 : Factor s) v.1)
+    (reconstruct_line_hasDerivAt_zero (1 : Factor s) v.2)
+  have hc := (factorCoordinates_smooth_at (1 : Factor s) (1 : KMat 𝕜 n)
+    (by aesop)).differentiableAt (by simp)
+  have ha := hc.hasFDerivAt.comp_hasDerivAt_of_eq 0 hp (by simp)
+  have hi := ((blockProductCoordinates_smooth_zero s).differentiableAt
+    (by simp)).hasFDerivAt.comp_hasDerivAt_of_eq (0 : ℝ)
+      ((hasDerivAt_id (0 : ℝ)).smul_const v) (by simp)
+  simp only [one_smul] at hi
+  refine (hi.unique ha).trans ?_
+  simpa only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.id_apply,
+    matrixReconstruct_fderiv_zero, matrixReconstruct_zero, Factor.matrix_one,
+    Matrix.one_mul, Matrix.mul_one, zero_smul, reconstruct_zero,
+    Submodule.coe_add, smul_add] using
+      congrArg (fun D : Generator s →L[ℝ] Generator s => D (v.1 + v.2))
+        (coordinateDerivative_reconstruct (1 : Factor s) 0)
+
+
+def reorderLeft := ((ContinuousLinearMap.fst ℝ (Generator left) (Generator right)).comp
+    (ContinuousLinearMap.fst ℝ _ _)).prod
+  ((ContinuousLinearMap.fst ℝ (Generator left) (Generator right)).comp
+    (ContinuousLinearMap.snd ℝ _ _))
+
+def reorderRight := ((ContinuousLinearMap.snd ℝ (Generator left) (Generator right)).comp
+    (ContinuousLinearMap.fst ℝ _ _)).prod
+  ((ContinuousLinearMap.snd ℝ (Generator left) (Generator right)).comp
+    (ContinuousLinearMap.snd ℝ _ _))
+
+@[fun_prop] theorem factorProductCoordinates_smooth_zero  :
+    ContDiffAt ℝ ⊤ (factorProductCoordinates right left) 0 := by
+  fun_prop [factorProductCoordinates]
+
+theorem factorProductCoordinates_hasFDerivAt_zero  :
+    HasFDerivAt (factorProductCoordinates right left)
+      (ContinuousLinearMap.fst ℝ (PairGenerator right left) (PairGenerator right left) +
+        ContinuousLinearMap.snd ℝ (PairGenerator right left) (PairGenerator right left)) 0 := by
+  have hl := (blockProductCoordinates_hasFDerivAt_zero left).comp (f := reorderLeft right left) 0
+    (reorderLeft right left).hasFDerivAt
+  have hr := (blockProductCoordinates_hasFDerivAt_zero right).comp (f := reorderRight right left) 0
+    (reorderRight right left).hasFDerivAt
+  convert hl.prodMk hr using 1 <;> rfl
+
+def sliceProduct  
+    (x : HorizontalModel right left P × OrbitKernel right left P) := factorProductCoordinates right left (x.1.val, x.2.val)
+
+def sliceInclusion := ((HorizontalModel right left P).subtypeL.comp (ContinuousLinearMap.fst ℝ _ _)).prod
+    ((OrbitKernel right left P).subtypeL.comp (ContinuousLinearMap.snd ℝ _ _))
+
+
+
+theorem sliceProduct_smooth_zero   :
+    ContDiffAt ℝ ⊤ (sliceProduct right left P) 0 := by
+  fun_prop [sliceProduct]
+
+theorem sliceProduct_hasFDerivAt_zero 
+     :
+    HasFDerivAt (sliceProduct right left P)
+      (horizontalKernelEquiv right left P : _ →L[ℝ] _) 0 := by
+  have hd := (factorProductCoordinates_hasFDerivAt_zero right left).comp (f := sliceInclusion right left P) 0
+    (@ContinuousLinearMap.hasFDerivAt ℝ _ (HorizontalModel right left P × OrbitKernel right left P) _ _ _ (PairGenerator right left × PairGenerator right left) _ _ _ (sliceInclusion right left P) 0)
+  convert hd using 1 <;> rfl
+
+def sliceProductChart := (sliceProduct_smooth_zero right left P).toOpenPartialHomeomorph _
+    (sliceProduct_hasFDerivAt_zero right left P) (by simp)
+
+
+
+theorem sliceProductChart_zero_mem_source 
+     : (0 : HorizontalModel right left P × OrbitKernel right left P)
+      ∈ (sliceProductChart right left P).source :=
+  (sliceProduct_smooth_zero right left P).mem_toOpenPartialHomeomorph_source _ (by simp)
+
+end GS.MatrixGeometry
diff --git a/GS/MatrixGeometry/LocalSections.lean b/GS/MatrixGeometry/LocalSections.lean
new file mode 100644
index 000000000..990651406
--- /dev/null
+++ b/GS/MatrixGeometry/LocalSections.lean
@@ -0,0 +1,86 @@
+import GS.MatrixGeometry.Base
+
+import GS.MatrixGeometry.OrbitAtlas
+import GS.OverlapGeometry.ManifoldSmoothMaps
+
+
+
+/-!
+# Local smooth sections of the shared orbit map
+
+Each translated slice yields an actual local choice of shared factors.  The
+choice is smooth on its stated open neighbourhood and reconstructs every point
+there.  No global section and no unique factorization are asserted.  In
+particular, ambient-smooth orbit curves now admit local smooth factor lifts.
+-/
+
+noncomputable section
+attribute [local instance] Matrix.normedAddCommGroup Matrix.normedSpace
+open GS.MatrixBase
+open scoped Manifold
+namespace GS.MatrixGeometry
+variable {𝕜 : Type} [RCLike 𝕜]
+variable  (right left : Pattern 𝕜 n) (P : KMat 𝕜 n)
+local instance localSectionsNormedSpace : NormedSpace ℝ (HorizontalModel right left P) :=
+  Submodule.normedSpace _
+
+variable (g : Factors right left)
+
+variable (X : MatrixOrbit right left P)
+
+/-- Total extension of a local section; its right-inverse identity is asserted
+only on the open source of the translated slice. -/
+def localFactors  (A : KMat 𝕜 n) : Factors right left :=
+  factorLift g ((translatedOrbitSlice right left P g).coordinates A).val
+
+/-- Every nearby matrix in the full shared orbit is reconstructed. -/
+theorem localFactors_right_inverse 
+     (hX : X ∈ (translatedOrbitSlice right left P g).source) :
+    orbitMapToOrbit right left P (localFactors right left P g X.val) = X := by
+  apply Subtype.ext
+  change orbitParam g P ((translatedOrbitSlice right left P g).coordinates X.val).val = X.val
+  rw [orbitParam_eq_translate]
+  exact congrArg Subtype.val ((translatedOrbitSlice right left P g).left_inverse X hX)
+
+set_option backward.isDefEq.respectTransparency false
+local instance : ChartedSpace (HorizontalModel right left P)
+    (MatrixOrbit right left P) := sharedOrbitChartedSpace right left P
+
+/-- Smooth ambient formulas in local factors descend smoothly to the orbit. -/
+theorem transported_contMDiff {E F : Type*}
+    [NormedAddCommGroup E] [NormedSpace ℝ E]
+    [NormedAddCommGroup F] [NormedSpace ℝ F]
+    (f : KMat 𝕜 n → E → F) (T : KMat 𝕜 n × (KMat 𝕜 n × E) → F)
+    (hT : ContDiff ℝ ⊤ T)
+    (he : ∀ (g : Factors right left) z,
+      T (Factor.matrix g.1, (Factor.matrix g.2, z)) = f (g • P) z) :
+    ContMDiff ((𝓘(ℝ, HorizontalModel right left P)).prod (𝓘(ℝ, E)))
+      (𝓘(ℝ, F)) ⊤ (fun p : MatrixOrbit right left P × E => f p.1.val p.2) := by
+  intro p
+  let g := preferredFactor P p.1
+  have h₀ :=
+    preferredOrbitSlice_covers right left P p.1
+  have hv := (HorizontalModel right left P).subtypeL.contDiff.contDiffAt.comp p.1.val
+    ((translatedOrbitSlice right left P g).coordinates_smooth p.1 h₀)
+  have hLR := (((reconstruct_matrix_smooth g.1).contDiffAt.comp p.1.val
+    (contDiffAt_fst.comp p.1.val hv)).prodMk
+      ((reconstruct_matrix_smooth g.2).contDiffAt.comp p.1.val
+        (contDiffAt_snd.comp p.1.val hv))).comp (p.1.val,p.2) contDiffAt_fst
+  have hs := hT.contDiffAt.comp (p.1.val, p.2)
+    (hLR.fst.prodMk (hLR.snd.prodMk contDiffAt_snd))
+  have hi : ContMDiff ((𝓘(ℝ, HorizontalModel right left P)).prod (𝓘(ℝ, E)))
+      (𝓘(ℝ, KMat 𝕜 n × E)) ⊤
+      (fun q : MatrixOrbit right left P × E => (q.1.val, q.2)) :=
+    ((sharedOrbit_val_contMDiff right left P).comp contMDiff_fst).prodMk_space contMDiff_snd
+  apply (ContDiffAt.comp_contMDiffAt
+    (f := fun q : MatrixOrbit right left P × E => (q.1.val, q.2)) hs (hi p)).congr_of_eventuallyEq
+  have hn := continuous_fst.continuousAt.eventually
+    ((translatedOrbitSlice right left P g).open_source.mem_nhds h₀)
+  filter_upwards [hn] with q hq
+  dsimp only [Function.comp_apply]
+  have hh := he (localFactors right left P g q.1.val) q.2
+  rw [show localFactors right left P g q.1.val • P = q.1.val from
+    congrArg Subtype.val (localFactors_right_inverse right left P g q.1 hq)] at hh
+  simpa only [localFactors,factorLift,Submodule.subtypeL_apply] using hh.symm
+
+end GS.MatrixGeometry
diff --git a/GS/MatrixGeometry/MinimumNormLift.lean b/GS/MatrixGeometry/MinimumNormLift.lean
new file mode 100644
index 000000000..8ae9131dc
--- /dev/null
+++ b/GS/MatrixGeometry/MinimumNormLift.lean
@@ -0,0 +1,177 @@
+import GS.MatrixGeometry.Base
+
+import GS.MatrixGeometry.Projection
+import Mathlib.Analysis.InnerProductSpace.ProdL2
+
+
+
+/-!
+# The canonical minimum-physical-norm lift of a shared tangent
+
+The metric on generators is the sum of the Frobenius norms of the two
+expanded physical matrices. Repeated blocks therefore carry their actual
+multiplicities. No inner product is installed on the entrywise matrix norm.
+Instead the kernel projection is constructed in a genuine L2 product of
+Frobenius coordinate spaces. Subtracting that projection gives the unique
+horizontal lift. All matrices X are allowed; smooth dependence on X is proved
+separately on each fixed shared orbit.
+-/
+
+
+noncomputable section
+open GS.MatrixBase InnerProductSpace
+namespace GS.MatrixGeometry
+variable {𝕜 : Type} [RCLike 𝕜]
+variable  {right left : Pattern 𝕜 n}
+variable (X Z : KMat 𝕜 n)
+variable (v : PairGenerator right left)
+
+
+/-- The physical, multiplicity-weighted pairing; not the chart-coordinate norm. -/
+def generatorInner (w : PairGenerator right left) : ℝ :=
+  cFrobInner v.1.val w.1.val + cFrobInner v.2.val w.2.val
+
+def generatorEnergy : ℝ := generatorInner v v
+
+
+
+
+
+@[simp] theorem generatorEnergy_eq_zero_iff :
+    generatorEnergy v = 0 ↔ v = 0 :=
+by
+  change cFrobSq v.1.val + cFrobSq v.2.val = 0 ↔ v = 0
+  rw [add_eq_zero_iff_of_nonneg (cFrobSq_nonneg _) (cFrobSq_nonneg _),
+    cFrobSq_eq_zero_iff,cFrobSq_eq_zero_iff]
+  simp only [Prod.ext_iff,Subtype.ext_iff,Prod.fst_zero,Prod.snd_zero,Submodule.coe_zero]
+
+abbrev GeneratorHilbert (𝕜 : Type) [RCLike 𝕜] (n : ℕ) := WithLp 2 (CFrobCoordinates 𝕜 n × CFrobCoordinates 𝕜 n)
+
+/-- Linear encoding preserving the physical pairing, with no change to the
+existing topology or norm instances on shared generators. -/
+def generatorEncoding (right left : Pattern 𝕜 n) :
+    PairGenerator right left →ₗ[ℝ] GeneratorHilbert 𝕜 n :=
+  let L := (encodeCFrob.comp (sharedSkewSpace left.size left.label).subtype).comp
+    (LinearMap.fst ℝ (Generator left) (Generator right))
+  let R := (encodeCFrob.comp (sharedSkewSpace right.size right.label).subtype).comp
+    (LinearMap.snd ℝ (Generator left) (Generator right))
+  (WithLp.linearEquiv 2 ℝ (CFrobCoordinates 𝕜 n × CFrobCoordinates 𝕜 n)).symm.toLinearMap.comp
+    (L.prod R)
+
+theorem generatorEncoding_inner (w : PairGenerator right left) :
+    ⟪generatorEncoding right left v, generatorEncoding right left w⟫_ℝ =
+      generatorInner v w := by
+  change ⟪encodeCFrob v.1.val, encodeCFrob w.1.val⟫_ℝ +
+    ⟪encodeCFrob v.2.val, encodeCFrob w.2.val⟫_ℝ = _
+  rw [encodeCFrob_inner, encodeCFrob_inner]
+  rfl
+
+theorem generatorInner_sub_left (u v w : PairGenerator right left) :
+    generatorInner (u - v) w = generatorInner u w - generatorInner v w := by
+  simp only [← generatorEncoding_inner, map_sub, inner_sub_left]
+
+def encodedPointKernel : Submodule ℝ (GeneratorHilbert 𝕜 n) :=
+  (pointMap right left X).ker.map (generatorEncoding right left)
+
+private def projectedGenerator :=
+  (encodedPointKernel (right := right) (left := left) X).orthogonalProjection
+    (generatorEncoding right left v)
+
+def kernelPart : PairGenerator right left := (projectedGenerator X v).property.choose
+
+private theorem kernelPart_mem : pointMap right left X (kernelPart X v) = 0 :=
+  (projectedGenerator X v).property.choose_spec.1
+
+private theorem encode_kernelPart :
+    generatorEncoding right left (kernelPart X v) = (projectedGenerator X v : GeneratorHilbert 𝕜 n) :=
+  (projectedGenerator X v).property.choose_spec.2
+
+/-- Orthogonality to the full shared synthesis kernel in the real physical metric. -/
+def IsHorizontal : Prop :=
+  ∀ k : PairGenerator right left, pointMap right left X k = 0 → generatorInner v k = 0
+
+private theorem sub_kernelPart_horizontal :
+    IsHorizontal X (v - kernelPart X v) := by
+  intro k hk
+  have hk' : generatorEncoding right left k ∈
+      encodedPointKernel   X := ⟨k, hk, rfl⟩
+  have h := Submodule.orthogonalProjectionFn_inner_eq_zero
+    (K := encodedPointKernel   X)
+    (generatorEncoding right left v) (generatorEncoding right left k) hk'
+  rw [Submodule.starProjection_apply] at h
+  rw [← generatorEncoding_inner, map_sub, encode_kernelPart]
+  exact h
+
+theorem horizontal_lift_unique (w : PairGenerator right left) (hv : IsHorizontal X v) (hw : IsHorizontal X w)
+    (h : pointMap right left X v = pointMap right left X w) : v = w := by
+  have hk : pointMap right left X (v - w) = 0 := by aesop
+  apply sub_eq_zero.mp
+  apply (generatorEnergy_eq_zero_iff (v - w)).mp
+  change generatorInner (v - w) (v - w) = 0
+  rw [generatorInner_sub_left, hv _ hk, hw _ hk, sub_self]
+
+/-- Existence is derived from finite-dimensional orthogonal projection. -/
+theorem exists_horizontal_lift :
+    ∃ v : PairGenerator right left,
+      pointMap right left X v = pointProjection right left X Z ∧ IsHorizontal X v := by
+  obtain ⟨v, hv⟩ := pointProjection_mem   X Z
+  refine ⟨v - kernelPart X v, ?_, sub_kernelPart_horizontal X v⟩
+  rw [map_sub, kernelPart_mem, sub_zero]
+  exact hv
+
+def selectedLift (right left : Pattern 𝕜 n) (X Z : KMat 𝕜 n) := Classical.choose (exists_horizontal_lift (right := right) (left := left) X Z)
+
+private theorem selectedLift_synthesis :
+    pointMap right left X (selectedLift right left X Z) = pointProjection right left X Z :=
+  (Classical.choose_spec (exists_horizontal_lift   X Z)).1
+
+private theorem selectedLift_horizontal :
+    IsHorizontal X (selectedLift right left X Z) :=
+  (Classical.choose_spec (exists_horizontal_lift   X Z)).2
+
+/-- The canonical minimum-physical-norm lift of the projected ambient vector.
+It is linear and continuous in Z; it is NOT asserted smooth across arbitrary
+ambient rank changes in X. -/
+def minimumNormLift (right left : Pattern 𝕜 n) (X : KMat 𝕜 n) :
+    KMat 𝕜 n →L[ℝ] PairGenerator right left :=
+  ({ toFun := selectedLift right left X
+     map_add' := by
+       intro Z W
+       apply horizontal_lift_unique X
+       · exact selectedLift_horizontal X (Z + W)
+       · intro k hk
+         rw [← generatorEncoding_inner, map_add, inner_add_left,
+           generatorEncoding_inner, generatorEncoding_inner, selectedLift_horizontal X Z k hk,
+           selectedLift_horizontal X W k hk, add_zero]
+       · simp only [map_add, selectedLift_synthesis]
+     map_smul' := by
+       intro a Z
+       apply horizontal_lift_unique X
+       · exact selectedLift_horizontal X (a • Z)
+       · intro k hk
+         rw [← generatorEncoding_inner, map_smul, inner_smul_left,
+           generatorEncoding_inner, selectedLift_horizontal X Z k hk, mul_zero]
+       · simp only [map_smul, selectedLift_synthesis, RingHom.id_apply]
+   } : KMat 𝕜 n →ₗ[ℝ] PairGenerator right left).toContinuousLinearMap
+
+theorem minimumNormLift_synthesis :
+    pointMap right left X (minimumNormLift right left X Z) =
+      pointProjection right left X Z := selectedLift_synthesis X Z
+
+theorem minimumNormLift_horizontal :
+    IsHorizontal X (minimumNormLift right left X Z) := selectedLift_horizontal X Z
+
+theorem minimumNormLift_unique (hv : pointMap right left X v = pointProjection right left X Z)
+    (hh : IsHorizontal X v) : v = minimumNormLift right left X Z :=
+  horizontal_lift_unique X v _ hh (minimumNormLift_horizontal X Z)
+    (hv.trans (minimumNormLift_synthesis X Z).symm)
+
+/-- Removing the ambient normal component does not change the selected generators. -/
+@[simp] theorem minimumNormLift_projected :
+    minimumNormLift right left X (pointProjection right left X Z) =
+      minimumNormLift right left X Z := by
+  apply minimumNormLift_unique X Z
+  · rw [minimumNormLift_synthesis, pointProjection_idempotent]
+  · exact minimumNormLift_horizontal X _
+
+end GS.MatrixGeometry
