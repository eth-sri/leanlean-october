-  apply Subtype.ext
-  simp
-
-@[simp] theorem cayleyTangentStep_zero_vector (X : MatrixOrbit b₁ b₂ (permMatrix σ))
-    (t : ℝ) : cayleyTangentStep b₁ b₂ σ X 0 t=X := by
-  apply Subtype.ext
-  simp
