-    simpa only [hc] using hAV)
-  obtain ⟨U₂, hU₂, he₂⟩ := exists_orthogonal_mul_diagonal (B * V) s (by
-    simpa only [hs] using hBV)
-  refine ⟨U₁, U₂, V, c, s, hU₁, hU₂, hV, ?_, he₁, he₂⟩
-  intro i
-  exact ⟨Real.sqrt_nonneg _, Real.sqrt_nonneg _, by rw [hc, hs]; ring⟩
-
-end GS.CS
