diff --git a/GS/MatrixGeometry/ProjectedSlice.lean b/GS/MatrixGeometry/ProjectedSlice.lean
new file mode 100644
index 000000000..c95ce70ea
--- /dev/null
+++ b/GS/MatrixGeometry/ProjectedSlice.lean
@@ -0,0 +1,129 @@
+import Mathlib.Tactic
+import GS.MatrixGeometry.Base
+
+import GS.MatrixGeometry.HorizontalModel
+import Mathlib.Analysis.Calculus.InverseFunctionTheorem.ContDiff
+
+open GS.MatrixBase
+
+set_option backward.isDefEq.respectTransparency false
+/-!
+# Ambient coordinates on a horizontal slice
+
+The inverse function theorem supplies an ambient smooth left inverse to the
+horizontal orbit parametrization near zero. Openness of the slice image in the
+whole orbit is established separately by local factor decomposition.
+-/
+
+noncomputable section
+attribute [local instance] Matrix.normedAddCommGroup Matrix.normedSpace
+open Filter
+open GS.OverlapGeometry (horizontalComplement horizontalRestriction
+  horizontalLeftInverse_comp)
+namespace GS.MatrixGeometry
+variable {𝕜 : Type} [RCLike 𝕜]
+variable  (right left : Pattern 𝕜 n) (P : KMat 𝕜 n)
+local instance projectedSliceNormedSpace : NormedSpace ℝ (HorizontalModel right left P) :=
+  Submodule.normedSpace _
+
+def horizontalValue (h : HorizontalModel right left P) := orbitParam (1 : Factors right left) P h.val
+
+def horizontalPoint (h : HorizontalModel right left P) := orbitInverse P (1 : Factors right left) h.val
+
+@[simp] theorem horizontalPoint_val (h : HorizontalModel right left P) :
+    (horizontalPoint right left P h).val = horizontalValue right left P h :=
+  rfl
+
+theorem horizontalValue_smooth : ContDiff ℝ ⊤ (horizontalValue right left P) :=
+  (orbitParam_smooth 1 P).comp
+    (horizontalComplement (orbitDerivative right left P)).subtypeL.contDiff
+
+@[simp] theorem horizontalValue_zero :
+    horizontalValue right left P 0 = P := by
+  simp [horizontalValue, orbitParam_zero, one_smul]
+
+def horizontalProjected (h : HorizontalModel right left P) := orbitHorizontalInverse right left P (horizontalValue right left P h - P)
+
+theorem horizontalProjected_smooth : ContDiff ℝ ⊤ (horizontalProjected right left P) :=
+  (orbitHorizontalInverse right left P).contDiff.comp
+    ((horizontalValue_smooth right left P).sub contDiff_const)
+
+@[simp] theorem horizontalProjected_zero : horizontalProjected right left P 0 = 0 := by
+  simp [horizontalProjected]
+
+theorem horizontalValue_hasFDerivAt_zero :
+    HasFDerivAt (horizontalValue right left P)
+      (horizontalRestriction (orbitDerivative right left P)) 0 := by
+  have hh := ((orbitParam_smooth (1 : Factors right left) P).differentiable
+    (by simp) 0).hasFDerivAt
+  unfold horizontalValue
+  simpa only [Function.comp_def, horizontalValue, horizontalRestriction, orbitDerivative, map_zero] using
+    HasFDerivAt.comp (f := fun h : HorizontalModel right left P => h.val)
+      (g := orbitParam (1 : Factors right left) P) 0 hh
+      (horizontalComplement (orbitDerivative right left P)).subtypeL.hasFDerivAt
+
+theorem horizontalProjected_hasFDerivAt_zero :
+    HasFDerivAt (horizontalProjected right left P)
+      (ContinuousLinearMap.id ℝ (HorizontalModel right left P)) 0 := by
+  have hh := (orbitHorizontalInverse right left P).hasFDerivAt.comp 0
+    ((horizontalValue_hasFDerivAt_zero right left P).sub_const P)
+  unfold horizontalProjected
+  simpa only [Function.comp_def, horizontalProjected, orbitHorizontalInverse, horizontalLeftInverse_comp] using hh
+
+def projectedSliceEquiv : OpenPartialHomeomorph (HorizontalModel right left P)
+    (HorizontalModel right left P) :=
+  (horizontalProjected_smooth right left P).contDiffAt.toOpenPartialHomeomorph
+    (horizontalProjected right left P)
+    (f' := ContinuousLinearEquiv.refl ℝ (HorizontalModel right left P))
+    (horizontalProjected_hasFDerivAt_zero right left P) (by simp)
+
+theorem projectedSliceEquiv_zero_source : 0 ∈ (projectedSliceEquiv right left P).source :=
+  (horizontalProjected_smooth right left P).contDiffAt.mem_toOpenPartialHomeomorph_source
+    (f' := ContinuousLinearEquiv.refl ℝ (HorizontalModel right left P))
+    (horizontalProjected_hasFDerivAt_zero right left P) (by simp)
+
+theorem projectedSliceEquiv_zero_target : 0 ∈ (projectedSliceEquiv right left P).target := by
+  simpa only [projectedSliceEquiv, ContDiffAt.toOpenPartialHomeomorph_coe, horizontalProjected_zero] using
+    (projectedSliceEquiv right left P).map_source (projectedSliceEquiv_zero_source right left P)
+
+theorem projectedSliceEquiv_inverse_smooth_zero :
+    ContDiffAt ℝ ⊤ (projectedSliceEquiv right left P).symm 0 := by
+  have hh := (horizontalProjected_smooth right left P).contDiffAt.to_localInverse
+    (f' := ContinuousLinearEquiv.refl ℝ (HorizontalModel right left P))
+    (horizontalProjected_hasFDerivAt_zero right left P) (by simp)
+  simpa only [horizontalProjected_zero, ContDiffAt.localInverse, HasStrictFDerivAt.localInverse, ContDiffAt.toOpenPartialHomeomorph, projectedSliceEquiv] using hh
+
+/-- Concrete IFT data, without any assertion that its image is open in the orbit. -/
+structure ProjectedSliceData where
+  domain : Set (HorizontalModel right left P)
+  coordinates : KMat 𝕜 n → HorizontalModel right left P
+  open_domain : IsOpen domain
+  zero_mem : 0 ∈ domain
+  left_inverse : ∀ h ∈ domain, coordinates (horizontalValue right left P h) = h
+  coordinates_smooth : ∀ h ∈ domain,
+    ContDiffAt ℝ ⊤ coordinates (horizontalValue right left P h)
+
+theorem exists_projectedSliceData : Nonempty (ProjectedSliceData right left P) := by
+  let e := projectedSliceEquiv right left P
+  have hs :=
+    (projectedSliceEquiv_inverse_smooth_zero right left P).eventually (by simp)
+  obtain ⟨W, hWsub, hWopen, hWzero⟩ := mem_nhds_iff.mp
+    (inter_mem (e.open_target.mem_nhds (projectedSliceEquiv_zero_target right left P)) hs)
+  let V := e.source ∩ horizontalProjected right left P ⁻¹' W
+  let c : KMat 𝕜 n → HorizontalModel right left P := fun A =>
+    e.symm (orbitHorizontalInverse right left P (A - P))
+  refine ⟨⟨V, c, e.open_source.inter
+    (hWopen.preimage (horizontalProjected_smooth right left P).continuous),
+    ⟨projectedSliceEquiv_zero_source right left P, ?_⟩, ?_, ?_⟩⟩
+  · aesop
+  · intro h hh
+    exact e.left_inv hh.1
+  · intro h hh
+    have hi : ContDiffAt ℝ ⊤ e.symm (horizontalProjected right left P h) :=
+      (hWsub hh.2).2
+    exact hi.comp (horizontalValue right left P h)
+      ((orbitHorizontalInverse right left P).contDiff.comp (contDiff_id.sub contDiff_const)).contDiffAt
+
+def projectedSliceData := Classical.choice (exists_projectedSliceData right left P)
+
+end GS.MatrixGeometry
diff --git a/GS/MatrixGeometry/Projection.lean b/GS/MatrixGeometry/Projection.lean
new file mode 100644
index 000000000..70f2474aa
--- /dev/null
+++ b/GS/MatrixGeometry/Projection.lean
@@ -0,0 +1,69 @@
+import Mathlib.Tactic
+import GS.MatrixGeometry.Base
+
+import GS.MatrixGeometry.Directions
+import Mathlib.Topology.Constructions.SumProd
+
+
+
+/-!
+# A canonical continuous projector on each shared orbit
+
+The projector is a function of the matrix point and ambient vector, not of a
+chosen factorization.  It equals the existing exact coupled shared projection
+at every valid factor pair.  Joint continuity on the actual matrix orbit is
+proved by descent through the open orbit map; no continuous choice of factors
+and no smooth shared-orbit atlas is assumed.
+
+These statements concern the actual generator range.  Calling it the full
+manifold tangent space still requires the shared-orbit atlas.
+-/
+
+noncomputable section
+open GS.MatrixBase
+namespace GS.MatrixGeometry
+variable {𝕜 : Type} [RCLike 𝕜]
+variable  {right left : Pattern 𝕜 n}
+
+variable (X Z Y : KMat 𝕜 n)
+
+/-- Canonical ambient Frobenius projection at a matrix point. -/
+def pointProjection (right left : Pattern 𝕜 n) (X : KMat 𝕜 n) := cFrobProjection (pointDirections right left X)
+
+theorem pointProjection_mem  :
+    pointProjection right left X Z ∈ pointDirections right left X :=
+  cFrobProjection_mem _ _
+
+theorem pointProjection_of_mem 
+    (hY : Y ∈ pointDirections right left X) : pointProjection right left X Y = Y :=
+  cFrobProjection_of_mem _ _ hY
+
+theorem pointProjection_normal 
+    (hY : Y ∈ pointDirections right left X) :
+    cFrobInner (Z - pointProjection right left X Z) Y = 0 :=
+  cFrobProjection_normal _ _ _ hY
+
+
+
+@[simp] theorem pointProjection_idempotent  :
+    pointProjection right left X (pointProjection right left X Z) =
+      pointProjection right left X Z :=
+  by simp_all [pointProjection_mem,pointProjection_of_mem]
+
+/-- Equivariance follows from the actual action isometry and the full range,
+not an entrywise overlap mask. -/
+theorem pointProjection_equivariant (g : Factors right left) (X Z : KMat 𝕜 n) :
+    pointProjection right left (g • X) (g • Z) =
+      g • pointProjection right left X Z := by
+  apply cFrobProjection_unique_normal (pointDirections right left (g • X)) (g • Z)
+  · grind [action_mem_pointDirections,pointProjection_mem]
+  · intro Y hY
+    have hback : g⁻¹ • Y ∈ pointDirections right left X := by grind [action_mem_pointDirections,inv_smul_smul]
+    have he := action_cFrobInner g (Z - pointProjection right left X Z) (g⁻¹ • Y)
+    rw [show g • (Z - pointProjection right left X Z) =
+        g • Z - g • pointProjection right left X Z from
+          (actionLinearEquiv g).map_sub _ _, smul_inv_smul] at he
+    rw [he]
+    exact pointProjection_normal X Z _ hback
+
+end GS.MatrixGeometry
diff --git a/GS/MatrixGeometry/Retraction.lean b/GS/MatrixGeometry/Retraction.lean
new file mode 100644
index 000000000..745c2eb00
--- /dev/null
+++ b/GS/MatrixGeometry/Retraction.lean
@@ -0,0 +1,102 @@
+import GS.MatrixGeometry.Base
+
+import GS.MatrixGeometry.CayleyStep
+import GS.MatrixGeometry.Gradient
+import Mathlib.Geometry.Manifold.MFDeriv.FDeriv
+
+
+set_option backward.isDefEq.respectTransparency false
+/-!
+# A canonical Cayley retraction on each actual shared tangent fibre
+
+The map uses only the base matrix and the matrix image of the actual tangent
+vector. It is feasible for all real times. The initial matrix derivative is
+identified with the manifold derivative using injectivity of the inclusion,
+and the fibre differential of the time-one map is the identity.
+-/
+
+noncomputable section
+attribute [local instance] Matrix.normedAddCommGroup Matrix.normedSpace
+open GS.MatrixBase
+open scoped Manifold
+attribute [local fun_prop] GS.MatrixGeometry.sharedCayleyValue_fixed_smooth
+namespace GS.MatrixGeometry
+variable {𝕜 : Type} [RCLike 𝕜]
+variable  (right left : Pattern 𝕜 n) (P : KMat 𝕜 n)
+local instance retractionNormedSpace : NormedSpace ℝ (HorizontalModel right left P) :=
+  Submodule.normedSpace _
+local instance retractionChartedSpace : ChartedSpace (HorizontalModel right left P)
+    (MatrixOrbit right left P) := sharedOrbitChartedSpace right left P
+
+
+attribute [local irreducible] sharedSkewSpace orbitDerivative GS.OverlapGeometry.horizontalComplement
+
+variable (X : MatrixOrbit right left P)
+
+theorem sharedCayleyValue_hasFDerivAt_zero (X : KMat 𝕜 n) :
+    HasFDerivAt (fun Z => sharedCayleyValue right left X Z 1)
+      (pointProjection right left X) 0 := by
+  let f := fun Z => sharedCayleyValue right left X Z 1
+  have hs : DifferentiableAt ℝ f 0 :=
+    ((sharedCayleyValue_fixed_smooth X).comp
+      (contDiff_id.prodMk contDiff_const)).differentiable (by simp) 0
+  have he : fderiv ℝ f 0 = pointProjection right left X := by
+    apply ContinuousLinearMap.ext
+    intro Z
+    have hd := hs.hasFDerivAt.comp_hasDerivAt_of_eq (0 : ℝ)
+      ((hasDerivAt_id (0 : ℝ)).smul_const Z) (by simp)
+    simp only [f, Function.comp_def, id_eq, one_smul,
+      sharedCayleyValue_smul, one_mul] at hd
+    exact hd.unique (sharedCayleyValue_derivative X Z)
+  rw [← he]
+  exact hs.hasFDerivAt
+
+
+/-- The globally feasible time-one Cayley map on the actual tangent fibre. -/
+def cayleyFibreRetraction 
+    (v : TangentSpace (𝓘(ℝ, HorizontalModel right left P)) X) :
+    MatrixOrbit right left P :=
+  ⟨sharedCayleyValue right left X.val (inclusionDifferential right left P X v) 1,
+    sharedCayleyValue_mem_orbit P X (inclusionDifferential right left P X v) 1⟩
+
+@[simp] theorem cayleyFibreRetraction_zero  :
+    cayleyFibreRetraction right left P X 0 = X := by
+  apply Subtype.ext
+  simp [cayleyFibreRetraction]
+
+theorem cayleyFibreRetraction_contMDiff  :
+    ContMDiff (𝓘(ℝ, HorizontalModel right left P)) (𝓘(ℝ, HorizontalModel right left P)) ⊤
+      (fun v : HorizontalModel right left P => cayleyFibreRetraction right left P X v) := by
+  apply (sharedOrbit_contMDiff_iff_ambient right left P (𝓘(ℝ, HorizontalModel right left P)) _).mpr
+  apply contMDiff_iff_contDiff.mpr
+  let D : HorizontalModel right left P →L[ℝ] KMat 𝕜 n := inclusionDifferential right left P X
+  change ContDiff ℝ ⊤ (fun v => sharedCayleyValue right left X.val (D v) 1)
+  fun_prop
+
+/-- The derivative of the time-one retraction at the zero vector is the identity. -/
+theorem cayleyFibreRetraction_mfderiv_zero
+     :
+    mfderiv (M := HorizontalModel right left P) (M' := MatrixOrbit right left P)
+      (𝓘(ℝ, HorizontalModel right left P)) (𝓘(ℝ, HorizontalModel right left P))
+      (fun v : HorizontalModel right left P => cayleyFibreRetraction right left P X v) (0 : HorizontalModel right left P) =
+        ContinuousLinearMap.id ℝ (HorizontalModel right left P) := by
+  ext v
+  apply inclusionDifferential_injective right left P X
+  have hf := (cayleyFibreRetraction_contMDiff right left P X).mdifferentiable (by simp)
+  have hi := (sharedOrbit_val_contMDiff right left P).mdifferentiable (by simp)
+  have hchain := mfderiv_comp_apply_of_eq (0 : HorizontalModel right left P)
+    (hi X) (hf 0) (cayleyFibreRetraction_zero right left P X) v
+  let D : HorizontalModel right left P →L[ℝ] KMat 𝕜 n := inclusionDifferential right left P X
+  have hd := sharedCayleyValue_hasFDerivAt_zero right left X.val
+  rw [← map_zero D] at hd
+  have hd := hd.comp 0 D.hasFDerivAt
+  have hmatrix : mfderiv (𝓘(ℝ, HorizontalModel right left P)) (𝓘(ℝ, KMat 𝕜 n))
+      (fun w : HorizontalModel right left P => (cayleyFibreRetraction right left P X w).val)
+      0 v = D v := by
+    rw [mfderiv_eq_fderiv]
+    exact (congrArg (fun L : HorizontalModel right left P →L[ℝ] KMat 𝕜 n => L v)
+      hd.fderiv).trans ((pointProjection_fixed_iff_tangent_image right left P X _).mpr ⟨v,rfl⟩)
+  exact hchain.symm.trans hmatrix
+
+
+end GS.MatrixGeometry
diff --git a/GS/MatrixGeometry/Riemannian.lean b/GS/MatrixGeometry/Riemannian.lean
new file mode 100644
index 000000000..c83944926
--- /dev/null
+++ b/GS/MatrixGeometry/Riemannian.lean
@@ -0,0 +1,74 @@
+import GS.MatrixGeometry.Base
+
+import GS.MatrixGeometry.OrbitAtlas
+import GS.MatrixGeometry.AmbientDual
+import GS.Extensions.FiniteTopology
+import Mathlib.Geometry.Manifold.ContMDiffMFDeriv
+import Mathlib.Analysis.LocallyConvex.Bounded
+
+
+set_option backward.isDefEq.respectTransparency false
+/-!
+# The smooth Frobenius metric on a shared matrix orbit
+
+The horizontal atlas gives the actual shared two-factor orbit its inherited smooth
+manifold structure. Pulling the ambient Frobenius pairing back through the
+injective manifold derivative of the inclusion defines a positive definite
+metric on mathlib's actual tangent spaces. Its evaluation is smooth on the
+total tangent bundle. No assumption excluding overlap is used.
+
+The chart norm is retained. No equality between the chart norm and the
+Frobenius norm is asserted, and no norm instance is replaced.
+-/
+
+noncomputable section
+attribute [local instance] Matrix.normedAddCommGroup Matrix.normedSpace
+open GS.MatrixBase
+open scoped Manifold
+
+namespace GS.MatrixGeometry
+variable {𝕜 : Type} [RCLike 𝕜]
+
+variable  (right left : Pattern 𝕜 n) (P : KMat 𝕜 n)
+
+-- Cache the existing submodule instance so tangent-bundle elaboration does
+-- not unfold the chosen horizontal complement while searching for it.
+local instance riemannianHorizontalNormedSpace : NormedSpace ℝ (HorizontalModel right left P) :=
+  Submodule.normedSpace _
+
+local instance metricChartedSpace : ChartedSpace (HorizontalModel right left P)
+    (MatrixOrbit right left P) := sharedOrbitChartedSpace right left P
+
+
+
+attribute [local irreducible] sharedSkewSpace orbitDerivative GS.OverlapGeometry.horizontalComplement
+
+variable (X : MatrixOrbit right left P)
+
+/-- Ambient realization of a genuine manifold tangent vector. -/
+def inclusionDifferential :
+    TangentSpace (𝓘(ℝ, HorizontalModel right left P)) X →L[ℝ] KMat 𝕜 n :=
+  mfderiv (𝓘(ℝ, HorizontalModel right left P)) (𝓘(ℝ, KMat 𝕜 n))
