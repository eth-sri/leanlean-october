-/-- The two large blocks viewed either as a product or as a disjoint sum. -/
-def twoProdSumEquiv (p : ℕ) : (Fin 2 × Fin p) ≃ (Fin p ⊕ Fin p) where
-  toFun x := if x.1 = 0 then Sum.inl x.2 else Sum.inr x.2
