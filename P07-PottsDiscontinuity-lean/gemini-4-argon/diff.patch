-    }
-    {
-      exact hcs.1
-    }
-  }
-  simp only
-  apply And.intro h1
-  intro I2 h2
-  rw [@char_complete_face SC n1 hn1 _ _ hcs.1] at h2
-  obtain ⟨ i2, hi2 ⟩ := h2
-  have h2 : SC.RL (J i2) = SC.n := by {
-    let c2 := SC.RL (J i2)
-    suffices h3 : ¬ (c2 ≤ n1) by {
-      apply le_antisymm (SC.rl_proper (J i2)).1
-      omega
-    }
-    intro h2
-    obtain ⟨i3, hi3⟩ := hi2.2 c2 h2
-    apply hi3.1
-    apply rl_inj_of_complete SC.n J hcs
-    exact hi3.2
-  }
-  suffices h3 : i2 = i by {
-    rw [hi2.1, h3]
