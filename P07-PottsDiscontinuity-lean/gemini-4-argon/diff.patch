-  cases' h1 with h1 h1
-  assumption
-  cases' h1 with h1 h1
-  rw [@case_C_parent_count SC n1 hn1 I hs h1] at hbf
-  simp only [OfNat.ofNat_ne_one] at hbf
-  rw [@case_D_parent_count SC n1 hn1 I hs h1] at hbf
