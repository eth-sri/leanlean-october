-  have h6 (j2 : Fin SC.n) : j2.1 ≤ n1 := by omega
-  cases h3
-  {
-    rename_i h1
-    obtain ⟨ j2, hj2⟩ := h1
-    exfalso
-    obtain ⟨i, hi⟩ := h4 j2.1 (h6 j2)
