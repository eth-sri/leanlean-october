-private theorem integer_half_upper (a x : ℤ) (w : ℕ)
-    (h : x ≤ a + (w : ℤ)) :
-    (x : ℝ) + 1 / 2 ≤ (a + (w : ℤ) : ℝ) + 1 / 2 := by
-  have h' : (x : ℝ) ≤ (a + (w : ℤ) : ℝ) := by exact_mod_cast h
-  linarith
