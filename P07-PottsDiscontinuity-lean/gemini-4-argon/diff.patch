-  {
-    rename_i h1
-    obtain ⟨ j2, hj2⟩ := h1
-    have hj3 i : (I i j2).1 = SC.p := by {
-      rw [hj2 i]
-      exact Fin.val_last SC.p
-    }
-    suffices h3 : j = j2 by {
-      intro i
-      rw [h3, hj3 i]
-    }
-    have h3 := SC.rl_proper
