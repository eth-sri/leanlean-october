-private theorem integer_half_lower (a x : ℤ) (h : a - 1 ≤ x) :
-    (a : ℝ) - 1 / 2 ≤ (x : ℝ) + 1 / 2 := by
-  have h' : (a : ℝ) - 1 ≤ (x : ℝ) := by exact_mod_cast h
-  linarith
