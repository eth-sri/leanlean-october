-    obtain ⟨j1, hj1⟩ := h1
-    have h2 := @case_D_iff_not_end_2 SC n1 hn1 J h1.2.1 j1
-    rw [hj1,h2] at hnd
-    have h3 := Decidable.or_iff_not_not_and_not.mpr hnd
-    cases' h3 with h3 h3
