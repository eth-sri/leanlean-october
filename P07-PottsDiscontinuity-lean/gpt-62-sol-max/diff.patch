-  have hlim : (I * h) * (-(I * d)) = h * d := by
-    calc
-      (I * h) * (-(I * d)) = -(I * I) * (h * d) := by ring
-      _ = h * d := by simp [I_mul_I]
-  rw [hlim] at hprod
-  apply hprod.congr'
-  filter_upwards [self_mem_nhdsWithin] with t ht
-  have htC : (t : ℂ) ≠ 0 := by exact_mod_cast ht
