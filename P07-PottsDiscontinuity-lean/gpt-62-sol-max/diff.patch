-        g ⟨rectangleBondToGraphEdge a w h b, hb⟩ else 0) =
-      (if hb : rectangleBondToGraphEdge a w h b ∈ A then
-        f ⟨rectangleBondToGraphEdge a w h b, hb⟩ else 0) +
-      (if hb : rectangleBondToGraphEdge a w h b ∈ A then
-        g ⟨rectangleBondToGraphEdge a w h b, hb⟩ else 0)
