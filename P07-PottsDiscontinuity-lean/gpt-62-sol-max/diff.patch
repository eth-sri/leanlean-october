-    ⟨hxlo,by omega,hylo,by omega,hklo,hkhi,hnot,hseam⟩
-  rcases hbounds with ⟨_,_,hR,hU,hL⟩
-  simp only [parafermionicCoverFiniteFaceDarts, Finset.mem_insert,
-    Finset.mem_singleton] at he
