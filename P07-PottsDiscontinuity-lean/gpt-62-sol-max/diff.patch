-/-- Every actual capped boundary pairs to zero with every conserved indexed flow. -/
-theorem ribbonIntersection_zero_of_mem_boundary (hN : Even N) (hM : Even M)
-    (A : RCConfig N M) (f g : diamondCycleSpace hN hM A)
