-noncomputable def rectanglePrimalFlowDivergence (a : LatticeVertex) (w h : ℕ)
-    (F : RectanglePrimalFlow a w h) (v : LatticeVertex) : ℝ :=
-  ∑ b : rectangleActualIncidentBonds a w h v,
-    if b.1.1.source = v then F b.1 else -F b.1
