-    (q u : Fin n → ℝ) (K : NNReal) (x : ℝ) : ℝ :=
-  Finset.univ.inf' (show (Finset.univ : Finset (Fin n)).Nonempty from
-    ⟨⟨0, hn⟩, Finset.mem_univ _⟩) (fun j => u j + K * |x - q j|)
