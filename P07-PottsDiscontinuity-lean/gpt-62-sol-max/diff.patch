+private theorem uniform_optional_cylinder {A : Type*} [Finite A] (q : ℕ) (hq : 0 < q)
+    (R : Setoid A) (rep : A → Option Vertex) (pin : Set.Icc 1 q) (ξ : A → Set.Icc 1 q)
