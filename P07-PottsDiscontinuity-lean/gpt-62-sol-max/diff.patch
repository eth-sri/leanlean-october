-  apply actualReachabilityLabel_eq_of_actualConnected G A L
-  apply actualConnected_of_adj
-  rw [openGraph_adj]
-  exact ⟨⟨s(u, v), hG⟩, hA, rfl⟩
-
-end PottsDiscontinuity.FK
