-      ∏ j ∈ (univ : Finset (Fin (n + 1))).erase l, f (p j) := by
-  apply Finset.prod_congr rfl
-  intro j hj
-  rw [perturbedMomenta_of_ne p l j t (mem_erase.mp hj).1]
