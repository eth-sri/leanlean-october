-    dsimp [a,b,coverBoxPoint]
-    exact cover_vertical_down_adj 0 (-1) k
-  have hbc : (parafermionicCoverBoxGraph n).Adj b c := by
-    change parafermionicCoverGraph.Adj b.1 c.1
