-    (i : T1PairIndex n l) :
-    i.w (t1PairRunEnd i) = true ∧
-      i.w (finRotate (n + 1) (t1PairRunEnd i)) = false :=
-  (Classical.choose_spec (t1PairIndex_existsUnique_LM i)).1
-
-end PottsDiscontinuity.BetheAnsatz
