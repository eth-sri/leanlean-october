-  Equiv.ofBijective (rootIncidentFiberUnderlying (n := n) (l := l))
-    ⟨rootIncidentFiberUnderlying_injective hn,
-      rootIncidentFiberUnderlying_surjective⟩
-
-end PottsDiscontinuity.BetheAnsatz
