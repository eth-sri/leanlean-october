-open Finset PottsDiscontinuity.SixVertex
-
-namespace PottsDiscontinuity.Torus
-
-variable {N M : ℕ}
-
-theorem ribbonBoundaryOf_pairing (hN : Even N) (hM : Even M) (A : RCConfig N M)
-    (d : DirectedDart (checkerArrows N M)) :
