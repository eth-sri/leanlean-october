-    intro h
-    have := congrFun h (t1EdgeLeft i.edge)
-    rw [i.hleft] at this
-    cases this
-  have hfalse : i.w ≠ fun _ => false := by
-    intro h
-    have := congrFun h (t1EdgeRight i.edge)
-    rw [i.hright] at this
-    cases this
-  have hAll : ∀ a, i.w a = false → i.w (finRotate (n + 1) a) = true →
-      r = a ∨ r = finRotate (n + 1) a := by
-    intro a ha hb
-    have hEdge := i.hunique a ha hb
-    cases hs : i.side
