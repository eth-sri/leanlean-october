-  classical
-  apply LipschitzWith.of_le_add_mul K
-  intro x y
-  obtain ⟨j, hj, he⟩ := Finset.exists_mem_eq_inf'
-    (show (Finset.univ : Finset (Fin n)).Nonempty from ⟨⟨0, hn⟩, Finset.mem_univ _⟩)
