-theorem parafermionicCover_sheetShift_of_adj {u v : ParafermionicCoverVertex}
-    (h : parafermionicCoverGraph.Adj u v) :
-    v.2 = u.2 + parafermionicCoverSheetShift u.1 v.1 := h.2
