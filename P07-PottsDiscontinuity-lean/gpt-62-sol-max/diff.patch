-/-- The fixed-amplitude contribution of the two constant words at perturbation t. -/
-noncomputable def constantWordSumPerturbed {N n : ℕ} (c : ℝ)
-    (x : Fin (n + 1) → ℤ) (p : Fin (n + 1) → ℝ) (l : Fin (n + 1)) (t : ℝ) : ℂ :=
