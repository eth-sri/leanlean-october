-      rw [hsector, hweq, houtCoeff]
-      simp [hdout]
-    · by_cases hdin : d = din + 2
-      · have hweq : w = r.penultimate := by
-          apply Subtype.ext
-          calc
-            w.1 = parafermionicCoverCompassNeighbor v.1 d := hw
-            _ = parafermionicCoverCompassNeighbor v.1 (din + 2) := by rw [hdin]
-            _ = r.penultimate.1 := hhin
