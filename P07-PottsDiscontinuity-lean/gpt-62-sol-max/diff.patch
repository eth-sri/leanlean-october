-    {N n : ℕ} {c : ℝ} (hc : 2 < c) (hn : 0 < n)
-    (p q : Fin (n + 1) → ℝ) (x : Fin (n + 1) → ℤ)
-    (l r a : Fin (n + 1)) (w : Fin (n + 1) → Bool)
-    (hBE : BetheEquations N (anisotropy c) p)
-    (hAgree : ∀ k, k ≠ l → q k = p k)
-    (hNotOne : ∀ k, k ≠ l → z (p k) ≠ 1)
-    (ha : w a = false) (hb : w (finRotate (n + 1) a) = true)
