-theorem perturbedWordTerm_seam_pair {N n : ℕ} {c : ℝ} (hc : 2 < c)
-    (x : Fin (n + 1) → ℤ) (p : Fin (n + 1) → ℝ)
-    (hp : ∀ j, p j ∈ Set.Ioo (-Real.pi) Real.pi) (hinj : Function.Injective p)
