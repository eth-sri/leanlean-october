-    {i j : Fin N} (hi : i ∈ x) (hj : j ∉ x) (hp : prv j ∉ x) (hji : nxt j = i) :
-    NoConsecutiveUp (jump x i j) := by
-  have hij : i ≠ j := fun he => hj (he ▸ hi)
-  intro k hk hnk
