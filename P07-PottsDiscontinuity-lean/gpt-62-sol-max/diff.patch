-private theorem coverFaceBoundary_edgeFinset_card_four {n : ℕ}
-    (i : ParafermionicCoverFiniteFaceTopIndex n) :
-    (faceGraphEdges (parafermionicCoverFiniteFaceBoundaryGraph i.1 i.2)).card = 4 := by
-  classical
-  let f := i.1
