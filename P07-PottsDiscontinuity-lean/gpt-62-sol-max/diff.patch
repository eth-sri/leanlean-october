-theorem eventually_fixedAmplitudeGapSum_eq_constant_plus_t1 {N m : ℕ} {c : ℝ}
-    (hc : 2 < c) (x : Fin (m + 2) → ℤ) (hx : StrictMono x)
-    (hspan : x (Fin.last (m + 1)) - x 0 < (N : ℤ))
-    (p : Fin (m + 2) → ℝ) (hp : ∀ k, p k ∈ Set.Ioo (-Real.pi) Real.pi)
