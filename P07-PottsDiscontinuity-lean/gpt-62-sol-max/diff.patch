-/-- The end of the unique L-run, selected from its unique LM edge. -/
-noncomputable def t1PairRunEnd {n : ℕ} {l : Fin (n + 1)}
-    (i : T1PairIndex n l) : Fin (n + 1) :=
-  Classical.choose (t1PairIndex_existsUnique_LM i)
