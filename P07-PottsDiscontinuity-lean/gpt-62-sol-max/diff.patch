-        r = t1EdgeRight i.edge := by simp [r, hs]
-        _ = finRotate (n + 1) (t1EdgeLeft i.edge) :=
-          (t1EdgeLeft_rotate i.edge).symm
-        _ = finRotate (n + 1) a := by rw [← hEdge]
-    · left
-      calc
-        r = t1EdgeLeft i.edge := by simp [r, hs]
-        _ = a := hEdge.symm
