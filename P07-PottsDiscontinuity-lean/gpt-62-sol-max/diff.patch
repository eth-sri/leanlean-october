-    (Or.inl ⟨rfl, rfl, rfl, by norm_num, rfl⟩))))))
-
-noncomputable def box_anchor_step (n : ℕ) (hn : 1 ≤ n) (k : ℤ)
-    (hk : -((n^5:ℕ):ℤ) ≤ k ∧ k+1 ≤ (n^5:ℤ)) :
-    (parafermionicCoverBoxGraph n).Walk
