-    rectangleOpenFlowZeroExtend a w h A f b = 0 := by
-  classical
-  unfold rectangleOpenFlowZeroExtend
-  change (if h : rectangleBondToGraphEdge a w h b ∈ A then _ else 0) = 0
-  simp [hb]
