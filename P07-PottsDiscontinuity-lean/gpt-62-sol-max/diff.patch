-    exact (Finset.mem_filter.mp hemem).2
-  · intro j hj
-    have hjmem : j ∈ t1LMBoundarySet i.w :=
-      Finset.mem_filter.mpr ⟨Finset.mem_univ _, hj⟩
-    rw [he] at hjmem
