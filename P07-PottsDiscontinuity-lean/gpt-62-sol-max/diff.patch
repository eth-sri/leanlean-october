-def rectangleExtendedPrimalFlow (a : LatticeVertex) (w h : ℕ)
-    (F : RectanglePrimalFlow a w h) (b : LatticeBond) : ℝ :=
-  if hb : b.source ∈ latticeRectangle a w h ∧ b.target ∈ latticeRectangle a w h
-  then F ⟨b, hb⟩ else 0
