-    rw [← hrot]
-    exact he.2
-  have hmono := t1ShiftedWord_antitone i
-  constructor
-  · intro hk
-    by_contra hle
-    have hek : e < k := lt_of_not_ge hle
-    have hcast : j.castSucc < k := by rw [hj]; exact hek
-    have hsuccle : j.succ ≤ k := (Fin.castSucc_lt_iff_succ_le).mp hcast
