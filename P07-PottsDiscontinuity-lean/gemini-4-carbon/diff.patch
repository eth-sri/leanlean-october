-/-- The next full index after a first-half coordinate. -/
-def discreteHalfNextIndex (n : ℕ) (j : Fin (n / 2)) : Fin n :=
-  ⟨j.val + 1, by have := discreteHalfIndex n j |>.isLt; omega⟩
