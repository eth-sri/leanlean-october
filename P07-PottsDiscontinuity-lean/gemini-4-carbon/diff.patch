-    simp only [full_halfFlow_corner] at hc
-    change fullFlowAt f.val (nxt v.val.1,nxt v.val.2)=0 at hw
-    change fullFlowAt f.val (v.val.1,nxt v.val.2)=0 at hs
-    rw [hw,hs] at hc
