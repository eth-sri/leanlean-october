-/-- The letter weight at a nonzero-root slot. -/
-noncomputable def zeroRootLetterWeight {n : ℕ} (c : ℝ)
-    (p : Fin (n + 1) → ℝ) (σ : Equiv.Perm (Fin (n + 1)))
-    (w : Fin (n + 1) → Bool) (k : Fin (n + 1)) : ℂ :=
-  if w k then L c (z (p (σ k))) else M c (z (p (σ k)))
