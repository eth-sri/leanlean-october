-theorem latticeCellBoundaryGraph_edgeSet_eq_image (S : Finset LatticeVertex) :
-    (latticeCellBoundaryGraph S).edgeSet =
-      LatticeBond.toSym2 '' (↑(latticeCellBoundaryBonds S) : Set LatticeBond) := by
