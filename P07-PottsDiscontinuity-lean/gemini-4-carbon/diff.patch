+  have hθright (s t : ℕ) (hst : s + t = r) (k : Fin t) :
+      Tendsto (fun i => theta Δ (x i) (p i ⟨s + (N i / 2 - r) + k.val, by have := hr i; omega⟩)) l (𝓝 (theta Δ a Real.pi)) := by
