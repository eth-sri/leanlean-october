-    simpa [num, den, u] using exp_I_theta_eq_M_L_ratio hc hz0 hzu
-  have hnum : num = Complex.exp (I * (Bethe.theta (anisotropy c)
-      (q (σ 0)) (q (σ u)) : ℂ)) * den := by
-    calc
-      num = (num / den) * den := by field_simp [hden]
-      _ = _ := by rw [← htheta]
