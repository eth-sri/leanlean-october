-    funext b
-    cases hax : b.1.axis
-    · simp only [rectanglePotentialCurlValue, hax,
-        Pi.smul_apply, smul_eq_mul]
-      rw [rectanglePotentialExtendedLinear_smul, rectanglePotentialExtendedLinear_smul]
