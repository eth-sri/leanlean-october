-  dsimp
-  by_contra hn
-  have hcases : v.1 ≤ -(N : ℤ) ∨ (N : ℤ) < v.1 ∨
-      v.2 ≤ -(N : ℤ) ∨ (N : ℤ) < v.2 := by omega
-  apply hv
-  rcases hcases with hl | hr | hb' | ht
