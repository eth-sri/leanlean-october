-    FK.squareLattice.Walk (v.1,Y) (u.1,Y) :=
-  (straightWalk (v.1,Y) .west (v.1-u.1).toNat).copy rfl (by
-    ext <;> simp [straightPosition,portVector,Int.toNat_of_nonneg (by omega : 0 ≤ v.1-u.1)])
