-    rw [z, ← Complex.exp_nat_mul]
-    congr 1
-    ring
-  have hthetaSeam :
-      Complex.exp (I * (Bethe.theta (anisotropy c)
-          (p (σ u)) 0 : ℂ)) *
-        Complex.exp (I * (Bethe.theta (anisotropy c)
-          t (p (σ u)) : ℂ)) * z t ^ N =
