-    o.source e ≠ o.target e := by
-  have hdiag : ¬ (e.1.1).IsDiag := G.not_isDiag_of_mem_edgeSet e.1.2
-  have hnot : ¬ (s(o.source e, o.target e)).IsDiag := by simpa [o.endpoints e] using hdiag
-  intro heq
-  exact hnot ((Sym2.mk_isDiag_iff).2 heq)
