-      -(N : ℤ) ≤ x.1 ∧ x.1 ≤ (N : ℤ) ∧ -(N : ℤ) ≤ x.2 ∧ x.2 ≤ (N : ℤ) := by
-    have h := (mem_latticeBox (0,0) x N).1 (hN x (by simpa using hx))
-    dsimp at h
