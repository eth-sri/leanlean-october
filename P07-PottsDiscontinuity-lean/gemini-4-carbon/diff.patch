-      (if t1ShiftedWord i k = true then 1 else 0) at hleval
-    simp [he.1] at hleval
-    cases hk : t1ShiftedWord i k <;> simp [hk] at hleval ⊢
-
-end PottsDiscontinuity.BetheAnsatz
