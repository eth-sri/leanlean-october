-      (∏ j : Fin n, f ⟨s + j.val, by omega⟩) *
-      ∏ j : Fin s, f ⟨s + n + j.val, by omega⟩ := by
-    rw [Fin.prod_univ_add, Fin.prod_univ_add]
-    rfl
-  have hmid : (∏ j : Fin n, f ⟨s + j.val, by omega⟩) =
