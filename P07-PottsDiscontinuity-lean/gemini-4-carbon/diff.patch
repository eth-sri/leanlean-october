-  rw [ratio_interiorTest_on_cell hp v j hx, rootStepDensity_interior hp hs j hx]
-  ring
-
-theorem ratio_interiorTest_outside {k N : ℕ} {p : Fin (k + 1) → ℝ}
-    (hp : p ∈ S_n (k + 1)) (v : Fin (k + 1) → ℝ) {x : ℝ}
