-def rectangleOpenFlowSubmodule : Submodule ℝ (RectanglePrimalFlow a w h) where
-  carrier := {F | ∀ b : RectanglePrimalBond a w h,
-    rectangleBondToGraphEdge a w h b ∉ A → F b = 0}
