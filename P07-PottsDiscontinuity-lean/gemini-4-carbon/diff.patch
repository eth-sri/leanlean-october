-/-- Basis vector `e_j-e_(n+1-j)` for the symmetric subspace. -/
-def discreteSymBasis (n : ℕ) (j : Fin (n / 2)) : Fin n → ℝ := fun ell =>
-  if ell = discreteHalfIndex n j then 1
-  else if ell = Fin.rev (discreteHalfIndex n j) then -1 else 0
