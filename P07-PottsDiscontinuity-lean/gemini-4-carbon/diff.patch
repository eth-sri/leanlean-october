-agrees eventually with the physical Perron root. -/
-theorem cor34_final_even_family_eventually_physical_pfRoot {N n r : ℕ}
-    {d₀ : ℝ} {p P : ℝ → Fin n → ℝ}
-    (hd₀ : d₀ < -1) (hp : ∀ d ≤ d₀, p d ∈ Bethe.S_n n)
-    (hBE : ∀ d ≤ d₀, Bethe.DiscreteBetheEquation d N n (p d))
