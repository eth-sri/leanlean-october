-theorem actualReachabilityLabel_eq_of_actualConnected (G : SimpleGraph V)
-    (A : Configuration G) (L : Finset V) {x y : V}
-    (hxy : ActualConnected G A x y) :
-    actualReachabilityLabel G A L x = actualReachabilityLabel G A L y := by
-  classical
