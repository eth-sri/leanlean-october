-    (hNpos : 0 < N) (hbound : 2 * n ≤ N) (hnpos : 0 < n)
-    (hnq : n + 1 = 2 * q) (hN : N = 2 * (n + r)) (hr : 0 ≤ r) :
-    ∀ᶠ ε in 𝓝[<] (0 : ℝ),
-      BetheAnsatz.eigenvalueZero N (Real.sqrt (2 - 2 / ε)) (P ε)
-          (⟨q - 1, by omega⟩ : Fin n) =
