-/-- Integer coordinates of the lift associated with an integer seam potential. -/
-def potentialLiftCoordinates (F : FaceVertex N M true → ℤ) (v : FaceVertex N M true) : ℤ × ℤ :=
-  ((v.val.1.val : ℤ)+(N : ℤ)*F v,v.val.2.val)
