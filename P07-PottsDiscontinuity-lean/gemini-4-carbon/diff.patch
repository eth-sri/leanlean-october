-  induction path with
-  | nil => simp [zeroRootZipperPerm]
-  | cons a tail ih =>
-      cases tail with
-      | nil => simp [zeroRootZipperPerm]
-      | cons b rest =>
-          have hka : k ≠ a := by
-            intro heq
-            exact hk (List.mem_cons.mpr (Or.inl heq))
-          have hkb : k ≠ b := by
-            intro heq
