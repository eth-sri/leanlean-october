-/-- Actual rectangle flows whose incidence divergence vanishes at every
-primal rectangle vertex. -/
-def rectangleDivergenceFreeFlowSubmodule (a : LatticeVertex) (w h : ℕ) :
-    Submodule ℝ (RectanglePrimalBond a w h → ℝ) where
