-      ∃ W : Set (T × X), IsOpen W ∧ (t, x) ∈ W ∧
-        ∀ u y, (u, y) ∈ W → R u y → y = φ u)
-    (t₀ : T) (hbase : ∃! x, R t₀ x) : ∀ t, ∃! x, R t x := by
