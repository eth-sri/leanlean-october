-    -r * Real.log (abs (-Real.cosh lam)) +
-        r * (∫ x in (-π)..π,
-          fourierEllPrime lam x * Bethe.tau (-Real.cosh lam) x) =
-        -r * (Real.log (abs (-Real.cosh lam)) -
-          ∫ x in (-π)..π,
-            fourierEllPrime lam x * Bethe.tau (-Real.cosh lam) x) := by ring
-    _ = -r * (lam + 2 * S) := by rw [hvalue]
