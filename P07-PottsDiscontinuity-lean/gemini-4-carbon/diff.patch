-        Equiv.swap (Fin.last n) 0 k := by
-      simpa only [Equiv.trans_apply] using
-        congrArg (fun e : Fin (n + 1) ≃ Fin (n + 1) => e k) hEq
-    exact congrArg Fin.val hpoint
