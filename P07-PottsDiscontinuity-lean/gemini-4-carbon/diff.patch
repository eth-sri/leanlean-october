-    {u v : LatticeVertex} (p : squareLattice.Walk u v) : Path
-      (latticeEmbed exclusionMesh (a.1 - 1,u.2))
-      (latticeEmbed exclusionMesh (a.1 + (w : ℤ) + 1,v.2)) :=
