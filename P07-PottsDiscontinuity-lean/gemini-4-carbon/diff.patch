-  have hdiff := hmono (show (⟨m, by omega⟩ : Fin (2 * m)) ≤ ⟨m + k, by omega⟩ by
-    change m ≤ m + k
-    omega)
-  simp only [Nat.cast_add] at hdiff
-  nlinarith only [hcentral, hdiff]
