-def upperReturnNorth (v : ℤ × ℤ) (Y : ℤ) (hv : v.2 < Y) :
-    FK.squareLattice.Walk v (v.1,Y) :=
-  (straightWalk v .north (Y-v.2).toNat).copy rfl (by
-    ext <;> simp [straightPosition,portVector,Int.toNat_of_nonneg (by omega : 0 ≤ Y-v.2)])
