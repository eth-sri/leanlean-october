-  have hidx : (⟨m - 1 + 1, by omega⟩ : Fin (2 * m)) = ⟨m, by omega⟩ := by
-    apply Fin.ext
-    change m - 1 + 1 = m
-    omega
-  rw [hidx, ratio_central_pair hm hp] at h
-  linarith
-
-end PottsDiscontinuity.Bethe
