-theorem ratio_positive_rank_lower {m N : ℕ} (hm : 0 < m) {p : Fin (2 * m) → ℝ}
-    (hp : p ∈ S_n (2 * m)) (hs : 2 * (2 * m) ≤ N) {M : ℝ}
-    (hupper : ∀ x ∈ Icc (-Real.pi) Real.pi,
-      rootStepDensity N (2 * m) p hp (by omega) hs x ≤ M)
-    (k : ℕ) (hk : k < m) :
