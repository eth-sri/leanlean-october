-    (thetaPartialSecond Δ (p (discreteHalfIndex n i)) (p (discreteHalfIndex n k)) -
-      thetaPartialSecond Δ (p (discreteHalfIndex n i))
-        (p (Fin.rev (discreteHalfIndex n k)))) / (N : ℝ)
