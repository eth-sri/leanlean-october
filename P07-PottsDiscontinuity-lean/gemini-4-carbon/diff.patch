-/-- The normalized even-branch coordinate wave satisfies the normalized block eigen-equation
-at every physical parameter. -/
-theorem cor34_final_even_normalized_eigen {N n : ℕ} {ε : ℝ}
-    (hε : ε < 0) (hInv : 1 / ε < -1)
