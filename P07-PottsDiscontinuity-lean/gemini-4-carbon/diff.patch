-noncomputable def rootSlotWordSurvivorConstantEquiv {n : ℕ} {l : Fin (n + 1)} :
-    {i : RootSlotWordSurvivorIndex n l // rootSlotWordConstant i.1} ≃
-      RootSlotWordConstantIndex n l where
