-    ⟨(hp.1 _).1.le, (hp.1 _).2.le⟩
-  have hx : p (discreteHalfIndex n i) ∈ Icc (-Real.pi) Real.pi :=
-    ⟨(hp.1 _).1.le, (hp.1 _).2.le⟩
