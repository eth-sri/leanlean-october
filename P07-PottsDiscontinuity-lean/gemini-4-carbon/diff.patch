-            cor34_normalizedBlockWave (N := N) ε (P ε) := by
-    filter_upwards [hnonzero, hInv, self_mem_nhdsWithin] with ε hw hΔ hε
-    have hε' : ε < 0 := by simpa only [Set.mem_Iio] using hε
-    have hrecip : 1 / (1 / ε) = ε := by field_simp [ne_of_lt hε']
