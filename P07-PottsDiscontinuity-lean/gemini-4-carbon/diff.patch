-                (zeroRootZipperRun (b :: rest) (σ', w')).2 =
-              zeroRootRegularizedWordTerm (N := N) c x p l σ' w' := htail
-            _ = zeroRootRegularizedWordTerm (N := N) c x p l σ w := htermStep
-
-end PottsDiscontinuity.BetheAnsatz
