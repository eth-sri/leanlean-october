-    Fintype (T1PairIndex n l) := by
-  classical
-  apply Fintype.ofInjective (fun i => (i.σ, i.w, i.edge))
-  intro i j hij
-  cases i with
-  | mk σ w edge hσ hleft hright hunique =>
-    cases j with
-    | mk σ' w' edge' hσ' hleft' hright' hunique' =>
-      simp only [Prod.mk.injEq] at hij
-      rcases hij with ⟨rfl, rfl, rfl⟩
-      rfl
