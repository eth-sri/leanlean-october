-  unfold ratioInteriorTest
-  apply Finset.sum_eq_zero
-  intro j hj
-  apply indicator_of_notMem
-  intro hcell
-  rcases hx with hleft | hright
-  · have he := hp.2.1.monotone (show (0 : Fin (k + 1)) ≤ j.castSucc from Fin.zero_le _)
