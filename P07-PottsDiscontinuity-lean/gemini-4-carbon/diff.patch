+    induction n with
+    | zero => simp
+    | succ n ih =>
+      rw [show Finset.Icc (R : ℤ) ((R : ℤ) + ↑(n + 1)) = insert ((R : ℤ) + ↑(n + 1)) (Finset.Icc (R : ℤ) ((R : ℤ) + ↑n)) by
