-    {x : ParafermionicCoverBoxVertex n}
-    (p : (parafermionicCoverBoxGraph n).Walk x x) (hp : p.IsCycle)
-    (v : ParafermionicCoverBoxVertex n) (hv : v ∈ p.support) :
