+private noncomputable def ratioZeroCoefficient {n : ℕ} (Δ c : ℝ) (N : ℕ) (q : Fin n → ℝ) (l : Fin n) : ℝ :=
+  2 + c ^ 2 * ((N : ℝ) - 1) + c ^ 2 * ∑ j ∈ univ.erase l, d1Theta Δ 0 (q j)
