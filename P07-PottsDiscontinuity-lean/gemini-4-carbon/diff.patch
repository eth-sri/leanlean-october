-theorem ratio_even_quotient_split {m n s : ℕ} (hcount : s + n + s = m)
-    {p : Fin m → ℝ} {q : Fin n → ℝ} {c : ℝ} (hc : 2 < c)
-    (hp : p ∈ S_n m) (hq : q ∈ S_n n) :
