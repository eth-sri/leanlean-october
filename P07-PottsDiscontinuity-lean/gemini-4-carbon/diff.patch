-      (∃ u, u ∈ L ∧ ActualConnected G A u y) := by
-    constructor
-    · rintro ⟨u, hu, hux⟩
-      exact ⟨u, hu, hux.trans hxy⟩
-    · rintro ⟨u, hu, huy⟩
-      exact ⟨u, hu, huy.trans hxy.symm⟩
-  apply Bool.eq_iff_iff.mpr
