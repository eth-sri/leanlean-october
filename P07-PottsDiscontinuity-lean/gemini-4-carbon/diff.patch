+    hE.eventually (gt_mem_nhds (by positivity : (0 : ℝ) < ε / 2))] with i hi hEi
+  have hd := dist_triangle (u i) (v i) a; have he := hb i
+  simp only [Real.dist_eq] at hd hi ⊢; linarith
