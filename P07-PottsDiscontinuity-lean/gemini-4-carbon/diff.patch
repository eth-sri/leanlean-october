-/-- The `j`th coordinate among the first `⌊n/2⌋` coordinates, regarded as a `Fin n`. -/
-def discreteHalfIndex (n : ℕ) (j : Fin (n / 2)) : Fin n :=
-  ⟨j.val, lt_of_lt_of_le j.isLt (Nat.div_le_self n 2)⟩
