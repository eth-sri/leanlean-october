-structure CountSort.Post (μ : ℕ → ℤ) (A : Args) (it kf : ℕ → ℕ) (μ' : ℕ → ℤ) : Prop where
-  placed : ∀ j < A.n, μ' (A.dst + sortPos kf A.n j) = it j
-  starts : ∀ t ≤ A.nb, μ' (A.cnt + t) = cntLt kf t A.n
