-  have hK : (0 : ℝ) ≤ K := by positivity
-  have hB : 400 ≤ A * (preBound31 γ N D₀ + (w : ℝ) * queryBound31 q D₀) := by linarith
-  calc (t N D₀ w : ℝ) + 400 + K
-      ≤ A * (preBound31 γ N D₀ + (w : ℝ) * queryBound31 q D₀)
