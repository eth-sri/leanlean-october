+private theorem offline32P_meets {aI aJ out d : ℕ} {u : ℤ} {WI WJ : List ℕ}
+    (hg : Input31 lim G X Y aX aY fr U) (hin : OfflineInput32 X Y aX aY aI aJ out fr WI WJ μ)
