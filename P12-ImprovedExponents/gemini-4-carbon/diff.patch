+    have hcol : μ' (aJ + i) = ((WJ[i] : ℕ) : ℤ) :=
+      (hinv.read hin.cols (j := i) (by simpa using hiJ)
+        (by rcases hin.out_cols with h | h <;> omega) (by omega)).trans (List.getElem_map _)
