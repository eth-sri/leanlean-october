-  .set PowFour (k 1) ;;
-  .set PowTwo (k 1) ;;
-  .set Expo (k 0) ;;
-  regimeExp ;;
-  .set Result (k 0) ;;
-  regimeTests ;;
-  .set Rows (v Result)
