-      .of_body (getElem?_append_of_eq_some hbrute Q) (Sec2.thinBrute_spec
-        ⟨ok.space, by exact_mod_cast h100⟩ x μ fr (x.U : ℤ) hpre hroom (hfits _ (by omega)))
