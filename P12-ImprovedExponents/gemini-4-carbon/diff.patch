-/-- The side n of the matrix. -/
-abbrev Side : ℕ := 0
-/-- The address of the source. -/
-abbrev Src : ℕ := 1
-/-- The summand c. -/
-abbrev Shift : ℕ := 2
-/-- The address of the destination. -/
-abbrev Dst : ℕ := 3
-/-- The column j of the source. -/
-abbrev Col : ℕ := 4
-/-- The address of the row j of the destination. -/
-abbrev Row : ℕ := 5
