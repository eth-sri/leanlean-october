-
-namespace ImprovedExponents.AllEdges
-
-open Light Light.Sec3 ThreeSumApsp ThreeSumApsp.Spec
-
-/-! ## The text -/
-
-namespace PairsHost
-
-/-- The number n of vertices. -/
-abbrev Verts : ℕ := 0
-/-- The bound U on the entries. -/
-abbrev Bound : ℕ := 1
-/-- The address of X. -/
-abbrev MatX : ℕ := 2
-/-- The address of Y. -/
-abbrev MatY : ℕ := 3
-/-- The address of V. -/
-abbrev MatV : ℕ := 4
-/-- The address of the flags. -/
-abbrev Out : ℕ := 5
-/-- The free pointer, where the array q begins: the prefixes of X + U. -/
-abbrev PreX : ℕ := 6
-/-- n². -/
-abbrev Cells : ℕ := 7
-/-- 2^b. -/
-abbrev Power : ℕ := 8
-/-- The number b of levels. -/
-abbrev Levels : ℕ := 9
-/-- The number of the round. -/
-abbrev Round : ℕ := 10
-/-- The result of a call. -/
-abbrev Res : ℕ := 11
