-/-- The routine for `g` runs within the bound of Theorem 17 (within the term `n² D g`). -/
-theorem stepsG_budget : Steps (fun θ => pk.tG θ.D) budget := pk.stepsG.withinBuild
-
-end ParamPack
-
-end ImprovedExponents.ParamRoutines
