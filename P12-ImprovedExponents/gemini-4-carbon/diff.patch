-      ([Sec2.regimeBody, Sec2.thinBruteBody, Sec2.thinBody] ++ List.replicate 11 .skip ++ procs40
-        ++ [preCoreBody, queryAtBody, wantedCoreBody, wantedMainBody] ++ procs31 G
-        ++ [powLtBody, testRSBody r s, allRSBody] ++ procsP G) := by
