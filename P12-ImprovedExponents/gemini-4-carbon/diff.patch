-  .ite (v Fits =' k 1)
-    (.ite (v Rows *' v Rows <' v Wanted *' v PowTwo) .skip (.set Result (v Expo)))
-    .skip
-
-/-- The four tests: 4^m = D, m ≥ 1, D^18 ≤ N and w 2^m ≤ N².  If all hold, the result becomes m. -/
