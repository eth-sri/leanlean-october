+    (K L m : ℝ) ≤ exp ((m : ℝ) * cEntropy ((L : ℝ) / m)) := by
+  have hm0 : (0 : ℝ) < m := by exact_mod_cast hm
+  have hexp : (m : ℝ) * cEntropy ((L : ℝ) / m)
