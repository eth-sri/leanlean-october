-abbrev LEN : ℕ := 0
-/-- The permutation, sorted order to given order. -/
-abbrev PERM : ℕ := 1
-/-- The values, in sorted order. -/
-abbrev VALS : ℕ := 2
-/-- The output. -/
-abbrev OUT : ℕ := 3
-/-- The place i in the sorted order. -/
-abbrev POS : ℕ := 4
-
-end ReportLocal
