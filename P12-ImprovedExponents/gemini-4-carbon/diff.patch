+  rw [A.base]
+  generalize D (logFour D₀) = F at A ⊢; generalize (F - D₀) * N = R at A ⊢
+  obtain ⟨μ₁, hμ₁⟩ : ∃ μ₁, μ₁ = Function.update μ (fr + 2) ((F : ℕ) : ℤ) := ⟨_, rfl⟩
+  rw [← hμ₁]
