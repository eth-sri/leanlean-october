-@[inherit_doc Num] abbrev Tiles : ℕ := 2
-@[inherit_doc Num] abbrev TileOf : ℕ := 3
-@[inherit_doc Num] abbrev Digits : ℕ := 4
-@[inherit_doc Num] abbrev Perm : ℕ := 5
-@[inherit_doc Num] abbrev Idx : ℕ := 6
