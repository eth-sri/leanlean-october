+      = (L : ℝ) ^ L / (((L - m : ℕ) : ℝ) ^ (L - m) * (m : ℝ) ^ m) := by
+    rw [hexp, ← exp_neg_negMulLog_natCast (L - m), ← exp_neg_negMulLog_natCast L,
+      ← exp_neg_negMulLog_natCast m, ← exp_add, ← exp_sub]
