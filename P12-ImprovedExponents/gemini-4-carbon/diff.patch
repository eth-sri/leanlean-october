-    rintro _ - ⟨r, μ', rfl, hrows, hrest⟩
-    exact ⟨fun q hq => (hrows q (by simpa using hq)).trans (List.getD_eq_getElem _ _ hq), hrest⟩
-
-end Light.Sec3
