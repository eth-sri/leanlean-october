-  refine Ends.iteLast (fun hyes => ?_) (fun hno => ?_)
-  · -- Found := 1
-    have hit : Hit x t s := flag_eq_one_iff.1 (by simpa [hres] using hyes)
-    exact Ends.setTo 1
-      ⟨res', μ₂, by rw [flag_of (Nat.exists_lt_succ_right.2 (Or.inr hit))]; rfl, hkept⟩
