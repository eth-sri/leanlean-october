-  .set Idx (v Buckets) ;;
-  .while (k 0 <' v Idx) (
-    .store (v Cnt +' v Idx) (M (v Cnt +' v Idx -' k 1)) ;;
-    .set Idx (v Idx -' k 1)) ;;
-  .store (v Cnt) (k 0)
