-abbrev Perm : ℕ := 1
-/-- The array that is read. -/
-abbrev Src : ℕ := 2
-/-- The array that is written. -/
-abbrev Dest : ℕ := 3
-/-- The counter i of the loop. -/
-abbrev Pos : ℕ := 4
-
-end GatherLocal
-
-open GatherLocal
-
-/-- gather(w, perm, src, dst): dst[i] := src[perm[i]] for i < w. -/
-def gatherBody : Stmt :=
