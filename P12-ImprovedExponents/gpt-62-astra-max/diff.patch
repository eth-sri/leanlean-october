+  simp [residue,Int.toNat_of_nonneg (Int.emod_nonneg _ (by omega : (M:ℤ) ≠ 0))]
+
+theorem residue_lt (hM : 1≤M) (sg z : ℤ) : residue M sg z < M :=
+  Int.toNat_emod_lt hM _
+
