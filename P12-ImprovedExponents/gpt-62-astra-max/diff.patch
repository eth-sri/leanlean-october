-    simp only [pairsTimeAE, roundTime, probeTime]
-    ring
-  rw [htime]
-  unfold paBody
-  -- paInit
-  refine Ends.next _ ((init_spec C).mono le_rfl ?_) (by simp [paInit]; omega)
-  rintro _ rfl
-  -- paPow
-  refine Ends.next _ ((pow_spec C).mono le_rfl ?_) (by simp [paInit]; omega)
-  rintro _ rfl
