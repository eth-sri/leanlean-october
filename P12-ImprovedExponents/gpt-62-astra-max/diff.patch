-    (hDi : DistinctSpec lim P pDistinct) (hBi : BitsSpec lim P pBits) : PrepSpec lim P p :=
-  fun _ _ _ _ _ _ C hseg => Meets.of_body hP (prepBody_ends hPr hFi hCo hSo hDi hBi C hseg)
