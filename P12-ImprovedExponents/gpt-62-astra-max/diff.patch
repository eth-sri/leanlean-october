+private theorem givesPos {σ : State} {id src n : ℕ} (q : Fin 4) (base : σ.loc id = src)
+    (half : σ.loc Half = n) (hn : 2*n+2 ≤ lim.word) (room : ((src+origin q n:ℕ):ℤ) ≤ lim.word) :
