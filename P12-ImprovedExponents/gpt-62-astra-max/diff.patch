-open ReportLocal in
-/-- report(w, perm, sv, out): OUT[PERM[i]] := VALS[i] for i < w, where VALS is the array at sv. -/
-def reportBody : Stmt :=
-  .for POS (v LEN) (.store (v OUT +' M (v PERM +' v POS)) (M (v VALS +' v POS)))
-
-variable {lim : Limits} {P : Program} {c i : ℕ} {μ μ' : ℕ → ℤ}
-
-/-! ## The report -/
