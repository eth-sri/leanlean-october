-  · rintro ⟨_, ha', b, hb, _, hc, hs⟩
-    obtain ⟨a, ha, rfl⟩ := mem_image.mp ha'
-    obtain ⟨-, ha0, h2⟩ := mem_filter.mp ha
-    obtain ⟨k, -, rfl⟩ := mem_image.mp hc
