-  std : Std lim
-  t_le : x.t ≤ x.m
-  m_le : x.m ≤ x.L
-  /-- Every value and every partial sum fits in a word. -/
-  value_le : ∃ A B : ℤ, (∀ β τ, |x.encA β τ| ≤ A) ∧ (∀ β τ, |x.encB β τ| ≤ B) ∧
