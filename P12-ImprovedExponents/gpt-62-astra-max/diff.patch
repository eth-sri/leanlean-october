-    by_cases hwx : (i, w) = x
-    · rw [hwx, Function.update_self]
-      omega
-    · rw [Function.update_of_ne hwx]
-      by_cases happ : (i, w ++ [a]) = x
-      · exact hparent i w a happ
-      · exact h.closed i w a (by rwa [Function.update_of_ne happ] at hnd)
