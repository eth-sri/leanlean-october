-    exact ⟨by light_side, by simp; omega, by simpa [← hout] using seg, same⟩
-  case round =>
-    rintro _ σ ht ⟨i, j, rfl, hI⟩
-    have left := takeLeft C hI
-    have right := takeRight C hI
-    obtain ⟨μ', out, rfl, hi, hj, same, -⟩ := hI
