-/-- **Strassen's algorithm**, at every level. -/
-theorem strassen_spec : ∀ j, StrSpec lim P ν j
-  | 0 => strassen_zero prog hw
-  | j + 1 => strassen_succ prog hw (strassen_spec j)
-
-end levels
-
-end Light.Sec3
