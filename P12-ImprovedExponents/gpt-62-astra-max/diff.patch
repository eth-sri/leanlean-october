-private theorem newChild (h : TrieInv L lo μ nd fr) {i : ℕ} {w : List ℕ} {a : ℕ} (ha : a < 11)
-    (hw : nd (i, w) ≠ 0) (hwa : nd (i, w ++ [a]) = 0) :
-    TrieInv L lo (Function.update μ (nd (i, w) + a) fr) (Function.update nd (i, w ++ [a]) fr)
-      (fr + 11) := by
