-    ((Above (ℓ + 1) b c ∨ c = (ℓ + 1, 2)) ∨ c = (ℓ + 1, 3)) ↔ Above ℓ b c := by
-  obtain ⟨l, r⟩ := c
-  simp only [Above, Prod.mk.injEq]
-  constructor
-  · rintro ((⟨h1, h2, h3⟩ | ⟨rfl, rfl⟩) | ⟨rfl, rfl⟩) <;> omega
-  · rintro ⟨h1, h2, h3⟩
-    by_cases hl : l = ℓ + 1
-    · subst hl
-      rcases h3 with rfl | rfl <;> simp
-    · exact Or.inl (Or.inl ⟨by omega, h2, h3⟩)
