+  · intro h i hi; change i<M at hi
+    have small : i<C := hi.trans_le hC
+    fin_cases h
+    · change ν₃ (a.fr+0*C+i)=_; change ∀ i<C, ν₁ (a.fr+0*C+i)=_ at v₁; simp only [zero_mul,add_zero] at v₁ ⊢
