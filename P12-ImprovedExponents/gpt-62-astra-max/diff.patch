-    by simp only [List.length_append, List.length_singleton]; omega,
-    seg.snoc _, by rw [← hout, hm]; simp⟩
-  simp [mergeTakeLeft, update_frame_setLocal, haddr, hread]
-
-/-- dst[i + j] := b[j]; j := j + 1. -/
