+    rw [← Real.rpow_natCast]; apply Real.rpow_le_rpow_of_exponent_le h1; grind
+  have hem : n^2 ≤ κ * (n^(3-δ) * Real.log n ^ 1) := by
+    calc n^2 = 1 * ((n:ℝ)^2 * 1) := by ring
+      _ ≤ _ := by gcongr; simpa using Real.one_le_log_natCast_of_three_le h3
