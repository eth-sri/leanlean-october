-  have hw := C.ok.space
-  have hcells := C.ok.cells
-  have hword := C.ok.word
-  have hdepth := C.ok.depth
-  simp only [prepNeed] at hcells hword hdepth
-  push_cast at hword
-  have : (0 : ℤ) ≤ ((a.m : ℤ) + 1) ^ 2 := by positivity
-  have htime : tDistinct Ls.length = tDistinct a.n := by rw [hlen]
