+private theorem decisionHost : IsHost aeTask etTask (fun T n U => T n U + 32 * (n*n + 1)) decNeed := by
+  constructor
+  · intro P p T need h
+    refine ⟨[decideBody p], P.length, decideBody p, by simp, ?_⟩
+    intro R lim d x μ fr pre ok
+    change TriInst at x
