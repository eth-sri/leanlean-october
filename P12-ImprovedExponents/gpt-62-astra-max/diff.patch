-  .store (v Base +' k 1) (v PrimeBound) ;;
-  .store (v Base +' k 2) (v Digits) ;;
-  .store (v Base +' k 3) (v NumPrimes) ;;
-  .store (v Base +' k 4) (v Primes) ;;
-  .store (v Base +' k 5) (v Count) ;;
-  .store (v Zero) (k 0) ;;
-  .set Len (v NumValues)
