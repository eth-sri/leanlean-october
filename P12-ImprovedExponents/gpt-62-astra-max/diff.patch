-/-- The instances at the levels above `ℓ` (and at most `b`) with `r ∈ {2, 3}`. -/
-def Above (ℓ b : ℕ) (c : ℕ × ℤ) : Prop := ℓ < c.1 ∧ c.1 ≤ b ∧ (c.2 = 2 ∨ c.2 = 3)
