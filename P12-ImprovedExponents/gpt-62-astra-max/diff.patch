+    let loc (j : ℕ) := frame [flag (hit j), x.U,x.ab,x.bc,x.ac,fr,(x.n*x.n),j]
+    have step (j : ℕ) : hit (j+1) ↔ hit j ∨ ν (fr+j) = 1 := by
