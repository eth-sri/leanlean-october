-x[a D + c p + t] := 1. -/
-def writeXCell : Stmt :=
-  .set T (M (v RES +' v A *' v N +' v C0 +' v C) +' v RHO) ;;
-  .ite (v T <' v PR) .skip (.set T (v T -' v PR)) ;;
