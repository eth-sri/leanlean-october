-
-namespace CountSort
-
-/-- The arguments of countSort. -/
-structure Args where
-  /-- the number of items -/
-  n : ℕ
-  /-- where the items stand -/
-  src : ℕ
-  /-- where the sorted items go -/
-  dst : ℕ
-  /-- the key of the item x is in the cell key + x · stride + off -/
-  key : ℕ
-  /-- see key -/
-  stride : ℕ
-  /-- see key -/
-  off : ℕ
-  /-- all keys are below nb -/
-  nb : ℕ
-  /-- nb + 1 cells of scratch space -/
-  cnt : ℕ
