-  .store (v ROW +' v LEV) (v DIG) ;;
-  .set ACC (v ACC *' k 10 +' v DIG) ;;
-  .set LEV (v LEV +' k 1)
-
-/-- The digit of the level: 9 at a level of the subset, and otherwise 3 x + y for the next digits
