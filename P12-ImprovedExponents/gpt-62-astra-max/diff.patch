-open SumTen in
-/-- One round: write the digit at the position of the star, look the string up, and add. -/
-def sumTenRound : Stmt :=
-  .store (v Box +' v Star) (v Digit) ;;
-  .call Proc.lookup [v Area, v Root, v Box, v Len] Val ;;
-  .set Sum (v Sum +' v Val)
-
