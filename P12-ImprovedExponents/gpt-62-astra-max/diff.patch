+    (B : SetAt τ (w.out+w.n) (w.slot (w.out+w.n) q b).len (w.slot (w.out+w.n) q b).set)
+    (C : SetAt τ (w.out+w.n+w.n) (w.slot (w.out+w.n+w.n) q c).len (w.slot (w.out+w.n+w.n) q c).set)
