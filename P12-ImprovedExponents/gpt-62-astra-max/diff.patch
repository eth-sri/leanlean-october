+  refine ⟨by simp,?_,?_,block_le ..⟩
+  · intro u hu; obtain ⟨i,hi,j,hj,rfl⟩ := Nat.exists_eq_mul_add_of_lt_mul (show u<x.t*x.t by simpa using hu)
