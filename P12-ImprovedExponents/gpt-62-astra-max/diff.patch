+    simp [decNeed] at hdepth
+    rw [List.append_assoc]
+    change Ends _ _ _ _ ⟨frame [x.n,x.U,x.ab,x.bc,x.ac,fr], μ⟩ (T x.n x.U + 32*(x.n*x.n+1)) _
+    light_set (x.n*x.n) using hn
