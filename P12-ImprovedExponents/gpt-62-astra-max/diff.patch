+/-- The decision host simply tests whether any of the output flags is set. -/
+private def decideBody (p : ℕ) : Stmt :=
+  .set 6 (v 0 *' v 0) ;;
+  .call p [v 0, v 1, v 2, v 3, v 4, v 5, v 5 +' v 6] 0 ;;
+  .set 0 (k 0) ;;
+  .for 7 (v 6) (.ite (M (v 5 +' v 7) =' k 1) (.set 0 (k 1)) .skip)
