-dst + i h.  pCopy is the number of the procedure copy. -/
-def subCopyBody (pCopy : ℕ) : Stmt :=
-  .for Row (v Block) (
-    .call pCopy [v Source +' (v Row0 +' v Row) *' v Side +' v Col0, v Dest +' v Row *' v Block,
-      v Block] Unused)
