+          x.Same μ μ'' ∧ ClsPlaced x (i + 1) μ'' := by
+  light_facts pre
+  have hread := pre.read hrest hi
+  have hk := pre.key_lt hi
+  have : sortPos (clsKey x.RAB) (x.n * x.n) i < x.n * x.n := sortPos_lt (clsKey x.RAB) hi
