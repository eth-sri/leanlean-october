-    (hsep : Apart fl len out len)
-    (hlim : (lim.space : ℤ) ≤ lim.word ∧ fl + len ≤ lim.space ∧ out + len ≤ lim.space)
-    (hflag : ∀ f ∈ F, f = 0 ∨ f = 1) (hL01 : ∀ o ∈ L, o = 0 ∨ o = 1) (hw : 1 ≤ lim.word) :
-    Meets lim P p d [(len : ℤ), fl, out] μ (31 * len + 6) fun _ μ' =>
