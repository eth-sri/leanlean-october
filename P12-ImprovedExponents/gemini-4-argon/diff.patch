-  .ite (v Idx ≤' v Row) (.set Jdx (v Row -' v Idx)) (.set Jdx (v Row +' v Len -' v Idx)) ;;
-  .set Acc (v Acc +' M (v ArgA +' v Idx) *' M (v ArgB +' v Jdx))
