-/-- `D ≤ N^ε` with `ε ≤ s/r` puts the instance in the regime `D^r ≤ N^s`, for `1 ≤ r`. -/
-theorem pow_le_pow_of_le_rpow {N D₀ r s : ℕ} {ε : ℝ} (hr : 1 ≤ r) (hε : ε ≤ (s : ℝ) / r)
