-/-- **Row 0** is zero. -/
-theorem digitsZero_spec (std : Std lim) (hsp : dst + len ≤ lim.space)
-    (done : Q ⟨frame [n, b, len, dst, 0, 0, 0, len], wrote μ dst (fun _ => 0) len⟩)
