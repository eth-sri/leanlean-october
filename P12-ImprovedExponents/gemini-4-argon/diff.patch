-/-- ae(n, U, ab, bc, ac, out, fr): the core, then the `n²` flags are copied to `out`. -/
-def aeTopBody (pCore pCopy : ℕ) : Stmt :=
-  .call pCore [v 0, v 1, v 2, v 3, v 4, v 6] 7 ;;
-  .call pCopy [v 7, v 5, v 0 *' v 0] 7
