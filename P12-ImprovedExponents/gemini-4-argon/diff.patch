+    Function.update (wrote μ dst f j) y w = wrote (Function.update μ y w) dst f j := by
+  funext a
+  by_cases ha : a = y
+  · subst ha
+    rw [Function.update_self, wrote_rest hy, Function.update_self]
+  · simp only [wrote, Function.update_of_ne ha]
