+      (by omega) (by omega) hlim.ip _ (by omega)) ?_
+      (hT := by simp [tQuery31, ite_eq_left hsmall]; omega)
+    rintro r μ' ⟨hr, rfl⟩
+    exact ⟨hr, hR, .refl⟩
