-    obtain ⟨q, hqend, hqlen, hqweight⟩ := ih k j
-    refine ⟨p ++ q, ?_, ?_, ?_⟩
-    · rw [walkEnd_append, hpend, hqend]
-    · rw [List.length_append, pow_succ]
-      omega
-    · rw [walkWeight_append, hpend, hpweight, hqweight]
-      exact hk.symm
-
