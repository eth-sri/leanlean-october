-/-- The dimension `Dc = ⌈⌊√D⌋/g⌉ ⌊√D⌋` of the middle part is `Θ(D^{1-η})`. -/
-theorem eventually_pieceSize_bounds {d η : ℝ} {D g : ℕ → ℕ}
