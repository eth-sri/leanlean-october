-    hpre.trans (mul_le_mul_of_nonneg_left (le_preBound31 hD le_rfl) hC),
-    hquery.trans (mul_le_mul_of_nonneg_left (le_queryBound31 hD le_rfl) hC)⟩
-
-end ImprovedExponents
