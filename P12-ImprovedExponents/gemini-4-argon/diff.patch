+
+variable {dst j : ℕ} {f : ℕ → ℤ}
+
+/-- The memory `μ` after `f 0`, …, `f (j - 1)` have been written to the cells from `dst`. -/
+def wrote (μ : ℕ → ℤ) (dst : ℕ) (f : ℕ → ℤ) (j : ℕ) : ℕ → ℤ :=
+  fun a => if dst ≤ a ∧ a < dst + j then f (a - dst) else μ a
