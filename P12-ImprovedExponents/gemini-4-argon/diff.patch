-theorem Counted.of_sameOutside {μ μ' : ℕ → ℤ} {fr cnt cap a n : ℕ} {K : List ℕ}
-    (h : Counted μ fr cnt cap K) (hs : SameOutside μ μ' a n) (hfr : a + n ≤ fr)
-    (hap : Apart a n cnt cap) :
