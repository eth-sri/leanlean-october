-theorem const_mul (c : ℕ) (hf : Within8P f) : Within8P fun p t => c * f p t := by
-  obtain ⟨A, hA, hf⟩ := hf
-  refine ⟨c * A, by positivity, fun p t hp => ?_⟩
-  rw [Nat.cast_mul, mul_assoc]
-  exact mul_le_mul_of_nonneg_left (hf p t hp) (Nat.cast_nonneg c)
