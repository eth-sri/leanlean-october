-    refine hTn n (3 * (n * U)) _ hn (by have := Nat.mul_pos hn hU; omega) ?_
-    push_cast
-    have : (n : ℝ) * U ≤ n * u := mul_le_mul_of_nonneg_left hu (by positivity)
-    linarith
