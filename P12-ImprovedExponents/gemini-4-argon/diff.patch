-  ∃ (r : ℤ) (μ' : ℕ → ℤ), σ = ⟨frame [s, h, src, r0, c0, dst, i, r], μ'⟩ ∧
-    (∀ q < i * h, μ' (dst + q) = B.getD q 0) ∧ SameOutside μ μ' dst (h * h)
