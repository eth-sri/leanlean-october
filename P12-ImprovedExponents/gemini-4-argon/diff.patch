-theorem claim17MidAE_of_host (MM : ℕ → ℝ) (D g : ℕ → ℕ) (time : (List ℕ → ℕ) → ℕ → ℕ → ℕ)
-    (need : (List ℕ → Need) → ℕ → ℕ → Need)
