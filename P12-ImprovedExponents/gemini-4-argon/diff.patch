-    k * r.den < r.num.toNat := by
-  have hden : (0 : ℝ) < r.den := by exact_mod_cast r.den_pos
-  rw [rat_eq_div hr, lt_div_iff₀ hden] at h
-  exact_mod_cast h
-
-/-- `r < k/l` for natural `k`, `l` gives `l · num < k · den`. -/
