-
-/-- A term of the convolution. -/
-def convTerm (p : ℕ) (A B : List ℤ) (r i : ℕ) : ℤ :=
-  A.getD i 0 * B.getD (if i ≤ r then r - i else r + p - i) 0
-
-/-- The sum of the first j terms of entry r of the convolution. -/
