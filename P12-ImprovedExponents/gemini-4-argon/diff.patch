+  light_set (x.cur + clsKey x.RAB i : ℕ) using hread
+  light_set (sortPos (clsKey x.RAB) (x.n * x.n) i : ℕ) using hcell
+  -- qi[pl] := row; qj[pl] := col; mem[ad] := pl + 1
