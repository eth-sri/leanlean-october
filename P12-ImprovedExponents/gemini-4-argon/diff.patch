-/-- **vlin** as a procedure. -/
-theorem vlin_meets {μ : ℕ → ℤ} {pVlin dst a b n : ℕ} {s V : ℤ} {A B : List ℤ}
-    (hP : P[pVlin]? = some vlinBody) (hw : (lim.space : ℤ) ≤ lim.word)
