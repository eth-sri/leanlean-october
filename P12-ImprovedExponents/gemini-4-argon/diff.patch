-  change 7 ^ p.L + (p.KK * p.N0 * p.D + 1) * (p.L + 1) ≤ _
-  generalize p.KK * p.N0 * p.D = E at *
-  generalize 7 ^ p.L = S7 at *
-  generalize p.L = L at *
