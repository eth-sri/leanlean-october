-/-- `N ≥ 1` under the hypotheses of Theorem 30, because `N ≥ √K N₀ ≥ 1`. -/
-theorem hyp30_N_pos {p : Sec2.Par} {t : ℕ} (h : Hyp30 p t) : 1 ≤ p.N := by
-  have := (one_le_sqrtKN0 h.m_le).trans h.N_ge
-  exact_mod_cast this
