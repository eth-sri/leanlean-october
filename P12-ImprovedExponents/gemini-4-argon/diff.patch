+    rw [show polyBound κ 20 [N, D, w, U] =
+      2 ^ κ * ((N + 1) * ((D + 1) * ((w + 1) * (U + 1)))) ^ 20 by simp [polyBound]]
+    have hN : N + 1 ≤ (N + 1) * ((D + 1) * ((w + 1) * (U + 1))) :=
+      Nat.le_mul_of_pos_right _ (by positivity)
+    have hD : D ≤ (N + 1) * ((D + 1) * ((w + 1) * (U + 1))) :=
