-def aOut (X : HostData) (U fr : ℕ) : ℕ := aY X U fr + X.n * X.D
-/-- The free pointer that is handed to the solver. -/
-def aFr (X : HostData) (U fr : ℕ) : ℕ := aOut X U fr + X.cap
