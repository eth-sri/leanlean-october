-        Seg σ'.mem flg (aeFlags x.n x.AB x.BC x.AC) ∧ Kept μ σ'.mem fr := by
-  have hok' : (hostNeed' Dfun Gfun wD wG need x.n x.U).Ok lim fr d := hostNeedAt'_ok hok
