-  have read : ∀ {b a i : ℕ}, Seg μP10 a (powList b (p.L + 1)) → i ≤ p.L →
-      μP10 (a + i) = (b ^ i : ℕ) :=
-    fun h hi => by rw [h.get (by rw [length_powList]; omega), getElem_powList]
