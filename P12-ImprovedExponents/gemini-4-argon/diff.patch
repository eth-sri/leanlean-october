+theorem card_bucket {M : ℕ} (hM : 1 ≤ M) {L : List ℤ} (hL : L.Nodup) (r : ℕ) :
+    #(bucket L.toFinset M r) = (keys M L).count r := by
+  have hfilter : bucket L.toFinset M (r : ℤ) =
