-/-- **The product from all pairs**: O(log u) calls, if a call takes at least n² steps. -/
-theorem mpTime_dominated :
-    Dominated Run.Quadratic (fun p => (mpTime p.Tn p.n p.U : ℝ))
-      fun p => p.T p.n (6 * p.u) * logU p.u := by
