-  .set AdrSc (v AdrPerm +' v Wanted +' v Wanted +' v Tiles +' k 11 +' v Tiles +' k 1) ;;
-  .call pGather [v Wanted, v AdrPerm, v AdrTid +' v Wanted, v AdrSc] Void ;;
