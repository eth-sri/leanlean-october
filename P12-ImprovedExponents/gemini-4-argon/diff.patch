-        Seg σ'.mem flg (aeFlags x.n x.AB x.BC x.AC) ∧ Kept μ σ'.mem fr := by
-  have hok' := hostNeedAt'_ok hok
-  have hbrute : (bruteNeed x.n x.U).Ok lim fr (d + 1) :=
-    hok'.mono (by simp only [bruteNeed, hostNeedAt', hostWord]; omega)
