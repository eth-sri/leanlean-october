-        ≤ 2 * ((Nat.sqrt Dn : ℝ) / gn) * Nat.sqrt Dn :=
-          mul_le_mul_of_nonneg_right (by linarith) hS0
-      _ = 2 * ((Nat.sqrt Dn : ℝ) * Nat.sqrt Dn / gn) := by ring
