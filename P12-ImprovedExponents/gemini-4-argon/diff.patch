-    (r j : ℕ) :
-    |convPartialSum p A B r j| ≤ j * (α * β) := by
-  simpa [convPartialSum] using List.abs_sum_map_le (List.range j) (convTerm p A B r)
-    fun i _ => abs_convTerm_le leA leB hα hβ r i
-
-end bounds
