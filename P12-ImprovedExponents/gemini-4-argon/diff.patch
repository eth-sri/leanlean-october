+  have : (n : ℤ) * n ≤ lim.word := by exact_mod_cast (show ((n * n : ℕ) : ℤ) ≤ _ by omega)
+  have : 0 ≤ (n : ℤ) * n := by positivity
+  unfold apInitBody
+  -- Cells := Verts * Verts
+  light_set (n * n : ℕ)
