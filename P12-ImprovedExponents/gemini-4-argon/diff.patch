-noncomputable def hostTimeAE (Dfun Gfun tD tG : ℕ → ℕ) (Tn : List ℕ → ℕ) (n U : ℕ) : ℕ :=
-  hostCoreTime Dfun Gfun tD tG Tn n U + copyTime (n * n) + 20
