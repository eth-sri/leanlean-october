-theorem theorem_21b_entries_bounded {R : Type} [AddCommGroup R] [LinearOrder R]
-    [IsOrderedAddMonoid R] {n : ℕ} (w : Fin n → Fin n → WithTop R) (hw : NoNegativeCycle w) (U : R)
