-/-- The input array of a band: `bandArrayShape ≤ 5 L 7^L`, because `K₀² N₀ D ≤ K N₀ D ≤ 7^L`. -/
-theorem bandArrayShape_le {p : Sec2.Par} {t : ℕ} (h : Hyp30 p t) :
-    Sec2.bandArrayShape p ≤ 5 * (p.L * 7 ^ p.L) := by
-  have hL1 := h.L_pos
