-/-- `cost8P` is at least 1 (for `L ≥ 1`; at `L = 0` it vanishes). -/
-theorem one_le_cost8P (L m t N : ℕ) (hL1 : 1 ≤ L) (hL : 10 * m ≤ L)
-    (hN : sqrtKN0 L m ≤ (N : ℝ)) : 1 ≤ cost8P L m t N := by
