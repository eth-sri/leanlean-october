-/-- A level outside the subset: wd[level] := 3 dI[outer] + dJ[outer]; outer := outer + 1;
-level := level + 1. -/
-def levelOuter : Stmt :=
-  .store (v Dest +' v Level) (k 3 *' M (v DigitsI +' v Outer) +' M (v DigitsJ +' v Outer)) ;;
-  .set Outer (v Outer +' k 1) ;;
-  .set Level (v Level +' k 1)
