-open ScanPairsAE in
-/-- scanPairsAE(out, qa, qb, w, flg, ab, bc, ac, n, c0, len); the parameter is the procedure number
-of `scan`. -/
-def scanPairsAEBody (pScan : ℕ) : Stmt :=
-  .set Cnt (k 0) ;;
-  .while (v Cnt <' v Num) (scanPairsAEStep pScan ;; .set Cnt (v Cnt +' k 1))
