-    base := x.base + t * 10 ^ n
-    l := x.sp + 11 + x.codes.length
-    out := x.sp + 11 + 2 * x.codes.length
-    sp := x.sp + 11 + 3 * x.codes.length
-    codes := childList n t x.codes }
