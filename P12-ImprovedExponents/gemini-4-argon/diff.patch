-  have h100 := hstd.const_le
-  have hrow : (I : ℕ) * D₀ + D₀ ≤ N * D₀ := Nat.mul_add_le_mul I.isLt le_rfl
-  have hcol : (J : ℕ) < N := J.isLt
-  have hN : N ≤ D₀ * N := Nat.le_mul_of_pos_left _ hD
-  -- every partial sum and every product fits in a word
