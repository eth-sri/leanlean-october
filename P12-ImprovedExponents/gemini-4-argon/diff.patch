-/-- The number of bands, from the band of the last row. -/
-theorem nB_eq (p : Par) (hmL : p.m ≤ p.L) :
-    (p.N = 0 → p.nB = 0) ∧ (0 < p.N → p.nB = (p.N - 1) / (p.K0 * p.N0) + 1) := by
