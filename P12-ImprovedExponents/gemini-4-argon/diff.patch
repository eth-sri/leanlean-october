+theorem allInstancesNeedP_poly (G : RatParams) (r : ℕ) : PolyNeedN (allInstancesNeedP G r) := by
+  set κ : ℕ := 1405 + r + 4 * G.a + 4 * G.p + G.b + G.q + G.m₀ + 14 with hκdef
+  refine ⟨κ, 20, fun ps => ?_⟩
+  match ps with
