-/-- A good time is at least `1 + log u`. -/
-theorem GoodTime.one_add_logU_le {T : ℕ → ℝ → ℝ} (hT : GoodTime T) {s : ℕ} (hs : 1 ≤ s) (u : ℝ) :
-    1 + logU u ≤ T s u :=
