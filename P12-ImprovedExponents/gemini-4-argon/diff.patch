-    refine ⟨seg_wrote (by simp [orL, lF, lL]) fun i hi => ?_, sameOutside_wrote le_rfl⟩
-    simp only [orL, List.length_zipWith] at hi ⊢
-    rw [List.getElem_zipWith]
-    exact (hfi i (by omega) (by omega)).symm
