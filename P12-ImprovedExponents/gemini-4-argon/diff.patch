+  have : d + (G.a * (4 * x.D) + 12) ≤ lim.depth := ok.depth
+  have hm4 := logFour_le_four_mul hpre.D_pos
+  have : G.L (logFour x.D) ≤ G.a * (4 * x.D) :=
