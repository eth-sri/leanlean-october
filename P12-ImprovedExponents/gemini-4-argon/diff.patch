-        by_cases h9 : lam = 9
-        · have : τ 0 = .P0 := (termIdx_eq_nine_iff _).1 (heq.trans h9)
-          simp only [this, ite_true, h9] at hcard hj'
-          omega
-        · have : τ 0 ≠ .P0 := fun h => h9 (heq.symm.trans ((termIdx_eq_nine_iff _).2 h))
