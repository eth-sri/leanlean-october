-/-- The row `j` written on top of the rows below it. -/
-private theorem tMem_succ {μ : ℕ → ℤ} {dst n : ℕ} {c : ℤ} {Y : List ℤ} {j : ℕ} (hj : j < n) :
-    wrote (tMem μ dst n c Y j) (dst + j * n) (fun i => Y.getD (i * n + j) 0 + c) n =
