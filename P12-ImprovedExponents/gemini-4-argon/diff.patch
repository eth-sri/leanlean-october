-  have haddr7 : ((p7 : ℤ) + ((L : ℤ) + 1) - 1).toNat = p7 + L := by omega
-  have haddr10 : ((p10 : ℤ) + ((L : ℤ) + 1) - 1).toNat = p10 + L := by omega
-  have hread7 := pre.p7V L (by omega)
-  have hread10 := pre.p10V L (by omega)
