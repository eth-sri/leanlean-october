-    (Real.rpow_le_rpow_of_exponent_le (by norm_num) hη1).trans_eq (Real.rpow_one _)
-  have h3 : (n : ℝ) ^ (d * η) / 2 ≤ (n : ℝ) ^ (d * η) / (2 : ℝ) ^ η :=
