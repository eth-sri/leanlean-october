-theorem theorem_21b_repeated_squaring {R : Type} [AddCommGroup R] [LinearOrder R]
-    [IsOrderedAddMonoid R] {n : ℕ} (w : Fin n → Fin n → WithTop R) (hw : NoNegativeCycle w) :
