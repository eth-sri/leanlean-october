+  cap : ℕ
+  /-- The weights of the edges `(a, b)`, row by row. -/
+  AB : List ℤ
+  /-- The weights of the edges `(b, c)`, row by row. -/
+  BC : List ℤ
+  /-- The weights of the edges `(a, c)`, row by row. -/
+  AC : List ℤ
