-/-- The number of rounds of the search is O(log u). -/
-theorem mpRounds_le {U : ℕ} (hU : 1 ≤ U) {u : ℝ} (hu : (U : ℝ) ≤ u) :
-    (mpRounds U : ℝ) ≤ 8 * logU u := by
