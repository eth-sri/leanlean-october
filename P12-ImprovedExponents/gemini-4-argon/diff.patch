-  have h3 : (KK + 1) * (L + 1) ≤ 4 * (N * L * n) :=
-    calc (KK + 1) * (L + 1) ≤ (2 * n) * (2 * L) := Nat.mul_le_mul (by omega) (by omega)
-      _ = 4 * (1 * L * n) := by ring
-      _ ≤ 4 * (N * L * n) := by gcongr
