-/-- A smaller function. -/
--- adapted from ImprovedExponents/Cost8X/Within.lean (Within8X.of_le)
-theorem of_le (hg : Within8P g) (h : ∀ p t, Hyp30 p t → f p t ≤ g p t) : Within8P f :=
