-
-/-- The product of a phase on quarters of the operands has the length of a quarter. -/
-theorem length_phaseM_quarter {p j : ℕ} {A B : List ℤ} (hA : A.length = 4 * (4 ^ j * p))
-    (hB : B.length = 4 * (4 ^ j * p)) (sA sB : ℤ) {t1 t2 t3 t4 : ℕ}
