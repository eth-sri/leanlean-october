-  /-- `D ≤ n^{1/18}`. -/
-  le_root : (D : ℝ) ≤ (n : ℝ) ^ (1 / 18 : ℝ)
-  /-- `D ≥ n^{1/18}/c`. -/
-  root_div_le : (n : ℝ) ^ (1 / 18 : ℝ) / c ≤ (D : ℝ)
-  /-- The constant `c` is positive. -/
-  c_pos : 0 < c
-  /-- `η ≥ 0`. -/
-  η_nonneg : 0 ≤ η
