-  simp [memOf, ThinInstance.input]
-
-@[inherit_doc memOf_input_N]
-theorem memOf_input_w (x : ThinInstance) : memOf (x.input []) 2 = x.W.length := by
-  simp [memOf, ThinInstance.input]
-
-/-! ## The limits are polynomial in N and D -/
-
