-theorem triOf_level (lAB : AB.length = n * n) (lBC : BC.length = n * n) (lAC : AC.length = n * n)
-    (hAB : AbsLe AB U) (hBC : AbsLe BC U) (hAC : AbsLe AC U) (ℓ : ℕ) (e : ℤ) :
