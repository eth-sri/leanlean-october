-theorem hasNegativeTriangle_iff_exists_level {L : ℕ} (lAB : AB.length = n * n)
-    (lBC : BC.length = n * n) (lAC : AC.length = n * n) (hAB : AbsLe AB U) (hBC : AbsLe BC U)
