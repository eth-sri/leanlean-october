-/-- The list of marks is the list of flags of the task, when it holds the right flag for every
-pair. -/
-theorem eq_pairFlags {n : ℕ} {X Y V O : List ℤ} (lO : O.length = n * n)
-    (h : ∀ i < n, ∀ j < n, entry n O i j = flag (PairHit n X Y V i j)) :
