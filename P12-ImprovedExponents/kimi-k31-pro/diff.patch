-    prefQ ℓ (2 * x) = ((2 * x.toNat / 2 ^ ℓ : ℕ) : ℤ) := by
-  rw [← prefQ_natCast, Nat.cast_mul, Int.toNat_of_nonneg hx, Nat.cast_ofNat]
