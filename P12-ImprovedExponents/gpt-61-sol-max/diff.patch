-  obtain ⟨hr, hc, hsrc⟩ := hplace
-  obtain ⟨hw, hdst, hd⟩ := hlim
-  have hh : h ≤ h * h := Nat.le_mul_self h
-  unfold subCopyTime
-  -- for i < h
-  refine .of_body hSub (Ends.for (Inv μ s h src r0 c0 dst (subMat s h r0 c0 L)) h (16 * h + 23)
