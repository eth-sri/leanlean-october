-theorem try_spec (C : Ctx P₀ R p pProbe pSub pCopy T r) {x : FindInst} {μ : ℕ → ℤ}
-    {fr a0 b0 c0 h h' : ℕ} (hpre : x.Pre μ fr) (hok : (findNeed r x.n x.U).Ok lim fr d)
-    (hh : 1 ≤ h' ∧ h' ≤ h) (hin : a0 + h ≤ x.n ∧ b0 + h ≤ x.n ∧ c0 + h ≤ x.n) {t : ℕ × ℕ × ℕ}
