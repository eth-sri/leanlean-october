+private structure Code (B H I x : ℤ) (d : WithTop ℤ) : Prop where
+  lo : -B ≤ x
+  hi : x ≤ H
+  gap : d = ⊤ → I - B ≤ x
+  eqn : ∀ z : ℤ, d = (z : WithTop ℤ) → x = z ∧ z ≤ B
