-      fun σ' => mpTask.Post x μ fr (σ'.loc 0) σ'.mem := by
-  have hlim := lim_of_ok hok
-  have hw := hlim.space
-  have hcells := hlim.cells
-  light_facts hlim hpre
-  have harea : 1 ≤ x.n * x.n := Nat.mul_pos hpre.n_pos hpre.n_pos
