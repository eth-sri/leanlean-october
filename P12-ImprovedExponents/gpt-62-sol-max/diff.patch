+      have hf := hscan.1 ⟨i, le_rfl, j - 1, by omega, h⟩
+      unfold accept
+      light_steps
+      exact ⟨_, by omega, L.length, j, true, le_rfl, hj, rfl, rfl, by simp, by simp [hf]⟩
+    unfold step
