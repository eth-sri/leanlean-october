-/-- markStmt marks the pair (oI + a, oJ + c), where a and c stand in the solver's answer. -/
-theorem mark_spec {P : Program} {μ : ℕ → ℤ} {fr oI oK oJ a c : ℕ} {z : ℤ}
-    (ha : μ (fr + 3 * (s * s)) = a) (hc : μ (fr + 3 * (s * s) + 2) = c)
