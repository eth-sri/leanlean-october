-/-- For `c > 10` there is `θ* ∈ (0, 9/10)` with `γX(c, θ*) = Γ(c) = γ_Q(θ*)`. -/
-theorem exists_crossing_eq_Gam (hc : 10 < c) :
-    ∃ θ ∈ Ioo (0 : ℝ) (9 / 10), gammaX c θ = Gam c ∧ gammaQ θ = Gam c := by
-  obtain ⟨θ, hθ, h⟩ := exists_crossing hc
