-theorem two_pow_aeLevels_le {U : ℕ} (hU : 1 ≤ U) : 2 ^ aeLevels U ≤ 6 * U := by
-  have := Nat.pow_log_le_self 2 (show 3 * U ≠ 0 by omega)
-  rw [aeLevels, pow_succ]
-  omega
-
