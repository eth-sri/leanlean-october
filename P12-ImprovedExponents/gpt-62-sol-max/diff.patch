+/-- Both positive and negative powers preserve two-sided asymptotic bounds. -/
+theorem theta_rpow {f : ℕ → ℝ} {a : ℝ} (hf : ∀ n, 0 ≤ f n)
+    (h : f =Θ[atTop] fun n : ℕ => (n : ℝ) ^ a) (r : ℝ) :
