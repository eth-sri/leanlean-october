+def addresses (next : ℕ) : Stmt :=
+  .set SizeSq (v Size *' v Size) ;;
+  .set ResAB (v Free +' (v Bits +' k 1)) ;;
+  .set ResBC (v ResAB +' v SizeSq) ;;
+  .set ResAC (v ResBC +' v SizeSq) ;;
+  .set next (v ResAC +' v SizeSq)
