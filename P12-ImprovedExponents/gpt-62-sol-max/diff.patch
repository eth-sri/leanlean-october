+  rw [hm]
+  cases hk : b k with
+  | top => exact hzB.trans (hgap.trans ((hab k).gap hk))
+  | coe w => rw [(hab k).eqn w hk |>.1]; exact WithTop.coe_le_coe.1 (hz ▸ hk ▸ hinf k)
