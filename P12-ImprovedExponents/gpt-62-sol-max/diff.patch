-/-- One round of the loop over the ten terms. -/
-def prunedRound : Stmt :=
-  prunedSlice ;;
-  .call pUnion [v COD +' v POS, v NPOS, v COD +' v Z0, v NZ0, v CH] NCH ;;
-  .ite (k 0 <' v NCH) prunedChild .skip ;;
-  .set LAM (v LAM +' k 1)
