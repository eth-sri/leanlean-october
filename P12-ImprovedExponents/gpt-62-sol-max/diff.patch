+/-- Insert the two counters of a rectangular traversal into a frame. -/
+abbrev rectLoc (loc : ℕ → ℤ) (r c : ℕ) (i j : ℤ) : ℕ → ℤ :=
+  Function.update (Function.update loc r i) c j
