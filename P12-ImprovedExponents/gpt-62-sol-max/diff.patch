-  · rw [flag_of_not fun hh => hp (h.2 hh)]
-    have : (pairFlags n X Y V)[q] = 0 ∨ (pairFlags n X Y V)[q] = 1 := by
-      simp only [pairFlags, List.getElem_map, List.getElem_range]
-      unfold flag
-      split_ifs <;> simp
-    omega
-
-end ImprovedExponents.AllEdges
