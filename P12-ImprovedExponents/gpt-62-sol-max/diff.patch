-  .call pSegBounds [v PL, v LEN, v PW, v SP] RES ;;
-  .set COD (v SP +' k 11) ;;
-  .set CH (v COD +' v LEN) ;;
-  .set VAL (v CH +' v LEN) ;;
-  .set NXT (v VAL +' v LEN) ;;
-  .set Z0 (M (v SP +' k 9)) ;;
-  .set NZ0 (v LEN -' v Z0) ;;
-  .call pFill [v OUT +' v Z0, v NZ0, k 0] RES ;;
-  .set LAM (k 0)
-
-/-- pruned(n, ea, eb, l, len, out, sp, p10). -/
-def prunedBody : Stmt :=
-  .ite (v NN =' k 0)
-    (.set PW (M (v PA) *' M (v PB)) ;;
-     .call pFill [v OUT, v LEN, v PW] RES)
-    (prunedSetup ;;
-     .while (v LAM <' k 10) prunedRound)
