-/-- A unit vector in `span {e i, e j}` orthogonal to a top eigenvector. -/
-lemma exists_l2_mem_span_single_pair_orthogonal (hA : A.IsHermitian)
-    [Nontrivial n] {i j : n} (hij : i ≠ j) :
-    ∃ x : n → ℝ,
