-/-- Rayleigh values of unit vectors in `span {e i, e j}`. -/
-def rayleighOnSpanPair (A : Matrix n n ℝ) (i j : n) : Set ℝ :=
-  { t | ∃ x : n → ℝ,
-      x ∈ Submodule.span ℝ ({Pi.single i (1 : ℝ), Pi.single j 1} : Set (n → ℝ)) ∧
-        ∑ k, x k ^ 2 = 1 ∧ t = x ⬝ᵥ A *ᵥ x }
