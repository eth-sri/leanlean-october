-    exact hmem
-  have hgu : g (integerUnitsToFieldUnits K u) = 1 := by
-    have hmem : integerUnitsToFieldUnits K u ∈ g.toMonoidHom.ker := by
-      rw [hgker]
-      exact hNorm u
-    exact hmem
