-  let S : Set (IsDedekindDomain.HeightOneSpectrum ℤ) :=
-    {v | ∃ w : IsDedekindDomain.HeightOneSpectrum (𝓞 L),
-      w.asIdeal.LiesOver v.asIdeal ∧
-        ¬ Algebra.IsUnramifiedAt ℤ w.asIdeal}
