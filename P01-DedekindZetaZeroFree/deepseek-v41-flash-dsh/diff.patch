-          right_inv := fun _ ↦ rfl }
-    _ = Nat.card (ZMod f) :=
-      Nat.card_congr
-        { toFun := Multiplicative.toAdd
-          invFun := Multiplicative.ofAdd
-          left_inv := fun _ ↦ rfl
-          right_inv := fun _ ↦ rfl }
-    _ = f := Nat.card_zmod f
