-/-- The integral Lubin--Tate polynomial attached to `uT`. -/
-noncomputable def equalCharacteristicChangedIntegralPiPolynomial
-    (F : LocalField.{u, v} K) (a : F.residueField⟦X⟧ˣ) :
-    Polynomial F.residueField⟦X⟧ :=
