-    let : TopologicalSpace (Multiplicative (ZMod n)) := ⊥
-    let : DiscreteTopology (Multiplicative (ZMod n)) := ⟨rfl⟩
-    let valuationMod : Kˣ →ₜ* Multiplicative (ZMod n) :=
-      valuationModContinuousMonoidHom K n
