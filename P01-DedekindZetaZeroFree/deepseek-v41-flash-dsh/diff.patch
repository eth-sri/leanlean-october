-  obtain ⟨target, hExt, hTarget, _hUnram, _hdegree⟩ :=
-    AlgebraicNumberTheory.Valuations.exists_padicCyclotomic_completeDVF_isFiniteUnramified_degree_eq
-      p f hf hζ hζgen
