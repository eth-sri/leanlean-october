-  induction i using Nat.strong_induction_on with
-  | h i ih =>
-      let d := a - b
-      have hdx :
-          equalCharacteristicLubinTateAmbientBracket F ι t (n + 1) d x = 0 := by
-        change equalCharacteristicLubinTateAmbientBracket F ι t (n + 1)
