-    Nat.sub_pos_of_lt (Nat.one_lt_pow hj.ne' hq)
-  simp [equalCharacteristicThetaGamma, hpow.ne']
-
-/-- Multiplying theta gamma by `X` gives the corresponding source-uniformizer power. -/
