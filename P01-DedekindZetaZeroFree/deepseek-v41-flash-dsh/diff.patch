-  change ∀ x : A,
-    σ • x - x ∈ (IsLocalRing.maximalIdeal A) ^ (Int.ceil (s + 1)).toNat
-  intro x
-  rw [hzero, pow_zero, Ideal.one_eq_top]
-  exact Submodule.mem_top
-
-end ClassFieldTheory
-
-end
