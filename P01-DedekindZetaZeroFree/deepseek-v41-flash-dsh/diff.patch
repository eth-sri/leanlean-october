-  refine ⟨θ, top_le_iff.mp ?_⟩
-  rw [← hα, IntermediateField.adjoin_simple_le_iff]
-  have hθ : (θ : K) ∈ IntermediateField.adjoin ℚ ({(θ : K)} : Set K) :=
-    IntermediateField.mem_adjoin_simple_self ℚ (θ : K)
