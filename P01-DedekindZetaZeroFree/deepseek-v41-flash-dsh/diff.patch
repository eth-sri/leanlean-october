-    (n : ℕ+) (hmu : (primitiveRoots (n : ℕ) K).Nonempty)
-    (u v : Lˣ) (huv : u ^ (n : ℕ) = v ^ (n : ℕ))
-    (σ : L ≃ₐ[K] L) :
-    σ • u / u = σ • v / v := by
-  have hpow : (u / v) ^ (n : ℕ) = 1 := by
-    rw [div_pow, huv]
-    exact div_self' (v ^ (n : ℕ))
-  obtain ⟨ζ, hζ⟩ : ∃ ζ : Kˣ,
-      u / v = Units.map (algebraMap K L).toMonoidHom ζ := by
-    let : NeZero (n : ℕ) := ⟨n.ne_zero⟩
