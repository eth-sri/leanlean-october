-  ⟨
-    { toOpenSubgroup :=
-        { toSubgroup := f.toMonoidHom.ker
-          isOpen' := by
-            change IsOpen (f ⁻¹' {1})
-            exact (isOpen_discrete {1}).preimage f.continuous_toFun }
-      isNormal' := by
-        infer_instance },
-    Subgroup.finiteIndex_ker f.toMonoidHom⟩
