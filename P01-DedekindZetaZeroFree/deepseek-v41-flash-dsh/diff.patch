-        rw [← hValuationRing]
-        exact x.property⟩
-      invFun := fun x => ⟨x.val, by
-        rw [hValuationRing]
-        exact x.property⟩
-      left_inv := fun x => by
-        apply Subtype.ext
-        rfl
-      right_inv := fun x => by
-        apply Subtype.ext
-        rfl
-      map_mul' := fun x y => by
-        apply Subtype.ext
-        rfl
-      map_add' := fun x y => by
-        apply Subtype.ext
-        rfl
