-    have h := globalInfinitePlaceHilbertSymbol_congr
-      e.toRingEquiv n hmuF W a₀ b₀
-    change er (fInf (eInf.symm W)) =
-      globalInfinitePlaceHilbertSymbol G n W
-        (eu a₀) (eu b₀) at h
-    rw [eu.apply_symm_apply, eu.apply_symm_apply] at h
