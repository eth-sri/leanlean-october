-    change IsIntegral V z⁻¹
-    apply (isIntegral_algHom_iff (ι.restrictScalars V) ι.injective).1
-    apply isIntegral_of_mem_extension V B (ι z⁻¹)
-    rw [map_inv₀]
-    exact hzinv
