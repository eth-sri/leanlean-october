-def topologicalProfiniteCompletionPreimageIndex
-    (P : ProfiniteGrp.{v}) (f : G →ₜ* P) (N : OpenNormalSubgroup P) :
-    OpenFiniteIndexNormalSubgroup G :=
-  ⟨
-    { toOpenSubgroup := N.toOpenSubgroup.comap f.toMonoidHom f.continuous_toFun
