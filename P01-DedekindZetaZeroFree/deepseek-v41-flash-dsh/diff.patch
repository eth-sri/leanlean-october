-  obtain ⟨f⟩ :=
-    GlobalClassFieldTheory.GlobalClassFields.finiteAbelianExtension_nonempty_algHom_of_normRange_le
-      (K := K) RJ.extension RH.extension hnorm
-  let : Algebra RJ.extension RH.extension := f.toRingHom.toAlgebra
