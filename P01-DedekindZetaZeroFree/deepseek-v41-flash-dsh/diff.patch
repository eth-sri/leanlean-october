-            hW, ha, hb, haG, hbG]
-          apply Subtype.ext
-          apply Units.ext
-          change e (-1 : F) = (-1 : G)
-          simp
-        · have hbG := fun h => hb (hbiff.mpr h)
-          change ¬InfinitePlace.embedding_of_isReal hW (e (b : F)) < 0 at hbG
-          simp [globalInfinitePlaceHilbertSymbol, hn, hv,
-            hW, ha, hb, haG, hbG]
