-    G ⧸ (topologicalProfiniteCompletionPreimageIndex P f N).toOpenNormalSubgroup.toSubgroup →*
-      P ⧸ (N : Subgroup P) :=
-  QuotientGroup.lift _
-    ((QuotientGroup.mk' (N : Subgroup P)).comp f.toMonoidHom) <| by
-      intro g hg
-      exact (QuotientGroup.eq_one_iff (f g)).mpr hg
