-      Subgroup.map qL.toMonoidHom (upperB (k : ℝ)) =
-        upperK (k : ℝ) := by
-    exact
-      equalCharacteristicTransportedLubinTateLocalUpperRamificationGroup_map_eq
-        K p (hKp := hKp) ϖ hϖ n (k : ℝ)
