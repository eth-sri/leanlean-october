-      artinPrincipalUnitStepGroup K E t =
-        localUpperRamificationGroup K E t :=
-    filteredLocalReciprocity_descends
-      K E F hEF
-      (localUpperRamificationGroup K E)
-      (localUpperRamificationGroup K F)
-      hupper hcover t ht
