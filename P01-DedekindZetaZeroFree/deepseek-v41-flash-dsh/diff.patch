-  toMonoidHom :=
-    (Int.castAddHom (ZMod n)).toMultiplicative.comp (valuationUnitsMulHom K)
-  continuous_toFun := by
-    exact (continuous_of_discreteTopology : Continuous
-      (Int.castAddHom (ZMod n)).toMultiplicative).comp
-        (valuationUnitsMulHom_continuous K)
