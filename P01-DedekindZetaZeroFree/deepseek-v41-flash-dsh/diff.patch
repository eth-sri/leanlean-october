-    algebraMap base.valuationSubring target.valuationSubring
-  let iLocal : 𝒪[ℚ_[p]] →+* 𝒪[L] := algebraMap 𝒪[ℚ_[p]] 𝒪[L]
-  let : IsDiscreteValuationRing base.valuationSubring :=
-    base.valuationSubring_isDiscreteValuationRing
