-  rfl
-
-/-- States the theorem `mem_transportEquiv_lower_iff`. -/
-@[simp] theorem mem_transportEquiv_lower_iff
-    (F : AntitoneNormalSubgroupFiltration G) (e : G ≃* G')
-    (n : ℕ) (sigma : G') :
-    sigma ∈ (transportEquiv F e).lower n ↔ e.symm sigma ∈ F.lower n :=
-  Iff.rfl
