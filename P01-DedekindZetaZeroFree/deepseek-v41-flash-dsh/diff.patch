-    (L : Type) [Field L] [NumberField L] [IsAbelianGalois ℚ L] :
-    ∃ n : ℕ, 0 < n ∧
-      Nonempty (L →ₐ[ℚ] CyclotomicField n ℚ) :=
-  ⟨kroneckerWeberConductorCandidate (L := L),
-    kroneckerWeberConductorCandidate_pos (L := L),
-    ⟨kroneckerWeberCyclotomicEmbedding (L := L)⟩⟩
-
-end KroneckerWeber
-
-end
