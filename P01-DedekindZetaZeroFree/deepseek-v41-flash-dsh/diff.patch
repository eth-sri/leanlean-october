-        (equalCharacteristicLaurentUniformizer F) =
-      WithZero.exp (-1 : ℤ) := by
-  change (Valued.v : Valuation F.residueField⸨X⸩ ℤᵐ⁰)
-      (((PowerSeries.X : F.residueField⟦X⟧) :
-        F.residueField⸨X⸩)) = _
-  simpa using LaurentSeries.valuation_X_pow F.residueField 1
