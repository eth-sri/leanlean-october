-/-- Exact level-cardinality factorization
-`|F_n| = |F_n ∩ H| * |image(F_n)|`. -/
-theorem card_subgroupFiltration_mul_card_quotientImageFiltration
-    [Finite G] (F : AntitoneNormalSubgroupFiltration G)
-    (H : Subgroup G) [H.Normal] (n : ℕ) :
