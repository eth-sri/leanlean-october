-      (LubinTate.Valuations.exponentialValuationSubringAsValuationSubring vK).valuation)
-    {p r n : ℕ} [hp : Fact p.Prime]
-    [Fintype (IsLocalRing.ResidueField
-      (LubinTate.Valuations.exponentialValuationSubring vK))]
