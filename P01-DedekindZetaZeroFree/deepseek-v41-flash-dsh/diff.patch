-    (v : HeightOneSpectrum (𝓞 K)) :
-    ∃ ι : (v.adicCompletion K)ˣ →* RayClassGroup D.modulus,
-      (D.artin.comp ι).ker = finitePlaceTensorNormSubgroup K L v := by
