-      _ = artinPrincipalUnitGroup K L 1 := by
-        change artinPrincipalUnitGroup K L ⌈t⌉₊ = _
-        rw [hceil]
-  have hAtS :
-      localUpperRamificationGroup K L s =
-        localLowerRamificationGroup K L 1 := by
