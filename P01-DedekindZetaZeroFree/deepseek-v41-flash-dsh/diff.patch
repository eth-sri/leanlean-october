-          (ValuativeRel.valuation ℚ_[p]).integer := by
-      intro c hc
-      obtain ⟨n, _hn, rfl⟩ := Polynomial.mem_coeffs_iff.mp hc
-      exact (integer_mem_iff_norm_le_one p _).2 (hcoeffNorm n)
