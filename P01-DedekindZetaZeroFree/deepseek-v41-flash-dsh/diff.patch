-        ((chosenLocalExtensionCompleteDVF K L).valuation.valuationSubring.inertiaSubgroup K) =
-      ramificationIndex (localCompleteDVF K).toDVF
-        (chosenLocalExtensionCompleteDVF K L).toDVF := by
