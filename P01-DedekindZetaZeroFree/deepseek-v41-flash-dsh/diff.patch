-    [IsTopologicalGroup G] (K : FiniteResidueAbstractField D)
-    (f : ℕ) (hf : 0 < f) :
-    (DegreeData.AbstractExtension.mk (unramifiedExtensionOfDegree D K f hf) K.field
-      (unramifiedExtensionOfDegree_le D K f hf)).IsUnramified D := by
