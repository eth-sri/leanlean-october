-    simpa [B, H, pi, d] using
-      (equalCharacteristicLubinTateUniformizerPrincipalQuotient_natCard F n)
-  have hindexN : N.index = d := by
-    simpa [N, d] using
-      (equalCharacteristicLubinTateNormSubgroup_index F n)
-  have hdpos : 0 < d := by
-    dsimp [d]
-    exact Nat.mul_pos
-      (Nat.sub_pos_of_lt
