-    (K : Type u) [Field K] [ValuativeRel K] [TopologicalSpace K]
-    [IsNonarchimedeanLocalField K] (n : ℕ)
-    [TopologicalSpace (Multiplicative (ZMod n))]
-    [DiscreteTopology (Multiplicative (ZMod n))] :
