-theorem valuedInteger_hasBasis_ltIdeal
-    {K : Type u} {Γ : Type v} [Field K]
-    [LinearOrderedCommGroupWithZero Γ] [Valued K Γ] :
-    (𝓝 (0 : Valued.integer K)).HasBasis
