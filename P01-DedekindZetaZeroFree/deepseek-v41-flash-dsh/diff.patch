-    have heval :
-        F.val (σ (E₁F.val x)) =
-          F.val (τ (E₁F.val x)) := by
-      have h :=
-        congrArg
-          (fun a : E₁ ≃ₐ[K] E₁ => E₁.val (a y)) hres
