-    (hπ : (ValuativeRel.valuation K).IsUniformizer (π : K))
-    (f g : Kˣ →ₜ* (L ≃ₐ[K] L))
-    (hfker : f.toMonoidHom.ker = fieldNormSubgroup K L)
-    (hgker : g.toMonoidHom.ker = fieldNormSubgroup K L)
-    (hϖ : f ((Units.mk0 (π : K) hπ.ne_zero)⁻¹) =
-      g ((Units.mk0 (π : K) hπ.ne_zero)⁻¹)) :
