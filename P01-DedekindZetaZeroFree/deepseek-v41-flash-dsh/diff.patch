-    [ValuativeRel K] [TopologicalSpace K]
-    [IsNonarchimedeanLocalField K] :
-    (fieldNormSubgroup K L).index = Module.finrank K L := by
-  obtain ⟨e⟩ := finiteAbelianLocalReciprocity_quotient K L
-  rw [Subgroup.index_eq_card]
