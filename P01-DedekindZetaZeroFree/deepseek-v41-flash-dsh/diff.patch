-    [IsTopologicalGroup G] (K : FiniteResidueAbstractField D)
-    (f : ℕ) (hf : 0 < f) :
-    (((finiteUnramifiedExtension D K f hf).toFiniteAbstractExtension.degree : ℕ)) = f := by
-  let : NeZero f := ⟨hf.ne'⟩
-  let : Fintype (ZMod f) := ZMod.fintype f
