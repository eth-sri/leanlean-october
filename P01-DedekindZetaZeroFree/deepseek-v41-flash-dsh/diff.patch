-theorem laurentSeriesCoefficientMap_single_one
-    [Field k] [Field l] (f : k →+* l) :
-    laurentSeriesCoefficientMap f (HahnSeries.single (1 : ℤ) 1) =
-      (HahnSeries.single (1 : ℤ) 1 : l⸨X⸩) := by
-  ext m
-  by_cases h : m = 1
-  · subst m
-    simp
-  · simp [HahnSeries.coeff_single_of_ne h]
