-  let L := F.residueField⸨X⸩
-  let : ValuativeRel L := equalCharacteristicLaurentValuativeRel F
-  let : IsNonarchimedeanLocalField L :=
-    equalCharacteristicLaurentIsNonarchimedeanLocalField F
