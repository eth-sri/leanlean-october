-      equalCharacteristicLubinTatePiIterate F i
-        (equalCharacteristicLubinTatePiIterate F j x) := by
-  change
-    ((equalCharacteristicLubinTatePiEnd F) ^ (i + j)) x =
-      ((equalCharacteristicLubinTatePiEnd F) ^ i)
