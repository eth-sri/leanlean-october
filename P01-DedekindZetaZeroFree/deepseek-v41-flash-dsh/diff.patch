-    (u : k⟦X⟧ˣ) : ((AlgebraicClosure k)⟦X⟧)⟦X⟧ :=
-  PowerSeries.map (equalCharacteristicPowerSeriesFrobenius k)
-    (equalCharacteristicDirectThetaSeries u)
