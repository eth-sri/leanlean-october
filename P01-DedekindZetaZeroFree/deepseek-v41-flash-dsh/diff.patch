-theorem equalCharacteristicChangedIntegralUniformizer_ne_zero
-    (F : LocalField.{u, v} K) (a : F.residueField⟦X⟧ˣ) :
-    equalCharacteristicChangedIntegralUniformizer F a ≠ 0 := by
