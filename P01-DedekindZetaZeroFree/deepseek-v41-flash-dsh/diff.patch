-theorem finiteUnramifiedExtension_residueDegree (D : DegreeData G)
-    [IsTopologicalGroup G] (K : FiniteResidueAbstractField D)
-    (f : ℕ) (hf : 0 < f) :
-    (((finiteUnramifiedExtension D K f hf).toFiniteAbstractExtension.residueDegree D : ℕ)) = f := by
