-    {k Omega L : Type*} [Field k] [Field Omega] [Field L]
-    [Algebra k Omega] [Algebra k L]
-    (r : Omega)
-    (ι : (IntermediateField.adjoin k ({r} : Set Omega)) →ₐ[k] L)
