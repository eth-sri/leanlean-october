-    minpoly_coeff_mem_of_mem_extension V B α hαB
-  have hlifts : minpoly K α ∈ Polynomial.lifts (algebraMap V K) := by
-    apply (Polynomial.lifts_iff_coeff_lifts (minpoly K α)).2
-    intro i
-    exact ⟨⟨(minpoly K α).coeff i, hcoeff i⟩, rfl⟩
