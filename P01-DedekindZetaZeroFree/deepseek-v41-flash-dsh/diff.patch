-      k ∈ unramifiedDegreeKernelWithin D K f hf := by
-    change unramifiedDegreeHom D K f hf k = 1
-    change zHatReductionMul f hf (D.normalizedDegree K k) = 1
-    rw [hkDegree, map_one]
