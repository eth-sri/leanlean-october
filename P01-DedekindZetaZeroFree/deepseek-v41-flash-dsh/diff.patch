-/-- The source prime `bar_pi = u⁻¹ T`, before extension of coefficients to
-the completed maximal unramified ring. -/
-noncomputable def equalCharacteristicSourceUniformizer
-    (u : k⟦X⟧ˣ) : k⟦X⟧ :=
-  ((u⁻¹ : k⟦X⟧ˣ) : k⟦X⟧) * PowerSeries.X
