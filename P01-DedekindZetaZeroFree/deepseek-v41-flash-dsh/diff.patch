-  intro sigma hsigma
-  have hE₁ : AlgEquiv.restrictNormalHom (F := K) (K₁ := P) E₁ sigma = 1 :=
-    congrArg Prod.fst hsigma
-  have hE₂ : AlgEquiv.restrictNormalHom (F := K) (K₁ := P) E₂ sigma = 1 :=
-    congrArg Prod.snd hsigma
