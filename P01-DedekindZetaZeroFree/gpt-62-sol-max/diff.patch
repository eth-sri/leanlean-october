-  intro s
-  rw [Valued.mem_nhds_zero]
-  constructor
-  · rintro ⟨δ, hδ⟩
-    refine
-      ⟨δ.mapEquiv
-          (ValuativeRel.ValueGroupWithZero.orderMonoidIso vL).symm, ?_⟩
-    intro z hz
-    apply hδ
