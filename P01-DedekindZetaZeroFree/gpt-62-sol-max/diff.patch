-  have hm : (N.toAddSubgroup.index : ℤ) ∈
-      Ideal.under ℤ (conductor ℤ θ) := by
-    change algebraMap ℤ (𝓞 K) (N.toAddSubgroup.index : ℤ) ∈ conductor ℤ θ
