-def toOpenSubgroupOfFiniteExtensionContinuous [FiniteDimensional K L]
-    (i : L →ₐ[K] AlgebraicClosure K) :
-    Field.absoluteGaloisGroup L →ₜ* openSubgroupOfFiniteExtension K i :=
