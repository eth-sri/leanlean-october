-      (KPChartL2.weightedMeasure n D.chart D.weight)) :
-    hv.toLp _ = P (hu.toLp u) := by
-  apply Lp.ext
-  have hp : (P (hu.toLp u)) =ᵐ[KPChartL2.weightedMeasure n D.chart D.weight]
-      KPChartL2.average n r Γ D.chart D.act D.cocycle (hu.toLp u) := hP _
