-    {K : Type u} {L : Type v}
-    [Field K] [Field L] [Algebra K L]
-    [FiniteDimensional K L] [Algebra.IsSeparable K L]
-    (vK : AbsoluteValue K ℝ) (hvK : vK.IsNontrivial) :
-    ∃ hfin : Fintype (ExtendingAbsoluteValue vK L),
-      letI := hfin
