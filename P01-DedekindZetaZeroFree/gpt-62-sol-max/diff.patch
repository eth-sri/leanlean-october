-          ((globalNormResidueEquiv ℚ L).symm
-            (Additive.ofMul
-              (globalNormResidueMonoidHom ℚ L c)))) =
-      QuotientGroup.mk'
-        (RayClass.Modulus.congruenceSubgroup r) c
-  exact
-    quotientMulEquivOfNormRangeEq_globalNormResidue
-      L (RayClass.Modulus.congruenceSubgroup r) h c
