-    OpenNormalSubgroup (intrinsicAbsoluteGalois K) where
-  toSubgroup := N.toSubgroup.comap
-    (localAbsoluteAbelianizationQuotientMap K)
-  isOpen' := N.isOpen'.preimage QuotientGroup.continuous_mk
