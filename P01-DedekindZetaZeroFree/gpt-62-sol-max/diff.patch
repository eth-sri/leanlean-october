-    (standardLubinTateUnitParameterEquivGal
-      (standardLocalField K) hπ n
-      (standardLubinTateUnitParameterClass
-        (standardLocalField K) n u))⁻¹
-  let d := orderOf σ
-  localFiniteUnramifiedField K d (orderOf_pos σ) ⊔ T
