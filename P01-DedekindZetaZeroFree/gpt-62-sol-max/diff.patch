-    Algebra.adjoin
-        (equalCharacteristicCompletedUnramifiedField F.residueField)
-        ((equalCharacteristicChangedCompletedPrimitivePolynomial F u n).rootSet
-          (equalCharacteristicChangedCompletedLevelField F u n) :
