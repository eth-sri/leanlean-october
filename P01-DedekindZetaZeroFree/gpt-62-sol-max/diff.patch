-        (kroneckerWeberLocalUnramifiedDegree_pos (L := L) p).ne'
-    have hdiff :
-        p.1 ^ kroneckerWeberLocalUnramifiedDegree (L := L) p -
-            (p.1 ^ kroneckerWeberLocalUnramifiedDegree (L := L) p - 1) =
-          1 := by
