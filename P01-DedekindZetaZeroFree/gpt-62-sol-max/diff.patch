-    continuous_toFun := by
-      change Continuous fun σ =>
-        ((equivOpenSubgroupOfFiniteExtension K i σ :
-          openSubgroupOfFiniteExtension K i) :
-          Field.absoluteGaloisGroup K)
-      exact
-        (continuous_subtype_val.comp
