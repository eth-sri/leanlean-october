-    equalCharacteristicAdditiveExponentIndex k (Nat.card k ^ j) ⟨j, rfl⟩ = j := by
-  exact equalCharacteristicAdditiveExponentIndex_eq_of_pow_eq
-    k (Nat.card k ^ j) ⟨j, rfl⟩ j rfl
