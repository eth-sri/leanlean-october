-    intro x hx
-    have hz : fderiv ℝ v x = 0 := image_eq_zero_of_notMem_tsupport
-      (fun ht => hx (hvs (tsupport_fderiv_subset ℝ ht)))
-    simp [hz]
-  have hcR : IntegrableOn (fun x => (Fintype.card Γ : ℝ)⁻¹ *
