-    rw [Polynomial.leadingCoeff_map_of_injective hinjVK]
-    rw [halgVK]
-  have hcoeffFactor (j : ℕ) :
-      algebraMap K L (p.coeff j : K) =
-        algebraMap K L (p.leadingCoeff : K) *
-          ((roots.map (fun x =>
-            Polynomial.X - Polynomial.C x)).prod).coeff j := by
