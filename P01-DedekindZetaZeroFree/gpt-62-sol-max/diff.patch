-    (F : LocalField.{u, v} K) (n : ℕ)
-    (a : equalCharacteristicLubinTateUnitParameter F n) :
-    F.residueField⟦X⟧ˣ :=
-  (equalCharacteristicLubinTateUnitParameterSeries_isUnit F n a).unit
