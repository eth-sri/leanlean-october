-      · rintro ⟨_,⟨v,hv,rfl⟩,rfl⟩
-        exact ⟨Quotient.mk _ v,hv,rfl⟩
-    rw [he]
-    exact actualLine_quotient_open F ζ hζ U R P H c _ (hraw.isOpenMap _ hpre)
