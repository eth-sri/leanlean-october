-theorem mem_normSubgroup_of_targetSubgroup_mul_generator_zpow
-    (U : Subgroup H) (P : Subgroup G) (ϖ : H) (γ : G)
-    (hU : Subgroup.map N.toHom U = P)
-    (hϖ : N.toHom ϖ = γ)
