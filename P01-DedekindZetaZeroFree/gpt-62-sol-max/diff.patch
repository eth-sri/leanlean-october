-theorem quotientMapOfLe_range_eq_top {m n : ℕ} (hmn : m ≤ n) :
-    (F.quotientMapOfLe hmn).range = ⊤ :=
-  MonoidHom.range_eq_top.2 (F.quotientMapOfLe_surjective hmn)
