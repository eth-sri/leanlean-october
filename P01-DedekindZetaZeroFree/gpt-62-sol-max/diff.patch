-private theorem equalCharacteristicChangedPiPolynomialIterate_eval₂
-    (F : LocalField.{u, v} K)
-    [CharP K F.residueCharacteristic]
-    (u : F.residueField⟦X⟧ˣ)
-    {A : Type*} [Field A] [CharP A F.residueCharacteristic]
