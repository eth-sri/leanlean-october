-    (B : Type*) [CommRing B] [IsDedekindDomain B]
-    {L : Type*} [Field L] [Algebra B L] [IsFractionRing B L]
-    (P : Ideal B) [P.IsPrime] (hP : P ≠ ⊥) :
-    Ring.KrullDimLE 1
-      (dedekindAtPrimeValuationSubring B (L := L) P hP) :=
