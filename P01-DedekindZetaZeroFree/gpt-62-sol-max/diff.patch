-    (F : LocalField.{u, v} K) (n : ℕ) :
-    F.residueField⸨X⸩ →+*
-      equalCharacteristicCompletedLevelField F n :=
-  (algebraMap
-      (equalCharacteristicCompletedUnramifiedField F.residueField)
-      (equalCharacteristicCompletedLevelField F n)).comp
-    (algebraMap F.residueField⸨X⸩
-      (equalCharacteristicCompletedUnramifiedField F.residueField))
