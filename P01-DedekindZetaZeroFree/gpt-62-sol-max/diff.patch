-      rfl
-    have hassoc : Associated (q₁ * q₂) q₁ := by
-      exact associated_mul_unit_left q₁ q₂ hq₂unit
-    rw [hQfactor]
-    exact hassoc.dvd_iff_dvd_left.mpr hq₁g
