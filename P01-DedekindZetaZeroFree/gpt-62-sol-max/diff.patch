+noncomputable def partialT (F : ℝ × E → V) (p : ℝ × E) : V :=
+  fderiv ℝ (fun t => F (t,p.2)) p.1 1
+lemma partialT_smooth (F : ℝ × E → V) (hF : ContDiff ℝ (⊤ : ℕ∞) F) :
