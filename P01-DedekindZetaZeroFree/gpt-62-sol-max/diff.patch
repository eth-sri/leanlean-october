-def PartialSumsConvergeAdically
-    (R : residueRepresentativeSystem F)
-    (π : F.valuationSubring) (hπ : F.valuation.IsUniformizer (π : K))
-    (u : F.valuationSubring) : Prop :=
-  Filter.Tendsto
-    (fun n =>
-      WithTopology.toTopology F.maximalIdeal.adicTopology
