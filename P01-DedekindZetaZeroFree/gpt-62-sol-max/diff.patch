-      (f := L.val) (s := (T : Set Ω))
-      (fun x _hx y _hy hxy => Subtype.ext hxy)
-      T.finite_toSet
-  have hImage : L.val '' S = (T : Set Ω) := by
-    ext x
-    constructor
-    · rintro ⟨y, hy, rfl⟩
-      exact hy
-    · intro hx
-      have hxL₀ : x ∈ L₀ := by
-        rw [← hT]
