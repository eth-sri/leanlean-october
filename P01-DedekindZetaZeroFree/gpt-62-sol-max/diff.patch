-        Multiset.map_zero, Multiset.sum_zero, w.map_zero]
-      exact (zero_lt_iff).2 (pow_ne_zero (n + 1) ht)
-  | @cons a s ih =>
-      obtain ⟨n, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hn)
