-    (m : RayClass.Modulus K)
-    {N P : Subgroup (IdeleClassGroup K)}
-    (hN : RayClass.Modulus.congruenceSubgroup m ≤ N)
-    (hP : RayClass.Modulus.congruenceSubgroup m ≤ P)
-    (hNP : N = P) :
-    idealArtinKernel m N hN = idealArtinKernel m P hP := by
-  subst P
-  rfl
