+theorem L_eq_zeta (R : ActualRecipe S η) (s : ℂ) (hs : 1 < s.re) :
+    R.L s = InitialSeparatedEuler.zetaS R.A s := by
+  let W : Ideal (𝓞 F) → ℂ := fun I => R.target I * (Ideal.absNorm I : ℂ) ^ (-s)
