-    Polynomial.eval₂ φ x
-        (equalCharacteristicChangedPiPolynomial F
-          (equalCharacteristicThetaSourceUnit u)) =
-      equalCharacteristicLubinTateAmbientPiEnd F
-        (φ (equalCharacteristicChangedLaurentUniformizer F
