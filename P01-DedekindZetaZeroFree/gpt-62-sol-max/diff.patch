-    irreducible_monic_reduction_coprime_factor_degree_zero
-      V W huniq Q hQmonic hQirr q₁ q₂ hQfactor hqcoprime
-  have hQbar0 : Q.map (IsLocalRing.residue V) ≠ 0 :=
-    (hQmonic.map (IsLocalRing.residue V)).ne_zero
