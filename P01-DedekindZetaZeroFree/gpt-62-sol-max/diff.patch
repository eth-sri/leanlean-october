-    |(NumberField.discr F : ℝ)| ^ (Module.finrank ℚ F : ℝ)⁻¹ ≤
-        ((C : ℝ) ^ Module.finrank ℚ F) ^ (Module.finrank ℚ F : ℝ)⁻¹ :=
