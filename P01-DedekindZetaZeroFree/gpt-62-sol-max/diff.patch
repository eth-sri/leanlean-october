-    (hN : MapsFiltrationLevels N UG UH targetLevel) (n : ℕ)
-    [(UH.principalUnitSubgroup n).Normal]
-    [(UG.principalUnitSubgroup (targetLevel n)).Normal] (x : H) :
-    quotientMapOfMapsFiltrationLevels N UG UH targetLevel hN n
