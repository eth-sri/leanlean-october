-/-- The named kernel subgroup `G_m/G_n` is normal in `G/G_n`. -/
-instance quotientKernelOfLe_normal {m n : ℕ} (hmn : m ≤ n) :
-    (F.quotientKernelOfLe hmn).Normal := by
