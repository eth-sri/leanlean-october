-      ∀ s : ℝ,
-        Subgroup.map
-            (RamificationTheory.intermediateFieldRestrictNormalHom E F hEF)
-            (localUpperRamificationGroup K F s) =
-          localUpperRamificationGroup K E s := by
-    intro s
-    exact localUpperRamificationGroup_map_restrict K E F hEF s
