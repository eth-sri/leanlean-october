-
-/-- The absolute local Artin map has dense image. -/
-theorem separableAbsoluteLocalArtinMap_denseRange :
-    DenseRange (separableAbsoluteLocalArtinMap K) := by
-  let e := absoluteGaloisAbelianizationLimitEquiv K
