-def deltaCombination (x : IntegralGroupRing G) :
-    IntegralGroupRing G :=
-  ∑ g ∈ x.coeff.support,
-    x.coeff g •
-      (MonoidAlgebra.single g 1 -
-        MonoidAlgebra.single (1 : G) 1)
