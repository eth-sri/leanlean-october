-    {c g : KPFiniteCuspAtlas.FiniteCover F ζ hζ}
-    (δ : KPCuspArithmetic.PGL2 F) (ε : rootsOfUnity 3 F) (u : U.toOpenSubgroup)
-    (hg : g = KPCuspGenuineMonodromy.finiteRationalLift F ζ hζ δ *
