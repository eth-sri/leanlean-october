-    globalPadicLocalizationModuleFinite p L w
-  letI : Algebra ℚ_[p] vK.Completion := e.symm.toRingHom.toAlgebra
-  letI : IsScalarTower ℚ_[p] vK.Completion E :=
-    IsScalarTower.of_algebraMap_eq' (by ext x; rfl)
