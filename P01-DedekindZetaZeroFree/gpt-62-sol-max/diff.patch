-    (C : Fin n → ActualChart (U:=U) (H:=H))
-    (K O : Set (KPFiniteCuspAtlas.rawXU F ζ hζ U))
-    (Q : FinitePartition F ζ hζ U R P H C K O) (i : Fin n)
-    (u : KPContSectorClosedLpSubspace.H F ζ hζ R U) (hu : ActualWeakH1Loc (H:=H) u) :
