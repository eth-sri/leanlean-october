+theorem domain_equation : ∀ s ∈ V,
+    ∃ hd : u 0 s ∈ (Δ).domain,
+      Δ ⟨u 0 s, hd⟩ - KPContActualChamberCasimirJets.lambda F s • u 0 s = -h 0 s := by
