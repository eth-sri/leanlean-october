-    padicCyclotomicUnramifiedResidueDegree n q hqn ≤ m := by
-  apply orderOf_le_of_pow_eq_one hm
-  apply Units.ext
-  rw [Units.val_pow_eq_pow_val, coe_unitOfCoprime, Units.val_one,
-    ← Nat.cast_pow, ← Nat.cast_one, ZMod.natCast_eq_natCast_iff]
-  exact hqm
