-  apply (QuotientAddGroup.eq_iff_sub_mem).2
-  rw [mem_squareInIdeal_iff]
-  have hg : (deltaElement G g : IntegralGroupRing G) ∈ ideal G :=
-    (deltaElement G g).property
-  have hh : (deltaElement G h : IntegralGroupRing G) ∈ ideal G :=
-    (deltaElement G h).property
-  have hprod :
-      (deltaElement G g : IntegralGroupRing G) *
-          (deltaElement G h : IntegralGroupRing G) ∈
