-    QuotientGroup.mk tK⁻¹
-  let kM : M := transferNormNaturalityIntermediateAbsoluteEquiv
-    E.base.field E.field.field E.below k'
-  let fiberEquiv := Internal.chosenTransferNormNaturalityTransferNormFiberEquiv
-    D E L hL σ q
