-/-- The genuine sparse outer theta series for the direct orientation
-`T → uT`. -/
-noncomputable def equalCharacteristicDirectThetaSeries
-    (u : k⟦X⟧ˣ) : ((AlgebraicClosure k)⟦X⟧)⟦X⟧ :=
