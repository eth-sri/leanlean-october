-    (smallHilbertClassFieldNormSubgroup (K := K))
-    (smallHilbertClassFieldNormSubgroup (K := M))
-    (ideleClassCongr e)
-    (smallHilbertClassFieldNormSubgroup_map_ideleClassCongr e)
