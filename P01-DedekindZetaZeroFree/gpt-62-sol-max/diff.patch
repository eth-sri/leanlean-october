-/-- States the theorem `coe_equivOpenSubgroupOfFiniteExtension_apply`. -/
-@[simp]
-theorem coe_equivOpenSubgroupOfFiniteExtension_apply
-    [FiniteDimensional K L] (i : L →ₐ[K] AlgebraicClosure K)
