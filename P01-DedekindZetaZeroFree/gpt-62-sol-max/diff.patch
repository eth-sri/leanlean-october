-    (F : LocalField.{u, v} K) (n : ℕ) :
-    Finite (equalCharacteristicLubinTateUnitParameter F n) :=
-  Finite.of_equiv (F.residueFieldˣ × (Fin n → F.residueField))
-    (equalCharacteristicLubinTateUnitParameterEquiv F n).symm
-
