-@[simp] theorem mem_filtrationPreimageSubgroup_iff (n : ℕ) (x : H) :
-    x ∈ N.filtrationPreimageSubgroup UG targetLevel n ↔
-      N.toHom x ∈ UG.principalUnitSubgroup (targetLevel n) :=
-  Iff.rfl
-
