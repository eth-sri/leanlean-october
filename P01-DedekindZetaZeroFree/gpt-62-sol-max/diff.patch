-    (base := (equalCharacteristicLubinTateBaseCompleteDVF F).toDVF)
-    (target := (equalCharacteristicLubinTateLevelCompleteDVF F n).toDVF)
-    (equalCharacteristicLubinTateLevelCompleteDVF_hasUniqueDVFValuationExtension
-      F n)
