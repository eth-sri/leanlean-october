-private theorem average_toLp_eq {n r : ℕ} {Γ : Type*} [Group Γ] [Fintype Γ]
-    (D : KPChartL2.Data n r Γ)
-    (P : Lp (V r) 2 (KPChartL2.weightedMeasure n D.chart D.weight) →L[ℂ]
