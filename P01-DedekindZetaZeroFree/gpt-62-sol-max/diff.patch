-noncomputable def infiniteAbelianClassFieldCorrespondence :
-    (ClosedSubgroup (ideleClassComponentQuotient K))ᵒᵈ ≃o
-      IntermediateField K (maximalAbelianExtension K) :=
-  (ClosedSubgroup.orderDualIsoMapContinuousMulEquiv
