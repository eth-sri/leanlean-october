-    { q with
-      continuous_toFun := by
-        apply (QuotientGroup.isQuotientMap_mk
-          (commutator (intrinsicAbsoluteGalois K)).topologicalClosure).continuous_iff.2
-        refine (InfiniteGalois.restrictNormalHom_continuous E).congr ?_
