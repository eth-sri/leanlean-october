-  classical
-  let e := (FiniteIdeleGroup.valuationVector a).toAdd
-  have heval (v : HeightOneSpectrum (𝓞 K)) :
-      e v =
-        (FiniteIdeleGroup.localOrder v (a v)).toAdd := by
-    simpa only [e] using
-      FiniteIdeleGroup.valuationVector_apply a v
-  have hsupport :
-      mulSupport
