-            partialSum F R π hπ u (n + 1) +
-              π ^ (n + 1) * remainder F R π hπ u (n + 1) := by
-          change
-            partialSum F R π hπ u n +
-                π ^ n *
-                  (coeff F R π hπ u n +
-                    π * remainder F R π hπ u (n + 1)) =
-              (partialSum F R π hπ u n +
-                  coeff F R π hπ u n * π ^ n) +
-                π ^ (n + 1) * remainder F R π hπ u (n + 1)
-          rw [pow_succ]
-          ring
