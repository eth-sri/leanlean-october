-noncomputable def
-    arithmeticClosedFiniteIndexClassFieldGaloisContinuousMulEquivNormQuotient
-    (H : Subgroup (IdeleClassGroup K))
-    (hclosed : IsClosed (H : Set (IdeleClassGroup K)))
-    [H.FiniteIndex] :
-    Gal((closedFiniteIndexClassField
-          (K := K) H hclosed) / K) ≃ₜ*
