-exponent chosen at `p`. -/
-noncomputable def kroneckerWeberLocalCompositumOrder
-    (p : Nat.Primes) : ℕ :=
-  kroneckerWeberLocalCompositumCoprimePart (L := L) p *
-    p.1 ^ kroneckerWeberLocalRamificationExponent (L := L) p
