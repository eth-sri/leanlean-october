-          (artin E).toMonoidHom.ker = E.normSubgroup) ∧
-      ∀ (E F : FiniteAbelianLocalExtension K)
-        (hEF : E.1 ≤ F.1) (x : Kˣ) (y : E.1),
-        IntermediateField.inclusion hEF ((artin E x) y) =
