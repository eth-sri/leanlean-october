-                  (w (((s.map (fun β => X - C β)).prod).coeff j))
-                  (w (α * ((s.map (fun β => X - C β)).prod).coeff (j + 1))) := by
-              simpa [sub_eq_add_neg] using hsum
-            _ ≤ B ^ (s.card + 1) :=
-              max_le (hqj.trans hpow_step) hterm
