-      f.map V.subtype * Polynomial.C c = g.map V.subtype := by
-    rw [hcu]
-    exact hu
-  obtain ⟨i, hfi⟩ := exists_isUnit_coeff_of_isPrimitive V hf
-  obtain ⟨uf, huf⟩ := hfi
