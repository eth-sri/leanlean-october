-/-- The target integer-unit equivalence preserves every explicit
-Lubin--Tate higher-unit level. -/
-theorem
-    equalCharacteristicPowerSeriesUnitsEquivTargetInteger_mem_principalUnits_iff
-    (p : ℕ) [Fact p.Prime] [CharP K p]
