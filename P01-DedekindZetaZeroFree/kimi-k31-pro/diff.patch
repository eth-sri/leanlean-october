-    ¬ P ^ P.ramificationIdx ℤ ∣ differentIdeal ℤ (𝓞 L) := by
-  classical
-  let p : Ideal ℤ := Ideal.span {(q : ℤ)}
-  have : Fact q.Prime := ⟨hq⟩
