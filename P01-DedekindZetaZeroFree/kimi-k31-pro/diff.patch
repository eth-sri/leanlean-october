-          IsLocalRing.residue 𝒪[E.1] z =
-            (IsLocalRing.residue 𝒪[E.1] x) ^ Nat.card 𝓀[K])
-    : f = g := by
-  obtain ⟨π, hπ⟩ := (LocalFieldTheory.localCompleteDVF K).exists_uniformizer
