-      Nat.totient (kroneckerWeberConductorCandidate (L := L)) := by
-  classical
-  let M := kroneckerWeberCompositumField L
-  let C := CyclotomicField (kroneckerWeberConductorCandidate (L := L)) ℚ
-  let S := kroneckerWeberRamifiedPrimes (L := L)
