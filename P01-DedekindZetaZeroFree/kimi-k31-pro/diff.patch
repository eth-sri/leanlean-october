-  let F := E i₀
-  let : Module.Finite K F := (hFactors i₀).1
-  have hFCard : Fintype.card I = (n : ℕ) / d := by
-    simpa only [Nat.card_eq_fintype_card, Nat.cast_id] using hCard
-  let σ : I ≃ Fin ((n : ℕ) / d) := Fintype.equivFinOfCardEq hFCard
