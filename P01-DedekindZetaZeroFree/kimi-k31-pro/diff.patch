-        (algebraMap
-          (equalCharacteristicTargetLocalField K).residueField⟦X⟧
-          (equalCharacteristicTargetLocalField K).residueField⸨X⸩
-          (a :
-            (equalCharacteristicTargetLocalField K).residueField⟦X⟧))
