-    hlift.irreducible_monic_reduction_coprime_factor_degree_zero
-      hf hirr hgmonic hhmonic (by simpa [qbar] using hfactor.symm) hcoprime
-  exact hdegree.imp hgmonic.natDegree_eq_zero.mp
-    hhmonic.natDegree_eq_zero.mp
