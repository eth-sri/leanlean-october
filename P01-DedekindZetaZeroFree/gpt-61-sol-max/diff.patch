-private theorem mulEquiv_symm_apply_eq_one_iff
-    {G H : Type} [Group G] [Group H]
-    (e : G ≃* H) (x : H) :
-    e.symm x = 1 ↔ x = 1 := by
-  constructor
-  · intro hx
-    apply e.symm.injective
-    exact hx.trans (map_one e.symm).symm
-  · intro hx
-    calc
-      e.symm x = e.symm 1 := congrArg e.symm hx
-      _ = 1 := map_one e.symm
