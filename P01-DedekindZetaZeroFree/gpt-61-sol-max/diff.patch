-            MonoidAlgebra.single g 1 -
-                MonoidAlgebra.single r 1 =
-              MonoidAlgebra.single r 1 *
-                (MonoidAlgebra.single (r⁻¹ * g) 1 -
-                  MonoidAlgebra.single 1 1)
