-    fieldNormQuotientEquivZMod K L vK vL residueDegree
-        hformula hϖK hϖL hzero
-        ((QuotientGroup.mk' (fieldNormSubgroup K L) ϖK) ^ n) =
-      Multiplicative.ofAdd ((n : ℤ) : ZMod residueDegree) := by
