-    (⟨p.1.1, Finset.mem_image.mpr ⟨p, p.2, rfl⟩⟩,
-      ⟨p.1.2, Finset.mem_image.mpr ⟨p, p.2, rfl⟩⟩)
-  have hemb : Function.Injective emb := by
