-          (Additive (Abelianization G)) := by
-      exact Nat.card_congr
-        ((presentationLinearMap φ).quotKerEquivOfSurjective
-          (presentationMap_surjective φ hφ)).toEquiv
-    _ = Nat.card (Abelianization G) := rfl
-
-end Presentation
