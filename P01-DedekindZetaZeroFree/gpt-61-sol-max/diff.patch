-    finiteWithAbsNontriviallyNormedField v hv
-  let : Algebra (WithAbs v) L :=
-    WithAbs.algebraLeft L v
-  let : CompleteSpace (WithAbs v) :=
-    completeSpace_withAbs_of_isCompleteForAbsoluteValue v hcomplete
