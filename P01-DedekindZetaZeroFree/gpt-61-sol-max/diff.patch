-            embeddedDelta
-              (commutator G) h,
-            embeddedDelta_mem_embeddedSubgroupIdeal
-                (commutator G) h, rfl⟩
-        rw [mem_ideal_iff, map_mul]
-        simp [(mem_ideal_iff G x).mp hx]
-    | add a b ha hb =>
-        convert
-          (mixedAugmentationProduct
-              (commutator G)).add_mem ha hb using 1
-        simp only [map_add]
