-            simpa [B, L] using
-              equalCharacteristicLubinTateLevelField_natCard_gal F n
-      _ = (q - 1) * q ^ n := by
-            simpa [B, L, q] using
-              equalCharacteristicLubinTateLevelField_finrank F n
