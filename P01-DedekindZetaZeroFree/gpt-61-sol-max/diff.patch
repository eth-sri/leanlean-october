-          (Algebra.norm K : L →* K) y) ∈
-      allPlaceLocalNormCondition (K := K) (L := L)
-  rw [← RelativeIdeleGroup.norm_principalIdele K L y]
-  exact
-    relativeIdeleNorm_range_le_allPlaceLocalNormCondition
-      (K := K) (L := L) ⟨_, rfl⟩
 
