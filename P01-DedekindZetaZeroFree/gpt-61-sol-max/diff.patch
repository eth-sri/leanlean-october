+        UG UH targetLevel hN n htarget
+        (UH.principalUnitGradedPieceMk n x) =
+      UG.principalUnitSubquotientMk (targetLevel n) (targetLevel (n + 1))
+        (mapLevelOfMapsFiltrationLevels N UG UH targetLevel hN n x) :=
