-/-- The Artin-oriented explicit finite-level reciprocity equivalence from
-the unit quotient. -/
-noncomputable def equalCharacteristicLubinTateArtinUnitQuotientEquivGal
-    (F : LocalField.{u, v} K)
-    [CharP K F.residueCharacteristic]
-    (n : ℕ) :
-    F.residueField⟦X⟧ˣ ⧸
