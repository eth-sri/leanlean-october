-    {ϖK : Kˣ} (hϖK : vK.IsUniformizer ϖK)
-    {ϖL : Lˣ} (hϖL : vL.IsUniformizer ϖL)
-    (hzero : vK.zeroSubgroup ≤ fieldNormSubgroup K L)
