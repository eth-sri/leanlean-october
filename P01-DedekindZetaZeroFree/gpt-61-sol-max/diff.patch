+       :=
+  (N.principalUnitSubquotientMapOfMapsFiltrationLevels
+    UG UH targetLevel hN (Nat.le_succ n) htarget).comp
+      (UH.principalUnitGradedPieceEquivSubquotient n).toMonoidHom
