-            HahnSeries.map y φ.toAddMonoidHom
-      exact
-        HahnSeries.map_add (Γ := ℤ) (R := ZMod p) (S := k)
-          φ.toAddMonoidHom
-    map_mul' := by
-      intro x y
-      change
-        HahnSeries.map (x * y) φ.toNonUnitalRingHom =
-          HahnSeries.map x φ.toNonUnitalRingHom *
-            HahnSeries.map y φ.toNonUnitalRingHom
