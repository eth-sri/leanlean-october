-its simultaneous small representatives. -/
-noncomputable def shrinkGalEquiv
-    (K L : Type*) [Field K] [Field L] [Algebra K L]
-    [Small.{0} K] [Small.{0} L] :
-    letI : Algebra (Shrink.{0} K) (Shrink.{0} L) := shrinkAlgebra K L
-    Gal(Shrink.{0} L / Shrink.{0} K) ≃ Gal(L/K) :=
-  letI : Algebra (Shrink.{0} K) (Shrink.{0} L) := shrinkAlgebra K L
