-    calc
-      qbar.natDegree = G.natDegree :=
-        hGmonic.natDegree_map (IsLocalRing.residue V)
-      _ = (G.map (algebraMap V K)).natDegree := by
-        rw [Polynomial.natDegree_map_eq_of_injective
-          (show Function.Injective (algebraMap V K) from
