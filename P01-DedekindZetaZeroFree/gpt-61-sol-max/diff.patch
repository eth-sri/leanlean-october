-      exact HahnSeries.map_zero (Γ := ℤ) (R := ZMod p) (S := k) φ.toZeroHom
-    map_one' := by
-      change HahnSeries.map (1 : (ZMod p)⸨X⸩) φ.toMonoidWithZeroHom = 1
-      exact
-        HahnSeries.map_one (Γ := ℤ) (R := ZMod p) (S := k)
-          φ.toMonoidWithZeroHom
