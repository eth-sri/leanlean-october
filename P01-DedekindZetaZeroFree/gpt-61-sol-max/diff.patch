-      Module.finrank k
-          (IntermediateField.adjoin k ({alpha} : Set ell)) =
-        Module.finrank K L := by
-    rw [IntermediateField.adjoin.finrank halphaIntegral, ← hqMinpoly]
-    exact hqDegree
