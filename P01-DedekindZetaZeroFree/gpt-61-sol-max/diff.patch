-    (hv : v.IsNontrivial) (x : L) :
-    finiteSpectralExtension (K := K) (L := L)
-      v hcomplete hnonarch hv x =
-      v ((minpoly K x).coeff 0) ^
-        (1 / ((minpoly K x).natDegree : ℝ)) :=
-  finiteSpectralNormEqMinpolyCoeffZeroRpow
