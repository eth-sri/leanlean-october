-    v (Algebra.norm K x) =
-      v ((minpoly K x).coeff 0) ^
-        (Module.finrank (IntermediateField.adjoin K ({x} : Set L)) L) := by
-  let : Algebra.IsAlgebraic K L := Algebra.IsAlgebraic.of_finite K L
