-    · rw [V.mem_zeroSubgroup_iff, V.val_mul, V.val_inv,
-        V.val_uniformizer_zpow hϖ n, hx]
-      ring
-    · rw [mul_assoc, inv_mul_cancel, mul_one]
-  · rintro ⟨u, hu, hux⟩
-    rw [← hux, V.val_mul, (V.mem_zeroSubgroup_iff u).1 hu,
-      V.val_uniformizer_zpow hϖ n, zero_add]
 
