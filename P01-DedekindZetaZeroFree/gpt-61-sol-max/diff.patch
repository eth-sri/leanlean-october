-      equalCharacteristicLubinTateLevelAlgebra F n
-    letI : FiniteDimensional B L :=
-      equalCharacteristicLubinTateLevelField_finiteDimensional F n
-    letI : IsGalois B L :=
-      equalCharacteristicLubinTateLevelField_isGalois F n
