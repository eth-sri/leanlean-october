-  by_cases hrs : r ≤ s
-  · rw [min_eq_left hrs]
-    exact le_max_left _ _
-  · have hsr : s ≤ r := le_of_not_ge hrs
-    rw [min_eq_right hsr]
-    exact le_max_right _ _
 
