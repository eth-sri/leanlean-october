-      [ValuativeRel E.1] [UniformSpace E.1] [IsUniformAddGroup E.1]
-      [IsNonarchimedeanLocalField E.1]
-      [Valuation.HasExtension (ValuativeRel.valuation K)
-        (ValuativeRel.valuation E.1)],
