-      hArtin.symm
-    _ =
-        Subgroup.map q.toMonoidHom
-          (localUpperRamificationGroup K E t) := by
-      rw [hExplicit]
-    _ = localUpperRamificationGroup K M t := hUpper
-
-end LocalClassFieldTheory
-
-end
