-    (tateComplex
-        (Rep.ofMulDistribMulAction (L ≃ₐ[K] L)
-          (RelativeIdeleGroup K L))).homologyπ 0
-      (tateH0FixedCycle aI)
-  have hP :
-      (tateH0IsoHerbrandH0
-          (G := L ≃ₐ[K] L)
