-    rw [Polynomial.lifts_iff_coeff_lifts]
-    intro n
-    exact IsLocalRing.residue_surjective (fbar.coeff n)
-  obtain ⟨F, hFmap, _hFdegree, hFmonic⟩ :=
-    Polynomial.lifts_and_natDegree_eq_and_monic hlifts hfbarMonic
