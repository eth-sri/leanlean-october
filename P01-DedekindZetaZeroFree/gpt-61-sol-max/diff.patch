-  commutes' := by
-    intro y
-    change E (σ (E.symm (algebraMap M Ψ y))) = algebraMap M Ψ y
-    rw [semilinear_symm_algebraMap e E hE y, σ.commutes, hE,
-      e.apply_symm_apply]
