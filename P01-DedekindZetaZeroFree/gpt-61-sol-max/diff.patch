+/-- States the theorem `ofFiniteExtensionAbsolute_apply`. -/
+@[simp]
+theorem ofFiniteExtensionAbsolute_apply [FiniteDimensional K L]
+    (i : L →ₐ[K] AlgebraicClosure K) (σ : Field.absoluteGaloisGroup L) :
+    ofFiniteExtensionAbsolute K i σ =
