-    (L : Type*) [Field L] [ValuativeRel L] [TopologicalSpace L]
-    [IsNonarchimedeanLocalField L] [Small.{0} L] :
-    letI : ValuativeRel (Shrink.{0} L) := shrinkLocalFieldValuativeRel L
