-                    (MonoidAlgebra.of ℤ G g))) =
-              MonoidAlgebra.single r 1 *
-                embeddedDelta
-                  (commutator G) h := by
-          simp only [MonoidAlgebra.of_apply,
-            abelianizationRingMap_single,
-            abelianizationRingSection_single]
-          rw [embeddedDelta_eq]
-          simp only [deltaElement_val]
