-    · intro i hi j hj hij hterm_i hterm_j
-      have hsi : s i ≠ 0 := by
-        intro hzero
-        exact hterm_i (by simp [hzero])
-      have hsj : s j ≠ 0 := by
-        intro hzero
-        exact hterm_j (by simp [hzero])
-      obtain ⟨ai, hai, hvi⟩ := hinner i hsi
-      obtain ⟨aj, haj, hvj⟩ := hinner j hsj
