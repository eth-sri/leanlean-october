-theorem val_eq_iff_exists_zeroSubgroup_mul_uniformizer_zpow {ϖ : G}
-    (hϖ : V.IsUniformizer ϖ) (x : G) (n : ℤ) :
-    V.val x = n ↔ ∃ u : G, u ∈ V.zeroSubgroup ∧ u * ϖ ^ n = x := by
-  constructor
-  · intro hx
