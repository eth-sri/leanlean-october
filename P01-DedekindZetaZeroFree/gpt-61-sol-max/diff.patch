-    _ = ∏ j : Fin ((n : ℕ) / d), Algebra.norm K (eTotal z j) :=
-      ValuationTheory.Completion.algebra_norm_pi_apply
-        (fun _ : Fin ((n : ℕ) / d) => F) (eTotal z)
