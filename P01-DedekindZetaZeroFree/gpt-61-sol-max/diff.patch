-    letI : Algebra (Shrink.{0} K) (Shrink.{0} L) := shrinkAlgebra K L
-    FiniteDimensional (Shrink.{0} K) (Shrink.{0} L) :=
-  letI : Algebra (Shrink.{0} K) (Shrink.{0} L) := shrinkAlgebra K L
-  Module.Finite.of_equiv_equiv
-    (Shrink.ringEquiv K).symm (Shrink.ringEquiv L).symm
-    (shrinkAlgebra_commutes K L)
