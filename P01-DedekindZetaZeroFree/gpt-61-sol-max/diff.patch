-private theorem mulEquiv_apply_trans_symm
-    {G H I : Type} [Group G] [Group H] [Group I]
-    (e : G ≃* H) (f : H ≃* I) (x : I) :
-    e ((e.trans f).symm x) = f.symm x :=
-  e.apply_symm_apply (f.symm x)
