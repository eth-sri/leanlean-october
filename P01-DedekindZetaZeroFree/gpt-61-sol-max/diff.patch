-    (hFmonic : F.Monic)
-    (hFroot :
-      (F.map ((algebraMap K L).comp
-        (LubinTate.Valuations.exponentialValuationSubring v).subtype)).eval (a : L) = 0)
-    (hFreduction :
-      (F.map (IsLocalRing.residue
