open scoped ValuativeRel

/-!
# Quotients by a uniformizer and principal units

For a nonarchimedean local field, quotienting the field-unit group by the
standard subgroup generated by a normalized uniformizer and `U^n` is
canonically equivalent to quotienting the integer-unit group by `U^n`.
-/

namespace LocalFieldTheory

open LocalFieldTheory
open LocalFieldTheory.IsNonarchimedeanLocalField

private theorem integerUnitsToFieldUnits_injective
    (L : Type*) [Field L] [ValuativeRel L] :
    Function.Injective (integerUnitsToFieldUnits L) := by
  intro x y hxy
  ext
  exact congrArg (fun z : Lˣ => (z : L)) hxy
