-inertia-group part of the simultaneous conjugacy used later for Frobenius
-classes. -/
-theorem mem_inertiaGroup_smul_iff
-    {P : Ideal B} {G : Type*} [Group G] [MulSemiringAction G B]
-    {σ τ : G} :
-    τ ∈ inertiaGroup (σ • P) G ↔
-      σ⁻¹ * τ * σ ∈ inertiaGroup P G := by
