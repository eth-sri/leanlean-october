-          (deltaElement G h : IntegralGroupRing G)) =
-      0 := by
-  simp [deltaElement, map_sub,
-    MonoidAlgebra.single_mul_single, mul_sub, sub_mul]
-
-/-- Linearization kills a product of two augmentation-zero elements. -/
