-    Nat.add_pos_right _ (Nat.pos_of_ne_zero hm)
-  have hcop : Nat.Coprime a m := by
-    change Nat.Coprime ((u : ZMod m).val + m) m
-    rw [Nat.coprime_add_self_left]
