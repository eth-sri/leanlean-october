-def depthLowerFiltration : AntitoneNormalSubgroupFiltration H where
-  lower := D.depthLowerSubgroup H
-  lower_normal := by
-    intro n
-    constructor
-    intro τ hτ σ
-    change WithTop.some (n + 1) ≤ D.depth (((σ * τ * σ⁻¹ : H) : G))
-    rw [show (((σ * τ * σ⁻¹ : H) : G)) =
-        (σ : G) * (τ : G) * (σ : G)⁻¹ by rfl, D.depth_conj]
-    exact hτ
