-      (ValuativeRel.valuation L).valuationSubring.comap
-        (Shrink.ringEquiv L).toRingHom :=
-  letI : ValuativeRel (Shrink.{0} L) := shrinkLocalFieldValuativeRel L
-  by
-    let v := shrinkLocalFieldValuation L
