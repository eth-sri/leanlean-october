-    (w : AbsoluteValueExtension (Rat.AbsoluteValue.padic p) L) : Prop := by
-  let vK := Rat.AbsoluteValue.padic p
-  letI hK := AbsoluteValue.extensionCompletionAlgebra (K := ℚ) w.1
