-        (D.frobeniusFixedField E.field L hL
-          (D.transferNormNaturalityTransferFrobeniusLift
-            E L hL σ q))
-        (D.frobeniusFixedField_le E.field L hL
-          (D.transferNormNaturalityTransferFrobeniusLift
-            E L hL σ q)) :=
-    Subgroup.mem_map_iff_mem e.injective
