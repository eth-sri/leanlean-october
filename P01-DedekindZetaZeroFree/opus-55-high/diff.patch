-private theorem principalUnitsImage_zero_eq_top_of_uniformizer_zpowers_le_ker
-    {G : Type} [Group G]
-    (φ : Kˣ →* G)
-    (hφ : Function.Surjective φ)
-    (ϖ : Kˣ)
