-      localCompleteDVF_integerRing_moduleFinite K E
-    IsUnramifiedValuedExtension K E := by
-  let H : FiniteAbstractField (Gal(SeparableClosure K / K)) :=
-    { field := closedFixingSubgroup K (SeparableClosure K) E
-      finite := by
