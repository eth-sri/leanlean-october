-    (UK : AntitoneSubgroupFiltration Kˣ) (UL : AntitoneSubgroupFiltration Lˣ)
-    (targetLevel : ℕ → ℕ) :
-    ValuedNorm.MapsFiltrationLevels
-        (valuedFieldNorm K L vK vL residueDegree hformula)
-        UK UL targetLevel ↔
-      fieldNormMapsFiltrationLevels K L UK UL targetLevel :=
-  Iff.rfl
