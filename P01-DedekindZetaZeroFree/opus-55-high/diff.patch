-    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx ⊢
-    intro hy
-    apply hx
-    rw [← e.symm_apply_apply x]
-    exact hy.map (e.symm : S →+* R)
-  · intro hy
-    refine ⟨e.symm y, ?_, e.apply_symm_apply y⟩
-    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hy ⊢
-    intro hx
