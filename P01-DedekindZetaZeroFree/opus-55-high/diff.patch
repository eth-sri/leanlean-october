-    MonoidHom.mem_ker.mp hpowKer
-  refine ⟨integerUnitsToFieldUnits K u, ?_, ?_⟩
-  · unfold LocalFieldTheory.fieldPrincipalUnits
-    exact ⟨u, by simp, rfl⟩
-  · rw [← hx, ← hdecomp, map_mul, hpow, mul_one]
