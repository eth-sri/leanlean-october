-@[simp]
-theorem relativeDeltaAbelianizationEquiv_apply
-    (H : Subgroup G) (a : Abelianization H) :
-    relativeDeltaAbelianizationEquiv H a =
-      relativeDeltaAbelianization H a :=
-  rfl
