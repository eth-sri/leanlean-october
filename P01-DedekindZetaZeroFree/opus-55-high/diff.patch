-theorem primeToIdealResidueHom_surjective
-    (m : ℕ) (hm : m ≠ 0) :
-    Function.Surjective (primeToIdealResidueHom m hm) := by
-  intro u
-  let a : ℕ := (u : ZMod m).val + m
