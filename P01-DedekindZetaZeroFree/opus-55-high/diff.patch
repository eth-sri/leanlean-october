-@[simp] theorem mem_depthLowerSubgroup_iff (n : ℕ) (τ : H) :
-    τ ∈ D.depthLowerSubgroup H n ↔
-      WithTop.some (n + 1) ≤ D.depth (τ : G) :=
-  Iff.rfl
