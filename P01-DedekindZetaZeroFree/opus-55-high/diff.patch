-/-- The additive embedding `I_H → ℤ[G]`. -/
-def subgroupIdealEmbedding (H : Subgroup G) :
-    ideal H →+ IntegralGroupRing G where
-  toFun x := subgroupRingMap H (x : IntegralGroupRing H)
-  map_zero' := (subgroupRingMap H).map_zero
