-@[simp]
-theorem relativeDeltaAbelianizationEquiv_of
-    (H : Subgroup G) (h : H) :
-    relativeDeltaAbelianizationEquiv H
-        (Abelianization.of h) =
-      Multiplicative.ofAdd (relativeDeltaClass H h) :=
-  rfl
