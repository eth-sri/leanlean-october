-    (m : RayClass.Modulus K)
-    (N : Subgroup (IdeleClassGroup K))
-    (hm : RayClass.Modulus.congruenceSubgroup m ≤ N)
-    (v : HeightOneSpectrum (𝓞 K))
-    (hv : v ∉ m.finitePart.support) :
-    IdeleClassGroup K ⧸ N :=
-  idealArtinMap m N hm
-    (RayClass.primeToModulusIdeal m v hv)
