-theorem localUpperRamificationGroupAfter_map_restrict
-    (K : Type) [Field K]
-    [ValuativeRel K] [TopologicalSpace K]
-    [IsNonarchimedeanLocalField K]
-    (E F : IntermediateField K (SeparableClosure K)) (hEF : E ≤ F)
