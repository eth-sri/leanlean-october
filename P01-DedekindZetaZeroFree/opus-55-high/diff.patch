-        x ∈ σ • B ↔ e x ∈ shrinkGalEquiv K L σ • A :=
-          shrink_mem_pointwise_smul_iff K L σ x
-        _ ↔ e x ∈ A := by rw [h]
-        _ ↔ x ∈ B := (hmem x).symm
