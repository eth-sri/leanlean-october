-        (QuotientGroup.mk' (idealArtinKernel m N hm)
-          (RayClass.primeToModulusIdeal m v hv)) := by
-  exact
-    (idealClassQuotientEquivNormQuotient m N hm).orderOf_eq
-      (QuotientGroup.mk' (idealArtinKernel m N hm)
-        (RayClass.primeToModulusIdeal m v hv))
