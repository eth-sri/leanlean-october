-    (denseRange_inclusion_iff
-      (Subgroup.le_topologicalClosure S :
-        (S : Set (openFiniteQuotientProduct G)) ⊆
-          (S.topologicalClosure : Set (openFiniteQuotientProduct G)))).2 <| by
-      simp [Subgroup.topologicalClosure_coe]
