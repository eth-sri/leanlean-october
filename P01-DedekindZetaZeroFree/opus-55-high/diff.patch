-  apply Continuous.of_coeHom_comp
-  rw [Topology.IsEmbedding.subtypeVal.continuous_iff]
-  have hval := Units.continuous_val.comp hquotient
-  convert hval using 1
-  funext x
-  exact (integerUnitsToFieldUnits_apply K
