-  rcases Nat.find_spec hP with ⟨x, hxI, hx0, hxval⟩
-  refine ⟨n, x, hxI, hx0, hxval, ?_⟩
-  intro y hyI hy0
-  rcases hvalue y hy0 with ⟨m, hm⟩
-  have hnm : n ≤ m := Nat.find_min' hP ⟨y, hyI, hy0, hm⟩
-  exact (hweight hnm).trans_eq hm.symm
