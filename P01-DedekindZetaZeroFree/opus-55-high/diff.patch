-    letI : Algebra K L :=
-      equalCharacteristicTransportedLubinTateLevelAlgebra
-        K p ϖ hϖ n
-    letI : FiniteDimensional K L :=
-      equalCharacteristicTransportedLubinTateLevel_finiteDimensional
-        K p ϖ hϖ n
-    letI : IsGalois K L :=
-      equalCharacteristicTransportedLubinTateLevel_isGalois
-        K p ϖ hϖ n
