-    {x : WithZero (Multiplicative ℤ)} (hx : x ≠ 0)
-    (hlog : WithZero.log x = 0) :
-    x = 1 := by
-  calc
-    x = WithZero.exp (WithZero.log x) :=
-      (WithZero.exp_log hx).symm
-    _ = WithZero.exp 0 := congrArg WithZero.exp hlog
-    _ = 1 := rfl
