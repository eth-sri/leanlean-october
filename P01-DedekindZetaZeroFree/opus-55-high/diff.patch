-    change IsFractionRing Vv K
-    have hfr : IsFractionRing Vv.valuation.valuationSubring K :=
-      (Valuation.valuationSubring.integers
-        (v := Vv.valuation)).isFractionRing
-    rw [Vv.valuationSubring_valuation] at hfr
