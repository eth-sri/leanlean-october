-    (Polynomial.mem_roots (hFmonic.map
-      (valuationSubringMapOfHasExtension V W hW)).ne_zero).1 haRoot
-  have hbEval : FW.eval b = 0 :=
-    (Polynomial.mem_roots (hFmonic.map
-      (valuationSubringMapOfHasExtension V W hW)).ne_zero).1 hbRoot
