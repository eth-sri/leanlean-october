-          (ih (fun c hc => hu c (by simp [hc])))
-  have htprod : w t.prod ≤ 1 :=
-    hprodle t (fun b hb => hs b (by simp [hb]))
-  exact mul_lt_one_of_lt_of_le halt htprod
