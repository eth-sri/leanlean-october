-    dsimp [U]
-    rw [Finset.iInter_mem_sets]
-    intro n hn
-    have hopen : IsOpen
-        ((PowerSeries.coeff n : k⟦X⟧ → k) ⁻¹' ({0} : Set k)) :=
-      (isOpen_discrete ({0} : Set k)).preimage
-        (PowerSeries.WithPiTopology.continuous_coeff k n)
