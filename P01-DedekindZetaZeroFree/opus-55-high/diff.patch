-    ((QuotientGroup.quotientMulEquivOfEq
-        (F.levelSubgroupToQuotient_ker_eq hmn).symm).trans
-      ((QuotientGroup.quotientKerEquivRange
-        (F.levelSubgroupToQuotient hmn)).trans
