-      Set.range (topologicalProfiniteCompletionMap G) = Set.range incl := by
-    ext x
-    constructor
-    · rintro ⟨g, rfl⟩
-      exact ⟨(openFiniteQuotientProductMapMonoidHom G).rangeRestrict g, rfl⟩
-    · rintro ⟨y, rfl⟩
-      rcases y.2 with ⟨g, hg⟩
-      refine ⟨g, ?_⟩
-      apply Subtype.ext
-      change (openFiniteQuotientProductMapMonoidHom G) g = y
-      exact hg
-  intro x
-  rw [hrange]
-  exact hincl x
