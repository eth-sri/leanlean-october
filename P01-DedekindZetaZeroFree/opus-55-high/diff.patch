-    (v : ValuationData D A)
-    (H H' : FiniteAbstractField G)
-    (hHH' : H.field = H'.field)
-    (x : ambientFixedAddSubgroup A H.field)
-    (x' : ambientFixedAddSubgroup A H'.field)
-    (hxx' : x.1 = x'.1) :
