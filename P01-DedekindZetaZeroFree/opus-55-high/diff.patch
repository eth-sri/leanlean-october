-    uniformizerUnitFactor K ϖ hϖ 1 = 1 := by
-  apply integerUnitsToFieldUnits_injective K
-  rw [integerUnitsToFieldUnits_uniformizerUnitFactor]
-  rw [valuationMap_ofMul_one]
