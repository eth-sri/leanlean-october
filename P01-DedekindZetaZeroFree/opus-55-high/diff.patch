-        vL.restrict z <
-          (ValuativeRel.ValueGroupWithZero.orderMonoidIso vL)
-            (γ : ValuativeRel.ValueGroupWithZero L) := by
-      exact hz
-    exact
-      (ValuativeRel.restrict_lt_orderMonoidIso
-        vL (γ : ValuativeRel.ValueGroupWithZero L) z).1 hz'
