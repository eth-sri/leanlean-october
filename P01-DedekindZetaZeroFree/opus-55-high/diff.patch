-    {F : Type u} {G : Type v} [Field F] [Field G]
-    [NumberField F] [NumberField G] (e : F ≃+* G) :
-    HeightOneSpectrum (𝓞 F) ≃ HeightOneSpectrum (𝓞 G) :=
