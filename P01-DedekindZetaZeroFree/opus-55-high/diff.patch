-          K (smallHilbertClassField K)
-          (QuotientGroup.mk'
-            (IdeleGroup.principalSubgroup K) a)) =
-      IdeleGroup.idealClass a := by
-  rw [
-    arithmeticSmallHilbertClassFieldGaloisEquivClassGroupOverOriginal_globalNormResidue,
