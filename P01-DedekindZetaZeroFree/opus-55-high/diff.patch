-    Subgroup.map
-        (intermediateFieldRestrictNormalHom E F hEF)
-        (⨆ s : {s : ℝ // t < s},
-          localUpperRamificationGroup K F (s : ℝ)) =
-      ⨆ s : {s : ℝ // t < s},
-        Subgroup.map
-          (intermediateFieldRestrictNormalHom E F hEF)
-          (localUpperRamificationGroup K F (s : ℝ)) := by
-            simpa using
-              Subgroup.map_iSup
-                (intermediateFieldRestrictNormalHom E F hEF)
-                (fun s : {s : ℝ // t < s} =>
-                  localUpperRamificationGroup K F (s : ℝ))
-    _ = ⨆ s : {s : ℝ // t < s},
-        localUpperRamificationGroup K E (s : ℝ) := by
-          apply iSup_congr
-          intro s
-          exact localUpperRamificationGroup_map_restrict
-            K E F hEF (s : ℝ)
