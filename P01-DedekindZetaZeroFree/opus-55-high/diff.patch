-  let vK := NumberField.HeightOneSpectrum.adicAbv K v
-  let hvK : vK.IsNontrivial := RayClass.adicAbv_isNontrivial v
-  let w : ExtendingAbsoluteValue vK L :=
-    _root_.chosenFinitePlaceExtension (L := L) v
