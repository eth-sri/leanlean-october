-    (UK : AntitoneSubgroupFiltration Kˣ) (UL : AntitoneSubgroupFiltration Lˣ)
-    (targetLevel : ℕ → ℕ)
-    (hN : fieldNormMapsFiltrationLevels K L UK UL targetLevel) (n : ℕ)
-    (x : UL.principalUnitSubgroup n) :
