-    (E F : IntermediateField K (SeparableClosure K))
-    [hEfin : FiniteDimensional K E] [hFfin : FiniteDimensional K F]
-    (h : E = F) :
-    SpectrallyUnramifiedLocalIntermediateField K E ↔
-      SpectrallyUnramifiedLocalIntermediateField K F := by
