-    (UK : AntitoneSubgroupFiltration Kˣ) (UL : AntitoneSubgroupFiltration Lˣ)
-    (targetLevel : ℕ → ℕ) : Prop :=
-  ∀ n {x : Lˣ}, x ∈ UL.principalUnitSubgroup n →
-    normUnits K L x ∈ UK.principalUnitSubgroup (targetLevel n)
