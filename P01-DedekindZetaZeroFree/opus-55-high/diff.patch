-theorem card_quotientInertiaByWildKernel_eq_tameQuotient {n : ℕ}
-    (hn : 1 ≤ n) [Finite G] :
-    Nat.card
-        (F.quotientKernelOfLe (le_trans (Nat.zero_le 1) hn) ⧸
