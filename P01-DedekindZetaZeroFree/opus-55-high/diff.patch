-profinite group. -/
-noncomputable def standardLocalAbsoluteAbelianProfinite
-    (K : Type) [Field K] : ProfiniteGrp :=
-  ProfiniteGrp.of (_root_.Field.absoluteGaloisGroupAbelianization K)
