-    field := closedFixingSubgroup K (SeparableClosure K) E
-    below := fixingSubgroupLeBase K (SeparableClosure K) E
-    normal := inferInstance
-    finite := baseFixingExtensionQuotient_finite
-      K (SeparableClosure K) E }
