-      ((v.valuationAt H' x' : v.valueGroup) : ZHat) := by
-  have hH : H = H' := by
-    cases H
-    cases H'
-    cases hHH'
-    rfl
-  subst H'
-  have hx : x = x' := Subtype.ext hxx'
-  subst x'
-  rfl
