-          · exact hlt _ (Nat.lt_trans (Nat.lt_succ_self _) hn)
-          · rw [w.map_mul, ha, pow_succ]
-            conv_rhs => rw [mul_comm]
-            exact mul_lt_mul_of_pos_of_nonneg le_rfl (hlt m (by omega))
-              ((zero_lt_iff).2 ht) (zero_le : 0 ≤ t ^ m)
