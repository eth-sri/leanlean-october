+    rw [he]
+    exact ENNReal.toReal_mono (measure_ne_top _ _) (quotient_survival_le_escape a K)
+  change ((e-ε/2 : ℚ) : ℝ) ≤ (quotientSurvival a).toReal ∧
+    (quotientSurvival a).toReal ≤ (e : ℝ) ∧ e-(e-ε/2) < ε
