module
public import proofs.HordijkSteelThreshold.BinaryReactionSplit
public import proofs.RAF.Concrete.Closure

/-! Commuting-factor channels and the chemistry-preserving surjection from split positions. -/

@[expose] public section

namespace OverlapCorrectedRAF.Source

open RAF.Polymer RAF.Concrete
variable {n : ℕ} (u v : Molecule n)

/-- The exact order used when `create_XFR` builds its molecule list: shorter
words precede longer words, and equal-length words use binary-code order. -/
abbrev moleculePrecedes : Prop :=
  molLength u < molLength v ∨
    (molLength u = molLength v ∧ u.2.val ≤ v.2.val)

/-- Numeric code of the displayed concatenation `u ++ v`. -/
def displayedConcat : Nat :=
  u.2.val * 2 ^ molLength v + v.2.val

/-- Canonical representative of the repository's displayed-reaction quotient.
Both orientations are retained when `u ++ v` and `v ++ u` differ.  When they
coincide, the repository emits only the orientation whose first factor occurs
first in its molecule list. -/
abbrev RepositoryChannel (n : Nat) :=
  {uv : Molecule n × Molecule n //
    molLength uv.1 + molLength uv.2 ≤ n ∧
      (displayedConcat uv.1 uv.2 ≠ displayedConcat uv.2 uv.1 ∨
        moleculePrecedes uv.1 uv.2)}

/-- The literal reversible reaction system generated by the public repository:
one base reaction per displayed-reaction channel, with catalysis attached to the
base channel and therefore shared by its ligation and cleavage orientations. -/
def repositoryCRS (n t : Nat) :
    ReversibleCRS (Molecule n) (RepositoryChannel n) where
  lhs := fun r => {r.1.1, r.1.2}
  rhs := fun r => {concatMolecule r.1.1 r.1.2 r.2.1}
  food := binaryFood n t

end OverlapCorrectedRAF.Source

namespace RAFReactionQuotient
open Classical RAF.Polymer RAF.Concrete OverlapCorrectedRAF.Source HordijkSteelThreshold RAFCriticalWindowQuantitative
variable {n : ℕ} (u v : Molecule n)

abbrev OrderedChannel (n : ℕ) :=
  {uv : Molecule n × Molecule n // molLength uv.1 + molLength uv.2 ≤ n}

theorem precedes_total :
    moleculePrecedes u v ∨ moleculePrecedes v u := by
  omega

def canonical (r : OrderedChannel n) : RepositoryChannel n :=
  if h : displayedConcat r.val.1 r.val.2 ≠ displayedConcat r.val.2 r.val.1 ∨
      moleculePrecedes r.val.1 r.val.2 then
    ⟨r.val, r.property, h⟩
  else
    ⟨(r.val.2, r.val.1), (Nat.add_comm (molLength r.val.2) (molLength r.val.1)).le.trans r.property,
      Or.inr ((precedes_total r.val.1 r.val.2).resolve_left (fun hp => h (Or.inr hp)))⟩

variable (h : molLength u + molLength v ≤ n)
@[simp] theorem concat_code :
    (concatMolecule u v h).2.val = displayedConcat u v := by
  simp [concatMolecule, moleculeOfCode, concatCode, displayedConcat,
    finProdFinEquiv, Nat.add_comm, Nat.mul_comm]

theorem concat_comm_of_code
    (hc : displayedConcat u v = displayedConcat v u) :
    concatMolecule u v h = concatMolecule v u (by omega) := by
  apply molecule_ext
  · simp [concatMolecule, Nat.add_comm]
  · simpa using hc

variable (r : Reaction n)
def splitToOrdered : OrderedChannel n :=
  ⟨(reactionLeft r, reactionRight r), by
    simp only [molLength_reactionLeft, molLength_reactionRight, reaction_length_add]
    exact Nat.succ_le_of_lt r.1.isLt⟩

theorem split_concat {h : molLength (reactionLeft r)+molLength (reactionRight r) ≤ n} :
    concatMolecule (reactionLeft r) (reactionRight r) h =
      reactionProduct r := by
  apply molecule_ext
  · simp [concatMolecule,reaction_length_add]
  · rw [concat_code]; unfold displayedConcat; rw [molLength_reactionRight]; exact Nat.div_add_mod' ..

def splitToQuotient : RepositoryChannel n :=
  canonical (splitToOrdered r)

theorem split_closure_eq_quotient (t : ℕ)
    (S : Finset (Reaction n)) (k : ℕ) :
    revClosureAt (repositoryCRS n t) (S.image splitToQuotient) k =
      revClosureAt (binaryPolymerCRS n t) S k := by
  let P := repositoryCRS n t
  let Q := binaryPolymerCRS n t
  have sides (r : Reaction n) : P.lhs (splitToQuotient r) = Q.lhs r ∧ P.rhs (splitToQuotient r) = Q.rhs r := by
    unfold splitToQuotient canonical; split <;>
      simp [P,Q,repositoryCRS,binaryPolymerCRS,splitToOrdered,Finset.pair_comm,split_concat];
      grind [concat_comm_of_code,splitToOrdered,split_concat]
  induction k with
  | zero => rfl
  | succ k ih =>
    ext; simp only [revClosureAt,ih,mem_step,Finset.mem_image]; grind


theorem splitToQuotient_surjective (n : ℕ) : Function.Surjective (@splitToQuotient n) := by
  intro j
  obtain ⟨r,hl,hr,_⟩ := source_append_split (moleculeWord j.val.1) (moleculeWord j.val.2) (by simp) (by simp) (by simpa using j.property.1)
  have h : splitToOrdered r = ⟨j.val,j.property.1⟩ := Subtype.ext (Prod.ext (moleculeWord_injective hl) (moleculeWord_injective hr))
  exact ⟨r,by simp [splitToQuotient,h,canonical,dite_eq_left j.property.2]⟩

variable (n L : ℕ) (S : Finset (RepositoryChannel n))
noncomputable def quotientClosure :
    Finset (Molecule n) := Finset.univ.filter
      (fun x => ∃ k, x ∈ revClosureAt (repositoryCRS n L) S k)

end RAFReactionQuotient
