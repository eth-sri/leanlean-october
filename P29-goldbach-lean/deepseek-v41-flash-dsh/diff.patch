+  have h1 : 1 < #S := by omega
+  have h2 : 2 < #S := by omega
+  refine ⟨f ⟨0, h0⟩, f ⟨1, h1⟩, f ⟨2, h2⟩,
+    S.orderEmbOfFin_mem _ _, S.orderEmbOfFin_mem _ _, S.orderEmbOfFin_mem _ _, ?_, ?_, ?_⟩
+  · exact f.strictMono (by simp)
+  · exact f.strictMono (by simp)
