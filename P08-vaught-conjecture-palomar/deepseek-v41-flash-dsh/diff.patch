-      have hψnsupp : sentenceJConsts (L' := L) (J := ℕ) ψ.not ⊆ (↑A : Set ℕ) := by
-        rw [sentenceJConsts_not]; exact (sentenceJConsts_imp_right φ ψ).trans himpsupp
-      exact ⟨pairedInsep_insert_right hSeq hΓfin hΔfin hΓU hΔU hΓS hΔS
