-    t.realize v = (t.toGround).realize (Empty.elim : Empty → M) := by
-  induction t with
-  | var x => rcases x with e | i
-             · exact e.elim
-             · exact i.elim0
-  | func f ts ih => simp only [Term.toGround, Term.realize]; congr 1; funext i; exact ih i
