-  C7_neg_ex : ∀ S ∈ toConsistencyProperty.sets,
-    ∀ (φ : L.Formulaω (Fin 1)),
-      ((φ.relabel (Sum.inr : Fin 1 → Empty ⊕ Fin 1)).ex).not ∈ S →
