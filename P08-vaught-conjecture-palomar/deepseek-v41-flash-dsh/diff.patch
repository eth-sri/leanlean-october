-  C7_quantifier : ∀ S ∈ toConsistencyProperty.sets,
-    ∀ (φ : L.Formulaω (Fin 1)),
-      (φ.relabel (Sum.inr : Fin 1 → Empty ⊕ Fin 1)).ex ∈ S →
-      ∃ (t : L.Term Empty),
-        S ∪ {φ.subst (fun _ => t)} ∈ toConsistencyProperty.sets
-  /-- (C7') Universal instantiation: if ∀x φ(x) ∈ S, then S ∪ {φ(t)} is consistent
