-theorem mem_Sstar_iff (S₀ : SetIn P) {x : L[[ℕ]].Sentenceω} :
-    x ∈ Sstar e S₀ ↔ ∃ n, x ∈ (stage e S₀ n).1 := Set.mem_iUnion
