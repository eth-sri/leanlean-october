-        ↔ @BoundedFormulaω.Realize L[[ℕ]] M (wc base h) Empty 0 ψ Empty.elim Fin.elim0 :=
-    fun ψ => ambient_realize_iff_wc (S := instM) ψ Empty.elim Fin.elim0
