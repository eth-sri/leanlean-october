-/-! ## The simultaneous symbol-generated sublanguage
-
-The schema route needs BOTH symbol sorts countable (its completion enumerates atoms over the
-relation symbols too), while the definitive Morley–Hanf endpoint assumes neither. So alongside
-the function-only sublanguage above, this section cuts BOTH sorts down to the (countable) symbols
-a formula mentions: `relationsIn` + countability, the two-sorted `symbSublang`, its inclusion,
-restriction `restrictSymbols`, and the left-inverse law. -/
-
-/-- The relation symbols occurring in a formula (through all countable connectives). -/
-def BoundedFormulaω.relationsIn {α : Type} :
-    ∀ {n : ℕ}, L.BoundedFormulaω α n → Set (Σ n, L.Relations n)
-  | _, .falsum => ∅
-  | _, .equal _ _ => ∅
-  | _, .rel R _ => {⟨_, R⟩}
-  | _, .imp φ ψ => φ.relationsIn ∪ ψ.relationsIn
-  | _, .all φ => φ.relationsIn
-  | _, .iSup φs => ⋃ i, (φs i).relationsIn
-  | _, .iInf φs => ⋃ i, (φs i).relationsIn
-
-theorem BoundedFormulaω.relationsIn_countable {α : Type} {n : ℕ}
-    (φ : L.BoundedFormulaω α n) : φ.relationsIn.Countable := by
-  induction φ with
-  | falsum => exact Set.countable_empty
-  | equal t u => exact Set.countable_empty
-  | rel R ts => exact Set.countable_singleton _
-  | imp φ ψ ihφ ihψ => exact ihφ.union ihψ
-  | all φ ih => exact ih
-  | iSup φs ih => exact Set.countable_iUnion ih
-  | iInf φs ih => exact Set.countable_iUnion ih
-
-/-- The sublanguage of `L` generated by a set `F` of function symbols AND a set `R` of relation
-symbols, both as subtypes. -/
-def symbSublang (F : Set (Σ n, L.Functions n)) (R : Set (Σ n, L.Relations n)) :
-    Language.{0, 0} where
-  Functions n := {f : L.Functions n // ⟨n, f⟩ ∈ F}
-  Relations n := {r : L.Relations n // ⟨n, r⟩ ∈ R}
-
-/-- The inclusion of the two-sorted generated sublanguage. -/
-def symbSublangIncl (F : Set (Σ n, L.Functions n)) (R : Set (Σ n, L.Relations n)) :
-    symbSublang (L := L) F R →ᴸ L where
-  onFunction := fun {_} f => f.1
-  onRelation := fun {_} r => r.1
-
-/-- Relation-symbol countability of the two-sorted generated sublanguage. -/
-theorem symbSublang_rel_countable (F : Set (Σ n, L.Functions n))
-    {R : Set (Σ n, L.Relations n)} (hR : R.Countable) :
-    Countable (Σ n, (symbSublang (L := L) F R).Relations n) := by
-  have := hR.to_subtype
-  refine Function.Injective.countable
-    (f := fun p : Σ n, (symbSublang (L := L) F R).Relations n =>
-      (⟨⟨p.1, p.2.1⟩, p.2.2⟩ : ↥R)) ?_
-  rintro ⟨n, r, hr⟩ ⟨n', r', hr'⟩ h
-  simp only [Subtype.mk.injEq] at h
-  obtain ⟨rfl, h2⟩ := Sigma.mk.inj_iff.mp h
-  cases eq_of_heq h2
-  rfl
-
-/-- Restrict a term whose function symbols lie in `F` to the two-sorted sublanguage. -/
-def Term.restrictSymbols {α : Type} {F : Set (Σ n, L.Functions n)}
-    (R : Set (Σ n, L.Relations n)) :
-    (t : L.Term α) → t.functionsIn ⊆ F → (symbSublang (L := L) F R).Term α
-  | .var x, _ => .var x
-  | .func f ts, h =>
-    .func ⟨f, h (Set.mem_insert _ _)⟩
-      (fun i => (ts i).restrictSymbols R
-        (fun _ hx => h (Set.mem_insert_of_mem _ (Set.mem_iUnion.mpr ⟨i, hx⟩))))
-
-/-- The inclusion is a left inverse of two-sorted term restriction. -/
-theorem Term.onTerm_restrictSymbols {α : Type} {F : Set (Σ n, L.Functions n)}
-    {R : Set (Σ n, L.Relations n)} :
-    ∀ (t : L.Term α) (h : t.functionsIn ⊆ F),
-      (symbSublangIncl F R).onTerm (t.restrictSymbols R h) = t := by
-  intro t
-  induction t with
-  | var x => intro h; rfl
-  | func f ts ih =>
-    intro h
-    simp only [Term.restrictSymbols, LHom.onTerm]
-    exact congrArg _ (funext fun i => ih i _)
-
-/-- Restrict a formula whose function AND relation symbols lie in `F`/`R` to the two-sorted
-generated sublanguage. -/
-def BoundedFormulaω.restrictSymbols {α : Type} {F : Set (Σ n, L.Functions n)}
-    {R : Set (Σ n, L.Relations n)} :
-    ∀ {n : ℕ} (φ : L.BoundedFormulaω α n), φ.functionsIn ⊆ F → φ.relationsIn ⊆ R →
-      (symbSublang (L := L) F R).BoundedFormulaω α n
-  | _, .falsum, _, _ => .falsum
-  | _, .equal t u, hF, _ =>
-    .equal (t.restrictSymbols R fun _ hx => hF (Set.mem_union_left _ hx))
-      (u.restrictSymbols R fun _ hx => hF (Set.mem_union_right _ hx))
-  | _, .rel Rl ts, hF, hR =>
-    .rel ⟨Rl, hR (Set.mem_singleton _)⟩
-      (fun i => (ts i).restrictSymbols R fun _ hx => hF (Set.mem_iUnion.mpr ⟨i, hx⟩))
-  | _, .imp φ ψ, hF, hR =>
-    .imp (φ.restrictSymbols (fun _ hx => hF (Set.mem_union_left _ hx))
-        (fun _ hx => hR (Set.mem_union_left _ hx)))
-      (ψ.restrictSymbols (fun _ hx => hF (Set.mem_union_right _ hx))
-        (fun _ hx => hR (Set.mem_union_right _ hx)))
-  | _, .all φ, hF, hR => .all (φ.restrictSymbols hF hR)
-  | _, .iSup φs, hF, hR =>
-    .iSup fun i => (φs i).restrictSymbols (fun _ hx => hF (Set.mem_iUnion.mpr ⟨i, hx⟩))
-      (fun _ hx => hR (Set.mem_iUnion.mpr ⟨i, hx⟩))
-  | _, .iInf φs, hF, hR =>
-    .iInf fun i => (φs i).restrictSymbols (fun _ hx => hF (Set.mem_iUnion.mpr ⟨i, hx⟩))
-      (fun _ hx => hR (Set.mem_iUnion.mpr ⟨i, hx⟩))
-
-/-- The inclusion is a left inverse of two-sorted formula restriction. -/
-theorem BoundedFormulaω.mapLanguage_restrictSymbols {α : Type} {F : Set (Σ n, L.Functions n)}
-    {R : Set (Σ n, L.Relations n)} :
-    ∀ {n : ℕ} (φ : L.BoundedFormulaω α n) (hF : φ.functionsIn ⊆ F) (hR : φ.relationsIn ⊆ R),
-      (φ.restrictSymbols hF hR).mapLanguage (symbSublangIncl F R) = φ := by
-  intro n φ
-  induction φ with
-  | falsum => intro hF hR; rfl
-  | equal t u =>
-    intro hF hR
-    simp only [BoundedFormulaω.restrictSymbols, BoundedFormulaω.mapLanguage]
-    exact congrArg₂ _ (Term.onTerm_restrictSymbols _ _) (Term.onTerm_restrictSymbols _ _)
-  | rel R ts =>
-    intro hF hR
-    simp only [BoundedFormulaω.restrictSymbols, BoundedFormulaω.mapLanguage]
