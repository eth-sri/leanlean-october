-
-theorem isOpenMap_prependWord (w : List Bool) : IsOpenMap (prependWord w) := by
-  rw [(PiNat.isTopologicalBasis_cylinders (fun _ : ℕ => Bool)).isOpenMap_iff]
-  rintro s ⟨x, n, rfl⟩
