-/-- Helper: `snoc Fin.elim0 x` evaluated at `0 : Fin 1` gives `x`. -/
-lemma snoc_elim0_zero_eq {M : Type*} (x : M) :
-    (Fin.snoc (α := fun _ => M) Fin.elim0 x) (0 : Fin 1) = x :=
-  congrFun (Fin.snoc_elim0_eq x) 0
