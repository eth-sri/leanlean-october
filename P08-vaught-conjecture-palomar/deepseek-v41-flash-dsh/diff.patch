-    have hsnoc : ∀ b : N, (Fin.snoc (⇑f ∘ a) (f b) : Fin (m + 1) → M) = ⇑f ∘ Fin.snoc a b :=
-      fun b => (Fin.comp_snoc ⇑f a b).symm
