-theorem reindex_exs (c : IndexCoding ι κ) :
-    ∀ {n} (φ : L.BoundedFormulaInf ι α n), reindex c φ.exs = (reindex c φ).exs
-  | 0, _ => rfl
-  | _ + 1, φ => by
-    rw [show (φ.exs : L.FormulaInf ι α) = φ.ex.exs from rfl, reindex_exs c φ.ex, reindex_ex]
-    rfl
