-    intro x₁ x₂ c; rw [ext₁_emb]; exact (hagree c).symm
-  have hq₁vis : extVisibilityReplace q₁ 3 3 = q₁ := by
-    have := hq.orderly (cell₂ a₁X); dsimp only at this; rw [grade_a₁] at this; exact this.symm
-  have hq₂vis : extVisibilityReplace q₂ 3 3 = q₂ := by
-    have := hq.orderly (cell₂ a₂X); dsimp only at this; rw [grade_a₂] at this; exact this.symm
-  by_cases hI : pb = qb ∧ qb ≤ γ
