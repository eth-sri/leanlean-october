-/-- **Left/right witness relation symbols are disjoint.** -/
-theorem leftRels_inter_rightRels : leftRels L ∩ rightRels L = ∅ :=
-  range_tag_disjoint fun _ _ _ h => Sum.inl_ne_inr (Sum.inr_injective h)
-
-end FirstOrder.Language
