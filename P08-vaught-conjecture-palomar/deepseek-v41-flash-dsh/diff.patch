-  set base := (L.lhomWithConstants ℕ).reduct M with hbase
-  set h := ambientConstMap (L := L) M with hh
-  -- Bridge each sentence's ambient realization to the controlled `wc base h`.
-  have bridge : ∀ (ψ : L[[ℕ]].Sentenceω),
