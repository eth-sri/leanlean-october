-  | _, .iSup φs, h =>
-    .iSup fun i => (φs i).restrictFuns fun _ hx => h (Set.mem_iUnion.mpr ⟨i, hx⟩)
-  | _, .iInf φs, h =>
-    .iInf fun i => (φs i).restrictFuns fun _ hx => h (Set.mem_iUnion.mpr ⟨i, hx⟩)
