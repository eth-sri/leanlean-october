-    ∀ (φ : L.Formulaω (Fin 1)),
-      ((φ.relabel (Sum.inr : Fin 1 → Empty ⊕ Fin 1)).all).not ∈ S →
-      ∃ (t : L.Term Empty),
-        S ∪ {(φ.subst (fun _ => t)).not} ∈ toConsistencyProperty.sets
