-theorem realize_constEq (M : Type) [S : L[[ℕ]].Structure M] (a b : ℕ) :
-    Sentenceω.Realize (constEq (L := L) a b) M ↔ cval (L := L) M a = cval (L := L) M b := by
-  rw [constEq]; exact BoundedFormulaω.realize_equal (M := M) (constTermS a) (constTermS b)
