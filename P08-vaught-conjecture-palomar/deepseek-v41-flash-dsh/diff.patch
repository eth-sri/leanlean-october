-        t₀_F_s1] at h1
-      change min (p (cell₁ (.inl Prop3.s1))) pb = min (σ v₀) (g 1) at h1
-      have h2 := heqq (.inl Prop3.s1)
-      rw [rowX_b₁_inl, t₀_F_s1] at h2
-      change min (q (cell₂ (.inl Prop3.s1))) qb = min (σq v₀) (gq 1) at h2
