-/-- **The limit is Henkin-complete.** -/
-theorem henkinComplete_Sstar : HenkinComplete U (Sstar e S₀) where
-  subset_U := Sstar_subset_U e S₀
-  no_falsum := by
-    intro hf
-    obtain ⟨n, hn⟩ := (mem_Sstar_iff e S₀).mp hf
