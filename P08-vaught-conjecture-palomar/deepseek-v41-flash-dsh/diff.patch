-      have hinfsupp : sentenceJConsts (L' := L) (J := ℕ) (BoundedFormulaω.iInf φs) ⊆ (↑A : Set ℕ) := by
-        rw [← sentenceJConsts_not]; exact support_mem_left hΓ hsupp
-      have hns : sentenceJConsts (L' := L) (J := ℕ) (φs k).not ⊆ (↑A : Set ℕ) := by
