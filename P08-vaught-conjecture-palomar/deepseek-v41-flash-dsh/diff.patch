-theorem entails_constEq_symm {Γ : Set L[[ℕ]].Sentenceω} {a b : ℕ}
-    (hmem : constEq (L := L) a b ∈ Γ) : Theoryω.Entails Γ (constEq (L := L) b a) := by
-  intro M _ _ hmodel
