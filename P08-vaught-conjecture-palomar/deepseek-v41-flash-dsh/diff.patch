-/-- Collapse a sentence-atomic term (variables in the uninhabited `Empty ⊕ Fin 0`) to a closed
-`Term Empty`. -/
-def Term.toGround : L[[ℕ]].Term (Empty ⊕ Fin 0) → L[[ℕ]].Term Empty
-  | .var x => match x with
-    | Sum.inl e => Empty.elim e
-    | Sum.inr i => i.elim0
-  | .func f ts => .func f (fun i => (ts i).toGround)
