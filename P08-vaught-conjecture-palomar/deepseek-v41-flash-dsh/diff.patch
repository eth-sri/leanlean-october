-  rw [ambient_realize_iff_wc (S := S) (instConst c φ) Empty.elim Fin.elim0, realize_instConst,
-    ambient_realize_iff_wc (S := S) φ Empty.elim (fun _ => ambientConstMap (L := L) M c)]
