--/
-module
-
-public import InfinitaryLogic.Methods.LopezEscobar.FunctionalTheta
-public import InfinitaryLogic.Methods.LanguageMapOccurrence
-public import InfinitaryLogic.Methods.LopezEscobar.RelationalizeSpike
