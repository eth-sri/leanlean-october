@@ -142,74 +142,3 @@ theorem realize_relabel_insertLastBound_zero {n : ℕ} (φ : L.Formulaω (Fin (n
     (φ.relabel insertLastBound).Realize v xs ↔ φ.Realize (snoc v (xs 0)) := by
   have h := realize_relabel_insertLastBound (k := 0) φ v xs
