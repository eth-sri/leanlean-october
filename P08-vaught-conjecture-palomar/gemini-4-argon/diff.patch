-theorem strip_val_le {m c : ExtOrd} (hc : SelfVis 2 c) (hmc : m ≤ c) (j : ℕ) :
-    extVisibilityReplace m 2 (min j 2) ≤ c :=
-  (evr_arg_mono m (min_le_right j 2)).trans ((R₂_mono hmc).trans (R₂_of_selfVis hc).le)
