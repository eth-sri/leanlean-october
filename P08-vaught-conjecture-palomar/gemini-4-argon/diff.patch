-  /-- The threshold. -/
-  N : ℕ
-  /-- The cap cell, of grade `N`. -/
-  cap : D
-  cap_grade : grade cap = N
-  /-- The trigger cell. -/
-  trigger : D
-  /-- The marker cell. -/
-  marker : D
-  marker_grade_le : grade marker ≤ N
-  /-- The requested top cells. -/
-  tops : List D
-  top_grade_le : ∀ y ∈ tops, grade y ≤ N
