-/-- The element of Cantor space that starts with the finite word `w` and continues with `x`. -/
-def prependWord (w : List Bool) (x : ℕ → Bool) : ℕ → Bool := fun n =>
-  if n < w.length then w.getD n false else x (n - w.length)
