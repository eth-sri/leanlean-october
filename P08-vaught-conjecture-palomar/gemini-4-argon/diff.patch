-/-- Lawfulness test: block implications and an exhaustive full-row order query. -/
-def Respect (T : Data Y C) (r : Y → ℕ) : Prop :=
-  T.Blocks r ∧ ∃ c, (∀ d e, T.source c d ≤ T.source c e → r d ≤ r e) ∧
-    (∀ d, T.source c d = 0 → r d = 0)
