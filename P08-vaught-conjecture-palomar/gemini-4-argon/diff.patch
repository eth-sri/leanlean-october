-in its own universe; only the summands move. -/
-theorem sum_le_of_countable_lift {ι : Type u} [Countable ι] {f : ι → Cardinal.{v}}
-    {κ : Cardinal.{max u v}} (hκ : Cardinal.aleph0 ≤ κ)
