-def Blocks (T : Data Y C) (r : Y → ℕ) : Prop :=
-  ∀ t ∈ T.blocks, (r t.2.1 = 0 ∨ r t.1 = 0) → (r t.2.2 = 0 ∨ r t.1 = 0)
