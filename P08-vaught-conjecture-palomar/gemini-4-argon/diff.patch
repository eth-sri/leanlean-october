-  | _, _, .falsum => True
-  | _, _, .equal _ _ => True
-  | _, _, .rel _ _ => True
-  | _, s, .imp φ ψ => universalSigned (!s) φ ∧ universalSigned s ψ
-  | _, s, .all φ => s = true ∧ universalSigned s φ
-  | _, s, .iSup φs => ∀ i, universalSigned s (φs i)
-  | _, s, .iInf φs => ∀ i, universalSigned s (φs i)
