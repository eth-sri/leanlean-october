-    ∃ α : Ordinal.{0}, a = ofOrd α ∧ ωn 1 ≤ α ∧ α < ωn 2 := by
-  rcases ExtOrd.cases a with rfl | rfl | ⟨α, rfl⟩
-  · exact absurd h1 (not_ofOrd_le_bot _)
-  · exact absurd h2 (not_lt.mpr le_top)
-  · exact ⟨α, rfl, ofOrd_le_ofOrd.mp h1, ofOrd_lt_ofOrd.mp h2⟩
