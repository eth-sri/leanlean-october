-@[simp] theorem universalSigned_imp {n : ℕ} (s : Bool) (φ ψ : L.BoundedFormulaω α n) :
-    universalSigned s (φ.imp ψ) ↔ universalSigned (!s) φ ∧ universalSigned s ψ := Iff.rfl
