-local notation "BRows" =>
-  GrowthReplicatedRows.rows (GrowthPaddedIteration.build I X T hA hB hC t ht)
-
-/-! ## The ledger -/
-
-end Fixed
-
-end
-end VaughtConjecture.Knight.GrowthMixedGradeOneLedger
