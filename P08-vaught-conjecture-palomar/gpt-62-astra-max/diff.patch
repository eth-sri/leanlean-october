-    (BoundedFormulaω.rel R (fun i => (a i).relabel (Sum.inl : Empty → Empty ⊕ Fin 0)) ∈ S) =
-    (BoundedFormulaω.rel R (fun i => (b i).relabel (Sum.inl : Empty → Empty ⊕ Fin 0)) ∈ S) := by
