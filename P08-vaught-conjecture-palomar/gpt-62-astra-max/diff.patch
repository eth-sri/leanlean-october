-/-- A cell of graded index `(univ, 1)` is a level-one cell. -/
-theorem Family.exists_S₁_of_cellX {w : F.X} (h : F.cellX w = (Finset.univ, 1)) :
-    ∃ H : ↥F.S₁, w = .inr (.inl H) := by
