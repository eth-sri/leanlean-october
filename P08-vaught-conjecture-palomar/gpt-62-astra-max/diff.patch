-lemma stages_refines (hUo : ∀ k, IsOpen (U k)) (hUd : ∀ k, Dense (U k))
-    (m : ℕ) (l : List Bool) (b : Bool) (hl : l.length = m) :
-    Refines ((stages U hUo hUd (m + 1)).f (b :: l)) ((stages U hUo hUd m).f l) :=
