-        refine ⟨cell₁ b₁X₁, Subtype.ext ?_⟩
-        rw [embBelow₁_cell₁, embX₁_b₁]
-        change family₂.e b₁X = d.1
-        rw [hd]
-        have e : a = ⟨b₁, Finset.mem_insert_of_mem (Finset.mem_insert_of_mem
