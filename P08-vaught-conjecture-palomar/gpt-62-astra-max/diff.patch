-        · simp only [hjk, ite_true, Nat.lt_succ_of_lt hjk]
-        · have hjk1 : ¬(j.val < k + 1) := by omega
-          simp only [hjk, ite_false, hjk1]
-    rw [hupdate] at step
-    exact (termEquiv_equivalence C S hmax).trans step_k step
