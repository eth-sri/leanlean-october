-    · exact absurd h' (by simp [embX₁])
-    · exact absurd h' (by simp [embX₁])
-    · have hb : b.1 = a := by
-        have := congrArg (fun z : family₂.X => match z with
-          | .inr (.inr (.inr d)) => d.1 | _ => a) h'
-        exact this
-      have hb1 : b.1 = b₁ := Finset.mem_singleton.mp b.2
-      exact hab (hb.symm.trans hb1)
