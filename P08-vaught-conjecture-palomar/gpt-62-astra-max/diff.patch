-theorem truth_both (hsc : HenkinComplete U S) :
-    (σ : L[[ℕ]].Sentenceω) →
-      (σ ∈ S → @Sentenceω.Realize L[[ℕ]] σ (QModel hsc) (qModelStructure hsc)) ∧
-      (σ.not ∈ S → ¬ @Sentenceω.Realize L[[ℕ]] σ (QModel hsc) (qModelStructure hsc))
