-theorem toLow2_embX₀ (y : family₀.X) : family₂.toLow2 (embX₀ y) = family₀.toLow2 y := by
-  rcases y with c | H | s | a
-  · rfl
-  · rfl
-  · rfl
-  · simp only [embX₀, Family.toLow2]; rw [s₀_eq₂, s₀_eq₀]
