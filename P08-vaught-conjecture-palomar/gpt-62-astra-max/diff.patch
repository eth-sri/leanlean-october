-variable (U) in
-/-- The full tower of stages, with each level refining the previous one. -/
-noncomputable def stages (hUo : ∀ k, IsOpen (U k)) (hUd : ∀ k, Dense (U k)) :
-    ∀ m, Stage U m
-  | 0 => base U
-  | m + 1 => Classical.choose (exists_step hUo hUd (stages hUo hUd m))
