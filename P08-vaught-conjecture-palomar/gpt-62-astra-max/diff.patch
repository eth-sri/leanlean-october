-  cases x with
-  | request => dsimp only [newIndex]; decide
-  | ladder b _ => cases b <;> dsimp only [newIndex] <;> decide
-  | upper b _ _ => cases b <;> dsimp only [newIndex] <;> decide
-  | apex => dsimp only [newIndex]; decide
