-theorem toLow3_embX₀ (y : family₀.X) : family₂.toLow3 (embX₀ y) = family₀.toLow3 y := by
-  rcases y with c | H | s | a <;> rfl
-theorem toLow3_embX₁ (y : family₁.X) : family₂.toLow3 (embX₁ y) = family₁.toLow3 y := by
-  rcases y with c | H | s | a <;> rfl
