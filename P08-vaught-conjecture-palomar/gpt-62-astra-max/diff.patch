-    hw hq (fun d => d.2.2) hρ hδvis hγb hγδ hroom hρh.ge
-    (fun d => hwcap' d.1)
-  · intro d
-    exact (hretune _ (source_short sem hA hproper a d.1)).trans
-      ((min_eq_left (hbound _)).trans (hambient d))
