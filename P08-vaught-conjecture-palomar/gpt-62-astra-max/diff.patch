-    ∃ (a : Profile sem) (τ : ExtOrd → ExtOrd) (h : ExtOrd),
-      Witness (gTop 3) τ ∧ (∀ x, τ x ≤ γ) ∧
-      τ (ceiling (D := D)) = γ ∧
-      h ∈ grid (D := D) ∧ SelfVis 3 h ∧ ⊥ < h ∧
-      h ≤ ceiling (D := D) ∧ τ h = γ ∧
-      (∀ z ∈ grid (D := D), z < h → τ z < γ) ∧
-      (∀ x : target sem hA,
-        τ (source sem hA hp a x.1) = min (q x) γ) ∧
