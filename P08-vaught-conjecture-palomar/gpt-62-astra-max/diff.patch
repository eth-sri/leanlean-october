-        rw [D₂_scope_castAdd, hcon.2]
-      have hs' : D₂.scope Sig ⊆ Finset.univ.image Fin.castSuccEmb := by rw [← hsc]; exact hs
-      have hSs : D₂.scope Sig = Finset.univ.image Fin.castSuccEmb :=
-        scope_eq_of_grade_three (by decide) hs' hg3
