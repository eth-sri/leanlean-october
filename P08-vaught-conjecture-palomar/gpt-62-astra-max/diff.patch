-def PCMem (g : L →ᴸ L') (Θ : L'.Sentenceω) (M : Type*) [L.Structure M] : Prop :=
-  ∃ S' : L'.Structure M, @LHom.IsExpansionOn L L' g M _ S' ∧ @Sentenceω.Realize L' Θ M S'
