-      have hSx : (S (res x n).length).f (res x n) = (S n).f (res x n) := by rw [hlen]
-      have hdepth : n ≤ (w (res x n)).2 := by
-        simp only [hw]
-        rw [hSx]
-        exact (S n).le_depth (res x n) hlen
