-    (hS : Admitted X j S)
-    {u : C.scheme.below (Finset.univ, j) → ExtOrd}
-    {v : P.scheme.below (Finset.univ, j) → ExtOrd}
-    (hu : RespectsSemanticsBelow C.rows (Finset.univ, j) u)
-    (hv : RespectsSemanticsBelow P.rows (Finset.univ, j) v)
