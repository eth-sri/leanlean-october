+      · rw [hσ'free a ha hla]; exact hσ'high_ge b hb
+      · have hlb : ¬ σ₁ b < ofOrd lam := fun hlb => hla ((hσ₁mono hab).trans_lt hlb)
+        rw [hσ'band a ha hla, hσ'band b hb hlb]
+        exact bandMap_mono_of_le hlam K (not_lt.mp hla) (hσ₁mono hab)
