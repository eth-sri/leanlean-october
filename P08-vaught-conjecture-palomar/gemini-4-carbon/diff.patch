-    (S : Finset Ordinal.{0}) (hS : ∀ μ ∈ S, limitPart μ = μ)
-    (hle : ∀ μ ∈ S, μ ≤ α)
-    (ref : Ordinal.{0} → DA.below (DA.cell req.C))
-    (off : Ordinal.{0} → ℕ) (hoff : ∀ μ ∈ S, off μ < req.N)
-    (href : ∀ μ ∈ S, τ (e (ref μ)) = ofOrd (μ + off μ))
-    {P : Cell DQ → ExtOrd} (hP : RespectsSemantics semQ P)
