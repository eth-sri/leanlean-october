-        I.leftPlan_le I.rightPlan_le d.1 with ⟨c, hc⟩ | ⟨c, hc⟩
-    · have hg : I.left.scheme.grade c ≤ j := by
-        have hi := d.2.2
-        rw [← hc] at hi
-        exact (congrArg Prod.snd (I.leftFace.index c)).ge.trans hi
