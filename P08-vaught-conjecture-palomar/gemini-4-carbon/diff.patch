-    (i : (W.reduct (blockStage_mono h)).Iso (V.reduct (blockStage_mono h)))
-    (j : (V.reduct (blockStage_mono h)).Iso (Z.reduct (blockStage_mono h))) :
-    liftReductIso h hW hZ (i.trans j) =
