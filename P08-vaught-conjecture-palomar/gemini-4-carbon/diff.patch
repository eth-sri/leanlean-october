-    Finset ExtOrd → ExtOrd → Cell carrier → ExtOrd
-  birth : ∀ {j : ℕ} (_hj : k ≤ j) (S : State I.left I.right)
-    (_hS : F.Admissible j S) (_hp : ∀ d, S.profile d ≠ ⊤), F.Anchor 1
-  birth_ranks : ∀ {j} (hj : k ≤ j) (S) (hS) (hp) d,
