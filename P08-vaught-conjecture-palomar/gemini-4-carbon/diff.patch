-          ∃ (c : Cell Q.scheme.scheme), Q.scheme.scheme.scope c = Finset.univ ∧
-            Q.label c = ⊤ ∧ L < Q.scheme.scheme.grade c ∧ i < Q.scheme.scheme.grade c ∧
-            ∃ hab : GradedLe (Q.scheme.scheme.cell (mapCell hf a)) (Q.scheme.scheme.cell c),
