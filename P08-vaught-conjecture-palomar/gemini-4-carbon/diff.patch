-variable {ιA ιQ : Type*} [DecidableEq ιA] [DecidableEq ιQ]
-  {A : Finset ιA} {Q : Finset ιQ} {DA : CellScheme A} {DQ : CellScheme Q}
-  {semA : Semantics DA} {semQ : Semantics DQ}
-  (X : RelativeData DA semA DQ semQ)
