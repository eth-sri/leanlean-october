-  have hμ : BoundedMap 1 μ := ReceivingCutDecoder.extend_bounded _ hτ hγ
-  have hμread (d) : μ (p' d) = p d := by
-    apply AlignedCutEncoding.decode_encode s p hτ.mono hroom hτcut.ge
-    intro e
-    have hh := hτread (.inl e.1)
