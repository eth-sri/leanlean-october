-    (d : Cell (scheme D Q n (Nat.le_of_succ_le hn))) :
-    (scheme D Q (n + 1) hn).cell (step D Q n hn d) =
-      (scheme D Q n (Nat.le_of_succ_le hn)).cell d :=
-  SourceLayerCarrier.cell_toCell _ _ _ _ _ (.inl d)
-
