+def privateIncl (d : I.right.scheme.below (Finset.univ, 1)) : I.boundary.below (A, 1) :=
+  ⟨I.rightFace.map d.1, I.boundary.isPlan.subset_of_mem (I.boundary.scope_mem_plan _),
