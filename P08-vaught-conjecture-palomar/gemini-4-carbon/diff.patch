+      rcases P.cases d.1 with ⟨b, hb⟩ | ⟨_, hg, _⟩
+      · exact ⟨⟨b, by simpa only [hb, P.base_index] using d.2⟩, Subtype.ext hb.symm⟩
+      · have := d.2.2; change 2 ≤ (P.carrier.cell d.1).2 at hg; omega⟩
