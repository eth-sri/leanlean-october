-theorem source_ceiling (a : F.Anchor 2) :
-    source I F hroot hA hB hC a (leaf I F hroot hA hB hC a) =
-      RecursiveRungRendering.ceiling (Field I.left I.right) 2 :=
-  (input I F hroot hA hB hC).source_parent a
