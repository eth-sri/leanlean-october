+  classical
+  constructor
+  · intro h
+    by_cases hy : y ∈ Set.range g
+    · obtain ⟨c, rfl⟩ := hy
+      rw [right_shared] at h
+      exact ⟨c, (Sum.inl.inj h).symm, rfl⟩
+    · rw [right, dite_eq_right hy] at h
+      cases h
+  · rintro ⟨c, rfl, rfl⟩
+    exact (right_shared f g c).symm
