-def Catalogue : Set (TField P C → ExtOrd) :=
-  {a | a ∈ CanonicalPairedProfiles.inventory (TField P C) j ∧
-    ∃ S : R.TState j, L.TAdmissible S ∧ Synchronized S.st ∧ S.profile = a}
