-theorem transformsTo_const_of_ne_bot {D : Type*} {grade : D → ℕ} (hK : ∀ d, grade d ≤ 1)
-    {p : D → ExtOrd} (hp : ∀ d, p d ≠ ⊥) {w : ExtOrd} (hw : SelfVis 1 w) :
