-    (hproper : ∀ d, P d ≠ ⊤ → P d < ofOrd (α + req.R))
-    {root top : Finset ιQ × ℕ}
-    (root_mem : root ∈ Plan.gradedPlan DQ.plan) (top_mem : top ∈ Plan.gradedPlan DQ.plan)
