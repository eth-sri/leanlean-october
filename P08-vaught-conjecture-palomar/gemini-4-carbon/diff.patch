-  -- 2. High-grade dominance at `γ = A₀ < B` over the lifted tuple.
-  obtain ⟨y, hy, q, ⟨Sig, hgrade, hlab⟩, -, hq⟩ :=
-    hR'.highGradeDominance e p hpe A₀.1 hlt
-  -- 3. Reduce the witness: the proper target-high label truncates to `⊤`.
