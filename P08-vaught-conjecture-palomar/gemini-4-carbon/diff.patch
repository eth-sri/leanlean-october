-def leafOccurrence (a : Q) : (carrier D hA (X := X) (Q := Q)).below (A, 1) :=
-  ⟨added D hA (SupportLadderRows.leaf (Nat.succ_pos _) a), by
-    rw [added_index]; exact GradedLe.refl _⟩
-
