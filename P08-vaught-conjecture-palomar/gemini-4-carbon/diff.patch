-/-- The tower's lower sets. -/
-local notation "Tbelow" => CellScheme.below (tower sem₀ I M P hAk)
-/-- The member row of a level-two member. -/
-local notation "MROW" => memberRow sem₀ I M P hAk hI hproper
-
-end VaughtConjecture.Knight
