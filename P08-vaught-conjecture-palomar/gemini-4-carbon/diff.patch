+def render (p : Cell D → ExtOrd) : Cell (carrier D K l hKl hlA) → ExtOrd :=
+  fun d => Sum.elim p (fun _ => ⊥) (toOcc D Unit l (MaximalFullLayer.positive K l hKl) hlA d)
