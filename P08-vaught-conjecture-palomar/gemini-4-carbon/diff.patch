+theorem lift_iff {I J : Finset ι × ℕ} (h : GradedLe I J) (hJ : J.2 ≤ k) :
+    CappedLift (rows D k sem) h ↔ CappedLift sem h := by
+  let eI := belowEquiv D k I (h.2.trans hJ)
