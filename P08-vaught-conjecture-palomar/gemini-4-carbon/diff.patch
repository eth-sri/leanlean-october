-variable (hp : RespectsSemanticsBelow (rows I X T hA hB hC) (A, 2) p) {a : Catalogue X 1}
-  {τ : ExtOrd → ExtOrd} (hτ : Witness (gTop 1) τ)
-
-include hp hτ
-
-end Admission
