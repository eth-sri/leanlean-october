-    (hready : Ready sem hp n (Nat.le_of_succ_le hA))
-    (hLc : n + 4 ≤ L.card) (hRc : n + 4 ≤ R.card)
-    (hcomplete : ∀ C ∈ D.plan, C ≠ A → n + 4 ≤ C.card →
