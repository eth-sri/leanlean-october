+private theorem typeMap_of_pointImage_face {α : Ordinal.{0}} {m n : ℕ}
+    (t : S α n) (p : S α m) (f : Fin m ↪ Fin n) {B : Finset (Fin n)}
+    (hB : Finset.univ.image f = B)
