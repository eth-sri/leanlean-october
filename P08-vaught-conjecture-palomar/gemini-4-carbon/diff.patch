-    (n : ℕ) (hn : n ≤ A.card) (d : Cell (scheme sem n hn)) :
-    ¬ GradedLe (A, n + 1) ((scheme sem n hn).cell d) :=
-  RecursiveSourceCarrier.separated D (Profile sem) hp n hn d
