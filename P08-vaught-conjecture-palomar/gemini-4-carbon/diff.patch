-    Origin I X T hA hB hC t ht (owner I X T hA hB hC t ht a) where
-  birth := t
-  birth_le := le_rfl
-  height := ht
-  member := a
-  map := id
-  order := strictMono_id
-  index _ := rfl
-  base _ := rfl
-  occurrence := rfl
-  domain := Equiv.refl _
-  domain_val _ := rfl
