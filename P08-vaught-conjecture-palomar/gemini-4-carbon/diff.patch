-    (one_le hA) (GradeCutBoundary.proper D 2 hp) 2 (GradeCutBoundary.grade_bound D 2)
-    (by decide) hA (by decide) (cut_lawful sem hK hpr)
-    (fun d => ht (GradeCutBoundary.toCell D 2 d)) G C
