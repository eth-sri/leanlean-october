-section State
-variable {S : State I.right.scheme I.left.scheme} (hS : Admitted X X.req.N S)
-  (hprof : ∀ f, S.profile f = min
-    (shadowSup I X T hA hB hC t ht U hU hm j hj hj0 p f)
-    (gradeMax I X T hA hB hC t ht U j p X.req.N))
-
