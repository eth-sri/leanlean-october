-theorem provisional_le_of_lawful_lift (p : S α n) (hα : Order.IsSuccLimit α)
-    (hαβ : α ≤ β) (v : Cell p.scheme.scheme → ExtOrd)
-    (hbound : ∀ d, v d < ofOrd β ∨ v d = ⊤)
