-    {p : I.right.scheme.below (effC n 2) → ExtOrd}
-    {u : (carrier I F hroot hA hB hC).below (A, 2) → ExtOrd}
-    (hp : RespectsSemanticsBelow I.right.rows (effC n 2) p)
-    (hu : RespectsSemanticsBelow (rows I F hroot hA hB hC) (A, 2) u)
-    {M : ExtOrd} (hM : SelfVis 2 M)
-    (hread : ∀ d, u (privateAt I F hroot hA hB hC d) = min (p d) M)
-    (hbound : ∀ d, u d ≤ M)
