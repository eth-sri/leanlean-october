+  simp only [erase, old, Equiv.symm_apply_apply]
+
+@[simp] theorem erase_added (p : Copy D B C) : erase D B C (added D B C p) = p.1.2 := by
+  simp only [erase, added, Equiv.symm_apply_apply]
