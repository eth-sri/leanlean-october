-
-variable {M : Type w}
-
-/-- Injective tuples on a countable carrier are countable. -/
-instance countable_emb [Countable M] (n : ℕ) : Countable (Fin n ↪ M) :=
-  Function.Injective.countable (f := fun f : Fin n ↪ M => (f : Fin n → M))
-    DFunLike.coe_injective
