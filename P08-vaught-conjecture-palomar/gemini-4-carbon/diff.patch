-    change min x₁ x₂ = min (σ η₁) (min (g 3) x₂)
-    rw [← min_assoc, mw.hx₁, min_eq_left mw.x₁_le_x₂]
-  · have hd : d.1 = family₂.e a₂X := congrArg Subtype.val hc
-    rw [hc, ext₁_a₂, hd, Equiv.symm_apply_apply, rowX_a₂_a₂, grade_e₂]
