+theorem profile_normalize (j : ℕ) (S : State DA DQ) (f : Field DA DQ) :
+    (S.normalize j).profile f = PairedSlotEncoding.normalize j S.profile f :=
+  (profile_map _ S f).trans (PairedSlotIncoming.encoder_profile j S.profile f)
