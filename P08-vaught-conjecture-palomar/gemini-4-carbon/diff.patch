-premise only asserts presence; absent future fields use the shadow theorem. -/
-theorem row_original (d : Cell I.boundary)
-    (hd : GradedLe (I.boundary.cell d) (A, O.birth + 2)) :
-    (build I X T hA hB hC t ht).rows.E c
