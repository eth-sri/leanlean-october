-    (a : Profile sem n)
-    {p : Cell D → ExtOrd}
-    (hpr : RespectsSemanticsBelow sem (A, (n + 4)) (fun d => p d.1)) (ht : ∀ d, p d ≠ ⊤)
-    {B : ℕ} (hB : B ≤ 2 * Fintype.card (Cell D) + 1)
