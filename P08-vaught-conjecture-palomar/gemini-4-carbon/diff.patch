-def faceEquiv (J : Finset ι × ℕ) (hJ : ¬ A ⊆ J.1) (hj : J.2 ≤ 3) :
-    (cut (D := D)).below J ≃ (carrier sem hA).below J :=
-  (GradeCutBoundary.belowEquiv D 3 J hj).trans
-    (CanonicalRecursiveBoundaryTransport.properEquiv sem 0 hA J hJ)
