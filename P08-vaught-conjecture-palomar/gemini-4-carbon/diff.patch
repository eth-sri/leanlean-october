-      (GradeCutBoundary.grade_bound D 2) (by decide) hA (by decide)
-      (cut_lawful sem hK hpr) (fun d => ht (GradeCutBoundary.toCell D 2 d)) hG hC
-    have hs := (GradeCutPairRows.lower_respects_iff D _ _ 1 2 (by decide)
