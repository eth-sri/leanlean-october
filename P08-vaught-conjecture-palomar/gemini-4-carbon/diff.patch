-
-variable {ι : Type*} [DecidableEq ι] {A B C : Finset ι}
-  {R : Finset (Finset ι)} {m n : ℕ}
-  (I : WholeDonorBoundary.Input A B C R m n n) (F : LowOnly.Family I.left I.right 1)
