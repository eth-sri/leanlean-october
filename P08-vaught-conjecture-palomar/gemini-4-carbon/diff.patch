-    (carrier I X T hA hB hC).below (A, 2) :=
-  ⟨original I X T hA hB hC (I.leftFace.map d.1), by
-    rw [original_index]
-    refine ⟨I.boundary.isPlan.subset_of_mem (I.boundary.scope_mem_plan _), ?_⟩
