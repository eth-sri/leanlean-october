-theorem later_chart (t : ℕ) (ht : t + 2 ≤ A.card) (r : ℕ)
-    (hr : t + r + 2 ≤ A.card) {j : ℕ} (hj : t + r + 2 ≤ j)
-    (S : State I.left I.right) (hS : F.Admissible j S) (hp : ∀ f, S.profile f ≠ ⊤)
