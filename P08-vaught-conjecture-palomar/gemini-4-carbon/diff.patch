-  have ha : (⟨S.profile, hcanon, S, hS, rfl⟩ : F.Anchor 2) = a := Subtype.ext he
-  have hdonor (d : I.left.scheme.below (effC n 2)) :
-      source I F hroot hA hB hC a (donorAt I F hroot hA hB hC d).1 = S.lowerP 2 d := by
