+theorem old_index (d : Cell D) : (scheme D B C).cell (old D B C d) = D.cell d := by
+  change (scheme D B C).cell (Fin.castAdd (Fintype.card (Copy D B C)) d) = D.cell d
+  unfold scheme; simp only [Fin.addCases_left]
