-/-- Realizations admitting an actual model expansion on the same carrier. -/
-abbrev Domain (h : σ ≤ ρ) (M : Type w) :=
-  {R : KnightRealization (blockStage σ) M //
-    R.ProlongsToOnIn IsModelClass (blockStage_mono h)}
