+    {p : X → ExtOrd} {q : Y → ExtOrd} {x : ExtOrd}
+    (hx : Supported K G q x) (hG : ∀ z ∈ G, SelfVis K z)
+    (hq : ∀ d, Supported K G p (q d)) : Supported K G p x := by
+  rcases hx with hx | hx | ⟨d, i, hi, rfl⟩
+  · exact Or.inl hx
+  · exact Or.inr (Or.inl hx)
+  · exact (hq d).replace hG hi
