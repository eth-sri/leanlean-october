-  obtain ⟨b, σ, hσ, hread⟩ := native_top_chart I hA hB hC t F hroot ht hq ⟨_, hg, hc⟩
-  have hv (e : I.right.scheme.below (effC n (t + 2))) :
-      σ ((state F b).v e.1) = q (originalAt I F hroot hA hB hC t ht (privateIncl I e)) := by
