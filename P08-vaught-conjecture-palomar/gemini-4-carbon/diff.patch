+theorem map_respects_of_short_or_reflecting {ι : Type*} [DecidableEq ι] {A : Finset ι}
+    {D : CellScheme A} {sem : Semantics D} {BJ : Finset ι × ℕ} {r : D.below BJ → ExtOrd}
