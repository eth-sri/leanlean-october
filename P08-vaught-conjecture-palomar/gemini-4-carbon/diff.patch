-      RelativeLadderLayer.renderWith I.boundary (by omega : 0 < A.card)
-        (field I) (F.fields 1) (birth hj S hS hp) S.profile H d
-  lawful : ∀ {j} (hj : k ≤ j) (S) (hS) (hp) {G H},
-    (∀ z ∈ G, SelfVis k z) → SelfVis k H → (∀ d, S.profile d ≤ H) →
