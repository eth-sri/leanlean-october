+        (P.carrier.cell (P.baseMap x.1)).1 ⊆ (P.carrier.cell (P.baseMap y.1)).1
+      rw [P.base_index, P.base_index])
+    (fun c d _ => (P.base_row c.1 d).symm) p
+end
