-    have h := hu.mono (show GradedLe (A, 1) (A, 2) from
-      ⟨Finset.Subset.refl _, by omega⟩)
-    simpa only [u₁, e, Function.comp_def, Equiv.apply_symm_apply,
-      lowerIncl, CellScheme.below.mono] using h
