+  · rcases Finset.mem_union.mp hmem with hmem | hmem
+    · exact Or.inl (Plan.mem_gradedPlan.mpr ⟨hmem, hpos, hcard⟩)
+    · exact Or.inr (Plan.mem_gradedPlan.mpr ⟨hmem, hpos, hcard⟩)
+  · exact False.elim (hB (Finset.mem_singleton.mp hmem))
+
