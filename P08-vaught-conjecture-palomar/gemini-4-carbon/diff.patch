-  by_cases hd : D.grade d ≤ j
-  · let e : D.below (A, j) := ⟨d, D.isPlan.subset_of_mem (D.scope_mem_plan d), hd⟩
-    rw [complete_present u p e]
-    exact h e
-  · rw [complete_future u p d (not_le.mp hd)]
-end Complete
