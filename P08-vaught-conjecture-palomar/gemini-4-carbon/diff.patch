+              le_antisymm (bandMap_mono_of_le hlam K hgk hlt.le) hak
+            have hcap : ofOrd (lam + K) ≤ g₁ k := cap_of_bandMap_eq_of_lt hlam K hgk hlt heqB
+            have hcapa : ofOrd (lam + K) ≤ σ₁ a := hcap.trans hlt.le
