-      (p (privateAt I X T hA hB hC t ht U j hCU X.req.C (cap_grade_le I X j hN))) := by
-    rw [← hc]
-    have ho := (hS.private_lawful.orderly (Growth.capAt X le_rfl X.req.capCell)).symm
