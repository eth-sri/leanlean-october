-    Cell (scheme D Q m hm) ↪o Cell (scheme D Q (m + t) h)
-  | 0, _ => OrderEmbedding.ofStrictMono id strictMono_id
-  | t + 1, h => (embed m hm t (by omega)).trans (step D Q (m + t) h)
