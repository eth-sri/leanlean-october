-      (LowOnlyPaddedStepRows.old P (by omega)
-        (belowEquiv I F hroot hA hB hC t ht (A, t + 2) le_rfl r (by omega) d).1)) = _
-    rw [LowOnlyPaddedStepRows.source_old]
-    exact congrArg δ (hd d)
