-  have ha : Agree (fun d : D.below (A, k) => master F weight p d.1)
-      (fun d : D.below (A, k) => master F weight q d.1)
-      (cut F.grid (F.boundary p) (F.boundary q)) :=
-    fun d => master_agreement F weight p q d.1 d.2.2
