-    apply eq_of_reduct_eq_of_le ρ σ h _ _ (hW.map e) hV
-    rw [Realization.reduct_map]
-    exact he.map_eq
-  rw [← hWV]
-  exact fun {n} t => Realization.isIso_map e W (n := n) t
