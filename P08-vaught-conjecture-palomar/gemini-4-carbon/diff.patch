+      simp only [Fin.addCases_right]
+      let p := (Fintype.equivFin (Copy D B C)).symm i
+      exact Plan.mem_gradedPlan.mpr ⟨p.1.1.2, D.grade_pos _, p.2.2.2.2⟩
