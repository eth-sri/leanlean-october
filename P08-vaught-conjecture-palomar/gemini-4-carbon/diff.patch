-/-- The same chart for a later raw source, before its final decoder. -/
-theorem source_chart (t : ℕ) (ht : t + 2 ≤ A.card) (r : ℕ)
-    (hr : t + r + 2 ≤ A.card) (b : F.Anchor (t + r + 2)) :
