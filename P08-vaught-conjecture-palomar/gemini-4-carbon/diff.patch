-theorem full_grade (hk : 1 ≤ k) (d : Cell P.carrier) (hd : P.carrier.scope d = A) :
-    P.carrier.grade d ≤ k := by
-  rcases P.cases d with ⟨c, rfl⟩ | ⟨_, _, hg⟩
