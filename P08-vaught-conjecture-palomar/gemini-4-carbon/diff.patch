-    · intro d
-      change truncExt α (u d) ≤ truncExt α (u (apex I F))
-      rw [htop, truncExt_id_of_bound (Or.inr rfl)]
-      exact le_top
-
-end
-end VaughtConjecture.Knight.CoatomSeedInstallation
