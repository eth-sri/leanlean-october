-    (by simpa only [hheight] using hrootcap) hZ hFenc
-    (by simpa only [hheight] using hFlt)
-    (fun y hy => (congrArg B.code (hT y hy)).trans (hBtop.trans hheight.symm))
-
-end
-end VaughtConjecture.Knight.GrowthFiniteCapTemplate
