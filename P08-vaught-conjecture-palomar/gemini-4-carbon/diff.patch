+    (e₀ : Fin a ↪ ι) (he₀ : Finset.univ.image e₀ = V) (hV : V ⊆ A)
+    (G : ExactSemanticFace (PointImageSemantics.rows O.scheme e₀ he₀ O.rows) P.rows) (j : ℕ)
