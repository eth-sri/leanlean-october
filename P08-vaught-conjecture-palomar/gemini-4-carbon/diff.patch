+  obtain ⟨x, rfl⟩ := (enumeration D Unit l (MaximalFullLayer.positive K l hKl) hlA).surjective d
+  rcases x with c | ⟨⟩; exact Or.inl ⟨c, rfl⟩; exact Or.inr rfl
