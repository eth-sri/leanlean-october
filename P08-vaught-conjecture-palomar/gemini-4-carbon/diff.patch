+theorem render_old (p : Cell D → ExtOrd) (d : Cell D) :
+    render D K l hKl hlA p (old D K l hKl hlA d) = p d := by
+  simp only [render, old, MaximalFullLayer.old, toOcc_toCell, Sum.elim_inl]
