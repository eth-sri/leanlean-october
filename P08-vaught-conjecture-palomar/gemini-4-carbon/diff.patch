+    (hcommon : Plan.restrictPlan Q (B ∩ C) = Plan.restrictPlan R (B ∩ C)) :
+    Plan.restrictPlan (Q ∪ R ∪ {A}) B = Q := by
+  ext S
+  simp only [Plan.restrictPlan, Finset.mem_inter, Finset.mem_union,
+    Finset.mem_singleton, Finset.mem_powerset]
