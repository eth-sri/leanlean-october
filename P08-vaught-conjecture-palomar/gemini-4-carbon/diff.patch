-      (hmax _ ((donor_grade I F hroot hA hB hC c).trans hg))
-  have hchart (d) : min (σ (source I F hroot hA hB hC a d.1)) γ = min (q d) γ := by
-    rw [hread, min_assoc, min_eq_right hreach]
-  obtain ⟨S, hS, he⟩ := a.property.2
