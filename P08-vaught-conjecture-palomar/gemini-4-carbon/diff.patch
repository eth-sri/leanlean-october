+    (hBA : B ⊆ A) : restrictPlan (restrictPlan P A) B = restrictPlan P B := by
+  ext S
+  simp only [restrictPlan, Finset.mem_inter, Finset.mem_powerset]
+  exact ⟨fun h => ⟨h.1.1, h.2⟩, fun h => ⟨⟨h.1, h.2.trans hBA⟩, h.2⟩⟩
