+    (c : Cell D) (hc : D.scope c = A) (hg : D.grade c ≤ U.card) : Cell (scheme D B C) := by
+  classical
+  exact if h : U = A then old D B C c else added D B C ⟨(⟨U, hU⟩, c), h, hm.resolve_left h, hc, hg⟩
