-/-! ## Uncapped recognition of the complete shadow vector -/
-
-section Chart
-
-variable {a : Catalogue X 1} {τ : ExtOrd → ExtOrd} (hτ : Witness (gTop 1) τ)
-
-include hτ
-
-end Chart
