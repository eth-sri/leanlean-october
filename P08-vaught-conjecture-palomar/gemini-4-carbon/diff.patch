-  have hpos : H ≠ ⊥ := fun hz => hcap (le_bot_iff.mp (hbound.trans_eq hz))
-  have hpriv := private_capped I X T hA hB hC t ht U j hCU hU hm hj hj0 hjt
-    hsmall hN hS he hp
-  have hdon := donor_capped I X T hA hB hC t ht U j hBU hU hm hj hj0 hjt
-    hsmall hN he hp
