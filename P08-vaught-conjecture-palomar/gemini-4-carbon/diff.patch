-    (c := ⟨Θ, GradedLe.refl _⟩) (fun d => d.2.2) hvis (hσr.locality Θ)
-  have hτa : τ (q.scheme.rows.E Θ ⟨mapCell hpq Xi, hXi'⟩) = ofOrd (α.1 + j) := by
