+    {p : Cell D → ExtOrd} (hp : ∀ d, Supported k G v (p d))
+    (d : Cell (carrier D K l hKl hlA)) : Supported k G v (render D K l hKl hlA p d) := by
+  rcases covered D K l hKl hlA d with ⟨c, rfl⟩ | rfl
+  · rw [render_old]; exact hp c
