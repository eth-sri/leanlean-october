+theorem map_respects_of_bottom_reflection {ι : Type*} [DecidableEq ι] {A : Finset ι}
+    {D : CellScheme A} {sem : Semantics D} {BJ : Finset ι × ℕ} {r : D.below BJ → ExtOrd}
