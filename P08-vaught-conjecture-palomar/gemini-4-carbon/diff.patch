-  let φ : L.Formulaω (Fin 1) :=
-    BoundedFormulaω.equal
-      (Term.func f (fun j =>
-        if j = i then Term.var (Sum.inl (0 : Fin 1))
-        else (args j).relabel (Sum.inl ∘ Empty.elim)))
-      (Term.func f (fun j => (args j).relabel (Sum.inl ∘ Empty.elim)))
