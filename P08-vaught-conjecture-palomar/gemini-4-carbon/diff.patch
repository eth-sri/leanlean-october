+          · have h5 := hσ₁5 a k hle i hik
+            have hla' : ¬ σ₁ (extVisibilityReplace a k i) < ofOrd lam := by
+              rw [h5]
+              rcases ExtOrd.cases (σ₁ a) with hb | ht | ⟨ν, hν⟩
