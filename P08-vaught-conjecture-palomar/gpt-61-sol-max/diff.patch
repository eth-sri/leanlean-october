-theorem embBelow₁_cell₁ (y : family₁.X) : embBelow₁ (cell₁ y) = cell₂ (embX₁ y) := by
-  apply Subtype.ext
-  change family₂.e (embX₁ (family₁.e.symm (family₁.e y))) = family₂.e (embX₁ y)
-  rw [Equiv.symm_apply_apply]
