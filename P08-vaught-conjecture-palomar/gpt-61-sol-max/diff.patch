-    {R₂ : T.Realization (sched 0) N} (h : Nonempty (R.Iso R₂)) :
-    HasFailure C sched hmono R ↔ HasFailure C sched hmono R₂ :=
-  h.elim fun i => IsIso.hasFailure_iff i.2
