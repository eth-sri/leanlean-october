-
-@[expose] public section
-
-universe u v u' uι uκ uμ w
-
-namespace FirstOrder
-
-namespace Language
-
-variable {L : Language.{u, v}} {ι : Type uι} {κ : Type uκ} {μ : Type uμ} {α : Type u'} {n : ℕ}
-
