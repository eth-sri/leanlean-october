-/-- Add `φ` to the `Δ`-coordinate of a paired family member. -/
-theorem pairedInsep_insert_right {S Γ Δ : Set L[[ℕ]].Sentenceω} {A : Finset ℕ}
-    {φ : L[[ℕ]].Sentenceω} (hSeq : S = Γ ∪ Δ)
