-  (∀ d, SelfVis 1 (p d)) ∧
-  (∀ c, TransformsTo (fun _ : Occ X => 1) (row E c)
-    (fun d => min (p d) (p (controller c)))) ∧
-  ∀ d, ∃ c, p d ≤ p (controller c)
