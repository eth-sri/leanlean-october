-theorem q_a₁_le_b₁ {q : C₂.below (Finset.univ, 3) → ExtOrd}
-    (hq : RespectsSemanticsBelow family₂.rows (Finset.univ, 3) q) :
-    q (cell₂ a₁X) ≤ q (cell₂ b₁X) :=
-  probe_diag₂ hq a₁X b₁X (Finset.Subset.refl _) le_rfl (by rw [rowX_a₁_b₁, rowX_a₁_a₁])
