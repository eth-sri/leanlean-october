-/-- The full-scope grade-one cells of `family₀` are all the same cell. -/
-theorem S₁cell_eq (H H' : ↥family₀.S₁) : H = H' :=
-  Subtype.ext ((mem_S₁_eq H.2).trans (mem_S₁_eq H'.2).symm)
