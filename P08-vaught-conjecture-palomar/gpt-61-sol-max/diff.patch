-    · exact Or.inr fun h => hyA (h.mpr (hGH (mk_mem_prod hx₁G hy)))
-  exact not_isMeagre_of_isOpen hH ⟨p₀.2, hyH⟩ (((hsec x₁).union hx₁).mono hHsub)
