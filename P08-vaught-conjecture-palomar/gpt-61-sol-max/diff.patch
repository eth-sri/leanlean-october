-        lift_mk_umax.{w, max u v}.symm
-    _ ≤ Cardinal.mk (tvSlice A Y n) :=
-        (Cardinal.mk_range_le_lift (f := tvSliceWitness A Y n)).trans_eq (Cardinal.lift_id' _)
