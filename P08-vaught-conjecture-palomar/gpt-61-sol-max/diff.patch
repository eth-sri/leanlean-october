diff --git a/InfinitaryLogic/Methods/LocalTower.lean b/InfinitaryLogic/Methods/LocalTower.lean
deleted file mode 100644
index 32fddef38..000000000
--- a/InfinitaryLogic/Methods/LocalTower.lean
