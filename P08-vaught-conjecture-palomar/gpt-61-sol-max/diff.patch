-    (h : C₂.cell Xi' = C₁.cell i) (hk : C₁.grade i ≤ 2 ∨ C₁.scope i ≠ Finset.univ) :
-    ∃ i' : Cell C₁, emb₁ i' = Xi' ∧ C₁.cell i' = C₁.cell i := by
-  rw [Family.cell_eq] at h
-  rcases hw : family₂.e.symm Xi' with c | H | s | a
