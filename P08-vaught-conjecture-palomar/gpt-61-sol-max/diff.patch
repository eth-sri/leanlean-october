-  | equal t₁ t₂ => simp only [BoundedFormulaω.castLE, BoundedFormulaω.functionsIn,
-      Term.functionsIn_relabel]
-  | rel R ts => simp only [BoundedFormulaω.castLE, BoundedFormulaω.functionsIn,
