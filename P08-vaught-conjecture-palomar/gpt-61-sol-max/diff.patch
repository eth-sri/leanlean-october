-theorem Term.functionsIn_relabel (g : α → β) (t : L.Term α) :
-    (t.relabel g).functionsIn = t.functionsIn := by
-  induction t with
-  | var x => rfl
-  | func f ts ih => simp only [Term.relabel, Term.functionsIn, ih]
