-theorem fresh_right {Γ Δ : Set L[[ℕ]].Sentenceω} {A : Finset ℕ} (c : ℕ) (hc : c ∉ (↑A : Set ℕ))
-    (hsupp : ((⋃ γ ∈ Γ, sentenceJConsts (L' := L) (J := ℕ) γ) ∪
