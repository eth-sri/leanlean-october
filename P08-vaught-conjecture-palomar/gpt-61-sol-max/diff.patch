-    have hpow : Cardinal.mk (Fin n → Y) = Cardinal.mk Y ^ (n : Cardinal) := by
-      rw [Cardinal.mk_arrow, Cardinal.mk_fin, Cardinal.lift_natCast, Cardinal.lift_uzero]
