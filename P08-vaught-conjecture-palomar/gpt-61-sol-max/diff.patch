-theorem valuesAt_mono {F : P → ExtOrd} {l l' : ℕ} (h : l ≤ l') :
-    valuesAt gradeP F l ⊆ valuesAt gradeP F l' := by
-  intro v hv
-  obtain ⟨c, hc, hFc⟩ := (mem_valuesAt gradeP).mp hv
