-theorem embX₁_b₁ : embX₁ b₁X₁ = b₁X := rfl
-theorem embX₁_H₀ : embX₁ H₀X₁ = H₀X := rfl
-theorem embX₁_s₀ : embX₁ s₀X₁ = s₀X := rfl
