-  have h1 : ofOrd (ωn 1) ≤ a := (ofOrd_le_ofOrd.mpr (by
-    change Ordinal.omega0 * ((1 : ℕ) : Ordinal) ≤ Ordinal.omega0 * ((2 : ℕ) : Ordinal)
-    exact mul_le_mul_right (Nat.cast_le.mpr (by decide)) _)).trans h
