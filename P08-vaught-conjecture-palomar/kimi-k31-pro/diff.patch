-theorem lt_of_keyOrd_one_lt {u u' : Ordinal.{0}} (hu : 1 ≤ finitePart u) (hu' : 1 ≤ finitePart u')
-    (h : keyOrd 1 u < keyOrd 1 u') : u < u' := by
-  have hne : u ≠ u' := by rintro rfl; exact lt_irrefl _ h
