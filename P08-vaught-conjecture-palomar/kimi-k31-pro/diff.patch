-        _ = Cardinal.continuum := Cardinal.aleph0_mul_eq Cardinal.aleph0_le_continuum
-    · -- Lower bound
-      rcases hc with hcA | ⟨n₀, hn₀⟩
-      · show Cardinal.continuum ≤ #(AllCodedIsoClasses φ)
