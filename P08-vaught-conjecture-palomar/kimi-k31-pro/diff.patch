-    j ∉ sentenceJConsts (L' := L) (J := ℕ) (genEx j ρ) := by
-  rw [genEx]
-  intro hmem
-  rw [sentenceJConsts_ex] at hmem
-  have h2 : sentenceJConsts (L' := L) (J := ℕ)
