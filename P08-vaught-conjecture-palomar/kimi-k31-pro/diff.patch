-    roundDown l I x ∈ alph l I ∧ SelfVis l (roundDown l I x) ∧ roundDown l I x ≤ x := by
-  classical
-  have h := Finset.max'_mem ((alph l I).filter fun a => SelfVis l a ∧ a ≤ x)
-    ⟨⊥, Finset.mem_filter.mpr ⟨bot_mem_alph l I, selfVis_bot l, bot_le⟩⟩
