-  insert ⊥ ((Finset.univ : Finset (Fin I × Fin (l + 2))).image
-    fun ij => ofOrd (Ordinal.omega0 * ((ij.1 : ℕ) : Ordinal) + ((ij.2 : ℕ) : Ordinal)))
