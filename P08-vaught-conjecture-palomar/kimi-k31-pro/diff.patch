-noncomputable def psi (κ : Ordinal.{0}) : Ordinal.{0} :=
-  if finitePart κ = 0 then Ordinal.omega0 * (blockOfKey 2 S₂ κ : ℕ)
-  else Ordinal.omega0 * (blockOfKey 2 S₂ (keyOrd 2 κ) : ℕ) + 2
