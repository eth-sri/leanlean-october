-@[simp] theorem realize_mF {α : Type} (t : (MidLang L).Term α) (v : α → M) :
-    (mF L t).realize v = fMap L M (t.realize v) :=
-  realize_app1 _ t v
-
-@[simp] theorem realize_mG {α : Type} (t : (MidLang L).Term α) (v : α → M) :
-    (mG L t).realize v = gMap L M (t.realize v) :=
-  realize_app1 _ t v
