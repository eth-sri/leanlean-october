-  congr 1
-  show n + (i : ℕ) - n = (i : ℕ)
-  omega
-
-/-! ### The standard model satisfies Θ -/
-
-theorem standardMid_models
-    (hbranch : ∀ n : ℕ,
-      ((fun i : Fin n => queryCode c (i : ℕ)), (fun i : Fin n => g (i : ℕ))) ∈ T n) :
