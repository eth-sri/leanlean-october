-    have hmin : min (finitePart u) 2 = 2 := min_eq_right h2
-    rw [hmin]
-    unfold psi
-    rw [if_neg (by omega)]
-    unfold blockOf
-    rw [keyOrd_one_of_ge_two (by rw [finitePart_mul_add])]
-    norm_cast
