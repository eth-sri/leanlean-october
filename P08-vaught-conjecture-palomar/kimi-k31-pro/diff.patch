-theorem mycielskiCantorHypothesis_holds : MycielskiCantorHypothesis := by
-  intro E hE
-  obtain ⟨ψ, hψ_cont, hψ_anti⟩ := mycielski_cantor hE
-  exact ⟨ψ, hψ_cont, fun a b hab => hψ_anti a b hab⟩
