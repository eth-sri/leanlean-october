-    intro γ hγ
-    have hg : @BoundedFormulaω.Realize L[[ℕ]] M (wc base h) Empty 0 γ Empty.elim Fin.elim0 :=
-      (bridge _).mp (hmodel _ (Set.mem_insert_of_mem _ hγ))
-    have hcongr : ∀ k ∈ sentenceJConsts (L' := L) (J := ℕ) γ, h k = Function.update h j x k := by
-      intro k hk
