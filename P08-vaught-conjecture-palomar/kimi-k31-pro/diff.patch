-/-- Two constant maps agreeing on a term's constant support give the term the same value. -/
-theorem Term.realize_congr_const (base : L.Structure M) {h h' : ℕ → M} {n : ℕ}
-    (t : L[[ℕ]].Term (α ⊕ Fin n))
