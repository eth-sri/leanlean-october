-            Empty.elim xs := by
-  intro n φ
-  induction φ with
-  | falsum => intro xs; exact Iff.rfl
-  | equal t u =>
-    intro xs
-    show @Term.realize L[[ℕ]] M (wc base h) _ _ (t.abstractConst j)
