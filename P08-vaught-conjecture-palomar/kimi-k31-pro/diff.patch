-theorem exists_model_of_henkinComplete (hsc : HenkinComplete U S) :
-    ∃ (M : Type) (_ : L[[ℕ]].Structure M) (_ : Nonempty M),
-      (∀ φ : L[[ℕ]].Sentenceω, φ ∈ S → Sentenceω.Realize φ M) ∧
