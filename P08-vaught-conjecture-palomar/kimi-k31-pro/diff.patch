-    rw [hmin]
-    unfold psi
-    rw [if_pos (finitePart_limitPart u)]
-    unfold blockOf
-    rw [keyOrd_two_of_le (by omega)]
-    rw [keyOrd_one_of_eq_one (by rw [finitePart_mul_add])]
-    rw [limitPart_mul_add]
