-/-- **The substitution round-trip**: for `c` fresh for `ψ`, `genEx c (instConst c ψ)` realizes
-exactly as `ψ.ex`. -/
-theorem realize_genEx_instConst (base : L.Structure M) (h : ℕ → M) (c : ℕ)
-    (ψ : L[[ℕ]].BoundedFormulaω Empty 1)
