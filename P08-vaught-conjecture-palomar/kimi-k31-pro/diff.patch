-noncomputable def addFullSem : Semantics (addFull D₀ level hlevel) where
-  E := rowFun hlevel hproper sem₀ newRow
-  orderly Sig := by
-    rcases cases hlevel Sig with ⟨i, rfl⟩ | ⟨j, rfl⟩
