-/-- Encode a node so that a proper prefix becomes *larger* than its extensions: append `⊤`. -/
-def kbEncode (x : List ℕ) : List ℕ∞ := x.map (fun a : ℕ => (a : ℕ∞)) ++ [⊤]
 
-theorem kbEncode_injective : Function.Injective kbEncode := by
-  intro x y h
