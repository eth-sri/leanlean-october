-/-- **The grade-one key of `φ u` is `ψ` of the grade-one key of `u`** (for `fp u ≥ 1`). -/
-theorem key_code_eq_psi {u : Ordinal.{0}} (hu : 1 ≤ finitePart u) :
-    keyOrd 1 (code 2 S₂ u) = psi S₂ (keyOrd 1 u) := by
-  unfold code
