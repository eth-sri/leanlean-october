-/-- The fragment's setting for the proper part, at any alphabet bound `T ≥ 8`. -/
-theorem setting {T : ℕ} (hT : 8 ≤ T) : Setting gradeP T :=
-  ⟨gradeP_pos, by rw [card_eq]; omega⟩
