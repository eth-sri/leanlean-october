-  have hle : GradedLe (family₁.scheme.cell (family₁.e y)) (family₁.scheme.cell (family₁.e x)) := by
-    rw [Family.cell_e, Family.cell_e]; exact ⟨hs, hgr⟩
-  have h := hp.ge_of_row_eq_diag (cell₁ x) ⟨family₁.e y, hle⟩ ?_ ?_
