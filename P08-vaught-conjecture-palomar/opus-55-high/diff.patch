-    intro hagree v xs
-    exact exists_congr fun i => ih i (fun k hk => hagree k (sentenceJConsts_component_iSup _ i hk)) v xs
-  | iInf φs ih =>
-    intro hagree v xs
-    exact forall_congr' fun i => ih i (fun k hk => hagree k (sentenceJConsts_component_iInf _ i hk)) v xs
