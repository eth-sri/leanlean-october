-    refine Finset.mem_image.mpr ⟨ofOrd v, Finset.mem_filter.mpr ⟨Finset.mem_image.mpr
-      ⟨c, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hc⟩, hF⟩, ofOrd_ne_bot v, ofOrd_ne_top v⟩, rfl⟩
