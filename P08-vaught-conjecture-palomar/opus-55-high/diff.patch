-theorem witnessRow_ofOrd {F : P → ExtOrd} {l : ℕ} {S : Finset Ordinal.{0}} {c : P}
-    (hc : gradeP c ≤ l) {α : Ordinal.{0}} (hF : F c = ofOrd α) :
