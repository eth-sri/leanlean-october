-/-- An old cell. -/
-def old (i : Cell D₀) : Cell (addFull D₀ level hlevel) := Fin.castAdd N i
-
-/-- A new cell. -/
-def new (j : Fin N) : Cell (addFull D₀ level hlevel) := Fin.natAdd D₀.card j
