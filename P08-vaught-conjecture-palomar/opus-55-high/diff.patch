-theorem S₃₁_sub {a : CappedCore3 Prop3.gradeP T₀} (h : a ∈ family₁.S₃) : a ∈ family₂.S₃ := by
-  have h' : a ∈ ({b₁} : Finset (CappedCore3 Prop3.gradeP T₀)) := h
-  rw [Finset.mem_singleton.mp h']
