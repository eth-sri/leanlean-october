-      = Cardinal.lift.{w} (Cardinal.mk A.toSet) := lift_mk_umax
-  have hYlift : Cardinal.lift.{max u v w} (Cardinal.mk Y)
-      = Cardinal.lift.{max u v} (Cardinal.mk Y) := lift_mk_umax
