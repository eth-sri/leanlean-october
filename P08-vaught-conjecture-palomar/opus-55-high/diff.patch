-  rintro (c | ⟨H, hH⟩ | ⟨s, hs⟩ | ⟨a, ha⟩) (c' | ⟨H', hH'⟩ | ⟨s', hs'⟩ | ⟨a', ha'⟩) h
-  all_goals simp only [embX₁, Sum.inl.injEq, Sum.inr.injEq, Subtype.mk.injEq, reduceCtorEq] at h
-  all_goals first | (subst h; rfl) | (cases h; rfl)
