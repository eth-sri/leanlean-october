-    · have hφsupp : sentenceJConsts (L' := L) (J := ℕ) φ ⊆ (↑A : Set ℕ) := by
-        rw [← sentenceJConsts_not, ← sentenceJConsts_not]; exact support_mem_right hΔ hsupp
-      exact pairedInsep_insert_right hSeq hΓfin hΔfin hΓU hΔU hΓS hΔS
