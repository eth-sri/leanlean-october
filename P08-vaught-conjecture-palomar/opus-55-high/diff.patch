-  probe_diag₁ hp b₁X₁ s₀X₁ (Finset.Subset.refl _) (by change (2 : ℕ) ≤ 3; decide)
-    (by rw [rowX₁_eq, rowX₁_eq, embX₁_b₁, embX₁_s₀, rowX_b₁_s, rowX_b₁_b₁])
