-structure Family where
-  v : ExtOrd
-  v_ne : v ≠ ⊥
-  v_vis : SelfVis 1 v
-  v_coded : IsCodedLabel 1 v
-  S₁ : Finset (Row1 Prop3.gradeP T)
-  S₂ : Finset (Core2 (gradeP := Prop3.gradeP) (T := T))
