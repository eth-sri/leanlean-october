-/-- Literal old rows with no enlarged domain. -/
-noncomputable def inheritedRow (sem : Semantics C) (c : Cell C)
-    (d : (D).below ((D).cell (old C hC c))) : ExtOrd :=
-  sem.E c (oldArg C hC c d)
