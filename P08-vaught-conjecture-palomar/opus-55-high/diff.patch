-      (fun d => F ⟨d.1, (d.2.2 : D₀.grade d.1 ≤ D₀.grade y.1).trans y.2⟩)
-      ⟨y.1, GradedLe.refl _⟩ (fun d => d.2.2) (fun d => h.orderly _) (h.locality y) y.2
