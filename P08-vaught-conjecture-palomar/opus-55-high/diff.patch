-section Completion
-
-variable {s₀ : LocalStage} {M : Type} [(localColim s₀).Structure M] [LinearOrder M]
-  [WellFoundedLT M]
-
-variable (hM : Cardinal.beth (Ordinal.omega 1) ≤ Cardinal.mk M)
-
-end Completion
