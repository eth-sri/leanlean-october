-    obtain ⟨Xi, hXi, hle⟩ := h.availability ⟨Sig.1, Sig.2.trans hjk⟩ ⟨Xi₀.1, Xi₀.2.trans hjk⟩ hs hg
-    refine ⟨⟨Xi.1, ?_⟩, hXi, hle⟩
-    unfold CellScheme.grade
-    rw [hXi]
-    exact Xi₀.2
