-  · exact Option.some_injective _ h ▸ hq.imp_right
-  · exact Option.some_injective _ h ▸ hq.all_body
-  · exact Option.some_injective _ h ▸ hq.iInf_comp _
-  · exact Option.some_injective _ h ▸ hq.iSup_comp _
-  · simp at h
-
