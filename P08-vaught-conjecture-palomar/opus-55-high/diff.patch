-
-section CanonDeFormWitness
-
-variable {M : Type} [(localColim s₀).Structure M] [LinearOrder M]
-  [WellFoundedLT M] (hM : Cardinal.beth (Ordinal.omega 1) ≤ Cardinal.mk M)
-
-end CanonDeFormWitness
-
-end FirstOrder.Language
