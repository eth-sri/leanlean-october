-  induction l₁ generalizing p with
-  | nil => rfl
-  | cons c l ih =>
-    show (componentStep p c).bind (componentPath · (l ++ l₂))
-      = ((componentStep p c).bind (componentPath · l)).bind (componentPath · l₂)
-    cases componentStep p c with
-    | none => rfl
-    | some q => exact ih q
-
