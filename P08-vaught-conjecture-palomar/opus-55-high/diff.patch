-/-- Antitone probe in input B's family. -/
-theorem probe_diag₁ {p : C₁.below (Finset.univ, 3) → ExtOrd}
-    (hp : RespectsSemanticsBelow family₁.rows (Finset.univ, 3) p) (x y : family₁.X)
-    (hs : (family₁.cellX y).1 ⊆ (family₁.cellX x).1)
