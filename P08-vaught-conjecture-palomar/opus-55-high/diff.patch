-theorem not_emb₁_a (i : Cell C₁) : emb₁ i ≠ (cell₂ a₁X).1 ∧ emb₁ i ≠ (cell₂ a₂X).1 := by
-  have key : ∀ (a : CappedCore3 Prop3.gradeP T₀) (ha : a ∈ family₂.S₃), a ≠ b₁ →
