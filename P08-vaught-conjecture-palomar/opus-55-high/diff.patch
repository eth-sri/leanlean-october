-/-- Every proper face avoids `3` or avoids `0`. -/
-theorem proper_side : ∀ C ∈ plan₄, C ≠ Finset.univ → (3 : Fin 4) ∉ C ∨ (0 : Fin 4) ∉ C := by
-  decide
