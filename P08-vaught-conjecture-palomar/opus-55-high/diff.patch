-    (hcount : CountableRefinementHypothesis.{u, v, w} L)
-    (M : Type w) [L.Structure M] [Countable M] :
-    StabilizesCompletely (L := L) M (scottHeight (L := L) M) := by
-  obtain ⟨α, _, hstab⟩ := exists_complete_stabilization_of hcount M
