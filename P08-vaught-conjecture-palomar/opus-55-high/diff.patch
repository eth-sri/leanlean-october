-    have himg : D V = Prod.fst '' (Cᶜ ∩ univ ×ˢ V) := by
-      ext x
-      simp only [hD, mem_ofPred_eq, mem_image, mem_inter_iff, mem_prod, mem_univ, true_and]
-      constructor
-      · rintro ⟨y, hyV, hyC⟩
-        exact ⟨(x, y), ⟨hyC, hyV⟩, rfl⟩
-      · rintro ⟨⟨x', y⟩, ⟨hyC, hyV⟩, rfl⟩
-        exact ⟨y, hyV, hyC⟩
