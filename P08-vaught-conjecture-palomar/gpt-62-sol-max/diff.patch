+    OrbitPrefixSupport.Supported k (I.grid : Set ExtOrd) (I.fields a) (I.source a d) := by
+  rcases I.cell_cases d with ⟨x, rfl⟩ | ⟨b, rfl⟩
+  · rw [I.source_old]; exact hl a x
+  · rw [I.source_new]; exact Or.inr (Or.inl (cut_mem I.bot_mem _ _))
