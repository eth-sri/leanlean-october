-/-- Every cell of the three-cell family is an image of input B, or `a₁`, or `a₂`. -/
-theorem cases₂' (d : C₂.below (Finset.univ, 3)) :
-    (∃ c : C₁.below (Finset.univ, 3), embBelow₁ c = d) ∨ d = cell₂ a₁X ∨ d = cell₂ a₂X := by
-  by_cases h3 : C₂.grade d.1 ≤ 2
