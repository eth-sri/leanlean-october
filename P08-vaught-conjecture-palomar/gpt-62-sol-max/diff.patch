-noncomputable def total {B : Finset ι} {D : CellScheme B} (sem : Semantics D)
-    (c d : Cell D) : ExtOrd :=
-  if h : GradedLe (D.cell d) (D.cell c) then sem.E c ⟨d, h⟩ else ⊥
