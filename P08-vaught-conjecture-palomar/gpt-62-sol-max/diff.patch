-      (baseRelationsIn_mapLanguage_withConstants r₁).le⟩
-    ⟨((baseFunctionsIn_not _).trans (baseFunctionsIn_mapLanguage_withConstants r₂)).le,
-      ((baseRelationsIn_not _).trans (baseRelationsIn_mapLanguage_withConstants r₂)).le⟩
-    ∅
