-  {N : Type*} [Fintype N] (newCell : N → Finset (Fin (n + 1)) × ℕ)
-  (hnew_mem : ∀ x, newCell x ∈ Plan.gradedPlan Q)
-  (hnew_last : ∀ x, Fin.last n ∈ (newCell x).1)
