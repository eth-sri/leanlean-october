-
-/-- **The glued domain from the three-point obligations.** -/
-noncomputable def semSchemeGlue' (HA : FaceExtA') (HB : FaceExtB') : SemScheme 4 :=
-  semSchemeGlue (faceExtA_of HA) (faceExtB_of HB)
-
-end Endpoint
