-def stepEquiv (U : Finset ι × ℕ) (hu : U.2 ≤ k) :
-    P.carrier.below U ≃ (successor P hk hnext).carrier.below U :=
-  HighLayerBountiful.equiv P.carrier (Catalogue X (k + 1)) (k + 1)
-    (Nat.succ_pos k) hnext U (fun h => by have := h.2; omega)
