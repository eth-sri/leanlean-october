-theorem baseFunctionsIn_imp_left {φ ψ : L[[ℕ]].Sentenceω} :
-    φ.baseFunctionsIn ⊆ (φ.imp ψ).baseFunctionsIn := by
-  intro s hs
-  simp only [BoundedFormulaω.baseFunctionsIn, BoundedFormulaω.functionsIn, Set.mem_ofPred_eq,
-    Set.mem_union] at hs ⊢
-  exact Or.inl hs
