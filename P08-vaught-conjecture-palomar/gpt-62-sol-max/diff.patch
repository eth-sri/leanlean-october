-/-! ## The ordinal under a proper value -/
-
 theorem ofOrd_ordOf {x : ExtOrd} (hb : x ≠ ⊥) (ht : x ≠ ⊤) : ofOrd (ordOf x) = x := by
   rcases ExtOrd.cases x with rfl | rfl | ⟨a, rfl⟩
   · exact absurd rfl hb
   · exact absurd rfl ht
   · rw [ordOf_ofOrd]
 
