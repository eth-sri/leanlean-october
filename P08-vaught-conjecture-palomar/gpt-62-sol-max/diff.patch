-  have h_mem : α ∈ {α : Ordinal.{0} | ∀ {n : ℕ} (a : Fin n → M)
-      (N : Type w) [L.Structure N] [Countable N] (b : Fin n → N),
-      BFEquiv (L := L) α n a b → BFEquiv (L := L) (Order.succ α) n a b} := by
-    intro n a N _ _ b hBF
-    exact (hstab n N a b).mp hBF
