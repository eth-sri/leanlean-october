-theorem render_base_ceiling (hG : ∀ z ∈ G, SelfVis 2 z) (hH : SelfVis 2 H)
-    (hb : ∀ d, S.profile d ≤ H) :
-    ∃ c : Cell (carrier I X attach hA hB hC),
-      (carrier I X attach hA hB hC).cell c = (A, 1) ∧
