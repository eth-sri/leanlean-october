-    ((Finset.univ : Finset (Fin 3)), 3) := by decide
-theorem univ_sub_fold_A :
-    (Finset.univ : Finset (Fin 3)) ⊆ ({0, 1, 2} : Finset (Fin 4)).image fold := by
