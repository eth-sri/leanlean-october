-/-- Every family member is an actual respecting normalized boundary profile. -/
-def Profile := {p : Cell D → Fin (D.card + 1) //
-  RespectsSemantics sem (fun d => value (p d).val) ∧
-    ∀ d, rankCode (fun e => value (p e).val) d = (p d).val}
