+    have h1 := hrows (e.symm Sig) ⟨(e.symm ⟨d.1, d.2.trans Sig.2⟩).1, hd⟩ hd0
+    have h2 : sem.E Sig.1 d =
+        sem.E (e (e.symm Sig)).1 ⟨(e (e.symm ⟨d.1, d.2.trans Sig.2⟩)).1, hd0⟩ :=
+      sem.E_congr hv2.symm hv1.symm
