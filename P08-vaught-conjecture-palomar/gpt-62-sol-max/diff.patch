-    apply csInf_le_csInf
-    · exact ⟨0, fun _ _ => bot_le⟩
-    · obtain ⟨α, _, hstab⟩ := exists_complete_stabilization (L := L) M
-      exact ⟨α, fun {n} a P _ _ b hBF => (hstab n P a b).mp hBF⟩
-    · intro α hα_M
