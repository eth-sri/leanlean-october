-        simp only [rowOf, hm]
-        exact (levelCap_selfVis _ _ _ _ _ _).symm
-      · simp only [rowOf, hm]
-        exact (extVisibilityReplace_bot _ _).symm
-    · exact (extVisibilityReplace_bot _ _).symm
-
-theorem newRow_orderly (j : Fin (famCard sem₀ I M P)) :
