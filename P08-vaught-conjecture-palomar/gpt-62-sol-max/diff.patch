-  | .inl c => (c.scope, c.gradeP)
-  | .inr (.inl _) => (Finset.univ, 1)
-  | .inr (.inr (.inl _)) => (Finset.univ, 2)
-  | .inr (.inr (.inr _)) => (Finset.univ, 3)
