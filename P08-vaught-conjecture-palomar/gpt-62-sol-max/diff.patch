-  ⟨fun _ => ⊤, fun _ => ⊥, fun _ _ _ => le_rfl, fun _ => rfl, rfl, monotone_const,
-    fun _ _ _ _ _ => (extVisibilityReplace_bot _ _).symm,
-    fun _ => (min_eq_left bot_le).symm⟩
