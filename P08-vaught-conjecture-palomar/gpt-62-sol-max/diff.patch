-theorem below_gradedLe {y : F.X} (d : F.scheme.below (F.scheme.cell (F.e y))) :
-    GradedLe (F.cellX (F.e.symm d.1)) (F.cellX y) := by
-  obtain ⟨i, hi⟩ := d
-  rw [cell_e] at hi
-  exact hi
