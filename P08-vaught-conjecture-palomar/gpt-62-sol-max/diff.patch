-  · exact False.elim (proper I hB hC d
-      ((congrArg Prod.fst (RelativeLadderLayer.old_index I.boundary (by omega) d)).symm.trans hc))
-  · exact congrArg Prod.snd (RelativeLadderLayer.added_index I.boundary (by omega) v)
