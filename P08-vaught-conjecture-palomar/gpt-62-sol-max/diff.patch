+theorem Semantics.IsBountiful.extend {sem : Semantics D} (hb : sem.IsBountiful)
+    {CI BJ : Finset ι × ℕ} (hCI : CI.1 ∈ D.plan) (hBJ : BJ.1 ∈ D.plan) (h : GradedLe CI BJ)
