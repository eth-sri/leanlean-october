-  SeparatedLayerFace.lift P.carrier (Catalogue X (k + 1)) (k + 1)
-    (Nat.succ_pos k) hnext (P.separated I X T hA hB hC (by omega))
-    P.rows (rows P hk hnext) (inherited_row P hk hnext) h
-    (fun h => by have := h.2; omega) hl
