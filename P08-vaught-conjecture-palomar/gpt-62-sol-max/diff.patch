+    D.scheme.cell (faceMap D F f hv hf d) =
+      ((F.scheme.scope d).image f, F.scheme.grade d) := by
+  subst F
+  exact (CellScheme.restrictFace.pushGraded_cell D.scheme f hv d).symm
