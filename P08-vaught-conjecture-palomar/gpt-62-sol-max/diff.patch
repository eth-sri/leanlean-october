-theorem lv_le (t : Fam sem₀ I M P) : lv sem₀ I M P t ≤ M + 2 := by
-  rcases t with _ | _ | i
-  · simp [lv]
-  · simp [lv]
-  · simp only [lv, Sum.elim_inr]; omega
