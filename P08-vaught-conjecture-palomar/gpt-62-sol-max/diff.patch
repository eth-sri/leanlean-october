-theorem field_coded {j : ℕ} (a : Catalogue X j) (d : Field DA DQ) :
-    IsCodedLabel j (fields X j a d) := by
-  rcases mem_codedAlphabet_iff.mp
-      (CanonicalPairedProfiles.inventory_coded (Field DA DQ) j a.property.1 d)
-      with hb | ⟨b, i, _, hi, he⟩
-  · exact Or.inl hb
-  · exact Or.inr ⟨b, i, hi, he⟩
-end Fields
