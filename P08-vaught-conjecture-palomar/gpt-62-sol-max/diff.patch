-    (H := RelativeLadderLayer.rungs (X := Field I.right.scheme I.left.scheme))
-    (X := Field I.right.scheme I.left.scheme) (by unfold RelativeLadderLayer.rungs; omega) a
-  let c := RelativeLadderLayer.added I.boundary J.one v
