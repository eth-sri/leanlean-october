-  | succ t ih =>
-    exact congrArg (old (build I X attach hA hB hC t (by omega)) (by omega)) (ih (by omega))
-
-def donorFace (t : ℕ) (ht : t + 2 ≤ A.card) :
-    ExactSemanticFace I.leftRows (build I X attach hA hB hC t ht).rows :=
-  face I X attach hA hB hC I.leftFace hB.not_ge t ht
-
-def privateFace (t : ℕ) (ht : t + 2 ≤ A.card) :
-    ExactSemanticFace I.rightRows (build I X attach hA hB hC t ht).rows :=
-  face I X attach hA hB hC I.rightFace hC.not_ge t ht
-
-theorem donor_order (t : ℕ) (ht : t + 2 ≤ A.card) :
-    StrictMono (donorFace I X attach hA hB hC t ht).map := by
-  have he := funext (face_map I X attach hA hB hC I.leftFace hB.not_ge t ht)
-  change StrictMono (face I X attach hA hB hC I.leftFace hB.not_ge t ht).map
-  rw [he]
-  exact (build I X attach hA hB hC t ht).base_mono.comp
