-    obtain ⟨x, rfl⟩ := SourceLayerCarrier.old_occurrence P.carrier (Catalogue X (k + 1))
-      (k + 1) (Nat.succ_pos k) hnext d hd
-    rw [lower_old]
-    exact selected_bound P _ x
