+      · exact Or.inr ⟨toCell L Q j hj hA (.inl c), appendMap_toCell Q j hj hA G.low _⟩
+    · exact Or.inr ⟨toCell L Q j hj hA (.inr q), appendMap_toCell Q j hj hA G.low _⟩
