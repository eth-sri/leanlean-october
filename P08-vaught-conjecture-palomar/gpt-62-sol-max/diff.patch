-    RespectsSemanticsBelow (rows P hk hnext) (A, k + 1)
-      (fun d => source P hk hnext a d.1) := (data P hk hnext).profile_respects _
-
-theorem source_supported (a : Catalogue X (k + 1)) (d : Cell (carrier P hnext)) :
