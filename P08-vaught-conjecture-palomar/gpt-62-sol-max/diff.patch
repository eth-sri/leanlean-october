-      | Sum.inl m' => levelCap 1 I m.F m.γ m'.F m'.γ
-      | Sum.inr _ => ⊥
-  | Sum.inr (Sum.inl m), _, hk, Sum.inl b => m.F ⟨b.1, b.2.trans_eq hk.symm⟩
