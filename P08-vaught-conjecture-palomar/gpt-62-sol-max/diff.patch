-/-- The ordered proper boundary, before installing full-scope cells. -/
-noncomputable def scheme : CellScheme A where
-  plan := s.plan
-  isPlan := isPlan s
-  card := Fintype.card (Boundary D E w)
-  cell d := index D E w ((enumeration D E w).symm d)
