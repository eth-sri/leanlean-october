+      RespectsSemanticsBelow I.sem (D.cell c) (fun d => q (I.old d.1)) :=
+  SeparatedSourceLayerCarrier.base_respects_iff D Q k I.pos I.height I.separated I.sem c (fun d => q d.1)
+
