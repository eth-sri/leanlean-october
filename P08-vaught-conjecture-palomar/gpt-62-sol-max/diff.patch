-/-- Only original scalar conditions are supplied. None of the physical
-predecessor receipts consumed by the weighted installer is a field. -/
-structure Input (D : CellScheme A) where
-  sem : Semantics D
-  proper : ∀ d : Cell D, D.scope d ≠ A
-  height : 2 ≤ A.card
-  field : Cell D → X
-  fields : Q → X → ExtOrd
