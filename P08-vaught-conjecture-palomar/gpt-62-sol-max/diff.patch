-    (G := ∅) (H := ⊤) (by simp) (by simp [SelfVis]) (fun _ => le_top) j hj hjt
-  exact ⟨d, hd⟩
-
-end
-end VaughtConjecture.Knight.GrowthPaddedInstallation
