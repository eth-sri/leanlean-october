-        exact ⟨J.lower.isPlan.subset_of_mem (J.lower.scope_mem_plan x), hg.trans hj⟩
-      have hl := render_below_old I X attach hA hB hC hj S hS hp hG hH hb x hxc
-      rcases c with ⟨c, h⟩
