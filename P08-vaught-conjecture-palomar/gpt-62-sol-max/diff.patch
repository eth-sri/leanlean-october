-      rw [hc]; exact GradedLe.refl _)
-  let fromEff := CellScheme.below.mono (D := I.right.scheme)
-    (show GradedLe (Finset.univ, k + 1) (I.right.scheme.cell c.1) from by
-      rw [hc]; exact GradedLe.refl _)
