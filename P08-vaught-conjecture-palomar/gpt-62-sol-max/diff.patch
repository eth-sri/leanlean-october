-theorem BoundedFormulaω.realize_congr_const (base : L.Structure M) {h h' : ℕ → M} :
-    ∀ {n : ℕ} (φ : L[[ℕ]].BoundedFormulaω α n)
-      (_ : ∀ k ∈ sentenceJConsts (L' := L) (J := ℕ) φ, h k = h' k)
