+    obtain ⟨a, rfl⟩ := old_occurrence E Q j hj hA d (fun he => hd (by rw [CellScheme.scope, he]))
+    obtain ⟨c, rfl⟩ := G.proper_exhaustive a (by simpa only [CellScheme.scope, cell_toCell, index] using hd)
