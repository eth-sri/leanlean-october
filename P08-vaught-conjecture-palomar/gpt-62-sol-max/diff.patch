-    (fun d => by
-      rw [hg]
-      exact CanonicalPairedProfiles.inventory_short _ _ hcanon (.inl d.1))
-    (by simpa only [hg] using hσ) (by simpa only [hg] using hγ) hpos hactive (fun d => by
