+
+@[simp] theorem data_boundary (a : Q) : I.data.boundary (I.controller a) = I.fields a := by
+  simp only [data, I.member_controller]
+
+abbrev rows := I.data.rows
+
+abbrev source (a : Q) := I.data.profile (I.controller a)
