-  ∀ (p : I.right.scheme.below (Finset.univ, k) → ExtOrd)
-    (q : P.carrier.below (A, k) → ExtOrd) (γ : ExtOrd),
-    RespectsSemanticsBelow I.right.rows (Finset.univ, k) p →
