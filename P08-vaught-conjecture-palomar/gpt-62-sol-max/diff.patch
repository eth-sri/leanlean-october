-namespace Family
-
-variable {st} (F : Family st)
-
-/-- The cells: the proper cells and the three families. -/
-abbrev X : Type 1 := Prop3 ⊕ (↥F.S₁ ⊕ (↥F.S₂ ⊕ ↥F.S₃))
