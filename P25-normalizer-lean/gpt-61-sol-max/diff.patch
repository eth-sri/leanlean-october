-    (h : c • ((ofZ r : Matrix (Fin 2) (Fin 2) ℝ) * hermMat a b d) =
-      (γ : Matrix (Fin 2) (Fin 2) ℝ) * (c' • ((ofZ r' : Matrix (Fin 2) (Fin 2) ℝ) * hermMat a' b' d'))) :
-    r = r' ∧ a = a' ∧ b = b' ∧ d = d' := by apply sigmaH_unique' <;> assumption
-
