-    (hk : k = min j (ν / 2))
-    (prim : a = 0 ∨ b = 0 ∨ c = 0 ∨ d = 0)
-    (u1 : min (a + d) (b + c) ≤ δ₀) (u2 : a + d ≠ b + c → δ₀ = min (a + d) (b + c))
