+    ((5 ≤ p ∧ p ^ 2 ∣ N ∧ AllPm p) ∨
+      (p = 3 ∧ 3 ^ 4 ∣ N ∧ AllPm 9) ∨
+      (p = 2 ∧ 2 ^ 8 ∣ N ∧ AllPm 8))
