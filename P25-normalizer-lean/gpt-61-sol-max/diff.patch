+theorem hDelta_eq_hPart_iff :
+    η = hPart N ↔
+      ¬ ((∃ p, Nat.Prime p ∧ 5 ≤ p ∧ p ^ 2 ∣ N ∧ AllPm p) ∨
+        (3 ^ 4 ∣ N ∧ AllPm 9) ∨
+        (2 ^ 8 ∣ N ∧ AllPm 8)) := by
