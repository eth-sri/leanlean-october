-  have Y1 : (a : ℤ) * b' = (b + k * d) * a' := by
-    linear_combination s * X1 - ((a : ℤ) * b' - b * a') * hs
-  have Y2 : (a : ℤ) * d' = d * a' := by
-    linear_combination s * X2 - ((a : ℤ) * d' - d * a') * hs
