-      · convert hzw using 1; ring
-    · refine ⟨x, hx0, ?_, ?_, ?_, ?_⟩
-      · convert (IsIntR.nat N).mul hxx using 1; ring
-      · convert hxy using 1; ring
-      · convert (IsIntR.nat N).mul hxz using 1; ring
-      · convert hxw using 1; ring
-  obtain ⟨Ix, hIx⟩ := htx
-  obtain ⟨Iy, hIy⟩ := hty
-  obtain ⟨Iz, hIz⟩ := htz
-  obtain ⟨Iw, hIw⟩ := htw
-  set h := η
