-theorem exists_Gamma0Reps (N : ℕ) : ∃ R : Set SL(2, ℤ), IsGamma0Reps N R := by apply exists_Gamma0Reps' <;> assumption
-
-/-- **The count of `aut_orders.py`**: for any set R of representatives of Γ₀(N)\SL₂(ℤ), [Nor(Γ_Δ(N)) : Γ₀(N)]
