+lemma unit_sq24 {m} (hm : m ∣ 24) : ∀ u : (ZMod m)ˣ, (u : ZMod m) ^ 2 = 1 := by
+  have := Nat.le_of_dvd (by norm_num) hm
+  interval_cases m <;> norm_num at hm <;> decide
