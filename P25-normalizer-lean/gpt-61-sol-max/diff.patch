+    case' inr => refine ⟨-a, -b, -c, -d, by nlinarith, ?_⟩
+    all_goals
+      rw [hc]
+      matrix_calc hNr
+
+variable (N Δ)
+
+theorem coe_MDelta :
+    ↑MΔ = {g | IsNewmanFormH N η g} :=
+  Set.ext fun _ => mem_MDelta_iff
