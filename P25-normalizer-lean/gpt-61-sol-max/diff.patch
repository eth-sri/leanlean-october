-  rw [← Nat.factorization_le_iff_dvd (Int.natAbs_ne_zero.2 hm) (Int.natAbs_ne_zero.2 hx)]
-  intro p
-  by_cases hp : p.Prime
-  · exact h p hp
-  · simp [Nat.factorization_eq_zero_of_not_prime _ hp]
