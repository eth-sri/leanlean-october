+  simp only [MulAut.conj_symm_apply, inv_inv, ← MulAut.conj_apply]
+  have hc : ↑ₘ(MulAut.conj (projSL !![η, 0; 0, 1]) g) =
+      !![g 0 0, η * g 0 1; g 1 0 / η, g 1 1] := by
+    matrix_calc MulAut.conj_apply projSL funext_iff
