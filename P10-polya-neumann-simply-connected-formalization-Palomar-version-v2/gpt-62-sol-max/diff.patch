-theorem physicalCircleTrace_contDiffAt_of_inverse_curve {F : ℂ → ℂ}
-    {α β : ℝ → ℂ} {t₀ θ₀ : ℝ}
-    (hα : ContDiffAt ℝ (⊤ : ℕ∞) α t₀)
