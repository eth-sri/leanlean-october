-    · have hxi : x ∈ Ioo a b := ⟨hxa, hx.2⟩
-      have hyi : y ∈ Ioo a b := ⟨hya, hy.2⟩
-      apply injOn_circleMap_of_abs_sub_le' hr hwidth hx hy
-      apply hinj (harc hxi) (harc hyi)
-      exact (hGeq hxi).symm.trans (heq.trans (hGeq hyi))
