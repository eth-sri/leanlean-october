-/-- This is actual C¹ regularity of the density, not a Fourier regularity premise. -/
-theorem contDiff_physicalMomentPrimitive (γ H : ℝ → ℂ)
-    (hγ : ContDiff ℝ 1 γ) (hH : Continuous H) :
