+  have h₀ : ∀ᵐ x : ℝ, x ≠ 0 := by simp [ae_iff]
+  have h₁ : ∀ᵐ x : ℝ, x ≠ L := by simp [ae_iff]
+  rw [uIcc_of_le hL]
+  filter_upwards [hd, h₀, h₁] with x; grind
