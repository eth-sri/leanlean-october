-    _ ≤ ‖physicalDrivenPower γ ℓ θ‖ *
-        (‖physicalDrivenQ E‖ ^ (ℓ + j) * (2 * ‖y θ‖)) :=
-      mul_le_mul_of_nonneg_left (norm_physicalDrivenScaledRow_le E y (ℓ + j) θ)
-        (norm_nonneg _)
-    _ = _ := by
-      simp only [physicalDrivenPower, norm_div, norm_pow, norm_neg, Complex.norm_natCast,
-        pow_add, mul_pow]
-      ring
