-theorem dirichlet_cutoff_conj_product_dirD (η : smoothTraceTests)
-    {v : ℂ → ℂ} {z : ℂ} (hv : DifferentiableAt ℝ v z) (w : ℂ) :
-    dirD (fun z => dirichletCutoffWeight η z * conj (v z)) w z =
