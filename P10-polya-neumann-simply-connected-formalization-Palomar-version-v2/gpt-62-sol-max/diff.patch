-    simp only [fderiv_const_apply, ContinuousLinearMap.add_apply,
-      ContinuousLinearMap.comp_apply, ContinuousLinearMap.flip_apply,
-      ContinuousLinearMap.zero_apply, map_zero, zero_add]
