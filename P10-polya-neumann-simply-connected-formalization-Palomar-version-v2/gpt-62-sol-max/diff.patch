+private theorem analytic_polynomial_convolution (q : ℝ[X]) {f : ℂ → ℝ}
+    (hf : Continuous f) (hc : HasCompactSupport f) (x₀ : ℂ) :
+    AnalyticAt ℝ (fun x : ℂ => ∫ y, q.eval (‖x - y‖ ^ 2) * f y) x₀ := by
+  let p : MvPolynomial (Fin 4) ℝ := q.aeval
