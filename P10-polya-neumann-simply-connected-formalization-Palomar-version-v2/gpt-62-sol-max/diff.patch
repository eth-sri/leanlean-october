-theorem exists_riemannMappingBoundaryAngularInverse {α : ℝ → ℂ} {t₀ θ₀ : ℝ}
-    (hα : ContDiffAt ℝ (⊤ : ℕ∞) α t₀)
-    (hcircle : ∀ᶠ t in 𝓝 t₀, ‖α t‖ = 1) (hd : deriv α t₀ ≠ 0)
