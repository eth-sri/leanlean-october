-    (hγ : ContDiff ℝ 1 γ) (hH : Continuous H) (θ : ℝ) :
-    HasDerivAt (physicalMomentPrimitive γ H) (conj (deriv γ θ) * H θ) θ :=
-  (((Complex.continuous_conj.comp hγ.continuous_deriv_one).mul hH).integral_hasStrictDerivAt
-    0 θ).hasDerivAt
