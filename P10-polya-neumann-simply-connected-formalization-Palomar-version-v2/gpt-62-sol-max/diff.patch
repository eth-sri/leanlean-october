-    hxd.tendsto.eventually (eventually_gt_nhds (by rw [hxd0]; exact one_pos))
-  obtain ⟨ρ, hρ, hρsub⟩ := Metric.mem_nhds_iff.mp
-    (hpos.and (isOpen_Ioo.mem_nhds ht))
