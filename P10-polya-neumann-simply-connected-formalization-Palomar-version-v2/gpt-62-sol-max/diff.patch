-def smoothDirichletHalfBox (a b : ℝ) : Set ℂ :=
-  {z | |z.re| < a ∧ 0 < z.im ∧ z.im < b}
-
-def smoothDirichletClosedHalfBox (a b : ℝ) : Set ℂ :=
-  {z | |z.re| ≤ a ∧ 0 ≤ z.im ∧ z.im ≤ b}
