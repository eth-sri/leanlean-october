-theorem exists_physicalDrivenGaugeTerm_majorant
-    (γ : ℝ → ℂ) (hγ : Continuous γ) (E : ℝ) (y : ℝ → Ell2)
-    (hy : ContinuousOn y (Icc 0 (2 * Real.pi))) (j : ℕ) :
