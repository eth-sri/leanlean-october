-    (hγ : ContDiff ℝ 1 γ) (hH : Continuous H)
-    (hmom : ∀ m : ℕ,
-      (∫ θ in (0 : ℝ)..(2 * Real.pi),
-        (conj (deriv γ θ) * H θ) * (conj (γ θ) - conj (γ 0)) ^ m) = 0)
