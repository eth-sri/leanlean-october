-private theorem radial_affine_value_ae {Ω : Set ℂ} (hb : Bornology.IsBounded Ω)
-    (p : ℂ) (u : NeumannH1 Ω) (f : ℂ → ℂ)
-    (hf : (h1Value Ω u : ℂ → ℂ) =ᵐ[volume.restrict Ω] f) (j : ℕ) :
-    (h1Value Ω ((neumannH1AffineMultiplier hb p ^ j) u) : ℂ → ℂ)
