-  let J := riemannMappingClosedInverse F
-  let z := rectangularComplexCoord (x, y)
-  have hz : z ∈ smoothDirichletHalfBox a b :=
-    rectangularComplexCoord_mem_halfBox ⟨hx, hy⟩
-  have hdJ : DifferentiableAt ℂ J (Ψ z) :=
