-/-- Finite sums contain indices 0,...,N, making the uncancelled tail explicit. -/
-def physicalDrivenGaugePartial (γ : ℝ → ℂ) (E : ℝ) (y : ℝ → Ell2)
-    (j N : ℕ) (θ : ℝ) : ℂ :=
-  ∑ ℓ ∈ Finset.range (N + 1), physicalDrivenGaugeTerm γ E y j ℓ θ
