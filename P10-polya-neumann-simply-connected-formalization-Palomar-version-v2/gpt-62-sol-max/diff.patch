+private lemma mul_image_ball {a : ℂ} (ha : ‖a‖ = 1) (r : ℝ) :
+    (a * ·) '' ball 0 r = ball 0 r := by
+  have h0 : a ≠ 0 := by rintro rfl; simp at ha
+  ext z
+  constructor
+  · rintro ⟨w, hw, rfl⟩
+    simpa [mem_ball_zero_iff, norm_mul, ha] using hw
+  · intro hz
+    refine ⟨a⁻¹ * z, ?_, ?_⟩
+    · simpa [mem_ball_zero_iff, norm_mul, ha] using hz
+    · simp [h0]
