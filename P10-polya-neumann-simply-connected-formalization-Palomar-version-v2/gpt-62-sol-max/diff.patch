-    ((riemannInteriorDerivative_measurable F).norm.pow_const 2)
-    (riemannInteriorDerivative_sq_integrable F hF hinj hb) c
-  have heq : ∀ p : ℝ × ℝ,
-      c + Complex.polarCoord.symm p = circleMap c p.1 p.2 := by
-    intro p
