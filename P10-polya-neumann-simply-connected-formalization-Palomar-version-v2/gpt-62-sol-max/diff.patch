-        gcongr
-      _ = _ := by dsimp [S]; ring
-  have hYsq : Y ^ 2 ≤ 2 * T := by
-    dsimp [Y, X, T]
-    have hxy : (‖x‖ + ‖y‖) ^ 2 ≤ 2 * (‖x‖ ^ 2 + ‖y‖ ^ 2) := by
