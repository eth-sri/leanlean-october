-  have hT : T e e = T (a • (1 : ℂ) + b • Complex.I)
-      (a • (1 : ℂ) + b • Complex.I) := congrArg (fun w => T w w) hE
-  have hTI : T (Complex.I * e) (Complex.I * e) =
-      T ((-b) • (1 : ℂ) + a • Complex.I) ((-b) • (1 : ℂ) + a • Complex.I) :=
-    congrArg (fun w => T w w) hIE
