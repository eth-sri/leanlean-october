+private lemma trial_gradients {D : Set ℂ} (hD : IsOpen D) (j : ℕ) {E : ℝ} (hE : 0 < E)
+    (h : neumannEigenvalue D j < ENNReal.ofReal E) :
+    ∃ (e : Fin (j + 1) → L2 D) (G : Fin (j + 1) → Fin 2 → L2 D), Orthonormal ℂ e ∧
