-  have hndX := dirichlet_bounded_mul_memLp hd.neg.aestronglyMeasurable
-    (fun z => by rw [Pi.neg_apply, norm_neg]; exact hdb z) hdx
-  have hab (z : ℂ) : ‖(1 : ℂ) + d z ^ 2‖ ≤ 1 + (K : ℝ) ^ 2 := by
