-    (hγ : ContDiff ℝ 1 γ) (hH : Continuous H) (θ : ℝ) :
-    deriv (physicalMomentPrimitive γ H) θ = conj (deriv γ θ) * H θ :=
-  (physicalMomentPrimitive_hasDerivAt γ H hγ hH θ).deriv
