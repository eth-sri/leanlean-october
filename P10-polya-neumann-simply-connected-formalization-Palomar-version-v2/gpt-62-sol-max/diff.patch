-theorem dirichletComplexBumpTest_tsupport_subset (κ : ContDiffBump (0 : ℂ)) :
-    tsupport (dirichletComplexBumpTest κ : ℂ → ℂ) ⊆
-      closedBall (0 : ℂ) κ.rOut := by
-  change tsupport (fun z => (κ z : ℂ)) ⊆ closedBall (0 : ℂ) κ.rOut
-  rw [← κ.tsupport_eq]
