-def dirichletCutoffWeight (η : smoothTraceTests) : smoothTraceTests :=
-  ⟨fun z => η z * conj (η z),
-    ⟨η.property.1.mul (Complex.conjCLE.contDiff.comp η.property.1),
-      η.property.2.1.mul_right, subset_univ _⟩⟩
