-theorem dirichletComplexBumpTest_eq_one (κ : ContDiffBump (0 : ℂ)) {z : ℂ}
-    (hz : z ∈ closedBall (0 : ℂ) κ.rIn) : dirichletComplexBumpTest κ z = 1 := by
