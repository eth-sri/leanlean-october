-    linarith only [herr, hYoung', hBc, hGv, hcBound]
-  have hmain : T / M ≤ main.re := by
-    rw [show main = ((‖η‖ ^ 2 : ℝ) : ℂ) * (F₀ * conj x + F₁ * conj y) by rw [← hρ]]
