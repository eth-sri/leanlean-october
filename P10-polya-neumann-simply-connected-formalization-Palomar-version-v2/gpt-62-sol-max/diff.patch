-/-- The physical interval primitive, normalized at the supplied boundary origin. -/
-def physicalMomentPrimitive (γ H : ℝ → ℂ) (θ : ℝ) : ℂ :=
-  ∫ s in (0 : ℝ)..θ, conj (deriv γ s) * H s
