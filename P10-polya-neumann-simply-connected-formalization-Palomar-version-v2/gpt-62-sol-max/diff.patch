-    hΨ.eventually (eventually_ne_nhds hne)
-  obtain ⟨ε, hε, hball⟩ := Metric.mem_nhds_iff.mp hev
-  let r := min ρ (ε / 4)
-  have hr : 0 < r := lt_min hρ (by positivity)
-  have hrε : r ≤ ε / 4 := min_le_right _ _
-  refine ⟨r, hr, min_le_left _ _, ?_⟩
-  intro z hz
-  apply hball
-  rw [mem_ball_zero_iff]
