+    rw [← uIcc_of_le Real.two_pi_pos.le]
+    exact (gaugeVector_absolutelyContinuous hγ
+      (physicalDrivenVector_absolutelyContinuous_of_intervalIntegrable hK hW g hg) E).continuousOn
