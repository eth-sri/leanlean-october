-    ((R * ‖physicalDrivenQ E‖) ^ ℓ / (ℓ.factorial : ℝ)),
-    (Real.summable_pow_div_factorial _).mul_left _, ?_⟩
-  intro ℓ θ hθ
-  apply (norm_physicalDrivenGaugeTerm_le γ E y j ℓ θ).trans
