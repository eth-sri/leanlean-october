-/-- `∫₀^{2π} e^{inφ} dφ = 2π [n = 0]` for `n ∈ ℤ`. -/
-lemma integral_exp_int_mul_I (n : ℤ) :
-    ∫ φ in (0 : ℝ)..(2 * π), Complex.exp ((n : ℂ) * φ * Complex.I) =
-      if n = 0 then ((2 * π : ℝ) : ℂ) else 0 := by
