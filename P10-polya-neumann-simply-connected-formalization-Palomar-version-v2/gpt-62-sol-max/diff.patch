-theorem norm_physicalDrivenRow_le (y : ℝ → Ell2) (n : ℕ) (θ : ℝ) :
-    ‖physicalDrivenRow y n θ‖ ≤ 2 * ‖y θ‖ := by
-  have hc (k : ℕ) := lp.norm_apply_le_norm (p := 2) (by norm_num) (y θ) k
-  unfold physicalDrivenRow
-  split_ifs
-  · rw [norm_mul]
