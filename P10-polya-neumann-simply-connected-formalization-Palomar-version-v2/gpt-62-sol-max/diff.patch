-    Y * S = (4 * M * Y * S) / (4 * M) := by field_simp [hM.ne']
-    _ ≤ (Y ^ 2 + 4 * M ^ 2 * S ^ 2) / (4 * M) :=
-      div_le_div_of_nonneg_right hpoly hfourM.le
