-    apply Complex.ext <;> simp [a, b]
-  have hIE : Complex.I * e = (-b) • (1 : ℂ) + a • Complex.I := by
-    apply Complex.ext <;> simp [a, b, Complex.mul_re, Complex.mul_im]
-  have hs : a ^ 2 + b ^ 2 = 1 := by
-    have h := congrArg (fun r : ℝ => r ^ 2) he
