+    AbsolutelyContinuousOnInterval (fun x => A x (f x)) a b := by
+  obtain ⟨C, hC⟩ := hA.exists_bound
+  obtain ⟨D, hD⟩ := hf.exists_bound
+  unfold AbsolutelyContinuousOnInterval at hA hf ⊢
+  have hlim : Tendsto
+      (fun E : ℕ × (ℕ → ℝ × ℝ) => ∑ i ∈ Finset.range E.1,
