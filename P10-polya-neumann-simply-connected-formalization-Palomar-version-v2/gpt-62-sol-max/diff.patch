+    rw [hm, mul_zero]
+  simpa only [hz, tsum_zero] using hs.tsum_eq.symm
+
+private lemma cauchy_differentiableAt {γ f : ℝ → ℂ} (hγ : Continuous γ)
+    (hf : Integrable f μ) {w : ℂ} (hw : ∀ t ∈ J, γ t ≠ w) :
+    DifferentiableAt ℂ (fun v => ∫ t, f t / (v - γ t) ∂μ) w := by
