-    _ = herglotzCoeff k (c • a) 0 z := hc
-    _ = c * herglotzCoeff k a 0 z := herglotzCoeff_smul_density a c k 0 z
-    _ = c * ((((herglotzCoeff_memLp_domain hb ha k 0).toLp _ : L2 Ω) : ℂ → ℂ) z) := by
