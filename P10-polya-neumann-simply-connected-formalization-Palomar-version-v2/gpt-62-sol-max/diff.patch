+  have hc := continuous_towerLoad hA ha hh
+  have hd := intervalIntegral.integral_hasDerivAt_right (hc.intervalIntegrable 0 t)
+    hc.aestronglyMeasurable.stronglyMeasurableAtFilter (hc.continuousAt (x := t))
