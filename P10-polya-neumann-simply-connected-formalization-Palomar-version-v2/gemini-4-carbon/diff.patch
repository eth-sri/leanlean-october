-def angMode2 (v : ℂ → ℂ) (x₀ : ℂ) (n : ℤ) (r : ℝ) : ℂ :=
-  ∫ θ in (0 : ℝ)..2 * π, angChar n θ * fderiv ℝ (fderiv ℝ v) (circPt x₀ r θ) (eI θ) (eI θ)
