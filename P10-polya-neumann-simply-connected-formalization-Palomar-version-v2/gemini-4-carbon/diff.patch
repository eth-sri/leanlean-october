+/-- The weighted Cauchy integral with the winding-number denominator sign. -/
+def physicalWeightedCauchy (γ K : ℝ → ℂ) (z : ℂ) : ℂ :=
+  ∫ θ in (0 : ℝ)..(2 * Real.pi), (deriv γ θ * K θ) / (γ θ - z)
