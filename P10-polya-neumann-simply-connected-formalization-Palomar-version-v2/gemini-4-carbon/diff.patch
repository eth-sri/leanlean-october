-variable {Ω : Set ℂ} (hbΩ : Bornology.IsBounded Ω) (hS : IsSmoothDomain Ω)
-    (hsc : SimplyConnectedSpace Ω) (F : ℂ → ℂ)
-    (hF : DifferentiableOn ℂ F (ball (0 : ℂ) 1))
-    (hinj : InjOn F (ball (0 : ℂ) 1)) (himage : F '' ball (0 : ℂ) 1 = Ω)
