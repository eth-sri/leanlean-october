-variable {L : NNReal} (hΓLip : LipschitzWith L (physicalCircleTrace F))
-    {E₀ : ℝ} (hE₀ : 0 ≤ E₀)
-    {W : ℝ → Ell2 →L[ℂ] Ell2} (hW : IsTransport (physicalCircleTrace F) E₀ W)
-    (hc : cutC (W (2 * π)) (basisVec 0) ≠ 0)
-    {a : ℝ → ℂ} (ha : IsDirDensity a)
