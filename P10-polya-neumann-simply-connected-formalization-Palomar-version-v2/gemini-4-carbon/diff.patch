-omit [CompleteSpace H] in
-/-- An eigenvector for `z ≠ 1` orthogonal to all `e_p` vanishes. -/
-lemma eq_zero_of_eigen_of_orth {U : H →L[ℂ] H} (hC : IsCompactOperator ⇑(U - 1)) {z : ℂ}
