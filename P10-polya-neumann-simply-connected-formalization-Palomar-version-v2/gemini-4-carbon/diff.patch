-theorem norm_dirichletHigherCoefficientCommutator_le_of_derivative_bounds
-    {A a b h M : ℝ} (k : ℕ) (hh : 0 < h) (hmargin : a + (k : ℝ) * h ≤ A)
-    {c : ℂ → ℂ} (hc : ContDiff ℝ (⊤ : ℕ∞) c)
