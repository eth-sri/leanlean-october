+    fderiv ℝ (smoothDirichletGraphChart p c hc f hf.continuous) z w =
+      c⁻¹ * (w + (deriv f z.re * w.re) • Complex.I) := by
+  rw [(smoothDirichletGraphChart_hasFDerivAt p c hc hf z).fderiv]
