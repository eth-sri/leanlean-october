-    0 ≤ (⟪(u : L2 Ω), neumannOperator Ω u⟫_ℂ).re := by
-  obtain ⟨g, hg, hw⟩ := (neumannOperator_weak_representation hΩ (u : L2 Ω)
-    (neumannOperator Ω u)).mp ⟨u.property, rfl⟩
