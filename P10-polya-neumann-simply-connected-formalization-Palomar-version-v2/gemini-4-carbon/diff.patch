-    fderiv ℝ (v ∘ Ψ) z (coordDir i)
-  rw [fderiv_comp z hdv hdΨ, ContinuousLinearMap.comp_apply, clm_apply_eq_sum_coordRe]
-  simp only [chainGrad, smul_eq_mul, hz, dirD]
