-private theorem firstOrderBoundarySpeedBound_spec {Ω : Set ℂ} {γ : ℝ → ℂ}
-    (hγ : IsBoundaryParam Ω γ) : LipschitzWith (firstOrderBoundarySpeedBound hγ) γ :=
-  Classical.choose_spec hγ.lipschitz
