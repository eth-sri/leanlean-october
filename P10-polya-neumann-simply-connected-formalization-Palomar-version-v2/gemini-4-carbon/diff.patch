+private lemma schur_numeric {E A I0 Im1 Im2 T0 T1 S G C₁ CT CS K : ℝ} (hE : 0 < E) (hE1 : E ≤ 1)
+    (hC₁ : 0 ≤ C₁) (hCT : 0 ≤ CT) (hCS : 0 ≤ CS) (hA : 0 ≤ A) (hI0 : 0 ≤ I0) (hIm1 : 0 ≤ Im1)
+    (hIm2 : 0 ≤ Im2)
