+theorem smoothDirichletGraphChart_pullback_gradient (p c : ℂ) (hc : c ≠ 0)
+    {f : ℝ → ℝ} (hf : ContDiff ℝ (⊤ : ℕ∞) f) {v : ℂ → ℂ} {z : ℂ}
