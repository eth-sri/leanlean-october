+    obtain ⟨ε₁, hε₁, hsub⟩ := mem_nhdsGT_iff_exists_Ioo_subset.mp hder
+    have hGreenC : ContinuousOn (fun z : ℂ => (riemannMappingGreen F z : ℂ)) (closure Ω \ {F 0}) :=
