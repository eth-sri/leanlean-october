+private def riemannMappingGreenLogDatum (F : ℂ → ℂ) (d : smoothTraceTests)
+    (Ψ : ℂ → ℂ) (z : ℂ) : ℂ :=
+  d (Ψ z) - (((1 / 2 : ℝ) * Real.log (‖Ψ z - F 0‖ ^ 2) : ℝ) : ℂ)
