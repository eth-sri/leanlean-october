-    (neumannShiftedOperator Ω).domain = (neumannResolvent Ω).range := by
-  rw [neumannShiftedOperator, LinearPMap.inverse_domain]
-  ext f
-  constructor
-  · rintro ⟨v, hv⟩
-    exact ⟨(v : L2 Ω), hv⟩
-  · rintro ⟨v, hv⟩
-    exact ⟨⟨v, Submodule.mem_top⟩, hv⟩
