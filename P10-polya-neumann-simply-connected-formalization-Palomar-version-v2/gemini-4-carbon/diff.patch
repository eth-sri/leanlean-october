-theorem rectangular_contDiffOn_dirD {U : Set ℂ} (hU : IsOpen U) {u : ℂ → ℂ}
-    (hu : ContDiffOn ℝ (⊤ : ℕ∞) u U) (v : ℂ) :
-    ContDiffOn ℝ (⊤ : ℕ∞) (dirD u v) U := by
-  intro z hz
