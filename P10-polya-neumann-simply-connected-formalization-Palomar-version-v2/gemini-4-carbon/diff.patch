+    dirD (v ∘ smoothDirichletGraphChart p c hc f hf.continuous) 1 z -
+      ((deriv f z.re : ℝ) : ℂ) *
+        dirD (v ∘ smoothDirichletGraphChart p c hc f hf.continuous) Complex.I z =
+      dirD v (1 / c) (smoothDirichletGraphChart p c hc f hf.continuous z) ∧
+    dirD (v ∘ smoothDirichletGraphChart p c hc f hf.continuous) Complex.I z =
