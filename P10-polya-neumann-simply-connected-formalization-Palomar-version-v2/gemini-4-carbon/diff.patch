-/-- The inverse spectral parameter is proved from both resolvent identities. -/
-theorem neumannOperator_eigen_iff_resolvent {Ω : Set ℂ} (hΩ : IsOpen Ω)
-    (c : ℂ) (hc : c + 1 ≠ 0) (u : L2 Ω) :
