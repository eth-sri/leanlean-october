-    F z ∉ G '' Icc a b := by
-  have hopen : IsOpen (F '' ball (0 : ℂ) 1) :=
-    RiemannInterior.isOpen_image_of_injOn isOpen_ball (convex_ball (0 : ℂ) 1).isPreconnected
-      hF hinj Subset.rfl isOpen_ball
-  have hzΩ : F z ∈ F '' ball (0 : ℂ) 1 := ⟨z, hz, rfl⟩
-  rintro ⟨θ, hθ, he⟩
