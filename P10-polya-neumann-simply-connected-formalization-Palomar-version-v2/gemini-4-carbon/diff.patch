-        (2 * Real.pi * Complex.I) * c * windingNumber γ w := by
-  let f : ℝ → ℂ := fun θ => (deriv γ θ * (K θ - c)) / (γ θ - w)
-  let q : ℝ → ℂ := fun θ => deriv γ θ / (γ θ - w)
