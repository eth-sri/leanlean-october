+theorem physicalMomentPrimitive_endpoint (γ H : ℝ → ℂ)
+    (hmom0 : (∫ θ in (0 : ℝ)..(2 * Real.pi), conj (deriv γ θ) * H θ) = 0) :
+    physicalMomentPrimitive γ H (2 * Real.pi) = 0 := hmom0
