+    by positivity, fun a ha k hk hz hmean => ?_⟩
+  have hai := ha.intervalIntegrable
+  let N : ℕ → ℝ := fun j => ∫ z in Ω, ‖herglotzCoeff k a (-(j : ℤ)) z‖ ^ 2
+  set A1 := ∫ z in Ω, ‖herglotzCoeff k a 1 z‖ ^ 2
