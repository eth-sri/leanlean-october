-theorem smoothDirichletGraphChart_rotate (p c : ℂ) (hc : c ≠ 0)
-    (f : ℝ → ℝ) (hf : Continuous f) (z : ℂ) :
-    c * (smoothDirichletGraphChart p c hc f hf z - p) = smoothDirichletGraphShear f z := by
-  rw [smoothDirichletGraphChart_apply]
-  field_simp [hc]
-  ring
