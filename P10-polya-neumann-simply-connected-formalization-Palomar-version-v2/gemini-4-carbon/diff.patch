-    (hinj : ∀ z : H₀ᗮ, (∀ j, ⟪adjoint R (w j), z⟫_ℂ = 0) → S E₀ (R z) = 0 → z = 0) :
-    ∃ A₀ > 0, ∃ V ∈ 𝓝 E₀, ∀ E ∈ V, E ∈ U →
