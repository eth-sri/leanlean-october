+    have hLpos : 0 < L := lt_of_le_of_ne hLnn (Ne.symm hne)
+    obtain ⟨r2, hr2⟩ := eventually_atTop.mp (hWlim.eventually (lt_mem_nhds (half_lt_self hLpos)))
