-/-- With `c = i h_a(0)`: `∫ |G - c| ≤ ∫ |h_a| + 2π |k| ∫ |q|`. -/
-lemma integral_norm_primitive_sub_le (ha : IntervalIntegrable a volume 0 (2 * π)) (k : ℝ)
