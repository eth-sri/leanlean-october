+    exact intervalIntegral.integral_congr fun _ _ => by simp [mul_comm]
+  rw [e, hg, integral_conj, map_mul, Complex.conj_conj, integral_const_mul]
+  simp only [map_mul, map_ofNat, Complex.conj_I]
+  ring_nf; rw [Complex.I_sq]; ring
