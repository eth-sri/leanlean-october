+        ∫ z in Ω, herglotzCoeff (Real.sqrt E) a 0 z = 0 →
+          0 ≤ imSchur (monodromy W) (basisVec 0) (herglotzVec ha (Real.sqrt E) (γ 0)) := by
+  obtain ⟨Kγ, hKγ⟩ := hγ.lipschitz
