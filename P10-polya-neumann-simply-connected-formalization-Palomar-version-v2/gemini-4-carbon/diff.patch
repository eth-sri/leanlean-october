-local notation "zΓ" => regularHerglotzObservationVector (γ := physicalCircleTrace F) E₀ W ha
-local notation "rΓ" => TF (Submodule.starProjection (h1ResonantSpace ΩF E₀)
-  (herglotzWaveH1 hb ha (Real.sqrt E₀)))
