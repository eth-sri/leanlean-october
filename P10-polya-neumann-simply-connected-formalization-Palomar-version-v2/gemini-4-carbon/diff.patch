-/-- The boundary density `q = conj(γ') F₋₁(γ)`. -/
-def herglotzQd (k : ℝ) (a : ℝ → ℂ) (γ : ℝ → ℂ) (θ : ℝ) : ℂ :=
-  conj (deriv γ θ) * herglotzCoeff k a (-1) (γ θ)
