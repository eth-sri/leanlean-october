-    exact Real.summable_pow_div_factorial (‖z‖ * a)
-  have hp : Summable (fun p : ℕ × ℕ => C * (r p.1 * r p.2)) :=
-    (summable_mul_of_summable_norm (R := ℝ) hr hr).mul_left C
-  apply Summable.of_nonneg_of_le (fun _ => norm_nonneg _) _ hp
-  intro p
