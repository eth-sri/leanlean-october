+private def correctedRemainderOperator (W : ℝ → Ell2 →L[ℂ] Ell2) (δ s : ℝ) : L2Z →L[ℂ] L2Z := by
+  classical
+  exact if h : Summable (fun p => ‖correctedRemainderMatrix W δ s p‖ ^ 2) then
+    hsMatrixOp (correctedRemainderMatrix W δ s) h else 0
