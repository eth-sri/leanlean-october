+    hF₀im ▸ exists_localConformal_isBoundaryParam hR₀ F₀ hF₀s hF₀hol hF₀inj
+      (fun z hz => hF₀nz z (sphere_subset_closedBall hz)) (hF₀im.symm ▸ hS.isLipschitzDomain)
