-      p ∈ frontier Ω ∧ F '' (ball (0 : ℂ) 1 ∩ ball ζ r) ⊆ ball p R := by
-  obtain ⟨γ, ⟨K, hK⟩, hper, hγinj, hγimage⟩ :=
-    exists_jordanParam_of_isPreconnected_frontier hb hL
