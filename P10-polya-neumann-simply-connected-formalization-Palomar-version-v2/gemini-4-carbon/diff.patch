-      ContinuousLinearMap.comp_apply, ContinuousLinearMap.comp_apply, adjoint_inner_right]
-  have hb := hE z ((hmemZ z).2 hzj)
-  rw [hPy, hpz, hSy]
-  exact hb
-
-end PolyaNeumann
-
-end
