-theorem h1BoundaryNormalXMultiplier_ae {Ω : Set ℂ} {γ : ℝ → ℂ}
-    (hγ : IsBoundaryParam Ω γ) (g : BoundaryL2) :
-    (h1BoundaryNormalXMultiplier hγ g : ℝ → ℂ) =ᵐ[
-      volume.restrict (Ioc (0 : ℝ) (2 * π))]
