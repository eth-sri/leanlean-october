+  have hFtr : physicalCircleTrace F = physicalCircleTrace Hφ :=
+    funext fun θ => hFHφ (circleMap_mem_closedBall 0 (by norm_num) θ)
+  have hΓF₁ : ContDiff ℝ 1 (physicalCircleTrace F) :=
+    hFtr ▸ hΓφ.of_le (WithTop.coe_le_coe.mpr le_top)
