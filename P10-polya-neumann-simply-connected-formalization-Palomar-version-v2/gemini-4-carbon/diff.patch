+      change dirD G Complex.I (ζ t) = T (Complex.I / c) at hY
+      have hv_split : v = (c * v).re • (1 / c : ℂ) + (c * v).im • (Complex.I / c) := by
+        calc v = (c * v) / c := (mul_div_cancel_left₀ v hc).symm
+          _ = (((c * v).re : ℂ) + ((c * v).im : ℂ) * Complex.I) / c := by rw [Complex.re_add_im]
