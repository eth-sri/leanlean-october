-lemma continuous_circPt (x₀ : ℂ) : Continuous (Function.uncurry (circPt x₀)) := by
-  unfold circPt; exact continuous_const.add
-    ((Complex.continuous_ofReal.comp continuous_fst).mul (continuous_eI.comp continuous_snd))
