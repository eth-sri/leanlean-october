+private lemma norm_fourier_le (f : ℂ → ℂ) (ξ : ℂ) : ‖𝓕 f ξ‖ ≤ ∫ x, ‖f x‖ := by
+  rw [fourier_eq_ePlane]
+  refine (norm_integral_le_integral_norm _).trans_eq ?_
+  congr 1; funext x; rw [norm_mul, norm_ePlane, one_mul]
