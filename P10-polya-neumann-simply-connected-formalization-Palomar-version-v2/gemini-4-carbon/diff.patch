-      boundary_liftIoc_eq_liftIco_ae (g : ℝ → ℂ)] with x hx hrep
-    rw [hx, hrep, liftIco_eq_comp, liftIco_eq_comp]
-  rw [integral_congr_ae he]
-  exact two_pi_mul_integral_liftIco _
