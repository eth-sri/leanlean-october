-    apply ContinuousOn.intervalIntegrable_of_Icc Real.two_pi_pos.le
-    exact hγ.continuous_deriv_one.continuousOn.div
-      (hγ.continuous.sub continuous_const).continuousOn
-      (fun θ hθ => sub_ne_zero.mpr (havoid θ hθ))
