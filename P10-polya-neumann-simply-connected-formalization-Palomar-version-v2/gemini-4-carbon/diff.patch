-    simp only [roughNormalizedLoadCoeff, fromL2, lp.coeFn_sub, Pi.sub_apply,
-      zeroModeProjection_apply, if_neg hn, zero_mul, sub_zero]
-
-theorem rough_test_derivative_memℓp (t : L2Z)
