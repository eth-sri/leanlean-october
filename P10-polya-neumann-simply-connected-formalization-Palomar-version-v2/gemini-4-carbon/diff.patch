-      (volume.restrict U) ∧
-    ∀ i : Fin 2, MemLp
-      (dirD (fun z => v (smoothDirichletGraphChart p c hc f hf.continuous z)) (coordDir i))
-      2 (volume.restrict U) := by
-  let Ψ := smoothDirichletGraphChart p c hc f hf.continuous
-  have hK : 0 < K + 1 := by positivity
