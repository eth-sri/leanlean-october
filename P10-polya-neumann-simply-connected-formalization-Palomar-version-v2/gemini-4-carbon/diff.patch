-theorem h1BoundaryNormalYMultiplier_ae {Ω : Set ℂ} {γ : ℝ → ℂ}
-    (hγ : IsBoundaryParam Ω γ) (g : BoundaryL2) :
-    (h1BoundaryNormalYMultiplier hγ g : ℝ → ℂ) =ᵐ[
-      volume.restrict (Ioc (0 : ℝ) (2 * π))]
-      fun θ => (-(deriv γ θ).re : ℂ) * g θ :=
