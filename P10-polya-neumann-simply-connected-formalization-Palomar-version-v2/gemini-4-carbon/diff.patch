+        normalizedArcCurve_factorization hΓ₁ hp₀ hv₀ (θ + φ)
+    _ = normalizedArcCurve hΓ₁ hp₀ hv₀ (τ θ + t) := by
+        congr 1; simp [τ, rotateTraceReparam, hφval]
+    _ = γ (τ θ) := (hshift (τ θ)).symm
 
 end PolyaNeumann
 end
