-theorem finiteFourierChart_nonpositive_part_finite {d : ℕ}
-    (u : Fin d → nonpositiveFourierSubspaceᗮ) (v : Fin d → L2Z)
-    (hv : ∀ r, (Function.support (v r : ℤ → ℂ)).Finite)
