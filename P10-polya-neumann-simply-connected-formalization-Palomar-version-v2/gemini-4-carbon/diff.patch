-      c * ∫ θ in (0 : ℝ)..(2 * Real.pi), q θ := by
-    rw [windingNumber]
-    change (2 * Real.pi * Complex.I) * c *
-      ((2 * Real.pi * Complex.I)⁻¹ * ∫ θ in (0 : ℝ)..(2 * Real.pi), q θ) = _
