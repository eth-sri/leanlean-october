-/-- Its primitive `Q(θ) = ∫₀^θ q`. -/
-def herglotzQ (k : ℝ) (a : ℝ → ℂ) (γ : ℝ → ℂ) (θ : ℝ) : ℂ :=
-  ∫ t in (0 : ℝ)..θ, herglotzQd k a γ t
