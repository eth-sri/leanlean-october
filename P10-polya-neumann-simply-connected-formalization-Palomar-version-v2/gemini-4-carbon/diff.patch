+private lemma norm_fourier_sub_le {f : ℂ → ℂ} (hf : Integrable f)
+    (hf' : Integrable fun x => ‖x‖ * ‖f x‖) (ξ η : ℂ) :
+    ‖𝓕 f ξ - 𝓕 f η‖ ≤ 2 * π * (∫ x, ‖x‖ * ‖f x‖) * ‖ξ - η‖ := by
