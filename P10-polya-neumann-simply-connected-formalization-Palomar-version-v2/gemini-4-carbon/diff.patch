-theorem neumann_operator_eigenpair_of_resolvent {Ω : Set ℂ} (hΩ : IsOpen Ω)
-    {eigenCoefficient : ℝ} (heigenCoefficient : 0 < eigenCoefficient) {u : L2 Ω} (hu : neumannResolvent Ω u = (eigenCoefficient : ℂ) • u) :
