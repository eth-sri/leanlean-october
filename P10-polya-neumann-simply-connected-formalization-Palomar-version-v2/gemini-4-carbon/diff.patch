-      M * ∑ j ∈ Finset.range k, (k.choose j : ℝ) *
-        ‖dirichletTangentialDifferenceIter h j v z‖ := by
-  refine (norm_dirichletHigherCoefficientCommutator_le h k c v z).trans ?_
