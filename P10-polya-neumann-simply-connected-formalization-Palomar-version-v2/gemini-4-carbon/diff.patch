-        neumannOperatorVector Ω ((c + 1) • u) := Subtype.ext hKu.symm
-    rw [huv, neumannOperator_apply_vector hΩ, hKu, add_smul, one_smul, add_sub_cancel_right]
-
-end PolyaNeumann
-
-end
