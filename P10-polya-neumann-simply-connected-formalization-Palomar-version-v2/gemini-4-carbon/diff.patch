-      z + (t : ℂ) ∈ smoothDirichletClosedHalfBox A b := by
-    have hx : |z.re + t| ≤ A := by
-      calc
-        |z.re + t| ≤ |z.re| + |t| := abs_add_le _ _
-        _ ≤ a + h := add_le_add hz.1 (by rw [abs_of_nonneg ht.1]; exact ht.2)
-        _ ≤ A := hmargin
