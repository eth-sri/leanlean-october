+          rw [norm_symD, ← hk,
+            show 4 * π ^ 2 * k ^ 2 - 4 * π ^ 2 * ‖ξ‖ ^ 2 = 4 * π ^ 2 * ((k - ‖ξ‖) * (k + ‖ξ‖)) by ring,
+            abs_mul, abs_of_pos (by positivity : (0 : ℝ) < 4 * π ^ 2), abs_mul,
+            abs_of_pos (by positivity : (0 : ℝ) < k + ‖ξ‖), abs_sub_comm k ‖ξ‖]
