-        TF ((h1ResonantSpace ΩF E₀).starProjection (herglotzWaveH1 hb ha (Real.sqrt E₀))) := by
-  rw [localConformal_regularHerglotzH1_eq_sub_resonant hR F hFs hb hL hhol hinj
-    hC hγ hτ hcoord hE₀ ha, map_sub]
