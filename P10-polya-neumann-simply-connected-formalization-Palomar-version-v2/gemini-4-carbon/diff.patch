-/-- Actual Cauchy decomposition about an arbitrary constant density. -/
-theorem physicalWeightedCauchy_eq_subtract_constant
-    (γ : ℝ → ℂ) (hγ : ContDiff ℝ 1 γ) (K : ℝ → ℂ) (hK : Continuous K)
