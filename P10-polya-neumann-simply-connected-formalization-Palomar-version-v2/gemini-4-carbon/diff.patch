+private theorem normalizedPeriodicBoundaryFamily_isSelfAdjoint {Ω : Set ℂ}
+    (Q : NeumannH1 Ω →L[ℂ] L2Z) {γ : ℝ → ℂ} {K : NNReal}
+    (Ws : ℝ → ℝ → Ell2 →L[ℂ] Ell2) {E : ℝ}
