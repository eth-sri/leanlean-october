-theorem rectangularL2Energy_swap (a b c d : ℝ) (f : ℝ × ℝ → ℂ) :
-    rectangularL2Energy c d a b (fun p => f (p.2, p.1)) = rectangularL2Energy a b c d f := by
-  exact integral_prod_swap (fun p => ‖f p‖ ^ 2)
