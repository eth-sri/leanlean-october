-theorem smoothDirichletGraphChart_pullback_memLp {Ω U : Set ℂ}
-    (hΩ : IsOpen Ω) (hU : IsOpen U) (p c : ℂ) (hc : c ≠ 0) (hc₁ : ‖c‖ = 1)
