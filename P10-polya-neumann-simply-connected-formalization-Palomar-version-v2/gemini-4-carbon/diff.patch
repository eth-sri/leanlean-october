-        rw [smul_smul, inv_mul_cancel₀ hc, one_smul]
-      _ = (c + 1)⁻¹ • u := congrArg ((c + 1)⁻¹ • ·) h
-  · intro hK
-    have hKu : neumannResolvent Ω ((c + 1) • u) = u := by
-      rw [map_smul, hK, smul_smul, mul_inv_cancel₀ hc, one_smul]
