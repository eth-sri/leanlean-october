+      have hs := integral_signedAreaDensity_shift hδ.periodic (-(2 * Real.pi))
+      rw [neg_add_cancel] at hs
+      rw [hs, hδa]; ring
+    have hvolpos : 0 < (volume Ω).toReal :=
+      ENNReal.toReal_pos (hΩ.1.measure_pos volume hΩ.2.nonempty).ne' hb.measure_lt_top.ne
+    linarith
