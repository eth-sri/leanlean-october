-    (hΓLip : LipschitzWith L (physicalCircleTrace F))
-    {a : ℝ → ℂ} (ha : IsDirDensity a) (k : ℝ) : BoundaryL2 :=
-  (memLp_herglotzConormal ha k hΓLip).toLp
-    (herglotzConormal k a (physicalCircleTrace F))
