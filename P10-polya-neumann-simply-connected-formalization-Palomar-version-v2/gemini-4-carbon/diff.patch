-    {A a b h M : ℝ} (hh : 0 < h) (hmargin : a + h ≤ A)
-    {c : ℂ → ℂ} (hc : ContDiff ℝ (⊤ : ℕ∞) c)
-    (hM : ∀ z ∈ smoothDirichletClosedHalfBox A b, ‖dirD c 1 z‖ ≤ M)
-    {z : ℂ} (hz : z ∈ smoothDirichletClosedHalfBox a b) :
-    ‖dirichletTangentialDifference h c z‖ ≤ M := by
