+  have hn₂ : ‖hm'.toLp _‖ ^ 2 = ∫ s in (0 : ℝ)..t, ‖dv s‖ ^ 2 := by
+    rw [norm_sq_toLp_eq_integral, intervalIntegral.integral_of_le ht.1.le]
+  rw [mul_pow, hn₁, hn₂, hprim] at hnormsq
+  exact hnormsq
