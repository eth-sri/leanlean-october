module

public import RequestProject.MollifierEstimate

/-!
# Rellich compactness from a covering by shiftable pieces

Let `Ω ⊂ ℂ` be a bounded open set, covered by finitely many open sets `W_j ⊆ Ω` such that for
every `η > 0` each `W_j` admits a small closed ball `B̄(a_j, r_j)` (with `‖a_j‖ + r_j ≤ η`) of
admissible shifts: all segments `t - s z` with `t ∈ W_j`, `z ∈ B̄(a_j, r_j)`, `0 ≤ s ≤ 1` stay in
`Ω`. Then every sequence bounded in `H¹(Ω)` has an `L²(Ω)`-convergent subsequence.

The proof is the Kolmogorov–Riesz argument: on each piece `Q_j` of the partition generated by
the `W_j`, `u` is approximated within `η (‖g₀‖ + ‖g₁‖)` by the mollification `ρ_j ⋆ U` with a
bump `ρ_j` supported in `B̄(a_j, r_j)` (`l2norm_indicator_sub_mollify_le`); for fixed bumps the
mollifications of a bounded sequence are uniformly bounded and uniformly Lipschitz, hence lie in
a compact set of continuous functions (Arzelà–Ascoli).
-/

@[expose] public section

open MeasureTheory Filter Topology Metric Set

noncomputable section

open scoped ContDiff

namespace PolyaNeumann

variable {m : ℕ} {K : Set ℂ}

/-- A compactness criterion: a sequence in a complete metric space that is, for every `ε > 0`,
within `ε` of some compact set, has a convergent subsequence. -/
theorem exists_tendsto_subseq_of_compact_approx {X : Type*} [MetricSpace X] [CompleteSpace X]
    u (h : ∀ ε > 0, ∃ S : Set X, IsCompact S ∧ ∀ n, ∃ y ∈ S, dist (u n) y ≤ ε) :
    ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∃ v, Tendsto (u ∘ φ) atTop (𝓝 v) := by
  obtain ⟨v, -, φ, hφ, hlim⟩ := ((show TotallyBounded (range u) by
    rw [Metric.totallyBounded_iff]
    intro ε hε
    obtain ⟨S, hS, hSu⟩ := h (ε / 3) (by positivity)
    obtain ⟨t, ht, htS⟩ := Metric.totallyBounded_iff.mp hS.totallyBounded (ε / 3) (by positivity)
    refine ⟨t, ht, ?_⟩
    rintro _ ⟨n, rfl⟩
    obtain ⟨y, hyS, hy⟩ := hSu n
    obtain ⟨z, hz, hyz⟩ := mem_iUnion₂.mp (htS hyS)
    refine mem_iUnion₂.mpr ⟨z, hz, ?_⟩
    rw [mem_ball] at hyz ⊢
    linarith [dist_triangle (u n) y z]).closure.isCompact_of_isClosed isClosed_closure).tendsto_subseq (x := u) fun n => subset_closure ⟨n, rfl⟩
  exact ⟨φ, hφ, v, hlim⟩

/-- The pieces `Q_j = W_j \ ⋃_{i<j} W_i` of the partition generated by a finite cover. -/
local notation "Φ0" => Fin m

def partPiece  (W : Φ0 → Set ℂ) (j : Φ0) : Set ℂ :=
  W j \ ⋃ (i : Φ0) (_ : i < j), W i

lemma measurableSet_partPiece  {W : Φ0 → Set ℂ} (hW : ∀ j, MeasurableSet (W j))
    (j : Φ0) : MeasurableSet (partPiece W j) :=
  (hW j).diff (MeasurableSet.iUnion fun i => MeasurableSet.iUnion fun _ => hW i)

lemma sum_indicator_partPiece  (W : Φ0 → Set ℂ) (h : ℂ → ℂ) {x : ℂ}
    (hx : x ∈ ⋃ j, W j) : ∑ j, (partPiece W j).indicator h x = h x := by
  obtain ⟨j, hj⟩ : ∃ j, x ∈ partPiece W j := by
    classical
    have hne : (Finset.univ.filter fun j => x ∈ W j).Nonempty := by
      obtain ⟨j, hj⟩ := mem_iUnion.mp hx
      exact ⟨j, by simp [hj]⟩
    set j0 := (Finset.univ.filter fun j => x ∈ W j).min' hne
    refine ⟨j0, (by
      simpa using (Finset.min'_mem _ hne)), ?_⟩
    simp
    intro i hi hxi
    exact absurd hi (not_lt.mpr (Finset.min'_le _ i (by simp [hxi])))
  rw [Finset.sum_eq_single j]
  · simp [hj]
  · intro i _ hij
    have : x ∉ partPiece W i := fun hi => hij (by
      rcases lt_trichotomy i j with h | h | h
      · exact absurd (mem_iUnion₂.mpr ⟨i, h, hi.1⟩) hj.2
      · exact h
      · exact absurd (mem_iUnion₂.mpr ⟨j, h, hj.1⟩) hi.2)
    simp [this]
  · simp

open Classical in
/-- Extension by zero of a bounded continuous function on `K ⊆ ℂ`. -/
def extBCF  (f : BoundedContinuousFunction K ℂ) : ℂ → ℂ :=
  fun x => if h : x ∈ K then f ⟨x, h⟩ else 0

lemma norm_extBCF_le  (f : BoundedContinuousFunction K ℂ) x :
    ‖extBCF f x‖ ≤ ‖f‖ := by
  unfold extBCF
  split_ifs with h
  · exact f.norm_coe_le_norm _
  · simp

lemma extBCF_sub  (f f' : BoundedContinuousFunction K ℂ) x :
    extBCF f x - extBCF f' x = extBCF (f - f') x := by
  unfold extBCF
  split_ifs with h <;> simp

/-- The combination `∑_j 1_{Q_j} f_j` of bounded continuous functions as an element of
`L²(Ω)`. -/
lemma memLp_sum_piece {Ω K : Set ℂ} (hK : IsClosed K) (hΩK : Ω ⊆ K) (hΩ : volume Ω ≠ ⊤)
     {Q : Φ0 → Set ℂ} (hQ : ∀ j, MeasurableSet (Q j))
    (f : Φ0 → BoundedContinuousFunction K ℂ) :
    MemLp (fun x => ∑ j, (Q j).indicator (extBCF (f j)) x) 2 (volume.restrict Ω) := by
  haveI : IsFiniteMeasure (volume.restrict Ω) := isFiniteMeasure_restrict.mpr hΩ
  refine memLp_finset_sum _ fun j _ => ?_
  refine MemLp.of_bound ((show AEStronglyMeasurable (extBCF (f j)) (volume.restrict Ω) by
    exact ((show ContinuousOn (extBCF (f j)) K by
      rw [continuousOn_iff_continuous_domRestrict]
      have : K.domRestrict (extBCF (f j)) = f j := by
        ext ⟨x, hx⟩; simp [extBCF, hx]
      rw [this]; exact (f j).continuous).aestronglyMeasurable hK.measurableSet).mono_measure (Measure.restrict_mono hΩK le_rfl)).indicator (hQ j)) ‖f j‖
    (Eventually.of_forall fun x => ?_)
  by_cases hx : x ∈ Q j
  · simp [hx]; exact norm_extBCF_le _ _
  · simp [hx]

/-- The map `(f_j)_j ↦ ∑_j 1_{Q_j} f_j` into `L²(Ω)`. -/
def pieceMap {Ω K : Set ℂ} (hK : IsClosed K) (hΩK : Ω ⊆ K) (hΩ : volume Ω ≠ ⊤)
     {Q : Φ0 → Set ℂ} (hQ : ∀ j, MeasurableSet (Q j))
    (f : Φ0 → BoundedContinuousFunction K ℂ) : L2 Ω :=
  (memLp_sum_piece hK hΩK hΩ hQ f).toLp _

lemma mollify_eq_flip ρ U x :
    mollify ρ U x = ∫ t, ρ (x - t) • U t := by
  rw [mollify, convolution_def]
  simp only [ContinuousLinearMap.lsmul_apply]
  rw [← integral_sub_left_eq_self (fun t => ρ t • U (x - t)) (μ := volume) x]
  simp

/-- Uniform bounds for mollifications: `|ρ ⋆ U| ≤ M ‖U‖₁` and `ρ ⋆ U` is `L ‖U‖₁`-Lipschitz. -/
lemma mollify_bounds  (hρ : ContDiff ℝ ∞ ρ) (hρs : HasCompactSupport ρ) :
    ∃ M L : ℝ, 0 ≤ M ∧ 0 ≤ L ∧ ∀ U : ℂ → ℂ, Integrable U →
      (∀ x, ‖mollify ρ U x‖ ≤ M * ∫ t, ‖U t‖) ∧
      (∀ x y, ‖mollify ρ U x - mollify ρ U y‖ ≤ L * (∫ t, ‖U t‖) * ‖x - y‖) := by
  obtain ⟨M, hM⟩ := hρs.exists_bound_of_continuous hρ.continuous
  obtain ⟨L, hL⟩ := hρ.lipschitzWith_of_hasCompactSupport hρs (by simp)
  refine ⟨M, L, (norm_nonneg _).trans (hM 0), L.2, fun U hU => ⟨fun x => ?_, fun x y => ?_⟩⟩
  · rw [mollify_eq_flip]
    calc _ ≤ _ := by
          refine norm_integral_le_of_norm_le (hU.norm.const_mul M)
            (Eventually.of_forall fun t => ?_)
          rw [norm_smul]; gcongr; exact hM _
      _ = _ := integral_const_mul _ _
  · rw [mollify_eq_flip, mollify_eq_flip]
    have hi : ∀ z, Integrable (fun t => ρ (z - t) • U t) := fun z =>
      (hU.norm.const_mul M).mono' ((hρ.continuous.comp (continuous_const.sub continuous_id)
        ).aestronglyMeasurable.smul hU.aestronglyMeasurable)
        (Eventually.of_forall fun t => by rw [norm_smul]; gcongr; exact hM _)
    rw [← integral_sub (hi x) (hi y)]
    calc ‖∫ t, (ρ (x - t) • U t - ρ (y - t) • U t)‖ ≤ ∫ t, L * ‖x - y‖ * ‖U t‖ := by
          refine norm_integral_le_of_norm_le (hU.norm.const_mul _)
            (Eventually.of_forall fun t => ?_)
          rw [← sub_smul, norm_smul]
          gcongr
          simpa [dist_eq_norm] using hL.dist_le_mul (x - t) (y - t)
      _ = L * (∫ t, ‖U t‖) * ‖x - y‖ := by rw [integral_const_mul]; ring

/-- `‖U‖₁ ≤ |Ω|^{1/2} ‖u‖` for the extension by zero. -/
lemma integral_norm_extZero_le  (hΩ : MeasurableSet Ω) (hΩf : volume Ω ≠ ⊤)
    u : Integrable (extZero Ω u) ∧
      ∫ t, ‖extZero Ω u t‖ ≤ (volume Ω).toReal ^ (1 / 2 : ℝ) * ‖u‖ := by
  haveI : IsFiniteMeasure (volume.restrict Ω) := isFiniteMeasure_restrict.mpr hΩf
  have hu1 := (Lp.memLp u).integrable one_le_two
  refine ⟨(integrable_indicator_iff hΩ).mpr hu1, ?_⟩
  rw [show ∫ t, ‖extZero Ω u t‖ = ∫ t in Ω, ‖u t‖ by
    rw [← integral_indicator hΩ]
    congr 1; ext t; by_cases ht : t ∈ Ω <;> simp [extZero, ht]]
  have h1 := eLpNorm_le_eLpNorm_mul_rpow_measure_univ (μ := volume.restrict Ω)
    (p := 1) (q := 2) (by norm_num) (Lp.memLp u).aestronglyMeasurable
  rw [Measure.restrict_apply_univ] at h1
  rw [show eLpNorm u 1 (volume.restrict Ω) = ENNReal.ofReal (∫ t in Ω, ‖u t‖) by
    rw [(memLp_one_iff_integrable.mpr hu1).eLpNorm_eq_integral_rpow_norm (by norm_num)
      (by norm_num)]
    simp] at h1
  have := ENNReal.toReal_mono (ENNReal.mul_ne_top (Lp.memLp u).eLpNorm_ne_top
    (ENNReal.rpow_ne_top_of_nonneg (by norm_num) hΩf)) h1
  rw [ENNReal.toReal_ofReal (integral_nonneg fun _ => norm_nonneg _), ENNReal.toReal_mul, ← ENNReal.toReal_rpow] at this
  rw [Lp.norm_def]
  norm_num at this ⊢
  linarith

/-- **Arzelà–Ascoli** for uniformly bounded, uniformly Lipschitz sequences on a compact set. -/
lemma isCompact_closure_range_bcf  [CompactSpace K] (F : ℕ → BoundedContinuousFunction K ℂ)
    B L (hB : ∀ n x, ‖F n x‖ ≤ B) (hL : ∀ n x y, ‖F n x - F n y‖ ≤ L * dist x y) :
    IsCompact (closure (range F)) := by
  refine BoundedContinuousFunction.arzela_ascoli (closedBall 0 B) (isCompact_closedBall 0 B)
    (range F) ?_ ?_
  · rintro _ x ⟨n, rfl⟩
    simpa using hB n x
  · refine Metric.equicontinuous_of_continuity_modulus (fun d => L * d) ?_ _ ?_
    · simpa using (tendsto_id (x := 𝓝 0)).const_mul L
    · rintro x y ⟨_, n, rfl⟩
      rw [dist_eq_norm]; exact hL n x y

/-- **Rellich compactness from a cover by shiftable pieces.** -/
theorem rellich_of_cover {Ω : Set ℂ} (hΩ : IsOpen Ω) (hb : Bornology.IsBounded Ω) 
    (W : Φ0 → Set ℂ) (hWo : ∀ j, IsOpen (W j)) (hWΩ : ∀ j, W j ⊆ Ω)
    (hcov : Ω ⊆ ⋃ j, W j)
    (hshift : ∀ η > 0, ∀ j, ∃ a : ℂ, ∃ r > 0, ‖a‖ + r ≤ η ∧
      ∀ t ∈ W j, ∀ z ∈ closedBall a r, ∀ s ∈ Icc (0 : ℝ) 1, t - s • z ∈ Ω)
    (u : ℕ → L2 Ω) (g : ℕ → Fin 2 → L2 Ω) (hg : ∀ n, IsWeakGradient Ω (u n) (g n)) (C : ℝ)
    (hu : ∀ n, ‖u n‖ ≤ C) (hgC : ∀ n i, ‖g n i‖ ≤ C) :
    ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∃ v : L2 Ω, Tendsto (u ∘ φ) atTop (𝓝 v) := by
  classical
  have hΩm := hΩ.measurableSet
  have hΩf : volume Ω ≠ ⊤ := hb.measure_lt_top.ne
  set K := closure Ω
  haveI : CompactSpace K := isCompact_iff_compactSpace.mp hb.isCompact_closure
  have hKcl : IsClosed K := isClosed_closure
  have hΩK : Ω ⊆ K := subset_closure
  have hC0 := (norm_nonneg _).trans (hu 0)
  set Q := partPiece W
  have hQm := measurableSet_partPiece fun j => (hWo j).measurableSet
  refine exists_tendsto_subseq_of_compact_approx u fun ε hε => ?_
  set η := ε / ((m + 1) * (2 * C + 1))
  have hη : 0 < η := by positivity
  choose a r hr hηj hseg using hshift η hη
  let bump : ∀ j, ContDiffBump (a j) := fun j => ⟨r j / 2, r j, by linarith [hr j],
    by linarith [hr j]⟩
  set ρ : Φ0 → ℂ → ℝ := fun j => (bump j).normed volume
  have hρd : ∀ j, ContDiff ℝ (⊤ : ℕ∞) (ρ j) := fun j => (bump j).contDiff_normed
  have hρs : ∀ j, HasCompactSupport (ρ j) := fun j => (bump j).hasCompactSupport_normed
  have hρt : ∀ j, tsupport (ρ j) = closedBall (a j) (r j) := fun j => (bump j).tsupport_normed_eq
  choose M L hM0 hL0 hML using fun j => mollify_bounds (hρd j) (hρs j)
  set U : ℕ → ℂ → ℂ := fun n => extZero Ω (u n)
  have hUi : ∀ n, Integrable (U n) := fun n => (integral_norm_extZero_le hΩm hΩf (u n)).1
  set I0 := (volume Ω).toReal ^ (1 / 2 : ℝ) * C
  have hUI : ∀ n, ∫ t, ‖U n t‖ ≤ I0 := fun n =>
    (integral_norm_extZero_le hΩm hΩf (u n)).2.trans
      (mul_le_mul_of_nonneg_left (hu n) (by positivity))
  have hmc : ∀ j n, Continuous (mollify (ρ j) (U n)) := fun j n =>
    (hρs j).continuous_convolution_left _ (hρd j).continuous (hUi n).locallyIntegrable
  let F : ℕ → Φ0 → BoundedContinuousFunction K ℂ := fun n j =>
    BoundedContinuousFunction.mkOfCompact
      ⟨fun x => mollify (ρ j) (U n) x, (hmc j n).comp continuous_subtype_val⟩
  have hFa : ∀ n j x, F n j x = mollify (ρ j) (U n) x := fun _ _ _ => rfl
  set A :=
    Set.pi univ (fun j => closure (range fun n => F n j))
  refine ⟨pieceMap hKcl hΩK hΩf hQm '' A, (show IsCompact A by
    refine isCompact_univ_pi fun j => isCompact_closure_range_bcf _ (M j * I0) (L j * I0) ?_ ?_
    · intro n x
      rw [hFa]
      refine ((hML j (U n) (hUi n)).1 x).trans ?_
      exact mul_le_mul_of_nonneg_left (hUI n) (hM0 j)
    · intro n x y
      rw [hFa, hFa]
      refine ((hML j (U n) (hUi n)).2 x y).trans ?_
      rw [Subtype.dist_eq, dist_eq_norm]
      gcongr
      · exact hL0 j
      exact hUI n).image (by
    set κ : NNReal := ⟨(volume Ω).toReal ^ (1 / 2 : ℝ) * m, by positivity⟩
    refine (LipschitzWith.of_dist_le_mul (K := κ) fun f f' => ?_).continuous
    rw [dist_eq_norm, pieceMap, pieceMap, ← MemLp.toLp_sub, Lp.norm_toLp]
    have hb : ∀ x, ‖(fun x => ∑ j, (Q j).indicator (extBCF (f j)) x) x -
        (fun x => ∑ j, (Q j).indicator (extBCF (f' j)) x) x‖ ≤ m * dist f f' := by
      intro x
      simp only
      rw [← Finset.sum_sub_distrib]
      refine (norm_sum_le _ _).trans ?_
      calc _ ≤ _ := Finset.sum_le_sum fun j _ => (show ∀ j, ‖(Q j).indicator (extBCF (f j)) x - (Q j).indicator (extBCF (f' j)) x‖ ≤ dist f f' by
        intro j
        by_cases hx : x ∈ Q j
        · simp [hx, extBCF_sub]
          refine (norm_extBCF_le _ _).trans ?_
          rw [← dist_eq_norm]; exact dist_le_pi_dist f f' j
        · simp [hx]) j
        _ = _ := by simp
    have := eLpNorm_le_of_ae_bound (μ := volume.restrict Ω) (p := 2)
      ((memLp_sum_piece hKcl hΩK hΩf hQm f).sub (memLp_sum_piece hKcl hΩK hΩf hQm f')).aestronglyMeasurable
      (Eventually.of_forall hb)
    rw [Measure.restrict_apply_univ] at this
    calc _ ≤ _ :=
          ENNReal.toReal_mono (ENNReal.mul_ne_top (ENNReal.rpow_ne_top_of_nonneg (by norm_num) hΩf)
            ENNReal.ofReal_ne_top) this
      _ = _ := by
          rw [ENNReal.toReal_mul, ENNReal.toReal_ofReal (by positivity), ← ENNReal.toReal_rpow, show κ = (volume Ω).toReal ^ (1 / 2 : ℝ) * m from rfl]
          simp; ring),
    fun n => ⟨pieceMap hKcl hΩK hΩf hQm (F n), ⟨F n, fun j _ => subset_closure ⟨n, rfl⟩, rfl⟩, ?_⟩⟩
  -- the error on each piece
  set D : Φ0 → ℂ → ℂ := fun j => (Q j).indicator (fun x => U n x - mollify (ρ j) (U n) x)
  -- the difference is the sum of the piecewise errors
  rw [dist_eq_norm, Lp.norm_def, eLpNorm_congr_ae (show (fun x => (u n - pieceMap hKcl hΩK hΩf hQm (F n)) x) =ᵐ[volume.restrict Ω] ∑ j, D j by
    filter_upwards [Lp.coeFn_sub (u n) (pieceMap hKcl hΩK hΩf hQm (F n)),
      MemLp.coeFn_toLp (memLp_sum_piece hKcl hΩK hΩf hQm (F n)), ae_restrict_mem hΩm]
      with x h1 h2 hx
    rw [h1, Pi.sub_apply, pieceMap, h2, Finset.sum_apply]
    have hext : ∀ j, extBCF (F n j) x = mollify (ρ j) (U n) x := fun j => by
      simp [extBCF, hΩK hx, hFa]
    rw [show u n x = U n x by simp [U, extZero, hx]]
    conv_lhs => rw [← sum_indicator_partPiece W (U n) (hcov hx)]
    rw [← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun j _ => ?_
    by_cases hxq : x ∈ partPiece W j
    · simp [D, Q, hxq, hext j]
    · simp [D, Q, hxq])]
  have hsum : eLpNorm (∑ j, D j) 2 (volume.restrict Ω) ≤ ENNReal.ofReal (m * (η * (2 * C))) := by
    calc _ ≤ _ :=
          eLpNorm_mono_measure _ Measure.restrict_le_self
      _ ≤ _ := by
          exact eLpNorm_sum_le (by norm_num)
      _ ≤ _ := Finset.sum_le_sum fun j _ => (show ∀ j, eLpNorm (D j) 2 volume ≤ ENNReal.ofReal (η * (2 * C)) by
        intro j
        obtain ⟨hmem, hle⟩ := l2norm_indicator_sub_mollify_le hΩ (hg n) (hWo j)
          (hb.subset (hWΩ j)) (hρd j).continuous (hρs j) (fun z => (bump j).nonneg_normed z)
          (bump j).integral_normed hη.le (by
            intro z hz
            rw [hρt j, mem_closedBall, dist_eq_norm] at hz
            have := norm_sub_norm_le z (a j)
            linarith [hηj j])
          (fun t ht z hz s hs => hseg j t ht z (by rwa [hρt j] at hz) s hs)
        calc eLpNorm (D j) 2 volume ≤
              eLpNorm ((W j).indicator fun x => U n x - mollify (ρ j) (U n) x) 2 volume := by
              refine eLpNorm_mono (((hUi n).aestronglyMeasurable.sub
                (hmc j n).aestronglyMeasurable).indicator (hQm j)) fun x => ?_
              by_cases hx : x ∈ Q j
              · simp [D, hx, diff_subset hx]
              · simp [D, hx]
          _ = _ :=
              (ENNReal.ofReal_toReal hmem.eLpNorm_ne_top).symm
          _ ≤ _ := by
              refine ENNReal.ofReal_le_ofReal (hle.trans ?_)
              gcongr
              linarith [hgC n 0, hgC n 1]) j
      _ = _ := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul,
            ← ENNReal.ofReal_natCast, ← ENNReal.ofReal_mul (Nat.cast_nonneg _)]
  refine (ENNReal.toReal_mono ENNReal.ofReal_ne_top hsum).trans ?_
  rw [ENNReal.toReal_ofReal (by positivity)]
  have hm0 : 0 ≤ m := Nat.cast_nonneg m
  have : m * (2 * C) ≤ (m + 1) * (2 * C + 1) := by nlinarith
  calc _ = η * (m * (2 * C)) := by ring
    _ ≤ η * ((m + 1) * (2 * C + 1)) := by gcongr
    _ = ε := by
        simp [η]
        field_simp

end PolyaNeumann

end
