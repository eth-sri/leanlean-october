+  · exact ⟨1, Or.inl rfl, fun z hz => by rw [hin z hz, ← hσeq, h]; simp, hout⟩
+  · exact ⟨-1, Or.inr rfl, fun z hz => by rw [hin z hz, ← hσeq, h]; simp, hout⟩
 
-end
+end PolyaNeumann
