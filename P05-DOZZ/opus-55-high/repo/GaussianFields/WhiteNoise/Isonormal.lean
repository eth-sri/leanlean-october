instance instFact_two_ne_top : Fact ((2 : ℝ≥0∞) ≠ ∞) :=
  ⟨ENNReal.ofNat_ne_top⟩

theorem inner_toLp_real {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    {f g : Ω → ℝ} (hf : MemLp f 2 μ) (hg : MemLp g 2 μ) :
    ⟪hf.toLp f, hg.toLp g⟫_ℝ = ∫ ω, f ω * g ω ∂μ := by
  rw [MeasureTheory.L2.inner_def]
  refine integral_congr_ae ?_
  filter_upwards [hf.coeFn_toLp, hg.coeFn_toLp] with ω hfω hgω
  simp [hfω, hgω, mul_comm]

section GaussianL2

variable {ι : Type*}

/-- A single standard Gaussian coordinate as an element of `L²` of the product Gaussian space. -/
@[expose]
noncomputable def gaussianCoordinateLp (i : ι) :
    Lp ℝ 2 (gaussianSequenceMeasure ι) :=
  (memLp_gaussianCoordinate i).toLp (gaussianCoordinate i)
section
variable [DecidableEq ι]

/-- Product Gaussian coordinates are orthonormal in `L²(Ω)`. -/
theorem inner_gaussianCoordinateLp (i j : ι) :
    ⟪gaussianCoordinateLp i, gaussianCoordinateLp j⟫_ℝ =
      if i = j then 1 else 0 := by
  rw [gaussianCoordinateLp, gaussianCoordinateLp, inner_toLp_real]
  have hcov := covariance_gaussianCoordinate (ι := ι) i j
  rw [covariance_eq_sub (memLp_gaussianCoordinate i) (memLp_gaussianCoordinate j)] at hcov
  simpa [integral_gaussianCoordinate] using hcov

/-- Each Gaussian coordinate has `L²` norm one. -/
theorem norm_gaussianCoordinateLp (i : ι) :
    ‖gaussianCoordinateLp i‖ = 1 := by
  have hsq : ‖gaussianCoordinateLp i‖ ^ 2 = 1 := by
    rw [norm_sq_eq_re_inner (𝕜 := ℝ), inner_gaussianCoordinateLp]
    simp
  exact (sq_eq_sq₀ (norm_nonneg _) zero_le_one).mp (by linarith)

/-- The concrete Gaussian coordinate vectors form an orthonormal family in `L²(Ω)`. -/
theorem orthonormal_gaussianCoordinateLp :
    Orthonormal ℝ (fun i : ι => gaussianCoordinateLp i) := by
  rw [orthonormal_iff_ite]
  intro i j
  exact inner_gaussianCoordinateLp i j

end

/-- The one-dimensional line generated by a Gaussian coordinate. -/
@[expose]
noncomputable def gaussianCoordinateLine [DecidableEq ι] (i : ι) :
    ℝ →ₗᵢ[ℝ] Lp ℝ 2 (gaussianSequenceMeasure ι) :=
  LinearIsometry.toSpanSingleton ℝ (Lp ℝ 2 (gaussianSequenceMeasure ι))
    (norm_gaussianCoordinateLp i)

@[simp]
theorem gaussianCoordinateLine_apply [DecidableEq ι] (i : ι) (c : ℝ) :
    gaussianCoordinateLine i c = c • gaussianCoordinateLp i :=
  by rfl

/-- The isonormal Gaussian map on `ℓ²(ι)`, constructed as the Hilbert-space sum of independent
standard Gaussian coordinates. -/
@[expose]
noncomputable def gaussianL2Isometry [DecidableEq ι] :
    ℓ²(ι, ℝ) →ₗᵢ[ℝ] Lp ℝ 2 (gaussianSequenceMeasure ι) :=
  (orthonormal_gaussianCoordinateLp (ι := ι)).orthogonalFamily.linearIsometry


/-- The finite set of encoded indices below `n`. -/
@[expose]
noncomputable def gaussianIndexTruncation (ι : Type*) [Encodable ι] [DecidableEq ι]
    (n : ℕ) : Finset ι :=
  (Finset.range n).preimage (Encodable.encode : ι → ℕ) (by
    intro i _ j _ hij
    exact Encodable.encode_injective hij)

theorem tendsto_gaussianIndexTruncation (ι : Type*) [Encodable ι] [DecidableEq ι] :
    Tendsto (gaussianIndexTruncation ι) atTop (atTop : Filter (Finset ι)) := (Filter.tendsto_finset_preimage_atTop_atTop
    Encodable.encode_injective).comp
      Filter.tendsto_finset_range

/-- The deterministic finite `ℓ²` partial sum over a finite set of indices. -/
@[expose]
noncomputable def gaussianL2CoefficientPartialSum [DecidableEq ι] (s : Finset ι)
    (c : ℓ²(ι, ℝ)) : ℓ²(ι, ℝ) :=
  ∑ i ∈ s, lp.single (E := fun _ : ι => ℝ) 2 i (c i)

theorem norm_gaussianL2CoefficientPartialSum_sq [DecidableEq ι] (s : Finset ι)
    (c : ℓ²(ι, ℝ)) :
    ‖gaussianL2CoefficientPartialSum s c‖ ^ (2 : Nat) =
      ∑ i ∈ s, (c i) ^ (2 : Nat) := by
  have h := lp.norm_sum_single (p := 2)
    (by norm_num) (fun i => c i) s
  aesop
section
variable [DecidableEq ι] (c : ℓ²(ι, ℝ))

theorem hasSum_gaussianL2CoefficientPartialSum :
    HasSum (fun i : ι => lp.single (E := fun _ : ι => ℝ) 2 i (c i)) c := by
  simpa using
    (lp.hasSum_single
      ENNReal.ofNat_ne_top c)

theorem tendsto_gaussianL2CoefficientPartialSum :
    Tendsto (fun s : Finset ι => gaussianL2CoefficientPartialSum s c) atTop (𝓝 c) := by
  simpa [HasSum, gaussianL2CoefficientPartialSum] using
    (hasSum_gaussianL2CoefficientPartialSum c)

end
section
variable [Encodable ι] [DecidableEq ι] (c : ℓ²(ι, ℝ))

theorem tendsto_gaussianL2CoefficientPartialSum_truncation :
    Tendsto (fun n : ℕ => gaussianL2CoefficientPartialSum (gaussianIndexTruncation ι n) c)
      atTop (𝓝 c) :=
  (tendsto_gaussianL2CoefficientPartialSum c).comp (tendsto_gaussianIndexTruncation ι)

theorem tendsto_gaussianL2CoefficientPartialSum_truncation_norm_sq :
    Tendsto
      (fun n : ℕ => ‖gaussianL2CoefficientPartialSum (gaussianIndexTruncation ι n) c‖ ^
        (2 : Nat))
      atTop (𝓝 (‖c‖ ^ (2 : Nat))) := ((continuous_norm.tendsto _).comp
    (tendsto_gaussianL2CoefficientPartialSum_truncation c)).pow 2

theorem tendsto_gaussianLinearCombinationVariance_indexTruncation :
    Tendsto
      (fun n : ℕ =>
        (gaussianLinearCombinationVariance (gaussianIndexTruncation ι n) fun i => c i : ℝ))
      atTop (𝓝 (‖c‖ ^ (2 : Nat))) := by
  convert tendsto_gaussianL2CoefficientPartialSum_truncation_norm_sq c using 1
  ext n
  rw [coe_gaussianLinearCombinationVariance, norm_gaussianL2CoefficientPartialSum_sq]

end

/-- The finite `L²(Ω)` partial sum associated to an `ℓ²` coefficient vector. -/
@[expose]
noncomputable def gaussianPartialSumLp [DecidableEq ι] (s : Finset ι)
    (c : ℓ²(ι, ℝ)) : Lp ℝ 2 (gaussianSequenceMeasure ι) :=
  ∑ i ∈ s, c i • gaussianCoordinateLp i
section
variable [DecidableEq ι]


theorem gaussianPartialSumLp_insert {s : Finset ι} {i : ι}
    (hi : i ∉ s) (c : ℓ²(ι, ℝ)) :
    gaussianPartialSumLp (insert i s) c =
      c i • gaussianCoordinateLp i + gaussianPartialSumLp s c := by
  simp [gaussianPartialSumLp, Finset.sum_insert, hi]

end
section
variable [DecidableEq ι] (s : Finset ι) (c : ℓ²(ι, ℝ))

/-- The finite `Lp` partial sum is represented by the corresponding concrete finite Gaussian sum. -/
theorem gaussianPartialSumLp_coeFn :
    ⇑(gaussianPartialSumLp s c) =ᵐ[gaussianSequenceMeasure ι]
      gaussianLinearCombination s (fun i => c i) := by
  classical
  induction s using Finset.induction with
  | empty =>
      filter_upwards [Lp.coeFn_zero ℝ 2 (gaussianSequenceMeasure ι)] with ω hω
      simp [gaussianPartialSumLp, gaussianLinearCombination] at hω ⊢
  | insert i s hi ih =>
      have hsum :=
        gaussianPartialSumLp_insert hi c
      rw [hsum]
      filter_upwards [Lp.coeFn_add _
          (gaussianPartialSumLp s c),
        Lp.coeFn_smul (c i) (gaussianCoordinateLp i),
        (memLp_gaussianCoordinate i).coeFn_toLp,
        ih] with ω hadd hsmul hcoord hih
      rw [hadd]
      change ((c i • gaussianCoordinateLp i) ω +
          (gaussianPartialSumLp s c) ω) =
        gaussianLinearCombination _ (fun i => c i) ω
      rw [hsmul, hih]
      simp
      unfold gaussianCoordinateLp
      rw [hcoord]
      simp [Finset.sum_insert, hi]

/-- Finite `Lp` partial sums have the expected centered Gaussian law. -/
theorem map_gaussianPartialSumLp_eq_gaussianReal :
    Measure.map (gaussianPartialSumLp s c) (gaussianSequenceMeasure ι) =
      ProbabilityTheory.gaussianReal 0
        (gaussianLinearCombinationVariance s fun i => c i) := by
  calc
    Measure.map _ (gaussianSequenceMeasure ι) =
        Measure.map (gaussianLinearCombination s fun i => c i)
          (gaussianSequenceMeasure ι) := Measure.map_congr (gaussianPartialSumLp_coeFn s c)
    _ = ProbabilityTheory.gaussianReal 0
        (gaussianLinearCombinationVariance s fun i => c i) :=
          map_gaussianLinearCombination_eq_gaussianReal s fun i => c i

end
section
variable [DecidableEq ι] (c : ℓ²(ι, ℝ))

/-- Finite coefficient partial sums converge in `L²(Ω)` to the infinite Gaussian sum. -/
theorem hasSum_gaussianPartialSumLp :
    HasSum (fun i : ι => c i • gaussianCoordinateLp i)
      (gaussianL2Isometry (ι := ι) c) := by
  rw [gaussianL2Isometry]
  simpa [gaussianCoordinateLine_apply] using
    (orthonormal_gaussianCoordinateLp).orthogonalFamily.hasSum_linearIsometry c

/-- The finite partial-sum net converges to the infinite white-noise evaluation in `L²(Ω)`. -/
theorem tendsto_gaussianPartialSumLp :
    Tendsto (fun s : Finset ι => gaussianPartialSumLp s c) atTop
      (𝓝 (gaussianL2Isometry (ι := ι) c)) := by
  simpa [HasSum, gaussianPartialSumLp] using
    (hasSum_gaussianPartialSumLp c)

end

section
variable [Encodable ι] [DecidableEq ι] (c : ℓ²(ι, ℝ))

/-- Characteristic function of the infinite `ℓ²` Gaussian-coordinate evaluation. -/
theorem charFun_map_gaussianL2Isometry (t : ℝ) :
    charFun (Measure.map (gaussianL2Isometry (ι := ι) c) (gaussianSequenceMeasure ι)) t =
      charFun (ProbabilityTheory.gaussianReal 0 (Real.toNNReal (‖c‖ ^ (2 : Nat)))) t := by
  let μ := gaussianSequenceMeasure ι
  let X := gaussianL2Isometry c
  let Xn : ℕ → Lp ℝ 2 μ := fun n =>
    gaussianPartialSumLp (gaussianIndexTruncation ι n) c
  have hLp : Tendsto Xn atTop (𝓝 X) := by
    exact (tendsto_gaussianPartialSumLp c).comp (tendsto_gaussianIndexTruncation ι)
  have hInMeasure : TendstoInMeasure μ (fun n => ⇑(Xn n)) atTop X :=
    tendstoInMeasure_of_tendsto_Lp hLp
  have hDist :
      TendstoInDistribution (fun n => ⇑(Xn n)) atTop (⇑X) (fun _ => μ) μ :=
    TendstoInMeasure.tendstoInDistribution hInMeasure fun n =>
      (Lp.aestronglyMeasurable (Xn n)).aemeasurable
  have hWeak :=
    (ProbabilityMeasure.tendsto_iff_forall_integral_rclike_tendsto ℂ).mp hDist.tendsto
  have hCharLimit :
      Tendsto
        (fun n => charFun (Measure.map (Xn n) μ) t)
        atTop
        (𝓝 (charFun (Measure.map X μ) t)) := by
    simpa [charFun_eq_integral_innerProbChar] using
      hWeak (BoundedContinuousFunction.innerProbChar (t : ℝ))
  have hVarianceLimit :
      Tendsto
        (fun n =>
          (gaussianLinearCombinationVariance _ fun i => c i : ℝ))
        atTop (𝓝 (‖c‖ ^ (2 : Nat))) :=
    tendsto_gaussianLinearCombinationVariance_indexTruncation c
  have hVarianceLimitComplex :
      Tendsto
        (fun n =>
          (((gaussianLinearCombinationVariance _
            fun i => c i : ℝ)) : ℂ))
        atTop (𝓝 (((‖c‖ ^ (2 : Nat) : ℝ)) : ℂ)) :=
    (Complex.continuous_ofReal.tendsto _).comp hVarianceLimit
  have hArgumentLimit :
      Tendsto
        (fun n =>
          (t : ℂ) * (0 : ℂ) * Complex.I -
            (((gaussianLinearCombinationVariance (gaussianIndexTruncation ι n)
              fun i => c i : ℝ)) : ℂ) * (t : ℂ) ^ (2 : Nat) / 2)
        atTop
        (𝓝 ((t : ℂ) * (0 : ℂ) * Complex.I -
          (((‖c‖ ^ (2 : Nat) : ℝ)) : ℂ) * (t : ℂ) ^ (2 : Nat) / 2)) := by
    exact (tendsto_const_nhds.sub
      ((hVarianceLimitComplex.mul tendsto_const_nhds).div tendsto_const_nhds
        (by norm_num : (2 : ℂ) ≠ 0)))
  have hGaussianLimit :
      Tendsto
        (fun n =>
          charFun
            (ProbabilityTheory.gaussianReal 0
              (gaussianLinearCombinationVariance (gaussianIndexTruncation ι n) fun i => c i))
            t)
        atTop
        (𝓝 (charFun
          (ProbabilityTheory.gaussianReal 0 (Real.toNNReal (‖c‖ ^ (2 : Nat)))) t)) := by
    simpa [Function.comp_def, ProbabilityTheory.charFun_gaussianReal,
      Real.coe_toNNReal ..] using ((Complex.continuous_exp.tendsto _).comp hArgumentLimit)
  have hFiniteChar :
      Tendsto
        (fun n => charFun (Measure.map (Xn n) μ) t)
        atTop
        (𝓝 (charFun
          (ProbabilityTheory.gaussianReal 0 (Real.toNNReal (‖c‖ ^ (2 : Nat)))) t)) := by
    simpa [Xn, μ, map_gaussianPartialSumLp_eq_gaussianReal] using hGaussianLimit
  exact tendsto_nhds_unique hCharLimit hFiniteChar

/-- The infinite `ℓ²` Gaussian-coordinate evaluation is centered Gaussian with variance `‖c‖²`. -/
theorem map_gaussianL2Isometry_eq_gaussianReal :
    Measure.map (gaussianL2Isometry (ι := ι) c) (gaussianSequenceMeasure ι) =
      ProbabilityTheory.gaussianReal 0 (Real.toNNReal (‖c‖ ^ (2 : Nat))) := by
  refine Measure.ext_of_charFun ?_
  ext t
  exact charFun_map_gaussianL2Isometry c t

end

end GaussianL2

