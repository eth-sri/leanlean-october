-    hData (Q γ - ν) (by linarith) (by linarith)
-  have hZ : IsLateralGMCOf P γ Z := (hdata _ (half_pos hν₁) (half_lt_self hν₁)).2.1
-  have he : Tendsto (fun ν : ℝ => 2 * ν / γ) (𝓝[>] 0) (𝓝 0) := by
