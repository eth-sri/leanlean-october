-  have hB : ∀ i, MeasurableSet (B i) := by
-    intro i
-    fin_cases i
-    · exact measurableSet_ball.compl
-    · exact measurableSet_ball
-    · exact measurableSet_ball
-    · exact measurableSet_ball
-  have hcover : ⋃ i, B i = Set.univ := by
-    apply Set.eq_univ_of_forall
-    intro x
-    rw [Set.mem_iUnion]
-    by_cases hx : x ∈ Metric.ball (0 : ℂ) (1 / 2)
