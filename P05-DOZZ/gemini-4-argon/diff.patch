-    (fun ν hν hν₁' => by simpa using (hdata ν hν hν₁').1) hZ
-    (fun ν hν hν₁' => (hdata ν hν hν₁').2.2) (lateralGMC_ne_zero_ae P γ Z hZ) _ he
-    (fun ν hν => (div_pos (mul_pos two_pos hν) hγ).le)
