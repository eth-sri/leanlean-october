+            DOZZ.finiteChaosMass PX Xn
+              (fun i => c * (n : ℝ)⁻¹ * (h (u i.val) : ℝ)) γ ω)) ∂PX := by
+                apply lintegral_congr_ae
+                exact ae_of_all _ fun ω => congrArg
+                    (fun m : ℝ => ENNReal.ofReal (Real.exp (-s * m)))
+                    (hformulaX n ω u).symm
