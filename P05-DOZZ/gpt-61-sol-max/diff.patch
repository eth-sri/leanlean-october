-/-- The linear image of a finite field vector. -/
-def finiteChaosLinearImageVector {ι : Type*}
-    [Fintype ι] (A : ι → ι → ℝ) (x : ι → ℝ) : ι → ℝ :=
-  fun i => ∑ l, A i l * x l
