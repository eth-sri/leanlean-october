-noncomputable def finiteChaosMatrixLaplaceScoreDerivative {n : ℕ}
-    (A B : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ)
-    (a : Fin (n + 1) → ℝ) (γ s t : ℝ) (i j : Fin (n + 1))
