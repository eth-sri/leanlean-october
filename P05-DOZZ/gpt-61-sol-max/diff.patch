-    intro x
-    simpa [G, T] using
-      finiteChaos_laplace_first_weight_bound a v γ s ha hs (T x) i
-  have hDBound : ∀ x j, ‖D (T x) j‖ ≤ 5 * |γ| := by
-    intro x j
-    simpa [D, T] using
-      finiteChaos_laplace_score_derivative_norm_le a v γ s ha hs (T x) i j
