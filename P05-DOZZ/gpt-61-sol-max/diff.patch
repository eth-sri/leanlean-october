-    fun_prop [finiteChaosVectorWeight, finiteChaosVectorMass]
-  have hDmeas : Measurable D := by
-    apply measurable_pi_iff.mpr
-    intro j
-    by_cases hij : i = j
-    · simp [D, hij]
-      fun_prop [finiteChaosVectorWeight, finiteChaosVectorMass]
-    · simp [D, hij]
-      fun_prop [finiteChaosVectorWeight, finiteChaosVectorMass]
