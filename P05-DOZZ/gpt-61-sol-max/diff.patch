+                noncomm_ring
+      _ = (c * (n : ℝ)⁻¹) * ∑ i : Fin n,
+            ((h (u i.val) : ℝ) * Real.exp (γ * Ψ ω (u i.val) - γ ^ 2 / 2 *
+              DOZZ.gaussianVariance PY (fun ω => Ψ ω (u i.val)))) := by rw [Finset.mul_sum]
