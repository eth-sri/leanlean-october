-noncomputable def productCauchyKernelDeriv {N : ℕ} (z w : Fin N → ℂ) :
-    (Fin N → ℂ) →L[ℂ] ℂ :=
-  ∑ i, (∏ j ∈ Finset.univ.erase i, (w j - z j)⁻¹) •
-    (((w i - z i) ^ 2)⁻¹ • ContinuousLinearMap.proj i)
