-      ∀ g ∈ Icc gLo gHi, ∀ r : ℝ, ∀ x ∈ K,
-        ∫⁻ ω, admissibleLogWickWeight P Y g (Real.exp (-r)) x ω *
-          Set.indicator (admissibleGrowingBarrierSet Y a k₀ r)ᶜ (fun _ => (1 : ℝ≥0∞)) (ω, x) ∂P ≤
