-/-- The dominating function `I^e ∫ g dm` of the outer integrands. -/
-noncomputable def bpzWCL_dom (γ χ α₁ α₂ α₃ : ℝ) (z : ℂ) (e : ℝ) (m : Measure ℂ) : ℝ :=
-  (∫ x, bpzSoftWeight γ χ α₁ α₂ α₃ 0 z x ∂m) ^ e * ∫ x, bpzWCL_g γ χ α₁ α₂ α₃ z x ∂m
