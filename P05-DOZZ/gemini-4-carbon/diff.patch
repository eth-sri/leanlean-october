-  have hIntY : ∀ j, ∀ᵐ ω ∂P', Integrable (fun x =>
-      weight j x * Real.exp (γ * Y ω x - γ ^ 2 / 2 * (variance x : ℝ))) ν := by
-    intro j
-    exact ae_integrable_weighted_wick_sections ν (W := Y) variance (weight j) γ hY
