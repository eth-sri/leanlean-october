-    unfold Q
-    field_simp [hγ.ne']
-    ring
-  have hqC : (γ : ℂ) / 4 + (γ : ℂ)⁻¹ = (Q γ / 2 : ℝ) := by
-    exact_mod_cast hqR.symm
-  rw [hqC]
