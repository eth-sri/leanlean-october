-/-- Fixed coordinate bounds give a fixed bound for the joint derivative. -/
-noncomputable def productCauchyDerivBound {N : ℕ} (b : Fin N → ℝ) : ℝ :=
-  ∑ i, (∏ j ∈ Finset.univ.erase i, b j) * (b i) ^ 2
