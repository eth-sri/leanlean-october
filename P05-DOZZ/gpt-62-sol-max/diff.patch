+    (hmem : ∀ x r, MemLp (fun ω => Z ω x r) 2 P)
+    (hlim : ∀ p, Tendsto (fun n => eLpNorm (fun ω =>
+      X ω (inversionTest (f p n) (hf p n)) - Z ω p.1 p.2) 2 P) atTop (𝓝 0))
