+    (g₂ : AnalyticAt ℂ Complex.Gamma (dualArg₂ γ af))
+    (g₃ : AnalyticAt ℂ Complex.Gamma (1 - dualArg₃ γ ef af bf))
+    (g₄ : AnalyticAt ℂ Complex.Gamma (1 - dualArg₄ γ ef af bf))
