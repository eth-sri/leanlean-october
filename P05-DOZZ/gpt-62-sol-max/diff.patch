-  let C : ℝ := (2 : ℝ) ^ |γ * α₂| * (1 + 2 / ‖y‖) ^ (γ ^ 2 / 2)
-  let w : ℂ → ℝ≥0∞ := fun x => ENNReal.rpow (ENNReal.ofReal ‖x‖) (-γ * (α₁ + γ / 2))
-  let v : ℂ → ℝ≥0∞ := fun x => ENNReal.rpow (ENNReal.ofReal ‖x - y * z‖) (-γ * (α₁ + γ / 2))
-  have hw : Measurable w := by
