+module
+
+public import Mathlib.MeasureTheory.Function.LpSeminorm.SMul
+public import Mathlib.MeasureTheory.Function.LpSeminorm.TriangleInequality
+public import Mathlib.Topology.Instances.ENNReal.Lemmas
+
+/-! Combining errors that tend to zero in `Lᵖ`. -/
+@[expose] public section
+
+open MeasureTheory Filter Topology
+open scoped ENNReal
+
+namespace DOZZ.Proofs
+
+section
+variable {Ω I : Type*} [MeasurableSpace Ω] {P : Measure Ω} {l : Filter I} {p : ℝ≥0∞}
+
+theorem tendsto_eLpNorm_add_zero {f g : I → Ω → ℝ} (hp : 1 ≤ p)
+    (hf : Tendsto (fun i => eLpNorm (f i) p P) l (𝓝 0))
+    (hg : Tendsto (fun i => eLpNorm (g i) p P) l (𝓝 0)) :
+    Tendsto (fun i => eLpNorm (f i + g i) p P) l (𝓝 0) :=
+  tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds
+    (by simpa only [add_zero] using hf.add hg) (fun _ => bot_le) (fun _ => eLpNorm_add_le hp)
+
+theorem tendsto_eLpNorm_smul_zero {c : I → ℝ} {f : Ω → ℝ}
+    (hc : Tendsto c l (𝓝 0)) (hf : MemLp f p P) :
+    Tendsto (fun i => eLpNorm (c i • f) p P) l (𝓝 0) := by
+  simpa only [eLpNorm_const_smul, Function.comp_def, enorm_zero, zero_mul] using
+    ENNReal.Tendsto.mul_const ((continuous_enorm.tendsto (0 : ℝ)).comp hc)
+      (Or.inr hf.eLpNorm_ne_top)
+
+end
+end DOZZ.Proofs
diff --git a/DOZZ/MeasureTheory/MeasureMassCode.lean b/DOZZ/MeasureTheory/MeasureMassCode.lean
new file mode 100644
index 000000000..656706aed
--- /dev/null
+++ b/DOZZ/MeasureTheory/MeasureMassCode.lean
@@ -0,0 +1,67 @@
+/-
+Copyright (c) 2026 Scott Armstrong and Amélie Loher. All rights reserved.
+Released under Apache 2.0 license as described in the file LICENSE.
+-/
+module
+
+public import DOZZ.MeasureTheory.CylinderLaws
+public import Mathlib.MeasureTheory.Measure.FiniteMeasure
+
+public section
+
+open MeasureTheory ProbabilityTheory Set
+open scoped ENNReal
+
+namespace DOZZ.Proofs
+
+variable {α : Type*} [MeasurableSpace α]
+
+/-- Record a measure by its masses on a chosen family of sets. -/
+abbrev measureMassCode {S : Set (Set α)} {p : Measure α → Prop} (μ : Subtype p) (U : S) : ℝ≥0∞ :=
+  μ.1 U.1
+
+section
+variable {S : Set (Set α)} {p : Measure α → Prop} (hS : ∀ U : S, MeasurableSet U.1)
+include S hS
+
+theorem measurable_measureMassCode : Measurable (measureMassCode (p := p) (S := S)) :=
+  .of_eval fun U => (Measure.measurable_coe (hS U)).comp measurable_subtype_coe
+
+/-- The code generates the usual σ-algebra if the underlying measure is measurable from it. -/
+theorem measureMassCode_comap_eq
+    (hforget : @Measurable (Subtype p) (Measure α) (MeasurableSpace.pi.comap (measureMassCode (S := S))) _ Subtype.val) :
+    MeasurableSpace.pi.comap (measureMassCode (p := p) (S := S)) = Subtype.instMeasurableSpace :=
+  le_antisymm (measurable_measureMassCode hS).comap_le hforget.comap_le
+
+end
+
+/-- Open-set masses generate the σ-algebra of finite measures on a Borel space. -/
+theorem finiteOpenMassCode_comap_eq [TopologicalSpace α] [BorelSpace α] :
+    MeasurableSpace.pi.comap (measureMassCode (S := {U : Set α | IsOpen U}) (p := IsFiniteMeasure)) =
+      (inferInstance : MeasurableSpace (FiniteMeasure α)) := by
+  refine measureMassCode_comap_eq (fun U => U.2.measurableSet) ?_
+  let m : MeasurableSpace (FiniteMeasure α) :=
+    MeasurableSpace.pi.comap (measureMassCode (S := {U : Set α | IsOpen U}) (p := IsFiniteMeasure))
+  let _ := m
+  have hc : @Measurable (FiniteMeasure α) ({U : Set α // IsOpen U} → ℝ≥0∞)
+      m _ measureMassCode := .of_comap_le le_rfl
+  letI : ∀ μ : Subtype (IsFiniteMeasure : Measure α → Prop), IsFiniteMeasure μ.1 := fun μ => μ.2
+  exact Measurable.measure_of_isPiSystem (BorelSpace.measurable_eq (α := α)) isPiSystem_isOpen
+    (fun U hU => (measurable_pi_iff.mp hc) ⟨U, hU⟩) ((measurable_pi_iff.mp hc) ⟨univ, isOpen_univ⟩)
+
+/-- Finite vectors of masses determine the law of random measures when the mass coordinates
+of individual measures generate their σ-algebra. -/
+theorem identDistrib_measure_of_mass_fdd {Ω Ω' : Type*} [MeasurableSpace Ω] [MeasurableSpace Ω']
+    {P : Measure Ω} {P' : Measure Ω'} [IsFiniteMeasure P]
+    {S : Set (Set α)} {p : Measure α → Prop} {M : Ω → Measure α} {N : Ω' → Measure α}
+    (hc : MeasurableSpace.pi.comap (measureMassCode (S := S) (p := p)) = Subtype.instMeasurableSpace)
+    (hM : AEMeasurable M P) (hN : AEMeasurable N P') (hMp : ∀ ω, p (M ω)) (hNp : ∀ ω, p (N ω))
+    (h : ∀ s : Finset S, P.map (fun ω (j : s) => M ω j.1.1) = P'.map (fun ω (j : s) => N ω j.1.1)) :
+    IdentDistrib M N P P' := by
+  have hm := Measurable.of_comap_le hc.le
+  have hf : AEMeasurable (fun ω => (⟨M ω, hMp ω⟩ : Subtype p)) P := hM.subtype_mk (hfs := hMp)
+  have hg : AEMeasurable (fun ω => (⟨N ω, hNp ω⟩ : Subtype p)) P' := hN.subtype_mk (hfs := hNp)
+  exact (identDistrib_of_code hf hg hc
+    (identDistrib_of_pi_fdd (hm.comp_aemeasurable hf) (hm.comp_aemeasurable hg) h)).comp measurable_subtype_coe
+
+end DOZZ.Proofs
diff --git a/DOZZ/MeasureTheory/PowerSums.lean b/DOZZ/MeasureTheory/PowerSums.lean
new file mode 100644
index 000000000..0f1fa29c4
--- /dev/null
+++ b/DOZZ/MeasureTheory/PowerSums.lean
@@ -0,0 +1,89 @@
+/-
+Copyright (c) 2026 Scott Armstrong and Amélie Loher. All rights reserved.
+Released under Apache 2.0 license as described in the file LICENSE.
+-/
+module
+
+public import Mathlib.Analysis.MeanInequalitiesPow
+public import Mathlib.Analysis.SpecialFunctions.Pow.Continuity
+public import Mathlib.Data.Finset.Max
+public import Mathlib.LinearAlgebra.Matrix.Notation
+
+/-! # Moment bounds for finite and countable sums -/
+
+@[expose] public section
+open scoped ENNReal
+namespace DOZZ.Proofs
+
+section
+variable {ι : Type*}
+
+/-- For a finite nonempty sum, compare with the largest summand before taking powers. -/
+theorem ennreal_finset_sum_rpow_le_card_rpow_sum (S : Finset ι) (hne : S.Nonempty) (f : ι → ℝ≥0∞)
+    (p : ℝ) (hp : 0 ≤ p) :
+    (∑ i ∈ S, f i) ^ p ≤ (S.card : ℝ≥0∞) ^ p * ∑ i ∈ S, (f i) ^ p := by
+  classical
+  obtain ⟨i₀, hi₀, hmax⟩ := S.exists_max_image f hne
+  have hsum : (∑ i ∈ S, f i) ≤ (S.card : ℝ≥0∞) * f i₀ := by
+    calc
+      _ ≤ ∑ _i ∈ S, f i₀ := Finset.sum_le_sum (fun i hi => hmax i hi)
+      _ = _ := by simp
+  have h := ENNReal.rpow_le_rpow hsum hp
+  rw [ENNReal.mul_rpow_of_nonneg _ _ hp] at h
+  exact h.trans (mul_le_mul' le_rfl (Finset.single_le_sum (f := fun i => (f i) ^ p) (fun _ _ => zero_le) hi₀))
+
+theorem ennreal_finset_sum_rpow_le_card_rpow_sum_of_pos (S : Finset ι) (f : ι → ℝ≥0∞) {p : ℝ} (hp : 0 < p) :
+    (∑ i ∈ S, f i) ^ p ≤ (S.card : ℝ≥0∞) ^ p * ∑ i ∈ S, (f i) ^ p := by
+  rcases S.eq_empty_or_nonempty with hS | hS
+  · simp [hS, ENNReal.zero_rpow_of_pos hp]
+  · exact ennreal_finset_sum_rpow_le_card_rpow_sum S hS f p hp.le
+
+private theorem ennreal_rpow_finset_sum_le_sum_rpow (s : Finset ι) (a : ι → ℝ≥0∞) {p : ℝ}
+    (hp : 0 < p) (hp1 : p ≤ 1) :
+    (∑ i ∈ s, a i) ^ p ≤ ∑ i ∈ s, (a i) ^ p := by
+  classical
+  induction s using Finset.induction_on with
+  | empty => simpa
+  | @insert i s his ih =>
+      rw [Finset.sum_insert his, Finset.sum_insert his]
+      exact ENNReal.rpow_add_le_add_rpow (a i) (∑ j ∈ s, a j) hp.le hp1 |>.trans
+        (add_le_add_right ih _)
+
+/-- Subadditivity for a concave power applies to countable sums. -/
+theorem ennreal_rpow_tsum_le_tsum_rpow (a : ι → ℝ≥0∞) {p : ℝ}
+    (hp : 0 < p) (hp1 : p ≤ 1) :
+    (∑' i, a i) ^ p ≤ ∑' i, (a i) ^ p := by
+  classical
+  rw [ENNReal.tsum_eq_iSup_sum, ENNReal.tsum_eq_iSup_sum]
+  have hmono : Monotone (fun x : ℝ≥0∞ => x ^ p) := fun _ _ h =>
+    ENNReal.rpow_le_rpow h hp.le
+  have hzero  := ENNReal.zero_rpow_of_pos hp
+  have hcontinuous : Continuous (fun x : ℝ≥0∞ => x ^ p) :=
+    ENNReal.continuous_rpow_const
+  rw [hmono.map_iSup_of_continuousAt
+    hcontinuous.continuousAt hzero]
+  apply iSup_le
+  intro s
+  exact (ennreal_rpow_finset_sum_le_sum_rpow s a hp hp1).trans
+    (le_iSup_of_le s le_rfl)
+
+end
+
+theorem ennreal_add3_rpow_le (a b c : ℝ≥0∞) {q : ℝ} (hq : 0 ≤ q) :
+    (a + b + c) ^ q ≤ (3 : ℝ≥0∞) ^ q * (a ^ q + b ^ q + c ^ q) := by
+  let f  := ![a, b, c]
+  have h := ennreal_finset_sum_rpow_le_card_rpow_sum (Finset.univ : Finset (Fin 3))
+    ⟨0, Finset.mem_univ 0⟩ f q hq
+  simpa [f, Fin.sum_univ_succ, add_assoc] using h
+
+theorem ennreal_rpow_le_max_one_rpow (x : ℝ≥0∞) {t tm : ℝ} (ht : 0 ≤ t) (htm : t ≤ tm) :
+    x ^ t ≤ max 1 x ^ tm :=
+  (ENNReal.rpow_le_rpow (le_max_right 1 x) ht).trans
+    (ENNReal.rpow_le_rpow_of_exponent_le (le_max_left 1 x) htm)
+
+/-- The positive-base power identity in function notation. -/
+theorem ennreal_ofReal_rpow_of_pos {x p : ℝ} (hx : 0 < x) :
+    ENNReal.rpow (ENNReal.ofReal x) p = ENNReal.ofReal (x ^ p) :=
+  ENNReal.ofReal_rpow_of_pos hx
+
+end DOZZ.Proofs
