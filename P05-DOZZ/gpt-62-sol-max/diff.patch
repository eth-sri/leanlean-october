+  calc
+    _ = P.map (fun ω => (fun i => Z ω 0 (s i), fun j => Z ω (q j).1 (q j).2)) := by
+      apply Measure.map_congr
+      filter_upwards [he] with ω hω
+      exact Prod.ext (funext fun i => (hω i).symm) rfl
+    _ = _ := hp
+
+end
