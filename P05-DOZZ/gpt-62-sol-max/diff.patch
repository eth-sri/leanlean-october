-      (ENNReal.measurable_ofReal.comp (measurable_norm : Measurable (fun x : ℂ => ‖x‖)))
-  have hv : Measurable v := by
-    exact (ENNReal.continuous_rpow_const (y := -γ * (α₁ + γ / 2))).measurable.comp
