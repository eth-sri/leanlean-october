-      ENNReal.ofReal ((2 : ℝ) ^ |γ * α₂| * (1 + 2 / ‖y‖) ^ (γ ^ 2 / 2)) *
-        (weightedGmcBallMass γ μ (α₁ + γ / 2) 0 δ +
