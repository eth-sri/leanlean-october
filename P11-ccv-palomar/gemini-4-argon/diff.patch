+    unfold lowSmoothnessAmplitude
+    rw [div_pow, ← Real.rpow_mul_natCast hk.le]
+    congr 2
+    norm_num
+    ring
+  rw [hright]
+  have hleft : b ^ 2 / (↑5 ^ (2 * s) * x ^ (4 * s / (↑d + 4 * s))) =
+      b ^ 2 / ↑5 ^ (2 * s) * x ^ (-4 * s / (↑d + 4 * s)) := by
+    rw [show -4 * s / (↑d + 4 * s) = -(4 * s / (↑d + 4 * s)) by ring,
