-    · have hex : ∃ j, A < s j := by
-        by_contra h
-        apply hcube
-        refine ⟨hs, ?_⟩
-        intro j
-        exact le_of_not_gt (fun hj => h ⟨j, hj⟩)
-      obtain ⟨j, hj⟩ := hex
-      have hterm : orthantCoordinateTail b A j s ≤ ∑ l, orthantCoordinateTail b A l s :=
-        Finset.single_le_sum (fun l _ => orthant_coordinate_tail_nonnegative b A l s)
