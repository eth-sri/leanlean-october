+    (hp : ∀ x ∈ A, pMinus ≤ p x) (hq : ∀ x ∈ A, ∀ y, cMass ≤ q x y)
+    (hRaw : Integrable (selectedRawSquareEnergy R) (Measure.pi (fun _ : κ => μ.restrict A))) :
