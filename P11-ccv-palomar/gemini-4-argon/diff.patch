-  simp [IsHistoryUpper]
-
-omit [DecidableEq α] in
-@[simp] theorem empty_mem_historyUpperSets (S : Finset α) : ∅ ∈ historyUpperSets S :=
-  mem_historyUpperSets.2 (empty_historyUpper S)
