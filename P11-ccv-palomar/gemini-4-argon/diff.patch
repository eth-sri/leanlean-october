-    (x : Covariate d) : MvPolynomial (Fin d) ℝ :=
-  ∑ q ∈ Finset.range (k + 1), C ((q.factorial : ℝ)⁻¹) *
-    multilinearPolynomial (iteratedFDerivWithin ℝ q f (cube d) x) x
