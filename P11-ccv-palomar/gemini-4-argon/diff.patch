-  rw [mem_historyGasFamilies]
-  refine ⟨Finset.insert_subset hp hFP, ?_, ?_⟩
-  · intro q hq r hr hqr
-    by_cases hqp : q = p
-    · subst q
-      have hrF := Finset.mem_of_mem_insert_of_ne hr (Ne.symm hqr)
