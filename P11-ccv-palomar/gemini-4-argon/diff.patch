-    (f : ℕ → R) (gs : List (ℕ → R)) (ρ A B : ℝ) (hp : 0 < ρ)
-    (hA : 0 ≤ A) (hB : 0 ≤ B)
-    (hf : ∀ k : ℕ, ‖f k‖ ≤ A * ρ ^ k)
-    (hg : ∀ g ∈ gs, ∀ k : ℕ, ‖g k‖ ≤ B * ρ ^ k) (k : ℕ) :
