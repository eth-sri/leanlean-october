-    (A : E → ι → ι → ℝ) (c : ι → ℝ) (b : E → ℝ)
-    (Φ : (ι → ℝ) → ℝ) : ℝ :=
-  ∑ e, weights e * b e * responseMatrixAction q C (A e) c Φ
