+                  rw [radial_gaussian_scale_normalization d lam t hlam ht]
+                _ ≤ Real.exp (1 / 2) * (Real.sqrt (2 * Real.pi / lam)) ^ d *
+                    (1 + t) ^ (1 - (d : ℝ) / 2) := by
+                  rw [Real.rpow_sub hs, Real.rpow_one]
+                  have h := mul_le_mul_of_nonneg_right (show t ≤ 1 + t by linarith)
