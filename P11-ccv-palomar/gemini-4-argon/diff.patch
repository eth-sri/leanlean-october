-      (finePairTimeMatrix_measurable d _) (finePairTimeMatrix_cost_integrable d T0 N _) c p hp
-      (fun ζ i => finePairTimeFieldValue ζ (U i))
-      (fun i => (boundedHyperplaneFieldValue_section_measurable d (U i)).comp measurable_snd)
