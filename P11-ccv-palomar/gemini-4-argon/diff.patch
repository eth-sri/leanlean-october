-    (higherBandCarrierAmplitude d r D lam fine)
-
-def higherBandRowActivation (d r m D q : ℕ) (a b C lam L T : ℝ) (fine : Bool) :
-    HigherBandRowMark d r m D q fine → ℝ :=
