+  have hhi := y.position.isLt
+  simp only [List.length_append, List.length_singleton] at hhi
+  apply WordHeapPiece.ext
+  apply Fin.ext
+  change word.length ≤ y.position.val at hlo
+  change y.position.val = word.length
