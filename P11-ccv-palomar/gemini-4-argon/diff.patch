-  swap
-  · exact (historyMarkedAppend_measurable dependent hsymm j).aemeasurable
-  rw [smul_smul, mul_comm, ← smul_smul,
-    historyMarkedReferenceRaw_append_restrict dependent hrefl hsymm Δ j π]
