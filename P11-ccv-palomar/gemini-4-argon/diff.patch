+    g ∈ Set.range (historyShapeAppend dependent j) ↔
+      ∃ x : WordHeapPiece g.out dependent,
+        x ∈ historyMaximalPieces Finset.univ ∧ wordHeapLabel x = j := by
+  constructor
+  · rintro ⟨u, hu⟩
