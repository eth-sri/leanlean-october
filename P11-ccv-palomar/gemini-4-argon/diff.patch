+def highTiltedObservableMean  [MeasurableSpace Ω] 
+    (ν : Measure Ω) (n : ℕ) (a V : ℝ) (p F : Ω → Covariate d → ℝ)
+    (hp : Measurable (Function.uncurry p)) (hF : Measurable (Function.uncurry F))
