-def selectedRawLikelihood {κ α : Type*} [Fintype κ]
-    (p : α → ℝ) (q : α → Fin 3 → ℝ) (x : κ → α) (y : κ → Fin 3) : ℝ :=
-  (∏ i, p (x i)) * ∏ i, q (x i) (y i)
