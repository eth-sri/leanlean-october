+  induction S using Finset.strongInductionOn
+  rename_i S ih
+  by_cases he : S = ∅
+  · subst S; simp
+  · have hS := Finset.nonempty_iff_ne_empty.2 he
+    have := Finset.card_pos.2 hS
+    rw [historyOrderCount_recursion S hS]
