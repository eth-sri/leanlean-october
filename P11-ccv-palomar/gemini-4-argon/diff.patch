-/-- A support patch, defined globally through the same clamp as its window. -/
-def gridPatch (d k : ℕ) (j : Fin d → Fin (k + 1)) : Set (Covariate d) :=
-  {x | ∀ i, |(k : ℝ) * clampUnit (x i) - (j i).val| ≤ 1}
