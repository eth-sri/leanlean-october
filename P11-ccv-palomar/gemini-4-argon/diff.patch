+    (c0 cs : κ → ℝ) (cl : Fin d → κ → ℝ)
+    (h0 : (∑ β, |c0 β|) ≤ 1) (hs : (∑ β, |cs β|) ≤ 64 * d)
+    (hl : ∀ l, (∑ β, |cl l β|) ≤ 8) :
+    finePairMatrixEntryCost (fun β β' => (∑ l, 2 * cl l β * cl l β') -
+      cs β * c0 β' - c0 β * cs β') ≤ 256 * d := by
+  let B (β β' : κ) : ℝ := ∑ l, 2 * cl l β * cl l β'
