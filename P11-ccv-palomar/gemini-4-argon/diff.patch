-  have hι : (Subtype.fintype (fun i : Fin n => i ∈ S) : Fintype S) = Finset.Subtype.fintype S := Subsingleton.elim _ _
-  rw [hι] at hs
-  have hp : Integrable (fun z : (S → α) × ({i : Fin n // i ∉ S} → α) => H S z.1)
