-/-- Actual separated representation of the symmetric matrix kernel on a
-cardinality-r observation subset. -/
-def separatedSubsetMatrix (σ : Measure Z) (r : ℕ) (B : Z → α → Fin r → ℝ)
-    (A : Z → ι → ι → ℝ) (S : Finset α) : ι → ι → ℝ :=
