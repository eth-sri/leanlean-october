-theorem preconditionedPilotFeature_zero_off_cell {d ℓ : ℕ} (j : ℕ) (x : Covariate d)
-    (a : LocalPilotIndex d ℓ) (z : Observation d) (hz : z.1 ∉ dyadicPilotCell j x) :
-    preconditionedPilotFeature j x a z = 0 := by
