-theorem source_pair_polynomial_exponential_le {D : ℝ} (hD : 0 ≤ D) :
-    D^2*Real.exp (-D) ≤ 2 := by
-  have hp := Real.pow_div_factorial_le_exp D hD 2
-  norm_num only [Nat.factorial, Nat.cast_ofNat, Nat.cast_one] at hp
-  have hs : D^2 ≤ 2*Real.exp D := by linarith
