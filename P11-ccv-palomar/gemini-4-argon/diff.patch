-      gaussianPhase (fun l => Real.sqrt (2 * lam * t) * y l) Z -
-      gaussianPhase (fun l => Real.sqrt (2 * lam * t) * x l) Z := by
-    simp only [gaussianPhase, gaussianSpatialFrequency, Finset.sum_sub_distrib]
