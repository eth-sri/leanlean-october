+        simp_rw [abs_mul]
+        rw [show (∑ β : HighFrameIndex d D, ∑ β' : HighFrameIndex d D,
+            |spatialCardinalScale lam (spatialScaleExtend i t) U i| *
+              |highFrameCoefficients (spatialCardinalPolynomial U i) β| *
+              |highFrameCoefficients (spatialCardinalPolynomial U i) β'|) =
