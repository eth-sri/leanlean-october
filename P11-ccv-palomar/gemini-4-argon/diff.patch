-theorem pairPilotScoreMean_eq_half_pilotMean {d : ℕ} (C : ModelConstants d)
-    (θ : RegressionParameter d) (hθ : Admissible C θ) (k : ℕ) (hk : 0 < k)
-    (bar : Covariate d × Covariate d → PairVector)
