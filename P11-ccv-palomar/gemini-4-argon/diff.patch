+  (hB : ∀ j ζ x l, |B j ζ x l| ≤ 1)
+  (initial : HighRawState d k F) (hinit : ∀ x, initial.1 x = 1)
+include hA hcost hpos ha hab hr hδ0 hδ1 hR ha1 hb1 hW hδW hmB hB hinit
