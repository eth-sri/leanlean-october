+    (hlam : 0 ≤ lam) (T : ℝ) (U : Fin n → Covariate d) :
+    cardinalWeightDefect i lam T U ∈ Icc ↑0 1 := by
+  have h := integrated_cardinal_weight_mem_unit i lam T hlam U
