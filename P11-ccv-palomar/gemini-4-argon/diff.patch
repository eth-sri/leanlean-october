+        (lowerSaddleM_tendsto_atTop hm).eventually (eventually_gt_atTop 0)] with x hx hMpos
+      unfold lowerSaddleCountUpper
+      field_simp [(Real.log_pos hx).ne']
+    have hu := tendsto_atBot_of_div_negative Real.tendsto_log_atTop
