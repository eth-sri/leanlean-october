-  have ha : Measurable (fun A : Matrix ι ι ℝ => A.adjugate i k) :=
-    continuous_id.matrix_adjugate.measurable.eval_matrix
-  convert hd.inv.mul ha using 1
-  funext A
-  rw [Matrix.inv_def, Ring.inverse_eq_inv]
