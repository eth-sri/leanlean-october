+  apply Integrable.of_bound ((cardinalWeightDefect_measurable i lam hT).pow_const 2).aestronglyMeasurable 1
+  exact Filter.Eventually.of_forall (fun U => by
+    rw [Real.norm_eq_abs, abs_sq]
