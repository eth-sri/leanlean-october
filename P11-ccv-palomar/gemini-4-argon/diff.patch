+      ((d : ℝ)^2-16*C.smoothness)/((d : ℝ)*((d : ℝ)+4))*highCompleteSourceSaddleTheta C+
+      2*d*densityIntervalExponent C.densityLower C.densityUpper/((d : ℝ)+4) < Cω) :
+    ∃ c, 0 < c ∧ ∀ᶠ n : ℕ in atTop,
+      let m := highCompleteSourceSaddleCoefficient C
