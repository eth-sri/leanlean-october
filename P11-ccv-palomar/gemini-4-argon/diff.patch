+    ∫ U, fineFieldGeometryEnvelope (d := d) (n := r) ad bd ell N M q C a rho eta U
+      ∂fullSpatialPatchDesign d r
+  have h_finite_refined_sum_eq_start_four : (∑ j ∈ Finset.range (D-2), f (3+j)) =
+      ∑ j ∈ Finset.range (D-3), f (4+j) := by
