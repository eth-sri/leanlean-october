-theorem finePairTimeFieldMeasure_abs_time_integral (d : ℕ) [NeZero d]
-    (lo hi : ℝ) (hlo : 0 ≤ lo) (horder : lo ≤ hi) :
-    (∫ e : ℝ × FinePairFieldMark d, |e.1| ∂finePairTimeFieldMeasure d lo hi) =
