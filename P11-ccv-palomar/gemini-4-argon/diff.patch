-    (ξ : (Fin d → Fin (k + 1)) → Fin 3) : Continuous (gridPriorField d k η ξ) :=
-  (continuous_finsetSum _ (fun j _ => (gridTensorWindow_continuous d k j).mul_const _)).const_mul _
