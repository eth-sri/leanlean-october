-def lowerSaddleH (d m θ C x : ℝ) : ℝ := (lowerSaddleGrid d m θ C x : ℝ)⁻¹
-
-def lowerSaddleMu (d m θ C x : ℝ) : ℝ := x * (lowerSaddleH d m θ C x) ^ d
-
-def lowerSaddleOmega (d m θ C x : ℝ) : ℝ :=
-  d * Real.log (lowerSaddleGrid d m θ C x) - Real.log x
