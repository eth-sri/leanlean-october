-      gridTensorWindow d k j x * ternaryValue 1 (ξ j)| ≤ (2 : ℝ) ^ d := by
-    calc
-      _ ≤ ∑ j ∈ gridTensorActive d k x, |gridTensorWindow d k j x * ternaryValue 1 (ξ j)| :=
-        Finset.abs_sum_le_sum_abs _ _
-      _ ≤ ∑ _j ∈ gridTensorActive d k x, (1 : ℝ) := by
