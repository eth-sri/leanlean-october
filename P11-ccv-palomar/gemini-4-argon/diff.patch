+    rfl
+  have he := h_completeSourceRawNumerator_eq_canonical
+  change highUnionSourceMarkedNumerator C R n Q.a V eta j h x y =
+    completeSourceRawNumerator _ _ lam ell N mu D M q Cfr Q.a V eta U p g w (c j) y at he
