+def tensorPolynomialPairMoment_fintype  [Fintype κ]
+    (w : κ → E → ℝ) (P P' : κ → E → MvPolynomial σ ℝ)
+    (β β' : σ →₀ ℕ) (e : κ → E) : ℝ :=
+  (∏ j, w j (e j)) * (∏ j, P j (e j)).coeff β * (∏ j, P' j (e j)).coeff β'
+theorem tensorPolynomialPairMoment_fintype_integral  [Fintype κ]
