-  have ht : gridTent k (j i) (x i) = 0 := max_eq_left (by linarith [lt_of_not_ge hi])
-  exact Finset.prod_eq_zero (Finset.mem_univ i) ((gridWindow_eq_zero_iff k (j i) (x i)).mpr ht)
