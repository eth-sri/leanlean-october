-      (∫ z : {i : Fin n // i ∉ S} → α, (1 : ℝ) ∂Measure.pi (fun _ => μ.restrict Aᶜ)) := hint
-    _ = _ := by
-      rw [integral_const, smul_eq_mul, mul_one]
