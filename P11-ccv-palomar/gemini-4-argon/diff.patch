-  have hn0 : 0 < (n : ℝ) := by exact_mod_cast hn
-  have hk0 : 0 ≤ (k : ℝ) ^ d := by positivity
-  have ha : ((Real.sqrt (n : ℝ))⁻¹) ^ 2 = 1 / (n : ℝ) := by
