-  intro s hs
-  have he : (fun z => g z (p z)) ⁻¹' s =
-      ⋃ i, (p ⁻¹' {i}) ∩ ((fun z => g z i) ⁻¹' s) := by
-    ext z
-    simp
-  rw [he]
-  exact MeasurableSet.iUnion (fun i =>
-    (hp (measurableSet_singleton i)).inter ((hg.eval) hs))
