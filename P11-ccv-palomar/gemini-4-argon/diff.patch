-    rw [← Real.rpow_natCast _ 4, ← Real.rpow_mul (by positivity), ← Real.rpow_mul hnreal.le]
-    congr 1
-    ring
-  simp only [mul_pow]
-  rw [hpower]
-  ring
-
-end NearlyMinimax
