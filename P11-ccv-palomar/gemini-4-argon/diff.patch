-def finePairDensityCoefficientBudget (ad bd : ℝ) (M n : ℕ) : ℝ :=
-  |finePairDensityPrefactor ad bd| * bd^n *
-    Real.cosh ((M+2 : ℕ) * exteriorTau ((ad+bd)/(bd-ad)))
