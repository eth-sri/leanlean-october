+ theorem finePairCountTwoGeometryEnvelope_integrable_and_le  (hd : 0 < d)
+    (bd a ρ η )  (hN : 0 < N) :
+    Integrable (finePairCountTwoGeometryEnvelope (d := d) bd a ρ η N) (fullSpatialPatchDesign d 2) ∧
