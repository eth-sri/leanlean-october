-  have hkp : 0 < (k : ℝ) := by exact_mod_cast hk
-  let R : Set (Covariate d) := Set.univ.pi
-    (fun i => Icc (((j i).val - 1 : ℝ) / k) (((j i).val + 1 : ℝ) / k))
