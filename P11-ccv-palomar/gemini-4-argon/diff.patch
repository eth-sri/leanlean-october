-theorem product_pairScoreOperator_integral {E F : Type*}
-    [MeasurableSpace E] [MeasurableSpace F]
-    (μ : Measure E) (ν : Measure F) [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
-    {Y : E → ℝ} {Y' : F → ℝ} (hY : MemLp Y 2 μ) (hY' : MemLp Y' 2 ν)
