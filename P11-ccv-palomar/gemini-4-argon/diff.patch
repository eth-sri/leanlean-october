-    (hg : ∀ j : ℕ, ‖g j‖ ≤ B * ρ ^ j) :
-    ‖convolution f g k‖ ≤ A * B * ((k + 1 : ℕ) : ℝ) ^ (ν + 1) * ρ ^ k := by
