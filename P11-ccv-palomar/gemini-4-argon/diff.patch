+        simpa only [sq_abs] using (sq_le_sq₀ (abs_nonneg _) (mul_nonneg (by positivity) (finePairDistanceFactor_nonneg (hT0.trans hN) _ _))).mpr h
+      exact (Finset.sum_le_sum (fun y _ => hy y)).trans_eq (by simp; ring)
