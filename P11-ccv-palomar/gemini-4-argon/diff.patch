-      _ = _ := h2'
-  have hs₁ : (∫ z : E × F, Y z.1 ^ 2 ∂μ.prod ν) = f ^ 2 + V := by
-    calc
-      _ = ∫ x, Y x ^ 2 ∂μ := by
-        simpa only [measureReal_def, measure_univ, ENNReal.toReal_one, one_smul] using
-          integral_fun_fst (μ := μ) (ν := ν) (fun x => Y x ^ 2)
-      _ = _ := h2
