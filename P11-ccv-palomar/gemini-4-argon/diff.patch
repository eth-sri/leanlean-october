-  rw [mem_historyGasFamilies]
-  refine ⟨(Finset.erase_subset _ _).trans hFP, ?_, ?_⟩
-  · intro q hq r hr hqr
-    exact hcompat q (Finset.mem_of_mem_erase hq) r (Finset.mem_of_mem_erase hr) hqr
-  · intro q hq x hx
-    obtain ⟨hqp, hqF⟩ := Finset.mem_erase.1 hq
