+    (e : WordHeapPiece u dependent ≃o WordHeapPiece v dependent) : Fin u.length ≃ Fin v.length :=
+  (wordHeapPiecePositionEquiv u dependent).symm.trans
+    (e.toEquiv.trans (wordHeapPiecePositionEquiv v dependent))
