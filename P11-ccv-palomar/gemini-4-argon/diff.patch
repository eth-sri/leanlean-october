-      η * gridSampleWeights d k n x i j * u| ≤ ((2 : ℝ) ^ d + 2) * η := by
-  let z := ternaryValue 1 (ξ j)
-  have hz : |z| ≤ 1 := ternaryValue_one_abs_le (ξ j)
-  have hw : |gridSampleWeights d k n x i j| ≤ 1 := by
