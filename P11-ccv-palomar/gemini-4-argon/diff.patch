-      (fun i => (boundedHyperplaneFieldValue_section_measurable d (U i)).comp measurable_snd)
-      (fun ζ i => (finePairTimeFieldValue_abs ζ (U i)).le) Φ
-  have hfine : finePairFineFirstAction ad bd T0 N M q C U p c Φ = 0 := by
