-def highLocalDerivativeConstant (q : ℕ) (a ρ : ℝ) : ℝ :=
-  (∑ j : Fin (2 * q + 2), |responseWeight q j|) *
-    (4 * (((2 * ρ + a) / a ^ 2) ^ 2 + 2 / a ^ 2))
-
