-theorem half_pilotMean_mean_eq (bar : W → H) (hbarMeas : Measurable bar) (hbar : MemLp bar 2 M)
-    {η : Ω → W → H} (hmη : Measurable (fun z : Ω × W => η z.1 z.2))
