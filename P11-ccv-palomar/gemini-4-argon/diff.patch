-  rw [Finset.prod_add]
-  simp only [MvPolynomial.coeff_sum]
-  have he (U : Finset ι) (hU : U ∈ S.powerset) :
-      ((∏ i ∈ U, MvPolynomial.C (t * p i) * densityModulationPolynomial r B i) *
