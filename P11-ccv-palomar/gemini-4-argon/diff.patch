-    (hcenter : ∀ᵐ w ∂M, (∫ x, η x w ∂μ) = 0)
-    {B : W → H →L[ℝ] H} (hmB : Measurable (fun z : W × H => B z.1 z.2))
-    {cB lam : ℝ} (hcB : 0 ≤ cB) (hlam : 0 ≤ lam) (hbound : ∀ w, ‖B w‖ ≤ cB)
-    (hsym : ∀ w a b, ⟪a, B w b⟫ = ⟪B w a, b⟫)
