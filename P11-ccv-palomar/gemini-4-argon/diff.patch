-def highMarkedResponseMass (a V η : ℝ) (g w : α → ℝ) (φ : α → ι → ℝ)
-    (c : ι → ℝ) (x : α) (y : Fin 3) : ℝ :=
-  ternaryMass a (g x + η * w x * ∑ γ, φ x γ * c γ) V y
