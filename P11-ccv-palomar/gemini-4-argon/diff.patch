-    have hac' : a ≤ c := le_iff_reflTransGen_covBy.2 hac
-    have hc : c ∈ U := hU.2 a ha c (Finset.mem_univ _) hac'
-    have hb : b ∈ U := hU.2 a ha b (Finset.mem_univ _) (hac'.trans hcb.le)
