-variable {α : Type*} [PartialOrder α] [DecidableEq α]
-
-def IsHistoryUpper (S U : Finset α) : Prop :=
-  U ⊆ S ∧ ∀ x ∈ U, ∀ y ∈ S, x ≤ y → y ∈ U
-
-def historyUpperSets (S : Finset α) : Finset (Finset α) := by
-  classical
-  exact S.powerset.filter (IsHistoryUpper S)
