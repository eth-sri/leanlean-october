+  rw [Real.mul_rpow (by norm_num : (0 : ℝ) ≤ 5) (Real.rpow_pos_of_pos hx0 _).le,
+    ← Real.rpow_mul hx0.le] at hupper
+  have heq : lowSmoothnessGridExponent d s * (2 * s) = 4 * s / (↑d + 4 * s) := by
+    unfold lowSmoothnessGridExponent
+    ring
+  rw [heq] at hupper
