-/-- The fixed endpoint estimate `τ≤τ_M≤τ+Cτ/M`, expressed without division. -/
-def LowerExponentControl (τM : ℕ → ℝ) (τ Cτ : ℝ) : Prop :=
-  ∀ᶠ M : ℕ in atTop, τ ≤ τM M ∧ (τM M - τ) * (M : ℝ) ≤ Cτ
