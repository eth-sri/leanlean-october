+    exact h_finePairAliasActionSpatialBudget_geometric_le.trans (by convert hh using 1 <;> ring)
+  have h_fine_pair_alias_cutoff_scale_le {tau : ℝ} (htau : tau ≤ c0) : Real.exp (2*tau*M)/ell^(d-4) ≤
