+theorem patch_expected_score_energy_integrable  [MeasurableSpace α]
+    (μ : Measure α) [IsFiniteMeasure μ] (n : ℕ) (a V η z ρ c : ℝ) (g w : α → Fin n → ℝ)
+    (hg : ∀ i, Measurable (fun x => g x i)) (hwmeas : ∀ i, Measurable (fun x => w x i))
