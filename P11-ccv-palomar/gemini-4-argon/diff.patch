-omit [DecidableEq α] in
-theorem mem_historyUpperSets {S U : Finset α} :
-    U ∈ historyUpperSets S ↔ IsHistoryUpper S U := by
-  classical
-  simp only [historyUpperSets, Finset.mem_filter, Finset.mem_powerset]
-  exact ⟨fun h => h.2, fun h => ⟨h.1, h⟩⟩
-
-omit [DecidableEq α] in
