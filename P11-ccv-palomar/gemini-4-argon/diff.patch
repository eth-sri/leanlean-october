-def densityResetPolynomial {ι : Type*} [DecidableEq ι] (S : Finset ι)
-    (r : ℕ) (z t : ℝ) (p : ι → ℝ) (B : ι → Fin r → ℝ) : MvPolynomial (Fin r) ℝ :=
