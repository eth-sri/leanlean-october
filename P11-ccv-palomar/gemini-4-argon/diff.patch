-    (_hpPlus : 0 ≤ pPlus) (hp : ∀ i, |p i| ≤ pPlus) :
-    |∏ i, p i| ≤ pPlus ^ n := by
-  rw [Finset.abs_prod]
-  simpa only [Finset.prod_const, Finset.card_univ, Fintype.card_fin] using
-    Finset.prod_le_prod₀ (fun i (_ : i ∈ (Finset.univ : Finset (Fin n))) => abs_nonneg (p i))
