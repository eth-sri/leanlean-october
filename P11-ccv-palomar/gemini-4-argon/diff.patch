-theorem measurable_variable_finite_eval {E I B : Type*} [MeasurableSpace E]
-    [MeasurableSpace I] [MeasurableSingletonClass I] [Countable I] [MeasurableSpace B]
-    (g : E → I → B) (p : E → I) (hg : Measurable g) (hp : Measurable p) :
