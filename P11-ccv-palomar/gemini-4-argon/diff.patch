+    funext x
+    unfold highUnionSourceRegression
+    rfl
+  have hreg (j : HighWindowLabels d k) (e : HighUnionMark E) (x : Covariate d) (y : Fin 3) :
+      highMarkedResponseMass a V η (highLocalFieldWithout d k D η c j)
