-def wordHeapUpperCovers {J : Type*} {word : List J} {dependent : J → J → Prop}
-    (x : WordHeapPiece word dependent) : Finset (WordHeapPiece word dependent) := by
-  classical
-  exact Finset.univ.filter (fun y => x ⋖ y)
