+  apply hr.trans
+  apply ENNReal.ofReal_mono
+  unfold pairRiskBudget
+  apply mul_le_mul_of_nonneg_left _ (by positivity : 0 ≤ 2 / a ^ 2)
+  apply add_le_add
+  · change (∫ z, S z ^ 2 ∂(μ.prod μ).prod ν) ≤ _
