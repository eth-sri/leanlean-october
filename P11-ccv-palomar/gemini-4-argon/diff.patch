+    (hs : 0 < s) (hb : 0 ≤ b) (hx : 1 ≤ x)
+    (hlinear : ((2 : ℝ) ^ d + 2) * b ≤ ρ) (hsquare : b ^ 2 ≤ ρ) :
+    0 ≤ lowSmoothnessAmplitude d s b x ∧
+      (↑2 ^ d + 2) * lowSmoothnessAmplitude d s b x ≤ ρ ∧
+      (lowSmoothnessAmplitude d s b x) ^ 2 ≤ ρ := by
