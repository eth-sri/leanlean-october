+  have h_completeSourceRawNumerator_count_zero (ad) (bd) (ha : 0 < ad) (hab : ad < bd) (hD : 1 ≤ D) (a) (c : HighFrameIndex d D → ℝ) : completeSourceRawNumerator ad bd lam ell N mu D M q Cfr a V eta U p g w c y = 0 := by
