-      obtain ⟨hip, hiF⟩ := Finset.mem_sigma.1 hi
-      obtain ⟨hjp, hjF⟩ := Finset.mem_sigma.1 hj
-      obtain ⟨hiP, hix, hiS⟩ := Finset.mem_filter.1 hip
