+  have hh : ∀ k (T : Finset α), 0 ≤ historyDeletionCoefficient (fun _ => 1) k T := by
+    intro k
+    induction k with
+    | zero => intro T; simp
+    | succ k ih =>
+      intro T
+      rw [historyDeletionCoefficient_succ]
+      apply Finset.sum_nonneg
+      intro x hx
+      simpa only [one_mul] using ih (T.erase x)
