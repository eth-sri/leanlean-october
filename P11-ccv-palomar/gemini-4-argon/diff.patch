-    Tendsto f atTop (𝓝 0) := by
-  have hh := Real.tendsto_exp_atBot.comp (tendsto_atBot_of_div_negative hM hr hc)
-  refine hh.congr' (hf.mono fun x hx => Real.exp_log hx)
