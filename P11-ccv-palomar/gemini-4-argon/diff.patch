+  apply ((integrable_finsetSum s hi).const_mul _).mono' ((Finset.measurable_sum s (fun i hi => (hm i hi).abs)).pow_const 2).aestronglyMeasurable
+  exact Filter.Eventually.of_forall (fun x => by
