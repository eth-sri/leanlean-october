-    (dependent : J → J → Prop) (hsymm : ∀ ⦃i j⦄, dependent i j → dependent j i)
-    (ν : Measure (HistoryMarked dependent E)) [SFinite ν] (π : Measure E) [SFinite π]
-    (activation : E → ℝ) (ham : Measurable activation) (n : ℕ) (a V η : ℝ)
