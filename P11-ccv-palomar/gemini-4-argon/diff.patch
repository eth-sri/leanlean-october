-theorem convolution_tsum {R : Type*} [NormedRing R] [CompleteSpace R]
-    (f g : ℕ → R) (hf : Summable (fun i => ‖f i‖)) (hg : Summable (fun i => ‖g i‖)) :
-    ∑' k : ℕ, convolution f g k = (∑' i : ℕ, f i) * ∑' j : ℕ, g j := by
