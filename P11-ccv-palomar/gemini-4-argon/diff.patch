-def finePairCoordinatePolynomial {d : ℕ} (l : Fin d) : MvPolynomial (Fin d) ℝ := C 8 * X l
-
-def finePairSquarePolynomial (d : ℕ) : MvPolynomial (Fin d) ℝ :=
-  ∑ l, (finePairCoordinatePolynomial l) ^ 2
