-    Integrable (fun Z : Covariate d => Z a * Z b) (standardGaussianPi d) := by
-  have h := (gaussian_cross_complex_characteristic_integrable (fun _ => 0) a b).re
-  simpa [gaussianPhase, Complex.mul_re] using h
