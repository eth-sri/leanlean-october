-    (lowerSaddleEta_tends_zero (s := s) (by linarith) hd0 hm hθ C cf).eventually (gt_mem_nhds hη0),
-    hrsp.eventually (gt_mem_nhds (by norm_num : (0 : ℝ) < 1))]
-    with x hx hM0 hMpos hN1 hMu1 hωl hωu hNl hNu hEta0 hRsp
