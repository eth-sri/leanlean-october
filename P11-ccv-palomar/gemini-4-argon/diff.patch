-/-- The exact tail bound used in Lemma 5(a), valid in every complete normed space. -/
-theorem series_truncation_bound {E : Type*} [NormedAddCommGroup E] [CompleteSpace E]
-    (f : ℕ → E) (ν m : ℕ) (ρ A : ℝ) (hp : 0 < ρ) (h1 : ρ < 1) (hA : 0 ≤ A)
