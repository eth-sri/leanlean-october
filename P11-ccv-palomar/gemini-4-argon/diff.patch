-theorem finePairThreeRowFirstAction_small_count {n : ℕ} (hn : n < 2)
-    (ad bd T0 N : ℝ) (ha : 0 < ad) (hab : ad < bd) (D M q : ℕ) (hD : 1 ≤ D)
