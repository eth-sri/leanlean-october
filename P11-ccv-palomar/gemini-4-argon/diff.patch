-def highResponsePacketCost (C : ℝ) (weights : E → ℝ) (A : E → ι → ι → ℝ) : ℝ :=
-  ∑ e, |weights e| * (2 * C ^ 2 * ∑ k, ∑ l, |A e k l|)
