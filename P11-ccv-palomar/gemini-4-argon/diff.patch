-    rw [← map_measureReal_apply measurable_fst hA]
-    have ht := ENNReal.toReal_mono
-      (show (ENNReal.ofReal (C.densityUpper ^ 2) • cubeVolume d) A ≠ ⊤ by
-        simp only [Measure.smul_apply, smul_eq_mul]
