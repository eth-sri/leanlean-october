-  have he : Real.exp D * Real.exp (-D) = 1 := by rw [← Real.exp_add]; simp
-  calc _ ≤ 2*Real.exp D*Real.exp (-D) := h
-       _ = 2 := by rw [mul_assoc,he,mul_one]
-
