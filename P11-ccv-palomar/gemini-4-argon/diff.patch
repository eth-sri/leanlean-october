-      A * ((m + 1 : ℕ) : ℝ) ^ ν * ρ ^ m *
-        ∑' k : ℕ, ((k + 1 : ℕ) : ℝ) ^ ν * ρ ^ k := by
-  let w : ℕ → ℝ := fun k => ((k + 1 : ℕ) : ℝ) ^ ν * ρ ^ k
-  have hw : Summable w := weighted_geometric_summable ν ρ hp h1
