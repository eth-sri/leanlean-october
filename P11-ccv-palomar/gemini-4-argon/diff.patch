-  apply Measurable.ite
-  · apply MeasurableSet.inter
-    · exact measurableSet_eq_fun
-        ((partitionFieldPattern_measurable ρ hρ n).comp
-          (measurable_id.prodMk measurable_const))
-        ((partitionFieldPattern_measurable ρ hρ n).comp
-          (measurable_id.prodMk measurable_const))
-    · exact measurableSet_eq_fun
-        ((partitionFieldPattern_measurable ρ hρ n).comp
-          (measurable_id.prodMk measurable_const))
-        ((partitionFieldPattern_measurable ρ hρ n).comp
-          (measurable_id.prodMk measurable_const))
-  · exact measurable_const
-  · exact measurable_const
