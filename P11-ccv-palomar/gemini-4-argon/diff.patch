+theorem cardinalWeightDefect_joint_square_integrable  (i : Fin n) 
+    (hlam : 0 ≤ lam)  (hT : 1 ≤ T) :
+    Integrable (fun z : Covariate d × (SpatialScaleIndex i → Covariate d) =>
+      anchoredCardinalDefect i lam T z.1 z.2 ^ 2)
