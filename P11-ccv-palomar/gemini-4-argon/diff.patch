-theorem truncationMatrix_eq_scaled_sum {N n0 : ℕ} {dims : Fin N → ℕ}
-    (lo hi : ℝ) (M0 : Matrix (Fin n0) (Fin n0) ℝ)
-    (M : (i : Fin N) → Matrix (Fin (dims i)) (Fin (dims i)) ℝ) (m : ℕ) :
