-      2 / (((n : ℝ) / (2 * polynomialFeatureCount C)) ^ ((d : ℝ)⁻¹)) := by
-    apply (div_le_div_iff₀ hkreal hrreal).mpr
-    simpa only [one_mul] using hspec.2.2
