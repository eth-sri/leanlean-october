-theorem even_cells_two_disjoint_pairs {I J : Type*} [DecidableEq I] [DecidableEq J]
-    (s : Finset J) (p : J → I) (hs : 4 ≤ s.card)
-    (h : ∀ i, Even ((s.filter (fun j => p j = i)).card)) :
-    ∃ a ∈ s, ∃ b ∈ s, ∃ c ∈ s, ∃ e ∈ s,
