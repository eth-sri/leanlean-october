-    (a b : J) (ha : a ∈ s) (hb : b ∈ s) (hab : b ≠ a) (hp : p b = p a) :
-    ∀ i, Even (((s.erase a).erase b).filter (fun j => p j = i)).card := by
-  intro i
-  rw [Finset.filter_erase, Finset.filter_erase]
