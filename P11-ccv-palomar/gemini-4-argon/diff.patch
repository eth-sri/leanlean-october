-  have h := (gamma_translated_monomial_integrable hb A m).const_mul
-    (Real.exp (-(b * A)) / (m.factorial : ℝ))
-  convert h using 1
-  funext v
-  simp only [Function.comp_apply]
-  rw [show -(b * (A + v)) = -(b * A) + -(b * v) by ring, Real.exp_add]
-  ring
-
-end NearlyMinimax
