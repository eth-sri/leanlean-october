-      (1 / 2) * ∫ w, ⟪bar w, B w (bar w)⟫ ∂M := by
-  rw [integral_const_mul,
-    PilotFields.pilotMean_mean_eq bar hbarMeas hbar hmη hη hcenter hmB hcB hlam hbound hsym htest]
