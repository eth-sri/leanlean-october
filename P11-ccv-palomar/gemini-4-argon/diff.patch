-    (μ : Fin n → Measure (Fin 3)) [∀ i, IsProbabilityMeasure (μ i)]
-    (S T : Finset (Fin n)) (hST : Disjoint S T)
-    (R : (S → Fin 3) → ℝ) (Q : (T → Fin 3) → ℝ) :
