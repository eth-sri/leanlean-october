-theorem dyadicKnownGram_posDef {d ℓ : ℕ} (j : ℕ) (x : Covariate d) :
-    (dyadicKnownGram (ℓ := ℓ) j x).PosDef := by
-  rw [dyadicKnownGram_eq_normalized]
-  exact anchoredGram_posDef _
