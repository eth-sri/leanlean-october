module

public import CCDN.Hilbert.LinearProjectionFiltration
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs
public import Mathlib.RingTheory.IntegralClosure.IsIntegral.Defs
import CCDN.Projection.PrimitiveCoordinateField

/-! The field generated by projected coordinates is the fraction field
of the image coordinate ring. Its inclusion in the source function
field is constructed and identified on every coordinate-ring element. -/

@[expose] public section
namespace CCDN
open MvPolynomial

variable {K F σ τ : Type*} [Field K] [Field F] [Algebra K F]
variable (I : Ideal (MvPolynomial τ K))
variable [Algebra (MvPolynomial τ K ⧸ I) F] [IsScalarTower K (MvPolynomial τ K ⧸ I) F]
variable (a : σ → MvPolynomial τ K)

/-- The subfield of `F` generated over `K` by the images of the forms `a` in the quotient by `I`;
for `F` the function field of `I`, it is the function field of the image of the projection by `a`.
-/
def projectionImageField : IntermediateField K F :=
  IntermediateField.adjoin K (Set.range (fun i =>
    algebraMap (MvPolynomial τ K ⧸ I) F ((Ideal.Quotient.mk I) (a i))))

/-- The forms `a` give a Noether normalization of the quotient by `I`: the coordinate map
`K[y] → K[x]/I` is integral and injective, that is, the forms are algebraically independent
modulo `I` and the quotient is finite over the polynomial ring they generate. -/
structure IsNoetherNormalization : Prop where
  /-- The quotient by `I` is integral over the subring generated by the forms. -/
  integral : (projectionCoordinateMap I a).IsIntegral
  /-- The forms are algebraically independent modulo `I`. -/
  injective : Function.Injective (projectionCoordinateMap I a)

/-- The forms `a` map the variety of the prime `I` birationally onto the hypersurface `f = 0`:
the images of the forms generate the function field of `I`, and the kernel of the coordinate map
`K[y] → K[x]/I` is generated by the irreducible polynomial `f`. -/
structure IsBirationalImage [I.IsPrime] (f : MvPolynomial σ K) : Prop where
  /-- The images of the forms generate the function field of `I`. -/
  birational : projectionImageField (F := FractionRing (MvPolynomial τ K ⧸ I)) I a = ⊤
  /-- The image equation `f` is irreducible. -/
  irreducible : Irreducible f
  /-- The kernel of the coordinate map is the principal ideal generated by `f`. -/
  ker_eq : RingHom.ker (projectionCoordinateMap I a) = Ideal.span {f}

/-- The forms `a` define a finite birational projection of the variety of the prime `I` onto
the hypersurface `f = 0`: a birational image whose coordinate map `K[y] → K[x]/I` is moreover
integral. -/
structure IsBirationalProjection [I.IsPrime] (f : MvPolynomial σ K) : Prop
    extends IsBirationalImage I a f where
  /-- The quotient by `I` is integral over the subring generated by the forms. -/
  integral : (projectionCoordinateMap I a).IsIntegral

variable {I} in
/-- For a birational image onto `f = 0`, a polynomial in the forms lies in the ideal exactly when
it is a multiple of `f`. -/
lemma IsBirationalImage.aeval_mem_iff [I.IsPrime] {a : σ → MvPolynomial τ K}
    {f : MvPolynomial σ K} (h : IsBirationalImage I a f) (g : MvPolynomial σ K) :
    aeval a g ∈ I ↔ f ∣ g := by
  rw [← Ideal.mem_span_singleton, ← h.ker_eq, RingHom.mem_ker]
  exact Ideal.Quotient.eq_zero_iff_mem.symm

variable {I} in
/-- The image equation of a birational image vanishes on the variety: substituting the forms
into it gives an element of the ideal. -/
lemma IsBirationalImage.aeval_mem [I.IsPrime] {a : σ → MvPolynomial τ K}
    {f : MvPolynomial σ K} (h : IsBirationalImage I a f) : aeval a f ∈ I :=
  (h.aeval_mem_iff f).mpr dvd_rfl

end CCDN
