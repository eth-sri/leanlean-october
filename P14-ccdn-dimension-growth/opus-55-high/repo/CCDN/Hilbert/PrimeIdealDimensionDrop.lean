import CCDN.Hilbert.FilteredHilbertPolynomial
import CCDN.ForMathlib.MvPolynomial
import CCDN.Hilbert.PolynomialComparison
import CCDN.Hilbert.PrincipalHilbertPolynomial
import CCDN.Hilbert.ProperHilbertDimension
import CCDN.Hilbert.ProperSectionHilbert
import Mathlib.RingTheory.Polynomial.UniqueFactorization

/-! A strict containment of affine prime ideals strictly lowers the
Hilbert dimension. The proof uses a polynomial in their difference. -/

namespace CCDN
section
open MvPolynomial

section
variable {K : Type*} [Field K] {n m : ℕ} (I J : Ideal (MvPolynomial (Fin n) K)) [I.IsPrime]

theorem prime_ideal_strict_hilbert_dimension_drop
    (hdim : (filteredHilbertPolynomial I).natDegree = m + 1)
    (hJ : J ≠ ⊤) (hIJ : I < J) :
    (filteredHilbertPolynomial J).natDegree ≤ m := by
  obtain ⟨f, hfJ, hfI⟩ := IsConcreteLE.not_le_iff_exists.mp (not_le_of_gt hIJ)
  have hsection :=
    sup_le hIJ.le (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hfJ))
  have hsectionproper : I ⊔ Ideal.span {f} ≠ ⊤ :=
    fun h => hJ (top_le_iff.mp (h ▸ hsection))
  have hfdeg : 0 < f.totalDegree := by
    by_contra! h
    have he := totalDegree_eq_zero_iff_eq_C.mp (Nat.eq_zero_of_le_zero h)
    have hc : f.coeff 0 ≠ 0 := by
      intro hc
      apply hfI
      rw [he, hc, map_zero]
      exact I.zero_mem
    exact hJ (Ideal.eq_top_of_isUnit_mem J hfJ (by
      rw [he]
      exact (isUnit_iff_ne_zero.mpr hc).map C))
  exact (filteredHilbertPolynomial_natDegree_le J _ hJ
    (filteredCoordinateSpace_finrank_antitone_ideal _ _ hsection)).trans
      (show (filteredHilbertPolynomial (I ⊔ Ideal.span {f})).natDegree ≤ m ∧
            ((filteredHilbertPolynomial (I ⊔ Ideal.span {f})).natDegree = m →
              (filteredHilbertPolynomial (I ⊔ Ideal.span {f})).leadingCoeff ≤
                (filteredHilbertPolynomial I).leadingCoeff * (m + 1) * f.totalDegree) by
          let P := (filteredHilbertPolynomial (I ⊔ Ideal.span {f})).comp
            (Polynomial.X + Polynomial.C (f.totalDegree : ℚ))
          let Q := (filteredHilbertPolynomial I).comp
            (Polynomial.X + Polynomial.C (f.totalDegree : ℚ)) - filteredHilbertPolynomial I
          have hPdeg : P.natDegree =
              (filteredHilbertPolynomial (I ⊔ Ideal.span {f})).natDegree :=
            Polynomial.natDegree_taylor _ _
          have hPlc : P.leadingCoeff =
              (filteredHilbertPolynomial (I ⊔ Ideal.span {f})).leadingCoeff :=
            Polynomial.leadingCoeff_taylor _ _
          have hPpos : 0 < P.leadingCoeff := by
            rw [hPlc]
            exact filteredHilbertPolynomial_leadingCoeff_pos _ hsectionproper
          have hs : (f.totalDegree : ℚ) ≠ 0 := mod_cast hfdeg.ne'
          obtain ⟨hQdeg, hQlc⟩ :=
            Polynomial.natDegree_and_leadingCoeff_comp_X_add_C_sub_self (filteredHilbertPolynomial I) hdim _ hs
          have hQpos : 0 < Q.leadingCoeff := by
            rw [show Q.leadingCoeff = _ from hQlc]
            exact mul_pos (mul_pos
              (filteredHilbertPolynomial_leadingCoeff_pos I (Ideal.IsPrime.ne_top ‹I.IsPrime›))
              (by positivity))
              (mod_cast hfdeg)
          have hle := proper_section_hilbert_polynomial_difference I f hfI
          constructor
          · have h := polynomial_natDegree_le_of_eventual_nat_eval_le P Q hPpos hle
            grind
          · intro hdimsection
            have h := polynomial_leadingCoeff_le_of_eventual_nat_eval_le P Q hPpos hQpos
              (by grind) hle
            grind).1

end

/-- A prime ideal in `n + 2` variables whose Hilbert polynomial has degree `n + 1`, that is a
projective hypersurface, is generated by one nonconstant prime element. -/
theorem exists_prime_generator_of_hilbert_dimension {n : ℕ}
    (I : Ideal (MvPolynomial (Fin (n + 2)) ℚ)) [hI : I.IsPrime]
    (hdim : (filteredHilbertPolynomial I).natDegree = n + 1) :
    ∃ p : MvPolynomial (Fin (n + 2)) ℚ, Prime p ∧ 0 < p.totalDegree ∧ I = Ideal.span {p} := by
  obtain ⟨p, hpI, hp⟩ := hI.exists_mem_prime_of_ne_bot (by
    rintro rfl
    rw [filteredHilbertPolynomial_bot, Polynomial.natDegree_preHilbertPoly,
      Fintype.card_fin] at hdim
    omega)
  have hdeg :=
    totalDegree_pos_of_ne_zero_of_not_isUnit hp.ne_zero hp.not_isUnit
  have : (Ideal.span {p}).IsPrime := (Ideal.span_singleton_prime hp.ne_zero).mpr hp
  refine ⟨p, hp, hdeg, ?_⟩
  by_contra hne
  have h_inl : ¬ (Ideal.span {p}) ≤ I := by
    intro h
    have hh := prime_ideal_strict_hilbert_dimension_drop (Ideal.span {p}) I (principal_filteredHilbertPolynomial_natDegree p hp.ne_zero hdeg)
      (Ideal.IsPrime.ne_top ‹I.IsPrime›) (h.lt_of_ne (Ne.symm hne))
    omega
  exact h_inl ((Ideal.span_singleton_le_iff_mem I).mpr hpI)

