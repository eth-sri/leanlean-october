import CCDN.Algebra.PolynomialPredicates
import CCDN.Hilbert.FilteredHilbertPolynomial
import CCDN.Hilbert.LinearProjectionFiltration
import Mathlib.RingTheory.AlgebraicIndependent.Defs
import CCDN.Hilbert.LinearCoordinates
import CCDN.Hilbert.PrincipalHilbertPolynomial
import CCDN.Projection.HilbertProjectionDegree
import CCDN.Projection.HomogeneousFiniteProjectionDegree
import CCDN.Projection.HomogeneousProjectionEquation

/-! Extending a linear projection by one leading coordinate. Integrality and
algebraic independence of the tail coordinates pass to the extended projection;
for a homogeneous prime whose function field is generated by the extended
coordinates, the image is a hypersurface cut out by a form of exactly the
original degree. -/

namespace CCDN
section
open MvPolynomial

section
variable {K τ : Type*} [Field K] {m : ℕ} (I : Ideal (MvPolynomial τ K)) (l : Fin (m + 1) → MvPolynomial τ K)

/-- Restricting the projection along `l` to the tail variables gives the projection along the
tail of `l`. -/
theorem projectionCoordinateMap_comp_rename_succ
    :
    (projectionCoordinateMap I l).comp (rename Fin.succ) =
      projectionCoordinateMap I (fun i : Fin m => l i.succ) := by
  ext i
  simp [projectionCoordinateMap]

/-- A projection is integral as soon as the projection along its tail coordinates is. -/
theorem projectionCoordinateMap_isIntegral_of_tail
    (h : (projectionCoordinateMap I (fun i : Fin m => l i.succ)).IsIntegral) :
    (projectionCoordinateMap I l).IsIntegral := by
  apply RingHom.IsIntegral.tower_top (rename Fin.succ).toRingHom
    (projectionCoordinateMap I l).toRingHom
  change ((projectionCoordinateMap I l).comp (rename Fin.succ)).IsIntegral
  rwa [projectionCoordinateMap_comp_rename_succ]

/-- If the projection along the tail coordinates is injective, the images of the tail
variables under the extended projection are algebraically independent. -/
theorem algebraicIndependent_projectionCoordinateMap_X_succ
    (h : Function.Injective (projectionCoordinateMap I (fun i : Fin m => l i.succ))) :
    AlgebraicIndependent K (fun i : Fin m => projectionCoordinateMap I l (X i.succ)) := by
  have hl : (fun i : Fin m => projectionCoordinateMap I l (X i.succ)) =
      fun i => Ideal.Quotient.mk I (l i.succ) := by
    funext i
    simp [projectionCoordinateMap]
  rw [hl]
  exact injective_projectionCoordinateMap_iff.mp h

end

variable {m : ℕ}

