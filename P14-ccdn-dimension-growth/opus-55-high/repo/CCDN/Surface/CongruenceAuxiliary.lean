import CCDN.AuxiliaryPolynomial.AffineCongruenceAuxiliary
import CCDN.Hilbert.PrincipalStandardMonomials
import CCDN.AuxiliaryPolynomial.HypersurfaceRankProfile
import CCDN.AuxiliaryPolynomial.PlaneAuxiliaryCount
import CCDN.Surface.MonomialWeight

/-! The full standard-monomial prefix produces a proper integer auxiliary
on the entire bounded surface congruence class, with the sharp weighted
degree in the sole remaining numerical gap. -/

namespace CCDN
noncomputable section
open MvPolynomial Finset

section
variable {n : ℕ}

/-- The integer zeros of `f` in the box of radius `B` that are congruent to `a p` modulo `p`,
coordinatewise, for every `p ∈ P`. -/
def affineCongruencePoints (f : MvPolynomial (Fin n) ℤ)
    (B : ℝ) (P : Finset ℕ) (a : ℕ → IntPoint n) : Finset (IntPoint n) := by
  exact (integerBox n B).filter (fun x =>
    eval x f = 0 ∧ ∀ p ∈ P, ∀ j, (p : ℤ) ∣ x j - a p j)

/-- A point lies in `affineCongruencePoints f B P a` exactly when it lies in the box of radius
`B`, is a zero of `f` and is congruent to `a p` modulo every `p ∈ P`. -/
lemma mem_affineCongruencePoints {f : MvPolynomial (Fin n) ℤ}
    {B : ℝ} {P : Finset ℕ} {a : ℕ → IntPoint n} {x : IntPoint n} :
    x ∈ affineCongruencePoints f B P a ↔
      InBox x B ∧ eval x f = 0 ∧
        ∀ p ∈ P, ∀ j, (p : ℤ) ∣ x j - a p j := by
  simp [affineCongruencePoints, mem_filter, mem_integerBox]

end

/-- The number of standard monomials of degree at most `M`, for the degree-lexicographic order,
of the principal ideal generated by the surface equation `f` over `ℚ`: the dimension of the
space of polynomials of degree at most `M` modulo `f`. -/
def surfaceCongruenceRank (f : MvPolynomial (Fin 3) ℤ) (M : ℕ) : ℕ :=
  (standardMonomialPrefix (Ideal.span {map (Int.castRingHom ℚ) f})
    MonomialOrder.degLex M).card

/-- The bound `log s! + ((2/3) s √(2s/d) + (2d + 2) s) log B` for the logarithm of the absolute
value of a determinant formed by evaluating `s` standard monomials of a surface of degree `d`
at `s` integer points of the box of radius `B`. -/
def surfaceWeightedDeterminantUpper (d s : ℕ) (B : ℝ) : ℝ :=
  Real.log (s.factorial : ℝ) +
    ((2 / 3 : ℝ) * s * Real.sqrt (2 * s / (d : ℝ)) + (2 * d + 2) * s) * Real.log B

variable (f : MvPolynomial (Fin 3) ℤ) {M : ℕ}

/-- For a nonzero surface equation `f` of degree `d ≤ M`, the standard-monomial rank
`surfaceCongruenceRank f M` lies between `d (M - d + 1)² / 2` and `d (M + 2)² / 2`. -/
theorem surface_congruence_rank_power_bounds
    (hf : f ≠ 0)
    (hM : f.totalDegree ≤ M) :
    (f.totalDegree : ℝ) * ((M : ℝ) - f.totalDegree + 1) ^ 2 / 2 ≤
      surfaceCongruenceRank f M ∧
    (surfaceCongruenceRank f M : ℝ) ≤
      (f.totalDegree : ℝ) * ((M : ℝ) + 2) ^ 2 / 2 := by
  have hdegree :=
    rational_map_totalDegree f
  have hfQ : map (Int.castRingHom ℚ) f ≠ 0 := by
    intro h
    exact hf ((map_injective (Int.castRingHom ℚ) Int.cast_injective) (by grind))
  have hr := principal_standard_prefix_rank (map (Int.castRingHom ℚ) f)
    hfQ (hdegree ▸ hM)
  rw [hdegree] at hr
  have hb := hypersurface_rank_power_bounds hM hr
  norm_num at hb
  exact hb
