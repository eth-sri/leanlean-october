-    obtain ⟨g, hg⟩ := homogeneousCoefficientMap_surjective n M v
-    have hvan : ∀ i, eval (points i) g.val = 0 := by
-      intro i
-      rw [← homogeneous_evaluation_mulVec g.val g.property]
