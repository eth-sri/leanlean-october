-  exact hh rfl
+    projectiveIdealZeroLocus I = ∅ :=
+  Set.eq_empty_iff_forall_notMem.mpr fun _ hx =>
+    (Nat.ne_of_gt (hilbert_dimension_pos_of_projective_zero I hx)) hdim
 
 end
