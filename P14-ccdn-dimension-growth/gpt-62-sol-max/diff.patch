-    (f : MvPolynomial (Fin (n + 1)) ℤ) (hf : f.IsHomogeneous d)
-    (hf0 : f ≠ 0) (hdM : d ≤ M)
-    (points : Fin t → Fin (n + 1) → ℤ) (hzero : ∀ i, eval (points i) f = 0)
