-private lemma homogeneousCoefficientMap_surjective {K : Type*} [Field K] (n M : ℕ) :
-    Function.Surjective ((homogeneousCoefficientMap K n M).domRestrict
-      (homogeneousSubmodule (Fin (n + 1)) K M)) := by
