-    (f : MvPolynomial (Fin 2) ℤ) (hprim : PrimitiveIntegerPolynomial f)
-    (hir : Irreducible (MvPolynomial.map (Int.castRingHom F) f))
-    (hd : 0 < f.totalDegree) (hf0 : f.coeff 0 ≠ 0)
