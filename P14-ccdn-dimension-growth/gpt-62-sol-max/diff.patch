-    intro h
-    apply hf0
-    exact (map_injective (Int.castRingHom ℚ) Int.cast_injective) (by simpa using h)
-  have hzQ : ∀ i, eval (fun j => (points i j : ℚ)) (map (Int.castRingHom ℚ) f) = 0 := by
-    intro i
-    have h := congrArg (Int.castRingHom ℚ) (hzero i)
