-  | zero => simpa only [mul_zero] using (parameterPowerSpan K u v (N + 1)).zero_mem
-  | add x y hx hy hxi hyi =>
-    simpa only [mul_add] using (parameterPowerSpan K u v (N + 1)).add_mem hxi hyi
-  | smul c x hx hxi =>
