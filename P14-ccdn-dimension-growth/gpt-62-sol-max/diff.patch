-`u ≤ T - h / (8 d X)`. -/
-lemma auxiliary_large_height_bracket_bound {r d M X a k u b l h T : ℝ}
-    (hr : 0 ≤ r) (hd : 1 ≤ d) (hM : 8 * d * (r + 1) ≤ M) (hX : 0 < X)
-    (halow : X * (M - d) / ((r + 1) * M) ≤ a)
-    (haup : a ≤ X * (M + r) / ((r + 1) * M))
-    (hk : 0 ≤ k) (hklow : 1 / (d * (r + 1)) - 1 / M ≤ k)
-    (hb : 0 ≤ b) (hl : 0 ≤ l) (hT : 0 ≤ T)
