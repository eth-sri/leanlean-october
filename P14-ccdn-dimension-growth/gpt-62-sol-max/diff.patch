-theorem Submodule.gcd_plucker_eq_one {k : ℕ} {y : Fin k → (ι → ℤ)}
-    (hy : LinearIndependent ℚ (fun i ↦ Rat.piIntCast ι (y i)))
-    (hspan : Submodule.span ℚ (Set.range fun i ↦ Rat.piIntCast ι (y i)) = V)
