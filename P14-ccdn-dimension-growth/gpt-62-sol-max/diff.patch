-/-- The Arakelov height of a tuple is always at least `1`. -/
-lemma one_le_arakelovMulHeight (x : ι → K) : 1 ≤ arakelovMulHeight x := by
-  rcases eq_or_ne x 0 with rfl | hx
-  · simp
-  obtain ⟨i, hi⟩ : ∃ i, x i ≠ 0 := ne_iff.mp hx
