-        lintegral_eq_lintegral_measure_ofReal_lt _ hf
-    _ = ∫⁻ t in Ioi (0 : ℝ), ∫⁻ x in {x | ENNReal.ofReal t < f x}, g x ∂μ :=
-        lintegral_congr fun t => withDensity_apply g (hK t)
