+    (hi : LinearIndependent ℚ (A.map ((↑) : ℤ → ℚ)).row) : 1 ≤ minorGcd A := by
+  obtain ⟨c, hc⟩ := exists_integer_submatrix_det_ne_zero hi
+  have hg := ne_zero_of_dvd_ne_zero hc (minorGcd_dvd_det A c)
+  have := minorGcd_nonneg A
+  omega
