-private lemma homogeneousCoefficientMap_injective {K : Type*} [Field K] (n M : ℕ) :
-    Function.Injective ((homogeneousCoefficientMap K n M).domRestrict
-      (homogeneousSubmodule (Fin (n + 1)) K M)) := by
