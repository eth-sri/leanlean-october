module

public import CCDN.Algebra.MonomialEvaluationMatrix
public import CCDN.ForMathlib.StandardExponents
public import Mathlib.LinearAlgebra.Matrix.Determinant.Basic
import CCDN.ForMathlib.Matrix
import Mathlib.RingTheory.Localization.FractionRing

/-! Vanishing maximal minors give a nonzero integral relation among standard monomials. -/

@[expose] public section
namespace CCDN
noncomputable section
open MvPolynomial Matrix

private lemma integer_kernel_of_zero_minors {N : ℕ} {ι : Type*} [Fintype ι] (A : Matrix ι (Fin N) ℤ)
    (h : ∀ a : Fin N → ι, (A.submatrix a id).det = 0) :
    ∃ v : Fin N → ℤ, v ≠ 0 ∧ A *ᵥ v = 0 := by
  classical
  let f := Int.castRingHom ℚ
  let Q := A.map f
  have hn : (Q.mulVecLin).ker ≠ ⊥ := by
    rw [Ne, LinearMap.ker_eq_bot]
    intro hi
    obtain ⟨a, ha⟩ := exists_det_submatrix_ne_zero_of_linearIndependent_row _ (Matrix.mulVec_injective_iff.mp hi)
    apply ha
    rw [← det_transpose]
    change (f.mapMatrix (A.submatrix a id)).det = 0
    rw [← RingHom.map_det, h, map_zero]
  obtain ⟨w, hw, hw0⟩ := (Q.mulVecLin.ker.ne_bot_iff).mp hn
  change Q *ᵥ w = 0 at hw
  obtain ⟨D, hD⟩ := IsLocalization.exist_integer_multiples_of_finite (nonZeroDivisors ℤ) w
  choose v hv using hD
  have he : f ∘ v = (D : ℤ) • w := funext hv
  have hd := nonZeroDivisors.coe_ne_zero D
  refine ⟨v, ?_, ?_⟩
  · intro hzero
    apply hw0
    exact (smul_eq_zero.mp (by rw [← he, hzero]; rfl)).resolve_left hd
  · funext i
    change (A *ᵥ v) i = 0
    apply Int.cast_injective (α := ℚ)
    change f ((A *ᵥ v) i) = f 0
    rw [map_zero, RingHom.map_mulVec, he]
    change (Q *ᵥ ((D : ℤ) • w)) i = 0
    rw [mulVec_smul, hw, smul_zero, Pi.zero_apply]

/-- If `mon` is an injective family of `N` standard monomials (for the degree-lexicographic order)
of the ideal generated by `f` over `ℚ`, all of degree at most `M`, and every `N × N` evaluation
determinant of these monomials at points chosen from `x` vanishes, then there is a nonzero
integer polynomial `g` of degree at most `M`, vanishing at every point `x i`, whose image over
`ℚ` is not divisible by `f`. -/
theorem exists_standard_auxiliary_of_zero_determinants {n N M : ℕ} {ι : Type*} [Fintype ι]
    (f : MvPolynomial (Fin n) ℚ) (mon : Fin N → (Fin n →₀ ℕ))
    (hmon : Function.Injective mon)
    (hstd : ∀ j, mon j ∈ Ideal.standardExponents (Ideal.span {f}) MonomialOrder.degLex)
    (hdegree : ∀ j, (mon j).degree ≤ M)
    (x : ι → IntPoint n)
    (hdet : ∀ a : Fin N → ι, (evaluationMatrix mon (x ∘ a)).det = 0) :
    ∃ g : MvPolynomial (Fin n) ℤ, g ≠ 0 ∧
      ¬ f ∣ map (Int.castRingHom ℚ) g ∧ g.totalDegree ≤ M ∧
      ∀ i, eval (x i) g = 0 := by
  classical
  have hdet' (a : Fin N → ι) : ((evaluationMatrix mon x).submatrix a id).det = 0 := hdet a
  obtain ⟨v, hv, hAv⟩ := integer_kernel_of_zero_minors _ hdet'
  let g := polynomialOfCoefficients mon v
  have hg0 := polynomialOfCoefficients_ne_zero mon hmon hv
  have hgQ : map (Int.castRingHom ℚ) g ≠ 0 :=
    (map_ne_zero_iff _ (map_injective _ Int.cast_injective)).mpr hg0
  have hgstd : map (Int.castRingHom ℚ) g ∈
      restrictSupport ℚ (Ideal.standardExponents (Ideal.span {f}) MonomialOrder.degLex) := by
    rw [show map (Int.castRingHom ℚ) g =
        ∑ j, monomial (mon j) (v j : ℚ) by simp [g, polynomialOfCoefficients]]
    exact Submodule.sum_mem _ (fun j _ => by simp [hstd j])
  refine ⟨g, hg0, ?_, totalDegree_polynomialOfCoefficients_le mon v hdegree, ?_⟩
  · intro hdvd
    exact hgQ (Ideal.eq_zero_of_mem_restrictSupport_standardExponents (Ideal.span {f})
      MonomialOrder.degLex hgstd (Ideal.mem_span_singleton.mpr hdvd))
  · intro i
    rw [eval_polynomialOfCoefficients]
    exact congrFun hAv i

end
end CCDN
