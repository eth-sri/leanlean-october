module

public import CCDN.Algebra.PolynomialPredicates
public import CCDN.Hilbert.FilteredHilbertPolynomial
public import CCDN.Projection.ImageFractionField
public import Mathlib.RingTheory.AlgebraicIndependent.Defs
import CCDN.ForMathlib.MvPolynomial
import CCDN.Hilbert.LinearCoordinates
import CCDN.Hilbert.PrincipalHilbertPolynomial
import CCDN.Projection.HilbertProjectionKernel
import CCDN.Projection.FilteredProjectionRank
public import CCDN.Projection.FilteredGenerators

/-! Extending a linear projection by one leading coordinate. Integrality and
algebraic independence of the tail coordinates pass to the extended projection;
for a homogeneous prime whose function field is generated by the extended
coordinates, the image is a hypersurface cut out by a form of exactly the
original degree. -/

@[expose] public section
namespace CCDN
noncomputable section
open MvPolynomial

section

variable {K τ : Type*} [Field K] {m : ℕ}
  (I : Ideal (MvPolynomial τ K)) (l : Fin (m + 1) → MvPolynomial τ K)
include K τ m I l

/-- Restricting the projection along `l` to the tail variables gives the projection along the
tail of `l`. -/
theorem projectionCoordinateMap_comp_rename_succ :
    (projectionCoordinateMap I l).comp (rename Fin.succ) =
      projectionCoordinateMap I (fun i : Fin m => l i.succ) := by
  ext i
  simp [projectionCoordinateMap]


end

/-- A birational linear extension of a filtered normalization preserves the degree. -/
theorem exists_extended_projection_equation
    {K F τ : Type*} [Field K] [Field F] [Algebra K F] [Fintype τ] [LinearOrder τ] {m : ℕ}
    (I : Ideal (MvPolynomial τ K)) [I.IsPrime]
    [Algebra (MvPolynomial τ K ⧸ I) F] [IsScalarTower K (MvPolynomial τ K ⧸ I) F]
    [IsFractionRing (MvPolynomial τ K ⧸ I) F]
    (l : Fin (m + 2) → MvPolynomial τ K) (hl : ∀ i, (l i).totalDegree ≤ 1)
    (hfg : HasFilteredGenerators I (projectionCoordinateMap I (fun i : Fin (m + 1) => l i.succ)))
    (hinj : Function.Injective (projectionCoordinateMap I (fun i : Fin (m + 1) => l i.succ)))
    (hfield : projectionImageField (F := F) I l = ⊤)
    (d : ℕ) (hdimdeg : HasProjectiveDimensionDegree I m d) :
    ∃ f : MvPolynomial (Fin (m + 2)) K, Irreducible f ∧ f.totalDegree = d ∧
      RingHom.ker (projectionCoordinateMap I l) = Ideal.span {f} := by
  obtain ⟨f, hf, hker⟩ := exists_hypersurface_projection_equation I l hl (by rw [hdimdeg.natDegree_eq]; omega)
    (fun i => X i.succ) (fun _ => by simp) (by
      simpa using injective_projectionCoordinateMap_iff.mp hinj)
  have hfpos := totalDegree_pos_of_irreducible hf
  have hfg' := HasFilteredGenerators.of_comp_rename Fin.succ
    ((projectionCoordinateMap_comp_rename_succ I l).symm ▸ hfg)
  obtain ⟨_, _, hlead⟩ := filtered_projection_rank (F := F) I l hl hfg'
  change _ = (Module.finrank (projectionImageField (F := F) I l) F : ℚ) * _ at hlead
  rw [hfield, IntermediateField.finrank_top, Nat.cast_one, one_mul, hker,
    principal_filteredHilbertPolynomial_leadingCoeff f hf.ne_zero hfpos, hdimdeg.leadingCoeff_eq] at hlead
  have hfdeg : f.totalDegree = d := by
    have hh := (div_left_inj' (by positivity : ((m + 1).factorial : ℚ) ≠ 0)).mp hlead
    exact_mod_cast hh.symm
  exact ⟨f, hf, hfdeg, hker⟩

end
end CCDN
