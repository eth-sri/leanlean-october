-variable [Finite ι]
-
-private theorem linearIndependent_euclidean {k : ℕ} {y : Fin k → (ι → ℤ)}
-    (hy : LinearIndependent ℚ (fun i ↦ Rat.piIntCast ι (y i))) :
-    LinearIndependent ℝ fun i ↦ Rat.piEuclidean ι (Rat.piIntCast ι (y i)) := by
