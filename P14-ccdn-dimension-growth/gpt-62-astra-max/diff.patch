-  · exact hR₀proper _ ((erase_ssubset hp).trans_le hRR₀)
-  · rw [← hparentEq]
-    exact not_not.mp hparent
-  · rwa [← hchildEq]
-  · exact F.point_vanishes x hx hxf R hRprime hRsmooth
-
-end
-end CCDN
