-          · exact pow_le_pow_right₀ hdR hcard
-          · positivity
-          · positivity
-    · simp only [surfaceResidueSubsetLocus, dite_eq_left hRW', ite_eq_right hq]
-      have hzero : count (∅ : Set (RatPoint 3)) B = 0 := by simp [count, integralPoints]
-      rw [hzero, Nat.cast_zero]
-      positivity
-  have hunion :
