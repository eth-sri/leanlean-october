+  let M := closedFormCoefficientMatrix d (E f)
+  let V := M.mulVecLin.ker
+  let decode := closedFormPair K d
+  let ev := (aeval z).toLinearMap.comp (E.symm.toLinearMap.comp ((LinearMap.fst K _ _).comp decode))
+  let φ := ev.domRestrict V
