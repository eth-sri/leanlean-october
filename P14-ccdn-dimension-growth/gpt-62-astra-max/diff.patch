-    ⟨mem_filter.mpr ⟨hIS, hedge.parent_mem, hedge.child_not_mem⟩, hxI, ?_⟩⟩
-  have hh := congrArg (Int.castRingHom ℚ) hedge.child_vanishes
-  rw [map_eval, map_zero] at hh
-  exact hh
-
-end
-end CCDN
