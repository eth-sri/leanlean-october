-        ∑ R ∈ W.powerset, (count (surfaceResidueSubsetLocus F S L X hL R) B : ℝ) := by
-    exact_mod_cast count_biUnion_finset_le W.powerset
-      (surfaceResidueSubsetLocus F S L X hL) B
