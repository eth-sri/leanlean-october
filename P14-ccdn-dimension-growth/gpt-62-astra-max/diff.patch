-    (d : ℝ) ≤ affineMinimumAuxiliaryBound n d A B L b := by
-  have hd1 : (1 : ℝ) ≤ d := by exact_mod_cast hd
-  have hn1 : (1 : ℝ) ≤ n + 1 := by have := Nat.cast_nonneg (α := ℝ) n; linarith
