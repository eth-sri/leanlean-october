-  simp only [one_mul] at hcost
-  have hcost2 := mul_le_mul_of_nonneg_left hcost (by norm_num : (0 : ℝ) ≤ 2)
-  convert add_le_add hscaled (hlower.trans hcost2) using 1 <;> ring
