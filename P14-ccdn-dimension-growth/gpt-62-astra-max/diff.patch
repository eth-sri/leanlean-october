-/-- The rows of the identity matrix are the standard basis. -/
-theorem row_one_eq_basisFun :
-    (1 : Matrix (Fin m) (Fin m) R).row = ⇑(Pi.basisFun R (Fin m)) := by
-  funext i j
-  simp [Matrix.one_apply, Pi.single_apply, eq_comm]
-
-end RowOps
