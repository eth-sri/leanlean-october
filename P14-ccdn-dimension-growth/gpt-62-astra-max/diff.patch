-    exists_minimal_product_subset P hW.one_lt_cutoff
-      (fun p hp => by exact_mod_cast (hPprime p hp).pos)
-      (fun p hp => ((mem_congruencePrimeWindow hL).mp (hPW hp)).2.2)
