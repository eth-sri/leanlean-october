-private theorem surface_curve_number_weight {d : ℕ} (hd : 5 ≤ d) {B : ℝ} (hB : 1 ≤ B) :
-    B ^ (1 / Real.sqrt (d : ℝ)) * (Real.log B + 1) ≤
-      (20 * Real.exp (1 / 20 : ℝ)) * B := by
