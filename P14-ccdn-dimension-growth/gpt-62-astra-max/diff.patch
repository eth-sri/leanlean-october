-    ext i
-    rw [homogeneous_evaluation_mulVec u (hhom _ hu)]
-    obtain ⟨w, _, rfl⟩ := Submodule.mem_map.mp hu
-    simp only [LinearMap.mulLeft_apply, eval_mul, hzero i, zero_mul, Pi.zero_apply]
