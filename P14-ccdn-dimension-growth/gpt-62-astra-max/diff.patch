-private lemma box_le_of_logarithmic_height_bound {A B N D : ℝ}
-    (hA : 1 ≤ A) (hB : 1 ≤ B) (hN : 1 ≤ N) (hD : 0 ≤ D)
-    (hheight : B / A ≤ N * Real.log N + N * D * Real.log B) :
-    B ≤ 4 * A ^ 2 * N ^ 4 * (D + 1) ^ 2 := by
-  have hA0 : 0 < A := by linarith
-  have hB0 : 0 < B := by linarith
