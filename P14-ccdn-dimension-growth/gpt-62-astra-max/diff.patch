-    constructor <;> omega
-  · change |((k + 2 : ℕ) : ℤ) - eulerLowExponent (k + 2) i 0 - eulerLowExponent (k + 2) i 1| ≤ _
-    rw [abs_le]
-    constructor <;> omega
