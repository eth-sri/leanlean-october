+  have ht := log_nonneg hB
+  have hW : 1 ≤ W := by
+    have := one_le_mul_of_one_le_of_one_le (one_le_rpow hB (by norm_num : (0:ℝ)≤1/2)) (one_le_pow₀ (n:=3) (show 1 ≤ log B+1 by linarith))
