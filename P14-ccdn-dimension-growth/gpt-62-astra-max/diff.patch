-private theorem square_minorGcd_eq_abs_det {s : ℕ} (A : Matrix (Fin s) (Fin s) ℤ) :
-    Int.Matrix.minorGcd A = |A.det| := by
-  classical
-  let : Nonempty (Set.powersetCard (Fin s) s) :=
-    ⟨⟨univ, by simp⟩⟩
