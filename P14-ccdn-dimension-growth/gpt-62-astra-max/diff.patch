-theorem hasSliceBound_univ_of_le_one {E : Type*} [MeasurableSpace E] [AddCommGroup E] [Module ℝ E]
-    {μ : Measure E} {g : E → ℝ≥0∞} (hg : ∀ x, g x ≤ 1) {Q : Set E} (hQ : ∀ x, x ∈ Q) :
-    HasSliceBound μ g Q := by
-  intro A _ _ _
