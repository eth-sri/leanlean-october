-      · exact Real.rpow_le_rpow_of_exponent_le hB (by linarith)
-      · linarith [Real.log_nonneg hB]
-    _ ≤ _ := by
-      have hh := surface_nonlinear_polylog_weight hd 1 hB
-      norm_num only [Nat.factorial, Nat.cast_one, pow_one, div_one] at hh
-      convert hh using 1
