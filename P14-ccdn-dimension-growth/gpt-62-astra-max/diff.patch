+      _ ≤ ∑ I ∈ T, (δ I:ℝ) := sum_le_sum fun I hi => by simp [(mem_filter.mp hi).2]
+      _ ≤ ∑ I ∈ S, (δ I:ℝ) := by gcongr; exact filter_subset ..
+      _ ≤ _ := budget
