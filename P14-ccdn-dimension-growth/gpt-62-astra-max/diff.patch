+  change A*(_+1)*(1+Real.log B+Q) ≤ levelCost N A * T * U
+  calc _ ≤ A*(2*U)*((1+9*((N:ℝ)+1))*T) := by
+             gcongr <;> dsimp only [T] at * <;> linarith
+       _ = _ := by ring
+
+abbrev residueCost (d N : ℕ) := ((d:ℝ)*(2^N)^2)^9
+
