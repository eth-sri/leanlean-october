+       _ = ((f.totalDegree:ℝ)*U^2)^k*(Y^k)^2 := by rw [mul_pow,mul_pow]; ring
+       _ ≤ _ := by gcongr; exact pow_le_pow_right₀ (one_le_mul_of_one_le_of_one_le hdR (one_le_pow₀ hu)) (W.depth R)
+
+end
+end CCDN.SurfaceWindow
