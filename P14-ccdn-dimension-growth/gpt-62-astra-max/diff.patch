+  have hdpos := hqd ▸ hd
+  obtain ⟨rows, cols, hw, hdeg⟩ := exists_universalPlane_badWitness q ((absolutelyIrreducibleRat_map_iff _).mpr hir) hdpos (.of_charZero _)
