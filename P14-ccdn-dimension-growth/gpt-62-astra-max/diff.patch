-    (hir : AbsolutelyIrreducible f)
-    (hd : 0 < f.totalDegree) (H : ℝ) (hH : 1 ≤ H)
-    (hcoeff : CoefficientHeightLE f H)
-    (mon : Fin N → (Fin (n + 2) →₀ ℕ)) (hmon : Function.Injective mon)
