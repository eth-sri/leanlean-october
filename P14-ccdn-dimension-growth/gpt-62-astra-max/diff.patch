-    ∃ C : ℝ, 0 < C ∧
-      ∀ (f : MvPolynomial (Fin 3) ℤ),
-      HasAbsIrreducibleTopForm f →
-      5 ≤ f.totalDegree →
-      ∀ (S : Finset (Ideal (CoordinatePolynomial 3)))
