+    have hd1 : (1 : ℝ) ≤ d := by exact_mod_cast hd
+    nlinarith [Nat.floor_le (show 0 ≤ 2 * B by positivity), mul_nonneg (sub_nonneg.mpr hB) (Nat.cast_nonneg (α := ℝ) d),
