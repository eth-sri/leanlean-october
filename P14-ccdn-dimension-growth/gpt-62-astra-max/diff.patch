+    have he : Lagrange.basisDivisor (i : ℝ) (j : ℝ) =
+        C (((i : ℝ) - j)⁻¹) * X + C (-((i : ℝ) - j)⁻¹ * j) := by
+      simp only [Lagrange.basisDivisor, neg_mul, map_neg, map_mul, sub_eq_add_neg]
