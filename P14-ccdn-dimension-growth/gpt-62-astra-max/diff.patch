-  match col with
-  | .inl j => (eulerLowExponent k j 1 : ℤ) - t
-  | .inr (.inl j) => (s : ℤ) - eulerLowExponent k j 0
-  | .inr (.inr _) => (k + 2 : ℕ) - (s : ℤ) - t
