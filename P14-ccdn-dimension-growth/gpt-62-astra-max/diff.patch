-instance (V : Submodule ℚ (ι → ℚ)) : DiscreteTopology V.intLattice := by
-  let _ : Fintype ι := Fintype.ofFinite ι
-  obtain ⟨_, b, _, hL, _⟩ := exists_basis_intLattice V
-  rw [hL]
-  infer_instance
