+  have hE : 0 ≤ E := (sum_nonneg (fun _ _ => Nat.cast_nonneg _)).trans budget
+  have hlin := line f top hd B (by linarith) T (fun I h => by
+    obtain ⟨hI,e⟩ := mem_filter.mp h
