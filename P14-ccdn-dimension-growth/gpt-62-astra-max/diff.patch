-private def eulerLowExponent (k : ℕ) (i : EulerLowIndex k) : Fin 2 →₀ ℕ :=
-  ((Finsupp.degreeLeEquivSym (Fin 2) k).symm i).val
-
-private def eulerTopExponent (k : ℕ) (i : EulerTopIndex k) : Fin 2 →₀ ℕ :=
-  ((degreeEqEquivSym (Fin 2) k).symm i).val
