-      (Real.log 4 + 4) * scalingPrimeRatio * L :=
-    (sum_le_sum_of_subset_of_nonneg hPW (fun p _ _ => Real.log_natCast_nonneg p)).trans
-      (congruencePrimeWindow_log_upper hL)
