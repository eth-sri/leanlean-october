-  have hz : aeval (fun _ : Unit => ψ (X j)) g = 0 := by
-    rw [← he]
-    change ψ (rename (fun _ : Unit => j) g) = 0
-    rwa [hg]
-  have hg0 : g = 0 := hi (by simpa only [map_zero] using hz)
-  exact hf (by rw [← hg, hg0, map_zero])
