-  let b := Module.finBasis (RatFunc K) F
-  let r := Module.finrank (RatFunc K) F
-  obtain ⟨q, hq⟩ := IsLocalization.exist_integer_multiples_of_finite
-    (nonZeroDivisors (Polynomial K)) (fun t : ι × Fin r => b.repr (w t.1) t.2)
