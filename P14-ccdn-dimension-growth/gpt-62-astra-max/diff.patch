-  have hd0 : (0 : ℝ) ≤ d := by positivity
-  have hb : (1 : ℝ) ≤ d + 1 := by linarith
-  have h₁ : 1 ≤ ((d : ℝ) + 2) ^ 2 := one_le_pow₀ (by linarith)
-  have h₂ : 1 ≤ (2 * (d : ℝ) + 1) ^ d := one_le_pow₀ (by linarith)
