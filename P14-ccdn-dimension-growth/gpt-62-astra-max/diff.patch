-  have hvars : (f.vars : Set (Fin 2)) ⊆ Set.range (fun _ : Unit => j) := by
-    intro t ht
-    have htk : t ≠ k := fun h => hk (h ▸ ht)
-    have htj : t = j := by omega
-    exact ⟨(), htj.symm⟩
-  obtain ⟨g, hg⟩ := exists_rename_eq_of_vars_subset_range f (fun _ : Unit => j)
