+  _ ≤ Real.log (B * (6 * d)) := Real.log_le_log (by linarith) (by linarith only [hsize])
+  _ ≤ _ := by rw [Real.log_mul (by linarith) (by positivity)]; linarith [Real.log_le_sub_one_of_pos (by positivity : (0 : ℝ) < 6 * d)]
