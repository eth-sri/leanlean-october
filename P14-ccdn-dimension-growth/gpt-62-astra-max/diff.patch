-    rw [hfac, totalDegree_mul_of_isDomain hg hh] at hm
-    exact hm
-  let S := Finset.univ.filter (fun i : ι => eval (algebraMap k K ∘ z i) g = 0)
-  let T := Finset.univ.filter (fun i : ι => ¬ eval (algebraMap k K ∘ z i) g = 0)
