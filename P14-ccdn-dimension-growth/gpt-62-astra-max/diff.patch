+    {K F σ τ : Type*} [Field K] [Field F] [Algebra K F]
+    [Fintype τ]
+    (I : Ideal (MvPolynomial τ K)) [I.IsPrime]
+    [Algebra (MvPolynomial τ K ⧸ I) F]
+    [IsScalarTower K (MvPolynomial τ K ⧸ I) F]
+    [IsFractionRing (MvPolynomial τ K ⧸ I) F]
