-  rw [covolume_eq_measure_fundamentalDomain L μ (F := ZSpan.fundamentalDomain bR)
-    (MeasureTheory.IsAddFundamentalDomain.mk'
-      (ZSpan.fundamentalDomain_measurableSet bR).nullMeasurableSet key), measureReal_def]
