-    plucker m A.row s =
-      (A.submatrix id ((s : Finset ι).orderEmbOfFin (Set.powersetCard.card_eq s))).det := by
-  rw [plucker_apply, Set.powersetCard.ofFinEmbEquiv_symm_apply]
-  rfl
