-    · rw [Set.indicator_of_mem hx,
-        Set.indicator_of_mem (show e x ∈ e.symm ⁻¹' A by simpa using hx)]
-    · rw [Set.indicator_of_notMem hx,
-        Set.indicator_of_notMem (show e x ∉ e.symm ⁻¹' A by simpa using hx)]
