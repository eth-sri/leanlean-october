-  have hfun : (fun i ↦ ((Basis.span hv i : ι → K))) = v :=
-    funext fun i ↦ congrArg Subtype.val (Basis.span_apply hv i)
-  rw [pluckerPoint_eq_mk hV (Basis.span hv) (by rw [hfun]; exact plucker_ne_zero hv)]
-  simp only [hfun]
-
-end Submodule
