-namespace Int.Matrix
-
-variable {α β : Type*} [Fintype α] [Fintype β] (A : Matrix α β ℤ)
-
-end Int.Matrix
-
-/-! ### Siegel's lemma over a number field -/
-
-namespace NumberField
-
-variable {K : Type*} [Field K] [NumberField K] {ι : Type*} [Finite ι]
-
-end NumberField
