module

public import CCDN.Hilbert.FilteredHilbertPolynomial
import CCDN.ForMathlib.MvPolynomial
import CCDN.Hilbert.PolynomialComparison
import CCDN.Hilbert.PrincipalHilbertPolynomial
import CCDN.Hilbert.ProperHilbertDimension
import CCDN.Hilbert.ProperSectionHilbert
import Mathlib.RingTheory.Polynomial.UniqueFactorization

/-! A strict containment of affine prime ideals strictly lowers the
Hilbert dimension. The proof uses a polynomial in their difference. -/

@[expose] public section
namespace CCDN
noncomputable section
open MvPolynomial

/- Distinct prime ideals of the same positive Hilbert dimension are not contained in one another.
-/

/-- A prime ideal in `n + 2` variables whose Hilbert polynomial has degree `n + 1`, that is a
projective hypersurface, is generated by one nonconstant prime element. -/
theorem exists_prime_generator_of_hilbert_dimension {n : ℕ}
    (I : Ideal (MvPolynomial (Fin (n + 2)) ℚ)) [hI : I.IsPrime]
    (hdim : (filteredHilbertPolynomial I).natDegree = n + 1) :
    ∃ p : MvPolynomial (Fin (n + 2)) ℚ, Prime p ∧ 0 < p.totalDegree ∧ I = Ideal.span {p} := by
  have hbot : I ≠ ⊥ := by
    rintro rfl
    rw [filteredHilbertPolynomial_bot, Polynomial.natDegree_preHilbertPoly,
      Fintype.card_fin] at hdim
    omega
  obtain ⟨p, hpI, hp⟩ := hI.exists_mem_prime_of_ne_bot hbot
  have hdeg : 0 < p.totalDegree :=
    totalDegree_pos_of_ne_zero_of_not_isUnit hp.ne_zero hp.not_isUnit
  have : (Ideal.span {p}).IsPrime := (Ideal.span_singleton_prime hp.ne_zero).mpr hp
  refine ⟨p, hp, hdeg, ?_⟩
  by_contra hne
  have hIJ := lt_of_le_of_ne ((Ideal.span_singleton_le_iff_mem I).mpr hpI) (Ne.symm hne)
  have hItop : I ≠ ⊤ := hI.ne_top
  obtain ⟨f, hfI, hfp⟩ := IsConcreteLE.not_le_iff_exists.mp (not_le_of_gt hIJ)
  have hsection : Ideal.span {p} ⊔ Ideal.span {f} ≤ I :=
    sup_le hIJ.le (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hfI))
  have hfdeg : 0 < f.totalDegree := by
    by_contra! hd
    have he := totalDegree_eq_zero_iff_eq_C.mp (Nat.eq_zero_of_le_zero hd)
    have hc : f.coeff 0 ≠ 0 := fun hc => hfp (by rw [he, hc, map_zero]; exact Submodule.zero_mem _)
    exact hItop (Ideal.eq_top_of_isUnit_mem I hfI (he ▸ (isUnit_iff_ne_zero.mpr hc).map C))
  have hh := (filteredHilbertPolynomial_natDegree_le I _ hItop
    (filteredCoordinateSpace_finrank_antitone_ideal _ _ hsection)).trans
      (proper_section_hilbert_dimension_leadingCoeff (Ideal.span {p}) n
        (principal_filteredHilbertPolynomial_natDegree p hp.ne_zero hdeg) f hfp hfdeg
        fun htop => hItop (top_le_iff.mp (htop ▸ hsection))).1
  omega

end
end CCDN
