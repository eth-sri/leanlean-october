module

public import CCDN.Statements
import CCDN.Hilbert.PrimeIdealDimensionDrop
import CCDN.Hilbert.PrincipalHilbertPolynomial
import CCDN.Hypersurface.AffineHypersurfaceCount
import CCDN.Hypersurface.NonabsoluteHypersurfaceCount
import CCDN.Projection.HomogeneousProjectionEquation

/-!
Projective hypersurface dimension growth in every degree at least five, from the
affine bound on the cone. The equation need only be irreducible over `ℚ`: an equation which
splits over `ℚ̄` has few points by the nonabsolute count.

A projective point count is bounded by the integer count on its
affine cone at the same height. Chosen primitive representatives give a
height-preserving injection.
-/

@[expose] public section
namespace CCDN
noncomputable section
open MvPolynomial

/-- CCDN Theorem 1 for rationally irreducible projective hypersurfaces of degree at least
five in `ℙ^(n+2)`, with degree exponent `18 + 3n`. Unlike the paper, the equation may split
over `ℚ̄`. -/
theorem projective_hypersurface_dimension_growth (n : ℕ) :
    ProjectiveHypersurfaceGrowth n (18 + 3 * n) := by
  classical
  obtain ⟨C, hC, hbound⟩ := (affineHypersurfaceGrowth n).rational
  let A : ℝ := (3 * (n + 3) : ℝ) ^ (n + 1)
  refine ⟨C + A, by positivity, fun f hhom hir hd B hB => ?_⟩
  have hd1 : (1 : ℝ) ≤ f.totalDegree := mod_cast (show 1 ≤ f.totalDegree by omega)
  have hB0 : 0 ≤ B := by linarith
  have hcone : (projectiveCount (projectiveZeroLocus f) B : ℝ) ≤ count (zeroLocus f) B := by
    let S := projectivePoints (projectiveZeroLocus f) B
    have hsub : S.image primitiveProjectiveRep ⊆ integralPoints (zeroLocus f) B := by
      rintro _ hz
      obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hz
      obtain ⟨hheight, hzero⟩ := mem_projectivePoints.mp hx
      exact mem_integralPoints.mpr ⟨fun i => (primitiveProjectiveRep_bound x i).trans hheight,
        (mem_projectiveZeroLocus_primitive hhom x).mp hzero⟩
    have hc := Finset.card_le_card hsub
    rw [Finset.card_image_of_injective S primitiveProjectiveRep_injective] at hc
    exact_mod_cast hc
  by_cases habs : AbsolutelyIrreducibleRat f
  · have htop : HasAbsIrreducibleTopFormRat f := by
      dsimp only [HasAbsIrreducibleTopFormRat, AbsolutelyIrreducibleRat]
      rwa [homogeneousComponent_eq_self hhom]
    refine (hcone.trans (hbound f htop hd B hB)).trans ?_
    gcongr
    exact le_add_of_nonneg_right (by positivity)
  · have hh : (projectiveCount (projectiveZeroLocus f) B : ℝ) ≤
        A * (f.totalDegree : ℝ) ^ 2 * B ^ (n + 1) :=
      hcone.trans (by
        simpa only [A, Nat.cast_add, Nat.cast_one, add_assoc,
          show (1 : ℝ) + 2 = 3 by norm_num] using
          nonabsolute_hypersurface_dimension_growth f hir habs hB)
    refine hh.trans ?_
    have : 2 ≤ 18 + 3 * n := by omega
    gcongr
    linarith

/-- The hypersurface bound in the Hilbert-polynomial formulation: a homogeneous prime ideal
of codimension one is generated by an irreducible homogeneous equation of degree `d`. -/
theorem ProjectiveHypersurfaceGrowth.ideal {n e : ℕ} (h : ProjectiveHypersurfaceGrowth n e) :
    ∃ C : ℝ, 0 < C ∧
      ∀ I : Ideal (MvPolynomial (Fin (n + 3)) ℚ), I.IsPrime → IsHomogeneousIdeal I →
      ∀ d : ℕ, 5 ≤ d → HasProjectiveDimensionDegree I (n + 1) d →
      ∀ B : ℝ, 1 ≤ B →
      (projectiveCount (projectiveIdealZeroLocus I) B : ℝ) ≤
        C * (d : ℝ) ^ e * B ^ (n + 1) := by
  obtain ⟨C, hC, hbound⟩ := h
  refine ⟨C, hC, fun I hprime hI d hd ⟨hdim, hdegree⟩ B hB => ?_⟩
  obtain ⟨p, hp, hpdeg, rfl⟩ := exists_prime_generator_of_hilbert_dimension I hdim
  have hpd : p.totalDegree = d := by
    rw [principal_filteredHilbertPolynomial_leadingCoeff p hp.ne_zero hpdeg] at hdegree
    exact_mod_cast (div_left_inj' (by positivity : ((n + 2).factorial : ℚ) ≠ 0)).mp hdegree
  have hsub : projectiveIdealZeroLocus (Ideal.span {p}) ⊆ projectiveZeroLocus p :=
    fun x hx => projectiveIdealZeroLocus_rep hx p (Ideal.mem_span_singleton_self p)
  refine (show (projectiveCount (projectiveIdealZeroLocus (Ideal.span {p})) B : ℝ) ≤
      projectiveCount (projectiveZeroLocus p) B from
    mod_cast projectiveCount_mono hsub le_rfl).trans ?_
  simpa only [hpd] using
    hbound p (principal_generator_isHomogeneous _ hI p hp.ne_zero rfl) hp.irreducible (by omega) B hB

end
end CCDN
