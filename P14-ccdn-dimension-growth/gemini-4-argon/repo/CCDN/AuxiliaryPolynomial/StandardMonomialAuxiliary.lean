module

public import CCDN.Algebra.MonomialEvaluationMatrix
public import CCDN.ForMathlib.StandardExponents
public import Mathlib.LinearAlgebra.Matrix.Determinant.Basic
import ArithmeticHeights.BombieriVaaler
import CCDN.Algebra.RowSelection

/-! Vanishing maximal determinants on a standard-monomial family produce
an integer auxiliary outside the original principal ideal. -/

@[expose] public section
namespace CCDN
noncomputable section
open MvPolynomial Matrix

/-- If `mon` is an injective family of `N` standard monomials (for the degree-lexicographic order)
of the ideal generated by `f` over `ℚ`, all of degree at most `M`, and every `N × N` evaluation
determinant of these monomials at points chosen from `x` vanishes, then there is a nonzero
integer polynomial `g` of degree at most `M`, vanishing at every point `x i`, whose image over
`ℚ` is not divisible by `f`. -/
theorem exists_standard_auxiliary_of_zero_determinants {n N t M : ℕ}
    (f : MvPolynomial (Fin n) ℚ) (mon : Fin N → (Fin n →₀ ℕ))
    (hmon : Function.Injective mon)
    (hstd : ∀ j, mon j ∈ Ideal.standardExponents (Ideal.span {f}) MonomialOrder.degLex)
    (hdegree : ∀ j, (mon j).degree ≤ M)
    (x : Fin t → IntPoint n)
    (hdet : ∀ a : Fin N → Fin t, (evaluationMatrix mon (x ∘ a)).det = 0) :
    ∃ g : MvPolynomial (Fin n) ℤ, g ≠ 0 ∧
      ¬ f ∣ map (Int.castRingHom ℚ) g ∧ g.totalDegree ≤ M ∧
      ∀ i, eval (x i) g = 0 := by
  classical
  let A := evaluationMatrix mon x
  obtain ⟨r, a, _, hli, hspan, _⟩ := exists_independent_spanning_rows (A.map ((↑) : ℤ → ℚ))
  have hrN : r < N := by
    by_contra hn
    obtain rfl : r = N := by omega
    apply (Matrix.isUnit_iff_isUnit_det _).mp (Matrix.linearIndependent_row_iff_isUnit.mp hli) |>.ne_zero
    have heA : (A.map ((↑) : ℤ → ℚ)).submatrix a id =
        (Int.castRingHom ℚ).mapMatrix (evaluationMatrix mon (x ∘ a)) := by ext; rfl
    rw [heA, ← RingHom.map_det, hdet a, map_zero]
  obtain ⟨v, hv, hAv⟩ := Int.Matrix.exists_ne_zero_mulVec_eq_zero
    (evaluationMatrix mon (x ∘ a)) hli (by simpa only [Fintype.card_fin] using hrN)
  let g := polynomialOfCoefficients mon v
  have hg0 : g ≠ 0 := polynomialOfCoefficients_ne_zero mon hmon hv
  have hgstd : map (Int.castRingHom ℚ) g ∈
      restrictSupport ℚ (Ideal.standardExponents (Ideal.span {f}) MonomialOrder.degLex) := by
    intro m hm
    by_contra hbad
    have hne (j : Fin N) : mon j ≠ m := fun he => hbad (he ▸ hstd j)
    exact (mem_support_iff.mp hm) (by
      simp [g, polynomialOfCoefficients, coeff_monomial, hne])
  refine ⟨g, hg0, fun hdvd => hg0 (map_injective (Int.castRingHom ℚ) Int.cast_injective ?_),
    totalDegree_polynomialOfCoefficients_le mon v hdegree, fun i => ?_⟩
  · simpa using Ideal.eq_zero_of_mem_restrictSupport_standardExponents (Ideal.span {f})
      MonomialOrder.degLex hgstd (Ideal.mem_span_singleton.mpr hdvd)
  · apply vanishes_of_evaluation_row_mem_span mon (x ∘ a) v hAv
    change (A.map ((↑) : ℤ → ℚ)).row i ∈ _
    rw [show Submodule.span ℚ (Set.range ((evaluationMatrix mon (x ∘ a)).map
      ((↑) : ℤ → ℚ)).row) = Submodule.span ℚ (Set.range (A.map ((↑) : ℤ → ℚ)).row) from hspan]
    exact Submodule.subset_span ⟨i, rfl⟩

end
end CCDN
