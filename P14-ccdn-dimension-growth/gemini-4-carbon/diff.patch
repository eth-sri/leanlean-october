-    simp only [I, FractionalIdeal.coeIdeal_mul, FractionalIdeal.coeIdeal_span_singleton,
-      Units.val_mul, coe_toPrincipalIdeal]
-    rw [← (J : FractionalIdeal R⁰ K).den_mul_self_eq_num']
