-  have hs0 : (0 : ℝ) < s := by exact_mod_cast hs
-  have hM0 : (0 : ℝ) < M := by exact_mod_cast lt_of_lt_of_le hd hdM
-  have hd1 : (1 : ℝ) ≤ d := by exact_mod_cast hd
-  have hr0 : (0 : ℝ) < r + 1 := by positivity
-  have hmd : (d : ℝ) ≤ M := by exact_mod_cast hdM
