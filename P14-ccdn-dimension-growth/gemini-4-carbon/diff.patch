+private lemma surfaceWindowSize_one_le {W_sc B : ℝ} (hW : 2 ≤ W_sc) (hB : 1 ≤ B) :
+    1 ≤ surfaceWindowSize W_sc B := by
+  unfold surfaceWindowSize; nlinarith [Real.log_nonneg hB]
