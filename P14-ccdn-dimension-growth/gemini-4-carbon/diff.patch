-`C = planeResidueConstant`. -/
-def PlaneResidueBound (C : ℝ) : Prop :=
-  ∀ f : MvPolynomial (Fin 2) ℤ, 0 < f.totalDegree → PlaneResidueCountBound C f.totalDegree f
