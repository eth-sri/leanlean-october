-        (by positivity) hB0 hK ha hmap hcount
-    _ ≤ ((2 * (n + 1 : ℕ) + 1) * (d : ℝ) ^ 3 * B) *
-        (C * (d : ℝ) ^ e * B ^ r) := mul_le_mul_of_nonneg_right hfactor hK
-    _ = _ := by rw [pow_add, pow_succ]; ring
