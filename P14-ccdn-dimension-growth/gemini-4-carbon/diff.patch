-private lemma ambientEulerEntryLinear_coefficientwiseHomogeneous
-    (σ : Type*) [Fintype σ] [DecidableEq σ] (k : ℕ)
-    (row : ℕ × ℕ) (col : EulerColumns k) :
-    CoefficientwiseHomogeneous
