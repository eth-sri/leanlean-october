-    1 / ((d : ℝ) * (r + 1 : ℝ)) - 1 / (M : ℝ) ≤
-        ((r + 1 + (M - d)).choose (M - d) : ℝ) / ((M : ℝ) * s) ∧
-      ((r + 1 + (M - d)).choose (M - d) : ℝ) / ((M : ℝ) * s) ≤
-        1 / ((d : ℝ) * (r + 1 : ℝ)) + 1 / (M : ℝ) := by
