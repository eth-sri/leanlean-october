-    rw [homogeneousComponent_of_mem hm,
-      homogeneousComponent_of_mem (graphHyperplaneRestriction_homogeneous a hm)]
-    split_ifs <;> simp
-  | add f g hf hg => simp only [map_add, hf, hg]
