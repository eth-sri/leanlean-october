-      LinearIndependent K v ∧ LinearIndependent K w ∧
-      span K (Set.range v) = V ∧
-      span K (Set.range w) = V.dualAnnihilator.comap (Module.piEquiv ι K K).toLinearMap ∧
-      ∀ s : Set.powersetCard ι k,
