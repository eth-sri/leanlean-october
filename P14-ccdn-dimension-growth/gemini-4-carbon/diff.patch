-  -- the quotient measure of the dilates, one per minimum
-  have hLcount : Countable L := countable_of_discreteTopology L
-  obtain ⟨M, hM⟩ : ∃ M : ℕ → ℝ≥0∞, ∀ j,
-      M j = μ (FL ∩ ((lam j / 2) • interior B + (L : Set E))) := ⟨_, fun _ ↦ rfl⟩
