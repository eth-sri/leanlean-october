-/-- The Gauss density on `ι → ℝ` for the euclidean norm. -/
-@[expose] noncomputable def gaussPi {ι : Type*} [Fintype ι] (x : ι → ℝ) : ℝ≥0∞ :=
-  ENNReal.ofReal (Real.exp (-π * ∑ i, (x i) ^ 2))
