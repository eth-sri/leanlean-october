-    (r + k + 1) * (r + k).choose r = (r + 1 + k).choose (r + 1) * (r + 1) := by
-  rw [show r + 1 + k = r + k + 1 by omega]
-  exact Nat.add_one_mul_choose_eq (r + k) r
