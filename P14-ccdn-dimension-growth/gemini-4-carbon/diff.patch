+  have hx : (2 * B ^ (1 / Real.sqrt (d : ℝ))) ^ 2 = 4 * B ^ (2 / Real.sqrt (d : ℝ)) := by
+    rw [mul_pow, ← Real.rpow_natCast (B ^ _) 2, ← Real.rpow_mul hB0.le]
