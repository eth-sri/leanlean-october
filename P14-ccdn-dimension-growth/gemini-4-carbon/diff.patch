-  have hf0 : f ≠ 0 := fun h => hg0 (by simp [he, h])
-  have hq0 : q ≠ 0 := fun h => hg0 (by simp [he, h])
-  have hqdegree : q.totalDegree = 0 := by
-    have hh := totalDegree_mul_of_isDomain hf0 hq0
-    rw [← he, hf.totalDegree hf0, hg.totalDegree hg0] at hh
