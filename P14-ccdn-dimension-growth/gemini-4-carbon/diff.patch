-private lemma universalPlane_coordinate_flatten_l1_le {σ : Type*} (i : σ) :
-    l1Norm ((sumAlgEquiv ℤ (Fin 2) (PlaneParameters σ)).symm
-      (C (X (i,0)) + C (X (i,1)) * X 0 + C (X (i,2)) * X 1)) ≤ 3 := by
