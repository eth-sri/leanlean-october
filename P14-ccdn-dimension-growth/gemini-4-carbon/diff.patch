-  have hlog := Real.log_nonneg hB
-  have hU : 0 ≤ U := by dsimp [U]; positivity
-  have hS : 0 ≤ ∑ i ∈ s, (δ i : ℝ) := Finset.sum_nonneg fun _ _ => by positivity
-  have hpoint : ∀ i ∈ s, curveBound (δ i) B ≤
-      (δ i : ℝ) * U + (2 * Real.exp 1) * (δ i : ℝ) ^ 4 := by
