+private theorem surface_directionalDerivative_ne_zero
+    (f : MvPolynomial (Fin 3) ℤ) (hir : HasAbsIrreducibleTopForm f) (hd : 2 ≤ f.totalDegree)
+    (v : Fin 3 → ℚ) (hv : v ≠ 0) :
+    directionalDerivative v (map (Int.castRingHom ℚ) f) ≠ 0 := by
