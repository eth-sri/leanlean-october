-    have hz' : ∀ j, z j ∈ s := Fintype.mem_piFinset.mp hz
-    apply mem_projectivePoints.mpr
-    refine ⟨affineProjectivePoint_integer_height_le z hB (fun j => hsB (z j) (hz' j)), ?_⟩
