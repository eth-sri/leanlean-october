-    polynomialOfCoefficients_ne_zero mon (homogeneousMonomials_injective n M) hv,
-    polynomialOfCoefficients_homogeneous n M v, ?_, ?_⟩
-  · intro i
-    apply vanishes_of_evaluation_row_mem_span mon (points ∘ a) v hAv (points i)
