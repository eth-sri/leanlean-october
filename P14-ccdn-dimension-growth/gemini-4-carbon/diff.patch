-      D ≠ 0 ∧ |D| ≤ (d ^ 3 : ℕ) ∧ (∀ i, |a i| ≤ (d ^ 3 : ℕ)) ∧
-      (graphHyperplaneRestriction (fun i => (a i : ℚ) / D)
-        (map (Int.castRingHom ℚ) f)).totalDegree = d ∧
-      AbsolutelyIrreducibleRat (graphHyperplaneRestriction (fun i => (a i : ℚ) / D)
-        (map (Int.castRingHom ℚ) f)) := by
