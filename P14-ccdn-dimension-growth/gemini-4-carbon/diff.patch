-    (hd : Module.finrank F K = 2) (σ : K ≃ₐ[F] K) (hσ : σ ≠ 1)
-    (s : Multiset (Ideal (𝓞 K)))
-    (hs : ∀ Q ∈ s, IsQuadraticRamifiedPrime F K Q) :
