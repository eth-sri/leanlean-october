-lemma arakelovMulHeight_pos (x : ι → K) : 0 < arakelovMulHeight x :=
-  zero_lt_one.trans_le <| one_le_arakelovMulHeight x
-
-lemma arakelovLogHeight_nonneg (x : ι → K) : 0 ≤ arakelovLogHeight x :=
-  log_nonneg <| one_le_arakelovMulHeight x
