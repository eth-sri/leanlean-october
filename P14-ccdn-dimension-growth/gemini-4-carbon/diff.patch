-  have hWrank : finrank K W = l := by
-    have h := Submodule.finrank_sup_add_finrank_inf_eq V W
-    rw [hW.sup_eq_top, hW.inf_eq_bot, finrank_top, finrank_bot, hk, Module.finrank_pi] at h
