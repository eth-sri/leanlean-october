-  have h0 : scaledHomogenize d 1 f ≠ 0 := by
-    intro h
-    have hh := affineChart_scaledHomogenize_one d f
-    rw [h, map_zero] at hh
-    exact hf.ne_zero (by rw [← hh, map_zero])
