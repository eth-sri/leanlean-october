-  · right
-    push Not at hrel
-    obtain ⟨g, hgh, hgz, hgnd⟩ := hrel
-    refine ⟨g, fun h => hgnd (by rw [h]; exact dvd_zero _), hgh, ?_, hgnd⟩
-    intro x hxB hxf
