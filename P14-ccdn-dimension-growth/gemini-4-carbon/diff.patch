-private theorem exists_norm_translate_cover (B : ℝ) :
-    ∃ β : (boundedSquareNormTranslationClasses K B) → 𝓞 K,
-      Function.Injective β ∧
-      (∀ q, ∀ w : InfinitePlace K, w (β q : K) ≤ B) ∧
-      ∀ α ∈ boundedSquareNormIntegers K B,
