-    intro z hzx hzy
-    have hzx' : dist x z < 1 / 2 := by
-      simpa only [dist_comm] using Metric.mem_ball.mp hzx
-    have hzy' : dist z y < 1 / 2 := Metric.mem_ball.mp hzy
-    have ht := dist_triangle x z y
-    have hh := hsep x hx y hy hxy
-    rw [← dist_eq_norm] at hh
-    linarith
