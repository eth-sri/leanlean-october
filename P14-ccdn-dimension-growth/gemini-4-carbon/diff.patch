-      (count (⋃ P ∈ s, idealZeroLocus P) B : ℝ) ≤
-        K * Real.exp 1 * (480 * C + 2 * C ^ 4) * (d : ℝ) ^ 18 * B := by
-  obtain ⟨K, hK, hcount⟩ := affine_curve_count 3 (by omega)
-  refine ⟨K, hK, ?_⟩
-  intro s δ d hd C B hC hB hcurve hdegree
