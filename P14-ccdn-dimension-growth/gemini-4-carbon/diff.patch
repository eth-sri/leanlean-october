-  (12 * affineHypersurfaceAuxiliaryConstant 0 * (n : ℝ) ^ 4) *
-    (numberFieldLatticeBoxConstant n ((n : ℝ) ^ 3) * (2 : ℝ) ^ n) *
-    (3 * (9 : ℝ) ^ (n - 1))
