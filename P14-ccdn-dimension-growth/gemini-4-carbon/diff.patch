+has volume at least `2 ^ dim V`. -/
 theorem two_pow_finrank_le_volume_inter_cube {ι : Type*} [Fintype ι]
     (V : Submodule ℝ (EuclideanSpace ℝ ι)) :
     (2 : ℝ≥0∞) ^ Module.finrank ℝ V ≤
       volume {y : V | ∀ i, |(y : EuclideanSpace ℝ ι) i| ≤ 1} := by
