-    ∃ K : ℝ, 0 < K ∧
-      ∀ (s : Finset (Ideal (CoordinatePolynomial 3)))
-        (δ : Ideal (CoordinatePolynomial 3) → ℕ) (d : ℕ),
-      16 ≤ d → ∀ C B : ℝ, 0 ≤ C → 1 ≤ B →
-      (∀ P ∈ s, P.IsPrime ∧ 2 ≤ δ P ∧ HasAffineCurveDegree P (δ P)) →
