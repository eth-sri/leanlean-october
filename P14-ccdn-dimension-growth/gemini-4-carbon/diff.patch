-    integer_slice_map_of_option_equations f D a g (fun k => (hg k).2.2) B k x hx
-  have hcount (k : ℤ) :
-      (count (Y k) B : ℝ) ≤ C * (f.totalDegree : ℝ) ^ e * B ^ (n + 1) := by
