-  have hlast1 := mul_le_mul_of_nonneg_right hsN hlogN
-  have hlast2 := mul_le_mul_of_nonneg_right hsN
-    (mul_nonneg (Nat.cast_nonneg (α := ℝ) d) hlogB)
-  change Real.log H ≤ (N : ℝ) * Real.log N + N * d * Real.log B
-  nlinarith
