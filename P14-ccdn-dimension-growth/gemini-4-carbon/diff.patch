+  calc (count (rationalAffineLine a v) B : ℝ) ≤ 1 + 2 * B / p.mulHeight := hcnt
+    _ ≤ 2 * B / p.mulHeight + 2 * B / p.mulHeight := by linarith
+    _ = 4 * B / p.mulHeight := by ring
 
