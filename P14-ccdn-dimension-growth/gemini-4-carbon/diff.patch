-    (integerNormPolynomial K β).eval x =
-      Algebra.norm ℤ (algebraMap ℤ (𝓞 K) x - β) := by
-  rw [integerNormPolynomial, LinearMap.eval_charpoly, Algebra.norm_apply,
-    map_sub (Algebra.lmul ℤ (𝓞 K)), Algebra.lmul_algebraMap]
-  rfl
