module

public import Mathlib.NumberTheory.NumberField.ClassNumber

/-! The algebraic starting point of the class-group application.
Classes killed by two have nonzero integral representatives whose
squares are principal. A principal square determines its ideal uniquely;
thus generators chosen for distinct classes are distinct. The norm assertion
uses the absolute value: a signed field norm need not be positive. -/

@[expose] public section
namespace CCDN
open scoped NumberField nonZeroDivisors Real

section Dedekind
variable {R : Type*} [CommRing R] [IsDedekindDomain R]

private lemma integralIdeal_pow_injective {m : ℕ} (hm : m ≠ 0) :
    Function.Injective (fun I : Ideal R => I ^ m) := by
  intro I J h
  change I ^ m = J ^ m at h
  apply le_antisymm
  · apply Ideal.le_of_dvd
    apply (UniqueFactorizationMonoid.pow_dvd_pow_iff_dvd hm).mp
    rw [h]
  · apply Ideal.le_of_dvd
    apply (UniqueFactorizationMonoid.pow_dvd_pow_iff_dvd hm).mp
    rw [h]


/-- Two nonzero integral ideals whose squares are generated by the same element are equal, hence
have the same ideal class. -/
lemma ideal_class_eq_of_square_generators_eq
    (I J : (Ideal R)⁰) {β γ : R}
    (hI : (I : Ideal R) ^ 2 = Ideal.span {β})
    (hJ : (J : Ideal R) ^ 2 = Ideal.span {γ}) (hβγ : β = γ) :
    ClassGroup.mk0 I = ClassGroup.mk0 J := by
  have hpow : (I : Ideal R) ^ 2 = (J : Ideal R) ^ 2 := by rw [hI, hJ, hβγ]
  have hIJ := Subtype.ext (integralIdeal_pow_injective (by norm_num) hpow)
  rw [hIJ]

end Dedekind

variable (K : Type*) [Field K] [NumberField K]

/-- The subgroup of the ideal class group killed by two. -/
noncomputable def classGroupTwoTorsion : Subgroup (ClassGroup (𝓞 K)) :=
  (powMonoidHom 2).ker

omit [NumberField K] in
/-- An ideal class lies in the two-torsion subgroup if and only if its square is trivial. -/
@[simp] lemma mem_classGroupTwoTorsion (c : ClassGroup (𝓞 K)) :
    c ∈ classGroupTwoTorsion K ↔ c ^ 2 = 1 := Iff.rfl

/-- The order `h₂(K)` of the two-torsion subgroup of the class group of `K`, the quantity bounded
in CCDN Theorem 6. -/
noncomputable def classGroupTwoTorsionCard  := Nat.card (classGroupTwoTorsion K)

/-- The order of the two-torsion subgroup of the class group is at most the class number. -/
lemma classGroupTwoTorsionCard_le_classNumber :
    classGroupTwoTorsionCard K ≤ NumberField.classNumber K := by
  classical
  simpa [classGroupTwoTorsionCard, NumberField.classNumber, Nat.card_eq_fintype_card] using
    Fintype.card_le_of_injective
      ((Subtype.val)) Subtype.val_injective

/-- If `I ^ 2 = (β)`, then the absolute norm `|N(β)|` equals `N(I) ^ 2`. -/
lemma generator_absolute_norm_of_ideal_square (I : Ideal (𝓞 K)) {β : 𝓞 K}
    (hI : I ^ 2 = Ideal.span {β}) :
    (Algebra.norm ℤ β).natAbs = Ideal.absNorm I ^ 2 := by
  rw [← Ideal.absNorm_span_singleton, ← hI, map_pow]

/-- Every two-torsion class has a nonzero integral representative and a nonzero
generator of its square. -/
theorem exists_two_torsion_integral_square_representative
    (c : classGroupTwoTorsion K) :
    ∃ I : (Ideal (𝓞 K))⁰, ∃ β : 𝓞 K,
      ClassGroup.mk0 I = c ∧ β ≠ 0 ∧
      (I : Ideal (𝓞 K)) ^ 2 = Ideal.span {β} := by
  obtain ⟨I, hIc⟩ := ClassGroup.mk0_surjective c.val
  have hIsq : (ClassGroup.mk0 I) ^ 2 = 1 := by
    rw [hIc]
    exact c.property
  obtain ⟨β, hβ, hIβ⟩ := (show ∃ β, β ≠ (0 : 𝓞 K) ∧ ↑I ^ (2 : ℕ) = Ideal.span {β} from (by
                           have hinv : ClassGroup.mk0 I = (ClassGroup.mk0 I)⁻¹ := by
                             apply eq_inv_iff_mul_eq_one.mpr
                             simpa only [pow_two] using hIsq
                           simpa only [pow_two] using ClassGroup.mk0_eq_mk0_inv_iff.mp hinv))
  exact ⟨I, β, hIc, hβ, hIβ⟩

end CCDN
