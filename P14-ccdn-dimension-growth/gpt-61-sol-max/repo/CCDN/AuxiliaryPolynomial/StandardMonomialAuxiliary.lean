module

public import CCDN.Algebra.Coordinates

import Mathlib

public import CCDN.Algebra.MonomialEvaluationMatrix
public import CCDN.ForMathlib.StandardExponents
public import Mathlib.LinearAlgebra.Matrix.Determinant.Basic
import ArithmeticHeights.CauchyBinet

/-! Vanishing maximal determinants on a standard-monomial family produce
an integer auxiliary outside the original principal ideal. -/

public section
namespace CCDN
open MvPolynomial Matrix

/-- If `mon` is an injective family of `N` standard monomials (for the degree-lexicographic order)
of the ideal generated by `f` over `ℚ`, all of degree at most `M`, and every `N × N` evaluation
determinant of these monomials at points chosen from `x` vanishes, then there is a nonzero
integer polynomial `g` of degree at most `M`, vanishing at every point `x i`, whose image over
`ℚ` is not divisible by `f`. -/
theorem exists_standard_auxiliary_of_zero_determinants {n N t M : ℕ}
    (f : CCDN.CoordinatePolynomial n) (mon : Fin N → (Fin n →₀ ℕ))
    (hmon : Function.Injective mon)
    (hstd : ∀ j, mon j ∈ Ideal.standardExponents (Ideal.span {f}) MonomialOrder.degLex)
    (hdegree : ∀ j, (mon j).degree ≤ M)
    (x : Fin t → IntPoint n)
    (hdet : ∀ a : Fin N → Fin t, (evaluationMatrix mon (x ∘ a)).det = 0) :
    ∃ g : CCDN.IntegerPolynomial n, g ≠ 0 ∧
      ¬ f ∣ CCDN.rationalPolynomial g ∧ g.totalDegree ≤ M ∧
      ∀ i, eval (x i) g = 0 := by
  classical
  let A := evaluationMatrix mon x
  have hzero (a : Fin N → Fin t) : (A.submatrix a id).det = 0 := hdet a
  have hgram : (Aᵀ * A).det = 0 := by
    simp only [Matrix.det_mul_eq_sum_det_submatrix, hzero, mul_zero, Finset.sum_const_zero]
  obtain ⟨v, hv, hAv⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hgram
  have hAv : A *ᵥ v = 0 := by
    have h := congrArg (dotProduct v) hAv
    rwa [← mulVec_mulVec, dotProduct_mulVec, dotProduct_zero, vecMul_transpose,
      dotProduct_self_eq_zero] at h
  let g := polynomialOfCoefficients mon v
  have hg0 := polynomialOfCoefficients_ne_zero mon hmon hv
  have hgQ : CCDN.rationalPolynomial g ≠ 0 := by
    intro h
    exact hg0 ((map_injective (Int.castRingHom ℚ) Int.cast_injective) (by simpa using h))
  have hgstd : CCDN.rationalPolynomial g ∈
      restrictSupport ℚ (Ideal.standardExponents (Ideal.span {f}) MonomialOrder.degLex) := by
    simp only [g, polynomialOfCoefficients, map_sum, map_monomial]
    exact Submodule.sum_mem _ (fun j _ => (monomial_mem_restrictSupport ℚ).mpr (Or.inl (hstd j)))
  refine ⟨g, hg0, ?_, totalDegree_polynomialOfCoefficients_le mon v hdegree, ?_⟩
  · intro hdvd
    exact hgQ (Ideal.eq_zero_of_mem_restrictSupport_standardExponents (Ideal.span {f})
      MonomialOrder.degLex hgstd (Ideal.mem_span_singleton.mpr hdvd))
  · intro i
    exact (eval_polynomialOfCoefficients mon x v i).trans (congrFun hAv i)

end CCDN
