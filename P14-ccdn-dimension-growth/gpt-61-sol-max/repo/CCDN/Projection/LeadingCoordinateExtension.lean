module

public import CCDN.Algebra.PolynomialPredicates
public import CCDN.Hilbert.FilteredHilbertPolynomial
public import CCDN.Hilbert.LinearProjectionFiltration
public import Mathlib.RingTheory.AlgebraicIndependent.Defs
import CCDN.Hilbert.LinearCoordinates
import CCDN.Hilbert.PrincipalHilbertPolynomial
import CCDN.Projection.HilbertProjectionDegree
import CCDN.Projection.HomogeneousFiniteProjectionDegree
import CCDN.Projection.HomogeneousProjectionEquation

/-! Extending a linear projection by one leading coordinate. Integrality and
algebraic independence of the tail coordinates pass to the extended projection;
for a homogeneous prime whose function field is generated by the extended
coordinates, the image is a hypersurface cut out by a form of exactly the
original degree. -/

public section
namespace CCDN
open MvPolynomial

variable {K τ : Type*} [Field K] {m : ℕ} (I : Ideal (MvPolynomial τ K)) (l : Fin (m + 1) → MvPolynomial τ K)

/-- Restricting the projection along `l` to the tail variables gives the projection along the
tail of `l`. -/
private theorem projectionCoordinateMap_comp_rename_succ  :
    (projectionCoordinateMap I l).comp (rename Fin.succ) =
      projectionCoordinateMap I (fun i : Fin m => l i.succ) := by
  ext i
  simp [projectionCoordinateMap]


/-- A finite birational projection of a homogeneous prime of projective dimension `m` and
degree `d`, obtained by extending a finite injective linear projection by one linear form and
generating the function field, has image a hypersurface cut out by an irreducible form of
degree exactly `d`. -/
theorem exists_homogeneous_extended_projection_equation
    {K F τ : Type*} [Field K] [Field F] [Algebra K F] [Fintype τ] [LinearOrder τ] {m : ℕ}
    (I : Ideal (MvPolynomial τ K)) [I.IsPrime]
    [Algebra (MvPolynomial τ K ⧸ I) F] [IsScalarTower K (MvPolynomial τ K ⧸ I) F]
    [IsFractionRing (MvPolynomial τ K ⧸ I) F]
    (hI : IsHomogeneousIdeal I)
    (l : Fin (m + 2) → MvPolynomial τ K) (hl : ∀ i, (l i).IsHomogeneous 1)
    (hint : (projectionCoordinateMap I (fun i : Fin (m + 1) => l i.succ)).IsIntegral)
    (hinj : Function.Injective (projectionCoordinateMap I (fun i : Fin (m + 1) => l i.succ)))
    (hfield : IntermediateField.adjoin K
      (Set.range (fun i => algebraMap (MvPolynomial τ K ⧸ I) F
        ((Ideal.Quotient.mk I) (l i)))) = ⊤)
    (d : ℕ) (hdimdeg : HasProjectiveDimensionDegree I m d) :
    ∃ f : MvPolynomial (Fin (m + 2)) K,
      Irreducible f ∧ f.IsHomogeneous d ∧ f.totalDegree = d ∧ 0 < d ∧
      RingHom.ker (projectionCoordinateMap I l) = Ideal.span {f} := by
  obtain ⟨f, hf, hfpos, _, hker⟩ := (let inline_hl := fun (i : Fin (m + (2 : ℕ))) => IsHomogeneous.totalDegree_le (hl i);
                                      exists_hypersurface_projection_equation_degree_le I l inline_hl d hdimdeg (fun i => X i.succ)
                                        (fun _ => by simp) ((by
                                                              let inline_m := m + (1 : ℕ)
                                                              have inline_hl : (fun i : Fin inline_m => projectionCoordinateMap I l (X i.succ)) =
                                                                  fun i => Ideal.Quotient.mk I (l i.succ) := by
                                                                funext i
                                                                simp [projectionCoordinateMap]
                                                              rw [inline_hl]
                                                              exact injective_projectionCoordinateMap_iff.mp hinj)))
  have hlead := homogeneous_finite_birational_projection_leadingCoeff_eq  I hI l hl
    ((by
       apply RingHom.IsIntegral.tower_top (rename Fin.succ).toRingHom
         (projectionCoordinateMap I l).toRingHom
       change ((projectionCoordinateMap I l).comp (rename Fin.succ)).IsIntegral
       rwa [projectionCoordinateMap_comp_rename_succ])) hfield
  rw [hker, principal_filteredHilbertPolynomial_leadingCoeff f hf.ne_zero hfpos,
    hdimdeg.leadingCoeff_eq] at hlead
  have hfdeg := by
    have hh := (div_left_inj' (by positivity : ((m + 1).factorial : ℚ) ≠ 0)).mp hlead
    exact_mod_cast hh
  refine ⟨f, hf, ?_, hfdeg, hfdeg ▸ hfpos, hker⟩
  rw [← hfdeg]
  exact homogeneous_projection_equation I hI l hl f hf.ne_zero hker

end CCDN
