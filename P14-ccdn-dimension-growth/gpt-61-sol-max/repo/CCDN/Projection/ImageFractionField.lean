module

public import CCDN.Hilbert.LinearProjectionFiltration
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs
public import Mathlib.RingTheory.IntegralClosure.IsIntegral.Defs
import CCDN.Projection.PrimitiveCoordinateField

/-! The field generated by projected coordinates is the fraction field
of the image coordinate ring. Its inclusion in the source function
field is constructed and identified on every coordinate-ring element. -/

@[expose] public section
namespace CCDN
open MvPolynomial

variable {K σ τ : Type*} [Field K]
variable (I : Ideal (MvPolynomial τ K))
variable (a : σ → MvPolynomial τ K)

/-- The forms `a` give a Noether normalization of the quotient by `I`: the coordinate map
`K[y] → K[x]/I` is integral and injective, that is, the forms are algebraically independent
modulo `I` and the quotient is finite over the polynomial ring they generate. -/
structure IsNoetherNormalization : Prop where
  /-- The quotient by `I` is integral over the subring generated by the forms. -/
  integral : (projectionCoordinateMap I a).IsIntegral
  /-- The forms are algebraically independent modulo `I`. -/
  injective : Function.Injective (projectionCoordinateMap I a)

/-- An irreducible equation generating the kernel of the projected coordinate map. -/
structure IsHypersurfaceImage (f : MvPolynomial σ K) : Prop where
  irreducible : Irreducible f
  ker_eq : RingHom.ker (projectionCoordinateMap I a) = Ideal.span {f}

variable {I} in
/-- For a hypersurface image onto `f = 0`, a polynomial in the forms lies in the ideal exactly when
it is a multiple of `f`. -/
lemma IsHypersurfaceImage.aeval_mem_iff {a : σ → MvPolynomial τ K}
    {f : MvPolynomial σ K} (h : IsHypersurfaceImage I a f) (g : MvPolynomial σ K) :
    aeval a g ∈ I ↔ f ∣ g := by
  rw [← Ideal.mem_span_singleton, ← h.ker_eq, RingHom.mem_ker]
  exact Ideal.Quotient.eq_zero_iff_mem.symm

variable {I} in
/-- The equation of a hypersurface image vanishes on the variety: substituting the forms
into it gives an element of the ideal. -/
lemma IsHypersurfaceImage.aeval_mem {a : σ → MvPolynomial τ K}
    {f : MvPolynomial σ K} (h : IsHypersurfaceImage I a f) : aeval a f ∈ I :=
  (h.aeval_mem_iff f).mpr dvd_rfl

end CCDN
