/-!
### Basic API, the affine case, and scaling
-/

section Basic

variable {K : Type*} [Field K] [CharZero K] {ι : Type*} [Finite ι]

lemma one_le_absMulHeight (x : ι → K) : 1 ≤ absMulHeight x := by
  by_cases hx : ∀ i, IsIntegral ℚ (x i)
  · have := numberField_adjoin_range hx
    rw [absMulHeight_def hx]
    exact Real.one_le_rpow (Height.one_le_mulHeight _) (by positivity)
  · rw [absMulHeight_eq_one_of_not_isIntegral hx]

lemma absMulHeight_pos (x : ι → K) : 0 < absMulHeight x :=
  zero_lt_one.trans_le <| one_le_absMulHeight x

lemma absLogHeight_nonneg (x : ι → K) : 0 ≤ absLogHeight x :=
  Real.log_nonneg <| one_le_absMulHeight x
/-- On a subsingleton index type every tuple has absolute height `1`: the height is computed in
the field the single coordinate generates, where `Height.mulHeight_eq_one_of_subsingleton` is the
product formula. -/
@[simp]
lemma absMulHeight_eq_one_of_subsingleton [Subsingleton ι] (x : ι → K) : absMulHeight x = 1 := by
  by_cases hx : ∀ i, IsIntegral ℚ (x i)
  · have := numberField_adjoin_range hx
    rw [absMulHeight_def hx, Height.mulHeight_eq_one_of_subsingleton, Real.one_rpow]
  · rw [absMulHeight_eq_one_of_not_isIntegral hx]

@[simp]
lemma absLogHeight_eq_zero_of_subsingleton [Subsingleton ι] (x : ι → K) : absLogHeight x = 0 := by
  simp [absLogHeight_eq_log_absMulHeight]

/-- **Scaling invariance, for an algebraic scalar.** ⚠ The algebraicity hypothesis is not
decorative: for `c` transcendental and `x` a nonzero algebraic tuple, `c • x` has a transcendental
coordinate and `absMulHeight (c • x)` is the junk value `1`. See the examples at the end of the
file. -/
theorem absMulHeight_smul_eq (x : ι → K) {c : K} (hc : c ≠ 0) (hc' : IsAlgebraic ℚ c) :
    absMulHeight (c • x) = absMulHeight x := by
  by_cases hx : ∀ i, IsIntegral ℚ (x i)
  · have hfin : (insert c (Set.range x)).Finite := (Set.finite_range x).insert c
    have := hfin.to_subtype
    have hfd : FiniteDimensional ℚ (adjoin ℚ (insert c (Set.range x))) :=
      finiteDimensional_adjoin fun y hy ↦ by
        rcases hy with rfl | ⟨i, rfl⟩
        · exact hc'.isIntegral
        · exact hx i
    have : NumberField (adjoin ℚ (insert c (Set.range x))) := {}
    have hcE : c ∈ adjoin ℚ (insert c (Set.range x)) := subset_adjoin ℚ _ (Set.mem_insert _ _)
    have hxE : ∀ i, x i ∈ adjoin ℚ (insert c (Set.range x)) := fun i ↦
      subset_adjoin ℚ _ (Set.mem_insert_of_mem _ ⟨i, rfl⟩)
    have hcxE : ∀ i, (c • x) i ∈ adjoin ℚ (insert c (Set.range x)) := fun i ↦ mul_mem hcE (hxE i)
    have hsmul : (fun i ↦ (⟨(c • x) i, hcxE i⟩ : adjoin ℚ (insert c (Set.range x))))
        = (⟨c, hcE⟩ : adjoin ℚ (insert c (Set.range x))) •
          fun i ↦ (⟨x i, hxE i⟩ : adjoin ℚ (insert c (Set.range x))) := by
      funext i
      exact Subtype.ext rfl
    rw [absMulHeight_eq_of_mem hcxE, absMulHeight_eq_of_mem hxE, hsmul,
      Height.mulHeight_smul_eq_mulHeight _ (fun h ↦ hc (congrArg Subtype.val h))]
  · rw [absMulHeight_eq_one_of_not_isIntegral hx, absMulHeight_eq_one_of_not_isIntegral]
    intro h
    refine hx fun i ↦ ?_
    have hxi : x i = c⁻¹ * (c * x i) := by field_simp
    rw [hxi]
    exact hc'.inv.isIntegral.mul (h i)

end Basic

end NumberField

/-!
### The descent to projective space

Scaling invariance makes the absolute height a well-defined function on
`Projectivization K (ι → K)` — but only over a field all of whose elements are algebraic, since
that is where `NumberField.absMulHeight_smul_eq` applies to every scalar.
-/

namespace Projectivization

open NumberField Real

variable {K : Type*} [Field K] [CharZero K] [Algebra.IsAlgebraic ℚ K] {ι : Type*} [Finite ι]

private lemma absMulHeight_aux (a b : { v : ι → K // v ≠ 0 }) (t : K) (h : a.val = t • b.val) :
    NumberField.absMulHeight a.val = NumberField.absMulHeight b.val :=
  have ht : t ≠ 0 := by
    contrapose! h
    simpa [h] using a.prop
  h ▸ absMulHeight_smul_eq _ ht (Algebra.IsAlgebraic.isAlgebraic t)

private lemma absLogHeight_aux (a b : { v : ι → K // v ≠ 0 }) (t : K) (h : a.val = t • b.val) :
    NumberField.absLogHeight a.val = NumberField.absLogHeight b.val := by
  simp only [absLogHeight_eq_log_absMulHeight, absMulHeight_aux a b t h]

-- We do not expose the bodies of these definitions so that we can keep the "_aux" lemmas
-- above private.

/-- The absolute multiplicative height of a point of projective space over a field of algebraic
numbers. -/
noncomputable def absMulHeight (x : Projectivization K (ι → K)) : ℝ :=
  x.lift (fun r ↦ NumberField.absMulHeight r.val) absMulHeight_aux

/-- The absolute logarithmic height of a point of projective space over a field of algebraic
numbers. -/
noncomputable def absLogHeight (x : Projectivization K (ι → K)) : ℝ :=
  x.lift (fun r ↦ NumberField.absLogHeight r.val) absLogHeight_aux

lemma absMulHeight_mk {x : ι → K} (hx : x ≠ 0) :
    absMulHeight (mk K x hx) = NumberField.absMulHeight x := by
  rfl

lemma absLogHeight_mk {x : ι → K} (hx : x ≠ 0) :
    absLogHeight (mk K x hx) = NumberField.absLogHeight x := by
  rfl

lemma absLogHeight_eq_log_absMulHeight (x : Projectivization K (ι → K)) :
    absLogHeight x = log (absMulHeight x) := by
  rw [← x.mk_rep, absMulHeight_mk, absLogHeight_mk,
    NumberField.absLogHeight_eq_log_absMulHeight]

lemma one_le_absMulHeight (x : Projectivization K (ι → K)) : 1 ≤ absMulHeight x := by
  rw [← x.mk_rep, absMulHeight_mk]
  exact NumberField.one_le_absMulHeight _

lemma absMulHeight_pos (x : Projectivization K (ι → K)) : 0 < absMulHeight x :=
  zero_lt_one.trans_le <| one_le_absMulHeight x

lemma absLogHeight_nonneg (x : Projectivization K (ι → K)) : 0 ≤ absLogHeight x := by
  rw [absLogHeight_eq_log_absMulHeight]
  exact log_nonneg x.one_le_absMulHeight
/-- On a subsingleton index type every point of projective space has absolute height `1`;
the projective form of `NumberField.absMulHeight_eq_one_of_subsingleton`. -/
@[simp]
lemma absMulHeight_eq_one_of_subsingleton [Subsingleton ι] (x : Projectivization K (ι → K)) :
    absMulHeight x = 1 := by
  rw [← x.mk_rep, absMulHeight_mk]
  exact NumberField.absMulHeight_eq_one_of_subsingleton _

@[simp]
lemma absLogHeight_eq_zero_of_subsingleton [Subsingleton ι] (x : Projectivization K (ι → K)) :
    absLogHeight x = 0 := by
  simp [absLogHeight_eq_log_absMulHeight]

end Projectivization

/-!
### `positivity` extensions

The absolute heights are positive (multiplicative) resp. nonnegative (logarithmic), exactly as
their relative counterparts in `Mathlib.NumberTheory.Height.Basic`.
-/

namespace Mathlib.Meta.Positivity

open Lean.Meta Qq

/-- Extension for the `positivity` tactic: `NumberField.absMulHeight` is always positive. -/
@[positivity NumberField.absMulHeight _]
meta def evalAbsMulHeight : PositivityExt where eval {u α} _ pα? e :=
  match pα? with | none => pure .none | some _ => do
  match u, α, e with
  | 0, ~q(ℝ), ~q(@NumberField.absMulHeight $K $KF $KCZ $ι $ιF $a) =>
    assertInstancesCommute
    pure (.positive q(NumberField.absMulHeight_pos $a))
  | _, _, _ => throwError "not NumberField.absMulHeight"

/-- Extension for the `positivity` tactic: `NumberField.absLogHeight` is always nonnegative. -/
@[positivity NumberField.absLogHeight _]
meta def evalAbsLogHeight : PositivityExt where eval {u α} _ pα? e :=
  match pα? with | none => pure .none | some _ => do
  match u, α, e with
  | 0, ~q(ℝ), ~q(@NumberField.absLogHeight $K $KF $KCZ $ι $ιF $a) =>
    assertInstancesCommute
    pure (.nonnegative q(NumberField.absLogHeight_nonneg $a))
  | _, _, _ => throwError "not NumberField.absLogHeight"

/-- Extension for the `positivity` tactic: `Projectivization.absMulHeight` is always positive. -/
@[positivity Projectivization.absMulHeight _]
meta def evalProjAbsMulHeight : PositivityExt where eval {u α} _ pα? e :=
  match pα? with | none => pure .none | some _ => do
  match u, α, e with
  | 0, ~q(ℝ), ~q(@Projectivization.absMulHeight $K $KF $KCZ $KA $ι $ιF $a) =>
    assertInstancesCommute
    pure (.positive q(Projectivization.absMulHeight_pos $a))
  | _, _, _ => throwError "not Projectivization.absMulHeight"

/-- Extension for the `positivity` tactic: `Projectivization.absLogHeight` is always
nonnegative. -/
@[positivity Projectivization.absLogHeight _]
meta def evalProjAbsLogHeight : PositivityExt where eval {u α} _ pα? e :=
  match pα? with | none => pure .none | some _ => do
  match u, α, e with
  | 0, ~q(ℝ), ~q(@Projectivization.absLogHeight $K $KF $KCZ $KA $ι $ιF $a) =>
    assertInstancesCommute
    pure (.nonnegative q(Projectivization.absLogHeight_nonneg $a))
  | _, _, _ => throwError "not Projectivization.absLogHeight"

end Mathlib.Meta.Positivity

