-    (hg : Summable (Function.uncurry g))
-    (hh : Summable (Function.uncurry h))
-    (hvertical : ∀ m, (∑' n, f m n) = ∑' n, h m n)
-    (hhorizontal : ∀ n, (∑' m, h m n) = ∑' m, g m n) :
-    (∑' p : ℤ × ℤ, f p.1 p.2) = ∑' p : ℤ × ℤ, g p.1 p.2 := by
