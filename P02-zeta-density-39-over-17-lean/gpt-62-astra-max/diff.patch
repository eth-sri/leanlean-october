-  rw [SourceCuspDatum.heightScale,s.datum_matrix,integralComplexMatrix_apply,
-    upper_right_removed_bottom _ _ s.lower_zero,map_mul,norm_mul]
-  have hn:‖eisEmbedding (s.upper 1 1)‖=1 := by
-    rcases s.lower_unit with ⟨u,hu⟩
-    rw [←hu]
