-lemma exists_fixedCuspShape (H:SL(2,Eis)) : Nonempty (FixedCuspShape H) := by
-  obtain ⟨G,j,T,hT,hT0,hT1,he⟩:=three_cusp_decomposition H
-  exact ⟨⟨G,j,T,hT,hT0,hT1,he⟩⟩
