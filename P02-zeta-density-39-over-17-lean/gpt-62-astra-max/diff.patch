-        ‖sharpZetaBoundaryCoeff ρ a * (a ^ (-ρ) : ℂ)‖ +
-          sharpZetaErrorCoeff ρ a / a ^ (ρ.re + 1) := by
-  obtain ⟨E, hEq, hE⟩ :=
-    zeta_zero_sharp_halfInteger_truncation hρre hρim hρzero ha haHalf haIm
-  rw [hEq]
-  calc
-    ‖(a ^ (1 - ρ) : ℂ) / (1 - ρ) +
-          sharpZetaBoundaryCoeff ρ a * (a ^ (-ρ) : ℂ) - E‖ ≤
-        ‖(a ^ (1 - ρ) : ℂ) / (1 - ρ) +
-          sharpZetaBoundaryCoeff ρ a * (a ^ (-ρ) : ℂ)‖ + ‖E‖ := norm_sub_le _ _
