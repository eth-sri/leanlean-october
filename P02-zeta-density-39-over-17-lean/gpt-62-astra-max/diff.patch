-theorem card_gmAffineFirstPoissonPairs_le_sum_divisors
-    (M₁ M₃ : ℕ) (Q xi : ℝ)
-    (hnonzero : ∀ p ∈ gmAffineFirstPoissonPairs M₁ M₃ Q xi,
