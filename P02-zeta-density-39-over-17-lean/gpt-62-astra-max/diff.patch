-lemma kernelCutoffGradient_faithful (g : KernelGradientL2)
-    (hg : ∀χ : PositiveChartCutoff,
-      Set.InjOn kernelEuclideanProjection (tsupport χ.func) → kernelCutoffGradientCLM χ g=0) : g=0 := by
