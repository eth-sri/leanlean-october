-      f M₁ M₂ M₃).integrableOn
-  · intro xi hxi
-    have hxi0 : xi ≠ 0 := by
-      intro hzero
-      subst xi
-      simp only [gmAffineHighFrequencyRegion, Set.mem_ofPred_eq, abs_zero] at hxi
-      exact (not_lt_of_ge hY.le) hxi
