-    (hE:∀Q∈E,Prime Q)(I:Ideal O)(hn:¬outside E I):
-    idealCoeff (χ.excludePrimes E hE) I=0 := by
-  rw [idealCoeff_excludePrimes]
-  apply ite_eq_right
-  intro hc
-  apply hn
-  intro Q hQ hd
-  have hu:IsUnit Q:=(hc Q hQ).isRelPrime hd (dvd_refl Q)
-  exact (hE Q hQ).not_isUnit hu
