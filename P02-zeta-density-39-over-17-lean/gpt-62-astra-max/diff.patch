-  have hhN : 0<‖eisEmbedding h‖ := norm_pos_iff.mpr (eisEmbedding_ne_zero hh)
-  have hk' : 0<k/‖eisEmbedding (finitePrimeModulus P)‖^2 := div_pos hk (sq_pos_of_pos hrN)
