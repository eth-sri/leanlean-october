-    cubic_weighted_energy_eq_gcd_blocks (rowMajorantBall M) _ cols a]
-  have he (D : Ideal O) (hD : D ∈ gcdPool cols) :=
-    compact_gcd_mobius_descent D (gcdPool_cubic_admissible cols hc D hD).2 cols hc a M hM
