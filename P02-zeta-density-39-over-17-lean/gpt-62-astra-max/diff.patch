-theorem typeISourceSmoothBlock_eq_wideDirichletPoly
-    (Y A r : ℕ) (σ t : ℝ) (hY : 1 ≤ Y) :
-    typeISourceSmoothBlock Y A r σ t =
-      wideDirichletPoly 1 (Nat.clog 2 (A + 1))
