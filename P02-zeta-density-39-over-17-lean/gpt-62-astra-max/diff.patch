-    apply tsum_subtype_eq_of_support_subset
-    intro h hh
-      hz
-    subst h
-    exact hh hzero
-  have hn : ‖∑' h : O, F h‖ ≤
-      ∑' h : {h : O // h ≠ 0}, ‖paperRadialFourier W (t * ‖eisEmbedding h.val‖ ^ 2)‖ := by
-    rw [heq]
-    exact (norm_tsum_le_tsum_norm (hFs.subtype _)).trans
-      ((hFs.subtype _).tsum_le_tsum (fun h => hF h) (hs.subtype _))
