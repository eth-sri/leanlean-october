-            (D.coefficient η m t T) h p)≤
-        ∑p : elementPool P,∑i : Fin 3,D.childEnergy (τ p i) p (errorIndex i) t T
-          (Z^(Real.logb Z (dyadicScale j)+errorGain D0 cLog sigma Z p (errorIndex i+1))) := by
-  have hf (p : elementPool P) (i : Fin 3) := by
