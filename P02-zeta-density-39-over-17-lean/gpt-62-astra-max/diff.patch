-def maskedSourceDensity (G : Ideal O) (rows : m → Ideal O) (cols : n → Ideal O)
-    (a : n → ℂ) (M : ℝ) : ℂ :=
-  ∑ i, ∑ j, ∑ k, originalTerm rows cols cols a a 1 1 i j k *
-    ((sourcePrincipalScale M (rows i):ℝ):ℂ)*primePoolDensity (G*(cols j*cols k))
