-`τ ≤ 1`. -/
-theorem classicalMHHExponent_le_montgomery_of_tau_le_one
-    {σ τ : ℝ} (hτ : τ ≤ 1) :
-    classicalMHHExponent σ τ ≤ 2 - 2 * σ := by
-  rw [classicalMHHExponent, max_le_iff]
-  constructor
-  · exact le_rfl
-  · exact (min_le_left _ _).trans (by linarith)
