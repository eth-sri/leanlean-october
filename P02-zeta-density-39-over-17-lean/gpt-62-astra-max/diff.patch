-    exact ⟨⟨B.val, mem_squarefreeIdealRange.mpr ⟨B.property, hN⟩⟩, Subtype.ext rfl⟩
-  have ht := he.tsum_eq hs
-  change (∑' B, F B) = _
-  rw [← ht, tsum_fintype]
-  apply Finset.sum_congr rfl
-  intro B _
