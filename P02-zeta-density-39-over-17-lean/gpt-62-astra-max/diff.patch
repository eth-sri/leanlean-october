-  obtain ⟨i,hi,rfl⟩:=Finset.mem_image.mp hP
-  refine ⟨inferInstance,poolGood F hF i,?_,poolOdd F hF i⟩
-  exact Ideal.prime_of_isPrime (NeZero.ne i.val) inferInstance
