-lemma quadraticRaySign_exponent (r s : Coord) (hr : odd r) (hs : odd s) :
-    quadraticRayExponent (EisensteinEPrimaryPhase.mul r s)=
-      (if quadraticRaySign r s=1 then 0 else 2)+quadraticRayExponent r+quadraticRayExponent s := by
