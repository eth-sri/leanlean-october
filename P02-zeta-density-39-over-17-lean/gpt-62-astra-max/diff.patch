-      linear_combination hxy
-    have hdiff : r∣a*(d-x) := dvd_mul_of_dvd_right hdr a
-    convert dvd_add hdiff hx using 1 ; ring
-  obtain ⟨b,hb⟩ := hcr.mul_dvd hcd hrd
-  refine ⟨b,d,?_,hd⟩
-  linear_combination hb
