-      kernelChartCutoff_exists (hyperbolicEuclideanCoordinates w) (hyperbolicHeight_pos w)
-    refine Set.mem_iUnion.mpr ⟨⟨χ,hinj⟩,?_⟩
-    change χ.func (hyperbolicEuclideanCoordinates w)≠0
-    rw [hχ]
-    norm_num
