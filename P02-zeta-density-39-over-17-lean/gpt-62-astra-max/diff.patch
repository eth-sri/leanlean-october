-theorem eisenstein_coord_norm_zero (a b : ℤ)
-    (h : a*a-a*b+b*b = 0) : a = 0 ∧ b = 0 := by
-  have hs : (a-b)^2 + a^2 + b^2 = 0 := by nlinarith [h]
-  have ha : a^2 = 0 := by
-    nlinarith [sq_nonneg (a-b), sq_nonneg b]
