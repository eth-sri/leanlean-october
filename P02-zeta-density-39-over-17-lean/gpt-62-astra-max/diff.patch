-theorem primeIndex_good (I : Ideal O) (hI : primaryGenerator I ≠ 0) (P : PrimeIndex I) :
-    lambda ∉ P.val :=
-  (primaryPrime_spec P.val (primaryPrime_factor_ne_zero I P.val hI
-    (Multiset.mem_toFinset.mp P.property))).2.1
