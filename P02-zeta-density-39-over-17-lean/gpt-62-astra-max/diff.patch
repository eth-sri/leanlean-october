-lemma brevePhase_hasFDerivAt (freq z : ℂ) :
-    HasFDerivAt (fun w : ℂ => ShortDraftTrace.breveE (freq*w))
-      (ShortDraftTrace.breveE (freq*z) • horizontalPhaseCLM freq) z := by
-  have hh := (horizontalPhaseCLM freq).hasFDerivAt.cexp (x:=z)
-  convert! hh using 1
