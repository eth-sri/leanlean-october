-      Complex.exp (Complex.I * (u : ℂ)) -
-        Complex.exp (Complex.I * (v : ℂ)) =
-      (Complex.exp (Complex.I * ((u - v : ℝ) : ℂ)) - 1) *
-        Complex.exp (Complex.I * (v : ℂ)) := by
-    rw [sub_mul, one_mul, ← Complex.exp_add]
-    congr 1
-    push_cast
-    ring_nf
