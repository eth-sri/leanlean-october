-    (G : Ideal O) (hG : G ≠ 0) (H : m → Ideal O)
-    (column : n → Ideal O) (hcol : ∀ j, column j ≠ 0)
-    (N : ℝ) (hN : 0 ≤ N) (hnorm : ∀ j, (Ideal.absNorm (column j) : ℝ) ≤ N)
