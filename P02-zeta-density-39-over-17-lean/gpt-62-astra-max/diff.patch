-theorem localGauss_five_eq (p : O) (hp : p ≠ 0) [(Ideal.span {p}).IsMaximal]
-    (hg : lambda ∉ Ideal.span {p}) :
-    localGauss p hp hg 5 = breveGammaMinus1 (Ideal.span {p}) hg p rfl hp := by
-  rw [localGauss, canonicalSextic_fifth_eq_inverse]
-  rfl
