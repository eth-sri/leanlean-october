-  · exact_mod_cast Nat.one_le_iff_ne_zero.mpr (Ideal.absNorm_eq_zero_iff.not.mpr ha0)
-  · exact (le_div_iff₀ hpos).mpr (by simpa only [mul_comm] using hab)
