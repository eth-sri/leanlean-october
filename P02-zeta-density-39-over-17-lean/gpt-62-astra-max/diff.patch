-      _=_:=by ring
-  · rw [ha,hc',map_mul,map_mul,map_mul,map_mul]
-    have he:=eisEmbedding_ne_zero hd
-    have hf:=eisEmbedding_ne_zero hcp
-    have hu0:=eisEmbedding_ne_zero u.ne_zero
-    field_simp
