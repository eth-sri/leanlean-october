-def planeDecayConstant (F : SchwartzMap ℂ ℂ) : ℝ :=
-  SchwartzMap.seminorm ℝ 0 0 F + SchwartzMap.seminorm ℝ 2 0 F +
-    SchwartzMap.seminorm ℝ 4 0 F
