-      (4 / 3 : ℝ) * ‖eisEmbedding (dualFrequencyEquiv p)‖ ^ 2 / ‖c‖ ^ 2 := by
-  rw [explicitDualFrequency_eq_paperFrequency, paperFrequency_norm_sq, norm_div, div_pow]
-  ring
