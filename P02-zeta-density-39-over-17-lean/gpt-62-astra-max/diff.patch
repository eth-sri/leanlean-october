-structure FixedCuspShape (H:SL(2,Eis)) where
-  gamma : levelTwo
-  index : Fin 3
-  upper : SL(2,Eis)
-  lower_zero : upper 1 0=0
-  upper_unit : IsUnit (upper 0 0)
-  lower_unit : IsUnit (upper 1 1)
-  factorization : H=(gamma:SL(2,Eis))*cuspRepresentative index*upper
