-theorem finiteSquarefreeRow_second_child
-    {ι : Type*} (P : ι → Ideal O) [∀ i, (P i).IsMaximal]
-    (hgood : ∀ i, lambda ∉ P i) (S : Finset ι)
-    (d e k J C v : O) :
