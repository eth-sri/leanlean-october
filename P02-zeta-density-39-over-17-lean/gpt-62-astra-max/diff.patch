-    (S : Finset α) (weight : α → ℕ) (ordinate : α → ℝ)
-    (k L : ℕ) (H : ℝ) (large : ℕ → ℝ → Prop) (inInterval : ℝ → Prop)
-    (hS : S.Nonempty)
