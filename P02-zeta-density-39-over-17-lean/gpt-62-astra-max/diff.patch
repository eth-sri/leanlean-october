-    {M : ℕ} {m : ℤ} (hm : m ∈ gmAffinePositiveShell M) :
-    |(m : ℝ)| ≤ 2 * M := by
-  rcases mem_gmAffinePositiveShell.mp hm with ⟨hmLower, hmUpper⟩
-  rw [abs_of_nonneg]
-  · exact_mod_cast hmUpper
-  · exact_mod_cast (Int.natCast_nonneg M |>.trans hmLower)
