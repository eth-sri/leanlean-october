-  calc
-    _ = ‖coefficient χ inverse I.val‖ * (norm I)^(-(c+σ)) := by
-      rw [mul_assoc, ← Real.rpow_add (norm_pos I)]
-      congr 2
-      ring
-    _ ≤ _ := mul_le_of_le_one_left (Real.rpow_nonneg (norm_pos I).le _)
