-def threeBlockExponent {ι : Type*} [DecidableEq ι] (N P : Finset ι)
-    (v : ι → ℕ) (ε₁ ε₂ : ι → Bool) (i : ι) : ℕ :=
-  if i ∈ N then 5 else if i ∈ P then 1
-  else (conductorExponent (parity (v i)) (ε₁ i) (ε₂ i)).val
