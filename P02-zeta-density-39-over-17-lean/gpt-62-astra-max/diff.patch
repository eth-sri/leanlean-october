-private theorem supplement_case00 (P : Ideal O) [P.IsMaximal]
-    (hg : lambda ∉ P) (k l : ℤ)
-    (hP : P = Ideal.span {primaryCoord (3*k+0) (3*l+0)}) :
-    cubicChar P hg (Ideal.Quotient.mk P lambda) = omega ^ 0 := by
