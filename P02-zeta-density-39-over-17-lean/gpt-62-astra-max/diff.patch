-def localErrorCost (p : O) (n : ℕ) : ℝ :=
-  if n=5 then (1-(Ideal.absNorm (Ideal.span {p}):ℝ)⁻¹)^2
-  else (Ideal.absNorm (Ideal.span {p}):ℝ)⁻¹
