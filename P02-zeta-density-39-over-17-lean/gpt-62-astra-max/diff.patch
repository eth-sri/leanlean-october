-theorem finiteDirichlet_beta_removal_power_threshold :
-    ∀ δ : ℝ, 0 < δ → ∀ B D : ℝ,
-      ∃ T₀ : ℝ, 8 ≤ T₀ ∧
-        ∀ (σ T : ℝ) (ρ : ℂ) (S : Finset ℕ) (coeff : ℕ → ℂ) (V : ℝ),
-          1 / 2 ≤ σ → σ ≤ 1 → T₀ ≤ T →
-          σ ≤ ρ.re → ρ.re ≤ 1 →
-          (∀ n ∈ S, 0 < n) →
-          finiteDirichletMass S coeff ≤ T ^ B →
-          T ^ (-D) ≤ V →
