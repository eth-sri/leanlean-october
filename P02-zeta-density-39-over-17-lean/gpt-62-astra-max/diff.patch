-structure OriginalData (ι : Type*) [Fintype ι] where
-  S : (ι ⊕ Fin 2) → Finset (Ideal O)
-  R : Ideal O
-  s : Ideal O
-  nu : ι → Ideal O → ℂ
-  slot : ι → ℝ → ℂ
-  lengths : ι → ℝ
-  W₁ : ℝ → ℂ
-  W₂ : ℝ → ℂ
