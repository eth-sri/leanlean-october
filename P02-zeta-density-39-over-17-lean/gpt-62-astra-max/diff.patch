-    hg.of_nonneg_of_le (fun i => norm_nonneg _) (hpoint k)
-  have hfp : Summable f := Pi.summable.mpr (fun k => (hsum k).of_norm)
-  have he : (∑'i,F i)=e.symm (fun k => ∑'i,f i k) := by
-    rw [show (fun i => F i)=(fun i => e.symm (f i)) from rfl,←e.symm.map_tsum]
