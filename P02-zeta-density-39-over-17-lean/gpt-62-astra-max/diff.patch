-    (z : SecondRayIndex × Finset ι) : ℂ :=
-  secondRayCoefficient z.1 *
-    secondCommonWeight p hp hcop hg (secondRayMinus Ψ₁ z.1) (secondRayPlus Ψ₂ z.1)
-      m r c d e k (-k) z.2
-
-end
