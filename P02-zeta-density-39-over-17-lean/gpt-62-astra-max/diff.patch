-theorem profile_mass_explicit {ι : Type*} [Fintype ι]
-    (Wslot : ι → ℝ → ℂ) (W₁ W₂ : ℝ → ℂ)
-    (b D : ι → ℝ) (b₁ b₂ D₁ D₂ : ℝ)
-    (hb : ∀ j,0≤b j) (hb₁ : 0≤b₁) (hb₂ : 0≤b₂)
