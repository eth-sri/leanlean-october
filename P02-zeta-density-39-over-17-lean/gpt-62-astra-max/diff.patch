-    _ ≤ (outsideScalar Z v ell el S₀ B₀ Td)^2 *
-        (Z^H*Z^v*Z^ell*Z^za)^ε * Z^ell *
-        ((2*Z^(max H (v+ell)))*(3*Z^(v+za-hybridSaving v za))) := by
-      nlinarith only [hh]
-    _ = 6*Z^(reflectedExponent 0 H S₀ B₀ za v ell el Td + ε*(H+v+ell+za)) := by
-      rw [outsideScalar_square hZ,hp]
