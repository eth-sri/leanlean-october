-  have hρrePos : 0 < ρ.re := hσ.trans_le hRect.1
-  have hρreOne : ρ.re ≤ 1 := hRect.2.1
-  have hρimPos : 0 < ρ.im := hTpos.trans_le hRect.2.2.1
