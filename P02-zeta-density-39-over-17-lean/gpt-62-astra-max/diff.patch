-    |xi + ((p.1 * p.2 : ℤ) : ℝ)| <
-      gmAffineFirstPoissonRadius M₁ M₃ Q := by
-  obtain ⟨hm₁, hell⟩ := mem_gmAffineFirstPoissonPairs.mp hp
-  have hm₁neZ : p.1 ≠ 0 := gmAffineSignedShell_ne_zero hM₁ hm₁
-  have hm₁neR : (p.1 : ℝ) ≠ 0 := by exact_mod_cast hm₁neZ
