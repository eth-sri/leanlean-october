-  calc
-    _ ≤ 2 + Real.log N / Real.log 2 := hL
-    _ ≤ 2 * N ^ ε + (N ^ ε / ε) / Real.log 2 := add_le_add (by linarith) hb
-    _ = _ := by field_simp
