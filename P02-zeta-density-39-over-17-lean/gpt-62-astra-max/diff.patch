-raised window is returned to the basic window by dividing its exponent by
-either two or three. -/
-theorem exists_two_or_three_scale_reduction
-    {τ₀ τ : ℝ} (hτLower : 4 * τ₀ / 3 ≤ τ)
-    (hτUpper : τ ≤ 8 * τ₀ / 3) :
-    (2 * τ₀ / 3 ≤ τ / 2 ∧ τ / 2 ≤ τ₀) ∨
-      (2 * τ₀ / 3 ≤ τ / 3 ∧ τ / 3 ≤ τ₀) := by
-  by_cases hτ : τ ≤ 2 * τ₀
-  · left
-    constructor <;> nlinarith
-  · right
-    constructor <;> nlinarith
