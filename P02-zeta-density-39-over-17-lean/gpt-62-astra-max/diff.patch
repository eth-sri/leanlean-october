-  calc
-    _ = q * (t * ‖∑' h : O, F h‖) := by dsimp [t]; field_simp
-    _ ≤ q * pvControl W := mul_le_mul_of_nonneg_left hbound hq.le
-    _ = _ := mul_comm _ _
