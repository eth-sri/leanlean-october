-  rcases mem_gmAffineSignedShell.mp hm with hmneg | hmpos
-  · rw [abs_of_nonpos]
-    · have hInt : -m ≤ (2 * M : ℤ) := by omega
-      exact_mod_cast hInt
-    · exact_mod_cast (hmneg.2.trans (neg_nonpos.mpr (Int.natCast_nonneg M)))
