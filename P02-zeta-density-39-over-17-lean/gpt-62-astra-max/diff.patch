-    (hX : 0 ≤ X) (hL : 0 < L) (hY : L ≤ Y) (hprod : X * Y = T) :
-    X ≤ T / L := by
-  apply (le_div_iff₀ hL).mpr
-  rw [← hprod]
-  exact mul_le_mul_of_nonneg_left hY hX
