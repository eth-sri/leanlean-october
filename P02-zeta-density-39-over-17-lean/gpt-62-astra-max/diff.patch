-def canonicalCubeCorrelation (pool B : Finset ι) (v₁ v₂ : ι→ℕ)
-    (Ψ₁ Ψ₂ : O→*ℂ) (m₁ m₂ f : O) (H₁ H₂ : Finset ι→ℂ)
-    (W : 𝓢(ℝ,ℂ)) (K : ℝ) : ℂ :=
-  ∑S∈pool.powerset,∑T∈pool.powerset,
-    canonicalCubeSourcePair p hp hcop hg B S T v₁ v₂ Ψ₁ Ψ₂ m₁ m₂ f H₁ H₂ W K
