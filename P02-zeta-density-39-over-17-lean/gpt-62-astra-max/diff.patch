-theorem centered_error_identity (A₁ A₂ B₁ B₂ a₁ a₂ b₁ b₂ : ℂ)
-    (hmain : a₁ * a₂ = b₁ * b₂) :
-    A₁ * A₂ - B₁ * B₂ =
-      (A₁ - a₁) * A₂ + a₁ * (A₂ - a₂) -
-        (B₁ - b₁) * B₂ - b₁ * (B₂ - b₂) := by
-  linear_combination hmain
