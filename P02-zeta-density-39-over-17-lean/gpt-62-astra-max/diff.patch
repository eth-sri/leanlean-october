-          (fun I => c ((Ideal.span {p})^(n+1)*I))
-          (fun I => residualCharacter p (n+1) (primaryGenerator I)) W K).re /
-          (T/(Ideal.absNorm (Ideal.span {p}):ℝ)^(n+1))) := by
