-theorem activePrimes_injective {α : Type*} [DecidableEq α]
-    (P : α → Ideal O) (hinj : Function.Injective P) (S T : Finset α) :
-    Function.Injective (activePrimes P S T) := by
-  intro a b h
-  apply Subtype.ext
-  exact hinj h
