-theorem pairAF_mult {q r : ℕ} (χ : DirichletCharacter ℂ q)
-    (ψ : DirichletCharacter ℂ r) :
-    (pairAF χ ψ).IsMultiplicative :=
-  (invCharAF_mult χ).mul (invCharAF_mult ψ)
