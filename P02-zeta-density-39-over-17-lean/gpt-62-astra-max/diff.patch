-      0 < ∫ x, f x ∂(volume : Measure E) := by
-    simpa using
-      (Continuous.integral_pos_of_hasCompactSupport_nonneg_nonzero (μ := (volume : Measure E))
-        hf_cont hf_cs hf_nonneg hf0_ne)
