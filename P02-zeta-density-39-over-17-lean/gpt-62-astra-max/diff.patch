-  by_cases hI : I = 0
-  · simp [hI]
-  by_cases hJ : J = 0
-  · simp [hJ]
-  simp only [idealSymbol, ite_eq_right hI, ite_eq_right hJ, ite_eq_right (mul_ne_zero hI hJ),
