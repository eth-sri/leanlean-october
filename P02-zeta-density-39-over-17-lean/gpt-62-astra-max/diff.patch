-def afterDilationLabel {κ : Type*} (p : κ → O) (B : Finset κ)
-    (v : κ → ℕ) (ε₁ ε₂ : κ → Bool) (c d : O) (S : Finset ι) : ℂ :=
-  finiteSquarefreeRow P hg S (c * jLabel p B v ε₁ ε₂) ^ 4 *
-    finiteSquarefreeRow P hg S d * rowCoprimeMask P S (b0Label p B v ε₁ ε₂)
