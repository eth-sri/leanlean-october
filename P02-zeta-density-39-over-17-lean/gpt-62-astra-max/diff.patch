-  · intro h P hP
-    obtain ⟨R,hR,rfl⟩:=Finset.mem_map.mp hP
-    have hr:=h hR
-    simpa only [Equiv.toEmbedding_apply,principalSupport,Finset.mem_filter,Finset.mem_univ,true_and,extracted_left,extracted_right]
-      using hr
