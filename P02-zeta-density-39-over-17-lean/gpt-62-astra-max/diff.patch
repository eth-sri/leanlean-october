-    (fun h q hq => coeff.term_hasFDerivAt h q (ha.trans hq.1.1))
-    (fun h q hq => hbound h q ⟨hq.1.1.le,hq.1.2.le⟩)
-    hpSlab (coeff.summable p hp) hpSlab
