-  simpa only [norm_iteratedFDeriv_eq_norm_iteratedDeriv, Complex.ofRealLI_apply, Function.comp_def] using
-    Complex.ofRealLI.norm_iteratedFDeriv_comp_left (x := u) hf.contDiffAt (i := n) (by simp)
