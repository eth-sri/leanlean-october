-theorem common_measure_energy {Ω κ : Type*} [MeasurableSpace Ω] [Fintype κ]
-    (μ : Measure Ω) (b : Ω → ℂ) (φ : κ → Ω → ℂ) (E : ℝ) (hE : 0 ≤ E)
