-    {T Q : ℝ} (hT : 1 ≤ T) (hQ : 0 < Q)
-    {M M₂ M₃ : ℕ} (hM₂ : 0 < M₂) (hM₂M : M₂ ≤ M)
-    (hM₃ : 0 < M₃) (hMT : (M : ℝ) ≤ T ^ 4) :
-    16 * (M₂ : ℝ) ^ 2 *
