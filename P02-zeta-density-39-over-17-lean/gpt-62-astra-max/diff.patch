-        _ ≤ 2 * T ^ d := by gcongr
-    have hSecond : 2 * T ^ d ≤ T ^ d * T ^ d := by
-      nlinarith [Real.rpow_nonneg hTPos.le d]
-    calc
-      (N : ℝ) ≤ 2 * T ^ d := hFirst
-      _ ≤ T ^ d * T ^ d := hSecond
-      _ = T ^ (2 * d) := by
-        rw [← Real.rpow_add hTPos]
-        congr 1
