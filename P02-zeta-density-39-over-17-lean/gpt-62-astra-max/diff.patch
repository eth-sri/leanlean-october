-    rw [←map_mul,←s.removed_eq g,integralComplexMatrix_apply,
-      upper_right_removed_bottom _ _ s.lower_zero,map_mul]
-    exact mul_ne_zero (eisEmbedding_ne_zero h) (eisEmbedding_ne_zero s.lower_unit.ne_zero)
