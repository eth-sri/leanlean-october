-  let : Countable r := hr.to_subtype
-  have heach (χ : Cutoff) : ∀ᵐw∂KernelFundamentalVolume,kernelLiftedCutoff χ.1 w • g w=0 := by
-    have hzero := hg χ.1 χ.2
-    change kernelCutoffGradient χ.1 g=0 at hzero
