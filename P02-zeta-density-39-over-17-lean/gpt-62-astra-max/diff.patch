-theorem series_ne_zero (a : Ideal O →*₀ ℂ) (ha : ∀ I, ‖a I‖ ≤ 1)
-    (s : ℂ) (hs : 1 < s.re) : series a s ≠ 0 := by
-  intro hz
-  have h := inverseSeries_mul_series a ha s hs
-  rw [hz, mul_zero] at h
-  exact zero_ne_one h
