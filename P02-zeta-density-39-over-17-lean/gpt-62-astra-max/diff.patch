-  let Q : ℕ := 2 ^ r * N ^ k
-  have hTTwo : 2 ≤ T := (le_max_left _ _).trans hT
-  have hTPos : 0 < T := by linarith
-  have hNReal : (1 : ℝ) < N := by exact_mod_cast hN
-  have hNPos : 0 < N := by omega
-  have hQ : 1 < Q := by
