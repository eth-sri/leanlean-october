-lemma cubicValue_neg (P : Ideal O) [P.IsMaximal] (hg : lambda ∉ P) (x : O) :
-    cubicChar P hg (Ideal.Quotient.mk P (-x)) =
-      cubicChar P hg (Ideal.Quotient.mk P x) := by
