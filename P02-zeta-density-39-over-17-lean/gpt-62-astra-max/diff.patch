-            inner ℝ (u : MeasureTheory.Lp ℝ (2 : ℝ≥0∞) μ) kx := by
-        have hsmooth :
-            smoothFun (E := E) (K := K) ψ u (x : E) =
-              ∫ t, u t * kx t ∂(volume.restrict K) := by
-          have h_ae' :
