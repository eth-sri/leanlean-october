-        Real.rpow_le_rpow_of_exponent_le hCutOne (by linarith [hRect.1.1])
-      _ ≤ (4 * T) ^ (-σ) :=
-        Real.rpow_le_rpow_of_nonpos (by positivity)
-          (four_mul_lt_sharpZetaCutoff T).le (by linarith)
-  exact mul_le_mul_of_nonneg_left hPower (by norm_num)
