-  field_simp
-
-theorem centralLocal_six_norm_sq (p : O) (hp : Prime p) [(Ideal.span {p}).IsMaximal]
-    (hs : Supported (Ideal.span {p})) (hg : goodLambda ∉ Ideal.span {p})
