-    {η : Character} {z : O} (F : NaturalRow η z) (R : Ideal O) (hR : R≠0)
-    (W₁ W₂ : ℝ→ℂ) (a₁ b₁ a₂ b₂ : ℝ) (ha₁ : 0<a₁) (ha₂ : 0<a₂)
