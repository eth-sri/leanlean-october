-    I = Ideal.span {primaryGenerator I} := (primaryGenerator_spec I (primaryGenerator_admissible I hI)).1.symm
-    _ = Ideal.span {primaryGenerator J} := by rw [heq]
-    _ = J := (primaryGenerator_spec J (primaryGenerator_admissible J hJ)).1
