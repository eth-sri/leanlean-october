-  have hρa:ρ≤εm/4:=min_le_left _ _
-  have hρb:ρ≤1/4:=min_le_right _ _
-  refine ⟨ρ,ρ/4,ρ/400,ρ/400,ρ/16,ρ/16,ρ/16,hρ,hρb,hρa,?_,?_,?_,?_,?_,?_,?_,?_,?_,?_,?_⟩ <;> linarith
