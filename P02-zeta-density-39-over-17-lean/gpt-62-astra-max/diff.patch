-      commonPart I J=C ∧ commonPart J I=D := by
-  obtain ⟨⟨I,J⟩,hp,he⟩ := Finset.mem_image.mp h
-  obtain ⟨hi,hj⟩ := Finset.mem_product.mp hp
-  obtain ⟨hi,hIs⟩ := Finset.mem_filter.mp hi
-  obtain ⟨hj,hJs⟩ := Finset.mem_filter.mp hj
