-    typeISourceDirichletCoeff Y A r σ n *
-      (n : ℂ) ^ (-(t : ℂ) * I)
-  have hSmall : Finset.Ioc 1 (A + 1) ⊆ Finset.Icc 1 (A + 1) := by
-    intro n hn
