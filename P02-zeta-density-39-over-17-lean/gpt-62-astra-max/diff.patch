-@[simp] theorem primeValue_eq (P : Ideal O) [P.IsMaximal]
-    (hgood : lambda ∉ P) (x : O) :
-    primeValue P x = cubicChar P hgood (Ideal.Quotient.mk P x) := by
-  simp only [primeValue, dite_eq_left (show P.IsMaximal ∧ lambda ∉ P from
