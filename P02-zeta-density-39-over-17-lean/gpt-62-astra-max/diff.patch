-  have hu (u : Oˣ) (z : O) : f (u.val * z) = f z := by
-    dsimp only [f]
-    rw [canonical_pair_unit_invariant I J hI hJ hray, norm_eisEmbedding_unit_mul]
-  have he := tsum_unit_invariant_of_zero f hf h0 hu
