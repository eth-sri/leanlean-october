-private theorem invCharAF_mult {q : ℕ} (χ : DirichletCharacter ℂ q) :
-    (invCharAF χ).IsMultiplicative := by
-  exact (χ.isMultiplicative_toArithmeticFunction).pmul
-    (ArithmeticFunction.isMultiplicative_moebius.intCast)
