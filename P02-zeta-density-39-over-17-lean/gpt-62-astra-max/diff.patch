-/-- The exterior `{y | dist y x ∈ Set.Ioi r}` (complement of `closedBall x r`). -/
-def annulusIoi (x : X) (r : ℝ) : Set X := (fun y : X ↦ dist y x) ⁻¹' Ioi r
-
-/-- The exterior `{y | dist y x ∈ Set.Ici r}` (complement of `ball x r`). -/
