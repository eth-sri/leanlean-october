-        rw [hSplit]
-        field_simp [(Real.rpow_pos_of_pos hTPos (1 / 2 : ℝ)).ne']
-  have hPUpper : (P : ℝ) ≤ T ^ (1 / 2 + d) := by
-    exact (by exact_mod_cast hPM : (P : ℝ) ≤ M) |>.trans hMUpper
