-    (∫ u' in gmAffineUnitInterval T x, T * f u') ≤
-      gmAffineTildeSchwartz T hT f x := by
-  let G : ℝ → ℝ := fun u' =>
-    T * gmCubicLocalBump (T * (x - u')) * f u'
