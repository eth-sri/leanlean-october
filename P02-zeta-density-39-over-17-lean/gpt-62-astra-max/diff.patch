-def twistedFullDensity {ι : Type*} [Fintype ι]
-    (g : ι → 𝓢(ℝ, ℂ)) (g₁ g₂ b₃ : 𝓢(ℝ, ℂ))
-    (θ : ℝ × ℝ) (p : Ambient ι) : ℂ :=
-  fullProfileDensity g (𝓕 (frequencyTwist g₁ θ.1))
-    (𝓕 (frequencyTwist g₂ θ.2)) b₃ p
