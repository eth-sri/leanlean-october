-    _ = ∑' m, ∑' n, h m n := tsum_congr hvertical
-    _ = ∑' n, ∑' m, h m n := hh.tsum_comm.symm
-    _ = ∑' n, ∑' m, g m n := tsum_congr hhorizontal
-    _ = ∑' m, ∑' n, g m n := hg.tsum_comm
