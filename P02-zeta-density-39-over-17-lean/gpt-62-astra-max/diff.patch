-theorem dyadic_energy_eq_sum (n : ℤ) (f : O→ℂ) :
-    (∑' h : O,dyadicWeight n (normValue h)*‖f h‖^2)=
-      ∑ h∈dyadRows n,dyadicWeight n (normValue h)*‖f h‖^2 := by
-  apply tsum_eq_sum
-  intro h hh
-  have hz : dyadicWeight n (normValue h)=0 := by
-    by_contra hn
-    exact hh ((mem_dyadRows n h).mpr hn)
