-theorem normalized_centered_saving (D : ℂ) (T L C E : ℝ)
-    (hT : 0 < T) (hbound : ‖D‖ ≤ 4 * E * C * (T / L)) :
-    ‖(Real.sqrt T : ℂ)⁻¹ * D‖ ≤ 4 * E * C * (Real.sqrt T / L) := by
