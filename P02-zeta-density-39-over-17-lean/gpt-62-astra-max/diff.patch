-  unfold localCubePhase
-  rw [pow_mul C 2 r, hC, ← pow_add]
-  have he : r+((e+3*(2*r))*k+e*(2*r)+(2*r).choose 2) =
-      e*k+2*(3*r*k+e*r+r*r) := by
-    have hd := even_diagonal_exponent r
-    nlinarith
-  rw [he, pow_add, pow_mul omega 2, ho, one_pow, mul_one]
-
