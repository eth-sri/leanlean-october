-theorem polynomial_mellin (χ : Character) (inverse : Bool) (W : ℝ → ℂ)
-    (a b : ℝ) (ha : 0 < a) (hWs : Function.support W ⊆ Icc a b)
-    (hW : ContDiff ℝ ∞ W) (D c σ freq : ℝ) (hD : 0 < D) (hc : 1 < c+σ) :
