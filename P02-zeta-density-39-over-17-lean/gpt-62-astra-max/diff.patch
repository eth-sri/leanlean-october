-      mul_le_mul_of_nonneg_left
-        (mul_le_mul_of_nonneg_right hpow (norm_nonneg _)) hscale
-    _ ≤ _ := by
-      convert mul_le_mul_of_nonneg_left hb hscale using 1
-      ring_nf
-      rfl
