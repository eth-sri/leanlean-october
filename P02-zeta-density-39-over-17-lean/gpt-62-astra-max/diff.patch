-  have hpow : (X₁ : ℂ) ^ (1 + Complex.I * t) *
-      (X₂ : ℂ) ^ (1 + Complex.I * t) =
-      (Y₁ : ℂ) ^ (1 + Complex.I * t) * (Y₂ : ℂ) ^ (1 + Complex.I * t) := by
-    rw [← Complex.mul_cpow_ofReal_nonneg hX₁ hX₂,
-      ← Complex.mul_cpow_ofReal_nonneg hY₁ hY₂, ← Complex.ofReal_mul,
