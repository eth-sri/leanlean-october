-    fun I hI P hP => (primaryPrime_spec P
-      (primaryPrime_factor_ne_zero I P (hF I hI).2 hP)).2.1
-  have hnat : 1 ≤ ⌈N⌉₊ := Nat.one_le_ceil_iff.mpr (by linarith)
-  have hnorm : ∀ I ∈ F, Ideal.absNorm I ≤ ⌈N⌉₊ := by
-    intro I hI
