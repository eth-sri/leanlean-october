-        (∫ u : ℝ, |f u|) ^ 2 ≤
-      64 * gmAffineMiddleFarSourceConstant n * T ^ 3 /
-          Q ^ (n + 1) * (M : ℝ) ^ 4 * (∫ u : ℝ, |f u|) ^ 2 := by
-  have hcard := card_gmAffinePositiveShell_real_le_two_mul hM₂
