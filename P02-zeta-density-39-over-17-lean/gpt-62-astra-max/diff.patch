-theorem selectedPoisson_bounds (C M X η : ℝ)
-    (hC : 4≤C) (hM : 1≤M) (hX : 1≤X) (hMX : M≤X^2) (hη : 0≤η) :
-    4≤selectedPoissonT C M X η ∧ 1≤selectedPoissonK C M X η ∧
-      selectedPoissonK C M X η≤C*(M*X)^(η+2) := by
