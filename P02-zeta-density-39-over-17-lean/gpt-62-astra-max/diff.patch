-  have he : (∑ h∈rows,‖amplificationError Finset.univ (sourceGenerator S) (sourceGenerator_supported S)
-      (fun I : supportedColumns S => (Real.sqrt T:ℂ)⁻¹*c I)
-      (fun I => multiplicity p (sourceGenerator S I)) p (n+1) h‖^2)=
