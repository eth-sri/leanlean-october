-    (η : Character) (z : O) (hz : z≠0) (R : Ideal O) (hR : R≠0)
-    (W₁ W₂ : ℝ→ℂ) (a₁ b₁ a₂ b₂ : ℝ) (ha₁ : 0<a₁) (ha₂ : 0<a₂)
