-  have htPos : 0 < t := by linarith
-  have hTwoH : 2 * H ≤ t := by linarith
-  have hNeg := norm_typeIPowerReflectionIntegral_neg_le_on_symmetric_window
-    (sigma := sigma) (t := t) (H := H) (Q := (Q : ℝ)) (M := M)
