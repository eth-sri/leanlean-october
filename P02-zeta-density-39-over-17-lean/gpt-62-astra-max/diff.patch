-  obtain ⟨u, hu⟩ := Ideal.mem_span_singleton.mp hx
-  obtain ⟨v, hv⟩ := Ideal.mem_span_singleton.mp hy
-  refine ⟨u, v, ?_⟩
-  rw [hu, hv] at hxy
-  convert hxy using 1; ring
