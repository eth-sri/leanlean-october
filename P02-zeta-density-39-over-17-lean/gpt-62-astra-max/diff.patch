-    have hRaised :
-        (((2 ^ (7 * r) : ℕ) : ℝ) ^ (τ₀ / 10)) ≤
-          (((N ^ k : ℕ) : ℝ) ^ (τ₀ / 10)) :=
-      Real.rpow_le_rpow
-        (by positivity : (0 : ℝ) ≤ ((2 ^ (7 * r) : ℕ) : ℝ))
