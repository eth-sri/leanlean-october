-  have he : Matrix.SpecialLinearGroup.map (n:=Fin 2)
-      (Ideal.Quotient.mk (Ideal.span {(3:Eis)})) (g:SL(2,Eis)) =
-      Matrix.SpecialLinearGroup.map (n:=Fin 2)
-      (Ideal.Quotient.mk (Ideal.span {(3:Eis)})) (rationalEmbedding (levelTwoRight g)) := by
