-def coefficient (η ηi : Character) (S : Finset (Ideal O))
-    (D : Finset (Ideal O)) (H : SmoothIdeal S) : ℂ :=
-  (moebius (∏ P ∈ D,P) : ℂ) * idealCoeff η (∏ P ∈ D,P) * idealCoeff ηi H.val.val /
-    (Real.sqrt ((Ideal.absNorm (∏ P ∈ D,P):ℝ) * norm H.val) : ℂ)
