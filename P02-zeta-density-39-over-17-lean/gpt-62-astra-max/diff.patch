-    · have hc6 : 6 ≤ c := Nat.le_of_dvd (by omega) h6
-      have hn1 : c ≠ 1 := by omega
-      simp only [localSaving,min_self,h6,not_true_eq_false,false_and,and_false,
-        ite_false,hn1,add_zero]
-      have hcr : (6:ℝ) ≤ c := by exact_mod_cast hc6
-      linarith
-    · by_cases hu : nonunit
-      · by_cases hc1 : c=1
-        · subst c
