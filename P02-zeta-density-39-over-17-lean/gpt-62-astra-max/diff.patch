-    (ρ : BoundedContinuousFunction ℝ ℂ) (s : ℂ) :
-    AnalyticAt ℂ (compactHeightMellin a b ρ) s :=
-  (compactHeightMellin_differentiable a b ha ρ).analyticAt s
