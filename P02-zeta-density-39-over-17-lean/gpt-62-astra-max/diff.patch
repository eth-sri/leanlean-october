-private theorem omega_conj : conj omega3 = omega3 ^ 2 := by
-  have hs : omega3 ^ 2 = -omega3 - 1 := by
-    linear_combination omega3_sq
-  rw [hs]
-  unfold omega3
-  simp only [map_div₀, map_add, map_neg, map_one, map_mul,
-    Complex.conj_ofReal, Complex.conj_I, map_ofNat]
-  ring
