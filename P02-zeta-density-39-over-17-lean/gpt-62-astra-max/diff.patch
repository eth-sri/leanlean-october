-  calc
-    (Q : ℝ) ^ classicalMHHExponent σ τ ≤
-        (Q : ℝ) ^ ((3 * (1 - σ) / τ₀) * τ) := hPower
-    _ = ((Q : ℝ) ^ τ) ^ (3 * (1 - σ) / τ₀) := by
-      rw [mul_comm, Real.rpow_mul (by positivity)]
-    _ = T ^ (3 * (1 - σ) / τ₀) := by
-      rw [rpow_typeILogarithmicScale_eq hT hQ]
