-      (Ideal.absNorm (rowPowerfulPart I*(rowMaskPart I Q)^2*Q):ℝ) := by exact_mod_cast hb
-  simpa only [map_mul,map_pow,Nat.cast_mul,Nat.cast_pow] using hr
