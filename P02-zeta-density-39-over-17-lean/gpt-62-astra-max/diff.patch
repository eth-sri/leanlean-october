-lemma horizontalPhaseCLM_apply (freq direction : ℂ) :
-    horizontalPhaseCLM freq direction = horizontalPhaseMultiplier freq direction := by
-  simp [horizontalPhaseCLM,horizontalPhaseMultiplier]
