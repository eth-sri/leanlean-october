-    (hτ'Upper : τ' ≤ τ₀)
-    (hLoss : (3 * (1 - σ) / τ₀) *
-        (τ' - typeILogarithmicScale T N / k) ≤
-      η * (typeILogarithmicScale T N / k)) :
-    let Q := 2 ^ r * N ^ k
