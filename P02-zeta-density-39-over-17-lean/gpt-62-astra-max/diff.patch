-    (continuous_id.add continuous_const).measurable
-    (fun p hp => (hasFDerivAt_id p).add_const u) (add_left_injective u).injOn
-  · apply Set.Subset.antisymm
-    · rintro q ⟨p,hp,rfl⟩
-      simpa [euclideanUpperHalf,hu] using hp
-    · intro p hp
