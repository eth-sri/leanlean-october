-    unfold rowCoprimeMask
-    split_ifs <;> simp
-  have hrow : finiteSexticRow (activePrimes P S T) (fun i => hg i.val)
-        (activeExponent S T) z ^ 2 =
-      finiteSexticRow (activePrimes P S T) (fun i => hg i.val)
-        (activeCubicExponent S T) z := by
