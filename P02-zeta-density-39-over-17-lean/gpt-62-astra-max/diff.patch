-def primeValue (P : Ideal O) (x : O) : O :=
-  if h : P.IsMaximal ∧ lambda ∉ P then
-    letI : P.IsMaximal := h.1
-    cubicChar P h.2 (Ideal.Quotient.mk P x)
-  else 0
