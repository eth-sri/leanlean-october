-    rcases le_total za ((v+za)/3) with hz|hz
-    · exact (hu (min_eq_left hz)).elim
-    · rw [min_eq_right hz]
-      have hzv := min_le_left za ((v+za)/3)
-      rw [min_eq_right hz] at hzv
-      linarith
