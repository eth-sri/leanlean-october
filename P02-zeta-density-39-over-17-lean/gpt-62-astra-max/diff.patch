-    rowCoprimeMask (fun P : primePool {D} => P.val) Finset.univ z = idealZeroMask D z := by
-  have he : (∃ P ∈ (Finset.univ : Finset (primePool {D})), z ∈ P.val) ↔
-      ∃ P ∈ UniqueFactorizationMonoid.normalizedFactors D, z ∈ P := by
-    constructor
