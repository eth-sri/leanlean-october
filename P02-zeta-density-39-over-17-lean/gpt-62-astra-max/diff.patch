-    _ ≤ ∏ i : ι, (1 : ℝ) := Finset.prod_le_prod₀ (fun _ _ => norm_nonneg _)
-      (fun i _ => norm_finite_character_le_one
-        (canonicalSextic (P i) (hg i) ^ j i) _)
