-  let F : α→EuclideanSpace ℂ κ := fun i => e.symm (f i)
-  have hF (i : α) : ‖F i‖≤g i := by
-    apply (sq_le_sq₀ (norm_nonneg _) (hg0 i)).mp
-    rw [EuclideanSpace.norm_sq_eq]
-    exact hbound i
