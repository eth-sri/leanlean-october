-    apply Subtype.ext
-    apply Prod.ext hfst
-    have hn : p.val.1 ≠ 0 := by
-      intro hz
-      have he := p.property
-      rw [hz, zero_mul] at he
-      exact hB he.symm
-    apply mul_left_cancel₀ hn
-    rw [p.property, hfst, q.property]
-  · intro D
-    obtain ⟨J, hJ⟩ := (mem_idealDivisors hB).mp D.property
-    exact ⟨⟨(D.val, J), hJ.symm⟩, rfl⟩
