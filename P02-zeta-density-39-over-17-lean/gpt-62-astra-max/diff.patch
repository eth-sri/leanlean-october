-def gcdRaySupport {n : Type} [Fintype n] (cols : n → Ideal O) (a : n → ℂ)
-    (D : Ideal O) (c : EisensteinEPrimaryPhase.Coord) : Finset n :=
-  Finset.univ.filter (fun j => D ∣ cols j ∧ columnRay (cols j)=c ∧ a j≠0)
