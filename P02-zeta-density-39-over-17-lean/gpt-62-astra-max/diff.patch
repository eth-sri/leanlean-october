-  let T := cubeChoiceActive H L p
-  let a : ∀ i : T,cubeAwayList H (L i.val) := fun i =>
-    ⟨(p i.val).val,Finset.mem_filter.mpr ⟨(p i.val).property,(Finset.mem_filter.mp i.property).2⟩⟩
