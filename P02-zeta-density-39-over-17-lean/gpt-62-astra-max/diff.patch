-section PartialDerivatives
-variable {A E G : Type*}
-  [NormedAddCommGroup A] [NormedSpace ℝ A]
-  [NormedAddCommGroup E] [NormedSpace ℝ E]
-  [NormedAddCommGroup G] [NormedSpace ℝ G]
