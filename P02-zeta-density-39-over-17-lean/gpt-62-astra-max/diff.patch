-      (1 + ‖t‖) ^ J * ‖b t‖ ≤
-        (2 : ℝ) ^ J * (‖b t‖ + ‖t‖ ^ J * ‖b t‖) := by
-    have hpow := add_pow_le (show (0 : ℝ) ≤ 1 by norm_num) (norm_nonneg t) J
-    have htwo : (2 : ℝ) ^ (J - 1) ≤ (2 : ℝ) ^ J :=
-      pow_le_pow_right₀ (by norm_num) (Nat.sub_le J 1)
