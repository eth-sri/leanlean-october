-      ∑ j ∈ cubeLogRange b X, ∑ v ∈ activeCubeLogBin S D b X j, a v := by
-  symm
-  exact Finset.sum_fiberwise_of_maps_to
-    (fun v hv => activeCubeLogIndex_mem S D b X v hv) a
