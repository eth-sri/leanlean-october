-def scaledDualPoint (L : ℝ) (u : ℂ) (p : DualIndex) : Joint :=
-  point (u*(L:ℂ)*explicitDualFrequency 1 p.1)
-    (u*(L:ℂ)*explicitDualFrequency 1 p.2)
