-theorem tsum_dualIdealDyads
-    (f : ℕ×NonzeroDualIdeal×NonzeroDualIdeal → ℂ) (hf : Summable f) :
-    (∑'x, f x) = ∑'i : ℕ×ℕ×ℕ,
-      ∑n : dualIdealDyad i.2.2, ∑b : dualIdealDyad i.2.1,
