-    {M₁ M₃ : ℕ} (hM₁ : 0 < M₁) (hM₃ : 0 < M₃)
-    {Q xi : ℝ} (hQ : 0 < Q)
-    (hxi : gmAffineFirstPoissonRadius M₁ M₃ Q ≤ |xi|)
-    {p : ℤ × ℤ} (hp : p ∈ gmAffineFirstPoissonPairs M₁ M₃ Q xi) :
