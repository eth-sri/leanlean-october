-        cubicChar Q hQgood (Ideal.Quotient.mk Q r)) →
-      cubicChar P hPgood (Ideal.Quotient.mk P f.prod) =
-        cubicChar Q hQgood (Ideal.Quotient.mk Q f.prod) := by
-    intro f
