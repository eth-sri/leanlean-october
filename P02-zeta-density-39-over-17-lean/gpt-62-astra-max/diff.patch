-theorem divisorEnergyFactor_nonneg (ε : ℝ) (hε : 0 < ε) (N : ℝ) (a : n → ℂ) (b : p → ℂ) :
-    0 ≤ divisorEnergyFactor ε hε N a b := by
-  have hs := (supportConstant_pos ε hε).le
-  have hd := (divisorConstant_pos ε hε).le
-  unfold divisorEnergyFactor
-  positivity
