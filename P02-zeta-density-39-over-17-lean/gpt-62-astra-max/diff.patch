-theorem annularSum_div_eq_integral (f : ℕ → ℝ) (φ : ℝ → ℝ)
-    (hφ : Differentiable ℝ φ) (hφ' : Continuous (deriv φ))
-    {a b x : ℝ} (ha : 0 ≤ a) (hab : a ≤ b) (hx : 0 < x)
