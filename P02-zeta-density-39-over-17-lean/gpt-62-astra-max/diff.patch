-
-theorem series_deletePrimes (S : Finset PrimeIdeal) (a : Ideal O →*₀ ℂ)
-    (ha : ∀ I, ‖a I‖ ≤ 1) (s : ℂ) (hs : 1 < s.re) :
-    series (deletePrimes S a) s =
-      series a s * ∏ P ∈ S, (1 - weighted a s P.val) := by
