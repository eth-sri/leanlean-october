-  let ζ : ℂ := Complex.exp (2 * Real.pi * Complex.I / q)
-  have hζ : IsPrimitiveRoot ζ q := Complex.isPrimitiveRoot_exp q NeZero.out
-  let F : ↥(dfiCoprimeResidues q) → ↥(primitiveRoots q ℂ) := fun d =>
