-theorem deletePrimes_apply (S : Finset PrimeIdeal) (a : Ideal O →*₀ ℂ) (I : Ideal O) :
-    deletePrimes S a I = if ∀ P ∈ S, ¬P.val ∣ I then a I else 0 := by
