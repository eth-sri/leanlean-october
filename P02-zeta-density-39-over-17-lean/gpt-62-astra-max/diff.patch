-  apply (ρ.continuous.comp hyperbolicHeight_continuous).mul
-  change Continuous (fun w : HyperbolicSpace =>
-    Complex.exp (2*Real.pi*Complex.I*((-freq*hyperbolicHorizontal w)+
-      starRingEnd ℂ (-freq*hyperbolicHorizontal w))))
