-    ((gmAffineFirstPoissonEllRange M₁ M₃ Q Y).card : ℝ) ≤
-      3 * (Y + Q + 1) := by
-  have hM₁r : (1 : ℝ) ≤ M₁ := by exact_mod_cast hM₁
-  have hM₃r : (1 : ℝ) ≤ M₃ := by exact_mod_cast hM₃
