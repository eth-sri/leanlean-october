-def outsideScalar (Z v ell el S₀ B₀ Td : ℝ) : ℝ :=
-  Z ^ (-v/2-ell-el/3-(S₀+B₀)/2) *
-    InverseKernelSourceUniform.smallScalar (Z ^ (v+3*ell+el-Td))
