-    baseChangeWeight χ (I * J) =
-      baseChangeWeight χ I * baseChangeWeight χ J := by
-  have hrel := ideals_isRelPrime_of_norms_coprime I J h
-  simp only [baseChangeWeight, map_mul, hrel.moebius_mul, Int.cast_mul, Nat.cast_mul]
-  ring
