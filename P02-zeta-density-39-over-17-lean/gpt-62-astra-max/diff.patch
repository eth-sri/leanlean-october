-lemma extractionBin_scale_product (R : Finset O) (M : ℝ)
-    (hR : ∀ z ∈ R, z ≠ 0 ∧ (Ideal.absNorm (Ideal.span {z}) : ℝ) ≤ M)
-    (j : Fin (CanonicalQuadraticSieve.columnDyadicLength M + 1) ×
