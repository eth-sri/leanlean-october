-    (hQ : Q ≠ 0) (hC : C^2=omega) (ho : omega^2=1) (r d : ℕ) :
-    weightedScalar Q eta a G1 C omega X W V (Q^(6*r+5)*(Q-1))
-      0 (2*r+2) 0 (r+1+d) =
-      evenRatio Q a X V ^ r * (evenRatio Q a X V*(1-Q⁻¹)*V^d) := by
