-    (fun i => primeRemainder_supported p hp (a i) (ha i))
-  · exact fun i _ => (primeRemainder_spec p hp (a i) (supported_element_ne_zero _ (ha i))).1
-  · exact fun i _ => hp.irreducible.coprime_iff_not_dvd.mpr
