-    unfold afeWeight
-    rw [(show u ^ (-σ - 3) = u ^ (-σ) / u ^ 3 by simpa only [Nat.cast_ofNat] using Real.rpow_sub_natCast hu.ne' (-σ) 3)]
-    field_simp
-  rw [he, abs_of_nonpos (mul_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr (sq_nonneg c))
