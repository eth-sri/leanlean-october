-noncomputable def gmAffineRegionIITailRawBound
-    (epsilon : ℝ) (n : ℕ) (T Q Y : ℝ) (f : SchwartzMap ℝ ℝ)
-    (M₁ M₂ M₃ : ℕ) (Cdiv Ctail : ℝ) : ℝ :=
