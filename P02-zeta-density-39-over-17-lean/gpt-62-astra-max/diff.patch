-  obtain ⟨hv,ha⟩ := Finset.mem_filter.mp hv
-  have hm := profile_nonzero_masks (R*C) (fun i : liveIndices B => ν i.val)
-    (fun i => Wslot i.val) (fun i => P i.val) W₁ W₂ X₁ X₂ Y₁ Y₂
-    (B₁*B (Sum.inr 0)) (B₂*B (Sum.inr 1)) 1 v hvn
