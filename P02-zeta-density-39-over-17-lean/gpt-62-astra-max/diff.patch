-lemma reference_sqrt_lower (NC ND A₀ B₀ a T M:ℝ)
-    (hNC:0≤NC)(hND:0≤ND)(hA:0≤A₀)(_hB:0≤B₀)(ha:0≤a)(hT:0≤T)
