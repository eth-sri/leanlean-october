-        Complex.exp ((gaussianRegulatorSequence n:ℂ)*((σ:ℂ)+t*Complex.I)^2)) := by fun_prop
-    exact hc.aestronglyMeasurable.mul hg.aestronglyMeasurable
-  · exact hg.norm.const_mul _
