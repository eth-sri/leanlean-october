-theorem Vstar_support (W : ℝ→ℂ) (a b : ℝ)
-    (hsupp : Function.support W⊆Set.Icc a b) : Function.support (Vstar W)⊆Set.Icc a b := by
-  intro x hx
-  apply hsupp
-  intro hz
-  exact hx (by simp [Vstar,hz])
