-    ‖∑ n ∈ Finset.Ioc L U,
-        ((n : ℝ) ^ (-σ)) • unitaryPhase (logarithmicPhase t n)‖ ≤
-      ((L + 1 : ℕ) : ℝ) ^ (-σ) *
-        (30 * Real.sqrt (X * ((L + 1 : ℕ) : ℝ) * t ^ (1 / 3 : ℝ))) := by
-  have h := norm_smoothStep_weighted_Ioc_le_weyl
-    X 0 σ t 1 L U (by norm_num) hσ (by omega) hL hLU hLength
