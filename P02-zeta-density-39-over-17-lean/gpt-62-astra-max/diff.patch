-theorem support_card_bound (ε : ℝ) (hε : 0 < ε) (I : Ideal O) (hI : I ≠ 0) :
-    (2 : ℝ) ^ (primeSupport I).card ≤ supportConstant ε hε * (Ideal.absNorm I : ℝ) ^ ε :=
-  (SquarefreeDivisorBound.prime_support_subsets_bound ε hε).choose_spec.2 I hI
