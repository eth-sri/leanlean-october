-    _ = ∑' p : Ideal O × Ideal O, ((moebius p.1 : ℂ) * f p.1) * f p.2 :=
-      tsum_mul_tsum_of_summable_norm (inverse_summable_norm a ha s hs)
-        (weighted_summable_norm a ha s hs)
