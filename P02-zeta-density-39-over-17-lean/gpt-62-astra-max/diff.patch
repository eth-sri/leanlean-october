-    {T : ℝ} {Q : ℕ} {σ τ₀ : ℝ}
-    (hσLower : 1 / 2 < σ) (hσUpper : σ < 1)
-    (hcert : EndpointScaleCertificate σ τ₀)
-    (hT : 0 < T) (hQ : 1 < Q)
