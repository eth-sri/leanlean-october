-lemma hyperbolicVolume_invariant_mul (g h : SL(2,ℂ))
-    (hg : Measure.map (fun w => g • w) hyperbolicVolume=hyperbolicVolume)
-    (hh : Measure.map (fun w => h • w) hyperbolicVolume=hyperbolicVolume) :
