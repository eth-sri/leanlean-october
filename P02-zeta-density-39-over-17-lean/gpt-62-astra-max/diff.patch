-lemma reflectedCuspProfile_eq_inv_square (A:ℂ) (Q:ℝ) (g:ℝ→ℂ) (v:ℝ) :
-    reflectedCuspProfile A Q g v=A/(v:ℂ)^2*g ((Q*v)⁻¹) := by
-  unfold reflectedCuspProfile
-  rw [Complex.cpow_neg,Complex.cpow_ofNat]
-  ring
