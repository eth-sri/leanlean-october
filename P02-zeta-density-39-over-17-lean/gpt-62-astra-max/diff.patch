-      simp only [xShift, sub_zero, Fin.val_zero, Nat.cast_zero, mul_zero]
-      field_simp
-    have hxmem : a / L ∈ Set.Ico (0 : ℝ) 1 :=
-      ⟨div_nonneg ha₀ hL.le, (div_lt_one hL).2 haL⟩
-    have hxiff : (xShift a 0 L 0 : UnitAddCircle) = 0 ↔ a = 0 := by
