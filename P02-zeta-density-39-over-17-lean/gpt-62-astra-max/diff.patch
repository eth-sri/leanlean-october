-instance primeIndexMaximal (I : Ideal O) (P : PrimeIndex I) : P.val.IsMaximal := by
-  have hp := UniqueFactorizationMonoid.prime_of_normalized_factor P.val
-    (Multiset.mem_toFinset.mp P.property)
