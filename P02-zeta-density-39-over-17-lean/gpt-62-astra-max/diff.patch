-    rw [norm_mul]
-    exact (mul_le_of_le_one_left (norm_nonneg _)
-      (QuadraticInitialBound.norm_ideal_moebius_le_one _)).trans
-      (tripleRow_norm_le_one _ _ _ (supported_element_ne_zero _ (residualGenerator_supported I J hI))
