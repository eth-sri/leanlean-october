-    (UniqueFactorizationMonoid.moebius (∏ i∈E,P i) : ℂ) *
-      (normValue (primeSubsetGenerator P E) : ℂ)⁻¹ *
-        G (Ideal.Quotient.mk _ (primeSubsetGenerator P E)) * quotientMean d G))
