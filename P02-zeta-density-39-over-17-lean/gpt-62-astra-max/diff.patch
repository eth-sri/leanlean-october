-  apply (mul_le_of_le_one_left (norm_nonneg _) (rowLogD_hyperbolic_bound u hu p hp j)).trans
-  exact cuspRemainderProfile_euler_bound a b s C hC _ (rowHeight_pos u hu p hp)
