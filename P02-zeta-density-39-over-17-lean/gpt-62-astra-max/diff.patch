-    _ ≤ C * (K * X) ^ ε * (K + X) *
-        ∑ p ∈ pairs, Cbound * ∑ c ∈ cset p.1, ‖F p c‖ ^ 2 := by
-      apply mul_le_mul_of_nonneg_left (Finset.sum_le_sum hlocal)
-      positivity
-    _ = _ := by rw [← Finset.mul_sum]; simp only [F]; ring
