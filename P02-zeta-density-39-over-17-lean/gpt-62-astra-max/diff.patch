-theorem actual_middle_radial_block_bound (W : 𝓢(ℝ, ℂ)) (A : ℕ) :
-    ∃ C : ℝ, 0 ≤ C ∧
-      ∀ {m n p : Type*} [Fintype m] [Fintype n] [Fintype p]
