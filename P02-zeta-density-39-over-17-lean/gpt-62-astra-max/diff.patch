-def kernelCorrectedSeed (a b : ℝ) (ha : 0<a) (hab : a<b) (s : ℂ) : KernelQuotient→ℂ :=
-  fun q => kernelQuotientSeed a b s q+kernelEisensteinL2Correction a b ha hab s q
