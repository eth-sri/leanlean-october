-        (τ' - typeILogarithmicScale T Q) ≤
-      η * typeILogarithmicScale T Q) :
-    (Q : ℝ) ^ classicalMHHExponent σ (typeILogarithmicScale T Q) ≤
-      T ^ (3 * (1 - σ) / τ₀ + η) := by
