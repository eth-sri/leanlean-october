-      HeckeDyadic.polynomial (χ.excludePrimes R hR) false W₂ X₂ 0 0 *
-      (∏i∈F,naturalSlot (χ.excludePrimes R hR) (pool i) (β i) (P i)) =
-    ∑D₁∈R.powerset,∑D₂∈R.powerset,∑J∈F.powerset,
