-    intro n
-    simpa [Pi.sub_def] using (continuousOn_weierstrassFactor_div (m n) (a n) K).sub continuousOn_const
-  simpa using hsumm.hasProdUniformlyOn_nat_one_add (K := K)
-    (f := fun n z ↦ weierstrassFactor (m n) (z / a n) - 1) hK hbound hcts
