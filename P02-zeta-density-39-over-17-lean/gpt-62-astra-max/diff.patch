-  have hI0 : Integrable (fun t : ℝ => ‖b t‖) volume := by
-    simpa using b.integrable_pow_mul volume 0
-  have hIJ : Integrable (fun t : ℝ => ‖t‖ ^ J * ‖b t‖) volume :=
-    b.integrable_pow_mul volume J
-  have hIrhs : Integrable
-      (fun t : ℝ => (2 : ℝ) ^ J *
-        (‖b t‖ + ‖t‖ ^ J * ‖b t‖)) volume :=
-    (hI0.add hIJ).const_mul _
