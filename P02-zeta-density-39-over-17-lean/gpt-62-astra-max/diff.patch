-theorem scaled_discarded_triple_bound (A : ℕ) :
-    ∃ (s : Finset (ℕ × ℕ)) (C : ℝ),0<C ∧
-      ∀ (W : 𝓢(ℝ,ℂ)) (Tsec Z Csec H ξ k : ℝ),
