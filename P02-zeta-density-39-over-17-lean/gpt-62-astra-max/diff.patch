-theorem large_principal_scale_shape (X N Q D V : ℝ) (hD : 0 < D)
-    (hcut : X * N ≤ V * D) :
-    (X / D) * (N + Q * D) ≤ V + X * Q := by
-  have hh : X * N / D ≤ V := (div_le_iff₀ hD).mpr hcut
-  calc
-    _ = X * N / D + X * Q := by field_simp
-    _ ≤ _ := add_le_add hh le_rfl
