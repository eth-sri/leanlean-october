-/-- Explicit reciprocal loss converting the detector's raw Type-I
-threshold into the normalized `N^σ` threshold. -/
-noncomputable def typeIDirectThresholdLoss (T : ℝ) (A : ℕ) (d : ℝ) : ℝ :=
-  1 + (8 / 3 : ℝ) * Nat.clog 2 A * T ^ d
