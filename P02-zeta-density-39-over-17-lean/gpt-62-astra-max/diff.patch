-  have hmb : m.Coprime b := hmn2.coprime_dvd_right hb2
-  have ha_mn : a ∣ m * n := ⟨b, hprod.symm⟩
-  have hm_ab : m ∣ a * b := ⟨n, hprod⟩
-  have hn_ab : n ∣ a * b := ⟨m, by rw [hprod, mul_comm]⟩
