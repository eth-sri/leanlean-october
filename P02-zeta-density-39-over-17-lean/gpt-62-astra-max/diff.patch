-      (Nat.pow_le_pow_right (by omega) hr.le)
-  have hSlack : (N : ℝ) ^ ((k : ℝ) * τ₀ / 10) ≥
-      (2 : ℝ) ^ ((r : ℝ) * (2 * τ₀ / 3)) := by
