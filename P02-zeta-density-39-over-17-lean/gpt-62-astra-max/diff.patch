-abbrev InitialChild := Ideal Eis × Ideal Eis × Eis
-
-def initialChild {J : ℕ} (x : InitialTuple J) : InitialChild :=
-  (idealQuotient x.divisor x.common, x.divisor * x.residual,
-    primaryGenerator x.divisor * x.frequency)
