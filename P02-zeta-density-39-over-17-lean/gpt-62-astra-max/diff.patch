-/-- A source-faithful finite realization of `|m₃| ≪ M₃`.  The factor eight
-dominates every support constant used by the Section 8 smoother. -/
-noncomputable def gmAffineCentralShell (M : ℕ) : Finset ℤ :=
-  Finset.Icc (-(8 * M : ℕ) : ℤ) (8 * M : ℤ)
