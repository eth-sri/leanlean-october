-        apply Ideal.Quotient.eq_zero_iff_mem.mp
-        have hz : (2 : O ⧸ P) = 0 := (ringChar.spec (O ⧸ P) 2).mpr (by rw [hc])
-        simpa only [map_ofNat] using hz
-      have he := maximal_ideal_eq_span_of_mem P inferInstance (2 : O) twoIdeal_maximal ht
