-def pullback (e : R ≃+* S) (χ : MulChar S ℂ) : MulChar R ℂ where
-  toFun := fun x => χ (e x)
-  map_one' := by simp
-  map_mul' := by intro x y; simp
-  map_nonunit' := by
-    intro x hx
-    apply χ.map_nonunit
-    intro h
-    apply hx
-    simpa using h.map e.symm.toMonoidHom
