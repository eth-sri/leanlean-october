-    have hRaised := Real.rpow_le_rpow (by positivity) hNLower hExpPos.le
-    have hFloorPower : (T ^ d / 2) ^ (2 / d) =
-        T ^ 2 / (2 : ℝ) ^ (2 / d) := by
-      have hExp : d * (2 / d) = 2 := by field_simp [hd.ne']
-      rw [Real.div_rpow (Real.rpow_nonneg hTPos.le _) (by norm_num : (0 : ℝ) ≤ 2),
