-    (hWc : HasCompactSupport W) (hWs : ContDiff ℝ ∞ W) (K : ℝ) (hK : 0 < K)
-    (c : O) (hc : c ≠ 0) (P : O ⧸ Ideal.span {c} → ℂ) :
