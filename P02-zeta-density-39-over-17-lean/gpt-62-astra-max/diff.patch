-  have hQOne : (1 : ℝ) ≤ Q := by exact_mod_cast hQ.le
-  have hEnvelope := classicalMHHExponent_le_corollary1110Envelope_of_certificate
-    hσUpper hcert (τ := τ)
-  have hTargetExp := hcert.subdivision_window τ hτLower hτUpper
