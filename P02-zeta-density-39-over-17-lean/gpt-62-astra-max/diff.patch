-theorem representative_spec (c : O) (r : O ⧸ Ideal.span {c}) :
-    Ideal.Quotient.mk (Ideal.span {c}) (representative c r) = r :=
-  Classical.choose_spec (Ideal.Quotient.mk_surjective r)
