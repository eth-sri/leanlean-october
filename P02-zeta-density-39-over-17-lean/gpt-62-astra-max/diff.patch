-      apply mul_le_mul_of_nonneg_left htotal
-      positivity
-    _ = _ := by
-      rw [Real.mul_rpow (show 0 ≤ K * X by positivity) (show 0 ≤ N by linarith)]
-      ring
-
-end
-end SevenEighths.InverseMoment
-
-end OAI
