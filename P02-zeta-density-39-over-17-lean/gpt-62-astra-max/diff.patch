-theorem summed_dual_density {n : Type} [Fintype n] [DecidableEq n]
-    (cols : n → Ideal O) (a : n → ℂ) (G : Ideal O) (M K : ℝ) (hM : 0 ≤ M)
-    (hcols : ∀ j, Admissible (cols j)) :
-    (∑ q ∈ idealDivisors G, (UniqueFactorizationMonoid.moebius q:ℂ)*
