-        gcongr
-  have hScalePos : 0 < C * (2 * N : ℝ) ^ ε * (N : ℝ) ^ (-σ) := by positivity
-  rw [normalizedSharpMollifiedLineCoeff, norm_div, Complex.norm_real,
-    Real.norm_eq_abs, abs_of_pos hScalePos]
-  exact (div_le_one hScalePos).mpr hLine
