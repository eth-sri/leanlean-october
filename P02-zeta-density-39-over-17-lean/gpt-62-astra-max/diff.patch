-      · simp only [ite_eq_right h,hz A h]
-    _=∑A:{A:Finset ι // R⊆A},F A.val:=by
-      rw [←Finset.sum_filter]
-      exact Finset.sum_subtype (Finset.univ.filter (fun A:Finset ι=>R⊆A)) (by simp) F
-    _=_:=by
-      apply Fintype.sum_equiv (mandatoryActiveEquiv R)
-      intro A
