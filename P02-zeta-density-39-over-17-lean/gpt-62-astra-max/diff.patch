-          Finset.mem_univ _, Ideal.mem_span_singleton.mpr hz⟩
-      · exact ⟨⟨P, Finset.mem_union_right _ (Multiset.mem_toFinset.mpr hP)⟩, Finset.mem_univ _, hz⟩
