-/-- Coarse but source-faithful envelope for finite-power normalization
-losses after the exact `N^σ` cancellation. -/
-noncomputable def classicalTypeIIPowerLoss
-    (A d T : ℝ) (k Q : ℕ) : ℝ :=
-  A * (((2 : ℝ) ^ k) * Q) ^ (2 * d) * (k : ℝ) *
-    (4 * Real.log T) ^ k
