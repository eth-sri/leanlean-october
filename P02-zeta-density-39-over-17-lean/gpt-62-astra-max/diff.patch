-lemma euclideanAxisSlice_derivatives (f : EuclideanSpatial→ℂ)
-    (hf : ∀p,0<p 2→ContDiffAt ℝ ∞ f p) (p : EuclideanSpatial) (hp : 0<p 2) (j : Fin 3) :
