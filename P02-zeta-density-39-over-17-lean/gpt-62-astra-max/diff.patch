-    _ ≤ T ^ (1 + rho) := hThreeT
-    _ ≤ (P : ℝ) ^ (3 : ℕ) := hCubeP
-    _ ≤ ((P + 1 : ℕ) : ℝ) ^ (3 : ℕ) := by
-      gcongr
-      norm_num
