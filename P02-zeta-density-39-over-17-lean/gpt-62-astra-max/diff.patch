-lemma upperSchwartz_derivative_compact (f : 𝓢(EuclideanSpatial,ℂ))
-    (hcompact : HasCompactSupport f) (u : EuclideanSpatial) :
-    HasCompactSupport (∂_{u} f : 𝓢(EuclideanSpatial,ℂ)) :=
