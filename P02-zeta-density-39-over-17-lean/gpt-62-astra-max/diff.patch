-          unitaryPhase (logarithmicPhase t n)‖ =
-        ‖∑ n ∈ Finset.Ioc L U, f n • g n‖ := by rfl
-    _ ≤ f (L + 1) * (100 * Real.sqrt t) := hBound
-    _ ≤ ((L + 1 : ℕ) : ℝ) ^ (-σ) * (100 * Real.sqrt t) := by
