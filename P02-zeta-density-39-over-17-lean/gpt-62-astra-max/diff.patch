-    (if IsCoprime (finiteTupleProduct v) R then 1 else 0)*
-    idealRectangle W₁ W₂ X₁ X₂ Y₁ Y₂ (B₁*v (Sum.inr 0)) (B₂*v (Sum.inr 1))*
-    (if s∣finiteTupleProduct v then 1 else 0)
