-    convert hbase1 1 using 1 ; dsimp [z, ι] ; simp ; field_simp
-  have hw : ShortDraftTrace.breveE (omega3 * z / eisLam) = 1 := by
-    convert hbase1 pb.gen using 1
-    · rw [show ι pb.gen = omega3 from embedding_gen omega3 omega3_sq]
-      dsimp [z]
-      field_simp
