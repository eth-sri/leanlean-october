-    (hid : kappa + lambda + count + 2 * Fc = F)
-    (hdelta : delta ≤ 6 * eta) :
-    kappa + lambda + count + 2 * (Fc + delta) +
-      (9 / 2 + 18 + 11 / 2) * eta + tau + pi + eps ≤
-      F + 40 * eta + tau + pi + eps := by
-  linarith
-
-def initialF (r z G P delta : ℝ) : ℝ := r + z - 2 * G - P + delta
-
-def initialM (m r z G P eta tau : ℝ) : ℝ :=
