-
-/-- The annulus `{y | dist y x ∈ Set.Icc r R}` in a pseudo metric space. -/
-def annulusIcc (x : X) (r R : ℝ) : Set X := (fun y : X ↦ dist y x) ⁻¹' Icc r R
