-      ∀ (η : Character) (m : O),m≠0 → goodLambda∣m → (2:O)∣m →
-      ∃ τ : (elementPool P) → Fin 3 → RayCharacter → Character,
-        (∀ (p : elementPool P) i χ,(τ p i χ).modulus.absNorm≤
