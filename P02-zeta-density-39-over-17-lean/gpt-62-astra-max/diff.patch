-  have hc : (0 : ℝ) < P.card := Nat.cast_pos.mpr hP.card_pos
-  have hb : (P.card : ℝ)*‖H‖^2 ≤ 4 *
-      ∑ p ∈ P, (‖A p‖^2 + ‖E₁ p‖^2 + ‖E₆ p‖^2 + ‖E₇ p‖^2) := by
