-    (χ : Character) (a X Y Z : ℝ) (H B : ℂ → ℂ → ℂ → ℂ) : ℂ :=
-  verticalIntegral a (fun s => fixedPrincipalResidue M ^ 2 / 6 *
-    sourceMultiplier W0 W1 X Y Z χ s (H s) (B s) 1 (1/6))
