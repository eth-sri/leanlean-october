-  have hmPos : (0 : ℝ) < m := by exact_mod_cast hmPosNat
-  have hmOne : (1 : ℝ) ≤ m := by exact_mod_cast hm
-  have hMPos : (0 : ℝ) < M := by exact_mod_cast hmPosNat.trans_le hmM
