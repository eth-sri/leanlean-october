-theorem canonicalCubeCorrelation_eq_blocks
-    (hinj : Function.Injective (fun i=>Ideal.span {p i}))
-    (hpr : ∀i,lambda^2∣p i-1) (pool : Finset ι) (v₁ v₂ : ι→₀ℕ)
