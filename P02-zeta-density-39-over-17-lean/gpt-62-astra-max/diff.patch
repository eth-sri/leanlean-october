-theorem idealQuotient_injective_on (D : Ideal O) :
-    Set.InjOn (idealQuotient D) {I | D ∣ I} := by
-  intro I hI J hJ heq
-  calc
-    I = D * idealQuotient D I := (idealQuotient_mul hI).symm
-    _ = D * idealQuotient D J := by rw [heq]
-    _ = J := idealQuotient_mul hJ
