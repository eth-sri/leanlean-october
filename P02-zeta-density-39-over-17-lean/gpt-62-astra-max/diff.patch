-lemma forcing_dvd_good_mul_radical (Q : Ideal O) (hQ : Q ≠ 0)
-    (P : ι → Ideal O) (hp : ∀ i, Prime (P i)) (hinj : Function.Injective P)
-    (c d : ι → ℕ) (V : Finset ι) :
-    forcingIdeal P c d V ∣ goodIdeal Q P c d V * commonRadical Q Q := by
