-      0<ρ ∧ ρ≤1/4 ∧ ρ≤εm/4 ∧
-      0<gap ∧ 2*gap≤ρ ∧
-      0<η ∧ η≤1/7 ∧ η≤gap/50 ∧
-      0<τ ∧ τ≤gap/50 ∧ 0<π ∧ 0<eps ∧ 0<loss ∧
-      ρ+15*η+π+eps+loss≤εm:=by
-  let ρ:=min (εm/4) (1/4)
