-def squarefreeGaussCoefficient (I : Ideal O) : ℂ :=
-  if h : Squarefree I ∧ primaryGenerator I ≠ 0 then
-    star (FiniteGaussPhase.angularFactor (primaryGenerator I)) * gaussTwo I h.2
-  else 0
