-      ‖Complex.exp ((ε:ℂ)*((σ:ℂ)+(t:ℂ)*Complex.I)^2)*
-        f ((σ:ℂ)+(t:ℂ)*Complex.I)‖≤K/(1+t^2) := by
-  refine ⟨B*Real.exp (ε*(max |a| |b|)^2+A^2/(2*ε))*(1+4/ε),by positivity,?_⟩
-  intro σ hσ t
