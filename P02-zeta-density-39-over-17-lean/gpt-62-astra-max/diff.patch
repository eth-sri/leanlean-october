-  toFun a := (a : ℕ)
-  invFun z := ⟨z.val, ZMod.val_lt z⟩
-  left_inv a := Fin.ext (ZMod.val_natCast_of_lt a.isLt)
-  right_inv z := ZMod.natCast_zmod_val z
