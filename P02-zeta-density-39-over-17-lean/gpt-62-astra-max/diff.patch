-    · intro I hI
-      obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hI
-      exact (hN x hx).2.1
-  have hc : (c.card : ℝ) ≤ 128 * W := by
-    apply finite_ideal_count_real c W hW
-    · intro I hI
-      obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hI
