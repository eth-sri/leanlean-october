-theorem eventually_reflected_weyl_geometry
-    {sigma d s U : ℝ} (hsigmaUpper : sigma < 1) (hd : 0 < d)
-    (hs : 0 < s) (hU : 0 < U) :
-    ∃ T₀ : ℝ, 8 ≤ T₀ ∧ ∀ {T theta w : ℝ} {P : ℕ}, T₀ ≤ T →
