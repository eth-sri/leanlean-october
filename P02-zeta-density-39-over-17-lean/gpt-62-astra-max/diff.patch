-      atTop (𝓝 0) := by
-    have hDiv := (isLittleO_log_rpow_atTop ha).tendsto_div_nhds_zero
-    apply hDiv.congr'
-    filter_upwards [eventually_gt_atTop (0 : ℝ)] with T hT
-    rw [Real.rpow_neg hT.le, div_eq_mul_inv]
