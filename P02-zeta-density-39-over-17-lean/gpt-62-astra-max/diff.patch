-    funext (euclideanAxisPath_affine p j)
-  rw [he]
-  simpa only [sub_zero,one_smul,zero_add,Pi.add_apply,id_eq] using!
-    (hasDerivAt_const t p).add (((hasDerivAt_id t).sub_const (p j)).smul_const (euclideanCoordinateVector j))
