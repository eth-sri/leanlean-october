-lemma outside_prime (R : Finset (Ideal O)) (hR : ∀ I∈R,Prime I)
-    (I : Ideal O) (hI : Prime I) : outside R I ↔ I∉R := by
-  constructor
-  · intro h hi
-    exact h I hi dvd_rfl
-  · intro h J hj hd
-    have he : J=I := (prime_dvd_prime_iff_eq (hR J hj) hI).mp hd
