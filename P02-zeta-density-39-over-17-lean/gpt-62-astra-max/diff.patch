-    (P : κ → Ideal O) [∀ j, (P j).IsMaximal] (B : Finset κ) (z : O) :
-    (∏ j ∈ B, (1 : MulChar (O ⧸ P j) ℂ) (Ideal.Quotient.mk (P j) z)) =
-      rowCoprimeMask P B z := by
-  by_cases h : ∃ j ∈ B, z ∈ P j
-  · rw [rowCoprimeMask, ite_eq_left h]
-    obtain ⟨j, hj, hz⟩ := h
