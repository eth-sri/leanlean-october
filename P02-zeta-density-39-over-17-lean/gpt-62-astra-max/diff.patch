-  calc
-    _ ≤ (Ideal.absNorm (firstPart (Ideal.span {z})) : ℝ) *
-        (Ideal.absNorm (secondPart (Ideal.span {z})) : ℝ) ^ 2 :=
-      mul_le_mul hh.1.1 (pow_le_pow_left₀
-        (le_trans (by norm_num) (CanonicalQuadraticSieve.divisorDyadicScale_ge_one _)) hh.2.1 2)
