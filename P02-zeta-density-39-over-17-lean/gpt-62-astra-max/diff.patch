-def rows (S : Finset (Ideal O)) : Set O :=
-  {u | u ≠ 0 ∧ ∀ P ∈ normalizedFactors (Ideal.span {u}),
-    P ∈ S ∧ (normalizedFactors (Ideal.span {u})).count P < 6}
