-    rw [iteratedDeriv_succ, ih]
-    funext x
-    rw [show deriv (fun y => phaseDerivative t ^ n * logPhase t y) x =
-        phaseDerivative t ^ n * (phaseDerivative t * logPhase t x) from
-      ((logPhase_hasDerivAt t x).const_mul _).deriv]
-    simp only [pow_succ]
-    ring
