-          Z^((H+v+ell+za)*ε) * Z^(max H (v+ell)) * Z^ell *
-          Z^(v+za-hybridSaving v za)) := by ring
-        _ = _ := by
-          rw [← Real.rpow_add hZ0,← Real.rpow_add hZ0,← Real.rpow_add hZ0,
-            ← Real.rpow_add hZ0,reflected_exponent_identity]
