-    n hT hQ hM₂ hM₃ hM₂M hMT
-  have hM₂r : (M₂ : ℝ) ≤ M := by exact_mod_cast hM₂M
-  have hM₂nonneg : (0 : ℝ) ≤ M₂ := Nat.cast_nonneg _
