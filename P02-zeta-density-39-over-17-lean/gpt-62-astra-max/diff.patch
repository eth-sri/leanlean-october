-  · rintro ⟨hs, hN⟩
-    exact ⟨⟨Nat.one_le_iff_ne_zero.mpr (fun h => hs.ne_zero (Ideal.absNorm_eq_zero_iff.mp h)),
-      Nat.le_floor hN⟩, hs⟩
