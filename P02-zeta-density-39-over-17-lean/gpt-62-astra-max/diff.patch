-lemma finite_centering_identity {ι : Type*} (S : Finset ι) (w R D : ι → ℂ) (c h : ℂ) :
-    (∑ q∈S, w q*(c*R q-h*D q)) = c*(∑ q∈S,w q*R q)-h*(∑ q∈S,w q*D q) := by
-  rw [Finset.mul_sum,Finset.mul_sum,←Finset.sum_sub_distrib]
-  apply Finset.sum_congr rfl
-  intro q hq
-  ring
