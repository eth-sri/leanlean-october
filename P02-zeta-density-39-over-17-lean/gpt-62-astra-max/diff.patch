-lemma ramifiedCusp_unit_period_constant (b:Bool) :
-    (3:Eis)∣onceCuspScale (ramifiedCuspScaleUnit b)+
-      ramifiedAffineParameter (ramifiedCuspDirectIndex b) 0 := by
