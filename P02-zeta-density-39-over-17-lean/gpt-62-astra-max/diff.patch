-theorem norm_setIntegral_typeIReflectedMellinIntegrand_le
-    {sigma t Q R K : ℝ} {M : ℕ} {S : Set ℝ}
-    (hS : MeasurableSet S) (hQ : 0 < Q) (hR : 0 ≤ R)
-    (hFixed : ∀ r ∈ S,
-      ‖typeIReflectedFixedPolynomial sigma (t + r) M‖ ≤ R)
-    (hKernel : ∀ r ∈ S,
