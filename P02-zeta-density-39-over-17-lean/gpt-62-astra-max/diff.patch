-      mul_le_mul_of_nonneg_right hnorm (by positivity)
-    _ ≤ _ := by
-      apply mul_le_mul_of_nonneg_left _ (highKernelNorm_nonneg _ _ _)
-      rw [Finset.sum_coe_sort S (fun j : n => ‖a j‖ ^ 2)]
