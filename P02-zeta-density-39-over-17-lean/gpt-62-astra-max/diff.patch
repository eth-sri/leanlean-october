-      obtain ⟨I, hI, hP⟩ := mem_primePool_iff.mp P.property
-      have hID : I = D := Finset.mem_singleton.mp hI
-      exact ⟨P.val, hID ▸ hP, hz⟩
-    · rintro ⟨P, hP, hz⟩
-      have hp : P ∈ primePool {D} := mem_primePool_iff.mpr ⟨D, Finset.mem_singleton_self D, hP⟩
