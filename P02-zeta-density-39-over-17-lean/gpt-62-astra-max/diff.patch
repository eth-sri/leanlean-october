-    (∏ i, F i (Ideal.Quotient.mk _ n)) =
-      ∑ A : Finset ι, localInactiveWeight p hp F A *
-        ∑ v : ∀ i : A, (Eis ⧸ Ideal.span {p i.val})ˣ,
-          localActiveWeight p hp F A v *
-            ∏ i : A, quotientTrace (p i.val) (hp i.val)
