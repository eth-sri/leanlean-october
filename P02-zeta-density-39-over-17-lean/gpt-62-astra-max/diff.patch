-
-theorem hybrid_kernel_quotients (R r k' P' c' m h : Ideal Eis)
-    (hk : CanonicalQuadraticSieve.Admissible ((R * r) * k'))
-    (hP' : CompletedGauss.primaryGenerator P' ≠ 0) :
