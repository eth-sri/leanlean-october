-theorem eventually_lower_source_logarithmic_scale_bounds
-    (d : ℝ) (hd : 0 < d) :
-    ∃ T₀ : ℝ, 2 ≤ T₀ ∧ ∀ (T : ℝ) (r : ℕ), T₀ ≤ T → r < 2 →
-      let Y := ⌊T ^ d⌋₊
