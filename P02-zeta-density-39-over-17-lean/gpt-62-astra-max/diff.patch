-    (hc : ringChar (O ⧸ Ideal.span {p})≠2) (hpp : goodLambda^2 ∣ p-1)
-    (n : ℕ) (hn : n=0 ∨ n=5 ∨ n=6) (T : ℝ) (hT : 0<T)
-    (rows : Finset O) (hrows : ∀ h∈rows,¬p∣h)
-    (W : 𝓢(ℝ,ℂ)) (K : ℝ) (hK : 0<K)
