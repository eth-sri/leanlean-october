-variable {M H hH}
-variable {s : Input α} {η₀ : Character} {θ : α → RayQuotient.Characters M H}
-  {w σ freq : α → ℝ} {W : ℝ → ℂ} {bslot Z : ℝ}
-  (h : Matches M H hH s η₀ θ w σ freq W bslot Z)
