-    (W : ℝ → ℂ) (bslot Z : ℝ) : Prop where
-  character : ∀ i I, s.ν i I = idealCoeff (relativeCharacter M H hH η₀ (θ i)) I
-  profile : ∀ i y, s.W i y = W y * (y : ℂ)^(-HeckeDyadic.shift (σ i) (freq i))
-  pool : ∀ i, s.slots i = primePool M H bslot (Z^(w i))
-  scale : ∀ i, s.P i = Z^(w i)
