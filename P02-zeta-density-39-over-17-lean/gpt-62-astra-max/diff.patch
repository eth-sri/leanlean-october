-      (dampedCutoff ψ q (Real.exp (-u)) : ℂ)) =
-      (fun u => (dampedMellinLift ψ σ q u : ℂ)) := by
-    funext u
-    simp [dampedMellinLift, Complex.real_smul]
-  rw [hfun]
-  simp
