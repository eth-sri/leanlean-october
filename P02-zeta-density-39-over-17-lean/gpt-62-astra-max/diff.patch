-    primaryIdealCharacter 1 χ I=1 := by
-  rw [primaryIdealCharacter_apply]
-  have he : Ideal.Quotient.mk (Ideal.span {(1:O)}) (CompletedGauss.primaryGenerator I)=1 := by
