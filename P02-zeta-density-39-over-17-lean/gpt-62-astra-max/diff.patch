-    {σ τ₀ T τ' η : ℝ} {Q : ℕ}
-    (hσUpper : σ < 1)
-    (hcert : EndpointScaleCertificate σ τ₀)
-    (hT : 0 < T) (hQ : 1 < Q)
-    (hScaleLe : typeILogarithmicScale T Q ≤ τ')
-    (hτ'Lower : 2 * τ₀ / 3 ≤ τ')
-    (hτ'Upper : τ' ≤ τ₀)
