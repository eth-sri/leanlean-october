-    ∃ (s : Finset (ℕ × ℕ)) (C : ℝ),0<C ∧
-      ∀ (W : 𝓢(ℝ,ℂ)) (I J : Ideal O)
-        (hI : CanonicalQuadraticSieve.Supported I) (hJ : CanonicalQuadraticSieve.Supported J)
-        (E : Finset (CommonIndex I J)) (K X HN Tsec Z Csec ξ : ℝ),
