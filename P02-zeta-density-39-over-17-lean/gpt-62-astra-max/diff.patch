-    ‖slotRatio S T w Q A η s‖ ≤ 1 + slotErrorConstant S * P ^ (-(7/8 : ℝ)) := by
-  have hn := norm_add_le (slotRatio S T w Q A η s - 1) (1 : ℂ)
-  rw [sub_add_cancel, norm_one] at hn
-  linarith [slotRatio_error S T w Q A η h hs]
