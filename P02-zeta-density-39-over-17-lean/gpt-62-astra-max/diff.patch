-      nlinarith
-    have hTwo : ((2 ^ r : ℕ) : ℝ) ^ (2 * τ₀ / 3) ≤
-        (N : ℝ) ^ ((k : ℝ) * τ₀ / 10) := by
-      calc
-        ((2 ^ r : ℕ) : ℝ) ^ (2 * τ₀ / 3) =
