-    simpa [Pi.smul_def, smul_eq_mul] using (((2 * Real.pi * t) • ContinuousLinearMap.id ℝ ℝ).hasTemperateGrowth)
-  exact Complex.hasTemperateGrowth_exp_mul_I.comp hl
