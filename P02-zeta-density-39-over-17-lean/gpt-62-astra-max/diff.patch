-  let E := 3 * (1 - σ) / τ₀
-  have hEnvelope := classicalMHHExponent_le_corollary1110Envelope_of_certificate
-    hσUpper hcert (τ := τ')
-  have hTarget := hcert.subdivision_window τ' hτ'Lower hτ'Upper
-  have hAtAugmented : classicalMHHExponent σ τ' ≤ E * τ' := by
