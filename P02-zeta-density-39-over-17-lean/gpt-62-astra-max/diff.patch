-    (hk : CanonicalQuadraticSieve.Admissible k)
-    (hP : CompletedGauss.primaryGenerator P ≠ 0)
-    (hngen : CompletedGauss.primaryGenerator n ≠ 0)
-    (hn : n = c * m) (hb : b = (c * h) * t ^ 2)
