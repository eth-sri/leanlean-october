-/-- The real logarithmic lift whose Fourier transform is the Mellin transform
-on the line of real part σ. -/
-def dampedMellinLift (ψ : ℝ → ℝ) (σ q u : ℝ) : ℝ :=
-  Real.exp (-σ*u) * dampedCutoff ψ q (Real.exp (-u))
