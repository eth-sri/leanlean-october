-    (if c=d ∧ ¬6∣c ∧ ¬nonunit then 1 else 0) +
-    (if c=d ∧ ¬6∣c ∧ nonunit then 1/6 else 0) +
-    (if c=d ∧ c=1 ∧ nonunit then 1/3 else 0)
