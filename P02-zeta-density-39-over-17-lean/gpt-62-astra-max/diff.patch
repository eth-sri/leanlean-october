-      T ≤ (N : ℝ) ^ ((k : ℝ) * τ₀) := hPowN
-      _ = ((N ^ k : ℕ) : ℝ) ^ τ₀ := by
-        push_cast
-        rw [← Real.rpow_natCast, ← Real.rpow_mul (by positivity)]
-      _ ≤ (Q : ℝ) ^ τ₀ := by
-        apply Real.rpow_le_rpow
-        · positivity
-        · exact_mod_cast Nat.le_mul_of_pos_left (N ^ k) (pow_pos (by omega) r)
-        · exact hτ₀.le
