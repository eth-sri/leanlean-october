-      (3 * (1 - σ) / τ₀) * τ := by
-    calc
-      classicalMHHExponent σ τ ≤ corollary1110Envelope σ τ₀ τ := hEnvelope
-      _ ≤ (3 - 3 * σ) * τ / τ₀ := hTargetExp
