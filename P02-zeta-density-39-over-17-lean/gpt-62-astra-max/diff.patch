-    apply mul_left_cancel₀ hd
-    change d*(r*a'+s*c')=d*1
-    calc
-      _=r*a+s*c:=by rw [ha,hc'];ring
-      _=d:=hrs
-      _=_:=by ring
-  obtain ⟨u,hu,hua,huc⟩:=normalize_coprime_pair a' c' hred
-  refine ⟨u.val*a',u.val*c',mul_ne_zero u.ne_zero hcp,?_,hu,?_,hua,huc⟩
-  · refine ⟨d*(↑u⁻¹:Eis),?_⟩
