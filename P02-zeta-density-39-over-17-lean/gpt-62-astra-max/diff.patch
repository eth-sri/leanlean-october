-def horizontalPhaseCLM (freq : ℂ) : ℂ →L[ℝ] ℂ :=
-  (2*Real.pi*Complex.I:ℂ) •
-    (freq • ContinuousLinearMap.id ℝ ℂ +
-      (Complex.conjCLE : ℂ →L[ℝ] ℂ).comp (freq • ContinuousLinearMap.id ℝ ℂ))
