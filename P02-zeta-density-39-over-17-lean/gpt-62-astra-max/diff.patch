-    (∑' i,∑ p,w p*f p i)-(∑ i∈J,∑ p,w p*f p i)=
-      ∑ p,w p*((∑' i,f p i)-∑ i∈J,f p i) := by
-  rw [Summable.tsum_finsetSum (fun p _ => (hf p).mul_left (w p)),Finset.sum_comm]
-  simp only [tsum_mul_left,←Finset.mul_sum,mul_sub,Finset.sum_sub_distrib]
