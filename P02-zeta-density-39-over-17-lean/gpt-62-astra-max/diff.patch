-  have hA:arithmeticResidueSum h ((u.val*lambda^n)*b)=0:=by
-    by_contra hA
-    exact (not_le_of_gt hout) (arithmeticResidueSum_ramified_index_bound h hh u n hn b hb hA)
-  simp only [arithmeticDirichletTerm,hA,mul_zero,ite_self]
-
-end
