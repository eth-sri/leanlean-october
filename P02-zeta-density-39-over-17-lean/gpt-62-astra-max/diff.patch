+    have hnn : 0 ≤ (harmonic Q:ℝ) := by rw [harmonic_eq_sum_Icc]; push_cast; positivity
+    calc
+      _ ≤ 2*(Q:ℝ)*((Q:ℝ)+12*π*Q*(harmonic Q:ℝ))/V^2 := by gcongr
