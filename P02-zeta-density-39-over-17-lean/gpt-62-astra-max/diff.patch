-      SchwartzMap.seminorm ℝ 0 0 gmAffineLocalBumpDual ^ 2) *
-      (64 * gmAffineMiddleFarSourceConstant n *
-          (∫ u : ℝ, |f u|) ^ 2 +
-        192 * 3 * (4 : ℝ) ^ n * Ctail ^ 2 *
-          SchwartzMap.seminorm ℝ 0 0 (gmAffineComplexify f) ^ 2) +
-    4 * (gmAffineRegionIFarConstant n * (∫ x : ℝ, f x)) ^ 2
