-theorem actual_eligible_amplification {α : Type*} (S : Finset α) (a : α → O)
-    (ha : ∀ i, Supported (Ideal.span {a i})) (c : α → ℂ)
-    (rows : Finset O) (hrows : ∀ h ∈ rows,h ≠ 0)
