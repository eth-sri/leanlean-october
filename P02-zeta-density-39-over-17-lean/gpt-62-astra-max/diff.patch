-theorem sourceLower_pos (C D : Ideal O) (hC : C≠0) (hD : D≠0)
-    (A : O) (hA : A≠0) (K : ℝ) (hK : 0<K) : ∀i,0<sourceLower C D A K i := by
-  intro i
-  fin_cases i
-  · exact secondEffectiveScale_pos C D hC hD A hA K hK
-  all_goals norm_num [sourceLower]
