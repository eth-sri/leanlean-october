-    (hW:ContDiff ℝ ∞ W) (X:ℝ) (hX:0<X) :
-    (∑v,w v*(s.datum (g v) (by rw [hC v];exact hc)).smoothedKernel W X)=
-      fixedRadialCoefficientScalar*s.stratumShapeFactor c*
-      ∑'p:ThetaFullIndex,
