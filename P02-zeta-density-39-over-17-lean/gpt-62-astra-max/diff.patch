-    · intro hi
-      by_cases hr:i∈R
-      · exact Or.inl hr
-      · exact Or.inr ⟨⟨i,hr⟩,hi,rfl⟩
-  right_inv B:=by
-    ext i
-    simp only [Finset.mem_subtype,Finset.mem_union,Finset.mem_image]
-    constructor
-    · rintro (hi|⟨j,hj,hji⟩)
-      · exact False.elim (i.property hi)
