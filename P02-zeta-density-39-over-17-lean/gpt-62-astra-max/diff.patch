-lemma norm_arithmeticDirichletTerm_le (s : ℂ) (h : O) (c : LevelLower) :
-    ‖arithmeticDirichletTerm s h c‖ ≤ 9*‖eisEmbedding c.1‖^(2-2*s.re) := by
-  unfold arithmeticDirichletTerm
-  split_ifs with hc
