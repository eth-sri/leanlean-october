-      (∫ t : ℝ, (1 + ‖t‖) ^ J * ‖b t‖) ≤
-        (2 : ℝ) ^ J *
-          ((∫ t : ℝ, ‖b t‖) +
-            (∫ t : ℝ, ‖t‖ ^ J * ‖b t‖)) := by
