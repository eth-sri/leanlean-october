-    (hbound : ∀i,(∑k,‖f i k‖^2)≤(g i)^2) :
-    (∀k,Summable (fun i => ‖f i k‖)) ∧
-    (∑k,‖∑'i,f i k‖^2)≤(∑'i,g i)^2 := by
