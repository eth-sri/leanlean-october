-  refine ⟨T₀, hTupper.trans (le_max_left _ _), ?_⟩
-  intro T r hT hr
-  dsimp only
-  have hTUpper : Tupper ≤ T := (le_max_left _ _).trans hT
-  have hTConst : (2 : ℝ) ^ (1 / d) ≤ T :=
-    (le_max_right _ _).trans hT
