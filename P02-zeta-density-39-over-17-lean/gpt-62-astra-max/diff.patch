-theorem gmAffineRegionIIRawBound_eq_core_add_tail
-    (epsilon : ℝ) (n : ℕ) {T Q Y : ℝ} (hT : 0 < T) (hQ : 0 < Q)
-    (f : SchwartzMap ℝ ℝ) (M₁ M₂ M₃ : ℕ) (Cdiv Ctail : ℝ) :
