-lemma primeProduct_add (B : Finset ι) (u v : ι → ℕ) :
-    primeProduct p B (fun i => u i + v i) = primeProduct p B u * primeProduct p B v := by
-  simp only [primeProduct, pow_add, Finset.prod_mul_distrib]
