-    ∑ i ∈ Finset.range (min P (M - P)),
-        (((P : ℝ) + 1 + (i : ℝ)) ^ sigma / (M : ℝ) ^ sigma) •
-          unitaryPhase (logarithmicPhase t (P + 1 + i)) =
-      ∑ i ∈ Finset.range (min P (M - P)),
