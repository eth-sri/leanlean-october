-def deletePrimes (S : Finset PrimeIdeal) (a : Ideal O →*₀ ℂ) : Ideal O →*₀ ℂ :=
-  CanonicalRowCompletion.primeValueHom
-    (fun I => if I ∈ S.image Subtype.val then 0 else a I)
