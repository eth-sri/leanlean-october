-/-- The `typeIDirectPowerLossConstant` definition used by the source-facing construction in `ClassicalEndpointSlab`. -/
-noncomputable def typeIDirectPowerLossConstant : ℝ :=
-  max 1 ((2 / 3 : ℝ) * (1 + 2 / Real.log 2))
