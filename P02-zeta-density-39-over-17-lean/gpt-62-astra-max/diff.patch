-lemma norm_four_correction_terms (A B C D : ℂ) :
-    ‖-A-B+C+D‖ ≤ ‖A‖+‖B‖+‖C‖+‖D‖ := by
-  have hab := norm_sub_le (-A) B
-  have habc := norm_add_le (-A-B) C
-  have habcd := norm_add_le (-A-B+C) D
-  simp only [norm_neg] at hab
-  linarith
