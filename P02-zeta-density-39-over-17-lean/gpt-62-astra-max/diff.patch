-  have hh := Real.rpow_le_rpow (Real.rpow_nonneg hN.le _) hM hα.le
-  rw [←Real.rpow_mul hN.le] at hh
-  have he : (2-1/α)*α=2*α-1 := by field_simp
-  rwa [he] at hh
