-    MulFiber B ≃ {D : Ideal O // D ∈ idealDivisors B} := by
-  let f : MulFiber B → {D : Ideal O // D ∈ idealDivisors B} :=
-    fun p => ⟨p.val.1, (mem_idealDivisors hB).mpr ⟨p.val.2, p.property.symm⟩⟩
