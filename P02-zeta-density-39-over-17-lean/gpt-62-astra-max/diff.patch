-    by_cases hI : I = 0
-    · subst I
-      rw [map_zero, map_zero]
-    · change (if I = 0 then 0 else
-        ((normalizedFactors I).map (fun J => if J ∈ S.image Subtype.val then 0 else a J)).prod) = a I
