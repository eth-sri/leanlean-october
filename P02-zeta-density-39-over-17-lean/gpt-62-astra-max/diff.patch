-lemma card_admissible_ramified_product (n : ℕ) (m : O)
-    (hm : IsCoprime m (3:O)) (hlamm : IsCoprime lambda m) :
-    Nat.card (AdmissibleResidue (lambda^n*m)) =
-      Nat.card (O ⧸ Ideal.span {lambda^n}) * idealTotient (Ideal.span {m}) := by
