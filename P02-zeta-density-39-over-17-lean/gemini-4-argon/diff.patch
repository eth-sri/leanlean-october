-    (m : ℕ) (f : ℂ → ℂ) (z₀ : ℂ)
-    (s : Finset (divisorZeroIndex₀ f (Set.univ : Set ℂ))) (z : ℂ) : ℂ :=
-  ∏ p ∈ s, divisorComplementFactor m f z₀ p z
