-/-- Continuity of the exact finite affine sum. -/
-theorem continuous_gmAffineTransformSum
-    {f : ℝ → ℝ} (hf : Continuous f) (M₁ M₂ M₃ : ℕ) :
-    Continuous (gmAffineTransformSum f M₁ M₂ M₃) := by
-  unfold gmAffineTransformSum gmAffineTerm
