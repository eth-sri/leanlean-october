-    (T : ℝ) (D : ℝ → ℕ → ℝ) (depth : ℕ)
-    (f : SchwartzMap ℝ ℝ) : Prop :=
-  ∀ epsilon : ℝ, 0 < epsilon → ∀ n : ℕ,
-    GMAffineHeightFourierMassBound epsilon T n
-      ((2 : ℝ) ^ depth * D epsilon n) f
