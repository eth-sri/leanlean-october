-/-- One affine summand from (9.1). -/
-noncomputable def gmAffineTerm (f : ℝ → ℝ) (m₁ m₂ m₃ : ℤ) (u : ℝ) : ℝ :=
-  f (((m₁ : ℝ) * u + (m₃ : ℝ)) / (m₂ : ℝ))
