-        2 ≤ tau → tau ≤ tauMax → (Q : ℝ) ^ tau = T →
-        T ^ d ≤ T / 2 → T - T ^ d ≤ t → t ≤ 2 * T + T ^ d →
-        (((Q + 1 : ℕ) : ℝ) ^ (2 : ℕ)) ≤ 8 * t ∧
-          t ≤ ((((Q / 2) + 1 : ℕ) : ℝ) ^ (3 : ℕ)) := by
-  let rho : ℝ := 3 / tauMax - 1
