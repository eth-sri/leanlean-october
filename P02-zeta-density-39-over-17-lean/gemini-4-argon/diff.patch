-    (f : SchwartzMap ℝ ℝ) (M₂ : ℕ) (m₁ : ℤ) (xi : ℝ) : ℂ :=
-  ∑ m₂ ∈ gmAffinePositiveShell M₂,
-    (((|(m₂ : ℝ) / (m₁ : ℝ)| : ℝ) : ℂ) *
-      fourier (gmAffineComplexify f)
