-/-- The exact product-window radius following from the retained
-first-Poisson cutoff. -/
-noncomputable def gmAffineFirstPoissonRadius
-    (M₁ M₃ : ℕ) (Q : ℝ) : ℝ :=
-  Q * (2 * M₁ : ℝ) / (8 * M₃ : ℝ)
