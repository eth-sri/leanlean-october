-        (1/3:ℝ) ≤ ‖shortFiniteDetector ρ H‖) →
-      (R.card:ℝ) ≤ C*H^(shortDensityExponent σ+ε) := by
-  classical
-  let η : ℝ := min (ε/100) (1/100)
