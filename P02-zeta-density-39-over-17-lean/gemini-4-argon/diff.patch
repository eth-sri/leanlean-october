-    mul_pos hMr (atkinsonIndexSlopeLower_pos (hH.trans_le hHu) (by positivity))
-  unfold atkinsonIndexFirstDerivativeUpper
-  rw [div_le_iff₀ hden]
-  exact mul_le_mul_of_nonneg_left (hgap.trans hscale) Real.pi_nonneg
-
