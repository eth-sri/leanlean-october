-    hasProdLocallyUniformlyOn_weierstrassFactor_div (s := (Set.univ : Set ℂ)) isOpen_univ
-      (m := fun _ => m) (a := a)
-      (eventually_le_norm_div_two_of_summable_inv_pow h_sum h_nonzero)
-      (summable_scaled_bound_of_summable_inv_pow h_sum)
-
-end Complex
