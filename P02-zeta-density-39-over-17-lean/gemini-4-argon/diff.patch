-theorem integral_gmAffineSmoothingKernelReal_eq
-    (T : ℝ) (hT : 0 < T) :
-    (∫ x : ℝ, T * gmCubicLocalBump (T * x)) =
-      ∫ y : ℝ, gmCubicLocalBump y := by
-  calc
-    (∫ x : ℝ, T * gmCubicLocalBump (T * x)) =
-        T * ∫ x : ℝ, gmCubicLocalBump (T * x) := by
-      rw [integral_const_mul]
