-/-- The finite affine transformation sum inside `J(f)`. -/
-noncomputable def gmAffineTransformSum
-    (f : ℝ → ℝ) (M₁ M₂ M₃ : ℕ) (u : ℝ) : ℝ :=
-  ∑ m₁ ∈ gmAffineSignedShell M₁,
-    ∑ m₂ ∈ gmAffinePositiveShell M₂,
-      ∑ m₃ ∈ gmAffineCentralShell M₃, gmAffineTerm f m₁ m₂ m₃ u
