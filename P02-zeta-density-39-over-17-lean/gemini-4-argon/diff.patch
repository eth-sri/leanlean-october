-  Σ z : ℂ, Fin (Int.toNat (MeromorphicOn.divisor f U z))
-
-/-- The nonzero part of `divisorZeroIndex`. -/
-abbrev divisorZeroIndex₀ (f : ℂ → ℂ) (U : Set ℂ) : Type :=
-  {p : divisorZeroIndex f U // p.1 ≠ 0}
