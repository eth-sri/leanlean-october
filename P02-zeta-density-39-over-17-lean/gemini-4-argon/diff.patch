-/-- The compact `tau`-integral `Z₁` in equation (9.7), with the same fixed
-local bump used throughout the source-facing Section 9 argument. -/
-noncomputable def gmAffineMiddleTauPhase
-    (A : ℝ) (m₂ m₂' : ℤ) (u u' tau : ℝ) : ℝ :=
-  2 * Real.pi * tau *
-    (((m₂' : ℝ) / A) * u' - ((m₂ : ℝ) / A) * u)
