-/-- The lower boundary of Region II excludes the zero product. -/
-theorem gmAffineFirstPoissonPair_product_ne_zero
-    {M₁ M₃ : ℕ} (hM₁ : 0 < M₁) (hM₃ : 0 < M₃)
-    {Q xi : ℝ} (hQ : 0 < Q)
-    (hxi : gmAffineFirstPoissonRadius M₁ M₃ Q ≤ |xi|)
