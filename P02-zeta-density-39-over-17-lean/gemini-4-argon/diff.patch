-    (M : ℕ) : gmAffineCentralShell M ⊆ gmAffineSmoothCentralShell M := by
-  intro m hm
-  rw [mem_gmAffineSmoothCentralShell]
-  rcases mem_gmAffineCentralShell.mp hm with ⟨hmLower, hmUpper⟩
-  constructor <;> omega
