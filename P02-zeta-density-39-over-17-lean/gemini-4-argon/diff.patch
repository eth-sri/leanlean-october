-      (sq_le_sq₀ (norm_nonneg _)
-        (div_nonneg hC (pow_nonneg (abs_nonneg xi) n))).mpr (hG xi hxi)
-    calc
-      ‖G xi‖ ^ 2 ≤ (C / |xi| ^ n) ^ 2 := hsq
-      _ = C ^ 2 * |xi| ^ a := by
-        dsimp only [a]
-        rw [Real.rpow_neg habs.le]
-        have hp : (|xi| ^ n) ^ 2 = |xi| ^ (2 * (n : ℝ)) := by
-          rw [← pow_mul, ← Real.rpow_natCast]
-          congr 1
-          norm_num
-          ring
-        rw [div_pow, div_eq_mul_inv, hp]
