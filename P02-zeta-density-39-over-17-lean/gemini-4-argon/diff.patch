-theorem atkinsonIndexSlopeLower_anti
-    {u x B : ℝ} (hu : 0 < u) (hx : 0 < x) (hxB : x ≤ B) :
-    atkinsonIndexSlopeLower u B ≤
-      atkinsonIndexSlopeLower u x := by
