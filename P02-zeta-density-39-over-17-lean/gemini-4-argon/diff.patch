-  unfold gmAffineSmoothTransformSum
-  apply Finset.sum_nonneg
-  intro m₁ hm₁
-  apply Finset.sum_nonneg
-  intro m₂ hm₂
-  apply Finset.sum_nonneg
-  intro m₃ hm₃
-  exact mul_nonneg (gmAffineCentralWeight_nonneg M₃ m₃) (hf _)
