-    (∑' j : ℤ, gmAffineScaledBumpDual S hS (alpha + j)) =
-        ∑' j : ℤ, (gmAffineScaledNearTerm S hS alpha Q j +
-          gmAffineScaledFarTerm S hS alpha Q j) := by
-      apply tsum_congr
-      intro j
