-  have hn :
-      Int.toNat (MeromorphicOn.divisor f U (divisorZeroIndex₀_val p)) ≠ 0 := by
-    intro h0
-    have q0 : Fin 0 := by
-      simpa [divisorZeroIndex₀_val, h0] using p.1.2
-    exact Fin.elim0 q0
-  intro hdiv
-  have : Int.toNat (MeromorphicOn.divisor f U (divisorZeroIndex₀_val p)) = 0 := by
-    simp [hdiv]
