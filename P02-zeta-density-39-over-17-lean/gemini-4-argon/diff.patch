-        (∫ x : ℝ, f x) * ((M₃ : ℝ) * (4 * S * Z + 16 * S)) := by
-      gcongr
-    _ = gmAffineRegionIFarConstant n * (M₂ : ℝ) ^ 2 * M₃ *
-          (∫ x : ℝ, f x) := by
-      unfold gmAffineRegionIFarConstant
-      dsimp only [S, Z]
-      field_simp [hM₁r.ne']
