-  have hηeps : η ≤ ε/100 := min_le_left _ _
-  obtain ⟨C,hC,hLV⟩ := refined_large_values hη hηsmall
-  have hloglim := (isLittleO_log_rpow_rpow_atTop (2:ℝ) hη).tendsto_div_nhds_zero
