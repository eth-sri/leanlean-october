-        gmAffineScaledFarSeries (T / M₂) (by positivity)
-          (-gmAffineMiddleDisplacement m₂ m₂' u u') Q := by
-  let S : ℝ := T / M₂
-  have hS : 0 < S := by dsimp only [S]; positivity
-  rw [gmAffineMiddleZ₂_poisson hT hM₂]
