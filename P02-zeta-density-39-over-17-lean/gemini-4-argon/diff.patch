-theorem atkinson_mul_sqrt_div {H M : ℝ} (hM : 0 < M) :
-    M*Real.sqrt (H/M) = Real.sqrt (H*M) := by
-  calc
-    _ = Real.sqrt (M^2)*Real.sqrt (H/M) := by rw [Real.sqrt_sq hM.le]
