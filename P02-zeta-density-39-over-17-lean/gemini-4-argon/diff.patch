-rapidly decaying frequency is discarded. -/
-noncomputable def gmAffineFirstPoissonTau
-    (M₃ : ℕ) (m₁ ell : ℤ) (xi : ℝ) : ℝ :=
-  (8 * M₃ : ℝ) * (xi / (m₁ : ℝ) + (ell : ℝ))
