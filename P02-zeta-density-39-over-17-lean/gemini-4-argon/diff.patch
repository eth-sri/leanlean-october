-theorem integral_gmAffineSmoothingKernelReal_le_four
-    (T : ℝ) (hT : 0 < T) :
-    (∫ x : ℝ, T * gmCubicLocalBump (T * x)) ≤ 4 := by
-  rw [integral_gmAffineSmoothingKernelReal_eq T hT]
