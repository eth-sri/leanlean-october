-noncomputable def gmAffineMiddleZ₁
-    (A : ℝ) (m₂ m₂' : ℤ) (u u' : ℝ) : ℂ :=
-  ∫ tau : ℝ, (gmCubicLocalBump tau : ℂ) *
-    Complex.exp ((gmAffineMiddleTauPhase A m₂ m₂' u u' tau : ℂ) * I)
