-/-- The Type-I branch count on actual zeta zero representatives. -/
-theorem two_term_typeI_zero_slab_count {σ a p α ε : ℝ}
-    (hw : TwoTermWindow σ a p α) (hε : 0 < ε) :
-    ∃ C : ℝ, 0 < C ∧ ∀ᶠ H : ℝ in atTop, ∀ R : Finset ℂ,
