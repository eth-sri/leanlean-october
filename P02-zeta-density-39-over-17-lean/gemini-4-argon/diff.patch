-    (f : ℝ → ℝ) (M₁ M₂ M₃ : ℕ) (u : ℝ) : ℝ :=
-  ∑ m₁ ∈ gmAffineSignedShell M₁,
-    ∑ m₂ ∈ gmAffinePositiveShell M₂,
-      ∑ m₃ ∈ gmAffineSmoothCentralShell M₃,
