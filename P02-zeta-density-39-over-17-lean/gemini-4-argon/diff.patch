-/-- Positive magnitude of the (negative) real-index curvature. -/
-def atkinsonIndexCurvatureMagnitude (T x : ℝ) : ℝ :=
-  Real.pi * T /
-    (x ^ (2 : ℕ) * atkinsonIndexRealSlope T x)
