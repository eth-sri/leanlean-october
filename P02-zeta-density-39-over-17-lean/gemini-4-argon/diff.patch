-theorem refined_power_buffer_eventually :
-    ∀ᶠ T : ℝ in atTop, ∀ a : ℝ, 8/11 ≤ a → a ≤ 4/5 →
-      T*(Real.log T)^4 ≤ T^(3*a/2) ∧
