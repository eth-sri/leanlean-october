-        (M : ℝ) ^ 4 * (16 * ∫ x : ℝ, f x ^ 2) := by
-      exact add_le_add
-        (mul_le_mul hM6 hmassSq (sq_nonneg _) (by positivity))
-        (mul_le_mul hM4 hL2 htildeL2 (by positivity))
-    _ = _ := by ring
