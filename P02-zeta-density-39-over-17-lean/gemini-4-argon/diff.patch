-theorem card_gmAffinePositiveShell (M : ℕ) :
-    (gmAffinePositiveShell M).card = M + 1 := by
-  rw [gmAffinePositiveShell, Int.card_Icc]
-  have hcast : (((2 * (M : ℤ) + 1 - (M : ℤ)).toNat : ℕ) : ℤ) =
-      2 * (M : ℤ) + 1 - (M : ℤ) := Int.toNat_of_nonneg (by omega)
-  omega
