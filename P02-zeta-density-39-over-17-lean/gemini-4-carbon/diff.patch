-      60 * (((2 * (P + 1) : ℕ) : ℝ) ^ sigma / (M : ℝ) ^ sigma) *
-        Real.sqrt (X * ((P + 1 : ℕ) : ℝ) * t ^ (1 / 3 : ℝ)) := by
-  let Y : ℝ := t ^ (1 / 3 : ℝ)
-  let L : ℕ := min P (M - P)
-  let f : ℕ → ℝ := fun i =>
-    ((P + 1 + i : ℕ) : ℝ) ^ sigma / (M : ℝ) ^ sigma
-  let g : ℕ → ℂ := fun i =>
-    unitaryPhase (logarithmicPhase t (P + 1 + i))
