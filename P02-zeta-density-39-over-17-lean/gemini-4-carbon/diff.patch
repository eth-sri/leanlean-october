-        _ = 4 * A ^ 4 := by ring
-        _ <= 4 * (u ^ 2 * v ^ 2) := by linarith
-    have hmul := mul_le_mul_of_nonneg_left hcore (mul_pos ht hr).le
-    nlinarith
