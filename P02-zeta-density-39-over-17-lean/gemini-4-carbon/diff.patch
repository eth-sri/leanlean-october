-
-/-- The sharp finite partial-zeta sum through `A`. -/
-noncomputable def classicalZetaPartialSum (A : ℕ) (s : ℂ) : ℂ :=
-  ∑ n ∈ Icc 1 A, (n : ℂ) ^ (-s)
