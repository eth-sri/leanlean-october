-      (4 * S / Q ^ n) * Z +
-          2 * ((8 * M₃ : ℝ) * S / Q ^ (n + 2)) ≤
-        (4 * S / Q ^ n) * Z +
-          2 * ((8 * M₃ : ℝ) * S / Q ^ n) := by gcongr
-      _ ≤ ((M₃ : ℝ) * (4 * S * Z + 16 * S)) / Q ^ n := by
-        rw [div_eq_mul_inv, div_eq_mul_inv, div_eq_mul_inv]
