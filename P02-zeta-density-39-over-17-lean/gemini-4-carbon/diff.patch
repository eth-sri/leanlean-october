-/-- Detector-strength sharp truncation on a positive dyadic zero slab. The
-cutoff is O(T), while the partial zeta sum is O(a⁻ᴿᵉ⁽ρ⁾) with the explicit
-absolute constant 149. -/
-theorem norm_zeta_zero_sharp_cutoff_sum_le {σ T : ℝ} {ρ : ℂ} (hT : 3 / 4 ≤ T)
-    (hρmem : ρ ∈ zerosInRect σ 1 T (2 * T)) (hσ : 0 < σ) :
-    ‖∑ n ∈ Finset.Icc 1 ⌊sharpZetaCutoff T⌋₊, (n : ℂ) ^ (-ρ)‖ ≤
-      149 * sharpZetaCutoff T ^ (-ρ.re) := by
-  have hρ := hρmem
-  rw [zerosInRect, Set.Finite.mem_toFinset, Set.mem_inter_iff] at hρ
-  rcases hρ with ⟨hRect, hZero⟩
-  rw [mem_ZeroRectangle] at hRect
-  have hTpos : 0 < T := by linarith
-  have hρrePos : 0 < ρ.re := hσ.trans_le hRect.1
-  have hρreOne : ρ.re ≤ 1 := hRect.2.1
-  have hρimPos : 0 < ρ.im := hTpos.trans_le hRect.2.2.1
-  have hAdmissible := sharpZetaCutoff_admissible_of_mem hT hρmem
-  rcases hAdmissible with ⟨hCutPos, hCutHalf, hCutIm⟩
-  have hMain := norm_zeta_zero_sharp_sum_le hρrePos hρimPos.ne' hZero
-    hCutPos hCutHalf hCutIm
-  have hCutUpper := sharpZetaCutoff_le_six_mul hT
-  have hDen : T ≤ ‖(1 : ℂ) - ρ‖ := by
-    calc
-      T ≤ ρ.im := hRect.2.2.1
-      _ = |ρ.im| := (abs_of_pos hρimPos).symm
-      _ = |((1 : ℂ) - ρ).im| := by simp
-      _ ≤ ‖(1 : ℂ) - ρ‖ := abs_im_le_norm _
-  have hDenPos : 0 < ‖(1 : ℂ) - ρ‖ := hTpos.trans_le hDen
-  have hCutRatio : sharpZetaCutoff T / ‖(1 : ℂ) - ρ‖ ≤ 6 := by
-    rw [div_le_iff₀ hDenPos]
-    nlinarith
-  have hPowSplit :
-      sharpZetaCutoff T ^ (1 - ρ.re) =
-        sharpZetaCutoff T * sharpZetaCutoff T ^ (-ρ.re) := by
-    rw [show 1 - ρ.re = 1 + (-ρ.re) by ring,
-      Real.rpow_add hCutPos, Real.rpow_one]
-  have hPole : ‖(sharpZetaCutoff T ^ (1 - ρ) : ℂ) / (1 - ρ)‖ ≤
-      6 * sharpZetaCutoff T ^ (-ρ.re) := by
-    rw [norm_div, norm_cpow_eq_rpow_re_of_pos hCutPos]
-    simp only [one_re, sub_re]
-    rw [hPowSplit]
-    calc
-      sharpZetaCutoff T * sharpZetaCutoff T ^ (-ρ.re) /
-          ‖(1 : ℂ) - ρ‖ =
-          (sharpZetaCutoff T / ‖(1 : ℂ) - ρ‖) *
-            sharpZetaCutoff T ^ (-ρ.re) := by ring
-      _ ≤ 6 * sharpZetaCutoff T ^ (-ρ.re) :=
-        mul_le_mul_of_nonneg_right hCutRatio (Real.rpow_nonneg hCutPos.le _)
-  have hBoundary :
-      ‖sharpZetaBoundaryCoeff ρ (sharpZetaCutoff T) *
-          (sharpZetaCutoff T ^ (-ρ) : ℂ)‖ ≤
-        14 * sharpZetaCutoff T ^ (-ρ.re) := by
-    rw [norm_mul, norm_cpow_eq_rpow_re_of_pos hCutPos]
-    simp only [neg_re]
-    exact mul_le_mul_of_nonneg_right
-      (sharpZetaBoundaryCoeff_le_fourteen hT hρmem)
-      (Real.rpow_nonneg hCutPos.le _)
-  have hCutOne : 1 ≤ sharpZetaCutoff T := by
-    linarith [four_mul_lt_sharpZetaCutoff T]
-  have hError :
-      sharpZetaErrorCoeff ρ (sharpZetaCutoff T) /
-          sharpZetaCutoff T ^ (ρ.re + 1) ≤
-        129 * sharpZetaCutoff T ^ (-ρ.re) := by
-    calc
-      _ ≤ 129 / sharpZetaCutoff T ^ (ρ.re + 1) := by
-        gcongr
-        exact sharpZetaErrorCoeff_le_129 hT hρmem hρrePos.le hρreOne
-      _ = 129 * sharpZetaCutoff T ^ (-(ρ.re + 1)) := by
-        rw [div_eq_mul_inv, ← Real.rpow_neg hCutPos.le]
-      _ ≤ 129 * sharpZetaCutoff T ^ (-ρ.re) := by
-        gcongr
-        linarith
-  calc
-    ‖∑ n ∈ Finset.Icc 1 ⌊sharpZetaCutoff T⌋₊, (n : ℂ) ^ (-ρ)‖ ≤
-        ‖(sharpZetaCutoff T ^ (1 - ρ) : ℂ) / (1 - ρ)‖ +
-          ‖sharpZetaBoundaryCoeff ρ (sharpZetaCutoff T) *
-            (sharpZetaCutoff T ^ (-ρ) : ℂ)‖ +
-            sharpZetaErrorCoeff ρ (sharpZetaCutoff T) /
-              sharpZetaCutoff T ^ (ρ.re + 1) := hMain
-    _ ≤ 6 * sharpZetaCutoff T ^ (-ρ.re) +
-          14 * sharpZetaCutoff T ^ (-ρ.re) +
-            129 * sharpZetaCutoff T ^ (-ρ.re) := by gcongr
-    _ = 149 * sharpZetaCutoff T ^ (-ρ.re) := by ring
