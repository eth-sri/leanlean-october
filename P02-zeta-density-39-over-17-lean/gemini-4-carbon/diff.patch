+private theorem ingham_contour_identity {σ₀ : ℝ} (hσ₀ : 1/2 < σ₀) {ρ : ℂ} {X Y : ℝ}
+    (hY : 1 ≤ Y) (hβ : σ₀ ≤ ρ.re) (hβ' : ρ.re < 1) (hZero : riemannZeta ρ = 0) :
