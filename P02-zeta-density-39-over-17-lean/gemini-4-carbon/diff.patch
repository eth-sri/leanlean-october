-          2 * (Real.sqrt (t * (k - h : Nat) / (8 * A ^ 3)) /
-            (t * (k - h : Nat) / (8 * A ^ 3)) + 1)) := by
-  let lambda : Real := t * (k - h : Nat) / (8 * A ^ 3)
-  let Lambda : Real := 4 * t * (k - h : Nat) / A ^ 3
-  have hr : 0 < ((k - h : Nat) : Real) := by exact_mod_cast Nat.sub_pos_of_lt hhk
-  have hlambda : 0 < lambda := by
-    dsimp only [lambda]
-    positivity
