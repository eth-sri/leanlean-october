-theorem gmAffineSmoothTransformSchwartz_fourier
-    (f : SchwartzMap ℝ ℝ) {M₁ M₂ M₃ : ℕ}
-    (hM₁ : 0 < M₁) (hM₂ : 0 < M₂) (ξ : ℝ) :
-    𝓕 (gmAffineSmoothTransformSchwartz f M₁ M₂ M₃) ξ =
