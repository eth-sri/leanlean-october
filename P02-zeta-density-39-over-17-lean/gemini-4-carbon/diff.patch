-  let Q : ℕ := 2 ^ r * Y
-  let R : ℝ := (Real.pi * V) /
-    (8 * (Q : ℝ) * K * (typeIDyadicCutoffMellinL1 + 1))
-  let S : ℝ := R / (2 * (M : ℝ) ^ σ)
