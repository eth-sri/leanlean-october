-      (⌈2 * T / (M₂ : ℝ)⌉₊ : ℝ) := Nat.le_ceil _
-  have hB : 2 * T / (M₂ : ℝ) < (B : ℝ) := by
-    dsimp only [B]
-    push_cast
-    linarith
-  have hell' : ell < -(B : ℤ) ∨ (B : ℤ) < ell := by
-    simpa only [gmAffineMiddleFrequencySupport, B, Finset.mem_Icc,
-      not_and_or, not_le] using hell
