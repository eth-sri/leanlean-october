-  have hMass : 0 ≤ typeIDyadicCutoffMellinL1 :=
-    typeIDyadicCutoffMellinL1_nonneg
-  have hDen : 0 < 8 * (Q : ℝ) * K *
-      (typeIDyadicCutoffMellinL1 + 1) := by positivity
