-  have hsumHigh : u + v <= 4 * A := by linarith
-  have huSqLow : A ^ 2 <= u ^ 2 := by nlinarith
-  have hvSqLow : A ^ 2 <= v ^ 2 := by nlinarith
-  have huSqHigh : u ^ 2 <= (2 * A) ^ 2 := by nlinarith
-  have hvSqHigh : v ^ 2 <= (2 * A) ^ 2 := by nlinarith
