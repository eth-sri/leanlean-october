-theorem gmAffineSecondPoissonCutoff_div_scale_le
-    {T Q : ℝ} (hT : 1 ≤ T) (hQ : 0 < Q)
-    {M₂ M₃ : ℕ} (hM₂ : 0 < M₂) (hM₃ : 0 < M₃) :
