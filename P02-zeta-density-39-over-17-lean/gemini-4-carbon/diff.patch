-    rw [← Real.rpow_add hTPos]
-    congr 1
-    ring
-  have hNumerator :
-      (Nat.clog 2 A + 1 : ℕ) *
-          (3 * (100 * Real.sqrt 3 + 288 * Real.pi) * 2 ^ σ *
