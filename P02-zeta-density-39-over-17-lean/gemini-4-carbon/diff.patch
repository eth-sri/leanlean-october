-/-!
-# Norm estimates for complex analysis
-
-Elementary norm estimates used in Cartan-style product bounds and Gamma/zeta growth arguments.
--/
-
-public section
-
-noncomputable section
-
-namespace Complex
-
-variable {z : ℂ}
-
-@[bound]
-theorem neg_norm_le_re (z : ℂ) : -‖z‖ ≤ z.re :=
