-      have hden : 0 < 1000 * (1 + τ₀) := by positivity
-      have hsmall : d ≤ 1 / 1000 := by
-        calc
-          d ≤ 1 / (1000 * (1 + τ₀)) := hdSmall
-          _ ≤ 1 / 1000 := by
-            apply one_div_le_one_div_of_le (by norm_num)
-            nlinarith
