-        (2 * (1 + (Real.log 6 + Real.log T) / Real.log 2)) *
-          (3 * (100 * Real.sqrt 3 + 288 * Real.pi) * 2 ^ σ *
-            T ^ (1 / 2 - σ)) := by gcongr
