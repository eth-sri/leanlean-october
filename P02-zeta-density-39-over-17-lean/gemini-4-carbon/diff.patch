-      (8 * ((2 ^ r * Y : ℕ) : ℝ) * K *
-        (typeIDyadicCutoffMellinL1 + 1))) :
-    let R := (Real.pi * V) /
-      (8 * ((2 ^ r * Y : ℕ) : ℝ) * K *
-        (typeIDyadicCutoffMellinL1 + 1))
-    let S := R / (2 * (M : ℝ) ^ σ)
