-    (Y A : ℕ) (σ t : ℝ) (hY : 1 ≤ Y) :
-    classicalZetaLongTail Y A ((σ : ℂ) + I * (t : ℂ)) =
-      wideDirichletPoly Y (Nat.clog 2 A)
