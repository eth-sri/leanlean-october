-    have hConstScaled : Real.log (500 / 3 : ℝ) *
-        (Real.log (35 / 32 : ℝ))⁻¹ ≤
-        (Real.log (500 / 3 : ℝ) * (Real.log (35 / 32 : ℝ))⁻¹) * T ^ η := by
