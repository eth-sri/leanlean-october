-    {σ T : ℝ} {ρ : ℂ} (hσ : 0 ≤ σ) (hT : 1 ≤ T)
-    (hρ : ρ ∈ zerosInRect σ 1 T (2 * T)) :
-    149 * sharpZetaCutoff T ^ (-ρ.re) ≤ 149 * (4 * T) ^ (-σ) := by
-  have hRect := hρ
