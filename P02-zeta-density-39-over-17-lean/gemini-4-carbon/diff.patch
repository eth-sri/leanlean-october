-/-- Explicit normalization loss for an actual powered Type-II block. -/
-noncomputable def typeIIPoweredThresholdLoss
-    (C L D η σ : ℝ) (N k : ℕ) : ℝ :=
-  max 1
-    (((((2 ^ k * N ^ k : ℕ) : ℝ) ^ σ) * D ^ k *
-        (C * (((2 ^ k * N ^ k : ℕ) : ℝ) ^ η)) * k) / L ^ k)
