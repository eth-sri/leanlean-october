-      (Nat.clog 2 A + 1 : ℕ) := by positivity
-  obtain ⟨j, hj, W', _hWsub, _hSep', _hCard, _hLarge', _hPUpper, hQFourP⟩ :=
-    extract_normalized_source_dyadic_block W hY hAOne hV hW hSep hLarge
