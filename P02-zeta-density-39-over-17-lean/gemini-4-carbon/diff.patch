-      ‖typeISourceNormalizationScalar σ t (2 ^ r * Y : ℕ) *
-        (((2 ^ r * Y : ℕ) : ℂ) *
-          typeINormalizedFourier σ t 0)‖ ≤ V / 8)
-    (hFar :
-      ‖typeISourceNormalizationScalar σ t (2 ^ r * Y : ℕ) *
-        typeINormalizedFarTail σ t (2 ^ r * Y) M‖ ≤ V / 8)
-    (hKernelNeg : ∀ u ∈ Set.Icc (-H) H,
-      ‖typeIPowerReflectionIntegral σ (t + u)
-        (((2 ^ r * Y : ℕ) : ℝ) / 2)
-        (2 * M * (2 ^ r * Y : ℕ))‖ ≤ K)
-    (hKernelPos : ∀ u ∈ Set.Icc (-H) H,
-      ‖typeIPowerReflectionIntegral σ (-t + u)
-        (((2 ^ r * Y : ℕ) : ℝ) / 2)
-        (2 * M * (2 ^ r * Y : ℕ))‖ ≤ K)
