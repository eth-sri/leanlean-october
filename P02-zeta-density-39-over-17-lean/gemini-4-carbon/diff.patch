-theorem gmAffineTranslationPhaseSum_eq_tsum
-    {M : ℕ} (hM : 0 < M) (m₁ : ℤ) (ξ : ℝ) :
-    gmAffineTranslationPhaseSum M m₁ ξ =
-      ∑' m₃ : ℤ, (gmAffineCentralWeight M m₃ : ℂ) *
-        Complex.exp ((((2 * Real.pi * (m₃ : ℝ) *
-          (ξ / (m₁ : ℝ)) : ℝ) : ℂ) * I)) := by
-  unfold gmAffineTranslationPhaseSum
