-      ‖∫ u : ℝ in (Set.Icc (-H) H)ᶜ,
-        typeIReflectedMellinPolynomial σ t
-            ((2 ^ r * Y : ℕ) : ℝ) M u *
-          typeIDyadicCutoffMellin u *
-            typeIPowerReflectionIntegral σ (t + u)
-              (((2 ^ r * Y : ℕ) : ℝ) / 2)
