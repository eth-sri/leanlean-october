-  let S := Finset.Icc 1 M
-  let A : ℝ := Q / 2
-  let B : ℝ := 2 * M * Q
-  have hA : 0 < A := by dsimp only [A]; positivity
-  have hAB : A ≤ B := by
-    dsimp only [A, B]
