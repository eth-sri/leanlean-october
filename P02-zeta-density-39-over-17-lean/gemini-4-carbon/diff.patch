-  ∫ r : ℝ, ‖typeIDyadicCutoffMellin r‖
-
-theorem typeIDyadicCutoffMellinL1_nonneg :
-    0 ≤ typeIDyadicCutoffMellinL1 := by
-  unfold typeIDyadicCutoffMellinL1
-  exact integral_nonneg fun _ => norm_nonneg _
