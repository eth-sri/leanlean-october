-      (((2 * (P + 1) : ℕ) : ℝ) ^ sigma / (M : ℝ) ^ sigma) ≤
-        4 ^ sigma := by
-    have hPMCast : (((2 * (P + 1) : ℕ) : ℝ)) ≤ 4 * (M : ℝ) := by
-      exact_mod_cast (show 2 * (P + 1) ≤ 4 * M by omega)
