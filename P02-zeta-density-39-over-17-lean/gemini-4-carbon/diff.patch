-    have hM₂real : (0 : ℝ) < M₂ := by positivity
-    have := mul_lt_mul_of_pos_left (lt_trans hB hellAbs) hM₂real
-    calc
-      2 * T = (M₂ : ℝ) * (2 * T / (M₂ : ℝ)) := by field_simp
-      _ < (M₂ : ℝ) * |(ell : ℝ)| := this
