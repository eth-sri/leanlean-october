-    sharpMollifiedLineCoeff A X σ n * (n : ℂ) ^ (-(t : ℂ) * I) =
-      sharpMollifiedCoeff A X n *
-        (n : ℂ) ^ (-((σ : ℂ) + I * (t : ℂ))) := by
