-      S < ‖wideDirichletPoly 1 (Nat.clog 2 M)
-        (normalizedTypeIReflectedCoeff σ M) (-(t + u))‖) ∨
-    (∃ u ∈ Set.Icc (-H) H,
-      S < ‖wideDirichletPoly 1 (Nat.clog 2 M)
-        (normalizedTypeIReflectedCoeff σ M) (t - u)‖) := by
