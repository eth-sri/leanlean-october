-/-- Natural-number cap for the Jensen unit-bin multiplicity estimate. -/
-noncomputable def classicalLocalMultiplicityCap (T : ℝ) : ℕ :=
-  ⌈Real.log ((100 * T ^ (3 : ℝ)) / (0.6 : ℝ)) /
-      Real.log ((7 / 4 : ℝ) / (8 / 5 : ℝ))⌉₊
