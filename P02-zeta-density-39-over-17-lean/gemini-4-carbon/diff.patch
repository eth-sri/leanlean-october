-  rw [hInterval, Finset.sum_Ico_eq_sum_range]
-  have hLength : 2 * P + 1 - (P + 1) = P := by omega
-  rw [hLength]
-  push_cast
-  symm
-  calc
-    ∑ i ∈ Finset.range (min P (M - P)),
-        (((P : ℝ) + 1 + (i : ℝ)) ^ sigma / (M : ℝ) ^ sigma) •
-          unitaryPhase (logarithmicPhase t (P + 1 + i)) =
-      ∑ i ∈ Finset.range (min P (M - P)),
