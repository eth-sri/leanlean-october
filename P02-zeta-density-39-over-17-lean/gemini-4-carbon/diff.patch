-/-- Fixed-line coefficients of the ordinary Type-I tail, extended by zero
-beyond the sharp upper cutoff. -/
-noncomputable def classicalZetaLongLineCoeff
-    (A : ℕ) (σ : ℝ) (n : ℕ) : ℂ :=
-  if n ≤ A then (n : ℂ) ^ (-(σ : ℂ)) else 0
