-    {sigma tau A B : ℝ} (hsigma : 0 ≤ sigma)
-    (hA : 0 < A) (hAB : A ≤ B) :
-    ‖typeIPowerReflectionIntegral sigma tau A B‖ ≤
-      (B - A) * (A ^ (-sigma) / A) := by
