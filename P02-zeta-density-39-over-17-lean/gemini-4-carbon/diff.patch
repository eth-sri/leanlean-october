-    t * r / (8 * A ^ 3) <= t / u ^ 2 - t / v ^ 2 ∧
-      t / u ^ 2 - t / v ^ 2 <= 4 * t * r / A ^ 3 := by
-  have hu : 0 < u := hA.trans_le huLow
-  have hv : 0 < v := hu.trans_le huv
-  have hformula : t / u ^ 2 - t / v ^ 2 =
-      t * r * (u + v) / (u ^ 2 * v ^ 2) := by
-    field_simp [hu.ne', hv.ne']
-    nlinarith
-  have huHigh : u <= 2 * A := huv.trans hvHigh
