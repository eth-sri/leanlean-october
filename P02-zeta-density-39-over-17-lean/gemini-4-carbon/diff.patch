-  apply Finset.sum_congr rfl
-  intro m₂ hm₂
-  apply Finset.sum_congr rfl
-  intro m₃ hm₃
-  rw [gmAffineTermSchwartzTotal_fourier_of_ne (gmAffineComplexify f) m₃
