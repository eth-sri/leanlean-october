-          (2 * (Q : ℝ) ^ classicalMHHExponent σ
-            (typeILogarithmicScale T Q)) := by gcongr
-    _ ≤ P ^ (6 : ℕ) * (2 * T ^ (3 * (1 - σ) / τ₀)) := by gcongr
-    _ = 2 * P ^ (6 : ℕ) * T ^ (3 * (1 - σ) / τ₀) := by ring
