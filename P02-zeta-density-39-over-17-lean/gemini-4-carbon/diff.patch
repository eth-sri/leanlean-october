-/-- The ordinary-zeta tail strictly above `Y` and through `A`. -/
-noncomputable def classicalZetaLongTail (Y A : ℕ) (s : ℂ) : ℂ :=
-  ∑ n ∈ Ioc Y A, (n : ℂ) ^ (-s)
-
