-          (normalizedTypeIReflectedCoeff sigma M) (-(t + u))‖) ∨
-    (∃ W' : Finset ℝ, W' ⊆ W ∧ W.card ≤ 2 * W'.card ∧
-      ∀ t ∈ W', ∃ u ∈ Set.Icc (-H) H,
-        S < ‖wideDirichletPoly 1 (Nat.clog 2 M)
-          (normalizedTypeIReflectedCoeff sigma M) (t - u)‖) := by
-  classical
-  let isNegative : ℝ → Prop := fun t =>
