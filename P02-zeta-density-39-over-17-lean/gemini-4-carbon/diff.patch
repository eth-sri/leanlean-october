-/-- Coefficients normalized to unit size on one chosen dyadic block. -/
-noncomputable def normalizedSharpMollifiedLineCoeff
-    (A X N : ℕ) (σ ε C : ℝ) (n : ℕ) : ℂ :=
-  sharpMollifiedLineCoeff A X σ n /
-    ((C * (2 * N : ℝ) ^ ε * (N : ℝ) ^ (-σ) : ℝ) : ℂ)
