-        unitaryPhase_logarithmicPhase_eq_cpow t (P + 1 + i) hnPos
-      norm_num only [Nat.cast_add, Nat.cast_one] at hPhase
-      rw [hPhase]
-    _ = ∑ i ∈ Finset.range P,
-        normalizedTypeIReflectedCoeff sigma M (P + 1 + i) *
-          ((P : ℂ) + 1 + (i : ℂ)) ^ (-t * I) := by
