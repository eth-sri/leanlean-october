-      (∫ s : ℝ,
-          (gmAffineMiddleTauWeight Q (Q * s) : ℂ) *
-            ((‖gmAffineMiddleFourierBlockReal f A M₂ ell (Q * s)‖ ^ 2 : ℝ) : ℂ)) =
-        ((Q⁻¹ : ℝ) : ℂ) * ∫ tau : ℝ,
-          (gmAffineMiddleTauWeight Q tau : ℂ) *
-            ((‖gmAffineMiddleFourierBlockReal f A M₂ ell tau‖ ^ 2 : ℝ) : ℂ) := by
-    change (∫ s : ℝ,
-        (gmAffineMiddleTauWeight Q (Q * s) : ℂ) *
-          ((‖gmAffineMiddleFourierBlockReal f A M₂ ell (Q * s)‖ ^ 2 : ℝ) : ℂ)) =
