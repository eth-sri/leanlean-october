-    apply hMultRaw.le.trans
-    dsimp [cMult]
-    rw [div_eq_mul_inv, div_eq_mul_inv]
-    have hInvRatio : 0 ≤ (Real.log (35 / 32 : ℝ))⁻¹ := inv_nonneg.mpr hlogRatio.le
-    have hLogScaled : 3 * Real.log T * (Real.log (35 / 32 : ℝ))⁻¹ ≤
