-    (hLower : (((Y + 1 : ℕ) : ℝ)) ≤ (((2 ^ r * Y : ℕ) : ℝ) / 2))
-    (hUpper : (2 * (2 ^ r * Y : ℕ) : ℕ) ≤ A)
-    (hσ : 0 ≤ σ) (hM : 1 < M)
-    (hV : 0 < V) (hH : 0 ≤ H) (hK : 0 < K)
-    (hLarge : V ≤ ‖typeISourceSmoothBlock Y A r σ t‖)
