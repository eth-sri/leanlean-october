-theorem eventually_classical_short_product_le_quarter
-    (δ₂ : ℝ) (hδ₂ : 0 < δ₂) :
-    ∃ T₀ : ℝ, 1 ≤ T₀ ∧ ∀ T ≥ T₀,
-      T ^ (-δ₂) * (⌊T ^ (δ₂ / 2)⌋₊ : ℝ) ≤ 1 / 4 := by
-  have hTendsto : Tendsto (fun T : ℝ => T ^ (-(δ₂ / 2))) atTop (𝓝 0) :=
