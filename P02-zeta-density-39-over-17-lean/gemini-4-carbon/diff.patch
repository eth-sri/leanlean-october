-/-- The second-Poisson cutoff covers both the ambient Fourier scale and
-the full translated first-Poisson window. -/
-noncomputable def gmAffineSecondPoissonCutoff
-    (T Q : ℝ) (M₂ M₃ : ℕ) : ℝ :=
-  T * Q + 4 * Q * (M₂ : ℝ) / (8 * M₃ : ℝ)
