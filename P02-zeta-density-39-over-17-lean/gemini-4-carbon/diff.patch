-  have hQuarter : T / 4 ≤ t / 2 := by linarith
-  have hExp : -sigma - 1 / 2 ≤ 0 := by linarith
-  have hPow := Real.rpow_le_rpow_of_nonpos (by positivity : 0 < T / 4)
-    hQuarter hExp
