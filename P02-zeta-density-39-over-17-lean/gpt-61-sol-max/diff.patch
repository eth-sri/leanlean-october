-  have hcoeff : |(m₂ : ℝ) / (m₁ : ℝ)| =
-      (1 / |(m₁ : ℝ)|) * (m₂ : ℝ) := by
-    rw [abs_div, abs_of_nonneg hm₂nonnegR]
-    field_simp [abs_ne_zero.mpr hm₁neR]
-  have harg : ((m₂ : ℝ) / (m₁ : ℝ)) * xi =
-      ((-ell : ℤ) : ℝ) * (m₂ : ℝ) +
-        ((m₂ : ℝ) / (8 * M₃ : ℕ)) *
-          ((8 * M₃ : ℝ) * (xi / (m₁ : ℝ) + (ell : ℝ))) := by
-    push_cast
-    field_simp [hm₁neR, hdenom]
-    ring
-  rw [hcoeff, harg]
-  push_cast
-  ring
