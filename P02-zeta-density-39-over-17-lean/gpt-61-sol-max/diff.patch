-  have hM₁r : (0 : ℝ) < M₁ := by exact_mod_cast hM₁
-  have hM₃r : (1 : ℝ) ≤ M₃ := by exact_mod_cast hM₃
-  have hsignedNat := card_gmAffineSignedShell_le M₁
