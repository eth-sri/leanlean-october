-    (f : SchwartzMap ℝ ℝ) (A : ℝ) (M₂ : ℕ) (ell : ℤ) (tau : ℝ) : ℂ :=
-  ∑ m₂ ∈ gmAffinePositiveShell M₂,
-    (m₂ : ℂ) * fourier (gmAffineComplexify f)
-      ((ell : ℝ) * (m₂ : ℝ) + ((m₂ : ℝ) / A) * tau)
