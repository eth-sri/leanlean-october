-theorem gmAffineTermSchwartzTotal_apply_of_ne
-    (f : SchwartzMap ℝ ℂ) {m₁ m₂ : ℤ} (m₃ : ℤ) (hm₁ : m₁ ≠ 0) (hm₂ : m₂ ≠ 0)
-    (u : ℝ) :
-    gmAffineTermSchwartzTotal f m₁ m₂ m₃ u =
-      f (((m₁ : ℝ) * u + (m₃ : ℝ)) / (m₂ : ℝ)) := by
-  rw [gmAffineTermSchwartzTotal, dite_eq_right hm₁, dite_eq_right hm₂]
