-    Real.sqrt (gmAffineJ
-      (gmAffineTildeSchwartz
-        (gmAffineSecondPoissonCutoff T Q M₂ M₃ / Q)
-        (by unfold gmAffineSecondPoissonCutoff; positivity) f) M₂)
-  have hH : 0 ≤ H := by dsimp only [H]; positivity
