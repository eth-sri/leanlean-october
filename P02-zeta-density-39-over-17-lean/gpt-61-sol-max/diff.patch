-/-- Fixed constant for the complete Region-I Poisson envelope. -/
-noncomputable def gmAffineRegionIConstant (n : ℕ) : ℝ :=
-  672 * SchwartzMap.seminorm ℝ 0 0 gmAffineLocalBumpDual +
