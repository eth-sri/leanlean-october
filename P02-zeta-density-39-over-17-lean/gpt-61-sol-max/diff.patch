-      have hpoint := hbound.pointwise hxi
-      have hxiabs : |xi| ≠ 0 := (abs_pos.mpr hxi).ne'
-      apply hpoint.trans_eq
-      dsimp only [C, S0, mass]
-      rw [div_pow, pow_add]
-      field_simp [hS0, hxiabs]
-      simpa only [S0, mass] using
-        (mul_div_cancel_right₀ (D * mass) hS0).symm
