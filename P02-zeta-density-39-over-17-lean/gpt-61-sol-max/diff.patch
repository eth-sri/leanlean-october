-      apply integral_congr_ae
-      filter_upwards with u'
-      apply integral_congr_ae
-      filter_upwards with u
-      dsimp only [A, B]
-      calc
-        Complex.exp ((((2 * Real.pi * u' * xi') : ℝ) : ℂ) * I) * (f u' : ℂ) *
-            (((m₂' * m₂ : ℤ) : ℂ) *
-              (Complex.exp (((-(2 * Real.pi * u * xi) : ℝ) : ℂ) * I) * (f u : ℂ))) =
