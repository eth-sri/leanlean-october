-    {T eta : ℝ} (hT : 0 ≤ T) (n : ℕ) :
-    (T ^ eta) ^ n = T ^ (eta * n) := by
-  simpa only [Nat.cast_ofNat] using
-    (Real.rpow_mul_natCast hT eta n).symm
