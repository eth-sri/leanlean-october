-        (gmAffinePoissonNearSet M₃ (xi / (m₁ : ℝ)) Q).image
-          fun ell => (m₁, ell)) := by
-    intro a ha b hb hab
-    change Disjoint
-      ((gmAffinePoissonNearSet M₃ (xi / (a : ℝ)) Q).image
-        fun ell => (a, ell))
-      ((gmAffinePoissonNearSet M₃ (xi / (b : ℝ)) Q).image
