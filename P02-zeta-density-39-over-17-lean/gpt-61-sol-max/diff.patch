-    {epsilon T D : ℝ} {n : ℕ} {f : SchwartzMap ℝ ℝ}
-    (hbound : GMAffineHeightFourierMassBound epsilon T n D f)
-    {xi : ℝ} (hxi : xi ≠ 0) :
-    ‖fourier (gmAffineComplexify f) xi‖ ≤
-      (D * T ^ epsilon * T ^ (n + 2) * ∫ x : ℝ, f x) /
-        |xi| ^ n := by
