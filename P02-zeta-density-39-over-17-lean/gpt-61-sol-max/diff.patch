-    (M₂ : ℝ) * |(ell : ℝ)| / 2 = (M₂ : ℝ) * (|(ell : ℝ)| / 2) := by ring
-    _ ≤ |(m₂ : ℝ)| * |(ell : ℝ) + tau / A| := by gcongr
-    _ = |(ell : ℝ) * (m₂ : ℝ) + ((m₂ : ℝ) / A) * tau| := by
-      rw [← abs_mul]
-      congr 1
-      field_simp [hA.ne']
