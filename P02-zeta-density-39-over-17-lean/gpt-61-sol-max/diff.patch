-/-- The Schwartz-space realization of the smooth finite majorant `g`. -/
-noncomputable def gmAffineSmoothTransformSchwartz
-    (f : SchwartzMap ℝ ℝ) (M₁ M₂ M₃ : ℕ) : SchwartzMap ℝ ℂ :=
