-    {A : Type*} [AddCommMonoid A]
-    (M₁ M₃ : ℕ) (Q xi : ℝ) (F : ℤ × ℤ → A) :
-    ∑ p ∈ gmAffineFirstPoissonPairs M₁ M₃ Q xi, F p =
-      ∑ m₁ ∈ gmAffineSignedShell M₁,
