-    n f hf hQ hY.le hM₁ hM₂ hM₂M hM₃ hM₃M
-  unfold gmAffineRegionIITailRawBound gmAffineRegionIITailSourceBound
-  dsimp only
-  change 2 * D * K * (Q * E + P) +
-      4 * Y * (gmAffinePoissonFarEnvelope n f M₁ M₂ M₃ Q) ^ 2 ≤
-    F * (Q * E₀ + P₀) +
-      4 * Y *
-        (gmAffineRegionIFarConstant n * (M : ℝ) ^ 3 *
-          (∫ x : ℝ, f x) / Q ^ n) ^ 2
