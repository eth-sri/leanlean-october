-    (f : SchwartzMap ℝ ℝ) (m₂ m₂' : ℤ) (xi xi' : ℝ) :
-    (starRingEnd ℂ) ((m₂' : ℂ) * fourier (gmAffineComplexify f) xi') *
-        ((m₂ : ℂ) * fourier (gmAffineComplexify f) xi) =
-      ∫ u' : ℝ, ∫ u : ℝ,
-        (((m₂' * m₂ : ℤ) : ℂ) * (f u' : ℂ) * (f u : ℂ)) *
