-    calc
-      2 * D * K * (Q * E + P) ≤ F * (Q * E + P) :=
-        mul_le_mul_of_nonneg_right hpref hinnerNonneg
-      _ ≤ F * (Q * E₀ + P₀) :=
-        mul_le_mul_of_nonneg_left hinner hFNonneg
