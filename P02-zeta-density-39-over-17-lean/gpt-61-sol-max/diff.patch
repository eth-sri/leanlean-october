-@[simp]
-theorem gmAffineCentralWeightSchwartz_apply
-    (M : ℕ) (hM : 0 < M) (x : ℝ) :
-    gmAffineCentralWeightSchwartz M hM x =
-      (gmCubicLocalBump (x / (8 * M : ℝ)) : ℂ) := rfl
