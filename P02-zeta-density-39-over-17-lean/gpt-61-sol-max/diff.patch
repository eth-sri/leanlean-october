-theorem gmAffinePoissonEnvelopes_le_mass
-    (n : ℕ) (f : SchwartzMap ℝ ℝ) (hf : ∀ x, 0 ≤ f x)
-    {M₁ M₂ M₃ : ℕ}
-    (hM₁ : 0 < M₁) (hM₂ : 0 < M₂) (hM₃ : 0 < M₃)
-    {Q : ℝ} (hQ : 1 ≤ Q) :
-    gmAffinePoissonMainEnvelope f M₁ M₂ M₃ Q +
