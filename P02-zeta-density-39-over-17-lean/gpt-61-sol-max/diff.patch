-      _ = 8 * Q * M := by ring
-  change 2 * (Cdiv * A *
-      (2 * gmAffineFirstPoissonRadius M₁ M₃ Q + 3)) *
-      ((32 * M₃ : ℝ) * L ^ 2) ≤
-    512 * Cdiv * A * Q * M * L ^ 2
-  rw [show
-    2 * (Cdiv * A *
-        (2 * gmAffineFirstPoissonRadius M₁ M₃ Q + 3)) *
-        ((32 * M₃ : ℝ) * L ^ 2) =
-      64 * Cdiv * A * L ^ 2 *
-        ((2 * gmAffineFirstPoissonRadius M₁ M₃ Q + 3) * M₃) by ring]
-  calc
-    64 * Cdiv * A * L ^ 2 *
-        ((2 * gmAffineFirstPoissonRadius M₁ M₃ Q + 3) * M₃) ≤
-      64 * Cdiv * A * L ^ 2 * (8 * Q * M) := by gcongr
-    _ = 512 * Cdiv * A * Q * M * L ^ 2 := by ring
