-  unfold gmAffineSecondPoissonCutoff
-  rw [add_div, mul_div_cancel_right₀ T hQ.ne']
-  have hratio : 0 ≤ 4 * Q * (M₂ : ℝ) / (8 * M₃ : ℝ) := by positivity
