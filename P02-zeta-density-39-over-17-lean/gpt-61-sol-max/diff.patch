-/-- The Fourier energy in (9.2) is integrable before any region is
-estimated. -/
-theorem integrable_gmAffineSmoothTransform_fourier_sq
-    (f : SchwartzMap ℝ ℝ) (M₁ M₂ M₃ : ℕ) :
-    Integrable (fun xi : ℝ =>
-      ‖fourier (gmAffineSmoothTransformSchwartz f M₁ M₂ M₃) xi‖ ^ 2) := by
