-  apply Finset.sum_congr rfl
-  intro m₂ hm₂
-  have hm₂posZ : (0 : ℤ) < m₂ := by
-    have hm₂lower := (mem_gmAffinePositiveShell.mp hm₂).1
-    exact lt_of_lt_of_le (by exact_mod_cast hM₂) hm₂lower
