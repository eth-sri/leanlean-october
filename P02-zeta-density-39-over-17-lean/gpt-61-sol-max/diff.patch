-        Q ^ (n + 1) * (M₂ : ℝ) ^ 4 * (∫ u : ℝ, |f u|) ^ 2 := by ring
-    _ ≤ 64 * gmAffineMiddleFarSourceConstant n * T ^ 3 /
-        Q ^ (n + 1) * (M : ℝ) ^ 4 * (∫ u : ℝ, |f u|) ^ 2 := by
