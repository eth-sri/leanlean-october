-  have hM₂r : (M₂ : ℝ) ≤ M := by exact_mod_cast hM₂M
-  have hscale :
-      (2 * gmAffineFirstPoissonRadius M₁ M₃ Q + 3) * (M₃ : ℝ) *
-          (M₂ : ℝ) ≤ 8 * Q * (M : ℝ) ^ 2 := by
-    calc
-      (2 * gmAffineFirstPoissonRadius M₁ M₃ Q + 3) * (M₃ : ℝ) *
-          (M₂ : ℝ) ≤
-        (4 * Q * ((M₁ : ℝ) + M₃)) * (M₂ : ℝ) := by gcongr
-      _ ≤ (4 * Q * (2 * M)) * M := by gcongr
-      _ = 8 * Q * (M : ℝ) ^ 2 := by ring
