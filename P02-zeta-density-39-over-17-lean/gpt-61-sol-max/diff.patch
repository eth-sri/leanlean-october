-        𝓕⁻ gmAffineLocalBumpSchwartz ((8 * M : ℝ) * y) := by
-  have hs : (0 : ℝ) < 8 * M := by positivity
-  rw [gmAffineCentralPoissonKernel, SchwartzMap.fourierInv_coe, Real.fourierInv_eq']
