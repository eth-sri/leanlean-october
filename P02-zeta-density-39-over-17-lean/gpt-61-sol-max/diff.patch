-theorem gmAffineRegionIITailRawBound_le_source
-    {epsilon T Q Y Cdiv Ctail : ℝ}
-    (n : ℕ)
-    (hepsilon : 0 ≤ epsilon)
-    (hT : 1 ≤ T) (hQ : 1 ≤ Q) (hY : 0 < Y)
-    (hCdiv : 0 ≤ Cdiv) (hCtail : 0 ≤ Ctail)
-    (f : SchwartzMap ℝ ℝ) (hf : ∀ x, 0 ≤ f x)
-    {M M₁ M₂ M₃ : ℕ}
-    (hM₁ : 0 < M₁) (hM₁M : M₁ ≤ M)
-    (hM₂ : 0 < M₂) (hM₂M : M₂ ≤ M)
-    (hM₃ : 0 < M₃) (hM₃M : M₃ ≤ M)
