-noncomputable def gmAffineRegionIITailSourceBound
-    (epsilon : ℝ) (n : ℕ) (T Q Y : ℝ) (f : SchwartzMap ℝ ℝ)
-    (M : ℕ) (Cdiv Ctail : ℝ) : ℝ :=
-  (512 * Cdiv *
-      (Y + Y) ^ epsilon * Q * M *
-        SchwartzMap.seminorm ℝ 0 0 gmAffineLocalBumpDual ^ 2) *
-    (Q *
-        (64 * gmAffineMiddleFarSourceConstant n * T ^ 3 /
