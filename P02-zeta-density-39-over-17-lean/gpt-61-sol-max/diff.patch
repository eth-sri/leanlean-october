-  rw [map_mul, conj_fourier_gmAffineComplexify_eq_integral,
-    fourier_gmAffineComplexify_eq_integral]
-  simp only [map_intCast]
-  let A : ℝ → ℂ := fun u' =>
-    Complex.exp ((((2 * Real.pi * u' * xi') : ℝ) : ℂ) * I) * (f u' : ℂ)
-  let B : ℝ → ℂ := fun u =>
-    Complex.exp (((-(2 * Real.pi * u * xi) : ℝ) : ℂ) * I) * (f u : ℂ)
