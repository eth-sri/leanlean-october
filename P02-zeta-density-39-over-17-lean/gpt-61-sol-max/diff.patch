-  have hTpos : 0 < T := zero_lt_one.trans_le hT
-  have hden : ((T ^ eta) ^ n) ^ 2 = T ^ (2 * eta * n) := by
-    rw [pow_rpow_eq_rpow_mul_nat hTpos.le]
-    rw [← Real.rpow_natCast, ← Real.rpow_mul hTpos.le]
-    norm_num
-    ring_nf
-  rw [hden]
-  exact (div_le_one (Real.rpow_pos_of_pos hTpos _)).2
