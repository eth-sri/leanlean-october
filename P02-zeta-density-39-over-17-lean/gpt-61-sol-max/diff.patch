-  have hsecond :
-      (8 * M₃ : ℝ) * S / Q ^ (n + 2) ≤
-        (8 * M₃ : ℝ) * S / Q ^ n :=
-    div_le_div_of_nonneg_left (by positivity) (pow_pos hQpos n) hQpow
