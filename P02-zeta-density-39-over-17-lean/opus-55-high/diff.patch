-noncomputable def abelZetaKernel (x : ℝ) : ℂ :=
-  if 1 < x then ((Int.fract x : ℝ) : ℂ) else 0
-
-theorem abelZetaKernel_eq_of_one_lt {x : ℝ} (hx : 1 < x) :
-    abelZetaKernel x = ((Int.fract x : ℝ) : ℂ) := by
