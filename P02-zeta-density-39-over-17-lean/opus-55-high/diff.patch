-        (T ^ (7 : ℕ)) ^ gmAffineIterationEta delta := hp
-    _ = T ^ (7 * gmAffineIterationEta delta) := by
-      rw [← Real.rpow_natCast, ← Real.rpow_mul hTnonneg]
