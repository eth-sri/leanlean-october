-theorem gmAffineIteration_M_pow_three_le
-    {T : ℝ} {M : ℕ} (hMT : (M : ℝ) ≤ T ^ 4) :
-    (M : ℝ) ^ 3 ≤ T ^ 12 := by
-  calc
-    (M : ℝ) ^ 3 ≤ (T ^ 4) ^ 3 := by gcongr
-    _ = T ^ 12 := by ring
