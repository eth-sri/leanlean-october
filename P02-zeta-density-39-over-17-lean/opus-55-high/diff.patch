-          ((2 * M₂ : ℝ) / M₁) ≤
-        16 * (M₂ : ℝ) ^ 2 := by
-    calc
-      ((gmAffineSignedShell M₁).card : ℝ) *
-          ((gmAffinePositiveShell M₂).card : ℝ) *
-          ((2 * M₂ : ℝ) / M₁) ≤
-        (4 * M₁ : ℝ) * (2 * M₂ : ℝ) * ((2 * M₂ : ℝ) / M₁) := by
-          gcongr
-      _ = 16 * (M₂ : ℝ) ^ 2 := by
-        field_simp [hM₁r.ne']
-        ring
