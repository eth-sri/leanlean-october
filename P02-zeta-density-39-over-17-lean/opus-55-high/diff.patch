-    (n : ℕ) {epsilon T Q Y Ctail : ℝ}
-    (hT : 0 < T) (hQ : 1 ≤ Q) (hY : 0 ≤ Y) (hCtail : 0 ≤ Ctail)
-    (f : SchwartzMap ℝ ℝ)
-    {M M₁ M₂ M₃ : ℕ}
-    (hM₁ : 0 < M₁)
-    (hM₂ : 0 < M₂) (hM₂M : M₂ ≤ M)
