-  have hM₂r : (0 : ℝ) < M₂ := by exact_mod_cast hM₂
-  have hM₂one : (1 : ℝ) ≤ M₂ := by exact_mod_cast hM₂
-  have hM₁Mreal : (M₁ : ℝ) ≤ M := by exact_mod_cast hM₁M
-  have hM₂Mreal : (M₂ : ℝ) ≤ M := by exact_mod_cast hM₂M
-  have hM₃Mreal : (M₃ : ℝ) ≤ M := by exact_mod_cast hM₃M
