-    (Y + gmAffineFirstPoissonRadius M₁ M₃ Q) ^ epsilon
-  let L : ℝ := SchwartzMap.seminorm ℝ 0 0 gmAffineLocalBumpDual
-  have hR : 0 ≤ gmAffineFirstPoissonRadius M₁ M₃ Q := by
-    unfold gmAffineFirstPoissonRadius
-    positivity
-  have hA : 0 ≤ A := by
-    dsimp only [A]
