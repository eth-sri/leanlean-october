-      (∫ x : ℝ, gmAffineTildeSchwartz S hS f x) ^ 2 ≤
-        16 * (∫ x : ℝ, f x) ^ 2 := by
-    calc
-      _ ≤ (4 * ∫ x : ℝ, f x) ^ 2 :=
-        (sq_le_sq₀ htildeMassNonneg
