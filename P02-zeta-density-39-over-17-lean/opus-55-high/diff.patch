-      (2 * (Q / (8 * M₃ : ℝ)) + 5) * ((8 * M₃ : ℝ) * L) =
-        (((2 * (Q / (8 * M₃ : ℝ)) + 5) * (8 * M₃ : ℝ)) * L) by ring]
