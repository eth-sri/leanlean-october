-    (f : ℝ → ℝ) (M₁ M₂ M₃ : ℕ) (u : ℝ) :
-    gmAffineTransformSum f M₁ M₂ M₃ u ^ 2 ≤
-      (gmAffineIndexSet M₁ M₂ M₃).card *
-        ∑ p ∈ gmAffineIndexSet M₁ M₂ M₃,
-          gmAffineTerm f p.1 p.2.1 p.2.2 u ^ 2 := by
-  rw [gmAffineTransformSum_eq_indexSum]
-  exact sq_sum_le_card_mul_sum_sq
