-      simpa only [C] using
-        (SchwartzMap.norm_le_seminorm ℝ (gmAffineComplexify f) (u - t))
-    simpa only [mul_comm] using
-      (mul_le_mul_of_nonneg_left hfbound
-        (norm_nonneg (gmAffineSmoothingKernel T hT t)))
