-theorem norm_gmAffineFirstPoissonPairTerm_sq_eq
-    (f : SchwartzMap ℝ ℝ) {M₁ M₂ M₃ : ℕ}
-    (hM₁ : 0 < M₁) (hM₂ : 0 < M₂) (hM₃ : 0 < M₃)
-    {Q xi : ℝ} {p : ℤ × ℤ}
-    (hp : p ∈ gmAffineFirstPoissonPairs M₁ M₃ Q xi) :
-    ‖gmAffineFirstPoissonPairTerm f M₂ M₃ hM₃ xi p‖ ^ 2 =
