-    (hstep : forall n, n < N -> theta n <= theta (n + 1)) :
-    forall i j, i <= j -> j <= N -> theta i <= theta j := by
-  intro i j hij hj
-  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hij
-  induction d with
-  | zero => simp
-  | succ d ih =>
-      have hprev := ih (by omega) (by omega)
-      exact hprev.trans (hstep (i + d) (by omega))
