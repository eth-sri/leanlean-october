-      _ ≤ _ := Real.rpow_le_rpow_of_exponent_le hH (by
-        have he := (upper_window_exponents hσ hσ').1
-        nlinarith [mul_nonneg hδ (show 0 ≤ σ by linarith)])
-
-/-- Padding the time interval preserves the exact middle-range hypotheses and
