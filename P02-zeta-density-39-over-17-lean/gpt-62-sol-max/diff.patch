-theorem vdc_product_bound
-    (n x : Real) (hn : 0 <= n) (hx : 0 < x) (hx1 : x <= 1) :
-    (n * (32 * x) / (2 * Real.pi) + 2) *
-        (2 * Real.pi / Real.sqrt x + 2 * (Real.sqrt x / x + 1)) <=
-      100 * (n * Real.sqrt x + 1 / Real.sqrt x) := by
