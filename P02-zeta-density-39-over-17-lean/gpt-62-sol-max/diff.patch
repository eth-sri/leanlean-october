-    simpa using f.memLp (2 : ENNReal)
-  have hcrude := gmAffineJ_le_crude hfSqInt hM
-  have hTone : (1 : ℝ) ≤ T := by linarith
-  have hM2 : (M : ℝ) ^ 2 ≤ T ^ (8 : ℕ) := by
