+private theorem separated_subset_card_le_one_of_diameter
+    (W S : Finset ℝ) (hSep : IsSeparated 1 W) (hSW : S ⊆ W)
+    (hdiam : ∀ x ∈ S, ∀ y ∈ S, |x - y| < 1) :
+    S.card ≤ 1 := by
+  rw [Finset.card_le_one]
+  intro x hx y hy
+  by_contra hxy
+  have hlarge := hSep x (hSW hx) y (hSW hy) hxy
+  exact (not_lt_of_ge hlarge) (hdiam x hx y hy)
