+/-- Fourier completion when all selected arcs arise from major dyadic anchors. -/
+abbrev DyadicAnchorFourier {ι : Type*} (S : Finset ι) (f : ι → ℝ → ℝ)
+    (L : ι → ℤ) (H : ι → ℕ) (anchor : ι → ℚ) (za : ι → ℝ) (N Q : ℕ)
+    (C U₃ close : ℝ) : Prop :=
+    (∀ i∈S, za i∈Ioo ((L i:ℝ)-2*(N:ℝ)-(N:ℝ)/8)
+      ((L i:ℝ)-2*(N:ℝ)+(N:ℝ)/8) ∧
