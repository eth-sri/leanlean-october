-    ring
-  rcases le_total i j with h|h
-  · have hji : (m : ℤ)+1 ≤ j-i := by
-      rw [abs_of_nonpos (sub_nonpos.mpr h)] at hij
-      omega
-    have hji' : (m : ℝ)+1≤(j : ℝ)-(i : ℝ) := by exact_mod_cast hji
-    have hp := mul_le_mul_of_nonneg_left hji' (sq_nonneg w)
