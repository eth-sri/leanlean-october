-      (ContinuousLinearMap.mul ℂ ℂ) (gmAffineSmoothingKernel T hT t)
-        (gmAffineComplexify f (u - t))) := by
-  let C : ℝ := SchwartzMap.seminorm ℝ 0 0 (gmAffineComplexify f)
