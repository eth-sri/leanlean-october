+    have hfloorPos : 0 < shell u := by
+      exact Nat.floor_pos.mpr hqOne
+    have hfloorLeReal : ((shell u : ℕ) : ℝ) ≤ (N : ℝ) := by
+      exact (Nat.floor_le hqNonneg).trans huData.2.2
