-/-- The normalized width-`1/T` Schwartz kernel `T psi(Tx)` from Lemma 9.2. -/
-noncomputable def gmAffineSmoothingKernel
-    (T : ℝ) (hT : 0 < T) : SchwartzMap ℝ ℂ :=
-  (T : ℂ) • gmAffineScaledBumpSchwartz (1 / T) (by positivity)
