-theorem logarithmicCorrelationBound_le_simple
-    (t A : Real) (N r : Nat) (ht : 0 < t) (hA : 0 < A)
-    (hr : 0 < r) (hsmall : t * r / (8 * A ^ 3) <= 1) :
-    logarithmicCorrelationBound t A N r <=
