-      p.1 ∈ gmAffineSignedShell M₁ ∧
-        p.2 ∈ gmAffinePoissonNearSet M₃ (xi / (p.1 : ℝ)) Q := by
-  classical
-  simp only [gmAffineFirstPoissonPairs, Finset.mem_biUnion,
-    Finset.mem_image]
-  constructor
-  · rintro ⟨m₁, hm₁, ell, hell, hp⟩
-    rw [← hp]
-    exact ⟨hm₁, hell⟩
-  · rintro ⟨hp₁, hp₂⟩
-    exact ⟨p.1, hp₁, p.2, hp₂, Prod.ext rfl rfl⟩
