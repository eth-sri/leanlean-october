-/-- The `gmAffineRegionIIIEnvelopeMassConstant` definition used by the source-facing construction in `LargeValuesAffineIteration`. -/
-noncomputable def gmAffineRegionIIIEnvelopeMassConstant
-    (n : ℕ) (D : ℝ) : ℝ :=
