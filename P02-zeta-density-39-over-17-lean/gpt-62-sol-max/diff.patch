-private theorem logCurve_block_gap {i j : ℤ} {m : ℕ} {x x' d w ν : ℝ}
-    (hm : 2/ν≤(m : ℝ))
-    (hx : x∈Icc (d+w^2*(i : ℝ)) (d+w^2*((i : ℝ)+1)))
-    (hx' : x'∈Icc (d+w^2*(j : ℝ)) (d+w^2*((j : ℝ)+1)))
