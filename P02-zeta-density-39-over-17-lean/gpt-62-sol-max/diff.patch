+  have h₁ := mul_nonneg (sub_nonneg.mpr hl) (sub_nonneg.mpr hr)
+  have h₂ := sq_nonneg ((5/7:ℝ)-s)
+  constructor <;> (try field_simp [hD,hE,hD₀,hE₀]) <;> nlinarith only [hl, hr, h₀, h₁, h₂]
+
