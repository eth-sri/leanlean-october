+      round (z ip.1.1 ip.1.2)+(A ip.1.1 ip.1.2:ℤ)=Z ip.1.1+(N:ℤ)*ip.1.2+2*(N:ℤ))
+    (hlevel : ∀ ip∈S, curvature ip.1.1 (z ip.1.1 ip.1.2)=q)
+    (hinj : ∀ y∈S.image (fun ip => ip.1.1), InjOn (curvature y) (Icc M (2*M))) :
