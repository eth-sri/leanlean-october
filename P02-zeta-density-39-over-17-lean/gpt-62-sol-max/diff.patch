-theorem upper_window_exponents {σ : ℝ} (hσ : 5/7 ≤ σ) (hσ' : σ ≤ 3/4) :
-    (9/4)*(1-σ) ≤ (39/17)*(1-σ) ∧
-    39/14-3*σ ≤ (39/17)*(1-σ) ∧
-    63/20-7*σ/2 ≤ (39/17)*(1-σ) ∧
-    15/8-7*σ/4 ≤ (39/17)*(1-σ) := by
-  constructor
-  · linarith
-  constructor
-  · linarith
-  constructor <;> linarith
-
-/-- Length losses and the first large-value term in the fixed powered window. -/
