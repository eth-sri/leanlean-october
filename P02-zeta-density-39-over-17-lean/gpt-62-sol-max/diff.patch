-      (4 * S / Q ^ n) * Z +
-          2 * ((8 * M₃ : ℝ) * S / Q ^ (n + 2)) ≤
-        (4 * S / Q ^ n) * Z +
-          2 * ((8 * M₃ : ℝ) * S / Q ^ n) := by gcongr
