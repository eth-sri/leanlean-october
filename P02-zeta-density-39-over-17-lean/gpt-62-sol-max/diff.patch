+theorem rayPoolOutside (S : Finset (Ideal O)) (N : ℕ) (c b : ℝ) (Y : Fin N→ℝ) :
+    ∀j P,P∈pool (RayQuotient.identityClass M H) S c b (Y j) → P.val∉S :=
+  fun j P hP=>(mem_pool _ S c b (Y j) P).mp hP |>.2.2.2
+
+end
