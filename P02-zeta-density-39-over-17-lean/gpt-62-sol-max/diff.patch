+theorem LogCurveDecouplingBound.of_bilinear_dyadic {n r : ℕ} {A K : ℝ}
+    (hr : r ≤ n) (hA : LogCurveDecouplingBound.{u} (2^(n-r)) A)
+    (hK : LogCurveBilinearSixBound.{u} (1/(2:ℝ)^n)
