-    (hσ : 5/7 ≤ σ) (hσ' : σ ≤ 3/4) (hH : 1 ≤ H) (hN : 0 ≤ N)
-    (hδ : 0 ≤ δ) (hδ' : δ ≤ 1/100) (hhi : N ≤ H^(9/8+δ)) :
-    N^δ ≤ H^(2*δ) ∧
-    N^(2-2*σ) ≤ H^((39/17)*(1-σ)+2*δ) := by
-  have hH0 : 0 < H := by linarith
-  constructor
-  · calc
-      _ ≤ (H^(9/8+δ))^δ := Real.rpow_le_rpow hN hhi hδ
-      _ = H^((9/8+δ)*δ) := (Real.rpow_mul hH0.le _ _).symm
