+abbrev DyadicAnchorChoice (f : ℝ → ℝ) (anchor : ℚ) (za N close : ℝ)
+    (Q : ℕ) (r : ℚ) (z : ℝ) : Prop :=
+  r.den ≤ Q ∧ Q ≤ 2*r.den ∧ (anchor:ℝ) < r ∧ |(r:ℝ)-(anchor:ℝ)| ≤ close ∧
