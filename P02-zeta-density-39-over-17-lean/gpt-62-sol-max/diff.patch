-/-- The `gmAffineRegionIIIEnvelopeConstant` definition used by the source-facing construction in `LargeValuesAffineIteration`. -/
-noncomputable def gmAffineRegionIIIEnvelopeConstant
-    (n : ℕ) (f : SchwartzMap ℝ ℝ) : ℝ :=
