+    (n : ℕ) (S alpha Q : ℝ) :
+    (∑' j : ℤ, gmAffineScaledFarMajorant n S alpha Q j) =
+      (4 * SchwartzMap.seminorm ℝ (n + 2) 0 gmAffineLocalBumpDual /
+        (S * Q ^ n)) *
