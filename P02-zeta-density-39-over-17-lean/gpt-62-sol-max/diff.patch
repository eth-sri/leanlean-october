-  have hdenexp : (1 - Complex.exp (Complex.I * x) : ℂ) ≠ 0 := by
-    simpa only [unitaryPhase] using hden
-  rw [eq_div_iff (mul_ne_zero Complex.I_ne_zero hdenexp)] at hcot
-  rw [unitaryPhase]
-  push_cast at hcot ⊢
-  ring_nf at hcot ⊢
-  linear_combination (1 / 2 : ℂ) * hcot
