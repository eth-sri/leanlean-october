-        gmAffineLocalBumpDual
-          (gmAffineFirstPoissonTau M₃ p.1 p.2 xi) := by
-  obtain ⟨hp₁, hp₂⟩ := mem_gmAffineFirstPoissonPairs.mp hp
-  unfold gmAffineFirstPoissonPairTerm
