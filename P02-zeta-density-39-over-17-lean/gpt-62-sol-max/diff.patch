+    {σ ε : ℝ} (hσ : 0<σ) (hε : 0<ε) :
+    ∃ δ η₀ B C : ℝ, 0<δ ∧ 0<η₀ ∧ η₀≤1/8 ∧ 1≤B ∧ 1≤C ∧
+      ∀ (X M : ℝ) (F : ℝ → ℝ) (n N H a L : ℕ),
