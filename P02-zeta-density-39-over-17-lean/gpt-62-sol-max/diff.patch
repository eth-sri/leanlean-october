-noncomputable def gmAffineMiddleFrequencySupport (T : ℝ) (M₂ : ℕ) : Finset ℤ :=
-  let B : ℕ := ⌈2 * T / (M₂ : ℝ)⌉₊ + 1
-  Finset.Icc (-(B : ℤ)) (B : ℤ)
