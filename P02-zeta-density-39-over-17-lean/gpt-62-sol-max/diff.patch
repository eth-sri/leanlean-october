-      ((64*7^6:ℝ)*A^6+64*(J.card:ℝ)^5*K)*(∑ i ∈ J, E i)^3 := by
-  have hmain := parabolaWeightedSixNorm_bilinear_reduction J S z x W hW₀ hW
