-    (T : ℝ) (hT : 0 < T) (x : ℝ) :
-    gmAffineSmoothingKernel T hT x =
-      (T * gmCubicLocalBump (T * x) : ℝ) := by
-  rw [gmAffineSmoothingKernel, smul_apply,
-    gmAffineScaledBumpSchwartz_apply]
-  push_cast
-  congr 1
-  field_simp [hT.ne']
