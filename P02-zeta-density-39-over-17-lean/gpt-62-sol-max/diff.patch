-    nlinarith [mul_le_mul_of_nonneg_left hQtwo
-      (pow_nonneg (zero_le_one.trans hQ) n)]
-  have hsecond :
-      (8 * M₃ : ℝ) * S / Q ^ (n + 2) ≤
-        (8 * M₃ : ℝ) * S / Q ^ n :=
-    div_le_div_of_nonneg_left (by positivity) (pow_pos hQpos n) hQpow
-  have htail :
-      (4 * S / Q ^ n) * Z + 2 * ((8 * M₃ : ℝ) * S / Q ^ (n + 2)) ≤
-        ((M₃ : ℝ) * (4 * S * Z + 16 * S)) / Q ^ n := by
