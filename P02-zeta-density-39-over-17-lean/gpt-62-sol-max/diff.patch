-        (xi / (m₁ : ℝ) + (ell : ℝ)) =
-      ((8 * M₃ : ℝ) : ℂ) *
-        gmAffineLocalBumpDual (gmAffineFirstPoissonTau M₃ m₁ ell xi) := by
-  rw [gmAffineCentralPoissonKernel_eq_scaled]
