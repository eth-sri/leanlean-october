-      have hpow : Real.sqrt (T ^ (3 * delta / 2)) =
-          T ^ (3 * delta / 4) := by
-        rw [Real.sqrt_eq_rpow, ← Real.rpow_mul hT]
-        congr 1
-        ring
-      rw [show Real.sqrt 16 = 4 by norm_num, hpow]
