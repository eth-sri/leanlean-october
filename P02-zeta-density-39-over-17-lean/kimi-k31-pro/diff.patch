-      4 * S / ((B / (M₂ : ℝ)) * Q ^ n) ≤
-        4 * S * T ^ 3 / Q ^ (n + 1) := by
-    have hden : 0 < (B / (M₂ : ℝ)) * Q ^ n :=
-      mul_pos hBdivPos (pow_pos hQ n)
-    rw [div_le_div_iff₀ hden (pow_pos hQ (n + 1))]
