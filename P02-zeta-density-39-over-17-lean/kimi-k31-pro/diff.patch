-    (M : ℕ) (hM : 0 < M) (alpha Q : ℝ) (ell : ℤ) : ℂ :=
-  if |(8 * M : ℝ) * (alpha + ell)| < Q then
-    gmAffineCentralPoissonKernel M hM (alpha + ell)
