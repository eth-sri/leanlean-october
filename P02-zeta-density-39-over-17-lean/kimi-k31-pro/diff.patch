-    |xi + ((p.1 * p.2 : ℤ) : ℝ)| =
-        |xi + (p.1 : ℝ) * (p.2 : ℝ)| := by push_cast; rfl
-    _ < (Q / (8 * M₃ : ℝ)) * |(p.1 : ℝ)| := hmul
-    _ ≤ (Q / (8 * M₃ : ℝ)) * (2 * M₁ : ℝ) := by
-      gcongr
-      exact abs_gmAffineSignedShell_le_scale hm₁
