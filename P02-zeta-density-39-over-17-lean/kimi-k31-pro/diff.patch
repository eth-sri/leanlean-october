-/-- The underlying point of a (nonzero) divisor index. -/
-abbrev divisorZeroIndex₀_val {f : ℂ → ℂ} {U : Set ℂ} (p : divisorZeroIndex₀ f U) : ℂ :=
-  p.1.1
