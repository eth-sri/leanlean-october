-    (M : ℕ) (m₁ : ℤ) (ξ : ℝ) : ℂ :=
-  ∑ m₃ ∈ gmAffineSmoothCentralShell M,
-    (gmAffineCentralWeight M m₃ : ℂ) *
-      Complex.exp ((((2 * Real.pi * (m₃ : ℝ) * ξ / (m₁ : ℝ) : ℝ) : ℂ) * I))
