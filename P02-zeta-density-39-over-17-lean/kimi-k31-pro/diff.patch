-    0 ≤ gmAffineRegionIFarConstant n := by
-  have hsum : 0 ≤ (∑' j : ℤ, gmIntDecayProfile 2 j) :=
-    tsum_nonneg fun j => by
-      unfold gmIntDecayProfile
