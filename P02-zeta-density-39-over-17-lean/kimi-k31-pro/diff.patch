-      Q / (8 * M₃ : ℝ) := by
-    rw [lt_div_iff₀ hscale]
-    simpa only [mul_comm] using hnear
-  have hmul : |xi + (p.1 : ℝ) * (p.2 : ℝ)| <
-      (Q / (8 * M₃ : ℝ)) * |(p.1 : ℝ)| := by
-    rw [div_lt_iff₀ hmabs] at hdiv
-    exact hdiv
