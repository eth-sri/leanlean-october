-          Real.sqrt (T ^ (3 * delta / 2)) * Real.sqrt W := by
-      rw [Real.sqrt_mul (by positivity : (0 : ℝ) ≤ 16 * C * T ^
-        (3 * delta / 2)), Real.sqrt_mul (by positivity : (0 : ℝ) ≤ 16 * C),
-        Real.sqrt_mul (by norm_num : (0 : ℝ) ≤ 16)]
