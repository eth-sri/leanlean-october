-    Complex.re (∫ t : ℝ, g t) = ∫ t : ℝ, Complex.re (g t) :=
-      (integral_re hint).symm
-    _ = ∫ u' : ℝ, T * gmCubicLocalBump (T * u') * f (u - u') := by
-      apply integral_congr_ae
-      filter_upwards with u'
