-    T ^ gmAffineIterationEta delta * (M : ℝ) ≤ T * T ^ 4 := hfirst
-    _ = T ^ 5 := by ring
-    _ ≤ T ^ 6 := hpow56
-    _ ≤ 4 * T ^ 6 := by nlinarith [pow_nonneg hTnonneg 6]
