-/-- The signed dyadic shell `M ≤ |m| ≤ 2M`. -/
-noncomputable def gmAffineSignedShell (M : ℕ) : Finset ℤ :=
-  (Finset.Icc (-(2 * M : ℕ) : ℤ) (-(M : ℕ) : ℤ)) ∪
-    Finset.Icc (M : ℤ) (2 * M : ℤ)
