-        ∑ h ∈ r, ∑ k ∈ r, ∑ n ∈ s, ⟪b n h, b n k⟫_ℝ := by
-    simp only [u, ← real_inner_self_eq_norm_sq, sum_inner, inner_sum]
-    rw [sum_comm]
-    apply Finset.sum_congr rfl
-    intro h _hh
-    rw [sum_comm]
-    apply Finset.sum_congr rfl
-    intro k _hk
-    apply Finset.sum_congr rfl
-    intro n _hn
