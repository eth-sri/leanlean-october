-theorem norm_phase_sum_finset_le_card (s : Finset Nat) (f : Nat -> Real) :
-    ‖∑ n ∈ s, unitaryPhase (f n)‖ <= (s.card : Real) := by
-  calc
-    ‖∑ n ∈ s, unitaryPhase (f n)‖ <= ∑ n ∈ s, ‖unitaryPhase (f n)‖ :=
-      norm_sum_le _ _
-    _ = (s.card : Real) := by simp
