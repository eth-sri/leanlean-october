-    (f : SchwartzMap ℝ ℝ) {A Q B F : ℝ} (hA : 0 < A)
-    {M₂ : ℕ} (hM₂ : 0 < M₂) {ell : ℤ} {tau : ℝ}
-    (htau : |tau| ≤ Q) (hell : 2 * Q / A ≤ |(ell : ℝ)|)
-    (hB : B ≤ (M₂ : ℝ) * |(ell : ℝ)| / 2)
