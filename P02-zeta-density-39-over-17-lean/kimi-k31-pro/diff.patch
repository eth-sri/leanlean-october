-theorem gmAffineMiddleFarBound_at_source_cutoff_le
-    (n : ℕ) {T Q : ℝ} (hT : 1 ≤ T) (hQ : 0 < Q)
-    {M M₂ M₃ : ℕ} (hM₂ : 0 < M₂) (hM₃ : 0 < M₃)
