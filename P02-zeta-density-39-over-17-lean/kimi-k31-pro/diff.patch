-      abs (∑ n ∈ s, ⟪b n h, b n k⟫_ℝ) ≤ B) :
-    (r.card : ℝ) ^ 2 * ‖S‖ ^ 2 ≤
-      (s.card : ℝ) * ((r.card : ℝ) * A + (r.card : ℝ) ^ 2 * B) := by
