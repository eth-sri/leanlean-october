-  have he : |phase g h u v| < (L : ℤ) := by
-    have hp := fourierPhase_abs_lt (by omega : (1 : ℤ) ≤ M) hh hg hu hv
-    have hL' : (5 : ℤ) * M ≤ L := by exact_mod_cast hL
-    exact hp.trans_le hL'
