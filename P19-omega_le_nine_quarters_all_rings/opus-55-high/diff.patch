-    calc
-      p = ∑ i ∈ Finset.range (a + 1), Polynomial.monomial i (p.coeff i) :=
-        p.as_sum_range' (a + 1) (Nat.lt_succ_of_le hp)
-      _ = _ := (Fin.sum_univ_eq_sum_range (fun i => Polynomial.monomial i (p.coeff i)) (a + 1)).symm
