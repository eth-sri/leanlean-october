-  rw [sum_unit_zpow_primitive_root_of_abs_lt hζ he]
-  split_ifs <;> simp
-
-theorem weightedBranch_vanishes {ζ : Eˣ} {M L j : ℕ} {g h u v : ℤ}
-    (hM : 0 < M) (hL : 5 * M ≤ L) (hζ : IsPrimitiveRoot ζ L)
-    (hg : 1 ≤ g ∧ g ≤ M) (hh : 1 ≤ h ∧ h ≤ M)
-    (hu : 1 ≤ u ∧ u ≤ M) (hv : 1 ≤ v ∧ v ≤ M)
-    (hj : j < 2 * M ^ 2) (c : E) :
