-    (h : ∀ p : ℕ, p.Prime → ∃ D ∈ S, ¬ (p : ℤ) ∣ D) :
-    ∃ t : Finset ℤ, (↑t : Set ℤ) ⊆ S ∧
-      ∃ u : t → ℤ, ∑ i, u i * (i : ℤ) = 1 := by
-  classical
-  have htop := integer_span_eq_top_of_prime_witness S h
-  have hmem := (Ideal.eq_top_iff_one _).mp htop
-  change (1 : ℤ) ∈ Submodule.span ℤ S at hmem
