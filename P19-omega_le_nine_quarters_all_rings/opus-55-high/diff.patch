-def gradedTensor (d e : ℕ) : Tensor K (Fin (d + 1)) (Index e) (Index (d + e))
-  | i, .inl j, .inl k => if i.val + j.val = k.val then 1 else 0
-  | _, .inl _, .inr _ => 0
-  | _, .inr _, .inl _ => 0
-  | i, .inr j, .inr k => if i.val + j.val = k.val then 1 else 0
