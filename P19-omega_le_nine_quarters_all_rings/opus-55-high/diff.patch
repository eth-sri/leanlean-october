-    u (n + k) ≤ u n + (k : ℝ) * (u (n + 1) - u n) := by
-  induction k with
-  | zero => simp
-  | succ k ih =>
-      have hstep := hd (show n ≤ n + k by omega)
-      simp only at hstep
-      rw [Nat.cast_add, Nat.cast_one]
-      have hindex : n + (k + 1) = n + k + 1 := by omega
-      rw [hindex]
-      nlinarith
