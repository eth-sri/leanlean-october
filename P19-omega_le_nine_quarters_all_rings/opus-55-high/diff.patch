-namespace MatrixMultiplication.AuxiliarySeparation
-
-/-- The product sequence from Section 6, indexed from zero. -/
-noncomputable def growthProduct : ℕ → ℝ
-  | 0 => 1
-  | n + 1 => growthProduct n * (1 + 1 / (3 * ((n : ℝ) + 1)))
