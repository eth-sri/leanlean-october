-theorem bounded_finite_stateConstraint_solution (R : S → ℕ) (d : S) (k : ℕ)
-    (hzero : ∀ x : S, 0 ≤ x) (hbound : ∀ x : S, x ≤ (R x : S))
-    (hadd : ∀ a b c e : S, a ≤ b → c ≤ e → a + c ≤ b + e)
-    (hno : ∀ (D s : S) (m : ℕ), 0 < m →
-      ¬D + (m : S) + d * s ≤ D + (k : S) * s)
