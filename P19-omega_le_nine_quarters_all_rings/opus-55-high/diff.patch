-      (hn : rightTensor (K := K) a h i j k ≠ 0) :
-      i ∈ Set.range (id : Fin a → Fin a) ∧
-        j ∈ Set.range (rightY a h) ∧ k ∈ Set.range (rightZ a h) := by
-    exact ⟨⟨i, rfl⟩, rightTensor_support a h i j k hn⟩
