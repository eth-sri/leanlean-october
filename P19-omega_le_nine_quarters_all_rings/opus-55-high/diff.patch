-      fun x y z => ∑ i, rankOne (aa i) (bb i) (cc i) x y z := by
-    funext x y z
-    rw [coeff_eq_sum_eval nodes hnodes _ d (hdegree x y z)]
-    simp only [Fintype.sum_prod_type, rankOne, Polynomial.eval_finsetSum,
