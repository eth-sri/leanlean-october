-/-- Consequently the base-ring determinant specializes to the residue norm. -/
-theorem norm_specialize (b : Module.Basis ι R E) (c : Module.Basis ι S K)
-    (ψ : R →+* S) (φ : E →+* K)
-    (hφ : ∀ r, φ (algebraMap R E r) = algebraMap S K (ψ r))
