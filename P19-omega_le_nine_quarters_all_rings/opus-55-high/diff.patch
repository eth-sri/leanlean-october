-    ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 3), mul_one_div_cancel hs.ne',
-    Real.rpow_one] at hmean
-  exact hmean
-
-end MatrixMultiplication.AuxiliarySeparation
-
-end OAI
