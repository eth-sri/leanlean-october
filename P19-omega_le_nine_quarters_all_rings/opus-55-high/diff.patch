-    forget e (basis K e j) =
-      Sum.elim (DeterminantKernel.quotientVector e) (DeterminantKernel.kernelVector e) j := by
-  rw [basis_apply, forget_vector]
-
-end MatrixMultiplication.AuxiliarySeparation.DeterminantBasis
