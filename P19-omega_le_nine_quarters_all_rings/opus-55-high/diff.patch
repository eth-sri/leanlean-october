-def eval (inputs : Input → F) : Expression F Input → F
-  | .constant z => z
-  | .input i => inputs i
-  | .add e f => e.eval inputs + f.eval inputs
-  | .sub e f => e.eval inputs - f.eval inputs
-  | .mul e f => e.eval inputs * f.eval inputs
