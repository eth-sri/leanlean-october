-    ((D.power n).middleMap y q.2).coeff q.1.2
-  let C := fun z (q : ExtractionIndex Lx Ly n × (Fin n → Z)) =>
-    shiftedCoeff ((D.power n).rightMap z q.2) (k * n) (q.1.1.val + q.1.2.val)
