-    (w : I → ℝ) (hw : ∀ i ∈ s, 0 ≤ w i)
-    (h : ¬ LinearIndependent ℝ (fun i : s ↦ A i)) :
-    ∃ i ∈ s, ∃ v : I → ℝ, (∀ j ∈ s.erase i, 0 ≤ v j) ∧
