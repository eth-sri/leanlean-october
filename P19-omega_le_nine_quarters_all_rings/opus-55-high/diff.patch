-    p.coeff d = (Lagrange.interpolate Finset.univ nodes
-        (fun i => p.eval (nodes i))).coeff d := congrArg (fun q => q.coeff d) hinterp
-    _ = _ := by
-      simp only [Lagrange.interpolate_apply, Polynomial.finsetSum_coeff,
