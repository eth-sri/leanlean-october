-theorem exists_nonneg_representation_linearIndependent (A : I → E) (s : Finset I)
-    (w : I → ℝ) (hw : ∀ i ∈ s, 0 ≤ w i) :
-    ∃ t : Finset I, t ⊆ s ∧ LinearIndependent ℝ (fun i : t ↦ A i) ∧
-      ∃ v : I → ℝ, (∀ i ∈ t, 0 ≤ v i) ∧
-        (∑ i ∈ t, v i • A i) = ∑ i ∈ s, w i • A i := by
