-      (Ideal.subset_span hDS)
-  rw [← Ideal.span_singleton_generator (Ideal.span S)]
-  exact Ideal.span_singleton_eq_top.mpr hu
-
-/-- Extract one finite Bezout family before any tensor-power parameter varies. -/
