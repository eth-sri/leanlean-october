-  have hu1 : (1 : ℝ) < u := by exact_mod_cast (show 1 < u by omega)
-  have hu0 : (0 : ℝ) < u := zero_lt_one.trans hu1
-  have hn1 : (1 : ℝ) ≤ n := by exact_mod_cast hn
-  have hn0 : (0 : ℝ) < n := zero_lt_one.trans_le hn1
