-theorem matrixClass_pow (m j : ℕ) : (matrixClass (K := K)) (m ^ j) = (matrixClass (K := K)) m ^ j := by
-  induction j with
-  | zero => simp
-  | succ j ih => rw [pow_succ, matrixClass_mul, ih, pow_succ]
