-theorem eval_append_old {r s : ℕ} (p : Program F Input r) (q : Program F Input s)
-    (inputs : Input → F) :
-    ∀ i : Fin r, (p.append q).eval inputs (oldIndex r s i) = p.eval inputs i := by
-  induction q with
-  | nil => intro i; simp [append]
-  | @step s q g ih =>
-    intro i
