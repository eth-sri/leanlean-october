-      (a * f x + b * g x) + (a * f y + b * g y)
-    rw [hf.2.2.1, hg.2.2.1]
-    ring
-  · intro x y hxy
-    exact add_le_add (mul_le_mul_of_nonneg_left (hf.2.2.2.1 x y hxy) ha)
-      (mul_le_mul_of_nonneg_left (hg.2.2.2.1 x y hxy) hb)
