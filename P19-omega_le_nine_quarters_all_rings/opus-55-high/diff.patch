-theorem le_of_eventually_pow_le_linear_mul_pow {a b K C : ℝ}
-    (ha : 0 ≤ a)
-    (h : ∀ᶠ j : ℕ in atTop, b ^ j ≤ ((j : ℝ) * K + C) * a ^ j) :
