-        -(m : ℤ) • Finsupp.single (1 : S) (1 : ℤ) := by
-  classical
-  rintro ⟨m, hm, n, hn⟩
-  have heq := congrArg
-    (Finsupp.linearCombination ℤ (Algebra.GrothendieckAddGroup.of (M := S))) hn
