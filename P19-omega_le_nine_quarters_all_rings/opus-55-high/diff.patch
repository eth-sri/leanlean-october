-    χ.value (Tensor.matrixCoefficients (K := K) (Fin m) (Fin m) (Fin m)) =
-      (m : ℝ) ^ (χ.pX + χ.pY + χ.pZ) := by
-  rw [χ.value_matrixCoefficients hm hm hm]
-  have hm' : 0 < (m : ℝ) := Nat.cast_pos.mpr hm
-  rw [Real.rpow_add hm', Real.rpow_add hm']
