-theorem normalizedStates_isCompact (R : S → ℝ) (d : S) (k : ℝ) :
-    IsCompact (normalizedStates R d k) := by
-  apply (isCompact_univ_pi (fun x => isCompact_Icc (a := (0 : ℝ)) (b := R x))).of_isClosed_subset
