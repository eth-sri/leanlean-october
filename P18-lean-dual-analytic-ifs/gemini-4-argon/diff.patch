-@[simp] private theorem dualCompU_cons (i : Fin N) (w : List (Fin N)) (u : nbhd ε →ᵤ ℂ) :
-    Φ.dualCompU (i :: w) u = Φ.dualOpU i (Φ.dualCompU w u) := rfl
