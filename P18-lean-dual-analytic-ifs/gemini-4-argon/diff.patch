-/-- `P_{m,W} = (z - l)^{m+2} P_{m,W∖{l}}` for `l ∈ W`. -/
-theorem P_eq_mul {l : ℝ} (hl : l ∈ W) (z : ℂ) :
-    P m W z = (z - l) ^ (m + 2) * P m (W.erase l) z :=
-  (Finset.mul_prod_erase W (fun w : ℝ => (z - w) ^ (m + 2)) hl).symm
-
-/-- `|P_{m,W}(z)| ≤ |z - l|^{m+2}` for `l ∈ W`. -/
