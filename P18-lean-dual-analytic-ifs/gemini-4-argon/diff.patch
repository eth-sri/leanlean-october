-/-! ## The map `g = f e^{φ ψ A}` -/
-
-/-- The perturbed map `g = f e^{φ ψ A}` of (4.2). -/
-noncomputable def G (f : ℂ → ℂ) (Y Z : Finset ℝ) (a : ℝ → ℝ) (η : ℝ) (z : ℂ) : ℂ :=
-  f z * Complex.exp (H Y Z a η z)
-
-section Map
