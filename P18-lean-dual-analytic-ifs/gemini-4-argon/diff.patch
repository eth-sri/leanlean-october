-private theorem dualCompU_append (v w : List (Fin N)) (u : nbhd ε →ᵤ ℂ) :
-    Φ.dualCompU (v ++ w) u = Φ.dualCompU v (Φ.dualCompU w u) := by
-  induction v with
-  | nil => rfl
-  | cons i v ih => simp [ih]
