-    ‖P m W z‖ ≤ ‖z - l‖ ^ (m + 2) := by
-  rw [P_eq_mul hl, norm_mul, norm_pow]
-  exact mul_le_of_le_one_right (by positivity)
-    (norm_P_le_one (W := W.erase l) fun w hw => hW w (Finset.mem_of_mem_erase hw))
-
