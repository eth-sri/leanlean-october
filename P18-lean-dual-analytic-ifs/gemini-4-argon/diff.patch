-/-- `F_w = F_{w₁} ∘ ⋯ ∘ F_{w_k}` acting on functions on `B_ε`. -/
-private noncomputable def dualCompU (w : List (Fin N)) : (nbhd ε →ᵤ ℂ) → nbhd ε →ᵤ ℂ :=
-  w.foldr (fun i G => Φ.dualOpU i ∘ G) id
