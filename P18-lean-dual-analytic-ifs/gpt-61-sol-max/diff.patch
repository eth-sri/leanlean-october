-  have hs1 : s < 1 := exampleIFS.exdim_lt_one hN hc ((hs s).2 rfl)
-  refine ⟨s, hs, hs1, by rw [hdim, min_eq_right hs1.le], fun p hp μ hμ => ?_⟩
-  have hH : entropy p < exampleIFS.lyapunov p μ :=
