-  have h := (koenigsIFS hε hf).differentiableOn_dualTerm (.inf fun _ => 0) k
-  have heq : (koenigsIFS hε hf).dualTerm (.inf fun _ => 0) k = hatHTerm f k :=
-    funext (dualTerm_koenigsIFS hε hf k)
-  rw [← heq]
-  exact h
