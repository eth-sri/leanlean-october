-/-- `π(ω) = f_{ω₀}(π(σω))`, where `σ` is the left shift. -/
-theorem natProj_eq_realMap (ω : ℕ → Fin N) :
-    Φ.natProj ω = Φ.realMap (ω 0) (Φ.natProj fun j => ω (j + 1)) := by
-  rw [Φ.natProj_eq_comp_prefix ω 1]
