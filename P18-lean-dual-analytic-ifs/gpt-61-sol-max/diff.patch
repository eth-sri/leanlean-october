-private theorem mapsTo_iterate (n : ℕ) : MapsTo (f^[n]) (nbhd ε) (nbhd ε) := by
-  rw [← koenigsIFS_comp hε hf]
-  exact (koenigsIFS hε hf).mapsTo_comp _
