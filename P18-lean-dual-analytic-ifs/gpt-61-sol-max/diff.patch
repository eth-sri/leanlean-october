-  refine ⟨R '' (K : Set _), ⟨?_, K.nonempty.image R,
-    K.isCompact.image ClosedAnalyticSpace.continuous_restrict, ?_⟩, ?_⟩
-  · rintro _ ⟨g, hg, rfl⟩
