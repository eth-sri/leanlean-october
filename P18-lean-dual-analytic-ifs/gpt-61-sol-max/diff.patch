-/-- The Lyapunov exponent is positive, so its reciprocal is well defined. -/
-theorem lyapunov_pos (hN : 0 < N) {p : Fin N → ℝ} (hp : IsProbVec p)
-    {μ : Measure ℝ} (hμ : Φ.IsSelfConformal p μ) : 0 < Φ.lyapunov p μ :=
