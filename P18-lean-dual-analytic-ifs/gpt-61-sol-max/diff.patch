-/-- The Gibbs property determines the exponent: the pressure `P(t)` exists and vanishes exactly
-for `t = s`, so `s = s(Φ)`. -/
-theorem tendsto_pressure_iff_of_isGibbs (hN : 0 < N) {s : ℝ} {ν : Measure (ℕ → Fin N)}
