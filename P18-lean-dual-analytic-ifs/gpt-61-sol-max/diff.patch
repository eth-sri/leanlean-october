-  have hpow2 : (1 / 8 : ℝ) ^ (n + 2) = (1 / 8) ^ n * (1 / 8) ^ 2 := pow_add _ _ _
-  have hpow3 : (1 / 8 : ℝ) ^ (n + 3) = (1 / 8) ^ n * (1 / 8) ^ 3 := pow_add _ _ _
-  rw [hμ]
-  constructor
-  · have hr : 2 * (1 / 8 : ℝ) ^ (n + 3) ≤ r := by
-      rw [hpow3]
-      rw [hpow2] at hr1
-      nlinarith
-    calc C⁻¹ * min 1 (2 ^ s) * ρ ^ 3 * ρ ^ n = C⁻¹ * min 1 (2 ^ s) * ρ ^ (n + 3) := by ring
