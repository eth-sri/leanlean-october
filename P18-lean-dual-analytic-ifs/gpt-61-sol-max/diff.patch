-  intro x hx
-  have hxδ := ofReal_mem_nbhd hδ hx
-  refine tsum_congr fun k => ?_
-  obtain ⟨h1, h2⟩ := hiter k x hxδ
-  rw [hdk k hxδ, ← h1, hd1 (hδ2 h2), hd2 (hδ2 h2)]
-
-end AnalyticESC
