-    (hlt : ∀ x ∈ I, ‖deriv f x‖ < 1) : ∃ ε > 0, InClass ε f := by
-  -- the open set `{z ∈ U : 0 < |f'(z)| < 1}` contains the compact set `I`
-  set V := U ∩ deriv f ⁻¹' ({0}ᶜ ∩ ball 0 1)
