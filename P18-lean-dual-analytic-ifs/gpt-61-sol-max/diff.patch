-private theorem ld_deriv_f_zero (i : Fin 3) (hi : i ≠ 2) : deriv (exampleIFS.f i) 0 = 1 / 8 := by
-  rcases ld_fin_three i hi with rfl | rfl
-  · exact (ld_hasDerivAt_zero 0).deriv
-  · rw [(ld_hasDerivAt_one 0).deriv]
-    norm_num
