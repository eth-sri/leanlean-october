-      exampleIFS.supDeriv w ≤ 2 * (1 / 8 : ℝ) ^ w.length := by
-  constructor
-  · have h := exampleIFS.norm_deriv_le_supDeriv w (x := 0) (left_mem_Icc.2 zero_le_one)
