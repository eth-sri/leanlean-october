-private theorem mapsTo_iterate_closure (n : ℕ) :
-    MapsTo (f^[n]) (closure (nbhd ε)) (closure (nbhd ε)) := by
-  rw [← koenigsIFS_comp hε hf]
-  exact (koenigsIFS hε hf).mapsTo_comp_closure _
