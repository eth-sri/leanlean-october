-/-- `log c_min ≤ log |f_i'(x)| ≤ log c_max` for `x ∈ I`. -/
-private theorem dim_log_abs_deriv_realMap_mem (hN : 0 < N) (i : Fin N) {x : ℝ} (hx : x ∈ I) :
-    Real.log Φ.cmin ≤ Real.log |deriv (Φ.realMap i) x| ∧
-      Real.log |deriv (Φ.realMap i) x| ≤ Real.log Φ.cmax := by
