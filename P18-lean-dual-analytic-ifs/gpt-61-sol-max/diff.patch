-  have hd2 : EqOn (deriv (deriv f)) (deriv (deriv g)) (nbhd (2 * δ)) := hd1.deriv hU
-  have hdk : ∀ k, EqOn (deriv (f^[k])) (deriv (g^[k])) (nbhd δ) :=
