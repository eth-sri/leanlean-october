-      ⟨ε', ⟨g, hε', hg⟩, rfl, fun _ => hΨ (⟨g, hε', hg⟩ : IFS N ε') hfg⟩⟩
-  · -- Density, by the interpolation and the density step.
-    rintro f ⟨ε, hε, hf⟩ r hr
-    let Φ : IFS N ε := ⟨f, hε, hf⟩
-    rcases Nat.eq_zero_or_pos N with rfl | hN
