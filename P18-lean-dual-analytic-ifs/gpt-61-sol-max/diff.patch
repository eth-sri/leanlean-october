-  · have hr : r < 29 / 32 * (1 / 8 : ℝ) ^ n := by
-      rw [hpow1] at hr2
-      nlinarith
-    calc _ ≤ C * max 1 (2 ^ s) * ρ ^ (n + 1) := hup n r hr
-      _ = C * max 1 (2 ^ s) * ρ * ρ ^ n := by ring
-
-end AnalyticESC
