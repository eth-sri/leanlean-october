-/-- The natural projection is continuous. -/
-theorem continuous_natProj : Continuous Φ.natProj := by
-  refine TendstoUniformly.continuous
-    (F := fun n ω => (Φ.comp (List.ofFn fun k : Fin n => ω k) 0).re) (p := atTop) ?_
