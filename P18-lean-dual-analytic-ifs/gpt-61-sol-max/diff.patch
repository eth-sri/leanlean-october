-  exact ⟨ε, hε, InClass.of_deriv hε (hd.mono h2) (fun x hx => him x (h2 hx)) hI
-    (fun z hz => (hcl hz).2.1) (fun z hz => mem_ball_zero_iff.1 (hcl hz).2.2)⟩
-
