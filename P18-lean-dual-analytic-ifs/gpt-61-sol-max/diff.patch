-/-- Points at distance at least `ρ` from `y` have `t = (x - y)²/ρ³ ≥ 1/ρ`. -/
-theorem one_div_le_of_le_abs {ρ x k : ℝ} (hρ : 0 < ρ) (h : ρ ≤ |x - k|) :
-    1 / ρ ≤ (x - k) ^ 2 / ρ ^ 3 := by
-  have h2 : ρ ^ 2 ≤ (x - k) ^ 2 := by
-    have := pow_le_pow_left₀ hρ.le h 2
-    rwa [sq_abs] at this
-  rw [div_le_div_iff₀ hρ (pow_pos hρ 3)]
-  nlinarith
