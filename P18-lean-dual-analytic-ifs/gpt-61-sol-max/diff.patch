-/-- The system consisting of the single map `f`. -/
-private def uniqIFS {ε : ℝ} {f : ℂ → ℂ} (hε : 0 < ε) (hf : InClass ε f) : IFS 1 ε :=
-  ⟨fun _ => f, hε, fun _ => hf⟩
