-    congr 1
-    funext i
-    rw [image_image, image_image]
-    congr 1
-    funext g
-    exact ClosedAnalyticSpace.restrict_op Φ i g
-  · intro Λ hΛ
-    obtain ⟨L, hL, hLR⟩ := Φ.lift_dualAttractor hΛ
-    rw [← hL, hunique L hLR]
-
-end IFS
-
-end AnalyticESC
