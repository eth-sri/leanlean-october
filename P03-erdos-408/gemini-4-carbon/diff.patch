-  obtain ⟨D,hD,hb⟩ := primeWeighted_error_bound (B+2*A+2)
-  refine ⟨15*D+8,by positivity,?_⟩
-  intro q _ χ hp x hx hL hpower hq
-  let L := Real.log x
-  let K := A+2
-  let a := B+2*A+2
-  let Q := ((q:ℝ)+2)^(1/2:ℝ)
-  let h := x/L^K
