-/-- The integration-by-parts identity (#1583), with explicit qualifiers. -/
-theorem log_zeta_eq_integ_aux (s : ℝ) (hs : 1 < s) :
-    Real.log (riemannZeta (s:ℂ)).re =
-      (s - 1) * ∫ x in Set.Ioi 1, (Real.log (Real.log x) + γ + E₂Λ x) * x ^ (-s) := by
