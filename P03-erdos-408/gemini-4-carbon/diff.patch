-private theorem log_zeta_eq_integ (s : ℝ) (hs : 1 < s) :
-    log (riemannZeta (s:ℂ)).re = (s - 1) * ∫ x in .Ioi 1, (log (log x) + γ + E₂Λ x) * x^(-s) :=
-  LogZetaInteg.log_zeta_eq_integ_aux s hs
