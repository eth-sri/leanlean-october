-  -- the L-series of `μ χ` inverts `L(s, χ)`
-  have hmul : LFunction χ s * LSeries (↗χ * ↗μ) s = 1 := by
-    rw [LFunction_eq_LSeries χ hs]
-    exact LSeries.mul_mu_eq_one χ hs
