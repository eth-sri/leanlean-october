-          have h2 : |log (log 2)| ≤ |log (log 2)| * x ^ ε := le_mul_of_one_le_right (abs_nonneg _) hx1
-          have h1 : x ^ ε / ε = 1 / ε * x ^ ε := by ring
-          rw [add_mul]; linarith
