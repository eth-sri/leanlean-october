-    simp only [f]
-    rw [Finset.sum_mul]
-    have hx0 : (0:ℝ) ≤ x := by have := hx; simp only [Set.mem_Ioi] at this; linarith
-    rw [tsum_eq_sum (s := Finset.Ioc 0 ⌊x⌋₊) ?_]
-    · apply Finset.sum_congr rfl
-      intro d hd
-      simp only [Finset.mem_Ioc] at hd
-      have hdx : (d:ℝ) ≤ x := by
-        rw [← Nat.le_floor_iff hx0]; exact hd.2
