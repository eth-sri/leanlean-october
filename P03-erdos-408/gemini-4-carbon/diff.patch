-theorem siegelWalfisz : SiegelWalfisz := by
-  intro A B hA hB
-  obtain ⟨M,hM,hb⟩ := primeCharacterError_log_bound A B hA hB
-  have hevent : ∀ᶠ x : ℝ in atTop, 2≤x ∧ 1≤Real.log x ∧ (Real.log x)^(2*A+2)≤x := by
