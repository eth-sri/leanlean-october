-  unfold signedTaylorCoeff
-  have hd := iteratedDeriv_sub (n:=n) hF.contDiffAt hG.contDiffAt
-  change iteratedDeriv n (fun s => F s-G s) 2 = _ at hd
-  rw [hd,mul_sub,Complex.sub_re]
