-    DirichletCharacter.LFunctionTrivChar,DirichletCharacter.LFunction_modOne_eq] at h
-  have hn : s-1 ≠ 0 := sub_ne_zero.mpr hs1
-  apply (mul_left_cancel₀ hn)
-  rw [mul_sub,mul_div_cancel₀ _ hn]
-  linear_combination -h
