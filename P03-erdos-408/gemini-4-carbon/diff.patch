-/-- `(s - 1) L(s, χ₀)` has no zeros on `re s > 7/8`. -/
-lemma trivReg_ne_zero {k : ℕ} [NeZero k] {s : ℂ} (hs : 7 / 8 < s.re) : trivReg k s ≠ 0 := by
