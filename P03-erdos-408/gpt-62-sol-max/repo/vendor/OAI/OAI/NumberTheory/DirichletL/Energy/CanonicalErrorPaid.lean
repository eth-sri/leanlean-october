    (∑i:CenteredMomentCommonProfile.liveIndices (castAllocation s t h C B).val,f i.val)=
      ∑i:CenteredMomentCommonProfile.liveIndices B.val,f i.val:=rfl

omit instα in
lemma restored_preVolume (s:Input α)(C R:Ideal O)
