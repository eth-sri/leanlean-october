module

public import OAI.NumberTheory.DirichletL.Reflection.TupleMembers
public import OAI.NumberTheory.DirichletL.Reflection.SectorData

@[expose] public section

namespace OAI.SevenEighths.InverseReflectedPhase

open scoped Classical BigOperators
open ActualEisensteinCubic CubicEisenstein CompletedGauss CanonicalQuadraticSieve InverseMoment
noncomputable section
local notation "Eis" => ActualEisensteinCubic.O

/-- Energy bound for a sector whose slots are indexed by tuples rather than products. -/
abbrev MemberTupleEnergy {φ σ : Type*} [Fintype φ] [Fintype σ] {N a c : Eis} {mode : Bool}
    (G : PrimeFamily φ) (rows : Finset (Ideal Eis)) (hrows : ∀ K∈rows,Admissible K)
    (tuples : Finset (σ→Ideal Eis)) (hne : tuples.Nonempty)
    (hmax : ∀ p∈tuples,∀ i,(p i).IsMaximal)
    (hgood : ∀ p∈tuples,∀ i,ConcretePrimeRowBridge.goodLambda∉p i)
    (hinj : Set.InjOn slotTupleProduct (↑tuples : Set (σ→Ideal Eis)))
    (s : FixedCuspShape (ControlledStratumArithmetic.fixedCusp a c mode)) (hc : c≠0)
    (j : φ→ℕ) (W : ℝ→ℂ) (X QK QP : ℝ) (E : ℝ→ℝ) : Prop :=
  let S := tuplePrimeFamily tuples hne hmax hgood
  let Pset := tuples.image slotTupleProduct
  WithSectorFamilies N G rows Pset S <|
  ∃ D : ∀ K : rows,∀ P : Pset,IsCoprime K.val P.val→
      ControlledStratumArithmetic (G.reflected K.val (hrows K.val K.property) (S P.val)).generator N a c mode,
    ∀ (θ : ℝ) (r : Ideal Eis→ℂ) (aw : (σ→Ideal Eis)→ℂ),
      1≤QK → 2≤QP →
      (∀ K∈rows,QK/2≤(Ideal.absNorm K:ℝ) ∧ (Ideal.absNorm K:ℝ)≤QK) →
      (∀ P∈Pset,CubicSieve.Admissible P ∧ QP/2≤(Ideal.absNorm P:ℝ) ∧ (Ideal.absNorm P:ℝ)≤QP) →
      (∀ K∈rows,‖r K‖≤1) → (∀ p∈tuples,‖aw p‖≤1) →
      (∑ K : rows,‖memberTupleRow tuples hmax hgood G K.val (hrows K.val K.property) hne hinj (D K) s hc j W θ X r aw‖^2)≤E θ

end
end OAI.SevenEighths.InverseReflectedPhase
