+    ∫ t : ℝ, Perron.f y ((2 : ℝ) + t * I) = 0 := by
+  have h := Perron.formulaLtOne (σ := 2) hy0 hy (by norm_num)
+  rw [VerticalIntegral, smul_eq_mul] at h
+  simpa using h
