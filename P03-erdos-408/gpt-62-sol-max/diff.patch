+/-- Window parameters common to the canonical main and error energy estimates. -/
+structure CanonicalEnergyWindow (α : Type*) where
+  Wslot : ℝ→ℂ
+  aslot : ℝ
+  bslot : ℝ
+  Mcap : ℝ
+  Lslot : ℝ
+  εremove : ℝ
+  lo : ℝ
+  hi : ℝ
