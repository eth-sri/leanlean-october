+  obtain ⟨I,hI,heI⟩ := Finset.mem_image.mp (hsub (divisorDyadicBin_subset rows Hrow i hK))
+  obtain ⟨hIp,hpow,hmask⟩ := Finset.mem_filter.mp hI
+  obtain ⟨hI0,hIn⟩ := hparents I hIp
