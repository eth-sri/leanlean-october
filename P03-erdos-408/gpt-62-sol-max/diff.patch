+/-- Threshold ensuring that the tilted weights and logarithmic bounds apply. -/
+def edgeLogThreshold (F : FixedData) : ℝ := max 3 (Real.exp (10 * (taylorTerms F).factorial))
+
+lemma edge_log_gates {F : FixedData} {x : ℝ} (hx : edgeLogThreshold F ≤ x) :
+    1 < L x ∧ (10 * ((taylorTerms F).factorial : ℝ)) ≤ L x := by
+  refine ⟨one_lt_L ((le_max_left _ _).trans hx), ?_⟩
+  have h := Real.log_le_log (Real.exp_pos _) ((le_max_right _ _).trans hx)
+  rwa [Real.log_exp] at h
+
+lemma edge_tilted_bounds {F : FixedData} {P : PrimeGroups} {x : ℝ}
+    (hP : P.Admissible F x) (hL : 1 < L x) (hN : 10 * ((taylorTerms F).factorial : ℝ) ≤ L x) :
+    (∀ (g : P.BigGroup) (p : P.Prime g.val), 0 ≤ tiltedMu F P (N x) g.val p) ∧
+    (∀ g : P.BigGroup, ∑ p : P.Prime g.val, tiltedMu F P (N x) g.val p ≤ 2) :=
+  ⟨fun g p => (tiltedMu_pos hL.le hP (N x) rfl hN g p).le,
+    fun g => tiltedMu_sum_le_two hL.le hP (N x) rfl hN g⟩
+
+lemma big_group_pow {F : FixedData} {P : PrimeGroups} {x C : ℝ}
+    (hP : P.Admissible F x) (hL : 1 < L x) (hC : 1 ≤ C) :
+    C ^ Fintype.card P.BigGroup ≤ (L x) ^ (F.C₀ * Real.log C) := by
+  apply pow_groups_le_rpow hC hL
+  simpa [PrimeGroups.bigGroups, Fintype.card_subtype, T] using hP.2.2.2.1
+
+lemma small_group_pow {F : FixedData} {P : PrimeGroups} {x C : ℝ}
+    (hP : P.Admissible F x) (hL : 1 < L x) (hC : 1 ≤ C) :
+    C ^ Fintype.card P.SmallGroup ≤ (L x) ^ (F.C₀ * Real.log C) := by
+  apply pow_groups_le_rpow hC hL
+  simpa [PrimeGroups.smallGroups, Fintype.card_subtype, T] using hP.2.1
+
+/-- Absorb both finite products of group constants into the logarithmic exponent. -/
+lemma pattern_group_powers_le {F : FixedData} {P : PrimeGroups} {x a C₁ Cbig Csmall : ℝ}
+    (hP : P.Admissible F x) (hL : 1 < L x) (ha : a ≤ (L x)^C₁)
+    (hCb : 1 ≤ Cbig) (hCs : 1 ≤ Csmall) :
+    a * Cbig ^ Fintype.card P.BigGroup * Csmall ^ Fintype.card P.SmallGroup ≤
+      (L x) ^ (C₁ + F.C₀ * Real.log Cbig + F.C₀ * Real.log Csmall) := by
+  have hb := big_group_pow hP hL hCb
