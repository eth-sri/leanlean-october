+    (hPnorm : ∀ p∈tuples,CubicSieve.Admissible (slotTupleProduct p) ∧ (Ideal.absNorm (slotTupleProduct p):ℝ)≤Hslot)
+    (hinj : Set.InjOn slotTupleProduct (↑tuples : Set (σ→Ideal Eis)))
