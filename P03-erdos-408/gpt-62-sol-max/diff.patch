-def omega (n : ℤ) : ℕ := ∑ g, P.omegaGroup g n
 
-abbrev BigGroup := {g : P.Group // P.big g = true}
-abbrev BigLabels (M : ℕ) := (g : P.BigGroup) → Fin M → P.Prime g.val
