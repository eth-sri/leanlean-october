+abbrev ReflectionWindow (robust : Bool) (Z width X₁ X₂ ell κ defect : ℝ) : Prop :=
+  if robust then
+    5 * width / 6 - defect ≤ Real.logb Z (X₁ * X₂) + ell ∧
+    Real.logb Z (X₁ * X₂) + ell + (6 * κ - 1) * ell ≤ width
