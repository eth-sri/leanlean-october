   (r : ℝ) ≤ K₀ + CN * Real.log (Real.log (Real.log x)) ∧ (∀ i, alo ≤ a i ∧ a i ≤ ahi) ∧
     ∀ i j, i ≠ j → Disjoint (band x (a i)) (band x (a j))
 
