+    rw [Nat.ceil_le]
+    exact_mod_cast hp.two_le
+
+/-- `primesIcc 2 w` and `primesIoc 1 w` are both the primes up to `w`. -/
+lemma primesIcc_two_eq (w : ℝ) : primesIcc 2 w = primesIoc 1 w := by
+  ext p
+  rw [mem_primesIcc_two, mem_primesIoc_one]
+
 end Erdos408
