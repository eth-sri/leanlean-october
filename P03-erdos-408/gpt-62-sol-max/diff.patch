+      (QuadraticMainBoundary.norm_one_le (squarefreeMaskPart_ne_zero (rowSimplePart I) Q)))
+  exact ⟨I,hI0,hIn,hpow.symm,hmask.symm,by linarith,by linarith [hres.trans hIn]⟩
+
+end
