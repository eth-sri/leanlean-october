+/-- The line integral of the Perron kernel at `y > 1` is `2π (1 - 1/y)`. -/
+private theorem integral_perron_f_of_one_lt {y : ℝ} (hy : 1 < y) :
+    ∫ t : ℝ, Perron.f y ((2 : ℝ) + t * I) = 2 * Real.pi * (1 - 1 / y) := by
