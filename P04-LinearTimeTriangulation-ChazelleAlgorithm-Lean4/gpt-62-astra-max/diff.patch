new file mode 100644
index 000000000..b1eda0b75
--- /dev/null
+++ b/Chazelle/Geometry/Direction.lean
@@ -0,0 +1,27 @@
+module
+
+public import Chazelle.Spec
+
+@[expose] public section
+namespace Chazelle
+
+/-- A signed unit direction, as used to distinguish the two sides of an edge or ray. -/
+abbrev UnitSign (σ : ℝ) : Prop := σ = 1 ∨ σ = -1
+
+@[simp] theorem UnitSign.one : UnitSign 1 := Or.inl rfl
+
+@[simp] theorem UnitSign.neg_one : UnitSign (-1) := Or.inr rfl
+
+theorem UnitSign.neg {σ} (h : UnitSign σ) : UnitSign (-σ) := by
+  rcases h with rfl | rfl <;> simp
+
+theorem UnitSign.mul_self {σ} (h : UnitSign σ) : σ * σ = 1 := by
+  rcases h with rfl | rfl <;> norm_num
+
+theorem UnitSign.abs_eq {σ} (h : UnitSign σ) : |σ| = 1 := by
+  rcases h with rfl | rfl <;> simp
+
+theorem UnitSign.ne_zero {σ} (h : UnitSign σ) : σ ≠ 0 := by
+  rcases h with rfl | rfl <;> norm_num
+
+end Chazelle
diff --git a/Chazelle/Machine/Contract.lean b/Chazelle/Machine/Contract.lean
new file mode 100644
index 000000000..1510ada84
--- /dev/null
+++ b/Chazelle/Machine/Contract.lean
@@ -0,0 +1,25 @@
+module
+
+public import Chazelle.Machine.Structured
+
+/-! # Postconditions of costed statements
+
+`RunsWithin` is the usual upper-bound specification. `RunsFor` records an exact cost,
+which is useful for straight-line blocks. Both expose the execution witness when composing
+blocks and make the final configuration available in the postcondition. -/
+
+@[expose] public section
+namespace Chazelle.Machine
+
+abbrev ExecPost (P : Polygon) (W : ℕ) (s : Stmt) (c : Config)
+    (post : Config → ℕ → Prop) : Prop := ∃ d k, Exec P W s c d k ∧ post d k
+
+abbrev RunsWithin (P : Polygon) (W : ℕ) (s : Stmt) (c : Config) (bound : ℕ)
+    (post : Config → Prop) : Prop :=
+  ExecPost P W s c fun d k => k ≤ bound ∧ post d
+
+abbrev RunsFor (P : Polygon) (W : ℕ) (s : Stmt) (c : Config) (cost : ℕ)
+    (post : Config → Prop) : Prop :=
+  ExecPost P W s c fun d k => k = cost ∧ post d
+
+end Chazelle.Machine
diff --git a/Chazelle/Machine/Frames.lean b/Chazelle/Machine/Frames.lean
new file mode 100644
index 000000000..64d9d8ca9
--- /dev/null
+++ b/Chazelle/Machine/Frames.lean
@@ -0,0 +1,38 @@
+module
+
+public import Chazelle.Spec
+
+/-! # Vocabulary for frame conditions
+
+An array may change on a write set; typical clients read below a frontier, inside an
+untouched band, or away from a short list of destination registers. The last predicate is
+curried in the non-aliasing proofs so that a client at a known index need not build lists
+of membership proofs. -/
+
+@[expose] public section
+namespace Chazelle
+
+abbrev AgreeBelow {α : Type*} (n : ℕ) (f g : ℕ → α) : Prop := ∀ i < n, f i = g i
+
+abbrev AgreeOnBand {α : Type*} (lo hi : ℕ) (f g : ℕ → α) : Prop :=
+  ∀ i ≥ lo, i < hi → f i = g i
+
+/-- Guard a read at `i` against each destination of a block. -/
+@[reducible, simp] def OffWrites (i : ℕ) (Q : Prop) : List ℕ → Prop
+  | [] => Q
+  | j :: js => i ≠ j → OffWrites i Q js
+
+abbrev AgreeExcept {α : Type*} (writes : List ℕ) (f g : ℕ → α) : Prop :=
+  ∀ i, OffWrites i (f i = g i) writes
+
+/-- A block writing only natural-number state leaves the real state and the output alone. -/
+abbrev Config.NatFrame (d c : Config) : Prop :=
+  d.rreg = c.rreg ∧ d.rmem = c.rmem ∧ d.output = c.output
+
+abbrev Config.NRegFrame (d c : Config) : Prop := d.nmem = c.nmem ∧ d.NatFrame c
+
+/-- Right-associated sequencing, for both structured programs and their execution proofs. -/
+scoped syntax:60 term:61 " ;; " term:60 : term
+macro_rules | `($a ;; $b) => `(.seq $a $b)
+
+end Chazelle
diff --git a/Chazelle/Programs/Address.lean b/Chazelle/Programs/Address.lean
new file mode 100644
index 000000000..6f1c90f29
--- /dev/null
+++ b/Chazelle/Programs/Address.lean
@@ -0,0 +1,69 @@
+module
+
+public meta import Lean.Elab.Tactic.Omega
+public meta import Lean.Elab.Tactic.Simp
+public meta import Lean.Util.FoldConsts
+public import Mathlib.Tactic.Linarith
+
+/-!
+# Arithmetic of register addresses
+
+Register names, offsets, and tests for membership in scratch bands are defined close to
+individual programs. To compare addresses we need their arithmetic meanings, but not the
+implementations of the program, machine, or geometry in the surrounding context.
+-/
+
+public meta section
+namespace Chazelle.Programs
+open Lean Meta Elab Tactic
+
+private def scalar : Expr → Bool
+  | .forallE _ t b _ => (t.isConstOf ``Nat || t.isConstOf ``Bool) && scalar b
+  | t => t.isConstOf ``Nat || t.isConstOf ``Bool || t == .sort .zero
+
+/-- Collect the scalar definitions mentioned in a register calculation, including those in
+another address definition. Ignore recursive functions. -/
+private partial def addresses (env : Environment) (ns : Array Name) (seen : NameSet) : NameSet :=
+  ns.foldl (init := seen) fun s n => Id.run do
+    unless n.getRoot == `Chazelle && !s.contains n do return s
+    let some (.defnInfo d) := env.find? n | return s
+    unless scalar d.type do return s
+    let deps := d.value.getUsedConstants
+    if deps.contains n || deps.any (fun a => a matches .str _ "rec" | .str _ "brecOn") then
+      return s
+    return addresses env deps (s.insert n)
+
+/-- Unfold the vocabulary of a register bound and solve its Presburger arithmetic. -/
+elab "address_omega" : tactic => do
+  evalTactic (← `(tactic| intros))
+  withMainContext do
+    let env ← getEnv
+    let mut ds := addresses env (← getMainTarget).getUsedConstants {}
+    for d in ← getLCtx do
+      unless d.isImplementationDetail do ds := addresses env d.type.getUsedConstants ds
+    let ids := (ds.toList ++ [``Bool.or_eq_true, ``Bool.or_eq_false_iff, ``Bool.and_eq_true,
+      ``decide_eq_true_eq, ``decide_eq_false_iff_not]).map mkIdent |>.toArray
+    let ss ← ids.mapM fun i => `(Parser.Tactic.simpLemma| $i:ident)
+    evalTactic (← `(tactic| (simp (config := {failIfUnchanged := false}) only
+      [$ss,*] at * <;> omega)))
+
+private def dischargeGuards (arg : Term) : TermElabM Expr := do
+  let mut e ← Term.elabTerm arg none
+  let mut t ← inferType e
+  while !t.isAppOf ``Not do
+    let .forallE _ d b _ ← whnf t | break
+    unless ← isProp d do break
+    let h ← Term.elabTerm (← `(by first | assumption | rfl | decide | omega | address_omega | linarith)) d
+    e := mkApp e h
+    t := b.instantiate1 h
+  return e
+
+/-- Read a fact about an array cell or register at a particular index. Its guards (range,
+non-aliasing, scratch membership, etc.) are proof arguments, discharged in the caller's
+context. Keeping them as tactic obligations allows the index itself to be inferred by a rewrite. -/
+elab "at_index " f:term:max i:term:max : term => do dischargeGuards (← `($f $i))
+
+/-- Apply a guarded lemma that does not require an index argument. -/
+elab "guarded " f:term:max : term => dischargeGuards f
+
+end Chazelle.Programs
diff --git a/Chazelle/Programs/Evidence.lean b/Chazelle/Programs/Evidence.lean
new file mode 100644
index 000000000..044308908
--- /dev/null
+++ b/Chazelle/Programs/Evidence.lean
@@ -0,0 +1,97 @@
+module
+
+public import Chazelle.Programs.Address
+public import Chazelle.Cost.Invariant
+public meta import Lean.Elab.Tactic.Rewrite
+
+/-! # Applying a verification rule from its data
+
+Many rules interleave data (a program, register or index) with proofs of range, frame
+and invariant conditions. In a context already containing those facts, only the data
+distinguish the application (inferable trailing data can be omitted). `from_facts (rule data …)` elaborates an ordinary application
+of `rule`, solving the explicit proof arguments. An optional list supplies additional
+facts, for example fields of an invariant. Named arguments work as usual. -/
+
+public meta section
+namespace Chazelle.Programs
+open Lean Meta Elab Term Tactic
+
+/-- Read a fact from a hypothesis or one of its proof fields. For an indexed fact,
+instantiate the index by matching the goal and check the remaining guards locally. -/
+elab "local_fact" : tactic => withMainContext do
+  let g ← getMainGoal
+  let target ← instantiateMVars (← g.getType)
+  let mut ps : Array (Expr × Expr) := #[]
+  for d in (← getLCtx).decls.toList.reverse do
+    if let some d := d then
+      if !d.isImplementationDetail && (← isProp d.type) then
+        ps ← Cost.foldFields (fun p t acc => acc.push (p,t)) (·.size ≥ 160) d.toExpr d.type 16 ps
+  for (p,t) in ps do
+    if t.getAppFn == target.getAppFn && (← isDefEq t target) then
+      g.assign p; replaceMainGoal []; return
+  for (p,t) in ps do
+    unless t.isForall && t.getForallBody.getAppFn == target.getAppFn do continue
+    let saved ← saveState
+    try
+      replaceMainGoal (← g.apply p)
+      evalTactic (← `(tactic| all_goals first | assumption | rfl | decide | omega))
+      return
+    catch _ => saved.restore
+  throwError "no matching local fact"
+
+/-- Reassemble a postcondition (a conjunction or proof record) from the available facts.
+Do not try arbitrary inductive constructors when an arithmetic obligation remains. -/
+elab "record_facts" : tactic => do
+  let rec solve : Nat → TacticM Unit
+    | 0 => throwError "postcondition nested too deeply"
+    | depth+1 => withMainContext do
+      try evalTactic (← `(tactic| first | assumption | rfl | local_fact)); return
+      catch _ => pure ()
+      let t ← whnf (← getMainTarget)
+      if t.getAppFn.isConst && (← isProp t) && (getStructureInfo? (← getEnv) t.getAppFn.constName!).isSome then
+        let gs ← (← getMainGoal).constructor
+        for g in gs do setGoals [g]; solve depth
+      else evalTactic (← `(tactic| first | decide | omega | address_omega))
+  focus (solve 24)
+
+/-- Rewrite at the index selected by the match, checking a rule's side conditions before
+applying the next rewrite. This is useful for reads across guarded writes and for
+bounds that depend on a matched index. -/
+elab "rw_facts" rs:Lean.Parser.Tactic.rwRuleSeq loc:(Lean.Parser.Tactic.location)? : tactic => focus do
+  let place := expandOptLocation (mkOptionalNode loc)
+  withRWRulesSeq (← getRef)[0] rs fun symm term => do
+    withLocation place (rewriteLocalDecl term symm ·) (rewriteTarget term symm)
+      (fun _ => throwError "no matching occurrence")
+    let main :: guards ← getGoals | return
+    setGoals guards
+    evalTactic (← `(tactic| all_goals first | assumption | rfl | decide | omega | local_fact | address_omega))
+    unless (← getUnsolvedGoals).isEmpty do throwError "unsolved rewrite condition"
+    setGoals [main]
+  evalTactic (← `(tactic| try rfl))
+
+elab "from_facts " t:term:max hs:(" [" term,* "]")? : term <= goal => do
+  let t := if t.raw.isOfKind ``Parser.Term.paren then t.raw[1] else t.raw
+  let (head, args) := if t.isOfKind ``Parser.Term.app then (t[0], t[1].getArgs) else (t, #[])
+  let (named, data) := args.partition (·.isOfKind ``Parser.Term.namedArgument)
+  let f ← if head.isIdent then
+    match ← resolveId? head (withInfo := false) with
+    | some e => pure e
+    | none => elabTerm head none
+  else elabTerm head none
+  let extras : Array Term := hs.map (fun h => h.raw[1].getSepArgs.map (⟨·⟩)) |>.getD #[]
+  let hints ← extras.mapM fun e => `(tactic| exact $e)
+  let pf ← `(by first | assumption $[| $hints:tactic]* | rfl | local_fact | decide | omega | address_omega)
+  let filled ← forallTelescope (← inferType f) fun xs _ => do
+    let mut res := named
+    let mut i := 0
+    for x in xs do
+      let d ← x.fvarId!.getDecl
+      unless d.binderInfo.isExplicit && !named.any (fun a => a[1].getId == d.userName) do continue
+      if ← isProp d.type then res := res.push pf.raw
+      else if let some a := data[i]? then res := res.push a; i := i+1
+      else res := res.push (← `(_)).raw
+    if i != data.size then throwError "too many data arguments"
+    return res
+  elabTermEnsuringType (mkNode ``Parser.Term.app #[head, mkNullNode filled]) goal
+
+end Chazelle.Programs
diff --git a/Chazelle/Programs/ReadWords.lean b/Chazelle/Programs/ReadWords.lean
new file mode 100644
index 000000000..ac245c9f9
--- /dev/null
+++ b/Chazelle/Programs/ReadWords.lean
@@ -0,0 +1,41 @@
+module
+
+public import Chazelle.Machine.Basic
+public import Chazelle.Programs.Evidence
+
+/-! # Reading a word through intermediate configurations
+
+Postconditions give both concrete values of cells and frames saying which other
+cells retain their values. To recover a word after several commands, follow these
+equations back through the preceding configurations. The same equations may reside
+in the proof fields of an environment, rather than in separate hypotheses.
+-/
+
+public meta section
+namespace Chazelle.Programs
+open Lean Meta Elab Tactic Machine
+
+private def word (e : Expr) : Bool :=
+  [``Config.nmem, ``Config.nreg, ``Config.rmem, ``Config.rreg, ``Config.output].contains
+    e.getAppFn.constName!
+
+/-- Normalize word reads using the known cells, frame equations and write equations. -/
+elab "read_words" : tactic => withMainContext do
+  let mut facts : Array (Expr × Expr) := #[]
+  for d in (← getLCtx).decls.toList.reverse do
+    if let some d := d then
+      if !d.isImplementationDetail && (← isProp d.type) then
+        facts ← Cost.foldFields (fun p t a => a.push (p,t)) (·.size ≥ 480) d.toExpr d.type 16 facts
+  let mut ss := #[]
+  for (p,t) in facts do
+    let use ← forallTelescopeReducing t fun _ tail => do
+      let some (_,l,_) := tail.eq? | return false
+      return l.getAppFn.isConst && word l
+    if use then
+      let h ← Term.exprToSyntax p
+      ss := ss.push (← `(Parser.Tactic.simpLemma| $h:term))
+  evalTactic (← `(tactic| solve | simp (config := {maxSteps := 4000})
+    (disch := first | assumption | decide | omega | address_omega) only
+    [upd_same, upd_other, $ss,*]))
+
+end Chazelle.Programs
diff --git a/Chazelle/Programs/RegisterProof.lean b/Chazelle/Programs/RegisterProof.lean
new file mode 100644
index 000000000..b6b610a82
--- /dev/null
+++ b/Chazelle/Programs/RegisterProof.lean
@@ -0,0 +1,44 @@
+module
+public import Chazelle.Programs.Verification
+
+/-! # Symbolic evaluation of natural-register blocks
+
+The register-only evaluator describes its effect as a succession of point writes.
+Reduce the instruction lists, distribute the postcondition, then normalize each read.
+The hypothesis at a symbolic address supplies the non-aliasing test; at a literal
+address the test is just a computation.
+-/
+public meta section
+namespace Chazelle.Programs
+open Lean Elab Tactic Meta Machine
+
+/-- Definitions of instruction lists and of their register semantics. Traverse the
+lists' dependencies, not the geometric functions computing individual operands. -/
+private partial def unfolds (env : Environment) (ns : Array Name) (seen : NameSet) : NameSet :=
+  ns.foldl (init := seen) fun s n => Id.run do
+    unless n.getRoot == `Chazelle && !s.contains n do return s
+    let some (.defnInfo d) := env.find? n | return s
+    let t := d.type.getForallBody
+    let list := t.isAppOfArity ``List 1 && t.appArg!.isConstOf ``Instr
+    let .str pre field := n | return s
+    let family := #["regB", "regI", "dstI", "okB", "okI"]
+    let evaluator := family.contains field
+    unless list || evaluator do return s
+    return unfolds env (d.value.getUsedConstants ++ (if evaluator then family.map (Name.str pre) else #[])) (s.insert n)
+
+elab "register_block" hs:(" [" Parser.Tactic.simpLemma,* "]")? : tactic => withMainContext do
+  let env ← getEnv
+  let mut ns := unfolds env (← getMainTarget).getUsedConstants {}
+  for d in ← getLCtx do
+    unless d.isImplementationDetail do ns := unfolds env d.type.getUsedConstants ns
+  let fs ← ns.toList.toArray.mapM fun n => `(Parser.Tactic.simpLemma| $(mkIdent n):ident)
+  let extra : Array (TSyntax ``Parser.Tactic.simpLemma) := hs.map (fun h => h.raw[1].getSepArgs.map (⟨·⟩)) |>.getD #[]
+  evalTactic (← `(tactic| (
+    simp (config := {failIfUnchanged := false}) only [$fs,*, $extra,*]
+    repeat' first | apply And.intro | intro
+    all_goals first | rfl | assumption | decide | solve |
+      simp (config := {failIfUnchanged := false})
+        (disch := first | assumption | decide | omega | address_omega) only
+        [upd_same, upd_other, *, $fs,*, $extra,*] <;> first | decide | assumption | omega | address_omega)))
+
+end Chazelle.Programs
diff --git a/Chazelle/Programs/RunProof.lean b/Chazelle/Programs/RunProof.lean
new file mode 100644
index 000000000..f45e81bb5
--- /dev/null
+++ b/Chazelle/Programs/RunProof.lean
@@ -0,0 +1,45 @@
+module
+
+public import Chazelle.Programs.Verification
+public meta import Lean.Elab.Tactic.RCases
+
+/-!
+# Strengthening execution specifications
+
+A write-mask theorem derives a frame from the execution itself. Discharge that conjunct
+separately from symbolic execution, without restating the spec and copying every register
+value from the first spec into the second.
+-/
+
+public meta section
+namespace Chazelle.Programs
+open Lean Meta Elab Tactic
+
+/-- Strip the final frame conjunct, using `pf` with the run named `e` to restore it. -/
+elab "frame_from " e:ident " => " pf:term : tactic => withMainContext do
+  let_expr Exists dc pred := ← whnf (← getMainTarget) | throwError "expected a run specification"
+  withLocalDeclD `d dc fun d => do
+    let_expr Exists kc post := pred.beta #[d] | throwError "expected a cost witness"
+    withLocalDeclD `k kc fun k => do
+      let mut t := post.beta #[k]
+      let mut parts := #[]
+      while t.isAppOfArity ``And 2 do
+        parts := parts.push t.appFn!.appArg!
+        t := t.appArg!.headBeta
+      unless parts.size ≥ 2 do throwError "expected a postcondition and a frame"
+      let body := parts.pop.foldr mkAnd parts.back!
+      let ty ← mkAppM ``Exists #[← mkLambdaFVars #[d] (← mkAppM ``Exists #[← mkLambdaFVars #[k] body])]
+      let premise ← Term.exprToSyntax ty
+      let mut names := #[← `(ident| d), ← `(ident| k), e]
+      for i in [1:parts.size] do names := names.push (← `(ident| $(mkIdent <| Name.mkSimple s!"__post{i}")))
+      let ps ← names.mapM fun id => `(rcasesPat| $id:ident)
+      let xs ← names.mapM fun id => `($id:ident)
+      evalTactic (← `(tactic| suffices prior : $premise by
+        obtain ⟨$ps,*⟩ := prior
+        exact ⟨$xs,*, $pf⟩))
+
+/-- Finish a specification with the given execution and the facts about its final state. -/
+macro "finish_run " e:term:max : tactic =>
+  `(tactic| (refine ⟨_, _, $e, ?_⟩; first | block_post | grind))
+
+end Chazelle.Programs
diff --git a/Chazelle/Programs/Verification.lean b/Chazelle/Programs/Verification.lean
new file mode 100644
index 000000000..2cf8c7cfc
--- /dev/null
+++ b/Chazelle/Programs/Verification.lean
@@ -0,0 +1,40 @@
+module
+
+public import Chazelle.Programs.Tactics
+public import Chazelle.Programs.Address
+
+/-! # Discharging block specifications
+
+In a straight-line proof there are three different kinds of obligations: bounds for the
+instructions, reads at known addresses, and frame conditions at an arbitrary address. The same
+read-over-write rules handle the last two, using arithmetic to establish non-aliasing.
+-/
+
+public section
+namespace Chazelle.Programs
+open Lean.Parser.Tactic
+
+/-- Rewrite using conditional register/memory equations, proving their side conditions. -/
+macro "frame_simp" "[" hs:simpLemma,* "]" : tactic =>
+  `(tactic| simp (disch := first | assumption | decide | omega) only
+    [Machine.upd_same, Machine.upd_other, $hs,*])
+
+/-- Discharge the bounds and postcondition after symbolic execution. The optional facts
+identify the input values of registers and cells for this block. -/
+macro "block_post" "[" more:simpLemma,* "]" : tactic =>
+  `(tactic| (repeat' first | apply And.intro | intro
+             all_goals first
+               | rfl | assumption
+               | solve | config_simp <;> omega
+               | (config_simp <;> simp (disch := first | assumption | decide | omega) only
+                    [Machine.upd_same, Machine.upd_other, *, $more,*] <;> first | omega | address_omega)))
+
+macro "block_post" : tactic => `(tactic| block_post [])
+
+/-- Verify a whole straight-line block. -/
+macro "verify_block" "[" hs:simpLemma,* "]" : tactic =>
+  `(tactic| (exec_block <;> block_post [$hs,*]))
+
+macro "verify_block" : tactic => `(tactic| verify_block [])
+
+end Chazelle.Programs
diff --git a/Chazelle/Visibility/DualTree.lean b/Chazelle/Visibility/DualTree.lean
deleted file mode 100644
index 8ba323744..000000000
--- a/Chazelle/Visibility/DualTree.lean
+++ /dev/null
@@ -1,3 +0,0 @@
-module
-public import Chazelle.Visibility.Submap
-public import Mathlib.Combinatorics.SimpleGraph.Acyclic
