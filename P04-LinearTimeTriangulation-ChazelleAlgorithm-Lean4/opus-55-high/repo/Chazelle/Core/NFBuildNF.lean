module

public import Chazelle.Core.NFBuildArcs

/-!
# WP-C (BuildNF): the normal form computed from the sorted events

`buildNF M Q L E` is the normal form that `BuildNF` computes from a chord list `L` and an ordering
`E` of the event codes (`2 i`: left endpoint of chord `i`, `2 i + 1`: right endpoint) sorted by
key and the tie rule (`BuildSort.EvLe`):

* chord records: the triples of `L`, with `up`/`dn` the region indices of the label before the
  chord's first event (outside) and of the chord itself (inside), `dn` inside iff the first event
  is the left endpoint;
* arc records: one per gap of the sorted keys (`kap S m < kap S (m + 1)`, and the wrapping gap),
  with the region index of the label after the gap's first event; for `K = 0` the single pinned
  arc `(0, 0)` of the root;
* region records `0` (root) and `i + 1` (inside chord `i`): their arcs, exit chords and weight;
* `seq`: the arcs in order (they are generated by increasing start key); no decomposition.

Main results: `BuildNF.Input.isNF` (`Chazelle.Core.NFBuildValid`) and
`BuildNF.isNF_goodModel` (`Chazelle.Core.NFBuildCmp`).
-/

namespace Chazelle.Core

namespace BuildNF

@[expose] public section

open Set List
open BuildSort (Ev EvLe kap cntBelow)
open BuildRegions (eL eR crec famOf e1 e2 kl kr gapLabel reg LabelOK)

/-- The event of an event code. -/
noncomputable def evOf (M : Model) (Q : Polygon) (L : List (ℕ × ℕ × ℕ)) (c : ℕ) : Ev :=
  if c % 2 = 0 then eL M Q L (c / 2) else eR M Q L (c / 2)

/-- The walk position of an event code. -/
def wposOf (L : List (ℕ × ℕ × ℕ)) (c : ℕ) : WPos :=
  if c % 2 = 0 then (crec L (c / 2)).lpos else (crec L (c / 2)).rpos

/-- The region index of a label. -/
def ridx : Option ℕ → ℕ
  | none => 0
  | some i => i + 1

/-- The label of a region index. -/
def lab (r : ℕ) : Option ℕ := if r = 0 then none else some (r - 1)

theorem lab_ridx (ℓ : Option ℕ) : lab (ridx ℓ) = ℓ := by
  cases ℓ <;> simp [lab, ridx]

theorem ridx_lab (r : ℕ) : ridx (lab r) = r := by
  unfold lab; split_ifs with h
  · rw [h]; rfl
  · simp only [ridx]; omega

variable (M : Model) (Q : Polygon) (L : List (ℕ × ℕ × ℕ)) (E : List ℕ)

/-- The sorted events. -/
noncomputable def evs : List Ev := E.map (evOf M Q L)

/-- The chord word. -/
noncomputable def word : List ℕ := (evs M Q L E).map Prod.fst

/-- The label outside chord `i` (before its first event). -/
noncomputable def outside (i : ℕ) : Option ℕ :=
  BuildStack.label (word M Q L E) ((evs M Q L E).idxOf (e1 M Q L i))

/-- The chord record of chord `i`. -/
noncomputable def chordRec (i : ℕ) : CRec :=
  { h := (L.getD i (0, 0, 0)).1, lp := (L.getD i (0, 0, 0)).2.1, rp := (L.getD i (0, 0, 0)).2.2,
    up := if kl M Q L i < kr M Q L i then ridx (outside M Q L E i) else i + 1,
    dn := if kl M Q L i < kr M Q L i then i + 1 else ridx (outside M Q L E i) }

/-- The gap starts: the indices `m` with `kap m < kap (m + 1)`, and the last index. -/
noncomputable def gapStarts : List ℕ :=
  (List.range E.length).filter fun m =>
    decide (m + 1 = E.length ∨ kap (evs M Q L E) m < kap (evs M Q L E) (m + 1))

/-- The arc record of the gap starting at `m`. -/
noncomputable def arcRec (m : ℕ) : ARec :=
  { reg := ridx (BuildStack.label (word M Q L E) (m + 1)),
    s := wposOf L (E.getD m 0), e := wposOf L (E.getD ((m + 1) % E.length) 0) }

/-- The arc records. -/
noncomputable def arcList : List ARec :=
  if L.length = 0 then [⟨0, ⟨0, 0⟩, ⟨0, 0⟩⟩] else (gapStarts M Q L E).map (arcRec M Q L E)

/-- The arcs of region `r`. -/
noncomputable def regArcs (r : ℕ) : List ℕ :=
  (List.range (arcList M Q L E).length).filter fun j =>
    decide (((arcList M Q L E).getD j ⟨0, ⟨0, 0⟩, ⟨0, 0⟩⟩).reg = r)

/-- The exit chords of region `r`. -/
noncomputable def regChords (r : ℕ) : List ℕ :=
  (List.range L.length).filter fun i =>
    decide ((chordRec M Q L E i).up = r ∨ (chordRec M Q L E i).dn = r)

/-- The weight of an arc record. -/
noncomputable def arcW (a : ARec) : ℕ := M.arcWt (M.key Q a.s) (M.key Q a.e)

/-- The weight of region `r`: the largest weight of its arcs. -/
noncomputable def regWt (r : ℕ) : ℕ :=
  ((regArcs M Q L E r).map fun j =>
    arcW M Q ((arcList M Q L E).getD j ⟨0, ⟨0, 0⟩, ⟨0, 0⟩⟩)).foldr max 0

/-- **The normal form computed by `BuildNF`.** -/
noncomputable def buildNF : NF where
  chords := (List.range L.length).map (chordRec M Q L E)
  arcs := arcList M Q L E
  regions := (List.range (L.length + 1)).map fun r =>
    ⟨regArcs M Q L E r, regChords M Q L E r, regWt M Q L E r⟩
  seq := List.range (arcList M Q L E).length
  dec := []
  root := 0
  lpar := []

end

end BuildNF

end Chazelle.Core
