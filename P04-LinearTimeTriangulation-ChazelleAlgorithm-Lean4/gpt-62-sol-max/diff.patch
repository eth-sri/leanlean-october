+      if read.getArg! 0 == c then
+        let fld := if read.isAppOf ``Config.nreg then ``And.left else ``And.right
+        let v := mkApp (← mkAppM fld #[hw]) (read.getArg! 1)
+        hs := hs.push {userName := ← mkFreshUserName `bound, type := ← inferType v, value := v}
