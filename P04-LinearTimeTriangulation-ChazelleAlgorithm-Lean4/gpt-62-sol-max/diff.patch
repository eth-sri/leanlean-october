+    (reserveBlock m ctr one).check (reserveFoot ctr).allows = true := by
+  induction m with
+  | zero => simp [reserveBlock, block, write_check, reserveFoot]
+  | succ m ih => simpa [reserveBlock, List.replicate_succ, block_cons, write_check, reserveFoot]
+      using ih
