+    ((chainModel C).param (Qof P) ⟨c.nreg 50201, c.nreg 50202⟩)
+    (Visibility.rayPt ((chainModel C).pos (Qof P) ⟨c.nreg 50201, c.nreg 50202⟩)
+      (dirOf (c.nreg 50203)) 1))
