+/-- Widening the register write sets or allowing natural stores preserves the check. -/
+theorem Footprint.widen {N R N' R' : ℕ → Bool} {b b' m o : Bool}
+    (hN : ∀ r, N r = true → N' r = true) (hR : ∀ r, R r = true → R' r = true)
