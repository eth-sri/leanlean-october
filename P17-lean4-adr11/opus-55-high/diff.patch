-    have e2' : #(cls_secondClass τ) = 6 := e2
-    rw [sh_read, e', e2', h, g4]
-    rfl
-  · -- `P₅`: `|𝒞| = 10`, four gene trees with a cherry in common
-    have e : #(cls_leastClass τ) = 10 := c5 h
