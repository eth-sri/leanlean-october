-  obtain ⟨c1, c2, c3, c5, c7, cp, cc, cb, c4, c6, c8, c9⟩ := appendixC_leastClass τ
-  obtain ⟨g1, g2, g3, g4, g5, g6, g7, g8, g9, gb, gc, gp⟩ := sh_groupOf_reps
