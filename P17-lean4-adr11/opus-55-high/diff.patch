-/-- Every cluster with at least two elements is the union of two disjoint clusters. -/
-def model_IsBinaryForest (F : Finset (Finset L)) : Prop :=
-  ∀ A ∈ F, 2 ≤ #A → ∃ B ∈ F, ∃ C ∈ F, Disjoint B C ∧ B ∪ C = A
