-/-- The shape groups of the representatives. -/
-theorem sh_groupOf_reps : sh_groupOf (polytomy5 1) = .p1 ∧ sh_groupOf (polytomy5 2) = .p2 ∧
-    sh_groupOf (polytomy5 3) = .p3 ∧ sh_groupOf (polytomy5 4) = .p48 ∧
