-    obtain ⟨h12, h18, h24, h84⟩ := (table6 σ).2.2.2.2.2.1 h
-    obtain ⟨-, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, e12, e13, e14, e15⟩ :=
-      rootingDist5_1_5 σ h
-    have q3 : u σ 3 = u σ 2 := by rw [e3, e2]
