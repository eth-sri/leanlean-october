-      rw [hu i hi, ite_eq_left hiC]
-      exact hba
-  refine ⟨h₁, ac1_secondClass_eq h₁ C a hC sdiff_disjoint hne fun i hi => ⟨fun h => ?_, ?_⟩⟩
-  · rw [hu i hi, ite_eq_left h]
-  · intro h1 h2
-    exact absurd (mem_sdiff.2 ⟨hi, h2⟩) h1
