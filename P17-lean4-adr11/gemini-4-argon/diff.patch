-def pseudo5Poly : ℕ → List (ℚ × List (ℕ × ℕ))
-  | 1 => [(1, []), (-2/3, [(3, 1)]), (-2/3, [(24, 1)]), (4/9, [(3, 1), (24, 1)]),
-      (-2/45, [(3, 1), (24, 1), (27, 6)])]
