-noncomputable def SpeciesTree.extendLength (σ : SpeciesTree X) (s : L → X) (B : Finset L) : ℝ :=
-  if h : ∃ A ∈ σ.clusters, (univ.filter fun l => s l ∈ A) = B ∧ 2 ≤ #B then
