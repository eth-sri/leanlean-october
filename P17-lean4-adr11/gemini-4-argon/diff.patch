+    rcases (show #(univ.filter fun l => s l = x) = 1 ∨ #(univ.filter fun l => s l = x) = 2 by
+      have := h2 x; omega) with h1 | h2'
+    · obtain ⟨l, hl⟩ := card_eq_one.1 h1
+      rw [forestDist_singleton_of_card_le_one σ.isHierarchy σ.length h1.le,
