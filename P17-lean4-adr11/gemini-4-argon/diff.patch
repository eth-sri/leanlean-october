-  · -- the pendant edge `{ℓ} | X ∖ {ℓ}`
-    obtain ⟨ℓ, rfl⟩ := card_eq_one.1 hA1
-    exact rl_exists_five_not_rootOn_pendant hX σ hA₁ hA₁c hne hne'
