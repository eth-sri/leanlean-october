+def root_collect (n : ℕ) (M : List CTerm) (u : List ℕ) : List (ℚ × List (ℕ × ℕ)) :=
+  let m := root_famMask n u
+  (M.filter fun τ => root_famMask n τ.forest == m).map fun τ => (τ.coef, normKey τ.key)
