-    (h : A ∈ unroot σ.clusters) : A.Nonempty := by
-  rcases quart_mem_unroot.1 h with ⟨h1, _⟩ | ⟨_, h2⟩
-  · exact σ.nonempty_of_mem A h1
-  · rw [nonempty_iff_ne_empty]
-    rintro rfl
-    exact h2 compl_empty
