+        · exact Or.inl (multi_pre_mono s h)
+        · exact Or.inr (Or.inl (multi_pre_mono s h))
+        · exact Or.inr (Or.inr (disjoint_left.2 fun _ hlA hlB =>
+            disjoint_left.1 h (mem_filter.1 hlA).2 (mem_filter.1 hlB).2))
