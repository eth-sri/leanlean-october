+          ∃ l ∈ univ.filter fun l => s l = x, (B : Finset L) = {l} := fun B => by
+        obtain ⟨hBE, hBS, -⟩ := mem_childClusters.1 B.2
+        have h1 := (hE.2.2.1 B hBE).card_pos
