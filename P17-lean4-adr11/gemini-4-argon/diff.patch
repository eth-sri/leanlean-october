-theorem n4_unrootedDist_of_mem (hX : Fintype.card X = 4) (σ : SpeciesTree X) {A : Finset X}
-    (hA : A ∈ unroot σ.clusters) (hA2 : #A = 2) :
-    σ.unrootedDist id (treeOfClusters {A}) = 1 - 2 / 3 * exp (-σ.unrootedLength A) := by
-  by_cases hσ : σ.IsBinary
