-  · obtain ⟨-, e2, -, e4, e5, -, e7, -⟩ := rootingDist5_2_8 τ h
-    constructor
-    · rw [show 3 * u τ 4 + 6 * u τ 5 + 6 * u τ 7 = exp (-τ.length {0, 1}) by
-        rw [e4, e5, e7]; ring, log_exp, neg_neg]
