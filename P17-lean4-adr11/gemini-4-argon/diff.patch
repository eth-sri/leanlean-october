-theorem kingmanTransition_nonneg {t : ℝ} (ht : 0 ≤ t) (F G : Finset (Finset L)) :
-    0 ≤ kingmanTransition t F G := by
-  -- uniformization: `tQ = tP - tc · 1` with `P = Q + c · 1` entrywise nonnegative
