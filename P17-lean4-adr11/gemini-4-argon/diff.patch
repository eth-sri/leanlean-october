-    {H : Finset (Finset (Fin 4))} (hc : τ.clusters = H)
-    (hH : ¬ ∀ A ∈ H, 2 ≤ #A → ∃ B ∈ H, ∃ C ∈ H, Disjoint B C ∧ B ∪ C = A) : ¬ τ.IsBinary := by
-  intro hb
-  refine hH fun A hA h2 => ?_
-  rw [← hc] at hA ⊢
-  exact hb A hA h2
