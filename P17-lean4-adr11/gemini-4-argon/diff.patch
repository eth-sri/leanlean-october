-    let Z := exp (-σ.length {3, 4})
-    0 < Z ∧ Z < 1 ∧ u σ 1 = 1 / 3 - 4 / 15 * Z ∧ u σ 2 = 1 / 15 * Z := by
-  obtain ⟨hZ, hZ1⟩ := appc_bounds σ (A := {3, 4}) (by rw [h]; decide) (by decide)
