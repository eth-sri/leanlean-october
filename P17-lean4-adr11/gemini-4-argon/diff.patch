-  · obtain ⟨e1, e2⟩ := ac1_classes_1_3 τ (h.trans (by decide))
-    rw [ac1_topSix, e1, e2]; decide
-  · obtain ⟨e1, e2⟩ := ac1_classes_1_4 τ (h.trans (by decide))
-    rw [ac1_topSix, e1, e2]; decide
