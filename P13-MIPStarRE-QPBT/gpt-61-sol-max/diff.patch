-    ‖applyOperatorToState (X₂ ^ c.val * reflectionEffect Z₂ c)
-      (applyOperatorToState (X₁ ^ b.val * reflectionEffect Z₁ b) ψ)‖ ^ 2)]
-  have hinner : ∀ b : ZMod 2,
-      (∑ c : ZMod 2, ‖applyOperatorToState (X₂ ^ c.val * reflectionEffect Z₂ c)
-          (applyOperatorToState (X₁ ^ b.val * reflectionEffect Z₁ b) ψ)‖ ^ 2) =
