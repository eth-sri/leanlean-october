+theorem sum_norm_sq_le_of_eq_add {U V : Type*} [Fintype U] [DecidableEq U]
+    [SeminormedAddCommGroup V] (x y : U → V) (b : V) (u₀ : U)
+    (h : ∀ u, y u = x u + if u = u₀ then b else 0) {c : ℝ} (hb : ‖b‖ ^ 2 ≤ c) :
