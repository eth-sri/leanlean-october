-  obtain ⟨t, rfl⟩ := hx
-  refine ⟨extendedDirectScalarEquiv P t, ?_⟩
-  funext i
-  change extendedDirectScalarEquiv P (b i + t * d i) =
-    extendedDirectScalarEquiv P (b i) +
-      extendedDirectScalarEquiv P t * extendedDirectScalarEquiv P (d i)
