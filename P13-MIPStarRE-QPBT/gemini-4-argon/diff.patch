-    [Fintype ι] [DecidableEq ι] (k : κ) :
-    EuclideanSpace ℂ ι →ₗ[ℂ] EuclideanSpace ℂ (κ × ι) where
-  toFun x := (EuclideanSpace.equiv (κ × ι) ℂ).symm
-    (fun p => if p.1 = k then x p.2 else 0)
-  map_add' x y := by
-    ext p
-    by_cases h : p.1 = k <;> simp [h]
-  map_smul' c x := by
-    ext p
-    by_cases h : p.1 = k <;> simp [h]
-
