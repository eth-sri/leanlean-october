-    [Fintype ι] [DecidableEq ι] (k : κ) :
-    EuclideanSpace ℂ ι →ₗᵢ[ℂ] EuclideanSpace ℂ (κ × ι) :=
-  LinearMap.isometryOfInner (registerFiberEmbeddingMap κ ι k) <| by
