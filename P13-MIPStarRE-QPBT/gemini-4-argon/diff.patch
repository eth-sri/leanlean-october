-    (qA qB : X -> DirectLdQuestion D) :
-    consistencyDefect mu
-        (fun x answer => heteroKron ((S.A (qA x)).effect answer) 1)
-        (fun x answer => heteroKron 1 ((S.B (qB x)).effect answer)) S.ψ =
-      avgOver mu (fun x => outcomeEventWeight S (qA x) (qB x)
