-    [Fintype ι] [DecidableEq ι] (k : κ) (x : EuclideanSpace ℂ ι) (p : κ × ι) :
-    registerFiberEmbedding κ ι k x p = if p.1 = k then x p.2 else 0 := rfl
-
-/-! ## Coarse contraction estimates -/
-
-end
-
