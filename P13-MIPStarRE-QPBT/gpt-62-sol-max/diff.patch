-      prefixMap (K := K) k n (Nat.le_trans (Nat.le_succ k) hk) := by
-    ext x i
-    rfl
-  rw [prefixRank, prefixRank, ← hcomp, Submodule.map_comp]
-  exact Submodule.finrank_map_le drop (W.map large)
