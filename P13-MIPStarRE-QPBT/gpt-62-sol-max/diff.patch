+    (S : ProjectiveSetting P ε) (side : PlayerSide) (W : PauliKind) :
+    ExtendedPointQuestion P → PauliScalar P → Op (S.ExpandedLocalSpace side) :=
+  pointAffinePostprocess (S.orderedPointProduct side W)
