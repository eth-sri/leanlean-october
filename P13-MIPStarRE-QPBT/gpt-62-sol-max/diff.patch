-      simp only [Finset.mem_filter, Finset.mem_univ, true_and]
-      simpa [j, r, Nat.le_of_lt hk, Nat.succ_le_of_lt hk] using hstrict
-  have hP_le : P.card ≤ Module.finrank K W := by
-    calc
-      P.card ≤ r n := by
