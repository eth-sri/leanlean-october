+      2 * qSDD ψ (leftPlacedSubMeas (ιB := ιB) P.toSubMeas) (rightPlacedSubMeas (ιA := ιA) B) +
+        (1 - ∑ a, ev ψ (rightTensor (ι₁ := ιA) (B.outcome a * B.outcome a))) := by
