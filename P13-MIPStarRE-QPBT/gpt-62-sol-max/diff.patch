-/-- If a coordinate does not increase prefix rank, it vanishes after all earlier coordinates do. -/
-lemma coordinate_eq_zero_of_prefixRank_eq {n : ℕ}
-    (W : Submodule K (Fin n → K)) (j : Fin n)
