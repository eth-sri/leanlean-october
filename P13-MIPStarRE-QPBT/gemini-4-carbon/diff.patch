-    (fun u => avgOver (uniformDistribution (Fin 2 → F))
-      (fun v => ∑ g ∈ s, ‖ψ g - A u v g‖ ^ 2)) + _
-  change avgOver (uniformDistribution (Fin n → F))
-    (fun u => avgOver (uniformDistribution (Fin 2 → F))
-      (fun v => ∑ g ∈ s, ‖A u v g‖ ^ 2)) ≤ _ at hnorm
-  linarith
-
-end PolynomialImageBounds
-
-end
