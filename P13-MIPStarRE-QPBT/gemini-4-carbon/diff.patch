-estimate is an input to this auxiliary theorem. -/
-theorem nonlinear_mass_le_ordered_error {n : ℕ} {Γ : Type*}
-    (s : Finset Γ) (p : Γ → MvPolynomial (Fin 2) (MvPolynomial (Fin n) F))
-    (hp : ∀ g ∈ s, ¬ ∃ r t : MvPolynomial (Fin n) F,
