-follows from completeness and projective postprocessing. -/
-theorem orderedIndicator_gram_le_one (X Z : Quantum.Measurement F ι)
-    (hX : Measurement.IsProjective X) (hZ : Measurement.IsProjective Z) (α β a : F) :
