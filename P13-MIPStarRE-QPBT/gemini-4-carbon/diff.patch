-        ((Z₁.effect ab.2 * X₁.effect ab.1 * Z₁.effect ab.2) *
-          (Z₂.effect ab.2 * X₂.effect ab.1 * Z₂.effect ab.2))
-      = ∑ b, ∑ a, stateQForm (applyOperatorToState (Z₁.effect b * Z₂.effect b) ψ)
-          (X₁.effect a * X₂.effect a) := by
-        simp_rw [hstep]
-        exact Fintype.sum_prod_type_right _
