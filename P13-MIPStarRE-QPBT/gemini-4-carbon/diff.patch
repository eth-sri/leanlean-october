-        6 * deltaQld a b epsilon P.m P.d P.q ^ 2 ≤
-      deltaQld (21 * a ^ 2) b epsilon P.m P.d P.q := by
-  have hdegree : (1 : ℝ) ≤ ((P.m * P.d : ℕ) : ℝ) :=
