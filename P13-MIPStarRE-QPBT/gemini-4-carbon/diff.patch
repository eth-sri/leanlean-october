-theorem abs_avgOver_sum_stateQForm_mul_le_sqrt_of_isProj {X α ι : Type*}
-    [Fintype α] [Fintype ι] [DecidableEq ι] (μ : Distribution X)
-    (A : X → Measurement α ι) (R W : X → α → Op ι) (ψ : EuclideanSpace ℂ ι)
