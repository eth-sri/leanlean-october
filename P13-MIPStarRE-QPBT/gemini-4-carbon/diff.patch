-    (A : Measurement β ιB) (B : Measurement Γ ιA)
-    (ψ : EuclideanSpace ℂ (ιA × ιB)) (f : Γ → β) :
-    (∑ b : β, stateQForm ψ
-      (heteroKron ((B.postprocess f).effect b) (A.effect b))) =
-      ∑ b : β, ∑ g : Γ, if f g = b then
-        stateQForm ψ (heteroKron (B.effect g) (A.effect b)) else 0 := by
