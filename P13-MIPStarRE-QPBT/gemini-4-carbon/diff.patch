-        (kind, directLdMap P.extendedDirectLd kind sample)
-        (kind, directLdMap P.extendedDirectLd kind sample)
-        answerA answerB = false := Bool.eq_false_of_not_eq_true hnotwin
-    simp only [hwinFalse, Bool.false_eq_true, if_false]
-    split
-    · rfl
-    · rename_i hnot
-      exact (hnot heq).elim
