-private theorem idealState_pauli_mirror (P : AdmissibleParams)
-    {ιA' ιB' : Type} [Fintype ιA'] [DecidableEq ιA']
-    [Fintype ιB'] [DecidableEq ιB']
-    (aux : EuclideanSpace ℂ (ιA' × ιB')) (W : PauliKind)
