-        (if row.1.2.1 = col.1.2.1 then 1 else 0) *
-        ((if row.2.1 = col.2.1 then 1 else 0) * T row.1.2.2 col.1.2.2) *
-        (if row.2.2.1 = col.2.2.1 then 1 else 0) *
-        (if row.2.2.2 = col.2.2.2 then 1 else 0)
