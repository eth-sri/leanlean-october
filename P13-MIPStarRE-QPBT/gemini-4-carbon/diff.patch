-  -- one on the source parameter domain.
-  have htail0 : (0 : ℝ) ≤ epsilon ^ b + (P.q : ℝ) ^ (-b) +
-      (2 : ℝ) ^ (-(b * ((P.m * P.d : ℕ) : ℝ))) := by
-    have h1 := Real.rpow_nonneg hepsilon b
