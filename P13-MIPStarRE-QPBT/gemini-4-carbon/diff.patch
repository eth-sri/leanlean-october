-    (fun u α p => evalDirectPolyTupleAt (D := D.combined) (combinedPoint u α) p)
-    (fun u p => directCombinedRecoveryLocalBound D (p default) u)
-    (((D.combined.m * D.d : ℕ) : ℝ) / D.q)
-    (fun u b p => directCombinedRecoveryEvent_transport D u b p)
