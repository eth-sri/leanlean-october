-            (S.expObs side .X rs.1 x * S.expObs side .Z rs.2 z -
-              S.expObs side .Z rs.2 z * S.expObs side .X rs.1 x) := by
-  rw [expPointOp_eq_inv_card_smul_sum, expPointOp_eq_inv_card_smul_sum,
