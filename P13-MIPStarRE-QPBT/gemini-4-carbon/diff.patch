-    ‖applyOperatorToState (orderedIndicator X Z α β a) ψ‖ ^ 2 =
-      stateQForm ψ (diagonalIndicator X Z α β a) := by
-  rw [MagicSquareRigidity.norm_applyOperatorToState_sq,
-    orderedIndicator_gram_of_ne_zero X Z hX α β a hβ]
-  rfl
