-/-- The compact and registered ordered-edge carriers are equivalent. -/
-def pauliEdgeEquiv : PauliEdge ≃ MIPStarRE.QPBT.PauliEdge :=
-  (Equiv.prodCongr pauliTypeEquiv pauliTypeEquiv).subtypeEquiv pauliEdges_mem_equiv
