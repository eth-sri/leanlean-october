-      pauliProj W (h + decodeFq (W.selectPoly pair)) := by
-  classical
-  rw [pauliProj_eq_avg_tauObservable, conjBy, Matrix.mul_smul, Matrix.smul_mul,
-    Matrix.mul_sum, Finset.sum_mul, pauliProj_eq_avg_tauObservable]
