-  · simp only [Option.some.injEq]
-    constructor
-    · intro heq
-      simpa [heq] using Classical.choose_spec hexists
-    · intro heval
-      obtain ⟨parameter, hparameter⟩ := heval.1
-      exact ((Classical.choose_spec hexists).2 parameter hparameter).symm.trans
