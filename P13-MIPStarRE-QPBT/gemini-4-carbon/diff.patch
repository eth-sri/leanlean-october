-/-- Every restricted line-point law has total mass one. -/
-theorem restrictedLinePointDist_isProbability (P : AdmissibleParams)
-    (kind : LineKind) (i : Fin P.m) :
-    (restrictedLinePointDist P kind i).IsProbability := by
-  cases kind
