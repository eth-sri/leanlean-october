-    (fun h => by
-      apply star_right_conjugate_nonneg
-      exact kronecker_nonneg
-        (kronecker_nonneg ((S.pauliMeas side W).pos h) Matrix.PosSemidef.one.nonneg)
-        Matrix.PosSemidef.one.nonneg)
-    (by
