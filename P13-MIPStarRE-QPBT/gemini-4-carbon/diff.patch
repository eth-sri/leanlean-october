-theorem abs_overlap_gap_le_sqrt_one_sub_of_isProj' {X α ι : Type*} [Fintype α]
-    [Fintype ι] [DecidableEq ι] (μ : Distribution X) (A : X → Measurement α ι)
-    (B C CB : X → α → Op ι) (ψ : EuclideanSpace ℂ ι) (hμ : μ.IsProbability)
