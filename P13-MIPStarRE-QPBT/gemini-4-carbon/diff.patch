-    params.extendedDirectLd (strategy lines)
-  rw [directLdRejectionProbability, avgOver_ldType_pair,
-    mixed_branch_rejection_eq_zero lines _ (Or.inl rfl),
-    mixed_branch_rejection_eq_zero lines _ (Or.inr rfl)] at hvalue
