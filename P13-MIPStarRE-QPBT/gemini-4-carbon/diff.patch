+@[simp] theorem combinedPoint_combinedPointVar {K : Type*} {m k : ℕ}
+    (u : Fin m → K) (α : Fin k → K) (j : Fin m) :
+    combinedPoint u α (combinedPointVar m k j) = u j := by simp [combinedPoint, combinedPointVar]
