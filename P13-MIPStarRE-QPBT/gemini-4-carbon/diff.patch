+theorem diagonalIndicator_bounds (X Z : Quantum.Measurement F ι)
+    (hZ : Measurement.IsProjective Z) (α β a : F) :
+    0 ≤ diagonalIndicator X Z α β a ∧ diagonalIndicator X Z α β a ≤ 1 := by
