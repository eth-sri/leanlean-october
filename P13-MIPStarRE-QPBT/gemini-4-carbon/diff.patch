-/-- Admissible field sizes are positive, so LDT points over a direct
-parameter tuple form a nonempty type. -/
-instance instNeZeroNatQ (D : DirectLdParams) : NeZero D.q :=
-  ⟨Nat.ne_of_gt D.toLDTParameters.hq⟩
