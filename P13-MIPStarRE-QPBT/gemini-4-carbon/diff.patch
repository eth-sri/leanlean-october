-    ∑ a, ‖applyOperatorToState (Q * N a * Q - T a) delta‖ ^ 2 ≤
-      3 * (∑ a, ‖applyOperatorToState (N a - T a) delta‖ ^ 2) +
-        6 * ‖delta - theta‖ ^ 2 := by
