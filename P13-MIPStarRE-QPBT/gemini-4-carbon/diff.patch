-        (honestMagicMeasurement_var_eq_placedBasis P (pauliSharedProjection z) hg).2
-      change Commute ((honestMeasurement P (.point .Z) _).effect a)
-        ((honestMagicMeasurement P (.var 4) (pauliSharedProjection z)).effect b)
