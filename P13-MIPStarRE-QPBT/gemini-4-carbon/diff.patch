-private theorem sum_norm_compression_sub_sq_le {α ι : Type*}
-    [Fintype α] [Fintype ι] [DecidableEq ι]
-    (N T R : α → Op ι) (Q : Op ι) (hQ : IsProj Q)
-    (hN : ∑ a, (N a)ᴴ * N a ≤ 1) (hR : ∑ a, (R a)ᴴ * R a ≤ 1)
