-    (u : Lp U ∞ muPlus) (ε : ℝ) (hε : 0 < ε) :
-    ∃ η > 0, ∀ r, 0 ≤ r → r < η → ∀ v : Lp U ∞ muPlus, ‖v‖ ≤ ‖u‖ → ‖S.Φ r v‖ < ε := by
