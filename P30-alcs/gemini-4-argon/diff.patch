-
-variable {𝕜 : Type*} [RCLike 𝕜]
-variable {X : Type*} [NormedAddCommGroup X] [NormedSpace 𝕜 X]
-variable {U : Type*} [NormedAddCommGroup U] [NormedSpace 𝕜 U]
