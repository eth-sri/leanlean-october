-
-/-- The trace-zero cubic discriminant, with the actual unscaled trace metric. -/
-theorem discriminant_identity (a b c : ℝ) (htrace : a + b + c = 0) :
-    ((a - b) * (a - c) * (b - c)) ^ 2 =
-      (a ^ 2 + b ^ 2 + c ^ 2) ^ 3 / 2 - 27 * (a * b * c) ^ 2 := by
