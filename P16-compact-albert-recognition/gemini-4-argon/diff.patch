-/-- One composed quadratic word has transport error twelve. -/
-theorem nested_error
-    (jA : Product A) (jE : Product E) (f : A →ₗᵢ[ℝ] E)
-    (hUA : ∀ a b, ‖Q jA a b‖ ≤ ‖a‖ ^ 2 * ‖b‖)
-    (hUE : ∀ a b, ‖Q jE a b‖ ≤ ‖a‖ ^ 2 * ‖b‖)
-    (μ : ℝ) (hμ : 0 ≤ μ)
