-      Q jE (f x) (f (Q jA y z) - Q jE (f y) (f z)) := by
-    rw [Q_sub]
-    module
-  have h₁ : ‖f (Q jA x (Q jA y z)) - Q jE (f x) (f (Q jA y z))‖ ≤
-      6 * μ * ‖x‖ ^ 2 * ‖y‖ ^ 2 * ‖z‖ := by
