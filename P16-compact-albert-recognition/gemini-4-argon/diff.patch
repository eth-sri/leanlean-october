+theorem flatBaseTriple_mem_PBox : flatBaseTriple ∈ PBox := fun i j => by
+  have h : (ledger54 flatBaseTriple).2.1 i j = 1 / 3 :=
+    uniformLedger_pair_overlap flatFrameP flatFrameQ flatFrameR flatFrameR_frame flat_uniform i j
+  rw [h]; norm_num
