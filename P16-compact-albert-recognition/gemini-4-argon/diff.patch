+      (Glennie.inner (nativeAdjoint (A x)) (A y))
+      (Glennie.inner (nativeAdjoint (A y)) (A x))
+      (nativeNewtonNorm (A y))).congr_of_eventuallyEq (Filter.Eventually.of_forall hline)
