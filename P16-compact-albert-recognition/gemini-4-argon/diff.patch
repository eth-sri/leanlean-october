-    a = flatScale := by
-  have hp : 0 < flatScale := flatScale_pos
-  have hprod : (a - flatScale) * (a + flatScale) = 0 := by
-    linear_combination h - flatScale_sq
-  rcases mul_eq_zero.mp hprod with h1 | h2
-  · linarith
-  · linarith
