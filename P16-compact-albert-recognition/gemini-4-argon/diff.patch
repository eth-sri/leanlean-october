-theorem contDiffAt_levelChartD2 (x : W) (hx : x ∈ U) : ContDiffAt ℝ ⊤ DDχ x := by
-  change ContDiffAt ℝ ⊤ (fderiv ℝ (levelChartD1 P e he)) x
-  exact ContDiffAt.fderiv_right (𝕜 := ℝ) (E := W) (F := W →L[ℝ] E)
