-    simp only [hs,Matrix.conjTranspose_conjTranspose]
-    simp only [Matrix.mul_assoc,su_cancel,su_left,Matrix.mul_one]
-  · simp only [sectorUnitaryAction_hidden]
-    simp only [hs,Matrix.conjTranspose_conjTranspose]
-    rw [Matrix.mul_assoc,su_left,Matrix.mul_one]
