+    rw [show phi x y z - phi x' y' z' =
+      (phi x y z - phi x' y z) + (phi x' y z - phi x' y' z) + (phi x' y' z - phi x' y' z') by ring]
+    exact (abs_add_le _ _).trans (add_le_add_left (abs_add_le _ _) _)
+  have hR8 : 0 ≤ R ^ 8 := by positivity
