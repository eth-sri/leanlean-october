+    rcases hTorbit with hN | hP
+    · exact ne_of_lt (hsN T hN)
+    · exact ne_of_gt (hsP T hP)
+  refine ⟨hscoreT, ⟨?_, ?_⟩⟩
+  · rintro ⟨k, hk⟩
