+      rw [← hvu, hm0 v v]; rfl
+    have hcubic_u : P.form ![(u : E), (u : E), (u : E)] =
+        Glennie.inner (v : Albert) (jordan (v : Albert) (v : Albert)) / 3 := by
+      rw [← hvu, hc0 v]
+      change CA v v v = _
+      rw [CA_eq_native, inner_comm]
