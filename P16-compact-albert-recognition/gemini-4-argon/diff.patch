+  have h2 : ‖a + b‖ ≤ 2 * R := (norm_add_le a b).trans (by linarith)
+  have h3 : 0 ≤ ‖a - b‖ * ‖w‖ := by positivity
+  nlinarith
 
-theorem negative_certificate (T : Triple) (noisy : Readouts) (ε : ℝ)
