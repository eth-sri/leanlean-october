-def fullCoordinates : Albert ≃ₗ[ℝ] (FullIndex → ℝ) where
-  toFun := fullCoeff
-  invFun := fullFrom
-  left_inv x := by
-    apply Albert.ext
-    · rfl
-    · rfl
-    · rfl
-    · apply Prod.ext <;> apply Quaternion.ext <;> rfl
-    · apply Prod.ext <;> apply Quaternion.ext <;> rfl
-    · apply Prod.ext <;> apply Quaternion.ext <;> rfl
-  right_inv c := by
-    ext i
-    rcases i with j | ⟨s,t⟩
-    · fin_cases j <;> rfl
-    · fin_cases s <;> fin_cases t <;> rfl
-  map_add' x y := by
-    ext i
-    rcases i with j | ⟨s,t⟩
-    · fin_cases j <;> rfl
-    · fin_cases s <;> fin_cases t <;> rfl
