+    E →L[ℝ] E →L[ℝ] E →L[ℝ] ℝ := fderiv ℝ (logHessianForm P) x
+
+theorem hasFDerivAt_actual_metric (P : SymmetricTrilinearForm E) {x : E}
+    (hx : 0 < diagonalCubic P.form x) :
