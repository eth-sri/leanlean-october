-/-- The final U/product factor has transport error seven. -/
-theorem rightFactor_error
-    (jA : Product A) (jE : Product E) (f : A →ₗᵢ[ℝ] E)
-    (hA : ∀ a b, ‖jA a b‖ ≤ ‖a‖ * ‖b‖)
-    (hUE : ∀ a b, ‖Q jE a b‖ ≤ ‖a‖ ^ 2 * ‖b‖)
