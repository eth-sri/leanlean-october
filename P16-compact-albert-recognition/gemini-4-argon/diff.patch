+theorem cubic_unit_unit_tangent (u : tangentSpace P e) : P.form ![e, e, (u : E)] = 0 := by
+  have h : fderiv ℝ (diagonalCubic P.form) e (u : E) = 0 := u.property
+  rw [fderiv_diagonalCubic_apply_symmetric] at h; linarith
