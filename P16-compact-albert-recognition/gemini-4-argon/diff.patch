-    NormedAddCommGroup (W →L[ℝ] W →L[ℝ] E) :=
-  ContinuousLinearMap.toNormedAddCommGroup (𝕜 := ℝ) (𝕜₂ := ℝ)
-    (E := W) (F := W →L[ℝ] E) (σ₁₂ := RingHom.id ℝ)
-
-local instance levelChartBilinearNormedSpace : NormedSpace ℝ (W →L[ℝ] W →L[ℝ] E) :=
