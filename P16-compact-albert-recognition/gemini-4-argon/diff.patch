-  apply Subtype.ext
-  rw [project_coe]
-  unfold Glennie.traceless
-  rw [trace_normalizedNativePoint]
-  have hc : (3*t)/3 = t := by ring
-  rw [hc]
-  unfold normalizedNativePoint
