-  have h₂ : ‖Q jE (f x) (f (Q jA y z) - Q jE (f y) (f z))‖ ≤
-      6 * μ * ‖x‖ ^ 2 * ‖y‖ ^ 2 * ‖z‖ := by
-    calc
-      _ ≤ ‖f x‖ ^ 2 * ‖f (Q jA y z) - Q jE (f y) (f z)‖ := hUE _ _
-      _ = ‖x‖ ^ 2 * ‖f (Q jA y z) - Q jE (f y) (f z)‖ := by rw [f.norm_map]
-      _ ≤ ‖x‖ ^ 2 * (6 * μ * ‖y‖ ^ 2 * ‖z‖) :=
-        mul_le_mul_of_nonneg_left (hQ y z) (sq_nonneg _)
