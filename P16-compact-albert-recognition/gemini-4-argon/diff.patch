+    x.o01.2.re, x.o01.2.imI, x.o01.2.imJ, x.o01.2.imK,
+    x.o02.1.re, x.o02.1.imI, x.o02.1.imJ, x.o02.1.imK,
+    x.o02.2.re, x.o02.2.imI, x.o02.2.imJ, x.o02.2.imK,
+    x.o12.1.re, x.o12.1.imI, x.o12.1.imJ, x.o12.1.imK,
