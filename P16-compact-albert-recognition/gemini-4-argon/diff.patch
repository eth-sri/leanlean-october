-    rw [e0, abs_lt]
-    have h1 := habs 2 2
-    have h2 := habs 2 0
-    exact ⟨by linarith [h1.1, h1.2, h2.1, h2.2], by linarith [h1.1, h1.2, h2.1, h2.2]⟩
