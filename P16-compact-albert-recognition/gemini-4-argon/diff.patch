+    (hx : 0 < diagonalCubic P.form x) : ContDiffAt ℝ ⊤ (logHessian P) x := by
+  have hd : ContDiffAt ℝ ⊤ (fderiv ℝ (logCubic P)) x :=
+    (contDiffAt_actual_log P hx).fderiv_right (by simp)
+  exact hd.fderiv_right (by simp)
