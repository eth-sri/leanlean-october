-structure SymmetricCubic where
-  form : V →ₗ[ℝ] (V →ₗ[ℝ] (V →ₗ[ℝ] ℝ))
-  swap12 : ∀ x y z, form x y z = form y x z
-  swap23 : ∀ x y z, form x y z = form x z y
