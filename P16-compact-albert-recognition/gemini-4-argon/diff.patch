-theorem signedBasis_norm (t : Fin 8) (plus : Bool) :
-    octNormSq (signedBasis t plus) = 1 := by
-  cases plus
-  · change octNormSq (-octBasis t) = 1
-    have hn : octNormSq (-octBasis t) = octNormSq (octBasis t) := by
-      simp [octNormSq, Quaternion.normSq_def']
-    rw [hn, octBasis_norm]
