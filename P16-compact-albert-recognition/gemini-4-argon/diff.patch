-  have heq : f (rightFactor jA x y z) - rightFactor jE (f x) (f y) (f z) =
-      (f (Q jA z (jA x y)) - Q jE (f z) (f (jA x y))) +
-      Q jE (f z) (f (jA x y) - jE (f x) (f y)) := by
