-/-- The certificates are obtained from actual smoothness at every x in U. -/
-theorem hasFDerivAt_levelChartD0 (x : W) (hx : x ∈ U) :
-    HasFDerivAt χ (Dχ x) x :=
-  ((contDiffAt_levelChartPoint_smoothDomain P e he ⊤ x hx).differentiableAt
-    (by simp)).hasFDerivAt
