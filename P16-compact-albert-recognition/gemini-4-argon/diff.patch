+def raisedTangentCubic :
+    tangentSpace P e →L[ℝ] tangentSpace P e →L[ℝ] tangentSpace P e :=
+  ((ContinuousLinearMap.compL ℝ (tangentSpace P e) (tangentSpace P e →L[ℝ] ℝ) (tangentSpace P e))
