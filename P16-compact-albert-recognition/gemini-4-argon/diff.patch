+theorem contDiffAt_actual_metric (P : SymmetricTrilinearForm E) {x : E}
+    (hx : 0 < diagonalCubic P.form x) : ContDiffAt ℝ ⊤ (logHessianForm P) x :=
+  (contDiffAt_actual_logHessian P hx).const_smul (-1 / 3 : ℝ)
