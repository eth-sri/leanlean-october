-  have hu02 : Complex.normSq (complexPart y.o02) = 1/3 := by linarith
-  have hu12 : Complex.normSq (complexPart y.o12) = 1/3 := by linarith
-  refine ⟨hu01, hu02, hu12, ?_⟩
-  rw [← hy, fe_complex_cubic, h0, h1, h2] at hcub
-  linarith
