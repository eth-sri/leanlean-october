-      (fun y => chartCovariantDerivative P e he y Y Z) -
-    chartCovariantDerivative P e he x Y
-      (fun y => chartCovariantDerivative P e he y X Z) -
-    chartCovariantDerivative P e he x (fun y => chartLieBracket P e y X Y) Z
