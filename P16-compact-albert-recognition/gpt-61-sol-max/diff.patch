-    intro x y z
-    simp only [ContinuousMultilinearMap.compContinuousLinearMap_apply,
-      Submodule.subtypeL_apply]
-    convert P.swap23 (x : E) (y : E) (z : E) using 1 <;>
-      congr 1 <;> ext i <;> fin_cases i <;> rfl
