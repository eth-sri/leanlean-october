-/-- Actual neighborhood projection identity, obtained before differentiating. -/
-theorem eventually_levelChart_projection (x : W) (hx : x ∈ U) :
-    ∀ᶠ y in 𝓝 x, π (χ y) = y :=
-  Filter.mem_of_superset ((isOpen_smoothLevelChartDomain P e he).mem_nhds hx)
