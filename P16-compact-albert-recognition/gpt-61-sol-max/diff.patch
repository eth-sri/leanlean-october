-/-- On the genuine domain the chart is inverted by decode20. -/
-theorem decode_encode (L : Ledger54) (h : InDomain L) : decode20 (encode20 L) = L := by
-  refine Prod.ext ?_ (Prod.ext ?_ (Prod.ext ?_ ?_))
