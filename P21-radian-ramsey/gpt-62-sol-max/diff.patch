-    exact mul_nonneg (mul_nonneg (mul_nonneg
-      (mul_nonneg (by norm_num) (smoothPositivePart''_nonneg _)) (sq_nonneg _))
-      (sq_nonneg _)) (sq_nonneg _)
-  apply max_le
-  · by_cases h : 0 ≤ halfLaplacian (radialPower a p) x
