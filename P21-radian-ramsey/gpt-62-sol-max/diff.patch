+    ∃ (B : Option ι → W) (C : Option ι → ℚ),
+      (∑ j, C j • (B j ⊗ₜ[ℚ] B j)) = ∑ j, c j • (b j ⊗ₜ[ℚ] b j) ∧
+      D * (∑ j, max (-(C j : ℝ)) 0 * f (B j)^2) < η := by
+  let t : ι → ℝ := f ∘ b
+  let A (x : ι → ℝ) := ∑ j, (c j : ℝ) * x j ^ 2
+  let V (x : ι → ℝ) := ∑ j, (c j : ℝ) * x j * t j
+  let E (x : ι → ℝ) := D * (max (A x-2) 0 * (V x)^2 +
+    ∑ j, max (-(c j : ℝ)) 0 * (t j - x j * V x)^2)
