+
+lemma Cost.prod (C : Cost G) (l : List α) a b c (h : ∀ j ∈ l, C.R (a j * (b j)⁻¹) c) :
+    C.R ((l.map a).prod * (l.map b).prod⁻¹) (l.length * c) := by
+  induction l with
+  | nil => simpa using C.one
