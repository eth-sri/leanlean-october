+structure Cost (G : Type*) [Group G] where
+  R : G → ℝ → Prop
+  one : R 1 0
+  inv {g b} : R g b → R g⁻¹ b
+  conj {g b} (k) : R g b → R (k * g * k⁻¹) b
+  mul {g h b c} : R g b → R h c → R (g * h) (b + c)
