-    Matrix (Column d) (Column d) K := fun i q =>
-  f ((augmented a (e i) q.1) ⊗ₜ[ℚ] (1 : Coeff a)) *
-    f ((1 : Coeff a) ⊗ₜ[ℚ] (augmented a (e i) q.2))
