module

public import SemigroupBetti

/-! The bounds on the span rank of the toric ideal, stated for the original generators. -/

@[expose] public section

namespace SemigroupBetti

variable (K : Type*) [Field K] (n : Fin 4 → ℕ)

/-- `n` minimally generates its monoid: no `n i` lies in the submonoid generated by the others. -/
def MinimallyGenerates : Prop :=
  ∀ i : Fin 4, n i ∉ AddSubmonoid.closure (n '' {j | j ≠ i})

/-- The normalized width `w / gcd(a, b, w)` for offsets `a, b, w` from `n 0`. -/
def normalizedWidth : ℕ :=
  (n 3 - n 0) / Nat.gcd (n 1 - n 0) (Nat.gcd (n 2 - n 0) (n 3 - n 0))

variable (hpos : 0 < n 0) (hmono : StrictMono n) (_hgcd : Finset.univ.gcd n = 1)
  (_hmin : MinimallyGenerates n)

include hpos hmono _hgcd _hmin

-- The protected signature includes the two semigroup hypotheses even in this stronger proof.
set_option linter.unusedSectionVars false in
/-- **Main theorem.** For a minimally four-generated numerical semigroup, the first Betti number
is at most `2W`, `W` the normalized width. The proof only needs positivity and ordering. -/
theorem beta1_le_two_mul_normalizedWidth :
    (toricIdeal K n).spanRank ≤ (2 * normalizedWidth n : ℕ) := by
  let a (i : Fin 4) := n i - n 0
  let g := Finset.univ.gcd a
  have h (i : Fin 4) := hmono.monotone (Fin.zero_le i)
  have hd (i : Fin 4) : g ∣ a i := Finset.gcd_dvd (Finset.mem_univ i)
  let b (i : Fin 4) := a i / g
  let G : GenData := ⟨n 0, g, b, hpos, by simp [b, a], fun i j hij =>
    Nat.div_lt_div_of_lt_of_dvd (hd j) (Nat.sub_lt_sub_right (h i) (hmono hij))⟩
  have hn : G.n = n := by
    funext i
    simp [GenData.n, G, b, Nat.mul_div_cancel' (hd i), a, Nat.add_sub_of_le (h i)]
  have hu : (Finset.univ : Finset (Fin 4)) = {0, 1, 2, 3} := by decide
  simpa [hn, show G.W = b 3 from rfl, b, g, hu, a, normalizedWidth, gcd_eq_nat_gcd] using
    GenData.spanRank_le_two K G

/-- The first Betti number is at most twice the width. -/
theorem beta1_le_two_mul_width :
    (toricIdeal K n).spanRank ≤ (2 * (n 3 - n 0) : ℕ) := by
  refine (beta1_le_two_mul_normalizedWidth K n hpos hmono _hgcd _hmin).trans ?_
  norm_cast
  exact Nat.mul_le_mul_left _ (Nat.div_le_self _ _)

end SemigroupBetti
