/-!
# Linear upper bounds for the first Betti number of four-generated numerical semigroups
-/

@[expose] public noncomputable section

namespace SemigroupBetti

open Finset MvPolynomial Classical

/-- The toric ideal of the monoid generated by `n 0, …, n 3`: the kernel of the `K`-algebra map
`K[X₀,…,X₃] → K[t]` sending `X i` to `t ^ n i`. -/
def toricIdeal (K : Type*) [Field K] (n : Fin 4 → ℕ) :=
  RingHom.ker (aeval (R := K) ((Polynomial.X : Polynomial K) ^ n ·)).toRingHom

/-- `n` minimally generates its monoid: no `n i` lies in the submonoid generated by the others. -/
def MinimallyGenerates (n : Fin 4 → ℕ) :=
  ∀ i, n i ∉ AddSubmonoid.closure (n '' {j | j ≠ i})

/-- The normalized width `w / gcd(a, b, w)` where `(a, b, w) = (n 1 - n 0, n 2 - n 0, n 3 - n 0)`. -/
def normalizedWidth (n : Fin 4 → ℕ) :=
  (n 3 - n 0) / Nat.gcd (n 1 - n 0) (Nat.gcd (n 2 - n 0) (n 3 - n 0))

/-- **Definition 1.** Generator data with the standing hypotheses `(H)`. -/
structure GenData where
  n : Fin 4 → ℕ
  m_pos : 0 < n 0
  n_strictMono : StrictMono n

namespace GenData

variable (G : GenData)

/-- `g = gcd(a, gcd(b, w))`. -/
abbrev g := Nat.gcd (G.n 1 - G.n 0) (Nat.gcd (G.n 2 - G.n 0) (G.n 3 - G.n 0))

/-- `A = a / g`. -/
def A := (G.n 1 - G.n 0) / G.g
/-- `B = b / g`. -/
def B := (G.n 2 - G.n 0) / G.g
/-- `W = w / g` (normalized width). -/
abbrev W := normalizedWidth G.n

/-- **Definition 2.** Degree `ν(z) = ∑ zᵢ nᵢ`. -/
def nu (z : Fin 4 → ℕ) := ∑ i, z i * G.n i

lemma m_le_n (i) : G.n 0 ≤ G.n i := G.n_strictMono.monotone (Fin.zero_le i)
lemma n_pos (i) : 0 < G.n i := G.m_pos.trans_le (G.m_le_n i)

@[simp] lemma n_one : G.n 1 = G.n 0 + G.g * G.A := by
  rw [A, Nat.mul_div_cancel' (Nat.gcd_dvd_left _ _), Nat.add_sub_of_le (G.m_le_n 1)]
@[simp] lemma n_two : G.n 2 = G.n 0 + G.g * G.B := by
  rw [B, Nat.mul_div_cancel' ((Nat.gcd_dvd_right _ _).trans (Nat.gcd_dvd_left _ _)),
    Nat.add_sub_of_le (G.m_le_n 2)]
@[simp] lemma n_three : G.n 3 = G.n 0 + G.g * G.W := by
  rw [W, normalizedWidth, Nat.mul_div_cancel' ((Nat.gcd_dvd_right _ _).trans (Nat.gcd_dvd_right _ _)),
    Nat.add_sub_of_le (G.m_le_n 3)]

lemma A_pos : 0 < G.A := by nlinarith [G.n_strictMono Fin.zero_lt_one, G.n_one]
lemma A_lt_B : G.A < G.B := by nlinarith [@G.n_strictMono 1 2 (by decide), G.n_one, G.n_two]
lemma B_lt_W : G.B < G.W := by nlinarith [@G.n_strictMono 2 3 (by decide), G.n_two, G.n_three]

/-! ### Additivity of `ν` -/

@[simp] lemma nu_add (x y) : G.nu (x + y) = G.nu x + G.nu y := by
  simp [nu, add_mul, sum_add_distrib]

@[simp] lemma nu_single (i k) : G.nu (Pi.single i k) = k * G.n i := by
  simp [nu, Pi.single_apply]

lemma single_le {i c} {z : Fin 4 → ℕ} (h : c ≤ z i) : Pi.single i c ≤ z :=
  fun j => by obtain rfl | hj := eq_or_ne j i <;> simp [*]

/-- If `x ≤ y` coordinatewise then `ν(y) = ν(x) + ν(y - x)`. -/
lemma nu_sub {x y} (h : x ≤ y) : G.nu y = G.nu x + G.nu (y - x) := by
  rw [← nu_add, add_tsub_cancel_of_le h]

/-! ### Definition 3: fibers and the graph `∇_d` -/

/-- The fiber `F_d = {z ∈ ℕ⁴ : ν(z) = d}`, enumerated inside the box `{0,…,d}⁴`. -/
def fiber (d) :=
  (Fintype.piFinset fun _ => range (d + 1)).filter (G.nu · = d)

@[simp] lemma mem_fiber {d z} : z ∈ G.fiber d ↔ G.nu z = d := by
  simp only [fiber, mem_filter, Fintype.mem_piFinset, mem_range, and_iff_right_iff_imp,
    Nat.lt_succ_iff]
  exact fun h i => h ▸ (single_le_sum (fun _ _ => zero_le) (mem_univ i)).trans'
    (Nat.le_mul_of_pos_right _ (G.n_pos i))

@[simp] lemma nu_coe {d} (z : G.fiber d) : G.nu z.1 = d := G.mem_fiber.1 z.2

/-- The factorization graph `∇_d` on the fiber: distinct factorizations sharing a variable. -/
def nabla (d) : SimpleGraph (G.fiber d) where
  Adj z z' := z ≠ z' ∧ ∃ i, 0 < z.1 i ∧ 0 < z'.1 i
  symm := ⟨fun _ _ ⟨h1, i, h2, h3⟩ => ⟨h1.symm, i, h3, h2⟩⟩
  loopless := ⟨fun _ h => h.1 rfl⟩

/-- `c_d`: the number of connected components of `∇_d` (`0` when the fiber is empty). -/
def ncomp (d) := Fintype.card (G.nabla d).ConnectedComponent

/-- The explicit cutoff finset `{0, …, n₃ (n₀+n₁+n₂+n₃)}` (Lemma 0, §3 preamble). -/
def H := range (G.n 3 * ∑ i, G.n i + 1)

/-- The support of a component: the union of the supports of its vertices. -/
def compSupp {d} (C : (G.nabla d).ConnectedComponent) :=
  univ.filter fun i => ∃ z, (G.nabla d).connectedComponentMk z = C ∧ 0 < z.1 i

lemma mem_compSupp {d} {C : (G.nabla d).ConnectedComponent} {i} :
    i ∈ G.compSupp C ↔ ∃ z, (G.nabla d).connectedComponentMk z = C ∧ 0 < z.1 i := by
  simp [compSupp]

lemma reachable_of_sharesVar {d i} {z y : G.fiber d} (hz : 0 < z.1 i) (hy : 0 < y.1 i) :
    (G.nabla d).Reachable z y := by
  obtain rfl | hzy := eq_or_ne z y
  · rfl
  · exact SimpleGraph.Adj.reachable ⟨hzy, i, hz, hy⟩

lemma exists_not_reachable {d} (h : 2 ≤ G.ncomp d) :
    ∃ z y, ¬ (G.nabla d).Reachable z y := by
  obtain ⟨⟨z⟩, ⟨y⟩, hne⟩ := Fintype.one_lt_card_iff.1 h
  exact ⟨z, y, mt SimpleGraph.ConnectedComponent.sound hne⟩

/-- A component containing a factorization positive at some index of `compSupp C` is `C`. -/
lemma comp_eq_of_mem {d} {C : (G.nabla d).ConnectedComponent} {z : G.fiber d} {i}
    (hi : i ∈ G.compSupp C) (hzi : 0 < z.1 i) : (G.nabla d).connectedComponentMk z = C := by
  obtain ⟨_, rfl, hw⟩ := G.mem_compSupp.1 hi
  exact SimpleGraph.ConnectedComponent.sound (G.reachable_of_sharesVar hzi hw)

/-- **Lemma 2.1.** Distinct components of `∇_d` have disjoint supports. -/
lemma compSupp_disjoint {d} {C C' : (G.nabla d).ConnectedComponent} (h : C ≠ C') :
    Disjoint (G.compSupp C) (G.compSupp C') :=
  disjoint_left.2 fun _ hi hi' => by
    obtain ⟨_, rfl, hz⟩ := G.mem_compSupp.1 hi
    exact h (G.comp_eq_of_mem hi' hz)

/-- **Lemma 2.2.** At a contributing degree every factorization has a positive coordinate. -/
lemma exists_pos_of_contributes {d} (hd : 2 ≤ G.ncomp d) (z : G.fiber d) :
    ∃ i, 0 < z.1 i := by
  obtain ⟨u, v, huv⟩ := G.exists_not_reachable hd
  by_contra! hc
  have h0 (w : G.fiber d) : w = z := Subtype.ext (funext (by
    simpa [nu, (G.n_pos _).ne', le_zero_iff.1 (hc _)] using
      (G.nu_coe w).trans (G.nu_coe z).symm))
  exact huv (by rw [h0 u, h0 v])

/-- **Lemma 2.3–2.4.** A replacement `b = z - u + v` sharing a variable with `z` and with `y` puts
`z` and `y` in the same component. -/
lemma reachable_of_bridge {d k j} {z y : G.fiber d} {u v}
    (huz : u ≤ z.1) (huv : G.nu u = G.nu v)
    (hk : u k < z.1 k) (hy : 0 < y.1 j) (hv : 0 < v j) :
    (G.nabla d).Reachable z y := by
  have hb : G.nu (z.1 - u + v) = d := by
    rw [G.nu_add, add_comm, ← huv, ← G.nu_sub huz, G.nu_coe]
  exact (G.reachable_of_sharesVar (Nat.zero_lt_of_lt hk) (y := ⟨_, G.mem_fiber.2 hb⟩)
    (by simp; omega)).trans
    (G.reachable_of_sharesVar hy (by simp; omega)).symm

/-- **Lemma 0A.** Every contributing degree lies in `H`. -/
lemma le_H_of_contributes {d} (h : 2 ≤ G.ncomp d) : d ∈ G.H := by
  obtain ⟨z, y, hzy⟩ := G.exists_not_reachable h
  obtain ⟨j, hyj⟩ := G.exists_pos_of_contributes h y
  rw [H, mem_range, Nat.lt_succ_iff, ← G.nu_coe z, nu, mul_sum]
  refine sum_le_sum fun i _ => Nat.mul_le_mul_right _ (le_of_not_gt fun hzi => hzy ?_)
  have hlt := (G.n_strictMono.monotone (Fin.le_last j)).trans_lt hzi
  exact G.reachable_of_bridge (single_le hlt.le) (v := Pi.single j (G.n i))
    (by simp [mul_comm]) (by rwa [Pi.single_eq_same]) hyj (by simpa using G.n_pos i)

/-! ### Critical exponents and singleton-support components -/

/-- The indices that form a singleton-support component at a contributing degree `d`. -/
def critIndices (d) :=
  univ.filter fun i => 2 ≤ G.ncomp d ∧
    ∃ C : (G.nabla d).ConnectedComponent, G.compSupp C = {i}

lemma le_of_singleton_comp {d d' i}
    (h : i ∈ G.critIndices d) (h' : i ∈ G.critIndices d') : d' ≤ d := by
  have hdeg {e} (he : i ∈ G.critIndices e) :=
    let ⟨_, _, C, hC⟩ := mem_filter.1 he
    let hi := hC.symm ▸ mem_singleton_self i
    let ⟨z, _, hzi⟩ := G.mem_compSupp.1 hi
    Exists.intro z (And.intro hzi fun (y : G.fiber e) (hy : 0 < y.1 i) =>
      (G.nu_coe y).symm.trans <| sum_eq_single i
        (fun _ _ hj => by simp [Nat.eq_zero_of_not_pos fun h =>
          hj <| mem_singleton.1 <| hC ▸ G.mem_compSupp.2 ⟨y, G.comp_eq_of_mem hi hy, h⟩])
        (by simp))
  obtain ⟨z, hzi, hnu⟩ := hdeg h
  obtain ⟨z', hzi', hnu'⟩ := hdeg h'
  have := hnu z hzi; have := hnu' z' hzi'
  obtain ⟨u, v, huv⟩ := G.exists_not_reachable (mem_filter.1 h).2.1
  by_contra! hlt
  have := mul_pos hzi (G.n_pos i); have : z.1 i < z'.1 i := by nlinarith
  have hw (w : G.fiber d) : 0 < w.1 i := by
    by_contra! hw
    have hb := hnu' ⟨Pi.single i (z'.1 i - z.1 i) + w.1,
      G.mem_fiber.2 <| by simp [Nat.sub_mul]; omega⟩ (by simp; omega)
    simp [le_zero_iff.1 hw, Nat.sub_mul] at hb; omega
  exact huv (G.reachable_of_sharesVar (hw u) (hw v))

/-! ### Splitting along a pair -/

/-- `∇_d` has components with supports `K` and `Kᶜ` of size 2. -/
def IsSplit (d K) :=
  K.card = 2 ∧ ∃ C C' : (G.nabla d).ConnectedComponent, G.compSupp C = K ∧ G.compSupp C' = Kᶜ

/-- The pair family for the partition `K | Kᶜ`: degrees in `H` which split along `K`. -/
def fam (K) :=
  G.H.filter (G.IsSplit · K)

/-- `ℰ` (partition `03|12`). -/
abbrev famE := G.fam {1, 2}

/-- The selected factorization of `d` with support exactly `K` (a fixed choice; `0` if none). -/
def IsSel (d) (K : Finset (Fin 4)) (z) := G.nu z = d ∧ ∀ k, 0 < z k ↔ k ∈ K
def sel (d K) := epsilon (G.IsSel d K)

variable {G}

lemma IsSplit.compl {K d} (h : G.IsSplit d K) : G.IsSplit d Kᶜ :=
  let ⟨hK, C, C', hC, hC'⟩ := h
  ⟨by rw [card_compl, Fintype.card_fin, hK], C', C, hC', by rw [compl_compl, hC]⟩

/-- The selected vectors at a split degree: `ν = d` and support `K`. -/
lemma IsSplit.sel_of_split {d K} (hS : G.IsSplit d K) : G.IsSel d K (G.sel d K) := by
  apply epsilon_spec
  obtain ⟨hK, C, -, hC, -⟩ := hS
  obtain ⟨i, j, -, rfl⟩ := card_eq_two.1 hK
  have hiC := hC.symm ▸ mem_insert_self i _
  obtain ⟨z0, hz0, hz0i⟩ := G.mem_compSupp.1 hiC
  obtain ⟨z1, hz1, hz1j⟩ := G.mem_compSupp.1 (hC.symm ▸ mem_insert_of_mem (mem_singleton_self j))
  obtain ⟨p⟩ := SimpleGraph.ConnectedComponent.exact (hz0.trans hz1.symm)
  clear hz0 hz1
  obtain ⟨z, hi, hj⟩ : ∃ z : G.fiber d, 0 < z.1 i ∧ 0 < z.1 j := by
    induction p with
    | nil => exact ⟨_, hz0i, hz1j⟩
    | cons hadj _ ih =>
      obtain ⟨-, k, hxk, hyk⟩ := hadj
      rcases mem_insert.1 (hC ▸ G.mem_compSupp.2 ⟨_, G.comp_eq_of_mem hiC hz0i, hxk⟩) with rfl | hk
      · exact ih hyk hz1j
      · exact ⟨_, hz0i, mem_singleton.1 hk ▸ hxk⟩
  exact ⟨z.1, G.nu_coe z, fun k =>
    ⟨fun h => hC ▸ G.mem_compSupp.2 ⟨z, G.comp_eq_of_mem hiC hi, h⟩, by aesop⟩⟩

lemma IsSplit.sel_pos {d K} (hS : G.IsSplit d K) {i}
    (hi : i ∈ K := by decide) : 0 < G.sel d K i :=
  (hS.sel_of_split.2 i).2 hi

/-- **Selected-vector replacement principle** (Lemma 2 applied to the selected vectors). -/
lemma IsSplit.no_replace {d K} (hS : G.IsSplit d K)
    {U V} (hUV : G.nu U = G.nu V) (hUz : U ≤ G.sel d K) (j)
    (hVj : 0 < V j) (hj : j ∉ K := by decide) : G.sel d K = U :=
  funext fun k => le_antisymm (le_of_not_gt fun hk => by
    have hz := hS.sel_of_split
    obtain ⟨-, -, C', -, hC'⟩ := hS
    obtain ⟨y, rfl, hyj⟩ := G.mem_compSupp.1 (hC' ▸ mem_compl.2 hj)
    exact mem_compl.1 (hC' ▸ G.mem_compSupp.2 ⟨⟨_, G.mem_fiber.2 hz.1⟩,
      SimpleGraph.ConnectedComponent.sound (G.reachable_of_bridge hUz hUV hk hyj hVj),
      Nat.zero_lt_of_lt hk⟩) ((hz.2 k).1 (Nat.zero_lt_of_lt hk))) (hUz k)

variable (G)

/-! ### Vector identity and antichain counting -/

/-- **Lemma 8, second identity.** -/
theorem identity2 : (G.W - G.A) * G.n 2 = G.nu ![0, G.W - G.B, 0, G.B - G.A] := by
  simp [nu, Fin.sum_univ_four]
  zify [G.A_lt_B.le, G.B_lt_W.le, (G.A_lt_B.trans G.B_lt_W).le]; ring

/-- A family whose selected `k`-coordinates are at most `c` has at most `c` members. -/
lemma card_le_of_coord {K} (k) (F : Finset ℕ) {c}
    (hc : ∀ d ∈ F, G.IsSplit d K ∧ ¬ c < G.sel d K k) (hk : k ∈ K := by decide) : F.card ≤ c := by
  refine (card_le_card_of_injOn (G.sel · K k)
    (fun d hd => mem_coe.2 (mem_Icc.2 ⟨(hc d hd).1.sel_pos hk, le_of_not_gt (hc d hd).2⟩)) ?_).trans
    (by simp)
  intro d hd d' hd' h; dsimp at h
  obtain ⟨i, hKe, j, hj⟩ := (by decide : ∀ K : Finset (Fin 4), K.card = 2 → ∀ k ∈ K,
    ∃ i, (∀ m ∈ K, m = i ∨ m = k) ∧ ∃ j, j ∉ K) K (hc d hd).1.1 k hk
  wlog hi : G.sel d K i ≤ G.sel d' K i generalizing d d'
  · exact (this hd' hd h.symm (by omega)).symm
  have hS := (hc d hd).1
  have hz := hS.sel_of_split
  have hle (m) : G.sel d K m ≤ G.sel d' K m := by
    by_contra! hm
    rcases hKe m ((hz.2 m).1 (by omega)) with rfl | rfl <;> omega
  rw [← hz.1, ← (hc d' hd').1.sel_of_split.1, (hc d' hd').1.no_replace
    (hz.1.trans hS.compl.sel_of_split.1.symm) hle j
    (hS.compl.sel_pos (mem_compl.2 hj)) hj]

lemma card_le_sub_one (K₀) {K i} (j) (hK : ∀ {d}, G.IsSplit d K₀ → G.IsSplit d K) {c V}
    (hV : c * G.n i = G.nu V) (hVj : 0 < V j)
    (hi : i ∈ K := by decide) (hj : j ∉ K := by decide) : (G.fam K₀).card ≤ c - 1 :=
  G.card_le_of_coord i (G.fam K₀) (fun _ hd => by
    have hS := hK (mem_filter.1 hd).2
    refine ⟨hS, fun hc => ?_⟩
    obtain ⟨k, hkK, hki⟩ := (by decide : ∀ K : Finset (Fin 4), K.card = 2 → ∀ i,
      ∃ k ∈ K, k ≠ i) K hS.1 i
    have := congrFun (hS.no_replace ((G.nu_single i c).trans hV) (single_le (by omega))
      j hVj hj) k
    simp [hki, (hS.sel_pos hkK).ne'] at this) hi

lemma E_le {p q} (hp : 1 ≤ p) (hpq : p * G.A = q * (G.W - G.B)) :
    G.famE.card ≤ p + (q - 1) := by
  rw [← card_filter_add_card_filter_not fun d => ¬ p < G.sel d {1, 2} 1]
  apply Nat.add_le_add
  · exact G.card_le_of_coord 1 _ fun _ hd => ⟨by simp_all [fam], (mem_filter.1 hd).2⟩
  · exact G.card_le_of_coord 2 _ fun d hd => by
      simp [fam] at hd
      refine ⟨hd.1.2, fun hq' => ?_⟩
      have hid3 : G.nu ![0, p, q, 0] = G.nu ![p, 0, 0, q] := by
        simp [nu, Fin.sum_univ_four]; zify [G.B_lt_W.le] at hpq ⊢; linear_combination G.g * hpq
      have := congrFun (hd.1.2.no_replace hid3
        (fun i => by fin_cases i <;> simp <;> omega) 0 hp) 1
      simp at this; omega

/-- **Main combinatorial theorem.** `β₁ ≤ 2W`. -/
theorem beta1_le_two_W : ∑ d ∈ G.H, (G.ncomp d - 1) ≤ 2 * G.W := by
  refine (?_ : _ ≤ (G.fam {0, 1}).card + (G.fam {1, 3}).card + G.famE.card + 4).trans ?_
  · refine (Nat.add_le_add_left ((card_biUnion fun _ _ _ _ hne => disjoint_left.2 fun _ hi hi' =>
      hne (le_antisymm (G.le_of_singleton_comp hi' hi) (G.le_of_singleton_comp hi hi'))).symm.trans_le
      (card_le_univ (G.H.biUnion G.critIndices))) _).trans' ?_
    simp only [ncomp, fam, card_filter, ← sum_add_distrib]
    refine sum_le_sum fun d _ => ?_
    by_cases hc : 2 ≤ G.ncomp d
    · have hC (C) :
          2 ≤ (G.compSupp (d := d) C ∩ univ).card + (G.compSupp C ∩ G.critIndices d).card := by
        rw [inter_univ]
        obtain ⟨i, hi⟩ := G.exists_pos_of_contributes hc C.out
        have := card_pos.2 ⟨i, G.mem_compSupp.2 ⟨_, C.out_eq, hi⟩⟩
        by_cases h : (G.compSupp C).card = 1
        · obtain ⟨j, hj⟩ := card_eq_one.1 h
          exact Nat.add_le_add h.ge (card_pos.2 ⟨j, by simp [critIndices, hj, hc]; exact ⟨C, hj⟩⟩)
        · omega
      have h2c := sum_le_sum fun C (_ : C ∈ univ) => hC C
      have hsum (S) : ∑ C, (G.compSupp (d := d) C ∩ S).card ≤ S.card := by
        rw [← card_biUnion fun _ _ _ _ h =>
          (G.compSupp_disjoint h).mono inter_subset_left inter_subset_left, ← biUnion_inter]
        exact card_le_card inter_subset_right
      have := hsum (G.critIndices d); have := hsum univ
      simp [sum_add_distrib] at h2c this
      rcases (G.critIndices d).eq_empty_or_nonempty with hpos | hpos
      · simp [hpos] at hC
        obtain ⟨C1, C2, h12⟩ := Fintype.one_lt_card_iff.1 hc
        rcases (by decide :
          ∀ A B : Finset (Fin 4), Disjoint A B → 2 ≤ A.card → 2 ≤ B.card →
            ∃ K, (K = {0, 1} ∨ K = {1, 3} ∨ K = {1, 2}) ∧ K.card = 2 ∧
              (A = K ∧ B = Kᶜ ∨ B = K ∧ A = Kᶜ))
          _ _ (G.compSupp_disjoint h12) (hC C1) (hC C2) with
          ⟨K, rfl | rfl | rfl, hK, ⟨h1, h2⟩ | ⟨h1, h2⟩⟩ <;>
          simp only [show G.IsSplit d _ from ⟨hK, _, _, h1, h2⟩, ↓reduceIte] <;> omega
      · have := hpos.card_pos; omega
    · unfold ncomp at hc; omega
  · by_contra! hc
    have := G.A_pos; have := G.A_lt_B; have hBW := Nat.sub_pos_of_lt G.B_lt_W
    have hid1 : G.B * G.n 1 = G.nu ![G.B - G.A, 0, G.A, 0] := by
      simp [nu, Fin.sum_univ_four]; zify [G.A_lt_B.le]; ring
    have := G.card_le_sub_one {0, 1} 2 id hid1 G.A_pos
    have := G.card_le_sub_one {1, 3} 2 id hid1 G.A_pos
    have := G.card_le_sub_one {0, 1} 1 IsSplit.compl G.identity2 hBW
    have := G.card_le_sub_one {1, 3} 1 IsSplit.compl G.identity2 hBW
    have := G.E_le hBW (mul_comm _ _)
    have := G.E_le (q := 1) le_rfl (by omega)
    have : (G.fam {1, 3}).card ≤ G.W - 3 :=
      G.card_le_of_coord 3 _ fun D hD => by
        have hS := (mem_filter.1 hD).2
        refine ⟨hS, fun hD3 => ?_⟩
        have := hS.sel_pos (i := 1)
        set y := G.sel D {1, 3}ᶜ
        have : 0 < y 2 := hS.compl.sel_pos
        have := G.card_le_sub_one {0, 1} 0 IsSplit.compl
          (by rw [Nat.sub_mul, G.identity2,
            ← hS.no_replace (G.identity2.symm.trans (G.nu_single 2 _).symm)
              (fun j => by fin_cases j <;> simp <;> omega) 2 (by simp; omega),
            hS.sel_of_split.1, ← hS.compl.sel_of_split.1, G.nu_sub (single_le (le_refl (y 2))),
            G.nu_single, Nat.add_sub_cancel_left] :
            (G.W - G.A - y 2) * G.n 2 = G.nu (y - Pi.single 2 (y 2)))
          hS.compl.sel_pos
        omega
    omega

/-! ### The algebraic bridge: `μ(I) ≤ β₁` -/

variable {K : Type*} [Field K]

/-- The monomial `X^z` for `z : Fin 4 → ℕ`. -/
def mono (z : Fin 4 → ℕ) :=
  monomial (Finsupp.equivFunOnFinite.symm z) (1 : K)

/-- The toric map `K[X₀,…,X₃] → K[t]`, `Xᵢ ↦ t^{nᵢ}`. -/
abbrev toricMap :=
  aeval (R := K) ((Polynomial.X : Polynomial K) ^ G.n ·)

lemma toricMap_monomial (s) (c : K) :
    G.toricMap (monomial s c) = Polynomial.C c * Polynomial.X ^ G.nu s := by
  simp [toricMap, aeval_monomial, Finsupp.prod_fintype, ← pow_mul, mul_comm (G.n _),
    prod_pow_eq_pow_sum, nu]

/-- A chosen factorization of `d` (junk `0` when the fiber is empty). -/
def root (d) :=
  if h : Nonempty (G.nabla d).ConnectedComponent then mono (K := K) h.some.out.1 else 0

variable (K) in
theorem spanRank_le : (toricIdeal K G.n).spanRank ≤ (2 * G.W : ℕ) := by
  set B := G.H.biUnion fun d =>
    if h : Nonempty (G.nabla d).ConnectedComponent then
      (univ.erase h.some).image fun C => mono (K := K) C.out.1 - G.root d
    else ∅
  set J := Ideal.span (SetLike.coe B)
  have hspan (d) (x : G.fiber d) : mono x.1 - G.root d ∈ J := by
    induction d using Nat.strong_induction_on with
    | _ d IH =>
    set Cx := (G.nabla d).connectedComponentMk x
    rw [← sub_add_sub_cancel _ (mono Cx.out.1) _]
    refine add_mem ?_ ?_
    · obtain ⟨p⟩ := SimpleGraph.ConnectedComponent.exact Cx.out_eq.symm
      generalize Cx.out = y at p ⊢
      clear Cx
      induction p with
      | nil => simp
      | @cons u v _ hadj _ ih =>
        rw [← sub_add_sub_cancel _ (mono v.1) _]
        refine add_mem ?_ ih
        obtain ⟨-, i, hi, hi'⟩ := hadj
        have hX {w : G.fiber d} (hw : 0 < w.1 i) : mono w.1 - X i * G.root (d - G.n i) ∈ J := by
          have h := single_le (c := 1) hw
          have := G.nu_sub h; simp at this
          have := G.n_pos i
          rw [show mono w.1 = X i * mono (w.1 - Pi.single i 1) by
            rw [mono, mono, X, monomial_mul_monomial, one_mul]
            congr 2; ext a; simp [Finsupp.single_eq_pi_single, add_tsub_cancel_of_le (h a)], ← mul_sub]
          exact J.mul_mem_left _ (IH _ (by omega) ⟨_, G.mem_fiber.2 (by omega)⟩)
        simpa using sub_mem (hX hi) (hX hi')
    · have h : Nonempty _ := ⟨Cx⟩
      by_cases hC : Cx = h.some
      · simp [root, h, hC]
      · refine Ideal.subset_span (mem_coe.2 (mem_biUnion.2
          ⟨d, G.le_H_of_contributes (Fintype.one_lt_card_iff.2 ⟨Cx, _, hC⟩), ?_⟩))
        rw [dif_pos h]
        exact mem_image_of_mem _ (mem_erase.2 ⟨hC, mem_univ _⟩)
  have heq : toricIdeal K G.n = J := by
    refine le_antisymm (fun f hf => ?_) (Ideal.span_le.2 fun p hp => ?_)
    · have hzero : ∑ s ∈ f.support, C (f.coeff s) * G.root (G.nu s) = 0 := by
        rw [← sum_fiberwise_of_maps_to fun _ => mem_image_of_mem (fun s : _ →₀ _ => G.nu s)]
        refine sum_eq_zero fun d _ => ?_
        have hcoeff := congrArg (Polynomial.coeff · d)
          ((congrArg G.toricMap f.as_sum).symm.trans hf)
        simp only [map_sum, G.toricMap_monomial, Polynomial.finsetSum_coeff,
          Polynomial.coeff_C_mul_X_pow, Polynomial.coeff_zero, @eq_comm _ d] at hcoeff
        rw [sum_congr rfl fun s hs => by rw [(mem_filter.1 hs).2], ← sum_mul, ← map_sum,
          sum_filter, hcoeff, map_zero, zero_mul]
      have hm := J.sum_mem fun s (_ : s ∈ f.support) =>
        J.mul_mem_left (C (f.coeff s)) (hspan _ ⟨s, G.mem_fiber.2 rfl⟩)
      simp_rw [mul_sub, sum_sub_distrib, hzero] at hm
      simpa [mono, C_mul_monomial, ← f.as_sum] using hm
    · obtain ⟨d, -, hp⟩ := mem_biUnion.1 (mem_coe.1 hp)
      split_ifs at hp with h
      · obtain ⟨C, -, rfl⟩ := mem_image.1 hp
        simp [toricIdeal, mono, G.toricMap_monomial, root, h]
      · simp at hp
  rw [heq]
  refine (Submodule.spanRank_span_le_card _).trans
    (Cardinal.mk_coe_finset.trans_le (Nat.cast_le.2
      ((card_biUnion_le.trans (sum_le_sum fun d _ => ?_)).trans G.beta1_le_two_W)))
  split_ifs with h
  · exact card_image_le.trans_eq (card_erase_of_mem (mem_univ _))
  · simp

end GenData

/-- **Main theorem.** For a minimally four-generated numerical semigroup, the first Betti number
is at most `2W`, `W` the normalized width. -/
theorem beta1_le_two_mul_normalizedWidth (K : Type*) [Field K] (n : Fin 4 → ℕ)
    (hpos : 0 < n 0) (hmono : StrictMono n) (_hgcd : Finset.univ.gcd n = 1)
    (_hmin : MinimallyGenerates n) :
    (toricIdeal K n).spanRank ≤ (2 * normalizedWidth n : ℕ) :=
  (GenData.mk n hpos hmono).spanRank_le K

/-- The first Betti number is at most twice the width. -/
theorem beta1_le_two_mul_width (K : Type*) [Field K] (n : Fin 4 → ℕ)
    (hpos : 0 < n 0) (hmono : StrictMono n) (hgcd : Finset.univ.gcd n = 1)
    (hmin : MinimallyGenerates n) :
    (toricIdeal K n).spanRank ≤ (2 * (n 3 - n 0) : ℕ) :=
  (beta1_le_two_mul_normalizedWidth K n hpos hmono hgcd hmin).trans
    (by gcongr; exact Nat.div_le_self _ _)

end SemigroupBetti
