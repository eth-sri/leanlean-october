-lemma g_dvd_a : G.g ∣ G.a := Nat.gcd_dvd_left _ _
-lemma g_dvd_b : G.g ∣ G.b := (Nat.gcd_dvd_right _ _).trans (Nat.gcd_dvd_left _ _)
-lemma g_dvd_w : G.g ∣ G.w := (Nat.gcd_dvd_right _ _).trans (Nat.gcd_dvd_right _ _)
