-  have := G.A_lt_B; have := G.B_lt_W; omega
-
-lemma gcd_m_g : Nat.gcd G.m G.g = 1 := G.gcd_eq_one
-
-lemma W_le_w : G.W ≤ G.w := by
-  rw [G.w_eq]; exact Nat.le_mul_of_pos_left _ G.g_pos
-
-end GenData
-
-end SemigroupBetti
