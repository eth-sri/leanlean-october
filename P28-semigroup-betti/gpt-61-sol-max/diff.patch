-lemma A_lt_B : G.A < G.B := by
-  have h := G.a_lt_b; rw [G.a_eq, G.b_eq] at h; exact Nat.lt_of_mul_lt_mul_left h
-
-lemma B_lt_W : G.B < G.W := by
-  have h := G.b_lt_w; rw [G.b_eq, G.w_eq] at h; exact Nat.lt_of_mul_lt_mul_left h
