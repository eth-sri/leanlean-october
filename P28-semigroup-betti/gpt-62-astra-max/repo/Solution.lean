module

public import SemigroupBetti
public import Mathlib.Algebra.Module.SpanRank
public import Mathlib.Algebra.Polynomial.AlgebraMap
public import Mathlib.Algebra.Polynomial.Basis
public import Mathlib.RingTheory.MvPolynomial.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.Tactic.GRewrite

/-! # Linear bounds for the first Betti number of four-generated numerical semigroups -/
@[expose] public noncomputable section

namespace SemigroupBetti

/-! ## The toric ideal is generated by the moves

In the quotient by the moves, `normal_form` identifies each monomial with its
degree representative. Extending the representative assignment linearly on the
basis of `K[t]` factors the quotient map through toric evaluation.
-/
open Finset Finsupp MvPolynomial

variable (K : Type*) [Field K] (n : Fin 4 → ℕ)

local notation "φ" => aeval (R := K) (fun i => (Polynomial.X : Polynomial K) ^ n i)

/-- The kernel of the monomial parametrization `X i ↦ t ^ n i`. -/
def toricIdeal : Ideal (MvPolynomial (Fin 4) K) := RingHom.ker (φ).toRingHom

local notation "Xₘ" => basisMonomials I K

lemma eval_mono (x : V) : φ (Xₘ x) = Polynomial.basisMonomials K (x.weight n) := by
  simp [aeval_monomial, Finsupp.prod, Finsupp.sum, weight_apply, ← pow_mul,
    Polynomial.monomial_one_right_eq_X_pow, prod_pow_eq_pow_sum, mul_comm]

lemma spanRank_le_moves (hn : ∀ i, n i > 0) :
    (toricIdeal K n).spanRank ≤ (#(labels n) : Cardinal) := by
  classical
  let bin (x : labels n) := Xₘ (pick n x.val.1.1 x.val.2) - Xₘ (root n x.val.2)
  let J := Ideal.span (Set.range bin)
  let q := Ideal.Quotient.mkₐ K J
  let L := (Polynomial.basisMonomials K).constr K fun d => q (Xₘ (root n d))
  have lifts : q.toLinearMap = L ∘ₗ (φ).toLinearMap := by
    apply (Xₘ).ext
    intro v
    change q _ = L (φ _)
    rw [eval_mono, Module.Basis.constr_basis]
    -- View monomial multiplication in the quotient as the target addition.
    exact normal_form (MonoidHom.toAdditive (q.toMonoidHom.comp (monomialOneHom K I))) hn
      (fun j => Ideal.Quotient.eq.mpr (Ideal.subset_span ⟨j, rfl⟩)) ⟨v, rfl⟩
  have hJ : toricIdeal K n = J := by
    apply le_antisymm
    · intro f hf
      apply Ideal.Quotient.eq_zero_iff_mem.mp
      simpa [q, show φ f = 0 from hf] using LinearMap.congr_fun lifts f
    · apply Ideal.span_le.mpr
      rintro _ ⟨x, rfl⟩
      change φ (_ - _) = 0
      have h := (pick_spec (inter_subset_left (mem_sigma.mp x.prop).2)).deg
      simp only [map_sub, eval_mono, h, (root_spec ⟨_, h⟩).prop, sub_self]
  grw [hJ, Submodule.spanRank_span_le_card]
  simpa [Cardinal.mk_fintype] using Fintype.card_range_le bin

/-- No generator is a sum of copies of the other generators. -/
def MinimallyGenerates : Prop :=
  ∀ i, n i ∉ AddSubmonoid.closure (n '' {j | j ≠ i})

variable (hpos : 0 < n 0) (hmono : StrictMono n)
  (_hgcd : Finset.univ.gcd n = 1) (_hmin : MinimallyGenerates n)
include hpos hmono _hgcd _hmin

-- The stronger estimate below only uses strict monotonicity and positivity.
set_option linter.unusedSectionVars false in
/-- The number of generators of the toric ideal is at most twice the normalized width. -/
theorem beta1_le_two_mul_normalizedWidth :
    (toricIdeal K n).spanRank ≤ (2 * normalizedWidth n : ℕ) := by
  grw [spanRank_le_moves K n (fun i => hpos.trans_le (hmono.monotone (Fin.zero_le i))),
    normalized_count hmono]

/-- In particular the number is at most twice the width. -/
theorem beta1_le_two_mul_width : (toricIdeal K n).spanRank ≤ (2 * (n 3 - n 0) : ℕ) := by
  grw [beta1_le_two_mul_normalizedWidth K n hpos hmono _hgcd _hmin,
    normalizedWidth, Nat.div_le_self]

end SemigroupBetti
