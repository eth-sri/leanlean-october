-theorem contDiff_exponentialTimeWeight {d : ℕ} (rho tBase : ℝ) :
-    ContDiff ℝ ⊤ (exponentialTimeWeight (d := d) rho tBase) := by
-  unfold exponentialTimeWeight
-  fun_prop
