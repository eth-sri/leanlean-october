+  have hΦop (p : KineticPoint n) :
+      viscousTransportedOperator B b 0 Φ p ≤ -Φ p :=
+    viscousTransportedOperator_growthBarrier_le zero_le_one
+      (fun t y z => (hB t y z).2) hb r p
