-/-- Position convolution of the continuous extension, in physical coordinate order. -/
-def positionBarrierConvolution (κ : ℝ → ℝ) (phi : (ℝ × ℝ) → ℝ) (q : ℝ × ℝ) : ℝ :=
-  ∫ Y, barrierConvolutionIntegrand κ phi q Y
