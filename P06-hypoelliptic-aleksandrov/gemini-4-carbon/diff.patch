+    rw [norm_mul, Real.norm_of_nonneg (Real.exp_pos _).le,
+      Real.norm_of_nonneg (connectionKernel_nonneg c t hc1.le ht)]
+    exact mul_le_of_le_one_left (connectionKernel_nonneg c t hc1.le ht)
