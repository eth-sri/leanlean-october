-        (reverseTimeFormResidual r₀ r₁ h₀₁ hΩ hΩbounded a b c
-          haSmooth hbSmooth hcSmooth F hFSmooth U) hdu) =
-      inner ℝ (valueCLM hΩ (galerkinVector hΩ k)) initial := by
-  let T := r₁ - r₀
