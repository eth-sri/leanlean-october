+    {X E ι : Type*} [TopologicalSpace X] [TopologicalSpace E]
+    {l : Filter ι} (F : ι → C(X, E)) (U : C(X, E)) (x : X)
+    (hF : Tendsto F l (𝓝 U)) :
+    Tendsto (fun n => F n x) l (𝓝 (U x)) := by
+  exact ((continuous_eval_const x).tendsto U).comp hF
