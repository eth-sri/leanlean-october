-        ‖hR.toLp R‖ * Real.sqrt (∫ z in V, w z * Hk z ^ 2) := by ring
-    _ ≤ ((1 : ℝ) / 8) * ‖hqh.toLp qh‖ ^ 2 +
-          (2 / (1 : ℝ)) * (2 * Keta * ‖hR.toLp R‖) ^ 2 +
-        ((lam / 8) * (∫ z in V, w z * Hk z ^ 2) +
-          (2 / lam) * ‖hR.toLp R‖ ^ 2) := by linarith
