-private theorem gradient_translate {d : ℕ} {f : PDE.Vec d → ℝ}
-    (hf : ContDiff ℝ 2 f) (c x : PDE.Vec d) :
-    PDE.classicalGradient (fun y => f (y - c)) x = PDE.classicalGradient f (x - c) := by
