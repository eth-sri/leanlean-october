-/-- Outside a fixed rectangle, every nonzero convolution summand has gauge at least one. -/
-theorem barrier_convolution_far_gauge (eta : ℝ → ℝ) (S : ℝ)
-    (hb : ∀ x ∈ tsupport eta, |x| < S) (q : ℝ × ℝ)
-    (hq : S + 1 < |q.1| ∨ 1 ≤ |q.2|) (Y : ℝ) (hη : eta (q.1 - Y) ≠ 0) :
