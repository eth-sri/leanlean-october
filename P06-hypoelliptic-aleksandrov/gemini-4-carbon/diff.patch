-          P.velocity - v (P.time - tminus)))) 0 -
-      PDE.vecDot (deriv v (P.time - tminus))
-        (kineticVelocityGradient (fun Q : KineticPoint d =>
-          f (P.time - tminus, (Q.position, Q.velocity)))
-          ⟨0, P.position - x (P.time - tminus), P.velocity - v (P.time - tminus)⟩) -
