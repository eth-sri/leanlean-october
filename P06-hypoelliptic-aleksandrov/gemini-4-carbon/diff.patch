+/-- The velocity cutoff is one on the profile domain and zero beyond the barrier radius. -/
+def constructionVelocityCutoff {d : ℕ} (m R : ℝ) (q : XV d) : ℝ :=
+  1 - Real.smoothTransition ((PDE.vecNormSq q.2 - m) / (R ^ 2 - m))
