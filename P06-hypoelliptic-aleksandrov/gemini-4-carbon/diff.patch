-  let : LocallyCompactSpace U := hU.locallyCompactSpace
-  let C (n : ℕ) : Set E := Subtype.val '' compactCovering U n
-  have hC (n : ℕ) : IsCompact (C n) :=
-    (isCompact_compactCovering U n).image continuous_subtype_val
-  have hCU (n : ℕ) : C n ⊆ U := by
-    rintro x ⟨y, _, rfl⟩
-    exact y.2
