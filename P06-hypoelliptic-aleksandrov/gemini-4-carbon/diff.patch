-          (A y i j * spatialSecond q k j y) := by
-    rw [Finset.mul_sum]
-    exact Finset.sum_le_sum fun k _ => hrow k
-  calc
-    lam * (η y) ^ 2 * (∑ k, ∑ i, spatialSecond q k i y ^ 2) =
-        (η y) ^ 2 * (lam * (∑ k, ∑ i, spatialSecond q k i y ^ 2)) := by ring
