+/-- A measurable representative of the full extended source, including the boundary. -/
+def constructionIndicatorSource {d : ℕ} {alpha : ℝ}
+    (h : CounterProfileStatement d alpha) (r mu R : ℝ) (z : ℝ × XV d) : ℝ :=
