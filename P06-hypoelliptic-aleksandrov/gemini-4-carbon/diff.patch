-/-- Restricted ENNReal norm scaling for the unamplified scalar pullback. -/
-theorem parabolicELpNormOn_pullbackScalar
-    {d : ℕ} (t₀ : ℝ) (v₀ : PDE.Vec d) {r : ℝ} (hr : 0 < r)
