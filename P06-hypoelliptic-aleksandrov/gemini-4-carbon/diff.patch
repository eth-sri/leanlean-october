-    exact (Continuous.memLp_parabolicMorreyUnitBox
-      (hcontU.mul ((continuous_apply i).comp continuous_snd))).integrable
-      (parabolicExponent_one_le d)
-  have hCV : ∀ i : Fin d, Integrable (fun y : TimeVelocity d => (-c) * y.2 i)
