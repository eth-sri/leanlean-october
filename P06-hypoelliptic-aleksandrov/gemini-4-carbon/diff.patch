-/-- The Fourier-inversion integral `∫ e^{i ξ·z} φ(ξ) dξ` on `ℝ^d`. -/
-def vecInvIntegral (φ : PDE.Vec d → ℂ) (z : PDE.Vec d) : ℂ :=
-  ∫ ξ, cexp (I * ((PDE.vecDot ξ z : ℝ) : ℂ)) * φ ξ
