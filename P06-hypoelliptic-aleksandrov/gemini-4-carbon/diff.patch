+        z.1 - (q.baseTime + q.radius ^ 2) ∧
+      z.1 - (q.baseTime + q.radius ^ 2) < 4 * q.radius ^ 2 / eta ∧
+      ∀ i, |z.2 i - q.center i| < 3 * zeta * q.radius := by
