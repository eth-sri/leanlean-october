+        simp only [Set.domRestrict_apply, Uext, dif_pos t.2]
+      rw [hEq]
+      exact Ubar.continuous
+    have hIoo : ∀ᵐ t ∂volume.restrict (Icc 0 T), t ∈ Ioo 0 T := by
