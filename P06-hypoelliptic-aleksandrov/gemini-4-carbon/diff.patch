-    hAmeas hlam hAlower hAupper hS η hη hηcompact ζ hζ hζcompact rG rH hrG hrH
-  let P : ℝ → ℝ := fun ε => ∑ i : Fin d, ∑ j : Fin d, ∑ k : Fin d,
