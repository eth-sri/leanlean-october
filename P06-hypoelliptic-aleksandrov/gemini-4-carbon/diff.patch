-  have hnL : (n : ℝ) ≤ L := by dsimp only [L]; nlinarith only [hn, hM]
-  have hsz : (2 * M + 1) * ((n : ℝ) + 1) ≤ L := by
-    dsimp only [L]
-    linarith only [hn]
-  have hsq : L ≤ L ^ 2 := by nlinarith only [hL]
-  have hsz' : 2 * M + 1 ≤ (1 / ((n : ℝ) + 1)) * L := by
-    rw [one_div, ← div_eq_inv_mul]
-    exact (le_div_iff₀ hp).mpr hsz
