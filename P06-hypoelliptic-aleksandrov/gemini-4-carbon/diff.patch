-            velocity coordinate ∧
-          velocity coordinate ≤
-            -1 + 2 * (parabolicDyadicVelocityCode n index coordinate + 1 : ℝ) / (2 : ℝ) ^ n := by
-  simp [parabolicDyadicVelocityCell]
-
-@[simp] theorem mem_parabolicDyadicHalfOpenCell_iff {d n : ℕ}
