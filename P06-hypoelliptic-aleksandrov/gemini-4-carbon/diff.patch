+    IsOpen {q : ℝ × EvolutionAmbientState n | q.2 ∈ evolutionStateSet Ω γ q.1} := by
+  have hc : Continuous (fun q : ℝ × EvolutionAmbientState n => q.2.1 - γ q.1) :=
