+  exact ((contDiff_timeCutoffTheta.continuous_deriv (by simp)).comp (((continuous_selectedFlatProfile h r).comp continuous_snd).sub hb)).neg.mul
+    ((continuous_const.mul he).mul (continuous_const.sub (hv.div_const _)))
