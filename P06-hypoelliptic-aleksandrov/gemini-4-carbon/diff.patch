-    (lam Lam p : ℝ) (hlam : 0 < lam) (hLam : lam ≤ Lam)
-    (hp : 1 + bellmanAdjointExponent (Lam / lam)
-      ((le_div_iff₀ hlam).2 (by simpa only [one_mul] using hLam)) < p) :
