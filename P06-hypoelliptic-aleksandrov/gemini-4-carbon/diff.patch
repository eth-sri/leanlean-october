+    rw [hM.cfc_eq f, Matrix.IsHermitian.cfc, Unitary.conjStarAlgAut_apply,
+      Matrix.trace_mul_cycle]
+    simp [Matrix.trace_diagonal, Function.comp_def]
+  exact trace_cfc_eq_sum _
