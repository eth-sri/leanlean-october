-      fun z => parabolicMorreyBoxAffineProjection t_b v_b r_b u (t_s, v_s) +
-        ∑ i : Fin d, (r_s *
-          parabolicMorreyBoxVelocitySlope t_b v_b r_b u i) * z.2 i := by
