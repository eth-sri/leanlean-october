-        4 * (a * Real.sqrt rho) ^ 2 *
-          Real.cosh (resolventPhase a rho z) *
-            PDE.vecDot z.2 (A *ᵥ z.2) := by
-  rw [velocityHessian_resolventBarrier,
-    matrixContraction_add_right, matrixContraction_smul_right,
