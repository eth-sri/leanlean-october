-          (volume.restrict (backwardCylinder P₀ R)) →
-        ∀ P ∈ closure (backwardCylinder P₀ R),
-          u P ≤ sSup ((fun P => max (u P) 0) '' kineticBoundary P₀ R) +
-            C * R ^ (2 - 6 / p) *
-              (eLpNorm (fun P => max (f P) 0) (ENNReal.ofReal p)
