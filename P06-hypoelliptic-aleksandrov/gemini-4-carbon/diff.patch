-theorem unitCutoffVelocitySlice_hessian {d : ℕ}
-    {f : ℝ × (PDE.Vec d × PDE.Vec d) → ℝ}
-    (hf : ContDiff ℝ (⊤ : ℕ∞) f) (Q : KineticPoint d) (i j : Fin d) :
-    sliceHessian (unitCutoffVelocitySlice f Q) Q.velocity i j =
