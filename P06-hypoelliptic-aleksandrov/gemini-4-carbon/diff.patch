-    (hrn : (eLpNorm g (ENNReal.ofReal r) μ).toReal ≤ A) :
-    MemLp g (ENNReal.ofReal γ) μ ∧
-      (eLpNorm g (ENNReal.ofReal γ) μ).toReal ≤ 2 * A := by
