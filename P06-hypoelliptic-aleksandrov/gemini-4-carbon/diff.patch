+    (aestronglyMeasurable_reverseTimeSpatialFormBochnerRaw r₀ r₁ h₀₁ hΩ hΩbounded a b c
+      haSmooth hbSmooth hcSmooth u) ?_
+  exact Eventually.of_forall
