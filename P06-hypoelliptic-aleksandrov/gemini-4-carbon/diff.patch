-  have htime := integral_local_time_derivative_sq_le V hV.measurableSet u A Lam
-    (hlam.le.trans hlamLam)
-    (fun z _ i j => abs_apply_le_of_loewner hlam (hlo z.1 z.2) (hhi z.1 z.2) i j)
