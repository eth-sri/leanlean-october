+    (hc : HasCompactSupport ψ) (hs : tsupport ψ ⊆ U) :
+    (∫ x in U, u x * transportedAdjoint B b ψ x) =
+      ∫ x in U, transportedOperator B b u x * ψ x := by
+  let D (v : EvolutionVec d) (f : EvolutionVec d → ℝ) (x : EvolutionVec d) :=
