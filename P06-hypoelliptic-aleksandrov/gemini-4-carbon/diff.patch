-/-- Bin zero charges its initial atom and its positive-time slab separately. -/
-theorem timeBinCount_initial_mass_le_atom_add_slab
-    (nu : Measure Point) [IsFiniteMeasure nu] (c : Clock) (s T : ℝ)
