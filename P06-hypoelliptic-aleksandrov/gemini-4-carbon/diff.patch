+/-- Uniform Euclidean acceleration bound for the source stack Hermite path. -/
+theorem stack_hermite_acceleration {d : ℕ} {r T : ℝ} (hr : 0 < r)
+    (m : ℕ) (hTlo : r^2/8 ≤ T) (x0 v0 x1 v1 : PDE.Vec d)
