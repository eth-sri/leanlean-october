+    intro v
+    rw [Measure.volume_eq_prod, Measure.prod_apply (measurable_prodMk_left hs)]
+    rfl
+  rw [volume_transport_slices (isOpen_iUnion (fun i => isOpen_cylinder (P i) (r i))).measurableSet,
