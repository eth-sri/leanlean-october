-    {N : ℕ} {r₀ r₁ : ℝ} {Q : PDE.Mat N}
-    (hQ : Q.PosDef)
-    (hr : r₀ < r₁)
-    (lam Lam : ℝ)
-    (hlam : 0 < lam)
-    (hlamLam : lam ≤ Lam)
