-    · have hnot : z.1 ∉ tsupport ζ := fun hmem => ht (hζsupport hmem)
-      have hzero : _root_.deriv ζ z.1 = 0 := by
-        rw [← fderiv_apply_one_eq_deriv, fderiv_of_notMem_tsupport ℝ hnot]
