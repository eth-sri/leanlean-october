-  have hHbound : (∫ z in V, ∑ k, ∑ i, scalarSpatialHessian u z k i ^ 2) ≤
-      Ch * (1 + Cg) * N := by
-    calc
-      _ ≤ Ch * ((∫ z in Q, u z ^ 2) +
-        ∫ z in Q, ∑ j, scalarSpatialGradient u z j ^ 2) := hH
