+private noncomputable def affineReverseTimeInitialPairing
+    {d : ℕ} {Ω : Set (PDE.Vec d)}
+    (hΩ : IsOpen Ω) (v : H10HilbertGraph hΩ)
+    (initial : PDE.ScalarLp Ω (2 : ℝ≥0∞)) : ℝ :=
+  inner ℝ (valueCLM hΩ v) initial
