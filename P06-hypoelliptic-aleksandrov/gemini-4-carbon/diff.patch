-    rw [Measure.restrict_apply_univ, Measure.restrict_eq_self ν hKU]
-    exact hK.measure_lt_top⟩
-  have : IsFiniteMeasureOnCompacts (ν + μ) := finiteOnCompacts_add ν μ
