+    (mul_nonneg (mul_nonneg ((Real.rpow_pos_of_pos hr (-alpha)).le) hP.le) (sq_nonneg M))
+  have hDC : D ≤ C := le_max_right _ _
+  have hBC : B ≤ C := le_max_left _ _
+  refine ⟨C, hM.trans (hD.trans hDC), ?_⟩
+  filter_upwards [he] with n hn
