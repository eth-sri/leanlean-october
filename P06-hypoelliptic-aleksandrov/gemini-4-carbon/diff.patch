-  · intro j
-    apply (memLp_const (2 * Real.sqrt d * Lam * M)).of_le (hm j)
-    filter_upwards [hbound j] with P hP
-    simpa only [borelCoefficientError,Real.norm_eq_abs,abs_abs,
