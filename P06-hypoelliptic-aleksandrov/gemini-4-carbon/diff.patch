+/-- The decay profile `exp(-c |ζ|^{2/3})` (Euclidean norm), as an `ℝ≥0∞`-valued function. -/
+def decayProfile (d : ℕ) (c : ℝ) (ζ : PDE.Vec d) : ℝ≥0∞ :=
