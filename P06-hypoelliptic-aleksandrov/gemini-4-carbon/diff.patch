-    (hAMeas : ∀ i j, AEStronglyMeasurable
-      (fun y : PDE.Vec d => a (r₁ - τ) y i j) (PDE.volumeOn Ω))
-    (hABound : ∀ i j, ∀ᵐ y ∂PDE.volumeOn Ω, ‖a (r₁ - τ) y i j‖ ≤ Ca i j)
-    (hCd : ∀ j, 0 ≤ Cd j)
-    (hDriftMeas : ∀ j, AEStronglyMeasurable
