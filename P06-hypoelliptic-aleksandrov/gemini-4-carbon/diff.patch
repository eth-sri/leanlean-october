-    (hgo : deriv (deriv g) s - s ^ 2 / 3 * deriv g s + gamma * s * g s = 0) :
-    HasDerivAt (scalarWronskian f g) (s ^ 2 / 3 * scalarWronskian f g s) s := by
-  have hdf := (hf.differentiable (by norm_num) s).hasDerivAt
