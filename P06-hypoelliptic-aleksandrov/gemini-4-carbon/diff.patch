-/-- A smooth real function has a smooth integral primitive. -/
-theorem capacity_primitive_smooth {f : ℝ → ℝ} (hf : ContDiff ℝ (⊤ : ℕ∞) f)
-    (a : ℝ) : ContDiff ℝ (⊤ : ℕ∞) (fun v => ∫ x in a..v, f x) := by
