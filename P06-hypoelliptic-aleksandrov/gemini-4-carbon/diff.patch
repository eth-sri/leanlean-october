-    constructor
-    · intro hx
-      exact ⟨massPhysicalPoint x, hx, rfl⟩
-    · rintro ⟨P, hP, hEq⟩
-      have hp : massPhysicalPoint x = P := congrArg sectionTwoPoint hEq.symm
-      change massPhysicalPoint x ∈ D
-      rw [hp]
-      exact hP
