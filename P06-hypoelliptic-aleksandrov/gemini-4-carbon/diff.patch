-private theorem exists_common_norm_bound_of_finite_continuousOn
-    {X ι : Type*} [TopologicalSpace X] [Fintype ι]
-    {S : Set X} (hS : IsCompact S) (q : ι → X → ℝ)
-    (hq : ∀ i, ContinuousOn (q i) S) :
