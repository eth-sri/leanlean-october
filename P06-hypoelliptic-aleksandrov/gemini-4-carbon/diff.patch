-def movingLensBarrier {d : ℕ} (xi eps : ℝ) (n : ℕ) (y : PDE.Vec d) :
-    TimeVelocity d → ℝ :=
-  fun z =>
-    (1 - movingLensRadiusSq xi eps y z) ^ 2 /
