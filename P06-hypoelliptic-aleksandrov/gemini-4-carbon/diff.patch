+    sum_apply, ContinuousLinearMap.proj_apply,
+    PDE.basisVec_apply, smul_eq_mul, Matrix.smul_apply]
+  simp only [mul_ite, mul_one, mul_zero, Finset.sum_ite_eq', Finset.mem_univ, ite_true]
+  rw [hQ.apply i j]
