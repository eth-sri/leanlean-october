+        ‖(∫ x in S, phaseFactor (ψ x) ∂F₁) - phaseFactor Φ₁ * (Θ.real E : ℂ)‖ +
+        ‖(∫ x in S, phaseFactor (ψ x) ∂F₂) - phaseFactor Φ₂ * (Θ.real E : ℂ)‖ :=
+        (norm_add₃_le).trans_eq rfl
