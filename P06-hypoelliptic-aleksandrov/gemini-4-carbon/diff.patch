-    {d : ℕ} (k : Fin d) (h : ℝ) (z : TimeVelocity d) :
-    spatialShift k h (spatialShift k (-h) z) = z := by
-  change (spatialShift k h ∘ spatialShift k (-h)) z = z
-  rw [spatialShift_comp]
-  simp
