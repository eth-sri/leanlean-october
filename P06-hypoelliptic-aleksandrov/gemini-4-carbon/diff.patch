-/-- A compact test supported in a positive phase region has a uniform positive margin. -/
-theorem exists_positive_phase_margin {E : Type*} [TopologicalSpace E]
-    {φ q : E → ℝ} (hφ : HasCompactSupport φ) (hq : Continuous q)
