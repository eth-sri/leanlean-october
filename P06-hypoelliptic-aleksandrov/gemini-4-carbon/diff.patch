-private def reverseTimeLinear (d : ℕ) :
-    TimeVelocity d →L[ℝ] TimeVelocity d :=
-  (-ContinuousLinearMap.fst ℝ ℝ (PDE.Vec d)).prod
-    (ContinuousLinearMap.snd ℝ ℝ (PDE.Vec d))
