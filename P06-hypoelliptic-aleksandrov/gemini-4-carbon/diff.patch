+def borelEllipticRepresentative {d : ℕ} (lam Lam : ℝ) (A : CoefficientField d) :
+    CoefficientField d := by
+  classical
+  exact fun t v => if lam • (1 : PDE.Mat d) ≤ A t v ∧ A t v ≤ Lam • (1 : PDE.Mat d)
+  then A t v else lam • (1 : PDE.Mat d)
