+    PDE.W1pFunction.coeFn_toW1pGraph_snd
+      u.toH1Function.toW1pFunction] with x hcoord hgrad
+  rw [hcoord]
+  rw [hgrad]
+  rfl
+
+end HypoellipticAleksandrov.Parabolic.Dirichlet
 
