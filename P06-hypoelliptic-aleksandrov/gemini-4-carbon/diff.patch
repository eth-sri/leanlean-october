+/-- A continuous polynomial bound for the time-derivative coefficient. -/
+def bellmanGaussianTimeWeight (q : ℝ × ℝ) : ℝ :=
+  9 * q.1 ^ 2 + 6 * |q.1 * q.2| + q.2 ^ 2 + 2
