+      change MeasurePreserving
+        (fun z : PDE.Vec d × (PDE.Vec d × ℝ) =>
+          KineticPoint.mk z.2.2 (z.2.1+z.2.2 • z.1) z.1) _ _
+      simpa only [Measure.volume_eq_prod, Function.comp_def, transportChart,
