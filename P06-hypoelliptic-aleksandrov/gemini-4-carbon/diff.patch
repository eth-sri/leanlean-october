-        match k with
-        | 0 => q₀
-        | 1 => (q₀ + s₀) / 2
-        | _ => s₀
-      let right : ℕ → ℝ := fun k =>
-        match k with
-        | 0 => q₁
-        | 1 => (s₁ + q₁) / 2
-        | _ => s₁
-      let spatial : ℕ → Set (PDE.Vec d) := fun k =>
-        match k with
-        | 0 => O₀
-        | 1 => V
-        | _ => O
