-/-- The moving domain over the whole space is the whole space. -/
-theorem movingDomain_univ {n : ℕ} (γ : ℝ → PDE.Vec n) (σ : ℝ) :
-    movingDomain (Set.univ : Set (PDE.Vec n)) γ σ = Set.univ := by
-  ext y
-  simp [mem_movingDomain_iff]
