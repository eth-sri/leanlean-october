-  change (∑ gamma, lhsTerm gamma) = ∑ delta, rhsTerm delta
-  have hleft : (∑ gamma, lhsTerm gamma) =
-      ∑ p, lhsTerm ((splitAtEquiv beta c).symm p) :=
-    (Equiv.sum_comp (splitAtEquiv beta c).symm lhsTerm).symm
