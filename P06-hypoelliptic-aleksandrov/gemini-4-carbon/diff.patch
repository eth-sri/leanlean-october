-  · have hgt : g r < f r := lt_of_le_of_ne (le_of_not_gt h) hne.symm
-    filter_upwards [hg.eventually_lt hf hgt] with s hs
-    exact ⟨fun hlt => (not_lt_of_ge hs.le hlt).elim, fun hlt => (h hlt).elim⟩
