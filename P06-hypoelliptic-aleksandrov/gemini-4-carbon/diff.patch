-theorem killed_slab_fourier_density_bound (hd : 0 < d)
-    (hcov : IsTranslationCovariantEvolution (wholeSpace d) (fun _ => 0) MeasurableSet.univ K)
-    (hcomp : K.HasComposition MeasurableSet.univ)
