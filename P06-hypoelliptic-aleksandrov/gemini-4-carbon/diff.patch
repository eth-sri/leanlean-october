+    apply Lp.ext
+    filter_upwards [
+      (memLp_reverseTimeSpatialFormBochnerRaw r₀ r₁ h₀₁ hΩ hΩbounded a b c
+        haSmooth hbSmooth hcSmooth C hC (q • u)).coeFn_toLp,
