+  unfold constructionVelocityCutoff
+  rw [Real.smoothTransition.zero_of_nonpos (div_nonpos_of_nonpos_of_nonneg
+    (sub_nonpos.mpr hq) (sub_pos.mpr hm).le), sub_zero]
