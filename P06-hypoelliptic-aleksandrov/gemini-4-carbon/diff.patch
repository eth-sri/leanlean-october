-    (K : Set (KineticPoint d)) (hK : IsCompact K)
-    (H : KineticPoint d → PDE.Mat d) (hH : ContinuousOn H K) {p : ℝ} (hp : 0 < p) :
-    (∀ j, ∀ᵐ P ∂(volume.restrict K), borelCoefficientError (C j) A H P ≤
