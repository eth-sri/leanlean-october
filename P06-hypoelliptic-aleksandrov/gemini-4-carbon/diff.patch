-/-- The Fourier transform `ξ ↦ ∫ e^{-i ξ·x} dμ(x)` of a measure on `ℝ^d`. -/
-def vecFourier (μ : Measure (PDE.Vec d)) (ξ : PDE.Vec d) : ℂ :=
-  ∫ x, cexp (-((PDE.vecDot ξ x : ℝ) * I)) ∂μ
