-      simp [TimeVelocityMultiIndex.parabolicWeight,
-        VelocityMultiIndex.parabolicWeight]
-    have hle : beta.1.timeOrder ≤ 2 * beta.1.timeOrder := by omega
-    exact hle.trans (hq.trans beta.2)
