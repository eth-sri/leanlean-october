+    (hsupp₁ : ∀ᵐ x ∂F₁, |ψ x - Φ₁| ≤ ε) (hsupp₂ : ∀ᵐ x ∂F₂, |ψ x - Φ₂| ≤ ε)
+    {ν : ComplexMeasure α} (hν : IsPhaseProjection ψ M ν) :
+    ν.variation ≤ (M - (F₁ + F₂)).map Prod.fst + ENNReal.ofReal (2 * ε) • Θ := by
