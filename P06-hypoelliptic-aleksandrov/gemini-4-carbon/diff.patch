-            (ENNReal.toReal (eLpNorm (G j) 2
-              (timeVelocityVolumeOn U))) ^ 2 +
-          Ac ^ 2 * (ENNReal.toReal (eLpNorm q 2
-            (timeVelocityVolumeOn U))) ^ 2) := by
