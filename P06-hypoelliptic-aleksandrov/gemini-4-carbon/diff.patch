-private theorem integral_add_of_integrable
-    {α : Type*} [MeasurableSpace α] (μ : Measure α) {f g : α → ℝ}
-    (hf : Integrable f μ) (hg : Integrable g μ) :
-    (∫ x, f x ∂μ) + ∫ x, g x ∂μ = ∫ x, f x + g x ∂μ := by
-  rw [integral_add hf hg]
