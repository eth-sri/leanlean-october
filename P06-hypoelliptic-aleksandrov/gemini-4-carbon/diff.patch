-  Real.Gamma b / Real.Gamma (b - a) * Real.rpow X (-a) *
-    ∑ n ∈ Finset.range N, poch a n * poch (a - b + 1) n /
-      (n.factorial : ℝ) * X⁻¹ ^ n
