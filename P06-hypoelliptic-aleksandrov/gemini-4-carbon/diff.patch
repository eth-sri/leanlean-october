-    isScalarC12On_sub hdiff hψreg
-  have huc : ContinuousOn u
-      (scalarParabolicClosedCylinder α 1 (PDE.euclideanBall vStar R)) :=
-    (hWcont.sub hV.1).sub
-      (((contDiff_occupationQuadratic Lam vStar).continuous.const_mul c).add
