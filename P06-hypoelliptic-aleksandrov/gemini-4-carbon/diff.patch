-theorem velocityNativeBand_measurable (r : ℝ) : MeasurableSet (velocityNativeBand r) := by
-  exact measurableSet_le
-    (continuous_abs.measurable.comp ((measurable_pi_apply 0).comp measurable_fst))
-    measurable_const
