+/-- The literal source time bin of length r² on the full integer grid. -/
+def entranceTimeBin (r : ℝ) (j : ℤ) : Set Point :=
+  {p | p.time ∈ Ioc ((j : ℝ) * r ^ 2) (((j : ℝ) + 1) * r ^ 2)}
