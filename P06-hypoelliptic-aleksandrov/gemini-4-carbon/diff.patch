-      (backwardCylinder (⟨0, 0, 0⟩ : KineticPoint d) 1),
-      ∀ B : PDE.Mat d, (∀ i j, |B i j| ≤ |Lam|) →
-        |fderiv ℝ f (KineticPoint.equivProd d Q) (1, (Q.velocity, 0)) -
-          matrixContraction B (sliceHessian (unitCutoffVelocitySlice f Q) Q.velocity)| ≤ C₀ := by
