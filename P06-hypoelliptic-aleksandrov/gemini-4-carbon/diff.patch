-  have hGrestrict : (∫ z in S, G z ∂volume) = ∫ z, G z ∂volume :=
-    integral_restrict_eq_integral_of_eq_zero_off S hS G hGoff
-  change 2 * (∫ z in S, F z ∂volume) = -(∫ z in S, G z ∂volume)
