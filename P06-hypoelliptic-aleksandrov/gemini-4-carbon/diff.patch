-    (hBb : ∀ j alpha, 0 ≤ Bb j alpha)
-    (hBc : ∀ alpha, 0 ≤ Bc alpha)
-    (ha : ∀ i j, ContDiffOn ℝ M (fun z : TimeVelocity d => a z.1 z.2 i j) U)
-    (hb : ∀ j, ContDiffOn ℝ M (fun z : TimeVelocity d => b z.1 z.2 j) U)
