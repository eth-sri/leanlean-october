+private theorem reverseTimeHilbertRepresentative_eq
+    {d : ℕ} {Ω : Set (PDE.Vec d)}
+    (hΩ : IsOpen Ω) (T : ℝ) (hT : 0 < T)
+    (u : ReverseTimeL2V hΩ T)
