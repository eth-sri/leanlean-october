+    have he : intervalStateInclusion σ pj = p := Subtype.ext rfl
+    rw [← he, intervalExtension_fiber_inside,
+      Measure.map_apply (measurable_intervalStateInclusion τ) hA,
+      hcomp σ r τ hσr hrτ,
