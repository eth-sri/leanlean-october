+/-- The closed collar region of the moving ball on the time slab `[a, b]`. -/
+def collarClosed {n : ℕ} (c : PDE.Vec n) (r₀ dstar : ℝ) (γ : ℝ → PDE.Vec n) (a b : ℝ) :
+    Set (KineticPoint n) :=
