+private theorem finite_affine_boundary_pairing_wrapped
+    {d : ℕ} {Ω : Set (PDE.Vec d)}
+    (r₀ r₁ lam : ℝ) (h₀₁ : r₀ < r₁) (hlam : 0 < lam)
+    (hΩ : IsOpen Ω) (hΩbounded : Bornology.IsBounded Ω)
+    (a : CoefficientField d)
+    (b : ℝ → PDE.Vec d → PDE.Vec d) (c F : ℝ → PDE.Vec d → ℝ)
