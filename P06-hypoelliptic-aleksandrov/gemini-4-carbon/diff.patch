+/-- The squared distance of the position from the moving centre `γ(σ) + c`. -/
+def centreSq {n : ℕ} (c : PDE.Vec n) (γ : ℝ → PDE.Vec n) (p : KineticPoint n) : ℝ :=
+  PDE.vecNormSq (p.position - (γ p.time + c))
