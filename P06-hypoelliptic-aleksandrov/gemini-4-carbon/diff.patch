-    a T haT φ hφ hc
-  have he := mass_homogeneous_abs_weighted B hB b T hbT v₀ R u v
-    (hu.1.mono (image_mono hsub)) hv.1
-    (fun Q hQ => hu.2.1 Q (hsub hQ)) hv.2.1
-    (hu.2.2.1.mono hcl) hv.2.2.1 ⟨M, fun Q hQ => hM Q (hcl hQ)⟩
