+    (mu m : Measure X) [IsFiniteMeasure mu] (g : X → ℝ)
+    (hgn : ∀ x, 0 ≤ g x) (hgi : Integrable g m)
+    (hpair : ∀ f : X → ℝ, (∫ x, f x * g x ∂m) = ∫ x, f x ∂mu) :
+    mu = m.withDensity (fun x => ENNReal.ofReal (g x)) := by
