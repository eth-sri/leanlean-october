-lemma evolvedMeasure_apply (hph : Measurable ph) (hph1 : ∀ y, ‖ph y‖ = 1) (hπ : Measurable π)
-    {t : Set Z} (ht : MeasurableSet t) :
-    evolvedMeasure μ κ ph π t = ∫ x, ∫ y, (π ⁻¹' t).indicator ph y ∂κ x ∂μ := by
