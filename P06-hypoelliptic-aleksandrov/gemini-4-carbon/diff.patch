-    _ ≤ B * (lam / (4 * C * (d : ℝ)) * (e ^ 2 * H ^ 2) +
-        C * (d : ℝ) / lam * G ^ 2) := mul_le_mul_of_nonneg_left hyoung hB
-    _ = _ := by ring
