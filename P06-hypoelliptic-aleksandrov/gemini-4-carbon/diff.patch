-private theorem hasReverseTimeDifferenceEnergyBound_of_pointwise
-    {d : ℕ} {Ω : Set (PDE.Vec d)}
-    (r₀ r₁ lam K : ℝ) (h₀₁ : r₀ < r₁) (hΩ : IsOpen Ω)
