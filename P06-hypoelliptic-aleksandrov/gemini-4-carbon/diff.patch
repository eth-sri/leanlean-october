+  · intro hp
+    refine ⟨(p.time, p.position 0, p.velocity 0), ⟨⟨hp.1, hp.2.1⟩, mem_univ _, hp.2.2⟩, ?_⟩
+    refine KineticPoint.ext rfl ?_ ?_
+    · funext i
+      fin_cases i
+      rfl
+    · funext i
