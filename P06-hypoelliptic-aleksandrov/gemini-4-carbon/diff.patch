-    (haLower : ∀ t v, lam • (1 : PDE.Mat N) ≤ a t v)
-    (haUpper : ∀ t v, a t v ≤ Lam • (1 : PDE.Mat N))
-    (hbSmooth : ContDiff ℝ (⊤ : ℕ∞)
-      (fun z : TimeVelocity N => b z.1 z.2))
