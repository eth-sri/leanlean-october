-    have h2 := mul_le_mul_of_nonneg_left ha.2 hv.le
-    nlinarith only [h1, h2]
-
-/-- The centre and cutoff-region velocity have the same strict sign. -/
-theorem Clock.normalized_sign (c : Clock) {y : ℝ} (hy : |y| < 1) :
