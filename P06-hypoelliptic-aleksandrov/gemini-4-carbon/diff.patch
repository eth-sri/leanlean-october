-          Finset.sum_nonneg fun k' _ =>
-            sq_nonneg ((fderiv ℝ (fun w : TimeVelocity d => f w i' j') z)
-              (0, PDE.basisVec k')))
-        (Finset.mem_univ i)
-
-end HypoellipticAleksandrov.Parabolic
