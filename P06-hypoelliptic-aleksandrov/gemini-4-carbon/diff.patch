+  have scalarJoin_deriv_of_ne_zero (s : ℝ) (hs : s ≠ 0) :
+      deriv (scalarJoin f g) s = scalarJoin (deriv f) (deriv g) s := by
+    rcases lt_or_gt_of_ne hs with hs | hs
