+/-- The position-line tangent is the native position basis vector. -/
+theorem scalarPoint_hasDerivAt_x (x v : ℝ) :
+    HasDerivAt (fun t => scalarPoint t v) (Pi.single 0 1, 0) x :=
+  scalarPositionSlice_hasDerivAt (scalarPoint 0 v) x
+
