+  have hfin := (fiber_height_minkowski Γ hg hΓ k hk hγ).2 hH
+  have hgtop : ∀ᵐ y ∂m, g y < ∞ := ae_lt_top hg (lintegral_ne_top_of_fst_eq Γ hΓ)
+  set κ := Γ.condKernel with hκ
