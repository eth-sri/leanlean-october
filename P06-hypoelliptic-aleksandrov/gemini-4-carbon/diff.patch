-      (Lam * α ^ 2 * T + α * v i - α * δ) p =
-        Real.exp (α * (-(p.2 i - v i) - δ) + Lam * α ^ 2 * (T - p.1)) := by
-    unfold ballExitPlane
-    congr 1
-    ring
