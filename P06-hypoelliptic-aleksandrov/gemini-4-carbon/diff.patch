-private def h1FunctionOfH10HilbertGraph
-    (hΩ : IsOpen Ω) (u : H10HilbertGraph hΩ) : PDE.H1Function Ω where
-  toFun := valueCLM hΩ u
-  grad := fun x => (gradientCLM hΩ u x).ofLp
-  memL2 := Lp.memLp (valueCLM hΩ u)
