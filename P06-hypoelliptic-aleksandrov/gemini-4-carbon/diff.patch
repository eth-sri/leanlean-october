+    intro t ht
+    have hb : t - (a + r ^ 2 / 2) ∈
+        Function.support (reconstructionPositionBump (3 * r ^ 2 / 4) (by positivity)) := ht
+    rw [ContDiffBump.support_eq, Metric.mem_ball, Real.dist_eq, sub_zero] at hb
+    change |t - (a + r ^ 2 / 2)| < 2 * (3 * r ^ 2 / 4) at hb
+    obtain ⟨hl, hu⟩ := abs_lt.mp hb
