-      (fun y : PDE.Vec d => reverseTimeScalarCoefficient r₁ c τ y) (PDE.volumeOn Ω))
-    (hScalarBound : ∀ᵐ y ∂PDE.volumeOn Ω,
-      ‖reverseTimeScalarCoefficient r₁ c τ y‖ ≤ Cc)
