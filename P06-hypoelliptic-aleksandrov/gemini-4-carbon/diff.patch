-          change beta.1.parabolicWeight + 1 ≤ 2 * m
-          have hw := beta.1.parabolicWeight_le_two_mul_order
-          omega) := by
-  apply Subtype.ext
-  rfl
-
-end TimeVelocityDerivativeIndex
