-    (d N : ℕ)
-    (q₀ s₀ s₁ q₁ : ℝ)
-    (Ω O₀ O : Set (PDE.Vec d))
-    (hq₀s₀ : q₀ < s₀)
-    (hs₀s₁ : s₀ < s₁)
-    (hs₁q₁ : s₁ < q₁)
-    (hO₀open : IsOpen O₀)
-    (hO₀compact : IsCompact (closure O₀))
-    (hO₀Ω : closure O₀ ⊆ Ω)
-    (hOopen : IsOpen O)
-    (hOne : O.Nonempty)
-    (hOcompact : IsCompact (closure O))
-    (hOO₀ : closure O ⊆ O₀) :
-    ∃ (left right : ℕ → ℝ)
-      (spatial : ℕ → Set (PDE.Vec d)),
