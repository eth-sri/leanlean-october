-    fun Q hQ => ⟨hQ.1, hQ.2.1.trans H.2.2.le, hQ.2.2⟩
-  obtain ⟨M, hM⟩ := ballBoundarySolution_bounded hH hLE hd hlam hLam B hB v₀ hR
