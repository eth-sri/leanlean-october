-    (hi.mul_bdd hph.aestronglyMeasurable (Filter.Eventually.of_forall (fun y => (hph1 y).le)))
-
-/-- `‖∫ h dη‖ ≤ ∫ ‖h‖ d|η|`. -/
-lemma evolved_integral_enorm_le (hph : Measurable ph) (hph1 : ∀ y, ‖ph y‖ = 1) (hπ : Measurable π)
-    (h : Z → ℂ) (hh : Measurable h) (hb : ∃ C : ℝ, ∀ z, ‖h z‖ ≤ C) :
