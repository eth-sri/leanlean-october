-    {d : ℕ} {lam : ℝ} {O : Set (PDE.Vec d)}
-    (A : PDE.Vec d → PDE.Mat d) (q η : PDE.Vec d → ℝ)
-    (hAlower : ∀ y ∈ O, lam • (1 : PDE.Mat d) ≤ A y)
-    {y : PDE.Vec d} (hy : y ∈ O) :
