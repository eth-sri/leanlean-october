+/-- Actual native initial state corresponding to a physical point. -/
+def velocityInitialState (z : Z) : EvolutionState autonomousWholeDomain (fun _ => 0) 0 :=
+  ⟨(wholeQuery 0 z).1.2.2, (wholeQuery 0 z).2.2⟩
