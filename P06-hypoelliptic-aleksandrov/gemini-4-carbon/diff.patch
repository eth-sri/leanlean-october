-    (hbBound : ∀ j, ∀ᵐ z ∂timeVelocityVolumeOn U, |b j z| ≤ Ab)
-    (hcBound : ∀ᵐ z ∂timeVelocityVolumeOn U, |c z| ≤ Ac) :
-    ParabolicMemLpOn U 2
