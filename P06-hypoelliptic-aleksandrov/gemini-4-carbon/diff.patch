+/-- Transport coordinates ordered as velocity, transported position, time. -/
+def transportChart {d : ℕ} (z : PDE.Vec d × (PDE.Vec d × ℝ)) : KineticPoint d :=
+  ⟨z.2.2, z.2.1+z.2.2 • z.1, z.1⟩
+
