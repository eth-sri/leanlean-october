+      exact ENNReal.toReal_mono (hmK j).eLpNorm_ne_top (eLpNorm_mono_measure _ hμ)
+    let G := fun j => borelSource localised u (f + e j)
+    have hpert j : MemLp (fun P => max ((f + e j) P) 0) (ENNReal.ofReal p)
