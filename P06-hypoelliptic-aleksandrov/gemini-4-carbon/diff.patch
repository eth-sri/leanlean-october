-
-/-- The signed backward residual of a smooth ambient extension is an actual smooth source. -/
-theorem contDiff_smooth_backward_residual {d : ℕ} (A : CoefficientField d)
-    (hA : IsSmoothCoefficient A) (w : TimeVelocity d → ℝ)
-    (hw : ContDiff ℝ (⊤ : ℕ∞) w) :
