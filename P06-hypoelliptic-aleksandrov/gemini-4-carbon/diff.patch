+        ∂reverseTimeVolume (r₁ - r₀) := by
+    let S := reverseTimeNegativeSource r₀ r₁ h₀₁ hΩ hΩbounded F hFSmooth
+    calc
+      reverseTimeDualPairingRightCLM hΩ (r₁ - r₀)
