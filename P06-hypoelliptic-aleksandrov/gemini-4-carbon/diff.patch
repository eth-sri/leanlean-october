-    (fun z ↦ velocityHessian q z i j) s
-
-/-- Finite real extraction of unamplified scalar pullback scaling. -/
-theorem parabolicLpNormOn_pullbackScalar_finite
-    {d : ℕ} (t₀ : ℝ) (v₀ : PDE.Vec d) {r : ℝ} (hr : 0 < r)
