-  exact le_of_tendsto_of_tendsto hleft hright (Eventually.of_forall fun j =>
-    hbound (φ j + N) m hm a (ball_subset_closedBall ha))
-
-end HypoellipticAleksandrov.KineticAleksandrov.LocalA
