+      ∀ s t : ℝ, ∀ hs : s ∈ Set.Icc 0 T, ∀ ht : t ∈ Set.Icc 0 T,
+      s ≤ t →
+        ‖Ubar ⟨t, ht⟩‖ ^ 2 - ‖Ubar ⟨s, hs⟩‖ ^ 2 =
+          2 * (∫ r in Set.Ioc s t,
+            (g r) (u r) ∂reverseTimeVolume T) := by
