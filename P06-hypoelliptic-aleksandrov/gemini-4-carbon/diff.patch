+      (Q (Φ.time σ) (Φ.time r) (Φ.time_le_iff.mpr hσr)).comp
+        (Q (Φ.time r) (Φ.time τ) (Φ.time_le_iff.mpr hrτ)) from hQ _ _ _ _ _]
+  simp
+  rw [hcancel]
+
