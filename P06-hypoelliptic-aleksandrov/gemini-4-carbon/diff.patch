+      PDE.Vec d → ℝ) =ᵐ[PDE.volumeOn Ω] u.toH1Function.toFun := by
+  simpa
+    using! (PDE.W1pFunction.coeFn_toW1pGraph_fst u.toH1Function.toW1pFunction)
