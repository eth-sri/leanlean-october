-      v =ᵐ[timeVelocityVolumeOn (Metric.thickening rho C)] u ∧
-      ∀ alpha : TimeVelocityDerivativeIndex d 2,
-        TimeVelocityMultiIndex.coordinateIteratedFDeriv alpha.1 v =ᵐ[
-          timeVelocityVolumeOn (Metric.thickening rho C)]
