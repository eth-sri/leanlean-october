-      (tsupport ζ ×ˢ tsupport η))
-    (hrii : ∀ i, Set.EqOn (rii i) (fun z => QH z i i)
-      (tsupport ζ ×ˢ tsupport η)) :
-    (∀ z, ζ z.1 * rt z * localizedGradientDivergence η
-        (fun z i => ri i z) (fun z i _j => rii i z) z =
