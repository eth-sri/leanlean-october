+  have hzStarTimeUpper : zStar.1 ≤ T :=
+    (mem_closedParabolicCylinder_iff.mp hzStar).2.1
+  have hzcTimeUpper : zc.1 ≤ T := by
+    nlinarith [hzcTimeUpperStar, hzStarTimeUpper, hT.le]
+  have hzcVelOpen : zc.2 ∈ PDE.euclideanBall y₀ 1 := by
