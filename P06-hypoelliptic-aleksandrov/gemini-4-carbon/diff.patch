+def fiberInversionDensity (g : Y → ℝ≥0∞) (κ : Kernel Y (PDE.Vec d)) (p : Y × PDE.Vec d) :
+    ℝ≥0∞ :=
+  ENNReal.ofReal (((2 * Real.pi) ^ d)⁻¹ *
+    (vecInvIntegral (fun ξ => fiberDensity g κ ξ p.1) p.2).re)
