-def IsHigherOrderNestedProductBoxChain
-    (d N : ℕ)
-    (q₀ s₀ s₁ q₁ : ℝ)
-    (Ω O₀ O : Set (PDE.Vec d))
-    (left right : ℕ → ℝ)
-    (spatial : ℕ → Set (PDE.Vec d)) : Prop :=
-  left 0 = q₀ ∧
-  right 0 = q₁ ∧
-  spatial 0 = O₀ ∧
-  left (N + 2) = s₀ ∧
-  right (N + 2) = s₁ ∧
-  spatial (N + 2) = O ∧
-  (∀ k, k ≤ N + 2 →
-    IsOpen (spatial k) ∧
-    (spatial k).Nonempty ∧
-    IsCompact (closure (spatial k)) ∧
-    closure (spatial k) ⊆ Ω ∧
-    left k < right k) ∧
-  (∀ k, k < N + 2 →
-    left k < left (k + 1) ∧
-    left (k + 1) < right (k + 1) ∧
-    right (k + 1) < right k ∧
-    closure (spatial (k + 1)) ⊆ spatial k)
