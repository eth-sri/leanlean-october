-    Tendsto (fun n => (hu n).toLp (u n)) atTop (𝓝 (hv.toLp v)) := by
-  let : Fact (1 ≤ (2 : ℝ≥0∞)) := ⟨by norm_num⟩
-  let K : ℝ := (measureUnivNNReal μ : ℝ) ^ (2 : ℝ≥0∞).toReal⁻¹
