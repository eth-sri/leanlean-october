+    (hs : s ^ 2 = 1) (p : TimeVelocity 1) (hp : 0 < τ - p.1 + ε) :
+    scalarSpatialHessian (endpointHeat lam τ ε s e) p 0 0 =
+      deriv (deriv (intervalHeat lam (τ - p.1 + ε))) (s * (p.2 0 - e)) := by
+  rw [scalarSpatialHessian_one]
