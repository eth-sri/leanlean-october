-        _ = h + (∑ x, p x * (v x - y₀ x)) + (∑ x, p x * r * e x) := by
-          rw [Finset.sum_add_distrib]
-          ring
-    rw [hsplit, hsingle]
-  rw [hfun]
-  simpa only [one_mul] using
-    ((hasDerivAt_id' (𝕜 := ℝ) 0).mul_const (p i)).const_add
