-/-- The literal ordinary-order view of the selected parabolic representatives. -/
-def ordinaryRepresentative
-    {d m : ℕ} {U : Set (TimeVelocity d)}
-    {u : TimeVelocity d → ℝ}
-    (D : ParabolicWeakDerivativeFamily d (2 * m) U u)
