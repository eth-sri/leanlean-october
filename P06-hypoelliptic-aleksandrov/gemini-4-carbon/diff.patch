-  obtain ⟨Kχ, ⟨χ⟩⟩ :=
-    exists_quantitativeSmoothCutoff_tsupport_subset
-      η.hasCompactSupport hΩ η.tsupport_subset
-  exact ⟨Kη, ⟨η, Kχ, χ⟩⟩
-
