-theorem ballExitRestart_fourier_apply
-    (P : LocalBallStart v₀ R) (T : {t : ℝ // P.1.time < t})
-    (H : {t : ℝ // P.1.time < t ∧ t < T.1}) (ξ : PDE.Vec d)
