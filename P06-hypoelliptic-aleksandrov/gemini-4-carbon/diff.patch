-    Lp.coeFn_sub f z] with a hfa hza hsub
-  simp only [Pi.sub_apply, hfa, hza, hsub, RCLike.inner_apply, conj_trivial]
-  nlinarith [half_sq_sub_sq_le_positivePart_mul_sub (f a) (z a)]
