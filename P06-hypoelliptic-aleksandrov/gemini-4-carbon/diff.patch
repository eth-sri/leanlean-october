+/-- At generation zero the unique restricted addressed cell is the whole
+reference subtype. -/
+theorem parabolicDyadicRestrictedCell_zero_eq_univ (d : ℕ)
+    (index : ParabolicDyadicIndex d 0) :
+    parabolicDyadicRestrictedCell index = Set.univ := by
