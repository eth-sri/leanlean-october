+/-- Open stack interiors avoid any uncountable union of terminal faces. -/
+def openForwardStack {d : ℕ} (P : KineticPoint d) (r : ℝ) (m : ℕ) :
+    Set (KineticPoint d) :=
+  forwardStack P r m ∩ {X | X.time < P.time+(m : ℝ)*r^2}
