-theorem inner_value_galerkinInitialProjection_eq
-    {d : ℕ} {Ω : Set (PDE.Vec d)}
-    (hΩ : IsOpen Ω) {M N : ℕ} (hMN : M ≤ N)
-    (initial : PDE.ScalarLp Ω (2 : ℝ≥0∞))
