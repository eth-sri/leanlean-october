+      have hloc := scalar_borel_locallyIntegrable
+      refine ⟨φ.hasCompactSupport_normed.contDiff_convolution_left (lsmul ℝ ℝ)
+        φ.contDiff_normed hloc, ?_⟩
+      intro x v
+      have hi := φ.hasCompactSupport_normed.convolutionExists_left
