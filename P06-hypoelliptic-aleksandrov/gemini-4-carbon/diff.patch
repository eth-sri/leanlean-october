-/-- A strict comparison of continuous real functions is locally constant away from equality. -/
-theorem eventually_lt_iff_of_ne {f g : ℝ → ℝ} {r : ℝ}
-    (hf : ContinuousAt f r) (hg : ContinuousAt g r) (hne : f r ≠ g r) :
