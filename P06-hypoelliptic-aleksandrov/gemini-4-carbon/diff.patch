+    (hE : IsStripEvolution A H E) (T : ℝ) (e : StripPole H (T : WithTop ℝ)) :
+    ∃! μ : Measure (stripClosedExit H T), μ univ ≤ 1 ∧
+      ∀ f : C_c(stripClosedExit H T, ℝ), ∫ p, f p ∂μ =
+        stripBoundaryFunctional hH hlam hLam A H E hE T e f :=
