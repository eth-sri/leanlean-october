-private theorem reverseTimeL2V_eq_of_hilbertRepresentative_eq_zero
-    {d : ℕ} {Ω : Set (PDE.Vec d)}
-    (hΩ : IsOpen Ω) (T : ℝ)
-    (u v : ReverseTimeL2V hΩ T)
