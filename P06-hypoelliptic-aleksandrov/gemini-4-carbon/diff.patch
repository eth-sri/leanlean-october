-    ae_ne_of_null_fiber (fun Y : KineticPoint d => Y.time) (P r).time (volume_time_face _),
-    ae_ne_of_null_fiber _ _ hvface, ae_ne_of_null_fiber _ _ hpface] with Y ht₁ ht₂ hv hp
