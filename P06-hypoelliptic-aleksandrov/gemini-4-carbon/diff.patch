+    kineticPositionGradient (fun Q : KineticPoint d => Q.time - T) P = 0 ∧
+    kineticVelocityGradient (fun Q : KineticPoint d => Q.time - T) P = 0 ∧
+    kineticVelocityHessian (fun Q : KineticPoint d => Q.time - T) P = 0 := by
