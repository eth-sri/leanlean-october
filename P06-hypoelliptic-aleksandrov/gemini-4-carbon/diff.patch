-/-- Restricted ENNReal norm scaling for the time derivative. -/
-theorem parabolicELpNormOn_timeDerivative_pullbackScalar
-    {d : ℕ} (t₀ : ℝ) (v₀ : PDE.Vec d) {r : ℝ} (hr : 0 < r)
