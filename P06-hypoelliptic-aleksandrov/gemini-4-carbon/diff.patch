-    a b (fun _ _ => 0) (fun _ _ => 0) φ (fun _ => 0) v u
-    haSmooth.continuous hbSmooth.continuous
-    (fun t y => (hlo.posDef hlam t y).posSemidef) (fun _ _ => le_rfl) hv hu
-
-
-end HypoellipticAleksandrov.KineticAleksandrov
