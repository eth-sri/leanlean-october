+  · rw [bellman_ofReal_div Lam, ← smul_smul]
+    apply smul_le_smul_left
+    have h := Measure.map_mono hhi H.measurable
+    rwa [Measure.map_smul _ H.measurable.aemeasurable] at h
+
+
+end
