-    (b : Fin d → TimeVelocity d → ℝ) (c q : TimeVelocity d → ℝ)
-    (G : Fin d → TimeVelocity d → ℝ)
-    (hR : ParabolicMemLpOn U 2 Rproper)
-    (hq : ParabolicMemLpOn U 2 q) (hG : ∀ j, ParabolicMemLpOn U 2 (G j))
