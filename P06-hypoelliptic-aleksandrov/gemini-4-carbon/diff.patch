+          exact (continuous_const.add (continuous_const.mul
+            (continuous_const.sub continuous_time))).add
+              ((continuous_apply 0).comp continuous_position |>.pow 2)
+      let g := fun q : Point => f (q.time, q.position, q.velocity) *
