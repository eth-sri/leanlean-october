-          omega
-        · rfl
-      · obtain ⟨gamma, i, hstay, rfl⟩ := hv
-        apply hvelocity gamma i hstay
-        apply ih gamma.1.parabolicWeight
-        · rw [parabolicWeight_velocitySucc] at hw
-          omega
-        · rfl
