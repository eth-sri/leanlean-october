-/-- Signed bounded potentials tend to zero at every point of the terminal face. -/
-theorem tendsto_duhamelPotential_terminal (K : MovingFiberKernel Ω γ)
-    (g : KineticPoint d → ℝ) (M : ℝ) (hM : 0 ≤ M)
