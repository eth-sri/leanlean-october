-private theorem positivePart_support_lower
-    {d : ℕ} {Ω : Set (PDE.Vec d)} (hΩ : IsOpen Ω)
-    (x z : H10HilbertGraph hΩ) :
-    (scalarLpToH10HilbertGraphDual hΩ (valueCLM hΩ x) -
-        scalarLpToH10HilbertGraphDual hΩ (valueCLM hΩ z))
