-    exact ⟨hcoefficient.1, hcoefficient.2.1, hcoefficient.2.2.1, hcoefficient.2.2.2,
-      contDiff_parabolicMollifiedValue J.g hp n, hnonnegative, hequation⟩
-
-end HypoellipticAleksandrov.Parabolic
