-    (hwOne : ∀ z ∈ inner, w z = 1) :
-    (∀ i, ParabolicMemLpOn inner 2 (H i)) ∧
-      ∑ i, ‖((hH i).mono hInnerOuter).toLp (H i)‖ ^ 2 ≤
-        ∫ z in outer, w z * ∑ i, H i z ^ 2 := by
