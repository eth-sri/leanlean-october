+/-- A twice smooth scalar profile has the required native slice regularity. -/
+theorem reconstructionProfile_regular {f : ℝ → ℝ} (hf : ContDiff ℝ 2 f) (p : Point) :
+    IsSliceRegularAt (reconstructionProfile f) p := by
