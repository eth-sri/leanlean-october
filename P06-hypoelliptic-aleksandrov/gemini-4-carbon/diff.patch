+private theorem young_of_square {X U V : ℝ} (hU : 0 ≤ U) (hV : 0 ≤ V)
+    (hX : X ^ 2 ≤ 4 * U * V) : X ≤ U + V := by
+  nlinarith [sq_nonneg (U - V)]
