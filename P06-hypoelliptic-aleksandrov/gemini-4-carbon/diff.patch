-      (eLpNorm g (ENNReal.ofReal γ) μ).toReal ≤ 2 := by
-  have hγpos : 0 < γ := zero_lt_one.trans_le hγ
-  have hrpos : 0 < r := zero_lt_one.trans hr
-  have hgr : Integrable (fun x => ‖g x‖ ^ r) μ := by
