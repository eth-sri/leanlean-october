-    MemLp (truncatedAbs g n) p μ := by
-  apply MemLp.of_bound (measurable_truncatedAbs hg n).aestronglyMeasurable (n + 1)
-  exact ae_of_all _ fun x => by
-    simpa only [Real.norm_eq_abs] using abs_truncatedAbs_le g n x
