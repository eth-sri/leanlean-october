-            (Real.sqrt (C * (d : ℝ) / lam) * |G|) +
-          C * (d : ℝ) / lam * G ^ 2 := hs
-      _ = _ := by
-        rw [mul_assoc 2, hcross]
-        ring
-  have hyoung : e * |H| * |G| ≤
-      lam / (4 * C * (d : ℝ)) * (e ^ 2 * H ^ 2) +
-        C * (d : ℝ) / lam * G ^ 2 := by
-    linarith
-  calc
