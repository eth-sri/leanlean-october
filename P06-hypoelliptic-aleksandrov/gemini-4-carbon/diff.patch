-/-- With a stationary spatial base point, the cylinder is the literal product cylinder. -/
-theorem construction_mem_cylinder_iff {d : ℕ} (T S : ℝ) (hS : 0 < S) (P : KineticPoint d) :
-    P ∈ backwardCylinder (⟨T, 0, 0⟩ : KineticPoint d) S ↔
