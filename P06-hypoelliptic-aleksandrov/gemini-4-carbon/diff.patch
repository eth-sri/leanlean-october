-  induction N generalizing q₀ q₁ O₀ with
-  | zero =>
-      obtain ⟨V, hVopen, hOV, hVO₀, hVcompact⟩ :=
-        exists_open_between_and_isCompact_closure hOcompact hO₀open hOO₀
