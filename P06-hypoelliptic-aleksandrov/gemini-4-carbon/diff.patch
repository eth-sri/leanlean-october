+/-- Extend a native Green density to the actual physical clock space by zero at nonpositive
+  times. -/
+def poleDensityExtend (G : GreenCarrier 1 → ℝ≥0∞) : Point → ℝ≥0∞ :=
+  Function.extend (elapsedPhysicalPoint 0) G (fun _ => 0)
