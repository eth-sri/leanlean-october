-    have hnN : (N : ℝ) ≤ n := Nat.cast_le.mpr hn
-    have hnt : 1 ≤ (n : ℝ) * t := hNt.trans (mul_le_mul_of_nonneg_right hnN ht.le)
-    simp [positiveSpectralRamp, positiveSpectralIndicator, ht, min_eq_left hnt]
