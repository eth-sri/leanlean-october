+          dv H q i * dv H q k := by
+  let a := Real.rpow r alpha
+  have hin : HasFDerivAt (fun z => H z / a) (a⁻¹ • fderiv ℝ H q) q := by
+    simpa only [div_eq_mul_inv, mul_comm] using
