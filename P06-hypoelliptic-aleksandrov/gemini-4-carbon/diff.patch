-  intro i j hij
-  apply Set.disjoint_left.mpr
-  intro p hi hj
-  have hi' : (i : ℝ) * r ^ 2 < p.time ∧ p.time ≤ ((i : ℝ) + 1) * r ^ 2 := hi
-  have hj' : (j : ℝ) * r ^ 2 < p.time ∧ p.time ≤ ((j : ℝ) + 1) * r ^ 2 := hj
-  rcases lt_or_gt_of_ne hij with h | h
