+    (u : ReverseTimeL2V hΩ (r₁ - r₀)) :
+    ‖reverseTimeSpatialFormBochnerRawAction r₀ r₁ h₀₁ hΩ hΩbounded a b c
+      haSmooth hbSmooth hcSmooth C hC u‖ ≤ C * ‖u‖ := by
+  apply Lp.norm_le_mul_norm_of_ae_le_mul
