+    intro P hP
+    exact ge_of_tendsto
+      (tendsto_const_nhds.add (tendsto_const_nhds.mul htG))
+      (Filter.Eventually.of_forall fun j => hineq j P hP)
+  have scalar_borel_coefficient_approximation :
+      ∃ C : ℕ → ℝ → ℝ → ℝ,
+      (∀ j, ContDiff ℝ (⊤ : ℕ∞) (Function.uncurry (C j)) ∧
