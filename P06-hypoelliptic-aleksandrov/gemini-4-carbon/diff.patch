-/-- The constant regularising field `Y_l = √ε ∂_{z_l}` of `L_ε = Lop + ε Δ_z`. -/
-def regularizingField (ε : ℝ) (l : Fin n) (_x : EvolutionVec n) : EvolutionVec n :=
-  packPoint 0 0 (Pi.single l (Real.sqrt ε))
