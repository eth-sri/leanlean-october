+    a.contDiff_convexApproxSmoothW1p_toFun hD (by norm_num) x0 hr n
+  have hv := a.tendsto_convexApproxSmoothW1p_toFun_eLpNorm_sub
+    hD (by norm_num) (by norm_num) hball hr
