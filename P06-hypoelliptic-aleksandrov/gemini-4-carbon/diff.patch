-/-- Smooth ellipsoidal terminal Dirichlet existence and closed-cylinder uniqueness. -/
-theorem ellipsoidDirichlet_aux
-    {N : ℕ} {r₀ r₁ : ℝ} {Q : PDE.Mat N}
-    (hQ : Q.PosDef)
