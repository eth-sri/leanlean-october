-/-- Existence and uniqueness of the positive contraction extending the actual probe values. -/
-theorem existsUnique_ballBoundaryFunctional (P : LocalBallStart v₀ R)
-    (T : {t : ℝ // P.1.time < t}) :
-    ∃! ℓ : C_c(localTrace P.1.time T.1 v₀ R, ℝ) →ₚ[ℝ] ℝ,
