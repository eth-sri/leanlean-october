-/-- Kinetic scaling matrix for the covariance. -/
-def covarianceDilation (h : ℝ) : Matrix (Fin 2) (Fin 2) ℝ :=
-  !![h ^ (3 / 2 : ℝ), 0; 0, h ^ (1 / 2 : ℝ)]
