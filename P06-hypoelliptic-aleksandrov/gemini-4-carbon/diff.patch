-      Cs * Real.exp (-cs * x) := by
-    change 1 - (Kb.master (ballEvolutionQuery P T)).real univ ≤
-      Cs * Real.exp (-cs * R ^ 2 / (T.1 - P.1.time)) at hs
-    have he : -cs * R ^ 2 / (T.1 - P.1.time) = -cs * x := by
-      dsimp only [x]
-      ring
-    rwa [he] at hs
