+    simp only [u, ψ, add_zero]
+    rw [huop, hdop, hψop, hWeq z hz, hVeq]
+    simpa only [Prod.mk.eta, sub_self] using
+      sub_nonneg.mpr (mul_nonpos_of_nonneg_of_nonpos hc hQop)
