+          {p | p.time ∈ Icc (b - c.r ^ 2) (b + 2 * c.r ^ 2)}).toReal ≤ 3 * c.r ^ 2 := by
+  let W : Set Point := {p | p.time ∈ Icc (b - c.r ^ 2) (b + 2 * c.r ^ 2)}
