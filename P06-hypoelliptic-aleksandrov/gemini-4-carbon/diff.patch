+            ψ y ∂volume := (setIntegral_mul_spatialPartial_eq_neg_spatialPartial_mul_of_right D hD i (fun y ↦ a (r₁ - τ) y i j * scalarSpatialGradient ell (r₁ - τ, y) j) ψ (hflux i j) hpsi1 ψ.hasCompactSupport ψ.tsupport_subset)
