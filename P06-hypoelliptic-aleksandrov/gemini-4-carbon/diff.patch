+  obtain ⟨C₂, _, hC₂⟩ := hv'.1
+  intro p₀ hp₀
+  have hclosed (p : KineticPoint n) (hp : p ∈ movingClosedSlab Ω γ p₀.time r) :
+      p ∈ evolutionPastClosedCylinder Ω γ r := ⟨hp.2.1, hp.2.2⟩
