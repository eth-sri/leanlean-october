+private def parabolicDriftField {d : ℕ} (B : CoefficientField d)
+    (b : ℝ → PDE.Vec d → PDE.Vec d) (x : PDE.Vec (d + 1)) : PDE.Vec (d + 1) :=
+  Fin.cons (-1) (fun i => b (x 0) (fun r => x r.succ) i - parabolicDriftCorr B i x)
