-    (hLip : ∀ s t, PDE.vecEuclideanNorm (v s - v t) ≤ H * |s - t|) :
-    closure (backwardCylinder
-      ⟨tminus + sblock + h, x (sblock + h), v (sblock + h)⟩
-      (barrierW d lam Lam H T1 * Real.sqrt h)) ⊆
-      corridor tminus (-T0) TP (kx / 2) (kv / 2) x v := by
