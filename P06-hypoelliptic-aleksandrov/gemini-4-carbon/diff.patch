-    (2 * Keta * ‖hR.toLp R‖) ‖hqh.toLp qh‖ (by norm_num)
-  have henergy := mul_le_lambda_eighth_sq_add lam ‖hR.toLp R‖
-    (Real.sqrt (∫ z in V, w z * Hk z ^ 2)) hlam
-  rw [Real.sq_sqrt henergyNonneg] at henergy
