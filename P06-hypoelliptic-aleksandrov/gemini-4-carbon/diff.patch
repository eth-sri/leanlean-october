-        (1 / 2 : ℝ) * ‖MeasureTheory.Lp.posPart z‖ ^ 2 ≤
-      inner ℝ (MeasureTheory.Lp.posPart f) (f - z) := by
-  rw [scalarLp_norm_sq_eq_integral_sq (MeasureTheory.Lp.posPart f),
