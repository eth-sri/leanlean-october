-  exact ((continuous_apply i).comp h1).pow 2
-
-/-- Continuity of the collar barrier. -/
-theorem continuous_collarBarrier {n : ℕ} (c : PDE.Vec n) (κ r₀ : ℝ) {γ : ℝ → PDE.Vec n}
-    (hγ : Continuous γ) :
