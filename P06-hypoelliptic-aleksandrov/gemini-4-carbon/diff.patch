-/-- The position differential reconstructed from the coordinate gradient. -/
-def positionDifferential {d : ℕ} (u : KineticPoint d → ℝ) (P : KineticPoint d) :
-    PDE.Vec d →L[ℝ] ℝ :=
-  ∑ i : Fin d, kineticPositionGradient u P i • ContinuousLinearMap.proj i
