-theorem parabolicAffine_mapsTo_backward_ball {N : ℕ} (T : ℝ) (v : PDE.Vec N)
-    {r : ℝ} (hr : 0 < r) :
-    MapsTo (parabolicAffine (T - r ^ 2) v r)
