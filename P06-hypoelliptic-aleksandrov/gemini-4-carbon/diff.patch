-theorem HasWeakVelocityPartialDerivOn.spatialTranslate_of_mapsTo
-    {d : ℕ} {U V : Set (TimeVelocity d)} {i : Fin d}
-    {u dui : TimeVelocity d → ℝ}
-    (hu : HasWeakVelocityPartialDerivOn U i u dui)
