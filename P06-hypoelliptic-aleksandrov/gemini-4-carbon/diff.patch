-theorem mass_aperture_size (M : ℝ) (hM : 0 ≤ M) (n : ℕ) :
-    let ε := 1 / ((n : ℝ) + 1)
-    let L := (2 * M + 1) * ((n : ℝ) + 1) + 1 + (n : ℝ)
