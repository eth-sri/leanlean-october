+    (b : ℝ → PDE.Vec d → PDE.Vec d) (S : Set (PDE.Vec (d + 1))) :
+    LieAlgebraSpansOn S (parabolicFields B b) := by
+  intro x _; rw [eq_top_iff]; intro v _
