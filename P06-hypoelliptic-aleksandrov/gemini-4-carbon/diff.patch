-      ((Lp.constL (2 : ℝ≥0∞) (PDE.volumeOn Ω) ℝ).continuous.comp
-        (NNReal.continuous_coe.comp continuous_snd)))
-
-end HypoellipticAleksandrov.Parabolic.Dirichlet
