-      (hint _) (hint _) (hint _) (hp.mono fun p hp =>
-        enlarged_active_stopped_step hH hLE hlam hLam A c J b T hBT hJ u hphi hc M hM
-          hbound hop hn p hp (Sout ∩ D) (ho.inter hD) inter_subset_right)
-    rw [hka n] at hh
-    exact hh
-  have hw (n : ℕ) : U (n + 1) ≤ R n := by
