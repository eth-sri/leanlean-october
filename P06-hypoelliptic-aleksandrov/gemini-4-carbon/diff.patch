-        have hm := continuousOn_bounded_mul_memLp hV
-          (TimeVelocityMultiIndex.coordinateIteratedFDeriv gamma.left q)
-          (D.representative
-            (ParabolicDerivativeIndex.properSplitRightVelocityTwo
