+    _ = (Real.Gamma (a.1 + 1 / 3))⁻¹ * Real.Gamma (1 / 3) *
+        (z ^ (1 / 3 : ℝ) * z ^ (-(1 / 3 : ℝ))) +
+        z ^ (1 / 3 : ℝ) * (Real.Gamma (a.1 + 1 / 3))⁻¹ *
+          connectionIntegral (a.1 + 1 / 3) z := by ring
+    _ = _ := by rw [he]; ring
 
