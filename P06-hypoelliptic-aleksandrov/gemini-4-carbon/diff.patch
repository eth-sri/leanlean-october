-/-- Interpret a canonical low-order shape as its bounded multi-index. -/
-def LowOrderClass.toIndex {d : ℕ} :
-    LowOrderClass d → ParabolicDerivativeIndex d 2
-  | .zero => zeroTwo d
-  | .time => timeOne d
-  | .velocity i => velocityOne i
-  | .velocity₂ i j _ => velocityTwo i j
