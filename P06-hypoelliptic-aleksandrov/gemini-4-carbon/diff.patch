-  have hsmall : 2 * M + 1 / ((n : ℝ) + 1) ≤ 2 * M + 1 := by
-    linarith only [he1]
-  exact hsmall.trans (hsz'.trans (mul_le_mul_of_nonneg_left hsq he.le))
-
-end HypoellipticAleksandrov.KineticAleksandrov.LocalA
