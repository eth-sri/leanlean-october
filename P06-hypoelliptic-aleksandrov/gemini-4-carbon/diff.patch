+      (-scalarTimeDerivative ell (r₁ - τ, y)) * ψ y +
+        (∑ j : Fin d,
+          reverseTimeDivergenceDrift r₁ a b τ y j *
+            scalarSpatialGradient ell (r₁ - τ, y) j * ψ y) -
+        c (r₁ - τ) y * ell (r₁ - τ, y) * ψ y) D) :
+    (∫ y in D,
+      (-scalarTimeDerivative ell (r₁ - τ, y)) * ψ y +
+        (∑ i : Fin d, ∑ j : Fin d,
+          a (r₁ - τ) y i j * scalarSpatialGradient ell (r₁ - τ, y) j *
+            ψ.partialDeriv i y) +
