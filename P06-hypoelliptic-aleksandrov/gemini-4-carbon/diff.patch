+        ((continuous_apply 0).comp continuous_velocity).measurable
+      have hm : (∑ n ∈ Finset.range N, tm n) ≤
+          enlargedFullSpaceTerminal hH hLE hlam hLam A P (P.time + b) := by
+        calc
