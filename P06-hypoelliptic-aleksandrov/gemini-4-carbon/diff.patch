-    [IsFiniteMeasure F₂] (hF : F₁ + F₂ ≤ M) {Θ : Measure α}
-    (hΘ₁ : F₁.map Prod.fst = Θ) (hΘ₂ : F₂.map Prod.fst = Θ) {Φ₁ Φ₂ ε : ℝ} (hε : 0 ≤ ε)
-    (hε₁ : ε ≤ 1) (hΦ : phaseFactor Φ₁ + phaseFactor Φ₂ = 0)
-    (hsupp₁ : ∀ᵐ x ∂F₁, |ψ x - Φ₁| ≤ ε) (hsupp₂ : ∀ᵐ x ∂F₂, |ψ x - Φ₂| ≤ ε)
