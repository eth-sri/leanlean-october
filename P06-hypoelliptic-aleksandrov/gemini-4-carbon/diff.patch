+    _ = ENNReal.ofReal K := by
+      rw [ENNReal.ofReal_rpow_of_nonneg (Real.rpow_nonneg hK _) hq.le,
+        ← Real.rpow_mul hK, one_div_mul_cancel hq.ne', Real.rpow_one]
