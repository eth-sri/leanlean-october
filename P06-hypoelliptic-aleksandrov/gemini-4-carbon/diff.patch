-def localBallEvolution : LocalBallEvolution v₀ R :=
-  (existsUnique_localBallEvolution hH hLE hd hlam hLam B hB v₀ hR).exists.choose
-
-/-- The selected pair satisfies the full terminal-evolution characterization. -/
