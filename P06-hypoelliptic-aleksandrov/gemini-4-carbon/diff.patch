+    (intervalQueryInclusion (evolutionQueryOfState (PDE.oneDimensionalAxisBox a c)
+      stationary σ τ hστ p)) =
+    (K.fiberKernel hJ σ τ hστ p).map Subtype.val
+  rw [intervalExtensionMaster_inside, K.map_fiberKernel_eq_master]
