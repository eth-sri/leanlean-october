-/-- The inversion density `(2π)^{-d} Re ∫ e^{i ξ·z} μ̂(ξ) dξ` of a measure on `ℝ^d`. -/
-def vecInvDensity (μ : Measure (PDE.Vec d)) (z : PDE.Vec d) : ℝ :=
