-/-- Convolution with the common spacetime mollifier, kernel on the left. -/
-def spacetimeMollification
-    {d : ℕ} (ε : ℝ) (f : TimeVelocity d → ℝ) :
-    TimeVelocity d → ℝ :=
-  spacetimeMollifier ε ⋆[
