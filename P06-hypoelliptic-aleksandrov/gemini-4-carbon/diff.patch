+  have hgradient_eq (y : PDE.Vec d) (j : Fin d) :
+      scalarSpatialGradient ell (r₁ - τ, y) j = spatialPartial j u y := rfl
+  have hhessian_eq (y : PDE.Vec d) (hy : y ∈ D) (i j : Fin d) :
