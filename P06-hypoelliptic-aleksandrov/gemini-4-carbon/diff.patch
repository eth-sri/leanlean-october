-            Bc (ParabolicDerivativeIndex.splitLeft beta gamma.1)) ^ 2 *
-              (ParabolicWeakDerivativeFamily.squaredL2Norm D +
-                ParabolicWeakDerivativeFamily.squaredL2Norm E)) := by
