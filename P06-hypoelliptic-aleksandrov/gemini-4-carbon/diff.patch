-        (fun P : KineticPoint d => C j P.time P.velocity) (volume.restrict K) :=
-      (hCs.measurable.comp hproj).aestronglyMeasurable.restrict
-    have he i k : Continuous (fun M : PDE.Mat d => M i k) :=
