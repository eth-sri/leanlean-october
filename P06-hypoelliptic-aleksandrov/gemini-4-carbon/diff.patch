+    _ = _ := by
+      rw [Measure.real, Measure.real,
+        ENNReal.ofReal_add ENNReal.toReal_nonneg (by positivity),
+        ENNReal.ofReal_mul (by positivity),
+        ENNReal.ofReal_toReal (measure_ne_top _ _), ENNReal.ofReal_toReal (measure_ne_top _ _)]
+
