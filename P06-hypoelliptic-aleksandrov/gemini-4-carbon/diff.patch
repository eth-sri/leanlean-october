-private theorem indicator_gradient_slice
-    {d : ℕ} (O : Set (PDE.Vec d)) (η : PDE.Vec d → ℝ)
-    (hηsupport : tsupport η ⊆ O) (r : ℝ)
-    (QG : TimeVelocity d → PDE.Vec d) :
