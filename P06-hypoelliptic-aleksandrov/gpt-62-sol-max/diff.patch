+    (hgn : ∀ p, 0 ≤ g p)
+    (hgs : ContDiff ℝ (⊤ : ℕ∞) (rawLift g)) (hgc : HasCompactSupport g)
+    (hgU : tsupport g ⊆ evolutionPastOpenCylinder Ω (fun _ => 0) T)
+    (hqc : Continuous q) (hqr : ∀ p, p.time ≤ T → IsSliceRegularAt q p)
+    (hqn : ∀ p ∈ evolutionPastClosedCylinder Ω (fun _ => 0) T, 0 ≤ q p)
+    (hqo : ∀ p ∈ evolutionPastOpenCylinder Ω (fun _ => 0) T,
+      transportedForwardOperator (evolutionCoefficient A.a) (identityDrift 1) q p ≤ -g p)
+    (p₀ : Point) (hp₀ : p₀ ∈ evolutionPastOpenCylinder Ω (fun _ => 0) T) :
+    duhamelPotential E.2 T g p₀ ≤ q p₀ := by
+  obtain ⟨⟨-, C, -, hCb⟩, -, hsm, -, heq, hc, ht, hl, -⟩ :=
+    autonomous_duhamel_properties A hΩ E hE T g hgn hgs hgc hgU
