+  drift_bound : ∀ j α z, z ∈ U →
+    |TimeVelocityMultiIndex.coordinateIteratedFDeriv α.1 (fun x => b x.1 x.2 j) z| ≤ Bb j α
+  potential_bound : ∀ α z, z ∈ U →
+    |TimeVelocityMultiIndex.coordinateIteratedFDeriv α.1 (fun x => c x.1 x.2) z| ≤ Bc α
