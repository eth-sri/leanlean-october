+    (fun p hp => (hreg p hp).sub (hqr p hp.2.1.le))
+    (fun p hp => by
+      rw [viscousTransportedOperator_sub (hreg p hp) (hqr p hp.2.1.le),
+        viscousTransportedOperator_zero, viscousTransportedOperator_zero, heq p (ha hp)]
