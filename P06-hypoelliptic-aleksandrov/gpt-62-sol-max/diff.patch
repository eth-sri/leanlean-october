-    have hmem : ∀ᵐ z ∂timeVelocityVolumeOn S, z ∈ S :=
-      (ae_restrict_iff' hS).mpr (ae_of_all _ fun z hz => hz)
-    filter_upwards [hzero.restrict, hto, hmem] with z hz hto hzS
-    rw [hz, Set.indicator_of_mem hzS, hto]
