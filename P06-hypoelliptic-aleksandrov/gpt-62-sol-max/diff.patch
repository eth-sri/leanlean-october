+    (∀ j, HasWeakVelocityPartialDerivOn univ j (localizedScalar b q) (localizedGradient b q QG j)) ∧
+    tsupport (localizedScalar b q) ⊆ U ∧ ∀ j, tsupport (localizedGradient b q QG j) ⊆ U := by
