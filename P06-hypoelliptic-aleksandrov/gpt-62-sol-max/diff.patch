+  have hm : (evolutionHomeomorph n).symm p ∈ evolutionHomeomorph n ⁻¹' D := by simpa using hp
+  exact .of_packed_contDiffAt p ((hu.contDiffAt
+    ((hD.preimage (evolutionHomeomorph n).continuous).mem_nhds hm)).of_le (by simp))
