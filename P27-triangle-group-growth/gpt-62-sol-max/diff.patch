+    (h02' : M' 0 2 = p') (h12' : M' 1 2 = q') (n : ℕ) : sphere(cs,n) ≤ sphere(cs',n) := by
+  rw [sphere_card cs ⟨hp,hq,h01,h02,h12⟩, sphere_card cs' ⟨hp.trans hpp,hq.trans hqq,h01',h02',h12'⟩]
