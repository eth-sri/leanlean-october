+@[simp, grind =] lemma in_cut {p q n : ℕ} {u : ℕ × ℕ} : u ∈ cut p q n ↔
+    (0 < u.1 ∧ u.1 < p) ∧ (0 < u.2 ∧ u.2 < q) ∧ hl u ≤ n := by
+  simp [cut, offsets, Nat.succ_le_iff, and_assoc]
