+@[simp, grind =] lemma mem_baseAt {p q n : ℕ} {x : Bool × ℕ} {k : ℕ} :
+    (x,k) ∈ baseAt p q n ↔ x.2 < p ∧ (k = 0 ∨ k < q) ∧ headLen x + k = n := by
+  simp [baseAt, base, lt_max_iff, and_assoc]
