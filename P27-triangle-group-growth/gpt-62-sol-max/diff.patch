-/-- `a`/`b` (head generator) acting on the head. -/
-def actH (m : ℕ) (v : Raw) : Raw := (da m v.1, v.2)
-/-- `c` acting on the head. -/
-def actC (v : Raw) : Raw := (dc v.1, v.2)
-/-- The other head generator: swap, act, swap back. -/
