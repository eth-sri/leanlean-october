-/-- Block lists of total length `n` whose blocks are bounded alternately by `m₁, m₂, m₁, …`. -/
-def tails (m₁ m₂ n : ℕ) : Finset (List ℕ) :=
-  (if n = 0 then {[]} else ∅) ∪
-    (range (n + 1)).biUnion fun k =>
-      if h : 0 < k ∧ k ≤ n ∧ k < m₁ then (tails m₂ m₁ (n - k)).image (List.cons k) else ∅
-termination_by n
-decreasing_by omega
