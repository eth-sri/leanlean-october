+    sphere(cs,n) = sphere(cs',n) := by
+  rw [sphere_card cs ⟨hp,hq,h01,h02,h12⟩, sphere_card cs' ⟨hq,hp,h01',h02',h12'⟩]
+  exact slice_symm hp hq n
