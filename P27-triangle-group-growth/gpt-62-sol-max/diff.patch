+def offsets (p q : ℕ) : Finset (ℕ × ℕ) := Ico 1 p ×ˢ Ico 1 q
+lemma offset_bounds {p q : ℕ} {u : ℕ × ℕ} (h : u ∈ offsets p q) : 0 < hl u ∧ hl u < p+q := by
+  grind [offsets]
+
+section
+variable (p q n : ℕ)
