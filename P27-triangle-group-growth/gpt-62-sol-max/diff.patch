+def cut := (offsets p q).filter fun u => hl u ≤ n
+def base : Finset ((Bool × ℕ) × ℕ) := (univ ×ˢ range p) ×ˢ range (max 1 q)
+def baseAt := (base p q).filter fun (x,k) => headLen x + k = n
