-theorem tails_eq (m₁ m₂ n : ℕ) : tails m₁ m₂ n = (if n = 0 then {[]} else ∅) ∪
-    (range (n + 1)).biUnion fun k =>
-      if 0 < k ∧ k ≤ n ∧ k < m₁ then (tails m₂ m₁ (n - k)).image (List.cons k) else ∅ := by
-  rw [tails]; simp only [dite_eq_ite]
