-  · intro k _ k' _ hkk'
-    show Disjoint (if P k then T k else ∅) (if P k' then T k' else ∅)
-    rw [Finset.disjoint_left]
-    intro x hx hx'
-    rw [mem_ite_empty] at hx hx'
