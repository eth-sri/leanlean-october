+@[simp] theorem mem_ite_empty {α : Type*} {x : α} {P : Prop} [Decidable P] {s : Finset α} :
+    x ∈ (if P then s else ∅) ↔ P ∧ x ∈ s := by
+  split_ifs with h <;> simp [h]
