+@[simp] def act (p q : ℕ) : Fin 3 → Raw → Raw
+  | 0, v => actH p v
+  | 1, v => swap (actH q (swap v))
+  | 2, v => actC v
+
+theorem swap_actC : ∀ v : Raw, swap (actC v) = actC (swap v)
+  | ((_, 0), []) | ((_, 0), _ :: _) | ((_, _ + 1), _) => rfl
+
+theorem act_V {p q : ℕ} (hp : 2 ≤ p) (hq : 2 ≤ q) : ∀ (i : Fin 3) {v : Raw}, V p q v →
+    V p q (act p q i v)
