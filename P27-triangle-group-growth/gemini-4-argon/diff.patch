-theorem sphere23_rec_fails_at_4 (h01 : M 0 1 = 0) (h02 : M 0 2 = 2) (h12 : M 1 2 = 3) :
-    sphere cs 4 ≠ sphere cs 2 + sphere cs 1 := by
-  obtain ⟨-, h1, h2, -, h4, -⟩ := sphere23_facts cs h01 h02 h12
-  omega
-
-end Closed
