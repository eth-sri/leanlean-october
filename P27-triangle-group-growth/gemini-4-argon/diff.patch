+abbrev bimg {α β : Type*} [DecidableEq α] (l u : ℕ)
+    (F : ℕ → Finset β) (f : ℕ → β → α) (n : ℕ) : Finset α :=
+  (range (n + 1)).biUnion fun k => if l ≤ k ∧ k < u then (F (n - k)).image (f k) else ∅
