+  | ((_, 0), 0 :: _), h => absurd h.1 (Nat.lt_irrefl 0)
+
+theorem len_swap : ∀ v : Raw, len (swap v) = len v
+  | ((_, 0), []) => rfl
+  | ((_, 0), _ :: _) | ((_, _ + 1), _) => by simp [swap]; omega
+
+abbrev actH (m : ℕ) (v : Raw) : Raw := (da m v.1, v.2)
+abbrev actC (v : Raw) : Raw := (dc v.1, v.2)
