-      coeff n (1 + X + X + X + X ^ 2 + X ^ 2 + X ^ 2 + X ^ 2 + X ^ 3 + X ^ 3 + X ^ 3 + X ^ 4 :
-        ℤ⟦X⟧) := by
-    intro n; rw [← map_sub, ← map_sub, H]
-  have c0 := c 0
-  have c1 := c 1
-  have c2 := c 2
-  have c3 := c 3
-  have c4 := c 4
-  simp [coeff_mul_X_pow', coeff_X_pow, coeff_one, coeff_X] at c0 c1 c2 c3 c4
