+abbrev R := ℕ × ℕ × List ℕ
+def VT : ℕ → ℕ → List ℕ → Prop
+  | _, _, [] => True
+  | a, b, k :: r => 0 < k ∧ k < a ∧ VT b a r
+def V (p q) (v : R) := v.1 ≤ 1 ∧ v.2.1 < p ∧ VT q p v.2.2
+def len (v : R) := v.1 + v.2.1 + v.2.2.sum
+def A (m : ℕ) : R → R
+  | (0, 0, r) => (0, 1, r)
+  | (0, 1, r) => (0, 0, r)
+  | (0, j + 2, r) => (1, j, r)
+  | (_ + 1, j, r) => if j + 2 < m then (0, j + 2, r) else (1, 2 * m - j - 3, r)
+def C (v : R) := (1 - v.1, v.2)
+def sw : R → R
+  | (e, 0, (k + 1) :: r) => (e, k + 1, r)
+  | (e, j + 1, r) => (e, 0, (j + 1) :: r)
+  | v => v
