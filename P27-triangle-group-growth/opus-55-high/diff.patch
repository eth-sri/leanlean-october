-`(Σ #NF_n Xⁿ) · (1 − P_p P_q) = (1 + X) [p] [q]`. -/
-theorem nf_series (p q : ℕ) (hq : 1 ≤ q) :
-    ser (fun n => (NFs p q n).card) * (1 - Pm p * Pm q) = E2 * Rm p * Rm q := by
