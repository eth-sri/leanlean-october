-/-- A radius whose exterior weighted disk has measure `y`. -/
-def massRadius (α y : ℝ) : ℝ := sqrt (1 - y ^ (α + 1)⁻¹)
-
-theorem massRadius_mem_unit {α y : ℝ} (hα : -1 < α) (hy : y ∈ Ioo (0 : ℝ) 1) :
