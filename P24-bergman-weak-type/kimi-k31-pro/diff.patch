-  apply Measure.integrableOn_of_bounded measure_Icc_lt_top.ne
-    (hg.comp (continuous_circleMap 0 r).measurable).aestronglyMeasurable
-  exact Filter.Eventually.of_forall fun θ ↦ hbound _
-
