+theorem normalizer_mono (α : ℝ) : MonotoneOn (normalizer α) radii := by
+  let B : Ray := ⟨1,0,0,continuousOn_const,continuousOn_const,fun _ _ ↦ ⟨hasDerivAt_const ..,hasDerivAt_const ..⟩⟩
