+  refine ⟨v r*(s*D r)/B.v r^2, div_nonpos_of_nonpos_of_nonneg (by nlinarith) (sq_nonneg _), ?_⟩
+  scalar_deriv [(A.jet r hr).1,(B.jet r hr).1,driftWeight_hasDerivAt c (inner_sq hr)]
+  grind
