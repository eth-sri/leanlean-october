+  case sub =>
+    intro r hr; rw [solution_eq α hr]; simp [B,Ray.err,rhs];
+    have := normalizer_nonneg α r; have := sub_pos.mpr (inner_sq hr); positivity
+  intro r hr R hR hle; simpa [B,driftWeight] using H hr hR hle
