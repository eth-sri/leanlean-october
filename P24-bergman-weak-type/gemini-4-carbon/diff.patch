-/-- A periodic derivative has zero integral over one period. -/
-theorem integral_periodic_derivative_eq_zero {g g' : ℝ → ℝ} {T : ℝ}
-    (hT : 0 ≤ T) (hg : ∀ θ ∈ Icc 0 T, HasDerivAt g (g' θ) θ)
