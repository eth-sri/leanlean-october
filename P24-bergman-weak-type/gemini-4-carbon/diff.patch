+        · simp only [polarOp, Pi.pow_apply, Pi.mul_apply, Pi.sub_apply, id_eq, B]
+          field_simp [hs.1.ne', show 1 - s ^ 2 ≠ 0 by nlinarith [hs.1, hs.2]]; ring) hu
