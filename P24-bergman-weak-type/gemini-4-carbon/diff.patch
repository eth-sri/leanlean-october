-
-/-- The automorphism of the unit disc that sends zero to `z`. -/
-def shift (z : 𝔻) : 𝔻 ≃ 𝔻 where
-  toFun := shiftFun z
-  invFun := shiftFun (-z)
-  left_inv := shiftFun_neg_apply_shiftFun _
-  right_inv := by
-    intro w
-    simpa using shiftFun_neg_apply_shiftFun (-z) w
