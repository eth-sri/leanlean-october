-def shiftFun (z w : 𝔻) : 𝔻 :=
-  mk ((z + w : ℂ) / (1 + conj ↑z * w)) <| by
-    refine (norm_shiftFun_le _ _).trans_lt ?_
-    rw [div_lt_one (by positivity)]
-    nlinarith only [z.norm_lt_one, w.norm_lt_one]
