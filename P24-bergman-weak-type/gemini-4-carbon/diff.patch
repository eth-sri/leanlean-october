-/-- The composition of two shifts is a rotation by `shiftCompCoeff z w` composed with a shift. -/
-@[simps! coe]
-def shiftCompCoeff (z w : 𝔻) : Circle :=
-  .ofConjDivSelf (1 + conj ↑z * w) (shift_den_ne_zero _ _)
-
-end
-
-end UnitDisc
-
-end Complex
