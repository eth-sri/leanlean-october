-  have heq : (fun ζ : ℂ ↦ ‖1 - z * ((r : ℂ) * star ζ)‖ ^ (-(α + 2))) =
-      (fun ζ : ℂ ↦ (fun ξ : ℂ ↦ ‖1 - (z * (r : ℂ)) * ξ‖ ^ (-(α + 2))) (star ζ)) := by
-    funext ζ
-    dsimp only
-    rw [mul_assoc]
-  change Real.circleAverage (fun ζ : ℂ ↦ ‖1 - z * ((r : ℂ) * star ζ)‖ ^ (-(α + 2))) 0 1 = _
-  rw [heq, circleAverage_star_eq (fun ξ : ℂ ↦ ‖1 - (z * (r : ℂ)) * ξ‖ ^ (-(α + 2))),
