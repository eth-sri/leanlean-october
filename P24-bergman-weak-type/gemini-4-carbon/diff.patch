-  coe_injective <| by simp [coe_shift]
-
-@[simp]
-theorem shift_zero : shift 0 = .refl 𝔻 := by
-  ext z
-  simp [coe_shift]
-
-@[simp]
-theorem shift_apply_zero (z : 𝔻) : shift z 0 = z := by simp [shift_eq_iff]
-
-@[simp]
-theorem shift_eq_zero_iff {z w : 𝔻} : shift z w = 0 ↔ w = -z := by
