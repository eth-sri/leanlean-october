-theorem image_rpow_unit_interval {q : ℝ} (hq : 0 < q) :
-    (fun x : ℝ ↦ x ^ q) '' Ioo 0 1 = Ioo 0 1 := by
-  ext y
-  constructor
-  · rintro ⟨x, hx, rfl⟩
-    exact ⟨rpow_pos_of_pos hx.1 _, rpow_lt_one hx.1.le hx.2 hq⟩
-  · intro hy
