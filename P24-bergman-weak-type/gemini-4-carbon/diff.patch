-  have hz' : ‖z‖ < 1 := (mem_disk_iff z).mp hz
-  have hmul : ‖z * star w‖ ≤ ‖z‖ := by
-    rw [norm_mul, norm_star]
-    exact mul_le_of_le_one_right (norm_nonneg z) hw
