-  apply integrable_mul_of_continuousOn_compact hK hμ
-    (hf.norm.comp_snd (volume.restrict (Set.uIoc 0 (2 * Real.pi))))
-  have hp : ContinuousOn (fun p : ℝ × ℂ ↦ poissonKernel 0 z (circleMap 0 R p.1))
