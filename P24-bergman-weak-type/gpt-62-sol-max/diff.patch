-@[simp] theorem normalizedPotential_zero (f : ℂ → ℂ) :
-    normalizedPotential f 0 = ∫ w, ‖f w‖ ∂diskArea := by
-  simp [normalizedPotential, normalizedKernel, kernel_zero_left]
