-theorem boundary_affine_mem_disk {R : ℝ} (hR : 0 < R) (u : ℂ) :
-    1 - (R : ℂ) * u ∈ disk ↔ R * ‖u‖ ^ 2 < 2 * u.re := by
-  rw [mem_disk_iff]
-  have hid := norm_sq_boundary_affine R u
-  constructor
-  · intro hu
-    nlinarith [norm_nonneg (1 - (R : ℂ) * u)]
-  · intro hu
-    nlinarith [norm_nonneg (1 - (R : ℂ) * u)]
-
