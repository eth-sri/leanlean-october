-theorem measurable_diskPotential {f : ℂ → ℂ} (hf : Integrable f diskArea) :
-    Measurable (diskPotential f) := by
-  classical
-  exact (continuousOn_normalizedPotential_disk hf).measurable_piecewise
-    continuousOn_const measurableSet_disk
