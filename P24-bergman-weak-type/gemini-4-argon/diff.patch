-    ((continuousOn_normalizer_radial α hz).aestronglyMeasurable
-      (μ := area) measurableSet_disk).mono_ac (withDensity_absolutelyContinuous diskArea _)
-  apply (integrable_const (normalizer α ‖z‖)).mono' hm
