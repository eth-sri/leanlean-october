-theorem re_cayley (u : ℂ) :
-    ((1 + u) / (1 - u)).re = (1 - ‖u‖ ^ 2) / ‖1 - u‖ ^ 2 := by
-  simp only [Complex.div_re, Complex.sq_norm,
-    Complex.add_re, Complex.one_re, Complex.sub_re, Complex.add_im,
-    Complex.one_im, Complex.sub_im, Complex.normSq_apply]
-  ring
