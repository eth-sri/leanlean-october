-theorem integrable_mul_of_continuousOn_compact {X : Type*} [TopologicalSpace X]
-    [T2Space X] [MeasurableSpace X] [OpensMeasurableSpace X]
-    {μ : Measure X} {K : Set X}
-    (hK : IsCompact K) (hμ : ∀ᵐ w ∂μ, w ∈ K) {f g : X → ℝ}
