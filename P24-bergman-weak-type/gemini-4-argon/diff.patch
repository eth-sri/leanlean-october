+    have hrad : Integrable (fun w : ℂ ↦ normalizer α (‖w‖ * ‖z‖)) (weightedArea α) := by
+      have hm_rad : AEStronglyMeasurable (fun w : ℂ ↦ normalizer α (‖w‖ * ‖z‖)) (weightedArea α) :=
