+          ⟨mul_nonneg (norm_nonneg _) (norm_nonneg _),
+            (mul_le_of_le_one_left (norm_nonneg z) ((mem_disk_iff w).mp hw).le).trans_lt ((mem_disk_iff z).mp hzd)⟩).aestronglyMeasurable
