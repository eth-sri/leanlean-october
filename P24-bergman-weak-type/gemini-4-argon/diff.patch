-theorem circleIntegrable_of_measurable_bounded {g : ℂ → ℝ} (hg : Measurable g)
-    {M : ℝ} (hbound : ∀ z, ‖g z‖ ≤ M) (r : ℝ) : CircleIntegrable g 0 r := by
