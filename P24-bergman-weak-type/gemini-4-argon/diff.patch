-
-theorem capMean_increment {f : ℂ → ℂ} (hf : Integrable f diskArea)
-    (t y : ℝ) {c : ℝ} (hc : c ≤ t * y) :
-    (t * y - c) * levelFraction f t y ≤ capMean f y (t * y) - capMean f y c := by
