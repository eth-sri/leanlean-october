-theorem hasDerivAt_smoothCap_comp_first {ε c x : ℝ} {U U' : ℝ → ℝ} {U'' : ℝ}
-    (hε : 0 < ε) (hU : HasDerivAt U (U' x) x) (hU' : HasDerivAt U' U'' x) :
