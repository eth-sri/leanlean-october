-    (∫ θ in (0 : ℝ)..T, g' θ) = 0 := by
-  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt
-    (by simpa only [uIcc_of_le hT] using hg) hgi, hperiod, sub_self]
