+def weightedNormalizedPotential (α : ℝ) (f : 𝕋) (z : ℂ) : ℝ :=
+  𝖕 weightedPotential / 𝕹 𝕫
+
+def weightedDiskPotential (α : ℝ) (f : 𝕋) : 𝕦 :=
+  disk.indicator (weightedNormalizedPotential α f)
