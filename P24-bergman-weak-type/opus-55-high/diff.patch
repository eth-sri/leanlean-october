-      (f := fun a ↦ ∫ y in a..b, A y) (g := fun _ ↦ M)
-      (fun a ha ↦ hinner a b ha.1 ha.2 hb.2)
-    · simpa only [closure_Ioo hb.1.ne, uIcc_of_le hb.1.le] using
