-theorem weightedDiskPotential_eq {α : ℝ} {f : ℂ → ℂ} {z : ℂ} (hz : z ∈ disk) :
-    weightedDiskPotential α f z = weightedNormalizedPotential α f z :=
-  indicator_of_mem hz _
