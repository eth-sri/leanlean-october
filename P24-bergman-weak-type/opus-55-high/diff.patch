-theorem polarKernel_equation_nonpos (k a b r θ : ℝ)
-    (hd : 0 < polarDenominator a b r θ) (hr : r ≠ 0) (ht : 0 < 1 - r ^ 2)
-    (hw : a ^ 2 + b ^ 2 ≤ 1) :
