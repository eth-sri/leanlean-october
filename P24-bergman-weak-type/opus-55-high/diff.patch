-@[simp] theorem weightedPotential_zero (α : ℝ) (f : ℂ → ℂ) :
-    weightedPotential α f 0 = ∫ w, ‖f w‖ ∂weightedArea α := by
-  simp [weightedPotential, weightedKernel]
