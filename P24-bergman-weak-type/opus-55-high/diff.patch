-    (show (0 : ℝ) ∈ closure (Ioo (0 : ℝ) (1 - b)) by
-      rw [closure_Ioo (by linarith : (0 : ℝ) ≠ 1 - b)]
-      exact ⟨le_rfl, by linarith⟩)
-  simpa using hz
-
-end BergmanWeakType
