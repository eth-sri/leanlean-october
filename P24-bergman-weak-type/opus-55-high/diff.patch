-@[simp] theorem weightedNormalizedPotential_zero (α : ℝ) (f : ℂ → ℂ) :
-    weightedNormalizedPotential α f 0 = ∫ w, ‖f w‖ ∂weightedArea α := by
-  simp [weightedNormalizedPotential]
