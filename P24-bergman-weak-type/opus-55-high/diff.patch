-/-- Cauchy's derivative formula at any point inside the contour. -/
-theorem circleIntegral_sub_inv_sq_mul {f : ℂ → ℂ} {c a : ℂ} {r : ℝ}
-    (hr : 0 < r) (hf : DiffContOnCl ℂ f (ball c r)) (ha : a ∈ ball c r) :
