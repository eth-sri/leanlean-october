-theorem polarIntegral_operator (k : ℝ) {r : ℝ} (hr : r ^ 2 < 1) (θ : ℝ) :
-    polarIntegral (polarKernelRR (-k / 2)) a b μ f r θ +
-      polarIntegral (polarKernelR (-k / 2)) a b μ f r θ / r +
-      polarIntegral (polarKernelTT (-k / 2)) a b μ f r θ / r ^ 2 -
