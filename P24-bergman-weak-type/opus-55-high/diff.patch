-theorem polarDenominator_eq_norm_sq (r θ : ℝ) (w : ℂ) :
-    polarDenominator w.re w.im r θ = ‖1 - circleMap 0 r θ * star w‖ ^ 2 := by
-  rw [← denominator_eq_norm_sq, circleMap_zero_re, circleMap_zero_im]
