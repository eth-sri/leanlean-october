-def weightedPotential (α : ℝ) (f : ℂ → ℂ) (z : ℂ) : ℝ :=
-  ∫ w, ‖weightedKernel α z w‖ * ‖f w‖ ∂weightedArea α
-
-def weightedNormalizedPotential (α : ℝ) (f : ℂ → ℂ) (z : ℂ) : ℝ :=
-  weightedPotential α f z / normalizer α ‖z‖
-
