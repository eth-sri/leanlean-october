-theorem polarKernel_laplacian (q a b r θ : ℝ)
-    (hd : 0 < polarDenominator a b r θ) (hr : r ≠ 0) :
-    polarKernelRR q a b r θ + polarKernelR q a b r θ / r +
-      polarKernelTT q a b r θ / r ^ 2 =
-        4 * q ^ 2 * (a ^ 2 + b ^ 2) * polarKernel (q - 1) a b r θ := by
