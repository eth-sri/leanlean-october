-  exact mul_nonpos_of_nonpos_of_nonneg
-    (div_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr
-      (mul_nonneg (sq_nonneg k) (sub_nonneg.mpr hw))) (mul_nonneg ht.le hd.le))
-    (Real.rpow_nonneg hd.le _)
