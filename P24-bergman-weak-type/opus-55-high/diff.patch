-  apply Measure.integrableOn_of_bounded measure_Icc_lt_top.ne
-    ((measurable_halfDiskPower α).comp
-      ((continuous_circleMap 0 r).comp (continuous_id.add_const η)).measurable).aestronglyMeasurable
