+lemma zeroTerm_conj f q σ γ ρ :
+    zeroTerm f q σ (-γ) (conj ρ) = zeroTerm f q σ γ ρ := by
+  unfold zeroTerm; rw [← laplace_re_conj]; congr 2; apply Complex.ext <;> simp [-Complex.natCast_log]; ring
+
+
+end
