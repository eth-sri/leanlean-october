-      (((1 / n * Real.exp (-(E.δ j + E.δ j') * tn q n) : ℝ) : ℂ) *
-        cexp (-(((E.γ j - E.γ j') * Real.log n : ℝ) : ℂ) * I)) =
-      ((Real.log n * (1 / n * Real.exp (-(E.δ j + E.δ j') * tn q n)) : ℝ) : ℂ) *
