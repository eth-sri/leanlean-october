-lemma integral_stepFn (φ : ℝ → ℝ) {h : ℝ} (hh : 0 < h) (j : ℕ) :
-    IntervalIntegrable (stepFn φ h) volume 0 (j * h) ∧
-      ∫ t in (0 : ℝ)..(j * h), stepFn φ h t = ∑ i ∈ Finset.range j, cell φ h i * h := by
-  induction j with
