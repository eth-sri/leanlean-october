-lemma sum_le_partition (φ : ℝ → ℝ) (q : ℕ) (hq : 1 < q) (u c : ℕ → ℝ) (hu0 : u 0 = 0)
-    (hmono : ∀ i, u i ≤ u (i + 1)) (j : ℕ)
