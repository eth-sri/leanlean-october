+          (hcel _ ⟨tn_ge_of_gt hq1 hn1, by push_cast at h2; exact (div_le_iff₀ hℓ).2 h2⟩)
+          (div_nonneg ArithmeticFunction.vonMangoldt_nonneg hnR.le)
