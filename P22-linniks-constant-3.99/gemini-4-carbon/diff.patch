-  have hc : ⌈t / h⌉₊ = i + 1 := by
-    rw [Nat.ceil_eq_iff (Nat.succ_ne_zero i)]
-    constructor
-    · rw [Nat.succ_sub_one, lt_div_iff₀ hh]; exact ht1
-    · rw [div_le_iff₀ hh]; push_cast; exact ht2
-  unfold stepFn
