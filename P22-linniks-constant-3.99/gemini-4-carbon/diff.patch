-          gcongr
-          exact h _ _
-      _ ≤ K * ((x : ℝ) / l) ^ ((2 : ℝ) / 3) := by
-          rw [one_mul]
-          gcongr
-  · rw [Finset.Ioc_eq_empty (by omega)]
-    simp only [Finset.sum_empty, norm_zero, mul_zero]
-    positivity
