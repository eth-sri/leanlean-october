-@[simp] lemma near_s (Δ : Finset ℝ) : (p.near Δ).s = p.s := rfl
-@[simp] lemma near_s₁ (Δ : Finset ℝ) : (p.near Δ).s₁ = p.s1 := rfl
-@[simp] lemma near_m (Δ : Finset ℝ) : (p.near Δ).m = p.m := rfl
