-    ‖wt s n - wt s (n + 1)‖ ≤ (1 + ‖s‖ * Real.log (n + 1)) / (n : ℝ) ^ 2 := by
-  set G : ℝ → ℂ := fun u => (u : ℂ) * cexp ((u : ℂ) * (-s)) with hG
-  have hn0 : (0:ℝ) < n := by exact_mod_cast hn
