+    have hg1 : (1 : ℝ) ≤ (d.gcd e : ℕ) := by exact_mod_cast Nat.gcd_pos_of_pos_left e hd0
+    have hl : (0 : ℝ) < (d.lcm e : ℕ) := by exact_mod_cast Nat.lcm_pos hd0 he0
