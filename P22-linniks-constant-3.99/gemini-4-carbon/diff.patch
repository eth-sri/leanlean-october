+    have e2 := sum_Ioc_consecutive (ψ ·) (Nat.le_add_right N q) (Nat.le_add_right _ H)
+    rw [hper, add_zero, add_right_comm] at e1; rw [hper, zero_add] at e2
+    rw [e1.trans e2.symm]; exact h (N + q) H (by omega) hH hHq
