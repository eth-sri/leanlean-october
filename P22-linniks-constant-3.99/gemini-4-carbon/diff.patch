-/-- A non-principal character sums to zero over a complete period `(N, N + q]`. -/
-lemma sum_Ioc_period_eq_zero {q : ℕ} (hq : 0 < q) (χ : DirichletCharacter ℂ q) (hχ : χ ≠ 1)
