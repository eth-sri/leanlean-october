-theorem le_mul_ceilDiv (a : ℤ) {b : ℤ} (hb : 0 < b) : a ≤ b * ceilDiv a b := by
-  unfold ceilDiv
-  have := Int.ediv_mul_le (-a) hb.ne'
-  linarith
