-    ∃ t : ℝ, 0 ≤ t ∧ t ≤ Real.sqrt d ∧ thresholdCost v D d t ≤ 1 := by
-  let b : ℝ := d * ∑ i, pos (v i) / D i
-  let f : ℝ → ℝ := fun t => d * (∑ i, pos (v i - t) / D i) - t
-  have hb : 0 ≤ b := by
-    dsimp [b]
-    exact mul_nonneg (le_of_lt hd)
-      (Finset.sum_nonneg (fun i _ => div_nonneg (pos_nonneg _) (le_of_lt (hD i))))
