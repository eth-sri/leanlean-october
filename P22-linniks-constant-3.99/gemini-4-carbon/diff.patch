+theorem burgessBound_of_primitive (hB : BurgessPrimitive) : BurgessBound := by
+  intro ε hε
+  set ε2 := ε / 2
+  have hε2 : 0 < ε2 := half_pos hε
+  obtain ⟨C₁, hC₁⟩ := hB ε2 hε2
