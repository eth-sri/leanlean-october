-  refine ⟨τ, hτ0, hτd, ?_⟩
-  have hmax : ∀ j, max 0 (v j - τ) = ThresholdAux.pos (v j - τ) := fun j => max_comm _ _
-  simp only [hmax]
-  unfold ThresholdAux.thresholdCost at hcost
-  linarith
-
-end GradedNear
