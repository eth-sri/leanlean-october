-/-- Family part of the tangent line. -/
-noncomputable def famT (r : RowHead) (m s : ℝ) : ℝ :=
-  (r.fam.map fun t => (t.1 : ℝ) * tgt ((t.2.1 : ℝ) / S) m s / ((t.2.2 : ℝ) / S)).sum
