-          mul_le_mul_of_nonneg_left h (div_nonneg hlogA0 hA0.le)
-  -- Step 4: the integral
-  have hI : -(∫ t in Set.Ioc A B, deriv (fun t : ℝ => Real.log t / t) t *
-        ∑ k ∈ Finset.Icc 0 ⌊t⌋₊, sieveNu V k) ≤
-      (1 / Real.log V + C₁ / Real.log V ^ 2) * ((Real.log B ^ 2 - Real.log A ^ 2) / 2) := by
