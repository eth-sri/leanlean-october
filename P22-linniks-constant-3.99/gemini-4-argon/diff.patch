-    rw [sum_Icc_zero_sieveNu]
-    have h := (hS B (hVA.trans hAB)).2
-    have hlogB0 : 0 ≤ Real.log B := Real.log_nonneg (by linarith)
-    calc Real.log B / B * ∑ k ∈ Finset.Icc 1 ⌊B⌋₊, sieveNu V k
