-        Finset.sum_congr rfl (fun k _ => (one_div_pow (p : ℝ) k).symm)
-    _ ≤ ∑ k ∈ Finset.Ico (F.min' hne) (F.max' hne + 1), (1 / (p : ℝ)) ^ k :=
