-`Re F(x) = ∫₀^{x₀} f(t) e^{-xt} dt`. -/
-lemma laplace_re_real {f : ℝ → ℝ} {x₀ B : ℝ} (hf : Condition1 f x₀ B) (x : ℝ) :
-    (laplace f (x : ℂ)).re = ∫ t in (0 : ℝ)..x₀, f t * Real.exp (-(x * t)) := by
