-/-- Column part of the tangent line of row `k` at `m`, evaluated at `m + s`. -/
-noncomputable def colT (L : Leaf) (x : Fin L.cols.length → ℝ) (k : ℕ) (m s : ℝ) : ℝ :=
-  ∑ j, x j * tgt (((L.cols.get j).v.getD k 0 : ℝ) / S) m s / (((L.cols.get j).D.getD k 1 : ℝ) / S)
