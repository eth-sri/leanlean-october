-/-- A zero of a non-principal `L(s, χ)` has multiplicity at least one. -/
-lemma one_le_zmult {q : ℕ} [NeZero q] {χ : DirichletCharacter ℂ q} (hχ : χ ≠ 1) {ρ : ℂ}
