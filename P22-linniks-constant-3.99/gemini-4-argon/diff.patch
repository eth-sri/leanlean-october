-/-! ### Sums -/
-
-lemma list_sum_le {α : Type*} (l : List α) (f g : α → ℝ) (h : ∀ t ∈ l, f t ≤ g t) :
-    (l.map f).sum ≤ (l.map g).sum := by
-  induction l with
-  | nil => simp
-  | cons a l ih =>
-    simp only [List.map_cons, List.sum_cons]
-    exact add_le_add (h a (by simp)) (ih fun t ht => h t (by simp [ht]))
