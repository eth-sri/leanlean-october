-private lemma sieve_diagonal_core {V A B C₁ : ℝ} (hC₁ : 0 ≤ C₁) (hVe : Real.exp 1 ≤ V) (hVA : V ≤ A)
-    (hAB : A ≤ B)
-    (hS : ∀ N : ℝ, V ≤ N →
-      N / Real.log V - C₁ * N / Real.log V ^ 2 ≤ ∑ n ∈ Finset.Icc 1 ⌊N⌋₊, sieveNu V n ∧
