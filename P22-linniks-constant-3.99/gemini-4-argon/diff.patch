-theorem getD_map_cast (Z : List ℕ) (k : ℕ) :
-    (Z.map (Nat.cast : ℕ → ℤ)).getD k 0 = ((Z.getD k 0 : ℕ) : ℤ) := by
-  have := List.getD_map Z 0 (n := k) (Nat.cast : ℕ → ℤ)
