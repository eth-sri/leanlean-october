+    rw [hfactor]
+    have hg1' : 0 < g := (Finset.mem_Ioc.1 hg).1
+    have hg1 : (1 : ℝ) ≤ g := by exact_mod_cast hg1'
+    have hg0 : (0 : ℝ) < g := by linarith
+    have hU : ∑ d ∈ Finset.Ioc 0 K, F g d ≤ 3 * (K : ℝ) ^ ((1 : ℝ) / 3) * (g : ℝ)⁻¹ := by
