-theorem sieve_diagonal (hGr : GrahamEstimate) :
-    ∃ C V₀ : ℝ, 1 < V₀ ∧ ∀ V A B : ℝ, V₀ ≤ V → V ≤ A → A ≤ B →
-      ∑ n ∈ Finset.Icc ⌈A⌉₊ ⌊B⌋₊, Real.log n / n * sieveNu V n ≤
-        (Real.log B ^ 2 - Real.log A ^ 2) / (2 * Real.log V) +
-          C * (Real.log B ^ 2 + 1) / Real.log V ^ 2 := by
