-theorem zmult_conj {χ : DirichletCharacter ℂ q} (hχ : χ ≠ 1)
-    (hreal : ∀ a : ZMod q, conj (χ a) = χ a) (ρ : ℂ) :
-    zmult χ (conj ρ) = zmult χ ρ := by
-  simp only [zmult, analyticOrderNatAt, analyticOrderAt_LFunction_conj hχ hreal ρ]
-
-variable {ι : Type*}
-
