-  have e1 : cexp (-((E.γ j * Real.log n : ℝ) : ℂ) * I) *
-      cexp (((E.γ k * Real.log n : ℝ) : ℂ) * I) =
-      cexp (-(((E.γ j - E.γ k) * Real.log n : ℝ) : ℂ) * I) := by
