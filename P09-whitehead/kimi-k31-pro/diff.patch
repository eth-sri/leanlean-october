-/-- The number, modulo two, of edges of the walk `l` carrying the label `χ`. -/
-def crossings (χ : Vx → Vx → ZMod 2) : List Vx → ZMod 2
-  | a :: b :: t => χ a b + crossings χ (b :: t)
