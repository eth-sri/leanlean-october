-  sat_commutator : ∀ N : @Subgroup G grp, @Subgroup.Normal G grp N → (∀ v, Sat N v) →
-      ∀ v, Sat ⁅N, N⁆ v
-  /-- A perfect normal subgroup satisfying all requirements yields the acyclic regular
-  cover `K_N`: `H₁(K_N) = N/[N,N] = 0` and `H₂(K_N) = ker ∂_{2,N} = 0`. -/
