-namespace Pi1
-
-variable {x : Vx}
-
-/-- The class of a closed walk. -/
-def mk (p : (toSimpleGraph S).Walk x x) : S.Pi1 x := Quotient.mk (walkSetoid S x x) p
-
-theorem mk_eq_mk {p q : (toSimpleGraph S).Walk x x} : mk p = mk q ↔ S.WalkHtpy p q :=
-  Quotient.eq (r := walkSetoid S x x)
