+    naturalDiskExtension r₀ r₁ H (t, boundaryFamilyInclusion J E a) =
+      old r₀ _ (H (t, a)) := by
+  change naturalDiskExtensionAt r₀ r₁ H a.1 _ = _
+  solve_by_elim [ballHomotopyExtension_boundary]
