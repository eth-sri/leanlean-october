+      apply stdSimplex.ext
+      rw [stickSimplex_cons_val,
+        show Fin.last _ = (Fin.last _).succ by rfl,
+        faceMap_succ_val]
+      apply congrArg _; rw [ih]; exact mul_insertNth_zero _ _
+        _
