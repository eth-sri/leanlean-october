+      change old a₀ Subtype.val (H (unitInterval.symm _, a)) = _
+      congr 2
+      refine Prod.ext ?_ rfl
+      apply Subtype.ext
+      change 1 - (2 * t - 1) = min (2 * (t : ℝ)) _
+      rw [min_eq_right (by linarith)]
