+        refine ⟨t, ?_⟩
+        apply stdSimplex.ext
+        funext i
+        cases i using Fin.cases with
+        | zero =>
+            change 1 - (t 0) = z.1 0
+            aesop
+        | succ j =>
+            change (t 0) * stickSimplex d _ j = z.1 j.succ
+            have hzsum := z.property.2
+            rw [Fin.sum_univ_succ] at hzsum
+            have hzj_le :=
