+  induction d with
+  | zero =>
+      simp
+  | succ d ih =>
+      intro t u ht hu hstick
+      have hheadReal : (t 0) = (u 0 : ℝ) := by
+        have hzero := congrArg (fun z : stdSimplex ℝ (Fin _) => z 0) hstick
