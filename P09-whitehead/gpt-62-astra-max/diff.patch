+namespace FiniteChains.Comb.IsPosetCover
+universe u
+variable {P Q : Type u} [PartialOrder P] [PartialOrder Q] {f : P → Q}
+  (hf : IsPosetCover f)
+
+def strictMap := strictOrderCxMap f hf.strictMono
+
