+  refine ⟨fun _ _ h => h.1, fun p => ⟨⟨p, 1⟩, rfl⟩, ?_, ?_⟩
+  · intro a p hp
+    refine ⟨⟨p, a.sheet * c.val a.point p⟩, ⟨⟨hp, rfl⟩, rfl⟩, ?_⟩
+    rintro ⟨b, g⟩ ⟨h, hb⟩
+    have hg := h.2
+    simp_all
