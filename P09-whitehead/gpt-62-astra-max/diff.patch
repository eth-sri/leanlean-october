+  le_trans a b d hab hbd := ⟨hab.1.trans hbd.1, by
+    grind [c.comp, mul_assoc, hab.2, hbd.2]⟩
+  le_antisymm a b hab hba := by
+    have hp := le_antisymm hab.1 hba.1
+    cases a with
+    | mk ap ag =>
