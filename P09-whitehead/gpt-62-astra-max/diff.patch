-variable {V : Type u} [DecidableEq V] (A : CommRel V)
-
-theorem gen_inv (s : V) : (gen A s)⁻¹ = gen A s :=
-  inv_eq_of_mul_eq_one_left (gen_mul_gen A s)
-
-end RACG
-end FiniteChains
