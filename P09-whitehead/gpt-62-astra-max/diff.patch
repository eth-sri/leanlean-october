+    IsQuotientMap (Sum.elim (pointFillBase x c b i) (pointFillDisk x c b i)) := by
+  apply isQuotientMap_iff_isClosed.mpr
+  constructor
+  · intro z
+    obtain ⟨z, rfl⟩ := quotientMap_surjective _ i z
+    cases z with
+    | inl y =>
