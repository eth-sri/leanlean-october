+    dist (affineEval hA v z).val (affineEval hA v w).val ≤ D := by
+  have hm (t : TopologicalSingular.Domain n) :=
+    affineEval_mem_of_vertices hA (convex_convexHull ℝ (Set.range (fun j => (v j).val))) v
