+    (∃ y : CayGroup A, y ≠ x ∧ RACG.clen A y ≤ RACG.clen A x ∧ InChamber y p) ↔
+      (p.spx ∩ rdescFinset A x).Nonempty := by
+  have hkey := exists_rdesc_iff_exists_earlier A (commuting_of_isSimplex p.isSimplex) x
