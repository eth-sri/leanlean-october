-/-- The one-skeleton of a square complex, as a simple graph. -/
-def toSimpleGraph (S : SquareComplex Vx) : SimpleGraph Vx where
-  Adj := S.adj
-  symm := ⟨fun _ _ h => S.adj_symm h⟩
-  loopless := ⟨S.adj_irrefl⟩
