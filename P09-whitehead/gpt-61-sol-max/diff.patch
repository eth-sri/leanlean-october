-
-theorem Homotopic.getLast?_eq {l l' : List Vx} (h : S.Homotopic l l') :
-    l.getLast? = l'.getLast? := by
-  induction h with
-  | refl => rfl
-  | tail _ hstep ih => rcases hstep with hm | hm
