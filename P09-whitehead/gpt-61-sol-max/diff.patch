+theorem loop_bounds_of_mem_commutator  (p : Loop X a)
+    (hp : Pi1.mk p ∈ commutator (Pi1 X a)) :
+    ∃ d : X.F →₀ ℤ, bdry2 X d = pathChain p.val := by
+  have hz := Abelianization.commutator_subset_ker (loopBoundaryClass X a) hp
