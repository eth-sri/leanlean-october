+theorem ballHomotopyExtension_natural
+    (f : C(X, Y)) (d : C(ClosedUnitBall E, X)) (d' : C(ClosedUnitBall E, Y))
+    (H : C(I × UnitBoundary E, X)) (H' : C(I × UnitBoundary E, Y))
+    (h₀ : ∀ a, H (0, a) = d (unitBoundaryInclusion E a))
+    (h₀' : ∀ a, H' (0, a) = d' (unitBoundaryInclusion E a))
