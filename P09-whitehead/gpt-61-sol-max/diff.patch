+    (f : Fin (d + 1) → Fin (e + 1)) (c : VertexChains.Chain (TopologicalSingular.Domain d) k) :
+    TopologicalSingular.map (standardMap f) (k + 1)
+        (realize (convex_stdSimplex ℝ (Fin (d + 1))) (k + 1)
