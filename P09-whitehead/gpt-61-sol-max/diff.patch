+    (∃ v : CayGroup A, RACG.clen A v < RACG.clen A w ∧ InChamber v p) ↔ JSet w p := by
+  grind [FiniteChains.Davis.jSet_iff, FiniteChains.Davis.mem_shorter_chamber_iff]
