+        (subdivide (center (convex_stdSimplex ℝ (Fin (e + 1)))) k
+          (VertexChains.map (standardMap f) k c)) :=
+  realize_subdivide_naturality _ _ (standardLinearMap f) (standardLinearMap_mapsTo f) k c
