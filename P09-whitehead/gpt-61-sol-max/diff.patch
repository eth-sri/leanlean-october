-structure WallSystem (S : SquareComplex Vx) (ι : Type*) where
-  /-- The characteristic function of the `i`-th wall. -/
-  χ : ι → Vx → Vx → ZMod 2
-  /-- Each member of the family is square-closed and symmetric. -/
