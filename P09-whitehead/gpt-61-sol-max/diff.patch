-theorem isWalk_junction {y z : Vx} {r : List Vx} (h : S.IsWalk (y :: r))
-    (hz : r.head? = some z) : S.adj y z := by
-  cases r with
-  | nil => simp at hz
-  | cons c r' =>
-      simp only [List.head?_cons, Option.some.injEq] at hz
