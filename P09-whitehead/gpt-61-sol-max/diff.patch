+def HasHomotopyExtension (i : A → D)  :=
+  ∀ (Z : Type u) [TopologicalSpace Z] (f : C(D, Z)) (H : C(I × A, Z)),
+    (∀ a, H (0, a) = f (i a)) →
+    ∃ G : C(I × D, Z), (∀ d, G (0, d) = f d) ∧
+      ∀ t a, G (t, i a) = H (t, a)
