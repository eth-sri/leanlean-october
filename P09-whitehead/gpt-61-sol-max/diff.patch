-/-- A walk from `x` to `y`. -/
-def IsWalkFrom (S : SquareComplex Vx) (x y : Vx) (l : List Vx) : Prop :=
-  S.IsWalk l ∧ l.head? = some x ∧ l.getLast? = some y
