+
+theorem cut_right   (j : Fin (n + 2)) (h : i.castSucc < j) :
+    cut i.castSucc.val ∘ j.succ.succAbove = (cut i.val : Fin (n + 2) → Fin 2) := by
+  funext k
+  have hh : i.val < j.val := h
+  have hv : (j.succ.succAbove k).val = if k.val < j.val + 1 then k.val else k.val + 1 := by
