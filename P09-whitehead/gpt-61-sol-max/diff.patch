+theorem spineReach_trans {a b c : GenusSpineCell q}
+    (h : Reach (orderCx (GenusSpineCell q)) a b)
+    (h' : Reach (orderCx (GenusSpineCell q)) b c) :
+    Reach (orderCx (GenusSpineCell q)) a c := by
+  obtain ⟨p, hp⟩ := h
+  obtain ⟨r, hr⟩ := h'
+  exact ⟨p ++ r, hp.append hr⟩
