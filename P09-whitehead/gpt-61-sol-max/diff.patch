+    IsClosed (orderNerveRealizationSubcomplex P A : Set (orderNerveRealization P)) := by
+  rw [← orderNerveRealizationSubtype_range A]
+  exact (orderNerveRealizationSubtype_isClosedEmbedding A).isClosed_range
