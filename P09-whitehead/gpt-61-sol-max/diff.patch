+        (realize hA (n + 1) (subdivideHomotopy (center hA) n c)) =
+      realize hB (n + 1) (subdivideHomotopy (center hB) n (VertexChains.map (restriction f hf) n c)) := by
+  rw [realize_naturality hA hB]
+  have he := DFunLike.congr_fun
