+      have h1 : x⁻¹ * p.rep ∈ specialSub A (p.spx : Set V) := by
+        have := Subgroup.inv_mem _ hp
+        rwa [mul_inv_rev, inv_inv] at this
+      have h2 : x⁻¹ * y = (x⁻¹ * p.rep) * (p.rep⁻¹ * y) := by group
+      rw [h2]
