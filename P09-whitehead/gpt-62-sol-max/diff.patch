+def side {n : ℕ} (A : Fin (n + 1) → Fin (n + 2) → V) (i : Fin n) (j : Fin (n + 1)) : V :=
+  if j ≤ i.castSucc then A i.succ j.castSucc else A i.castSucc j.succ
