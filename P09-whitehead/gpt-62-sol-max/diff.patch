-omit [Fintype V] in
-theorem upto_zero_iff (p : Sph A) : Upto 0 p ↔ InChamber 1 p := by
-  constructor
-  · rintro ⟨y, hy, hyp⟩
-    have : y = 1 := (RACG.clen_eq_zero_iff A).1 (Nat.le_zero.1 hy)
