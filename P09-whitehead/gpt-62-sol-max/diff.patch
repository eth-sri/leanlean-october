+universe u
+variable (X : Complex2.{u})
+
+/-- Edge chains modulo actual finite face boundaries. -/
+abbrev EdgeBoundaryQuotient := (X.E →₀ ℤ) ⧸ LinearMap.range (bdry2 X)
