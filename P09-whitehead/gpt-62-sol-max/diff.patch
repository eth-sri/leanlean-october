-  | Sum.inr _ => False
-
-theorem zJSet_imp_inZChamber {w : CayGroup A} {z : Zpos A X M att} (h : ZJSet w z) :
-    InZChamber w z := by
-  cases z with
-  | inl p => exact h.choose_spec.2.1
-  | inr wx => exact h.elim
-
-/-- **The attaching intersection of a chamber of `Z`.**  A cell of the chamber of `w` lies in
