-@[reducible] def toyData : TwoComplexData.{0} where
-  Cx := ℕ
-  Sub := (· ≤ ·)
-  sub_refl _ := le_rfl
-  sub_trans h h' := le_trans h h'
-  Cockcroft _ := True
-  ZeroPi2 _ _ := True
-  Pi1Trivial _ _ := True
-  Acyclic _ := True
-  IsAcyclicCover _ _ := True
-
-end FiniteChains
