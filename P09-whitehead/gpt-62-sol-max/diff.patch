+def chartedFixedPresChainFS
+    (hkill : ∀ i : Fin n, Whitehead.KillsPi2
+      (⟨Set.inclusion (hC (Nat.le_succ i.val)),
+        continuous_inclusion _⟩ : C((C i.castSucc : Set K), (C i.succ : Set K)))) :
