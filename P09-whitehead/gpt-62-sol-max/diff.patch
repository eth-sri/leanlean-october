+    (hp : IsCoveringMap p) (H : f.Homotopy (ContinuousMap.id Y)) :
+    ContinuousMap.HomotopyEquiv (CoverPullback f p) D := by
+  let E := ((coverPullbackHomotopyHomeomorph p hp H).trans (coverPullbackIdentity p)).toHomotopyEquiv
