+    (cylRetr (aHom w) (cylCollapse (aHom w) (cylinderProjection w gen hrel p))) =
+      r.val.2 at he
+  simpa only [cylCollapse, cylRetr, cylIn, Sum.elim_inl, id_eq, roseVal_self, mul_one] using he.symm
