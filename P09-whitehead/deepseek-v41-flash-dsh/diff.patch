-  | succ d ih =>
-      intro i t
-      refine Fin.cases ?_ (fun i => ?_) i
-      · have hinput : cubeFace (0 : Fin (d + 2)) 1 t =
-            (Fin.cons 1 t : I^Fin (d + 2)) := by
-          change Fin.insertNth 0 1 t = (Fin.cons 1 t : I^Fin (d + 2))
