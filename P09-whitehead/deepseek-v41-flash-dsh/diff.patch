+    SkeletonCarrier (Set.univ : Set X) 1 :=
+  ⟨vertexPoint j, CWComplex.closedCell_subset_skeletonLT 0 j
+    (by rw [CWComplex.closedCell_zero_eq_singleton]; rfl)⟩
