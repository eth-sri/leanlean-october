+        | succ j =>
+            change (t 0 : ℝ) * stickSimplex d (fun k => t k.succ) j = z.1 j.succ
+            have hzsum := z.property.2
+            rw [Fin.sum_univ_succ] at hzsum
+            change z.1 0 + ∑ k : Fin (d + 1), z.1 k.succ = 1 at hzsum
+            have hzj_le : z.1 j.succ ≤ ∑ k : Fin (d + 1), z.1 k.succ :=
