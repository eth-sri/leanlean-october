-/-! ### Cubical faces -/
-
-theorem cubeFace_zero_eq_cons {d : ℕ} (a : I) (t : I^Fin d) :
-    cubeFace (0 : Fin (d + 1)) a t = (Fin.cons a t : I^Fin (d + 1)) := by
-  change Fin.insertNth 0 a t = (Fin.cons a t : I^Fin (d + 1))
-  exact Fin.insertNth_zero' a t
