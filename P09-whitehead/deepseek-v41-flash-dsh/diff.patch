+    let v : Cover p hp := ⟨q, e⟩
+    refine ⟨⟨orderNerveRealizationVertex v, ?_⟩, ?_⟩
+    · exact orderNerveRealizationMap_vertex _ _ v
+    · apply Subtype.ext
+      exact realizationComparison_vertex p hp v
