-    obtain ⟨hsσ, hsd⟩ := Finset.mem_inter.1 hs
-    obtain ⟨y, hxy, hne, hlen⟩ := hkey.2 ⟨s, Finset.mem_coe.2 hsσ, (mem_rdescFinset A).1 hsd⟩
-    refine ⟨y, hne, hlen, ?_⟩
