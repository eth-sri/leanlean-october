-theorem mul_insertNth_zero {d : ℕ} (i : Fin (d + 1)) (a : ℝ) (f : Fin d → ℝ) :
-    (fun j : Fin (d + 1) => a *
-        (@Fin.insertNth d (fun _ : Fin (d + 1) => ℝ) i (0 : ℝ) f) j) =
-      @Fin.insertNth d (fun _ : Fin (d + 1) => ℝ) i (0 : ℝ)
-        (fun j : Fin d => a * f j) := by
-  funext j
-  refine Fin.succAboveCases i ?_ (fun k => ?_) j
-  · simp
-  · simp
