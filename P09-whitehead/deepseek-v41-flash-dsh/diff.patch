+variable (core : M → FreeGroup A) (extra : J → FreeGroup (A ⊕ B))
+  (target : J → FreeGroup B) (rev : J → Bool)
+  (hword : ∀ j, dropCore (extra j) = if rev j then (target j)⁻¹ else target j)
