+      else coefficientMap core extra target rev hword (v (Sum.inr j))) (by
+    intro j hj
+    apply Finsupp.mem_support_iff.mpr
+    intro hz
+    have hz' : v (Sum.inr j) = 0 := hz
+    apply hj
