-theorem stickSimplex_cons_val (d : ℕ) (a : I) (t : I^Fin d) :
-    (⇑(stickSimplex (d + 1) (Fin.cons a t)) : Fin (d + 2) → ℝ) =
-      (Fin.cons (1 - (a : ℝ))
-        (fun i => (a : ℝ) * stickSimplex d t i) : Fin (d + 2) → ℝ) := by
