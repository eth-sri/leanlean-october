+    have hn0 : n = 0 := by omega
+    subst n
+    refine ⟨j, Subtype.ext ?_⟩
+    exact (show x.val = vertexPoint j from by
+      simpa only [CWComplex.openCell_zero_eq_singleton, Set.mem_singleton_iff, vertexPoint] using hj).symm
