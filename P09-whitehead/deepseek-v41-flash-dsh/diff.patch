+    C(BoundaryFamily (OriginalRoseRel K) (Fin 2 → ℝ), Rose (OriginalRoseGen K)) :=
+  ⟨fun a => (originalRoseWords K a.1).boundaryMap a.2,
+    continuous_sigma (fun j => (originalRoseWords K j).boundaryMap.continuous)⟩
