+@[simp] theorem pointAttachmentFillingHomeomorph_old (y : X) :
+    pointAttachmentFillingHomeomorph x c b i hi (pointOld x (i (b.symm c)) y) =
+      pointFillBase x c b i y := attachmentQuotientHomeomorph_old ..
