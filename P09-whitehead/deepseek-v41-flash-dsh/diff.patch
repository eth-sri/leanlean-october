-  | succ d ih =>
-      intro t u ht hu hstick
-      have hheadReal : (t 0 : ℝ) = (u 0 : ℝ) := by
-        have hzero := congrArg (fun z : stdSimplex ℝ (Fin (d + 2)) => z 0) hstick
-        simp only [stickSimplex_succ_zero] at hzero
-        linarith
-      have hhead : t 0 = u 0 := Subtype.ext hheadReal
-      have ht0 : (t 0 : ℝ) ≠ 0 := by
-        intro ht0
