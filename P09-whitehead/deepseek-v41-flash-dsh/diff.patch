-theorem stickSimplex_succ_val (d : ℕ) (t : I^Fin (d + 1)) :
-    (⇑(stickSimplex (d + 1) t) : Fin (d + 2) → ℝ) =
-      (Fin.cons (1 - (t 0 : ℝ))
-        (fun i => (t 0 : ℝ) * stickSimplex d (fun j => t j.succ) i) :
-          Fin (d + 2) → ℝ) :=
