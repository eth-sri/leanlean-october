-theorem cubeFace_succ_eq_cons {d : ℕ} (i : Fin (d + 1)) (a : I)
-    (t : I^Fin (d + 1)) :
-    cubeFace i.succ a t =
-      (Fin.cons (t 0) (cubeFace i a (Fin.tail t)) : I^Fin (d + 2)) := by
-  change i.succ.insertNth a t =
-    (Fin.cons (t 0) (i.insertNth a (Fin.tail t)) : I^Fin (d + 2))
-  rw [← Fin.cons_self_tail t]
