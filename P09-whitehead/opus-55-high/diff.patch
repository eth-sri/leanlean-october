+    (coverPullbackMapEquivOfHomotopicId _ p hp
+      (Classical.choice e.right_inv))
+  have hE : E.toFun = g.comp f := rfl
+  have hF : F.toFun = h.comp g := rfl
+  exact ContinuousMap.HomotopyEquiv.twoOfSixRight f g h E hE F hF
