+            cases z'' with
+            | inl r =>
+                cases' hz'z''.2 with hne hy
+                exact ⟨hzz'.1 ▸ hz'z''.1, hne, le_trans hzz'.2 hy⟩
+            | inr wz =>
+                exact ⟨hzz'.1.trans hz'z''.1, le_trans hzz'.2 hz'z''.2⟩
