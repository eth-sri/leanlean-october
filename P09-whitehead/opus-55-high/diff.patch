+  let h := coverPullbackMap e.toFun p
+  let E := (coverPullbackComposition e.toFun e.invFun q).toHomotopyEquiv.trans
+    (coverPullbackMapEquivOfHomotopicId _ q hq
+      (Classical.choice e.left_inv))
