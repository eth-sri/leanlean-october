+def imageCellEquiv (e : CWCellEmbedding K L) m :
+    RelCWComplex.cell (Set.univ : Set K) m ≃
+      {j : RelCWComplex.cell Set.univ m // j ∈ e.imageSubcomplex.I m} :=
+  Equiv.ofInjective _ (e.cellIndex m).injective
