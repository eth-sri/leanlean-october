+omit [Fintype V] in
+theorem not_isMarkedApex_apex {w : CayGroup A} (hw : ¬ M w) :
+    ¬ IsMarkedApex M (chamberPt w (isSimplex_empty (A := A))) := by
+  rintro ⟨-, h⟩
+  simp_all [chamberPt_empty_rep]
