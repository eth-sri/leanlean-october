-            | inr wy => exact hz'z''.elim
-        | inr wy => exact hzz'.elim
-    | inr wx =>
-        cases z' with
-        | inl q =>
-            cases z'' with
-            | inl r =>
-                obtain ⟨hne, hx⟩ := hzz'.2
