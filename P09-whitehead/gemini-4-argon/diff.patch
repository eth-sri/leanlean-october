-  intro A B h
-  ext i
-  have hi := congrFun h i
-  simp only [flipOn] at hi
-  constructor
-  · intro hA
-    by_contra hB
-    rw [if_pos hA, if_neg hB] at hi
-    simp at hi
-  · intro hB
-    by_contra hA
-    rw [if_neg hA, if_pos hB] at hi
-    simp at hi
