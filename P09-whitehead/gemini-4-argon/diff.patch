+    IsConnected (strictOrderCx (Cover p hp)) ∧
+    IsAcyclic (strictOrderCx (Cover p hp)) ∧
+    (∀ g e, (strictProjection p hp hs).onE ((strictDeckAction p hp).smulE g e) =
