-      · let ai : I := ⟨a, ha0, ha1⟩
-        let y : stdSimplex ℝ (Fin (d + 1)) :=
-          ⟨fun i => z.1 i.succ / a,
-            fun i => div_nonneg (z.property.1 i.succ) ha0,
-            by
