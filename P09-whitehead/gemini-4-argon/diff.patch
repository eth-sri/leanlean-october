-      have hlast' : m.getLast? = m'.getLast? := by
-        rcases hstep with ⟨hmove, -⟩ | ⟨hmove, -⟩
-        · exact hmove.getLast?_eq
-        · exact hmove.getLast?_eq.symm
-      have hjm' : ∀ a ∈ m'.getLast?, ∀ b ∈ t.head?, S.adj a b := by
-        rw [← hlast']; exact hjm
-      rcases hstep with ⟨hmove, hw⟩ | ⟨hmove, hw⟩
