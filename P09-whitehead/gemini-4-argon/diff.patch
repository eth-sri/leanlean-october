-
-/-! ### Counting crossings in `ℕ` -/
-
-/-- The number of edges of the walk `l` crossing the wall `χ`. -/
-def crossCount (χ : Vx → Vx → ZMod 2) : List Vx → ℕ
-  | a :: b :: t => (if χ a b = 1 then 1 else 0) + crossCount χ (b :: t)
-  | _ => 0
