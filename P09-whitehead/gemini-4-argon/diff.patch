-def wallSpaceOf (hfin : ∀ v : Vx, {i : ι | σ i v ≠ σ i x₀}.Finite)
-    (hsep : ∀ u v : Vx, u ≠ v → ∃ i, σ i u ≠ σ i v) : WallSpace Vx ι where
-  side i v := decide (σ i v = 1)
