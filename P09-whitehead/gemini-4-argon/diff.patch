-                  Finset.Nonempty.mono hz'z''.1 hne, ?_⟩
-                exact le_trans hx (att.monotone (show (⟨q.1.spx, hne, q.1.isSimplex⟩ : NeSpx A) ≤
-                  ⟨r.1.spx, Finset.Nonempty.mono hz'z''.1 hne, r.1.isSimplex⟩ from hz'z''.1))
-            | inr wy => exact hz'z''.elim
-        | inr wy =>
-            cases z'' with
