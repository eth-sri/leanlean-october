-
-variable {A K M S : Type} [DecidableEq A] [DecidableEq K] [DecidableEq S]
-  (core : M → FreeGroup A) (q : S → ℕ) [∀ s, NeZero (q s)]
-  (u : ∀ s, Fin (q s) × Bool → FreeGroup (A ⊕ K))
