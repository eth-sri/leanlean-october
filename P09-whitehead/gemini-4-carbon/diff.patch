-  | h p =>
-    induction d using UV.ind with
-    | h q =>
-      have hpe : endpt K x₀ p.1 = endpt K x₀ q.1 := he
-      have hp : IsPath K.src K.tgt p.1 x₀ (endpt K x₀ p.1) := p.2
-      have hq' : IsPath K.src K.tgt q.1 x₀ (endpt K x₀ p.1) := by
-        rw [hpe]; exact q.2
