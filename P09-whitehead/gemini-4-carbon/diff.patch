-section Bridge
-
-variable {α J α' J' : Type u}
-  [DecidableEq α] [Fintype J] [Fintype α'] [DecidableEq α'] [Fintype J']
-  {ρ : J → FreeGroup α} {ρ' : J' → FreeGroup α'}
-
-variable {ι : Type*} {A₂ A₁ Q Q₃ Q₂ Q₁ B₃ : Type*}
