-def pairSubGroupHom : PresGroup ρ →* PresGroup (pairRel ρ) :=
-  QuotientGroup.lift _ ((QuotientGroup.mk' _).comp pairSubstitution) (by
-    refine Subgroup.normalClosure_le_normal ?_
-    rintro _ ⟨j, rfl⟩
-    exact (QuotientGroup.eq_one_iff _).mpr
