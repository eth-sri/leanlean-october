-not a face of `L` is enlarged by none.) -/
-theorem hedge_of_edgeInTwoTriangles {L : ASC V} (h : ASC.EdgeInTwoTriangles L)
-    (e : Finset V) (he : e.card = 2) :
-    ((univ.filter fun j => j ∉ e).filter fun j => insert j e ∈ L.faces).card ≤ 2 := by
