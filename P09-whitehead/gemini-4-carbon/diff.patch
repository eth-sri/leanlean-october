-  | true =>
-      right
-      have hsrc : X.src e = a := by
-        simpa [germSrc, hb, hea] using hs
-      have hheight : T.ht (X.tgt e) + 1 = T.ht a := by
-        simpa [germTgt, hb, hea] using hh
-      exact hheight.trans (congrArg T.ht hsrc).symm
