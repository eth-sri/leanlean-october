+
+/-- The inclusion of a copy of the base is monotone. -/
+theorem zNew_monotone (w : {w : CayGroup A // M w}) :
+    Monotone (zNew (A := A) (X := X) (M := M) (att := att) w) :=
+  fun _ _ h => ⟨rfl, h⟩
