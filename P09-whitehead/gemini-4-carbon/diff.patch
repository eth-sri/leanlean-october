-      cubeEdgeSubdivision d v hv := by
-  rw (config := { transparency := .default }) [lowerFacetEdgeChain, map_sub]
-  simp [chain1, cubeLowerIncl, strictOrderCxMap, cubeEdgeSubdivision, Finsupp.lmapDomain_apply]
