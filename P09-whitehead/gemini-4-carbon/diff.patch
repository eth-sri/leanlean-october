-    change 1 - c b = c a
-    linarith
-  · by_cases hpb : p = b
-    · subst p
-      simp only [if_neg hne, ite_true, mul_zero, mul_one, zero_add]
-      rfl
-    · rw [if_neg (Ne.symm hpa), if_neg (Ne.symm hpb), hx p hpa hpb]
-      ring
-
-end FiniteChains.Comb
