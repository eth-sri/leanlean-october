-theorem markedBoundaryPos_div (x : Fin q × Bool) (b : Bool) :
-    (markedBoundaryPos q x b).val / 2 / 4 = x.1.val := by
-  obtain ⟨h, t⟩ := x
-  cases t <;> cases b <;> simp only [markedBoundaryPos, Bool.false_eq_true, ↓reduceIte] <;> omega
-
-omit [NeZero q] in
