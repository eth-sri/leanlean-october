-          foxMatrixPres (substPresF ρ bsub) (Sum.inr ⟨s, z⟩) (Sum.inr p)) := by
-      rw [hx, Finsupp.sum_sumElim]
-      rfl
-    _ = blocks.sum (fun p a => a *
-        foxMatrixPres (substPresF ρ bsub) (Sum.inr ⟨s, z⟩) (Sum.inr p)) := by
