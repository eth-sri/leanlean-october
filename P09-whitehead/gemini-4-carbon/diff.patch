-def markedBoundaryPos (x : Fin q × Bool) (b : Bool) : Fin (8 * q) :=
-  ⟨8 * x.1.val + (if x.2 then 2 else 0) + (if b then 1 else 0), by
-    have := x.1.isLt
-    cases x.2 <;> cases b <;> simp only [Bool.false_eq_true, ↓reduceIte] <;> omega⟩
