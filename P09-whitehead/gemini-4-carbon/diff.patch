-/-- Concatenating a loop at `x₀` in front of a path from `x₀`. -/
-def deckP (g : Loop X x₀) (p : PathFrom X x₀) : PathFrom X x₀ :=
-  ⟨g.1 ++ p.1, by
-    have hend : endpt X x₀ (g.1 ++ p.1) = endpt X x₀ p.1 := by
