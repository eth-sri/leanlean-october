-namespace PresMor
-
-variable {ρ : J → FreeGroup α} {ρ' : J' → FreeGroup α'} {ρ'' : J'' → FreeGroup α''}
-
-omit [Fintype α] [Fintype α'] in
-@[simp] theorem cells_zero (f : PresMor ρ ρ') : f.cells 0 = 0 := by
-  have h := f.cells_smul 0 0
-  rw [zero_smul, map_zero, zero_smul] at h
