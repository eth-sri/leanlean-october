-      show QuotientGroup.mk (pathWord T (revPath (T.treePath x₀))) = 1
-      rw [pathWord_revPath, pathWord_treePath]
-      simp
-    rw [hrev, one_mul, mul_one]
-    show QuotientGroup.mk (pathWord T L) = _
-    rw [hLw]
-  · show endpt K x₀ l = a
