-        omega
-      exact htf (by simpa [spineInc, hcard] using hg)
-    | inr σ =>
-      apply cubeBdry_inr_eq_zero
-      intro he
-      have hσ : IsTri L σ := by simpa [he] using mem_topCubes.mp ht
-      exact htf (by simp [spineInc, hσ, he])
-
-end FiniteChains
