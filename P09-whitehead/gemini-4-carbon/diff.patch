+theorem isPath_delta (p : Fin M) :
+    IsPath (orderCx (NeSpx (cmpRel (SCell vc ec hc)))).src
+      (orderCx (NeSpx (cmpRel (SCell vc ec hc)))).tgt (delta hc p)
+      (spx1 (cW hc p)) (spx1 (cV hc p)) :=
+  (isPath_edgeHop _).append (isPath_edgeHopRev _)
