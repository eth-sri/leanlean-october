-theorem orderCxRestrict_projects :
-    (orderCxMap Subtype.val (fun _ _ h => h)).comp (orderCxRestrict k S hk) = k := by
-  apply Hom.ext'
-  · rfl
-  · rfl
-  · rfl
-
-end FiniteChains.Comb
