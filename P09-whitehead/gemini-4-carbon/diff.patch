-@[simp] theorem pi1Map_mk (hp : IsCovering T B p) (x₀ : Vt)
-    (w : (toSimpleGraph T).Walk x₀ x₀) : hp.pi1Map x₀ (Pi1.mk w) = Pi1.mk (hp.mapWalk w) := rfl
