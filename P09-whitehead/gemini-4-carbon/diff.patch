-
-def qCubeFacet (c : QCube A) (v : V) (s : ZMod 2) : QCube A where
-  spx := c.spx.erase v
-  sgn := Function.update c.sgn v s
-  isSimplex := isSimplex_subset A (Finset.erase_subset _ _) c.isSimplex
-  sgn_eq_zero w hw := by
