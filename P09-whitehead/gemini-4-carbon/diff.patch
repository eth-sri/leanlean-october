+    rfl
+  have h1 s : qSquareChainSubdivision (Finsupp.single (f (1, s)) 1) =
+      cubeSquareSubdivision (qCubeFacet c v s) u w (Ne.symm (hvw.trans huv).ne)
+        (threeFacet_uw_spx c (Ne.symm huv.ne) (Ne.symm hvw.ne) hs s) := by
