-def loopWord : List (J × Bool) :=
-  List.append (α := J × Bool)
-    (List.append (α := J × Bool)
-      (List.append (W.word (0, false)) (W.word (1, true)))
-      (Comb.revPath (X := graphCx r) (W.word (0, true))))
-    (Comb.revPath (X := graphCx r) (W.word (1, false)))
