-def BlockSurfaceGeneratesFS (c : ∀ s, Mt s →₀ R') : Prop :=
-  ∀ (s : Sx) (β : Mt s →₀ R'),
-    (∀ z : Zt s, β.sum (fun m a => a *
-      foxMatrixPres (substPresF ρ bsub) (Sum.inr ⟨s, z⟩) (Sum.inr ⟨s, m⟩)) = 0) →
-    ∃ w : R', ∀ m, β m = w * c s m
