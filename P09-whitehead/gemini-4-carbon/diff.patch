-omit [DecidableEq A] [DecidableEq B] in
-@[simp] theorem cellsFS_single_core (m : M)
-    (a : MonoidAlgebra ℤ (PresGroup (corePres core extra))) :
-    cellsFS core extra target rev hword (Finsupp.single (Sum.inl m) a) = 0 := by
