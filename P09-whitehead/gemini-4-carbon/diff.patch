-theorem universalNerveChain2_lengthProjection (c : UF (orderCx P) a →₀ ℤ) :
-    Nerve.lengthProjection 3 (universalNerveChain2 c) = universalNerveChain2 c :=
-  ordNerveChain2_lengthProjection _
