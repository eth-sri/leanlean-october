-    by_cases hx : x.1 = s
-    · change x.1 ≤ (r x).1
-      simpa [r, hx] using hst
-    · simp [r, hx]
-  · intro x
-    by_cases hx : x.1 = s <;> simp [r, hx, hne]
-  · intro x hx
-    simp [r, hx]
