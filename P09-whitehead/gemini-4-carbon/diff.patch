+/-- The lengths of edge paths from a fixed vertex. -/
+def reach (K : Complex2.{u}) (r a : K.V) : Set ℕ := {n | ∃ p : List (K.E × Bool),
+  p.length = n ∧ IsPath K.src K.tgt p r a}
+
