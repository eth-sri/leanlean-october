-theorem exists_cover_zigzag_contraction (hf : IsPosetCover f)
-    (l r : Q → Q) (hl : Monotone l) (hr : Monotone r)
-    (hir : ∀ x, x ≤ r x) (hlr : ∀ x, l x ≤ r x) (b : Q) (hlb : ∀ x, l x ≤ b) :
