-  induction ps with
-  | nil => rfl
-  | cons p ps ih => simp only [List.cons_append, surfacePath, ih, List.append_assoc]
-
-theorem surfacePath_eq_flatMap {X : Complex2.{u}} {a : X.V} {ι : Type u}
-    (f : ι → Loop X a) (ps : List (ι × ι)) :
-    surfacePath f ps = ps.flatMap (fun p =>
