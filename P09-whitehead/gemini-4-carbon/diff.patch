-            existsUnique_up_inChamber (w := wx.1.1) wx.1.2 (c := c) hsgn
-          have hspx : r.spx = c.spx := (qProjCube_eq_iff.1 hrc).1
-          refine ⟨zOld r (not_isMarkedApex_of_qProjCube_eq hc hrc), ⟨⟨hwr, ?_⟩, ?_⟩, ?_⟩
