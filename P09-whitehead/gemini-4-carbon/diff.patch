-  calc
-    c.val b d • s d = (c.val a b)⁻¹ • (c.val a d • s d) := by
-      rw [← c.comp hab hbd, mul_smul, inv_smul_smul]
-    _ = (c.val a b)⁻¹ • s a := by rw [h₂]
-    _ = s b := by rw [← h₁, inv_smul_smul]
-
