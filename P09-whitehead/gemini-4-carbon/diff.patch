-  onV := Prod.snd
-  onE := Prod.snd
-  onF := Prod.snd
-  src_onE _ := rfl
-  tgt_onE _ := rfl
-  base_onF _ := rfl
-  att_onF f := (liftPath_projection T φ (K.att f.2) f.1).symm
-
