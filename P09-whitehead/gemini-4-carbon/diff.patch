-theorem markingTail_lastEndpoints_avoids (i j : Fin q × Bool)
-    (a : MarkingSurfaceEdge q × Bool) (ha : a ∈ markingTail q j) :
-    (chainMax a.1.1.1, chainMax a.1.1.2) ≠
-      (markingBaseCell q, markingBedCell q i false) := by
