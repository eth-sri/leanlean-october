-    have hss : IsPath X.src X.tgt (s ++ revPath s) b b := hs.append (isPath_revPath hs)
-    have hlss : IsPath X.src X.tgt (l ++ (s ++ revPath s)) a b := hl.append hss
-    have e1 : revPath r ++ (r ++ l ++ s) ++ revPath s
