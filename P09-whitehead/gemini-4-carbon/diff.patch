-theorem ExactlyTwo.congr {α : Sort*} {P Q : α → Prop} (h : ExactlyTwo P)
-    (hPQ : ∀ x, P x ↔ Q x) : ExactlyTwo Q := by
-  obtain ⟨x, y, hxy, hx, hy, huniq⟩ := h
-  exact ⟨x, y, hxy, (hPQ x).1 hx, (hPQ y).1 hy, fun z hz => huniq z ((hPQ z).2 hz)⟩
