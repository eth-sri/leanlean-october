-  V : Fin M → P
-  W : Fin M → P
-  E : Fin M → P
-  D : Fin M → P
-  G : Fin M → P
-  F : Fin M → P
-  R : Fin M → P
-  T1 : Fin M → P
-  T2 : Fin M → P
-  I : Fin M → P
-  projV : ∀ p, f (V p) = cV hc p
-  projW : ∀ p, f (W p) = cW hc p
-  projE : ∀ p, f (E p) = cE hc p
-  projD : ∀ p, f (D p) = cD hc p
-  projG : ∀ p, f (G p) = cG hc p
-  projF : ∀ p, f (F p) = cF hc p
-  projR : ∀ p, f (R p) = cR hc p
