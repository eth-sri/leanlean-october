-theorem BoundaryWords.eraseTree_mk (W : BoundaryWords r) :
-    FreeGroup.mk (W.eraseTree r T).loopWord = Comb.SpanningTree.pathWord T W.loopWord := by
-  rw [W.eraseTree_loopWord, treeLetters_mk]
