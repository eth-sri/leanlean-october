+/-- The projection of the cover onto the presentation complex. -/
+def coverProj : Hom (coverComplex Nsub ρ hρ) (presComplex ρ) where
+  onV _ := PUnit.unit
+  onE e := e.2
+  onF f := f.2
+  src_onE _ := rfl
+  tgt_onE _ := rfl
+  base_onF _ := rfl
+  att_onF f := (map_liftPath (FreeGroup.toWord (ρ f.2)) f.1).symm
+
+end Comb
