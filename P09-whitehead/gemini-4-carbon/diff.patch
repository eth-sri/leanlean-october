-theorem truncatedCell_eq_of_le_of_dimension_eq {c d : TruncatedCell A}
-    (hcd : c ≤ d) (hd : truncatedCellDimension c = truncatedCellDimension d) : c = d := by
-  by_contra hne
-  have hlt := truncatedCellDimension_strictMono (lt_of_le_of_ne hcd hne)
-  omega
