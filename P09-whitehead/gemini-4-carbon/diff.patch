-theorem traversal_eq_base {t : I} (h : L t = orderRoseBase PUnit) : t = 0 ∨ t = 1 := by
-  rcases hfiber t 0 (h.trans L.source.symm) with ht | ht | ht
-  · exact Or.inl ht
-  · exact Or.inl ht.1
-  · exact Or.inr ht.1
