-
-theorem clen_le_of_cword {l : List V} {x : CayGroup A} (h : cword A l = x) :
-    clen A x ≤ l.length := by
-  rw [← h]
-  exact len_le_length A l
-
-theorem clen_inv (x : CayGroup A) : clen A x⁻¹ = clen A x := by
