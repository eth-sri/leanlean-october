-noncomputable def circleDimension (w : J → List (α × Bool)) (x : TCirc w) : ℕ := by
-  classical
-  exact if x.2.1 < (w x.1).length ∧
-    (x.2.2 = CPos.cedgL ∨ x.2.2 = CPos.cedgR) then 1 else 0
