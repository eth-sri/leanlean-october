-  desc s (boundaryFamilyInclusion K _)
-    ((⟨old (twoAttaching f c r s) (boundaryFamilyInclusion (NewRelators c) _),
-      old_continuous _ _⟩ : C(DiskAttachment (oneAttaching f r), _)).comp (roseIntoOne f r))
