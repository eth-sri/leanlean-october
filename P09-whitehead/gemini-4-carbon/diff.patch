-/-! ### Two vertices of a triangle are joined by a side -/
-
-omit [Fintype κ] [Fintype ι] [DecidableEq κ] [DecidableEq ι] in
-/-- The vertices of the triangle `tr1 p`. -/
-theorem vtx_of_lt_tr1 {p : Fin M} {v : SCell vc ec hc} (hv : Cell.rk v = 0)
