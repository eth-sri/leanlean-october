-def sidePath (s : SquareSide) :
-    Path (old r (boundaryFamilyInclusion J (Fin 1 → ℝ)) (W.vertex (squareSideMap s 0)))
-      (old r (boundaryFamilyInclusion J (Fin 1 → ℝ)) (W.vertex (squareSideMap s 1))) :=
