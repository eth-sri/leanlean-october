-  · simp [squareEndpointFlag, squareNegativeFlag, squarePositiveFlag,
-      cubeNegativeVertex, cubePositiveVertex, hb] at hv
-  · have hst : s = t := by simpa [squareEndpointFlag, squarePositiveFlag] using hm
-    exact Prod.ext hst rfl
