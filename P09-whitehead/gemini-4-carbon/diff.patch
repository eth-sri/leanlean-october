-    @FSGenerates A J B K dA' dB' ρ τ
-      (@PresMorFS.redecide A J B K dA dB ρ τ f dA' dB') := by
-  have hA : dA' = dA := Subsingleton.elim _ _
-  have hB : dB' = dB := Subsingleton.elim _ _
-  subst dA'
-  subst dB'
-  exact hf
