-  · intro ht
-    apply d.property
-    refine ⟨⟨d.val.1, graphBoundaryNeg⟩, ?_⟩
-    change Sigma.mk d.val.1 (unitBoundaryInclusion _ graphBoundaryNeg) = d.val
-    cases d with
-    | mk d hd =>
-      cases d with
-      | mk a x =>
-        dsimp at ht ⊢
-        apply congrArg (Sigma.mk a)
-        rw [← graphDiskHomeomorph_zero, ← ht, Homeomorph.apply_symm_apply]
