+theorem isPath_alph (p : Fin M) :
+    IsPath (orderCx (NeSpx (cmpRel (SCell vc ec hc)))).src
+      (orderCx (NeSpx (cmpRel (SCell vc ec hc)))).tgt (alph hc p)
+      (spx1 (cC hc)) (spx1 (cW hc p)) :=
