+/-- The six actual facet coefficients reconstruct every chain supported below the three-cube. -/
+theorem qThreeOrderedCoordinates_reconstruct (c : QCube A) (u v w : V) (huv : u ≠ v) (huw : u ≠ w) (hvw : v ≠ w) (hs : c.spx = {u, v, w})
