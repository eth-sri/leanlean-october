-      old r (boundaryFamilyInclusion J E) (r ⟨j, ⟨x, hx⟩⟩) := by
-  rw [show diskCharacteristic r x₀ j x =
-      cell r (boundaryFamilyInclusion J E) ⟨j, ⟨x, hx.le⟩⟩ from
