-    (∑ C ∈ fsCosetSupport H c,
-      (single (Quotient.out C) (1 : ℤ) : MonoidAlgebra ℤ G) •
-        (c.mapRange (slice H (Quotient.out C)) (map_zero _)).mapRange
-          (subRingHom H) (map_zero _)) = c := by
