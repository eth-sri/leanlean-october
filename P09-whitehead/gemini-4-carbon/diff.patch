-  wd : ∀ p, W p ≤ D p
-  vg : ∀ p, V p ≤ G p
-  w1g : ∀ p, W (p + 1) ≤ G p
-  wf : ∀ p, W p ≤ F p
-  w1f : ∀ p, W (p + 1) ≤ F p
