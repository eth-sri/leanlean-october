-/-- The six signs of an actual three-cube in decreasing coordinate order. -/
-theorem threeFacet_incidence_zero (c : QCube A) {u v w : V}
-    (huv : v < u) (hvw : w < v) (hs : c.spx = {u, v, w}) :
