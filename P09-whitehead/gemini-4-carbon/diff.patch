-    fsCellsF ρ bsub hfill c y (Sum.inr ⟨s, m⟩) =
-      coeffF ρ bsub hfill (y (Sum.inr s)) * c s m := rfl
-
-end Fox
-
-end FiniteChains.BlockFamily
