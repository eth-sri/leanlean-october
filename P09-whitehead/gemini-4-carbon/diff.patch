-
-theorem quotientMarkingTail_avoids (i j : Fin q × Bool)
-    (c : (orderCx (namedQuotientPos ρ q u)).E × Bool)
-    (hc : c ∈ quotientMarkingTail q ρ u j) : c.1 ≠ quotientMarkingFirstEdge q ρ u i := by
-  obtain ⟨d, hd, rfl⟩ := List.mem_map.mp hc
