-def simplexHornRetractCoords (i : Fin (d + 2))
-    (z : stdSimplex ℝ (Fin (d + 2))) : Fin (d + 2) → ℝ :=
-  i.insertNth (z.1 i + (d + 1 : ℝ) * simplexHornMin i z)
-    (fun j ↦ z.1 (i.succAbove j) - simplexHornMin i z)
