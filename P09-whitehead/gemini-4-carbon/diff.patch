-theorem vtx_of_lt_inn {p : Fin M} {v : SCell vc ec hc} (hv : Cell.rk v = 0)
-    (h : v < toS vc ec hc (inn p)) :
-    v = ctr ∨ v = cvx p ∨ v = cvx (p + 1) := by
