-theorem pairSubstitution_generator_fox (i : PairGen A Z) (j : A ⊕ Z) :
-    fox i (pairSubstitution (FreeGroup.of j)) =
-      if pairOldCoordinate i = j then pairFoxWeight i else 0 := by
-  by_cases h : pairOldCoordinate i = j
-  · subst j
-    rw [if_pos rfl]
-    rfl
-  · rw [if_neg h]
-    cases i with
-    | inl a =>
