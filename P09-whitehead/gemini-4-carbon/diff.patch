-  induction ps with
-  | nil => rfl
-  | cons p ps ih =>
-      change wordPath f (commutatorLetterBlock p ++ commutatorLetters ps) = _
-      rw (config := { transparency := .default }) [wordPath_append, ih]
-      simp only [commutatorLetterBlock, wordPath_cons, wordPath_nil,
