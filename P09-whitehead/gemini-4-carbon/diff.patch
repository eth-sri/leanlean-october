+      refine ⟨{x, e', f}, ?_, ?_, by simp⟩
+      · rw [mem_orderComplex]
+        have : IsChain (· ≤ ·) ({x, e', f} : Set P) :=
+          isChain_triple (Or.inl hxe.le) (Or.inl (hxe.trans he'f).le) (Or.inl he'f.le)
+        simpa [Finset.coe_insert] using this
+      · grind
+    · -- `x` is an edge of `f`
