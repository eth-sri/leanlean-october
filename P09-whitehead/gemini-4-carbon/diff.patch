-    omega
-  · have hred : IsRed A.rel (s :: l) := ⟨hl, hc⟩
-    have hcons : gen A s * cword A l = cword A (s :: l) := (cword_cons A s l).symm
-    simp only [IsDesc, hcons, clen_cword A hred, clen_cword A hl, hc, iff_false,
