-  let e₁₂ : StrictOrdEdge P := ⟨(t.val.2.1, t.val.2.2), t.property.2⟩
-  let e₀₂ : StrictOrdEdge P := ⟨(t.val.1, t.val.2.2), t.property.1.trans t.property.2⟩
