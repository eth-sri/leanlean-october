-  have e1 := att_V hM hvlab helb hc p
-  have e2 := att_VE hM hvlab helb hc p
-  have e3 := att_E hM hvlab helb hc p
-  have e4 := att_V hM hvlab helb hc (p + 1)
-  have e5 := att_V1E hM hvlab helb hc p
