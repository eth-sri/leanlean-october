+theorem generatesDegreeIn_cover_chamber [Nonempty X] (hf : IsPosetCover f)
+    (w : CayGroup A) :
+    GeneratesDegreeIn (fun p : P => InZChamber w (f p))
+      (fun p => InZBase (f p)) 3 := by
