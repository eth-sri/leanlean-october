-def BoundaryWords.eraseTree (W : BoundaryWords r) :
-    BoundaryWords (roseAttaching {j : J // ¬T.isTree j}) where
-  vertex := fun _ => PUnit.unit
-  word s := treeLetters r T (W.word s)
-  isPath _ := rose_word_isPath _
