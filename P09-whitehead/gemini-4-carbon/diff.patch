-      exact (orderNerveH2Class_eq_zero_iff P c.val c.property).mpr
-        (hfill c.val c.property)
-  letI : Subsingleton (OrderNerveH2 P) := ⟨fun x y => (hz x).trans (hz y).symm⟩
-  letI := (orderCellSingularH2Equiv P).surjective.subsingleton
