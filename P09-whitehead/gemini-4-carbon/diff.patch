-  Adj := S.adj
-  symm := ⟨fun _ _ h => S.adj_symm h⟩
-  loopless := ⟨S.adj_irrefl⟩
-
-omit [DecidableEq Vx] in
-@[simp] theorem toSimpleGraph_adj (a b : Vx) : (toSimpleGraph S).Adj a b ↔ S.adj a b := Iff.rfl
