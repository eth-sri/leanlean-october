-      (Σ n, (nerve P).nonDegenerate n) := fun s => ⟨s.1.val, s.2⟩
-  have hf : Function.Injective f := (show Function.LeftInverse g f from fun _ => rfl).injective
-  exact Finite.of_injective f hf
