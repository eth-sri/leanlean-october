-        exact ⟨hadj, S.adj_symm hadj, by simp⟩
-      rw [WalkHtpy, hrw, SimpleGraph.Walk.support_cons]
-      refine hcons.trans ?_
-      simpa using WalkHomotopic.of_walkMove hback
