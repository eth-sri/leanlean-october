-    let B₀ : Set (FullCylinderBoundary S) := {z | z.val.1 = 0}
-    let B₁ : Set (FullCylinderBoundary S) := {z | z.val.1 = 1}
-    let C : Set (FullCylinderBoundary S) := {z | z.val.2 ∈ S}
