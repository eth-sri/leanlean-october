-    have hu := prismDenom_le_one w
-    constructor
-    · have he : (-2) ≤ ((w.1 : ℝ) - 2) / prismDenom w :=
-        (le_div_iff₀ hd).mpr (by linarith)
-      linarith
-    · have he : ((w.1 : ℝ) - 2) / prismDenom w ≤ -1 :=
-        (div_le_iff₀ hd).mpr (by linarith [w.1.property.2])
-      linarith⟩
