+    presUniversalRelatorGroupEquiv σ v hv hvp (h.universalRelatorMap p) =
+      Prod.map (h.groupHom ρ σ hw hv) h.cell (presUniversalRelatorGroupEquiv ρ w hw hwp p) := by
+  apply Prod.ext
+  · exact h.universal_reading_map ρ σ hw hv p.val.1
+  · rfl
