-/-- The loop obtained from a path by prefixing and suffixing tree paths. -/
-noncomputable def conjPath (l : List (K.E × Bool)) (a b : K.V) : List (K.E × Bool) :=
-  T.treePath a ++ l ++ revPath (T.treePath b)
