-theorem Move.reverse {l l' : List Vx} (h : S.Move l l') : S.Move l.reverse l'.reverse := by
-  induction h with
-  | backtrack x y q =>
-      have h0 : S.Move [x, y, x] [x] := Move.backtrack x y []
-      have := h0.append_left q.reverse
