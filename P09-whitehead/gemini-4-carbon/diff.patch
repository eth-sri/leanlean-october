-structure IntervalEndpointExtension (f : C(I, X)) {x₀ x₁ : X}
-    (p₀ : Path (f 0) x₀) (p₁ : Path (f 1) x₁) where
-  map : C(I × I, X)
-  zero : ∀ t, map (0, t) = f t
-  side_zero : ∀ τ, map (τ, 0) = p₀ τ
-  side_one : ∀ τ, map (τ, 1) = p₁ τ
