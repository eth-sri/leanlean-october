-    have hc : t.1.2.2.1 = c := hf.up_inj
-      (by rw [← ht.1]; exact t.2.1.trans t.2.2.1) (hab.trans hbc)
-      ((congrArg (fun s : OrdTet Q => s.1.2.2.1) ht.2).trans hfc.symm)
