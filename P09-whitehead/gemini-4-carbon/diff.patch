-namespace ComplexChain
-
-variable {K : Complex2.{u}} {T₀ : SpanningTree K} {n : ℕ} (c : ComplexChain K T₀ n)
-
-end ComplexChain
-
-variable {K : Complex2.{u}} (T₀ : SpanningTree K)
-variable [Fintype (NonTree T₀)] [DecidableEq (NonTree T₀)] [Fintype K.F] [DecidableEq K.F]
-
-/-! ### Non-vacuity -/
