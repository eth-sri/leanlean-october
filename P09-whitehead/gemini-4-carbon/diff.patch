-theorem normalizedEdgeHomotopies_coherent (x : X) (tau : Simplex X 2)
-    (i j : Fin 3) (t : I) (z w : Domain 1)
-    (h : stdSimplex.map (SimplexCategory.δ i) z = stdSimplex.map (SimplexCategory.δ j) w) :
