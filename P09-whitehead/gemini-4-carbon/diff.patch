-  have hs := congrArg Prod.fst hp
-  have ht := congrArg Prod.snd hp
-  have hh := congrArg (namedSurfaceProjection ρ q u) he
-  dsimp only at hs ht
-  rw [hs, ht] at hh
-  cases hh
