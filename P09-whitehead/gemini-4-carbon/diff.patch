-    intro g g' hg p p' hp
-    show Htpy X x₀ (endpt X x₀ (deckP g p).1) (deckP g p).1 (deckP g' p').1
-    rw [endpt_deckP]
-    exact Htpy.append_congr g.2 p.2 hg hp) γ c
