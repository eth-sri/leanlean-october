+      y.filter (fun t => t.1.2.2.2 = c) := by
+  ext t
+  simp
+  by_cases ht : y t = 0
+  · simp [Finsupp.filter_apply, ht]
+  · rw [Finset.sum_eq_single t.1.2.2.2]
+    · simp
+    · intro c _ hne
+      simp [Ne.symm hne]
+    · intro hnot
+      exact False.elim (hnot (Finset.mem_image.mpr
+        ⟨t, Finsupp.mem_support_iff.mpr ht, rfl⟩))
