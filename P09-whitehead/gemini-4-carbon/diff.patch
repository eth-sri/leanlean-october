-  constructor
-  · intro h
-    obtain ⟨l, hl, rfl⟩ := exists_cword A x
-    rw [clen_cword A hl] at h
-    have : l = [] := List.eq_nil_of_length_eq_zero h
-    simp [this]
-  · rintro rfl
-    simp [clen, len]
