+  · exact generatesDegreeIn_of_acyclicRelIn (acyclicRelIn_cover_marked_chamber hf w hw)
+  · exact generatesDegreeIn_of_fillsDegreeIn (by
+    have hne : ∃ p : P, InZChamber w (f p) := by
+      obtain ⟨p, hp⟩ := hf.surj (zApex hw)
