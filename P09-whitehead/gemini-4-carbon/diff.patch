+def sectionV (v : K.V) : D.V := Classical.choose (hp.surjV v)
+theorem sectionV_spec (v : K.V) : p.onV (sectionV p hp v) = v := Classical.choose_spec (hp.surjV v)
+
+def sheet (d : D.V) : Q := Classical.choose
