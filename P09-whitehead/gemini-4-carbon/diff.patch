+  {vc : Fin M → κ} {ec : Fin M → ι} (hc : Compat vc ec)
+  {G : Type v} [Group G] {Ω : Type w} [MulAction G Ω]
+  (c : OrdCocycle (NeSpx (cmpRel (SCell vc ec hc))) G)
