-  apply hq.continuous_iff.mpr
-  have he : (e.symm ∘ roseCopyRealization a) ∘ L =
-      fun t => cell (roseAttaching α) (boundaryFamilyInclusion α _) ⟨a, graphDiskHomeomorph t⟩ := by
