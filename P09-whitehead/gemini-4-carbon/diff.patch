+    (h : b < a) (hs : c.1.spx = {a, b}) (s : ZMod 2) :
+    (qSquareSmallFacet c s).1 = qCubeFacet c.1 b s := by
+  obtain ⟨_, hr⟩ := qSquare_frame_unique c h hs
+  change qCubeFacet c.1 (qSquareRight c) s = _
+  rw [hr]
