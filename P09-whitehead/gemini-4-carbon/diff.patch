-  intro x y h
-  refine Prod.ext ?_ (congrArg (fun e : OrdEdge P × Bool => e.2) h)
-  apply Subtype.ext
-  apply Prod.ext
-  · apply Subtype.ext
-    exact congrArg (fun e : OrdEdge P × Bool => e.1.1.1) h
-  · apply Subtype.ext
-    exact congrArg (fun e : OrdEdge P × Bool => e.1.1.2) h
