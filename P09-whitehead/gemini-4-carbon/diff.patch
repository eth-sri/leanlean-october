-/-- The existing genuine finitely supported Fox boundary, in matrix coordinates. -/
-theorem fsCoverSecondBoundary_apply {A J : Type u} [DecidableEq A]
-    (σ : J → FreeGroup A) (x : J →₀ MonoidAlgebra ℤ (PresGroup σ)) (i : A) :
