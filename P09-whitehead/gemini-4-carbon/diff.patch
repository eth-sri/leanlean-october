-    orderSmallSingularApproximation P 0 = orderSmallSingularApproximation0 := by
-  apply orderSmallSingle_spans
-  intro σ
-  change orderNerveGradedRealize P 0 (orderSmallToNerve0 (orderSmallSingle σ 1)) = _
