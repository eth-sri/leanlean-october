-    apply MulOpposite.unop_injective
-    change (d p ≫ F.map (homOfLE hpq) ≫ Groupoid.inv (d q)) ≫
-      (d q ≫ F.map (homOfLE hqr) ≫ Groupoid.inv (d r)) =
-      d p ≫ F.map (homOfLE (hpq.trans hqr)) ≫ Groupoid.inv (d r)
