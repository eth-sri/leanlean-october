-  linarith
-
-/-- The explicit retraction of a simplex onto the horn obtained by deleting face `i`. -/
-def simplexHornRetract (i : Fin (d + 2)) :
-    C(stdSimplex ℝ (Fin (d + 2)), stdSimplex ℝ (Fin (d + 2))) where
-  toFun z := ⟨simplexHornRetractCoords i z,
