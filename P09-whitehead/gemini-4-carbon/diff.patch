-/-- Exact naturality of normalization under a strict change of coordinates. -/
-theorem mapOne_semiconj (e : P → Q) (he : StrictMono e)
-    (g : P → P) (hg : Monotone g) (h : Q → Q) (hh : Monotone h)
-    (hs : ∀ x, e (g x) = h (e x)) (c : StrictOrdEdge P →₀ ℤ) :
