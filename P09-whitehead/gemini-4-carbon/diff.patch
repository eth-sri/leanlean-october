-    ((simplexCoordinates n).symm z).weights i = z.val i := by
-  exact congrArg (fun w : stdSimplex ℝ (Fin (n + 1)) => w.val i)
-    ((simplexCoordinates n).apply_symm_apply z)
-
-end FiniteChains.TopologicalSingular
