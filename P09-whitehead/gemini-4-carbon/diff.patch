-  toFun x := ⟨x.point, g * x.sheet⟩
-  invFun x := ⟨x.point, g⁻¹ * x.sheet⟩
-  left_inv x := by cases x; simp only [← mul_assoc, inv_mul_cancel, one_mul]
-  right_inv x := by cases x; simp only [← mul_assoc, mul_inv_cancel, one_mul]
