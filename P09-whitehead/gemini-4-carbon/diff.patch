-      Limits.IsZero (((singularHomologyFunctor (ModuleCat.{0} ℤ) 2).obj
-        (ModuleCat.of ℤ ℤ)).obj (orderNerveRealization P)) := by
-  constructor
-  · intro h
-    exact ⟨h 1 (by decide), h 2 (by decide)⟩
