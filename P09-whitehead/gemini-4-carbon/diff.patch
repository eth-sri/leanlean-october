+theorem canonicalGen_finite (hK : Whitehead.FiniteCells K) : Finite (CanonicalGen K) := by
+  haveI : Finite (Comb.SpanningTree.NonTree (originalGraphTree K)) := originalRoseGen_finite K hK
+  infer_instance
