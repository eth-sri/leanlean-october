-        change (T.ht t.val.1 + 1 = T.ht t.val.2.2 ∨
-          T.ht t.val.2.2 + 1 = T.ht t.val.1) at h₃
-        omega
-      · exact ⟨⟨e₀₂, h₀₂⟩⟩
-    · exact ⟨⟨e₁₂, h₁₂⟩⟩
