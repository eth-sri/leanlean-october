-theorem orderSmallTwoFill_exists {P : Type} [PartialOrder P]
-    (σ : OrderSmallSimplex P 2) :
-    ∃ b : Nerve.Ch P, b ∈ Nerve.IncOn (orderNerveSingularCarrier σ.val) ∧
