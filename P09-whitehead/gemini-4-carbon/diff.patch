-def FreshLoopOrFace (h : Hom X Y) : Prop :=
-  (∃ e : Y.E, Y.src e = Y.tgt e ∧ e ∉ Set.range h.onE) ∨
-    ∃ f : Y.F, f ∉ Set.range h.onF
