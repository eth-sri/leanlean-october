-namespace FiniteChains.RelativeAttachment
-
-theorem closedUnitBall_connectedSpace {E : Type*} [NormedAddCommGroup E]
-    [NormedSpace ℝ E] : ConnectedSpace (ClosedUnitBall E) := by
-  apply isConnected_iff_connectedSpace.mp
