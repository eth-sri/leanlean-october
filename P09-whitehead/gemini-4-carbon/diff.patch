-        rcases vtx_of_lt_tr1 hc hv' hv'f with rfl | rfl | rfl
-      · exact absurd rfl hne
-      · exact ⟨bed (ec p), (Ebed p).1, (Ebed p).2.1, (Ebed p).2.2⟩
