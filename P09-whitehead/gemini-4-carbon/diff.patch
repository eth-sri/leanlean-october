-  positive : 0 < n
-  vertex : Fin (n + 2) ≃ P
-  consecutive : ∀ i : Fin (n + 1),
-    vertex i.castSucc ≤ vertex i.succ ∨ vertex i.succ ≤ vertex i.castSucc
