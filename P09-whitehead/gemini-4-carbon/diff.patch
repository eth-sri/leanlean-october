+open RACG Mirror Comb PresModel BlockFamily
+variable {α Jr : Type} (ρ : Jr ⊕ PUnit.{1} → FreeGroup α)
+  (q : ℕ) [NeZero q] (u : Fin q × Bool → FreeGroup α)
+
+end FiniteChains.Davis.Genus
