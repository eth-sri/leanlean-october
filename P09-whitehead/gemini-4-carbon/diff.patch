-theorem IsBlock.relSub_le_comap : relSub ρ ≤ (relSub τ).comap (FreeGroup.map f) := by
-  refine Subgroup.normalClosure_le_normal ?_
-  rintro _ ⟨j, rfl⟩
-  refine Subgroup.mem_comap.2 ?_
