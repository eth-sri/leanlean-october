-theorem stickSimplex_cubeFace_zero_succ : ∀ (d : ℕ) (i : Fin (d + 1)) (t : I^Fin d),
-    stickSimplex (d + 1) (cubeFace i 0 t) i.succ = 0 := by
-  intro d
-  induction d with
-  | zero =>
-      intro i t
-      have hi : i = 0 := Fin.eq_zero i
-      subst i
-      rw [cubeFace_zero_eq_cons]
-      change (0 : ℝ) * stickSimplex 0 t 0 = 0
-      ring
-  | succ d ih =>
-      intro i t
