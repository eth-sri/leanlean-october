-  onV v := ⟨k.onV v, hk v⟩
-  onE := orderCxRestrictEdge k S hk
-  onF := orderCxRestrictFace k S hk
-  src_onE e := Subtype.ext (k.src_onE e)
-  tgt_onE e := Subtype.ext (k.tgt_onE e)
-  base_onF t := Subtype.ext (k.base_onF t)
