-      [(⟨(f a, g a), hfg a⟩, true)]) at hn
-  rw [he, ← hfix] at hn
-  exact (hn.trans (htpy_reflexive_conjugation _ (isPath_mapPath (orderCxMap f hf) hp))).symm
-
-end FiniteChains.Comb
