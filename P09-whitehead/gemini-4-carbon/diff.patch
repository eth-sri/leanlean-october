-  apply QCube.ext' hs
-  intro w hw
-  by_cases hwv : w = v
-  · subst w
-    simp
-  · change d.sgn w = Function.update c.sgn v (d.sgn v) w
-    rw [Function.update_of_ne hwv]
-    apply h.2
-    intro hc
-    apply hw
