-    obtain ⟨j', hz⟩ := Set.mem_iUnion.mp hz
-    obtain ⟨j, hj⟩ := j'.property
-    have hj' : (j'.1 : AttachmentCell (X := X) (J := J) n m) = Sum.inl j := hj.symm
-    rw [hj'] at hz
