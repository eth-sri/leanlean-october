+theorem isPath_gam (p : Fin M) :
+    IsPath (orderCx (NeSpx (cmpRel (SCell vc ec hc)))).src
+      (orderCx (NeSpx (cmpRel (SCell vc ec hc)))).tgt (gam hc p)
+      (spx1 (cW hc p)) (spx1 (cW hc (p + 1))) :=
