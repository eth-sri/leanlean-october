+theorem isPath_gg (p : Fin M) :
+    IsPath (orderCx (NeSpx (cmpRel (SCell vc ec hc)))).src
+      (orderCx (NeSpx (cmpRel (SCell vc ec hc)))).tgt (gg hc p)
+      (spx1 (cV hc p)) (spx1 (cW hc (p + 1))) :=
