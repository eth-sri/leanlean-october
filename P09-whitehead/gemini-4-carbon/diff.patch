-  have hc'mem : c' ∈ σ' \ σ := by rw [hc']; simp
-  simp only [Finset.mem_sdiff] at hcmem hc'mem
-  refine ⟨c, c', ?_, hcmem.1, hcmem.2, hc'mem.1, hc'mem.2, ?_⟩
