-  change sheet p hp a hr (D.src e) * edge p hp a hr (p.onE e) =
-    sheet p hp a hr (D.tgt e) at h
-  rw [← h]
-  group
-
-include he in
-theorem read_projected_path {l : List (D.E × Bool)} {d e : D.V}
-    (hl : IsPath D.src D.tgt l d e) :
