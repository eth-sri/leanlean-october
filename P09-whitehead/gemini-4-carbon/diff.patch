-def fsSurfaceChain (c : ∀ s, Mt s →₀ R) (s : Sx) : (Jr ⊕ (Σ s, Mt s)) →₀ R :=
-  (c s).mapDomain (fun m => Sum.inr ⟨s, m⟩)
