+theorem realization_connected [ConnectedSpace E] :
+    ConnectedSpace (orderNerveRealization (Cover p hp)) :=
+  (realizationHomeomorph p hp hs).symm.surjective.connectedSpace
+    (realizationHomeomorph p hp hs).symm.continuous
