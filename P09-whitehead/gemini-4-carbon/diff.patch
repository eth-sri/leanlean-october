+/-- A group ring over `ℤ` has no additive torsion. -/
+theorem nsmul_eq_zero_iff_of_ne {G : Type*} (m : ℕ) (hm : m ≠ 0) (x : MonoidAlgebra ℤ G) :
+    m • x = 0 ↔ x = 0 := by simp_all
