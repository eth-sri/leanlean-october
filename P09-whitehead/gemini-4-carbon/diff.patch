-def fullCylinderPastingFun (f₀ f₁ : C(D, Z)) (H : C(I × S, Z))
-    (z : FullCylinderBoundary S) : Z :=
-  if h₀ : z.val.1 = 0 then f₀ z.val.2
-  else if h₁ : z.val.1 = 1 then f₁ z.val.2
-  else H (z.val.1, ⟨z.val.2, (z.property.resolve_left h₀).resolve_left h₁⟩)
