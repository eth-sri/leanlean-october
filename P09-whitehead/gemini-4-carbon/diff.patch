+      rw [hp]
+      exact inZChamber_zApex hw
+    apply fillsDegreeIn_of_subtype hne
+    intro c hi hd hc
+    exact nerve_twoCycle_filling_of_strict
+      (strict_twoCycle_cover_unmarked_chamber hf w hw) c hi hd hc)
