-def attachmentCW (hb : FiniteLowerBoundary n r) : CWComplex (Set.univ : Set (DiskAttachment r)) where
-  cell := AttachmentCell (X := X) (J := J) n
-  map := attachmentCharacteristic n r hr x₀
