-noncomputable def cornerTriangleEdge (t : OrdTri P) :
-    (orderCx (Set.Ioi p)).E →₀ ℤ := by
-  classical
-  exact if h : t.1.1 = p ∧ p < t.1.2.1 then
-    Finsupp.single ⟨(⟨t.1.2.1, h.2⟩, ⟨t.1.2.2, h.2.trans_le t.2.2⟩), t.2.2⟩ 1 else 0
-
