-  mul_smulE _ _ e := by simp [mul_assoc]
-  one_smulF f := by simp
-  mul_smulF _ _ f := by simp [mul_assoc]
-  src_smul _ _ := rfl
-  tgt_smul _ e := mul_assoc ..
-  base_smul _ _ := rfl
-  att_smul q f := liftPath_translate (FreeGroup.toWord (ρ f.2)) q f.1
-
-/-! ### The topological input of Section 2, as a theorem -/
-
-end Comb
-end FiniteChains
