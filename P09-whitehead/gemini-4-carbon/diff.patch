-open RACG Mirror Comb PresModel BlockFamily
-variable (q : ℕ) [NeZero q] {α Jr : Type}
-  (ρ : Jr ⊕ PUnit.{1} → FreeGroup α) (u : Fin q × Bool → FreeGroup α)
-  (hrho : ρ (Sum.inr PUnit.unit) = commWord u (finitePairs q))
