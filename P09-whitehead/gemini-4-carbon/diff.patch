-  congrArg Prod.fst (liftGerm_spec p hp e).2
-
-def edge (e : K.E) : Q := sheet p hp a hr (D.tgt (liftEdge p hp e))
-
-include he in
-theorem lifted_edge_deck (e : D.E) :
