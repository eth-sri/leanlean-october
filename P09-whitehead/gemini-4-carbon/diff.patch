-/-! ### The projection is a covering of posets -/
-
-omit [Fintype V] in
-/-- **Unique lifting of the cells above a cell of `Z`.** -/
-theorem zProj_up (z : Zpos A X (IsGamma A) att) (q : Qpos A X att)
