-  funext j
-  rcases j with (m | p) | k
-  · change FreeGroup.map Sum.inl (FreeGroup.map Sum.inl (core m)) =
-      FreeGroup.map Sum.inl (ρ (Sum.inl m))
-    rw [hcore]
-  · rfl
-  · rfl
-
-end FiniteChains.Davis.Genus
