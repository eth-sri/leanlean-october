-    rw [← squareRadialBoundary_filter_top c a b hne hs z hz, hcycle, map_zero]
-  have he := squareChain_eq_scalar_subdivision c a b hne hs _ hsupp hint
-  simpa only [Finsupp.filter_apply, squareFlag_top, if_true] using he
