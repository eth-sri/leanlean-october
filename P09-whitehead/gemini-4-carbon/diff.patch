-  have hl := le_of_lt h
-  change x = y ∨ TCirc.lt w x y at hl
-  rcases hl with he | hl
-  · exact (hn he).elim
-  obtain ⟨j, k, t⟩ := x
-  obtain ⟨j', k', t'⟩ := y
-  obtain ⟨hj, hk, htags⟩ := hl
-  subst j'
-  rcases htags with ⟨ht, ht', _⟩ | ⟨ht, ht', _⟩ | ⟨ht, ht', _⟩ | ⟨ht, ht', _⟩ <;>
-    subst t <;> subst t' <;> simp [circleDimension, hk]
