-    S.WalkMove l.reverse l'.reverse := by
-  rcases h with ⟨hm, hw⟩ | ⟨hm, hw⟩
-  · exact Or.inl ⟨hm.reverse, isWalk_reverse hw⟩
-  · exact Or.inr ⟨hm.reverse, isWalk_reverse hw⟩
