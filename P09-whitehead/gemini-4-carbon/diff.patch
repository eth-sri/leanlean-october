-    apply d.property
-    refine ⟨⟨d.val.1, graphBoundaryPos⟩, ?_⟩
-    change Sigma.mk d.val.1 (unitBoundaryInclusion _ graphBoundaryPos) = d.val
-    cases d with
-    | mk d hd =>
-      cases d with
-      | mk a x =>
-        dsimp at ht ⊢
-        apply congrArg (Sigma.mk a)
-        rw [← graphDiskHomeomorph_one, ← ht, Homeomorph.apply_symm_apply]
