-          simp only [expMatrix, Finsupp.linearCombination_single,
-            Finsupp.smul_apply, smul_eq_mul, expVec_apply]
-          change n * expEntry (terminalSpineCore (K := K) core) (Sum.inr k) (Sum.inl m) = _
-          simp [hz]
-      | inr l =>
