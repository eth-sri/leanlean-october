+theorem rk_cases (S : SurfaceRank P) {x y : P} (hxy : x < y) :
+    (S.rk x = 0 ∧ S.rk y = 1) ∨ (S.rk x = 1 ∧ S.rk y = 2) ∨ (S.rk x = 0 ∧ S.rk y = 2) := by
+  have h1 := S.rk_lt_of_lt hxy
+  have h2 := S.rk_le_two y
+  omega
