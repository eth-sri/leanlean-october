-theorem sbc_step (u : ℝ) (hu0 : sbc5Rate ≤ u) (hu1 : u ≤ 1) :
-    step .sbc sbc5_r (fun i => sbc5_lim i + u * sbc5_v i) =
-      fun i => sbc5_lim i + (sbc5Rate * u) * sbc5_v i := by
-  have h2 := sbc_sqrt_two_sq
