-    rintro d ⟨k, -, rfl | rfl⟩ <;> exact abs_nonneg _
-  rw [hS, mul_zero]
-
-theorem abs_band_iff (a b c d R : ℝ) (h1 : |a - c| ≤ 1 / 2 * |(|c - d|) - R|)
-    (h2 : |b - d| ≤ 1 / 2 * |(|c - d|) - R|)
