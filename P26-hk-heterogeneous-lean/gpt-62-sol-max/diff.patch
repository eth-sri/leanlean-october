+theorem fvct_of_tail (t : ℕ) (hc : Tendsto X atTop (𝓝 L))
+    (hs : ∀ k ≥ t, (adjMatrix m r (X t)).mulVec (X k) = X (k + 1)) : fvct m r (X t) = L := by
