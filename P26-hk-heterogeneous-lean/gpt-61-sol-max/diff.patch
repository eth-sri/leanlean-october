-  have hδε : δ ≤ ε / 4 := min_le_right _ _
-  have hδ1 : δ ≤ 1 := by linarith
-  have hεδ := mul_le_mul_of_nonneg_left hδhalf hε.le
-  have hspread : 6 + 3 * δ < (1 + ε) * (6 - 3 * δ) := by nlinarith
