+    Model.sbi.neighbors sbi8_r (spe_x (sbiRate ^ t) ((1 / 4) ^ t)) = sbi8_N := by
+  have := neg_pow_facts sbiRate rate_bounds.1 t
+  have : (1 / 4 : ℝ) ^ t ∈ Set.Icc 0 1 := by constructor <;> bound
