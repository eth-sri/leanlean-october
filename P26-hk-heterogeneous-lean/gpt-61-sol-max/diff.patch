+    simp_all [sbi5Offset] <;> and_intros <;> nlinarith
+
+section
+include hlo hhi
+
+theorem sbi5_offset_bound : ∀ i, |u t i| ≤ (2 / 3 : ℝ) ^ (t + 2) := by
