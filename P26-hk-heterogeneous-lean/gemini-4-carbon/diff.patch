+theorem sbi6_closed_form t :
+    traj .sbi sbi6_r sbi6_x0 t = fun i => sbi6_lim i + sbi6Rate ^ t * sbi6_v i := by
+  hk_ind; have := sbi6_bds t; rw [pow_succ]
