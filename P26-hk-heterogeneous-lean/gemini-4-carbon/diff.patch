+        div_mul_eq_mul_div, mul_comm goldenRatio]
+      repeat (first
+        | (erw [ite_eq_left]; rotate_right; (try constructor) <;> nlinarith)
+        | (erw [ite_eq_right]; rotate_right; intro; nlinarith))
+      ring_nf <;> norm_num <;> try ring)))
